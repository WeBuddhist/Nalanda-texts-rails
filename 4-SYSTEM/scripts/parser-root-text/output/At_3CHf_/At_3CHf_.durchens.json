{
  "durchens": [
    {
      "span": {
        "start": 61,
        "end": 70
      },
      "text": "བཟློག་པར་ ༼སྣར། པེ།༽ ཟློག་པར་"
    },
    {
      "span": {
        "start": 201,
        "end": 206
      },
      "text": "བཏང་། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 273,
        "end": 282
      },
      "text": "གྲུ་བཞིར་ ༼སྣར།༽ གྲུ་བཞི་"
    },
    {
      "span": {
        "start": 358,
        "end": 361
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 370,
        "end": 389
      },
      "text": "རྣམས་ཀྱི་གཟུགས་བྱས་ ༼སྣར།༽ རྣམས་ཀྱིས་གཟུགས་ ༼པེ།༽ རྣམས་ཀྱི་གཟུགས་"
    },
    {
      "span": {
        "start": 431,
        "end": 438
      },
      "text": "བསྒྱུར། ༼སྣར། པེ།༽ སྒྱུར།"
    },
    {
      "span": {
        "start": 459,
        "end": 469
      },
      "text": "གླུད་མཐེབ་ ༼སྣར། པེ།༽ བླུད་འཐེབ་"
    },
    {
      "span": {
        "start": 504,
        "end": 510
      },
      "text": "དེ་དག་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 548,
        "end": 553
      },
      "text": "རེའི་ ༼སྣར། པེ།༽ རེ་རེའི་"
    },
    {
      "span": {
        "start": 871,
        "end": 878
      },
      "text": "བསྒྱུར་ ༼སྣར། པེ།༽ སྒྱུར་"
    },
    {
      "span": {
        "start": 1052,
        "end": 1058
      },
      "text": "བཞུགས་ ༼སྣར། པེ།༽ བཞུག་"
    },
    {
      "span": {
        "start": 1313,
        "end": 1319
      },
      "text": "བསྣམས། ༼སྣར། པེ།༽ རྣམས།"
    },
    {
      "span": {
        "start": 1375,
        "end": 1381
      },
      "text": "བཅིབས། ༼སྣར། པེ།༽ ཆིབས།"
    },
    {
      "span": {
        "start": 3289,
        "end": 3293
      },
      "text": "གྲེ་ ༼སྣར། པེ།༽ དྲེ་"
    },
    {
      "span": {
        "start": 3557,
        "end": 3561
      },
      "text": "དབོ་ ༼སྣར། པེ།༽ སྦོ་"
    },
    {
      "span": {
        "start": 4011,
        "end": 4016
      },
      "text": "སྟེང་ ༼སྣར། པེ།༽ སྟེངས་"
    },
    {
      "span": {
        "start": 4088,
        "end": 4094
      },
      "text": "འཇིགས་ ༼སྣར། པེ།༽ འཇིགས་པ་"
    },
    {
      "span": {
        "start": 4719,
        "end": 4723
      },
      "text": "རྗེ་ ༼སྣར། པེ།༽ ལྗོང་"
    },
    {
      "span": {
        "start": 5155,
        "end": 5178
      },
      "text": "ས་འོག་དབང་བ་ཁྲོན་སྐྱེས་ ༼སྣར།༽ ས་བོག་དབང་པོ་"
    },
    {
      "span": {
        "start": 5979,
        "end": 5986
      },
      "text": "ཆེན་མོ་ ༼སྣར། པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 6230,
        "end": 6248
      },
      "text": "གྲོ་བཞིན་ས་ཡི་ཁམས་ ༼སྣར། པེ།༽ ས་འོག་དབང་བ་ཁྲོན་སྐྱེས་"
    },
    {
      "span": {
        "start": 6515,
        "end": 6520
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ ཞུན་"
    },
    {
      "span": {
        "start": 6821,
        "end": 6843
      },
      "text": "ལྗང་གུ་འོད་ཟེར་འཁྲུག ། ༼སྣར། པེ།༽ ལྗང་གུ་ལ། །"
    },
    {
      "span": {
        "start": 7045,
        "end": 7049
      },
      "text": "གྲེ་ ༼སྣར། པེ།༽ དྲེ་"
    },
    {
      "span": {
        "start": 7562,
        "end": 7571
      },
      "text": "བརྟན་པའི་ ༼སྣར། པེ།༽ བསྟན་པའི་"
    },
    {
      "span": {
        "start": 8576,
        "end": 8586
      },
      "text": "བསྟོད་ཅིང་ ༼སྣར། པེ།༽ བསྟོད་དེ་"
    },
    {
      "span": {
        "start": 8624,
        "end": 8631
      },
      "text": "མཛོད། ། ༼སྣར། པེ།༽ ། །།།"
    },
    {
      "span": {
        "start": 8726,
        "end": 8730
      },
      "text": "རིན་ ༼སྣར། པེ།༽ ཆེན་"
    },
    {
      "span": {
        "start": 8873,
        "end": 8879
      },
      "text": "བཅས་པ་ ༼སྣར། པེ།༽ བཅས་པའི་"
    },
    {
      "span": {
        "start": 8932,
        "end": 8937
      },
      "text": "བསགས། ༼སྣར།༽ བསག།"
    },
    {
      "span": {
        "start": 9006,
        "end": 9018
      },
      "text": "བཀྲ་ཤིས་དང་། ༼སྣར། པེ།༽ བཀྲ་ཤིས་སམ།"
    },
    {
      "span": {
        "start": 9394,
        "end": 9399
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    }
  ]
}