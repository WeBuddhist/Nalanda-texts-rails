{
  "durchens": [
    {
      "span": {
        "start": 40,
        "end": 42
      },
      "text": "ཏ་ ༼པེ། གསེར་བྲིས།༽ ཏ།"
    },
    {
      "span": {
        "start": 56,
        "end": 59
      },
      "text": "ཙྩ་ ༼པེ། གསེར་བྲིས།༽ ཚ་"
    },
    {
      "span": {
        "start": 139,
        "end": 141
      },
      "text": "བ། ༼པེ། གསེར་བྲིས།༽ བ། །"
    },
    {
      "span": {
        "start": 215,
        "end": 219
      },
      "text": "ལོག ༼གསེར་བྲིས།༽ ལོགས་"
    },
    {
      "span": {
        "start": 526,
        "end": 531
      },
      "text": "བཅོས་ ༼གསེར་བྲིས།༽ བཙད་ ༼པེ།༽ བཅོས་"
    },
    {
      "span": {
        "start": 1766,
        "end": 1771
      },
      "text": "རྙེད་ ༼པེ། གསེར་བྲིས།༽ བརྙེད་"
    },
    {
      "span": {
        "start": 1895,
        "end": 1898
      },
      "text": "དོན་ ༼གསེར་བྲིས།༽ མདོན་"
    },
    {
      "span": {
        "start": 2547,
        "end": 2551
      },
      "text": "གཡང་ ༼པེ། གསེར་བྲིས།༽ གཡའ་"
    },
    {
      "span": {
        "start": 2831,
        "end": 2833
      },
      "text": "ཏེ ༼པེ། གསེར་བྲིས།༽ སྟེ་"
    },
    {
      "span": {
        "start": 2851,
        "end": 2860
      },
      "text": "སྟོང་ཉིད་ ༼གསེར་བྲིས།༽ སྟོང་པ་ཉིད་"
    },
    {
      "span": {
        "start": 2865,
        "end": 2870
      },
      "text": "གླགས་ ༼པེ། གསེར་བྲིས།༽ ཀླག་"
    },
    {
      "span": {
        "start": 2925,
        "end": 2930
      },
      "text": "རྟགས་ ༼གསེར་བྲིས།༽ བརྟགས་"
    },
    {
      "span": {
        "start": 3029,
        "end": 3031
      },
      "text": "ཏེ་ ༼པེ། གསེར་བྲིས།༽ སྟེ་"
    },
    {
      "span": {
        "start": 3062,
        "end": 3067
      },
      "text": "གཟུང་ ༼གསེར་བྲིས།༽ གཟུངས་"
    },
    {
      "span": {
        "start": 3562,
        "end": 3566
      },
      "text": "ཐོག་ ༼གསེར་བྲིས།༽ ཐོགས་"
    },
    {
      "span": {
        "start": 3832,
        "end": 3836
      },
      "text": "གུད་ ༼གསེར་བྲིས།༽ གུང་"
    },
    {
      "span": {
        "start": 4050,
        "end": 4053
      },
      "text": "ཆོད་ཚད་ ༼པེ།༽ ཆོད་ཚད་ ༼གསེར་བྲིས།༽ ཚར་ཚད་"
    },
    {
      "span": {
        "start": 4089,
        "end": 4094
      },
      "text": "དངངས་ ༼གསེར་བྲིས།༽ དངས་"
    },
    {
      "span": {
        "start": 4131,
        "end": 4136
      },
      "text": "སྐྲག་ ༼པེ།༽ བཅག་ ༼གསེར་བྲིས།༽ བཀྲ་"
    },
    {
      "span": {
        "start": 4342,
        "end": 4346
      },
      "text": "གཟི་ ༼གསེར་བྲིས།༽ གཟིགས་"
    },
    {
      "span": {
        "start": 4480,
        "end": 4484
      },
      "text": "བྲོ་ ༼པེ།༽ བློ་བརྟེན་ ༼གསེར་བྲིས།༽ བློ་བརྟན་"
    },
    {
      "span": {
        "start": 4570,
        "end": 4574
      },
      "text": "བེམ་ ༼པེ། གསེར་བྲིས།༽ བེམས་"
    },
    {
      "span": {
        "start": 4617,
        "end": 4621
      },
      "text": "བེམ་ ༼པེ། གསེར་བྲིས།༽ བེམས་"
    },
    {
      "span": {
        "start": 4783,
        "end": 4787
      },
      "text": "བེམ་ ༼པེ། གསེར་བྲིས།༽ བེམས་"
    },
    {
      "span": {
        "start": 5362,
        "end": 5365
      },
      "text": "ཡིས་ ༼གསེར་བྲིས།༽ ཡིན་"
    }
  ]
}