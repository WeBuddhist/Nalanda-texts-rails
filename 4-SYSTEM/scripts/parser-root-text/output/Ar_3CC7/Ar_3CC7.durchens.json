{
  "durchens": [
    {
      "span": {
        "start": 40,
        "end": 42
      },
      "text": "ཏ་ ༼པེ། གསེར་བྲིས།༽ ཏ།"
    },
    {
      "span": {
        "start": 56,
        "end": 59
      },
      "text": "ཙྩ་ ༼པེ། གསེར་བྲིས།༽ ཚ་"
    },
    {
      "span": {
        "start": 139,
        "end": 141
      },
      "text": "བ། ༼པེ། གསེར་བྲིས།༽ བ། །"
    },
    {
      "span": {
        "start": 215,
        "end": 219
      },
      "text": "ལོག ༼གསེར་བྲིས།༽ ལོགས་"
    },
    {
      "span": {
        "start": 526,
        "end": 531
      },
      "text": "བཅོས་ ༼གསེར་བྲིས།༽ བཙད་ ༼པེ།༽ བཅོས་"
    },
    {
      "span": {
        "start": 1766,
        "end": 1771
      },
      "text": "རྙེད་ ༼པེ། གསེར་བྲིས།༽ བརྙེད་"
    },
    {
      "span": {
        "start": 1895,
        "end": 1898
      },
      "text": "དོན་ ༼གསེར་བྲིས།༽ མདོན་"
    },
    {
      "span": {
        "start": 2547,
        "end": 2551
      },
      "text": "གཡང་ ༼པེ། གསེར་བྲིས།༽ གཡའ་"
    },
    {
      "span": {
        "start": 2831,
        "end": 2833
      },
      "text": "ཏེ ༼པེ། གསེར་བྲིས།༽ སྟེ་"
    },
    {
      "span": {
        "start": 2851,
        "end": 2860
      },
      "text": "སྟོང་ཉིད་ ༼གསེར་བྲིས།༽ སྟོང་པ་ཉིད་"
    },
    {
      "span": {
        "start": 2865,
        "end": 2870
      },
      "text": "གླགས་ ༼པེ། གསེར་བྲིས།༽ ཀླག་"
    },
    {
      "span": {
        "start": 2925,
        "end": 2930
      },
      "text": "རྟགས་ ༼གསེར་བྲིས།༽ བརྟགས་"
    },
    {
      "span": {
        "start": 3029,
        "end": 3031
      },
      "text": "ཏེ་ ༼པེ། གསེར་བྲིས།༽ སྟེ་"
    },
    {
      "span": {
        "start": 3062,
        "end": 3067
      },
      "text": "གཟུང་ ༼གསེར་བྲིས།༽ གཟུངས་"
    },
    {
      "span": {
        "start": 3562,
        "end": 3566
      },
      "text": "ཐོག་ ༼གསེར་བྲིས།༽ ཐོགས་"
    },
    {
      "span": {
        "start": 3832,
        "end": 3836
      },
      "text": "གུད་ ༼གསེར་བྲིས།༽ གུང་"
    },
    {
      "span": {
        "start": 4050,
        "end": 4053
      },
      "text": "ཆོད་ཚད་ ༼པེ།༽ ཆོད་ཚད་ ༼གསེར་བྲིས།༽ ཚར་ཚད་"
    },
    {
      "span": {
        "start": 4089,
        "end": 4094
      },
      "text": "དངངས་ ༼གསེར་བྲིས།༽ དངས་"
    },
    {
      "span": {
        "start": 4131,
        "end": 4136
      },
      "text": "སྐྲག་ ༼པེ།༽ བཅག་ ༼གསེར་བྲིས།༽ བཀྲ་"
    },
    {
      "span": {
        "start": 4342,
        "end": 4346
      },
      "text": "གཟི་ ༼གསེར་བྲིས།༽ གཟིགས་"
    },
    {
      "span": {
        "start": 4480,
        "end": 4484
      },
      "text": "བྲོ་ ༼པེ།༽ བློ་བརྟེན་ ༼གསེར་བྲིས།༽ བློ་བརྟན་"
    },
    {
      "span": {
        "start": 4570,
        "end": 4574
      },
      "text": "བེམ་ ༼པེ། གསེར་བྲིས།༽ བེམས་"
    },
    {
      "span": {
        "start": 4617,
        "end": 4621
      },
      "text": "བེམ་ ༼པེ། གསེར་བྲིས།༽ བེམས་"
    },
    {
      "span": {
        "start": 4783,
        "end": 4787
      },
      "text": "བེམ་ ༼པེ། གསེར་བྲིས།༽ བེམས་"
    },
    {
      "span": {
        "start": 5362,
        "end": 5365
      },
      "text": "ཡིས་ ༼གསེར་བྲིས།༽ ཡིན་"
    },
    {
      "span": {
        "start": 6166,
        "end": 6170
      },
      "text": "སྣར་ཐང་བསྟན་འགྱུར། མདོ་འགྲེལ། ༼ཉོ༽ ཤོག་གྲངས་ ༣༩༦བ༦ ནས་ ༣༩༩ན༥ བར་བཞུགས།"
    },
    {
      "span": {
        "start": 6223,
        "end": 6228
      },
      "text": "ཕྱི་ལོ་ ༢༠༠༨ ལོར་བསམ་འགྲུབ་ཀྱིས་ཉར་ཚགས་བྱས་པའི་སྡེ་དགེའི་དམངས་ཁྲོད་ཀྱི་གནའ་དཔེ་བྲིས་མའི་གློག་རྡུལ་འདྲ་བཤུས།​ པོད། ༼༦༽ ​གཅོད་སྐོར་ཆོས་ཚན་ ༢༧ པ། ཁམས་བྲིས་དཔེ་རིང་ཤོག་བུ་དྲུག་ཅན་དང་གཞུང་གཅིག་ཀྱང་འདིར་མཆན་དང་བཅས་ཤིང་། མཇུག་བྱང་ལས། ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཚིགས་བཅད་ཆེན་མོ་ཞེས་བྱ་བ། བྲམ་ཟེ་ཨཱརྱ་དེ་ཝ་ཞེས་བྱ་བས་གསུངས་པ་རྫོགས་སོ། །རྒྱ་གར་གྱི་པཎྜི་ཏ་དམ་པ་རིན་པོ་ཆེ་དང་། ཞྭ་མ་ལོ་ཙཱས་སྒྲ་རང་འགྱུར་དུ་དིང་རིར་བསྒྱུར་ཅིང་ཞུས་ཏེ་གཏན་ལ་ཕབ་པའོ། །ཞེས་སྒྲ་སྒྱུར་ལོ་པཎ་གྱི་མཚན་མི་འདྲ་བ་འབྱུང་ངོ་།།"
    }
  ]
}