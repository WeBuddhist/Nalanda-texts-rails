{
  "durchens": [
    {
      "span": {
        "start": 187,
        "end": 196
      },
      "text": "བསྐྱེད་པ། ༼སྣར། པེ།༽ སྐྱེ་བ།"
    },
    {
      "span": {
        "start": 224,
        "end": 228
      },
      "text": "གི ། ༼སྣར། པེ།༽ ནི། །"
    },
    {
      "span": {
        "start": 363,
        "end": 373
      },
      "text": "བསྡུས་བྱས། ༼སྣར། པེ།༽ བསྡུ་བྱ།"
    },
    {
      "span": {
        "start": 587,
        "end": 595
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 643,
        "end": 649
      },
      "text": "རིག་པ་ ༼སྣར།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 655,
        "end": 662
      },
      "text": "དེ་ལྟར་ ༼ཅོ། སྡེ།༽ དེ་ལྟས་"
    },
    {
      "span": {
        "start": 665,
        "end": 669
      },
      "text": "པོར་ ༼སྣར། པེ།༽ པོ་"
    },
    {
      "span": {
        "start": 696,
        "end": 704
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 722,
        "end": 731
      },
      "text": "གཅིག་རྐྱ་ ༼སྣར། པེ།༽ ཅིག་ཀྱང་"
    },
    {
      "span": {
        "start": 737,
        "end": 746
      },
      "text": "གཞན་གྱིས་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 798,
        "end": 802
      },
      "text": "མཚན་ ༼སྣར། པེ།༽ ཚན་"
    },
    {
      "span": {
        "start": 812,
        "end": 815
      },
      "text": "ཡོ་ ༼སྣར། པེ།༽ ཡོང་"
    },
    {
      "span": {
        "start": 851,
        "end": 853
      },
      "text": "ལ། ༼སྣར།༽ ནབ ༼པེ།༽ ན།"
    },
    {
      "span": {
        "start": 862,
        "end": 872
      },
      "text": "ཚོགས་ཀྱིས་ ༼སྣར།༽ ཚོགས་ཀྱི་"
    },
    {
      "span": {
        "start": 899,
        "end": 905
      },
      "text": "བཅས་པ་ ༼སྣར། པེ།༽ ཆས་པ་"
    },
    {
      "span": {
        "start": 957,
        "end": 959
      },
      "text": "བ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 1010,
        "end": 1019
      },
      "text": "ལྟ་བུ་ཡི། ༼སྣར། པེ།༽ ལྟ་བུ་ཡིས།"
    },
    {
      "span": {
        "start": 1088,
        "end": 1093
      },
      "text": "འཇིག་ ༼སྣར།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 1187,
        "end": 1191
      },
      "text": "བབས་ ༼སྣར། པེ།༽ འབབ་"
    },
    {
      "span": {
        "start": 1319,
        "end": 1327
      },
      "text": "འཕྲོད་པ་ ༼སྣར། པེ།༽ འཕྲོད་པར་"
    },
    {
      "span": {
        "start": 1401,
        "end": 1409
      },
      "text": "ཤེས་ཉེན་ ༼སྣར། པེ།༽ བཤེས་གཉེན་"
    },
    {
      "span": {
        "start": 1473,
        "end": 1479
      },
      "text": "བརྟེན། ༼སྣར། པེ།༽ བསྟེན།"
    },
    {
      "span": {
        "start": 1495,
        "end": 1503
      },
      "text": "འབྲེལ་པ་ ༼པེ།༽ འབྲལ་བ་"
    },
    {
      "span": {
        "start": 1521,
        "end": 1527
      },
      "text": "ཅི་རུ་ ༼སྣར། པེ།༽ ཅི་ཞིག་"
    },
    {
      "span": {
        "start": 1691,
        "end": 1698
      },
      "text": "ཕུང་བར་ ༼སྣར། པེ།༽ འཕུང་བ་"
    },
    {
      "span": {
        "start": 1740,
        "end": 1748
      },
      "text": "བཅས་པའི་ ༼སྣར། པེ།༽ ཆས་པའི་"
    },
    {
      "span": {
        "start": 1748,
        "end": 1756
      },
      "text": "ལས་ཀྱིས་ ༼སྣར། པེ།༽ ལས་ཀྱི་"
    },
    {
      "span": {
        "start": 1765,
        "end": 1778
      },
      "text": "སྲིན་བུ་པད་པ་ ༼སྣར། པེ།༽ སྲིན་བུ་པདྨ་"
    },
    {
      "span": {
        "start": 1829,
        "end": 1834
      },
      "text": "གཏིང་ ༼སྣར། པེ།༽ རྟིང་"
    },
    {
      "span": {
        "start": 1880,
        "end": 1885
      },
      "text": "གཏིང་ ༼སྣར། པེ།༽ རྟིང་"
    },
    {
      "span": {
        "start": 1911,
        "end": 1919
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 1940,
        "end": 1948
      },
      "text": "གཞན་གྱི་ ༼པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 2030,
        "end": 2034
      },
      "text": "མདས་ ༼སྣར། པེ།༽ མདའ་"
    },
    {
      "span": {
        "start": 2064,
        "end": 2070
      },
      "text": "མཁྱུད་ ༼སྣར། པེ།༽ འཁྱུད་"
    },
    {
      "span": {
        "start": 2106,
        "end": 2114
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 2134,
        "end": 2142
      },
      "text": "སྦྱོར་བ་ ༼སྣར། པེ།༽ སྦྱར་བ་"
    },
    {
      "span": {
        "start": 2142,
        "end": 2145
      },
      "text": "ཡི། ༼པེ།༽ ཡིས།"
    },
    {
      "span": {
        "start": 2256,
        "end": 2259
      },
      "text": "ཚེ། ༼སྣར། པེ།༽ རྩེ།"
    },
    {
      "span": {
        "start": 2261,
        "end": 2271
      },
      "text": "འཐོར་རླུང་ ༼སྣར། པེ།༽ ཐོར་འཐུང་"
    },
    {
      "span": {
        "start": 2276,
        "end": 2281
      },
      "text": "ཀྱིས་ ༼སྣར། པེ།༽ ཀྱི་"
    },
    {
      "span": {
        "start": 2284,
        "end": 2288
      },
      "text": "སོད་ ༼སྣར། པེ།༽ གསོད་"
    },
    {
      "span": {
        "start": 2300,
        "end": 2311
      },
      "text": "སྐྱེས་བུའང་ ༼སྣར། པེ།༽ སྐྱེས་བུ་"
    },
    {
      "span": {
        "start": 2391,
        "end": 2396
      },
      "text": "བསྟན་ ༼སྣར། པེ།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 2416,
        "end": 2424
      },
      "text": "གཡོན་ཅན་ ༼སྣར། པེ།༽ གཡོ་ཅན་"
    },
    {
      "span": {
        "start": 2508,
        "end": 2522
      },
      "text": "སྒྲ་སྒྲོགས་པར། ༼སྣར། པེ།༽ སྒྲ་སྒྲོག་པ།"
    },
    {
      "span": {
        "start": 2664,
        "end": 2674
      },
      "text": "ཕྱིར་རྗེས་ ༼སྣར། པེ།༽ ཕྱི་རྗེས་"
    },
    {
      "span": {
        "start": 2680,
        "end": 2685
      },
      "text": "ལྟ་བ་ ༼སྣར།༽ བལྟ་བ་"
    },
    {
      "span": {
        "start": 2730,
        "end": 2739
      },
      "text": "བརྟན་ཞིང་ ༼སྣར། པེ།༽ བརྟན་པའི་"
    },
    {
      "span": {
        "start": 2837,
        "end": 2846
      },
      "text": "སྙན་དངགས་ ༼སྣར། པེ།༽ སྙན་ངག་"
    },
    {
      "span": {
        "start": 2862,
        "end": 2866
      },
      "text": "ཡུལ་ ༼སྣར། པེ།༽ གཡུལ་"
    },
    {
      "span": {
        "start": 2870,
        "end": 2872
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 2905,
        "end": 2912
      },
      "text": "ལྟ་བུར། ༼སྣར། པེ།༽ ལྟ་བུ།"
    },
    {
      "span": {
        "start": 3035,
        "end": 3043
      },
      "text": "མཁོས་སུ་ ༼སྣར། པེ།༽ འཁོས་ལ་"
    },
    {
      "span": {
        "start": 3221,
        "end": 3226
      },
      "text": "གཡུལ་ ༼སྣར། པེ།༽ གཞུང་"
    },
    {
      "span": {
        "start": 3364,
        "end": 3370
      },
      "text": "མཁས་པ་ ༼སྣར། པེ།༽ མཁས་པས་"
    },
    {
      "span": {
        "start": 3417,
        "end": 3422
      },
      "text": "འཁྲི་ ༼སྣར། པེ།༽ མཁྲི་"
    },
    {
      "span": {
        "start": 3448,
        "end": 3454
      },
      "text": "འཁྲིས་ ༼སྣར། པེ།༽ མཁྲིས་"
    },
    {
      "span": {
        "start": 3489,
        "end": 3496
      },
      "text": "དོགས་པ་ ༼སྣར།༽ དོག་པ་"
    },
    {
      "span": {
        "start": 3575,
        "end": 3609
      },
      "text": "ངག་གིས་ཀུན་དང་མཐུན་པར་བྱ། །ངག་གིས་ ༼སྣར། པེ།༽ ངག་གིས་"
    },
    {
      "span": {
        "start": 3647,
        "end": 3657
      },
      "text": "སྤྱོད་པའང་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 3759,
        "end": 3767
      },
      "text": "ཀྱི་གུམ་ ༼སྣར།༽ ནི་རྐུམ་ ༼པེ།༽ ནི་བརྐུམ་"
    },
    {
      "span": {
        "start": 3811,
        "end": 3818
      },
      "text": "སོད་པར་ ༼སྣར། པེ།༽ གསོད་པར་"
    },
    {
      "span": {
        "start": 3925,
        "end": 3931
      },
      "text": "གསད་པ་ ༼ཅོ།༽ གསད་གསོད་པ་ ༼སྣར།༽ གསད་གསད་པར་ ༼པེ།༽ གསད་སད་པར་"
    },
    {
      "span": {
        "start": 4122,
        "end": 4125
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེར་"
    },
    {
      "span": {
        "start": 4153,
        "end": 4177
      },
      "text": "དེ་དག་གཙོར་བརྟག་གོ། །གང་ ༼སྣར།༽ དེ་དག་བརྩོན་བརྟག །གང་ ༼པེ།༽ དེ་དག་བརྩོན་བརྟག་གོ། །གང་"
    },
    {
      "span": {
        "start": 4275,
        "end": 4281
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 4370,
        "end": 4381
      },
      "text": "དྲག་པོ་ཡིས་ ༼སྣར། པེ།༽ དྲག་པོ་ཡི་"
    },
    {
      "span": {
        "start": 4469,
        "end": 4480
      },
      "text": "མི་གཙང་བའི། ༼སྣར། པེ།༽ མི་གཙང་བ།"
    },
    {
      "span": {
        "start": 4489,
        "end": 4496
      },
      "text": "འཛུར་བ་ ༼སྣར། པེ།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 4500,
        "end": 4504
      },
      "text": "ལྟར། ༼སྣར། པེ།༽ སྔར།"
    },
    {
      "span": {
        "start": 4603,
        "end": 4610
      },
      "text": "མཆོང་བ་ ༼སྣར། པེ།༽ འཕྱོང་བ་"
    },
    {
      "span": {
        "start": 4692,
        "end": 4699
      },
      "text": "བསིལ་བ་ ༼སྣར། པེ།༽ བསིལ་བའི་"
    },
    {
      "span": {
        "start": 4773,
        "end": 4777
      },
      "text": "ཚིག་ ༼སྣར།༽ ཚིགས་"
    },
    {
      "span": {
        "start": 4783,
        "end": 4787
      },
      "text": "སུས་ ༼སྣར། པེ།༽ སུ་"
    },
    {
      "span": {
        "start": 4790,
        "end": 4796
      },
      "text": "བསྔགས། ༼སྣར།༽ སྔགས།"
    },
    {
      "span": {
        "start": 4805,
        "end": 4815
      },
      "text": "ཁམས་འཁྲུག་ ༼སྣར། པེ།༽ འཁམས་འཁྲུགས་"
    },
    {
      "span": {
        "start": 4833,
        "end": 4840
      },
      "text": "ཞིམ་པོ་ ༼སྣར། པེ།༽ ཞིམ་ཡང་"
    },
    {
      "span": {
        "start": 5026,
        "end": 5032
      },
      "text": "དེ་ཡང་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 5078,
        "end": 5083
      },
      "text": "སྲེག་ ༼སྣར།༽ བསྲེག་"
    },
    {
      "span": {
        "start": 5151,
        "end": 5159
      },
      "text": "རྩོམ་པར་ ༼སྣར། པེ།༽ བརྩོན་པར་"
    },
    {
      "span": {
        "start": 5208,
        "end": 5212
      },
      "text": "ཁོང་ ༼སྣར། པེ།༽ ཁོན་"
    },
    {
      "span": {
        "start": 5228,
        "end": 5233
      },
      "text": "བཤེས་ ༼སྣར། པེ།༽ གཤེས་"
    },
    {
      "span": {
        "start": 5386,
        "end": 5393
      },
      "text": "ཅན་སྟག་ ༼སྣར། པེ།༽ འཆང་རྟག་"
    },
    {
      "span": {
        "start": 5402,
        "end": 5417
      },
      "text": "དེ་བས་ཡིད་བརྟན་ ༼སྣར། པེ།༽ དེ་དག་གཏན་"
    },
    {
      "span": {
        "start": 5444,
        "end": 5452
      },
      "text": "དགའ་བའི་ ༼སྣར། པེ།༽ དག་པའི་"
    },
    {
      "span": {
        "start": 5475,
        "end": 5484
      },
      "text": "ཕན་འགྱུར་ ༼སྣར།༽ ཕམ་གྱུར་ ༼པེ།༽ ཕན་གྱུར་"
    },
    {
      "span": {
        "start": 5657,
        "end": 5662
      },
      "text": "གཉེན་ ༼སྣར། པེ།༽ མཉེས་"
    },
    {
      "span": {
        "start": 5683,
        "end": 5689
      },
      "text": "དེས་པ་ ༼སྣར། པེ།༽ དེས་པས་"
    },
    {
      "span": {
        "start": 5737,
        "end": 5746
      },
      "text": "སྤྱོད་པར་ ༼སྣར། པེ།༽ བཅད་པར་"
    },
    {
      "span": {
        "start": 5777,
        "end": 5789
      },
      "text": "བློ་ལྡན་དཔའ། ༼སྣར། པེ།༽ བློ་ལྡན་པ།"
    },
    {
      "span": {
        "start": 5812,
        "end": 5816
      },
      "text": "གཟོ། ༼སྣར། པེ།༽ བཟོ།"
    },
    {
      "span": {
        "start": 6031,
        "end": 6039
      },
      "text": "རྟེན་པར་ ༼སྣར། པེ།༽ སྟེན་པར་"
    },
    {
      "span": {
        "start": 6056,
        "end": 6061
      },
      "text": "བརྐམ་ ༼སྣར། པེ།༽ རྐམ་"
    },
    {
      "span": {
        "start": 6088,
        "end": 6093
      },
      "text": "ཆད་པ་ ༼སྣར། པེ།༽ བཅད་པ་"
    },
    {
      "span": {
        "start": 6142,
        "end": 6147
      },
      "text": "རྟེན་ ༼སྣར།༽ བརྟེན་ ༼པེ།༽ སྟེན་"
    },
    {
      "span": {
        "start": 6159,
        "end": 6163
      },
      "text": "སྒོ་ ༼སྣར། པེ།༽ རྒོད་"
    },
    {
      "span": {
        "start": 6173,
        "end": 6178
      },
      "text": "རྨོས་ ༼སྣར། པེ།༽ སྨོས་"
    },
    {
      "span": {
        "start": 6185,
        "end": 6192
      },
      "text": "ལོ་ཏོག་ ༼སྣར། པེ།༽ ལོ་ཐོག་"
    },
    {
      "span": {
        "start": 6257,
        "end": 6263
      },
      "text": "གདུངས་ ༼སྣར། པེ།༽ གདུང་"
    },
    {
      "span": {
        "start": 6287,
        "end": 6297
      },
      "text": "ལྡན་པ་ཡིས། ༼སྣར། པེ།༽ ལྡན་པ་ཡི།"
    },
    {
      "span": {
        "start": 6299,
        "end": 6307
      },
      "text": "ས་ཕྱོགས་ ༼སྣར།༽ ས་ཕྱོགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 6393,
        "end": 6399
      },
      "text": "གནས་ས་ ༼སྣར། པེ།༽ མིག་རྣམས་"
    },
    {
      "span": {
        "start": 6401,
        "end": 6408
      },
      "text": "བྱེ་བར། ༼སྣར། པེ།༽ བྱེ་བ།"
    },
    {
      "span": {
        "start": 6446,
        "end": 6451
      },
      "text": "འགྲས་ ༼སྣར།༽ འགྲེས་ ༼པེ།༽ འདྲས་"
    },
    {
      "span": {
        "start": 6462,
        "end": 6469
      },
      "text": "དགྲ་བོ་ ༼སྣར།༽ དགྲ་དགའོ་"
    },
    {
      "span": {
        "start": 6491,
        "end": 6496
      },
      "text": "ཟ་བས་ ༼སྣར། པེ།༽ ཟླ་བའི་"
    },
    {
      "span": {
        "start": 6581,
        "end": 6585
      },
      "text": "རྦད་ ༼སྣར། པེ།༽ སྦད་"
    },
    {
      "span": {
        "start": 6619,
        "end": 6627
      },
      "text": "སྨྲས་པས། ༼སྣར། པེ།༽ སྨྲས་པ།"
    },
    {
      "span": {
        "start": 6673,
        "end": 6678
      },
      "text": "བྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 6684,
        "end": 6692
      },
      "text": "ལས་ཀྱིས་ ༼སྣར། པེ།༽ ལས་ཀྱི་"
    },
    {
      "span": {
        "start": 6700,
        "end": 6705
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 6714,
        "end": 6721
      },
      "text": "གསང་བས་ ༼སྣར། པེ།༽ བསངས་པས་"
    },
    {
      "span": {
        "start": 6728,
        "end": 6735
      },
      "text": "སློབ་མ་ ༼སྣར། པེ།༽ སློབ་པ་"
    },
    {
      "span": {
        "start": 6742,
        "end": 6750
      },
      "text": "བློན་པོ་ ༼སྣར། པེ།༽ བླུན་པོ་"
    },
    {
      "span": {
        "start": 6784,
        "end": 6795
      },
      "text": "བྱེད་པ་སྟེ། ༼སྣར། པེ།༽ བྱེད་པ་དེ།"
    },
    {
      "span": {
        "start": 6987,
        "end": 6992
      },
      "text": "སྤྱད། ༼སྣར།༽ དབྱེད ༼པེ།༽ དཔྱད།"
    },
    {
      "span": {
        "start": 7000,
        "end": 7007
      },
      "text": "རྒས་རབ་ ༼སྣར། པེ།༽ རྒན་རབས་"
    },
    {
      "span": {
        "start": 7115,
        "end": 7119
      },
      "text": "སོག་ ༼སྣར། པེ།༽ ལོག་"
    },
    {
      "span": {
        "start": 7143,
        "end": 7151
      },
      "text": "གྱི་དོན་ ༼སྣར།༽ གྱི་ནོར་ ༼པེ།༽ གྱིས་ནོར་"
    },
    {
      "span": {
        "start": 7239,
        "end": 7246
      },
      "text": "འདོད་པ། ༼སྣར། པེ།༽ འདོད་པའི།"
    },
    {
      "span": {
        "start": 7248,
        "end": 7254
      },
      "text": "ཕུང་བ་ ༼སྣར། པེ།༽ འཕུང་བ་"
    },
    {
      "span": {
        "start": 7260,
        "end": 7269
      },
      "text": "འགྱུར་བར་ ༼པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 7289,
        "end": 7299
      },
      "text": "ཟོས་པ་ཡིས། ༼སྣར། པེ།༽ ཟོས་པ་ཡི།"
    },
    {
      "span": {
        "start": 7348,
        "end": 7354
      },
      "text": "བརྟེན་ ༼པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 7396,
        "end": 7400
      },
      "text": "བཙན་ ༼སྣར། པེ།༽ བརྩན་"
    },
    {
      "span": {
        "start": 7451,
        "end": 7454
      },
      "text": "ཁང་ ༼སྣར། པེ།༽ གྲག །འཁོར་"
    },
    {
      "span": {
        "start": 7469,
        "end": 7473
      },
      "text": "གྱུ་ ༼སྣར། པེ།༽ སྒྱུ་"
    },
    {
      "span": {
        "start": 7488,
        "end": 7496
      },
      "text": "ཚོལ་འཇར་ ༼སྣར། པེ།༽ འཚལ་གཞན་"
    },
    {
      "span": {
        "start": 7503,
        "end": 7513
      },
      "text": "སྒྲུབ་པའི་ ༼སྣར། པེ།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 7637,
        "end": 7641
      },
      "text": "ཕུང་ ༼སྣར། པེ།༽ འཕུང་"
    },
    {
      "span": {
        "start": 7728,
        "end": 7735
      },
      "text": "བསྡོངས་ ༼སྣར། པེ།༽ སྟངས་"
    },
    {
      "span": {
        "start": 7755,
        "end": 7759
      },
      "text": "རླག་ ༼སྣར། པེ།༽ བརླག་"
    },
    {
      "span": {
        "start": 7924,
        "end": 7932
      },
      "text": "རྐྱ་ཡང་། ༼སྣར། པེ།༽ གིས་ཀྱང་།"
    },
    {
      "span": {
        "start": 7952,
        "end": 7960
      },
      "text": "གྲུབ་པར་ ༼སྣར། པེ།༽ འགྲུབ་པར་"
    },
    {
      "span": {
        "start": 8038,
        "end": 8046
      },
      "text": "ཚོགས་པར་ ༼སྣར། པེ།༽ འཚོགས་པར་"
    },
    {
      "span": {
        "start": 8185,
        "end": 8192
      },
      "text": "བཙལ་བར་ ༼སྣར། པེ།༽ བརྩལ་བར་"
    },
    {
      "span": {
        "start": 8197,
        "end": 8203
      },
      "text": "གང་དག་ ༼སྣར། པེ།༽ གང་གཱ་"
    },
    {
      "span": {
        "start": 8287,
        "end": 8295
      },
      "text": "མཛའ་བོར་ ༼སྣར། པེ།༽ མཛའ་བོ་"
    },
    {
      "span": {
        "start": 8395,
        "end": 8399
      },
      "text": "པའི་ ༼སྣར། པེ།༽ ལྟའི་"
    },
    {
      "span": {
        "start": 8428,
        "end": 8434
      },
      "text": "སྐྱེས་ ༼སྣར། པེ།༽ སྐྱེ་"
    },
    {
      "span": {
        "start": 8668,
        "end": 8680
      },
      "text": "ཁྲོ་བའི་ཡུས་ ༼སྣར།༽ ཁྲོ་བའི་ཕུས་ ༼པེ།༽ ཁྲོ་བོའི་ལུས་"
    },
    {
      "span": {
        "start": 8724,
        "end": 8728
      },
      "text": "བའི་ ༼པེ།༽ ཁྲོ་བོའི་"
    },
    {
      "span": {
        "start": 8746,
        "end": 8755
      },
      "text": "གདུལ་བའི་ ༼སྣར། པེ།༽ གདུང་བའི་"
    },
    {
      "span": {
        "start": 8768,
        "end": 8772
      },
      "text": "ཡོད་ ༼སྣར། པེ།༽ ཡངས་"
    },
    {
      "span": {
        "start": 8893,
        "end": 8900
      },
      "text": "ཆུ་བུར་ ༼སྣར།༽ ཆུ་བུམ་"
    },
    {
      "span": {
        "start": 9075,
        "end": 9087
      },
      "text": "དཔལ་ལྡན་པ། ། ༼སྣར། པེ།༽ དཔལ་ལྡན་པའོ།། །།"
    },
    {
      "span": {
        "start": 9119,
        "end": 9127
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ འགྱུར་བར་"
    },
    {
      "span": {
        "start": 9253,
        "end": 9262
      },
      "text": "དགྲ་བཅོམ་ ༼སྣར།༽ དྲག་བརྩོན་ ༼པེ།༽ ངག་བརྩོན་"
    },
    {
      "span": {
        "start": 9303,
        "end": 9309
      },
      "text": "སྤོང་། ༼སྣར། པེ།༽ སྤོངས།"
    },
    {
      "span": {
        "start": 9319,
        "end": 9328
      },
      "text": "གཡུལ་ངོར་ ༼སྣར། པེ།༽ གཡུལ་ངོ་"
    },
    {
      "span": {
        "start": 9406,
        "end": 9414
      },
      "text": "གཞོམ་པར་ ༼སྣར། པེ།༽ གཞོམ་པ་"
    },
    {
      "span": {
        "start": 9443,
        "end": 9452
      },
      "text": "བསྲེགས་པ་ ༼སྣར། པེ།༽ བསྲེག་པ་"
    },
    {
      "span": {
        "start": 9470,
        "end": 9475
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 9489,
        "end": 9492
      },
      "text": "དང་ ༼སྣར།༽ ལ་"
    },
    {
      "span": {
        "start": 9518,
        "end": 9524
      },
      "text": "བཀྲེན་ ༼སྣར།༽ བཀྲན་"
    },
    {
      "span": {
        "start": 9527,
        "end": 9531
      },
      "text": "ཅིས་ ༼སྣར། པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 9579,
        "end": 9586
      },
      "text": "བསྲེགས་ ༼སྣར། པེ།༽ སྲེགས་"
    },
    {
      "span": {
        "start": 9657,
        "end": 9666
      },
      "text": "ལྕགས་ཀྱོ་ ༼སྣར། པེ།༽ ལྕགས་ཀྱུ་"
    },
    {
      "span": {
        "start": 9758,
        "end": 9761
      },
      "text": "གླ་ ༼སྣར། པེ།༽ བལ་"
    },
    {
      "span": {
        "start": 9845,
        "end": 9853
      },
      "text": "ཞི་བ་ཡི། ༼སྣར། པེ།༽ ཞི་བ་ཡིས།"
    },
    {
      "span": {
        "start": 10053,
        "end": 10058
      },
      "text": "ཕྲེང་ ༼པེ།༽ འཕྲེང་"
    },
    {
      "span": {
        "start": 10080,
        "end": 10084
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིར་"
    },
    {
      "span": {
        "start": 10191,
        "end": 10198
      },
      "text": "གཞན་དག་ ༼སྣར། པེ།༽ གང་དག་"
    },
    {
      "span": {
        "start": 10237,
        "end": 10243
      },
      "text": "སྲེག ། ༼སྣར། པེ།༽ བསྲེག །"
    },
    {
      "span": {
        "start": 10289,
        "end": 10294
      },
      "text": "ཕུང་། ༼སྣར། པེ།༽ འཕུང་།"
    },
    {
      "span": {
        "start": 10579,
        "end": 10588
      },
      "text": "ལྕགས་ཀྱོ་ ༼སྣར། པེ།༽ ལྕགས་ཀྱུ་"
    },
    {
      "span": {
        "start": 10609,
        "end": 10617
      },
      "text": "དྲངས་ཏེ་ ༼སྣར། པེ།༽ དྲང་དེ་"
    },
    {
      "span": {
        "start": 10684,
        "end": 10698
      },
      "text": "དཔའ་བོ་ཚམ་ཚོམ་ ༼སྣར།༽ དཔའོ་ཙམ་ཙམ་ ༼པེ།༽ དཔའོ་ཅིམ་ཅམ་"
    },
    {
      "span": {
        "start": 10702,
        "end": 10707
      },
      "text": "རྩོམ་ ༼པེ།༽ བརྩོམ་"
    },
    {
      "span": {
        "start": 10775,
        "end": 10778
      },
      "text": "དང་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 10969,
        "end": 10973
      },
      "text": "བཙན་ ༼སྣར། པེ།༽ བརྩན་"
    },
    {
      "span": {
        "start": 11136,
        "end": 11141
      },
      "text": "གསོས། ༼སྣར། པེ།༽ གྱིས་གསོ།"
    },
    {
      "span": {
        "start": 11286,
        "end": 11294
      },
      "text": "འཛེགས་ན་ ༼སྣར། པེ།༽ འཛེགས་ནས་"
    },
    {
      "span": {
        "start": 11297,
        "end": 11299
      },
      "text": "པ་ ༼སྣར། པེ།༽ པའང་"
    },
    {
      "span": {
        "start": 11328,
        "end": 11340
      },
      "text": "ལུགས་ཆེན་པོ། ༼སྣར། པེ།༽ ལུགས་པོ་ཆེ།"
    },
    {
      "span": {
        "start": 11349,
        "end": 11356
      },
      "text": "ཕྲེང་བ་ ༼པེ།༽ འཕྲེང་བ་"
    },
    {
      "span": {
        "start": 11478,
        "end": 11485
      },
      "text": "འདོད་པ། ༼སྣར། པེ།༽ འདོད་པས།"
    },
    {
      "span": {
        "start": 11487,
        "end": 11494
      },
      "text": "དེ་ཡིས་ ༼པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 11509,
        "end": 11516
      },
      "text": "བྱས་པས། ༼སྣར། པེ།༽ བྱ་སྟེ།"
    },
    {
      "span": {
        "start": 11585,
        "end": 11591
      },
      "text": "བརྙེས་ ༼སྣར། པེ།༽ མཉེས་"
    },
    {
      "span": {
        "start": 11682,
        "end": 11688
      },
      "text": "བྱ་བར་ ༼སྣར།༽ བྱ་བར་འགྱུར་བར་ ༼པེ།༽ བྱ་བར་འགྱུར་བ་"
    },
    {
      "span": {
        "start": 11745,
        "end": 11751
      },
      "text": "སྒྲུབ་ ༼སྣར།༽ སྒྲུབས་"
    },
    {
      "span": {
        "start": 11838,
        "end": 11842
      },
      "text": "སརྦ་ ༼སྣར།༽ བྲརྦ་ ༼པེ།༽ བརྦ་"
    },
    {
      "span": {
        "start": 11878,
        "end": 11881
      },
      "text": "དེ་ ༼སྣར། པེ།༽ ལོཙྪ་བ་དགེ་སློང་"
    }
  ]
}