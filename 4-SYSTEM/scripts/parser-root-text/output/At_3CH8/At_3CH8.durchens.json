{
  "durchens": [
    {
      "span": {
        "start": 296,
        "end": 305
      },
      "text": "རྣམས་ཀྱི་ ༼པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 472,
        "end": 485
      },
      "text": "སེམས་ཅན་རྣམས་ ༼སྣར། པེ།༽ སེམས་ཅན་"
    },
    {
      "span": {
        "start": 663,
        "end": 674
      },
      "text": "བསྐྱེད་པའི་ ༼སྣར། པེ།༽ སྐྱེས་པའི་"
    },
    {
      "span": {
        "start": 714,
        "end": 718
      },
      "text": "བྱན་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 741,
        "end": 748
      },
      "text": "བསླབ་པ་ ༼པེ།༽ སླབ་པ་"
    },
    {
      "span": {
        "start": 753,
        "end": 761
      },
      "text": "ལས་ཀྱིས་ ༼སྣར། པེ།༽ ལས་ཀྱི་"
    },
    {
      "span": {
        "start": 1541,
        "end": 1550
      },
      "text": "བཏུས་ཀྱི་ ༼སྣར། པེ།༽ བཏུས་ཀྱིས་"
    },
    {
      "span": {
        "start": 2013,
        "end": 2019
      },
      "text": "པགས་པ་ ༼སྣར།༽ འཕགས་པ་"
    },
    {
      "span": {
        "start": 2118,
        "end": 2124
      },
      "text": "ཐོས་པ་ ༼ཅོ། སྡེ།༽ ཐས་པ་"
    },
    {
      "span": {
        "start": 2328,
        "end": 2339
      },
      "text": "བྱུང་བ་འདི་ ༼སྣར། པེ།༽ བྱུང་བའི་"
    },
    {
      "span": {
        "start": 2355,
        "end": 2363
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 2466,
        "end": 2474
      },
      "text": "བྱུང་བས་ ༼སྣར།༽ བྱང་བས་"
    },
    {
      "span": {
        "start": 2505,
        "end": 2519
      },
      "text": "ཚུལ་ཁྲིམས་ཀྱི་ ༼སྣར། པེ།༽ ཚུལ་ཁྲིམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 2626,
        "end": 2631
      },
      "text": "གཤིས་ ༼སྣར། པེ།༽ ཤིས་"
    },
    {
      "span": {
        "start": 2691,
        "end": 2699
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 2860,
        "end": 2867
      },
      "text": "འཇིག་པ་ ༼པེ།༽ འཇིགས་པ་"
    },
    {
      "span": {
        "start": 3127,
        "end": 3134
      },
      "text": "མཛངས་པ་ ༼སྣར།༽ འཛངས་པ་"
    },
    {
      "span": {
        "start": 3151,
        "end": 3157
      },
      "text": "དང་ཞེ་ ༼སྣར།༽ དང་ཞེས་"
    },
    {
      "span": {
        "start": 3281,
        "end": 3287
      },
      "text": "བསག་པ་ ༼སྣར། པེ།༽ བསགས་པ་"
    },
    {
      "span": {
        "start": 3403,
        "end": 3408
      },
      "text": "ཁྲིད་ ༼སྣར། པེ།༽ ཁྲིད་པ་"
    },
    {
      "span": {
        "start": 3757,
        "end": 3768
      },
      "text": "སྐྱེས་པ་དེ་ ༼སྣར། པེ།༽ སྐྱེས་པ་སྟེ་"
    },
    {
      "span": {
        "start": 4167,
        "end": 4174
      },
      "text": "སྨོན་པ་ ༼སྣར། པེ།༽ སྨྱོན་པ་"
    },
    {
      "span": {
        "start": 4374,
        "end": 4381
      },
      "text": "བྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 4875,
        "end": 4888
      },
      "text": "མནར་སེམས་ཀྱི་ ༼སྣར། པེ།༽ མནར་སེམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 4938,
        "end": 4948
      },
      "text": "འབྱུང་ངོ་། ༼སྣར། པེ།༽ འབྱུང་།"
    },
    {
      "span": {
        "start": 5390,
        "end": 5392
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 5473,
        "end": 5481
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 5489,
        "end": 5497
      },
      "text": "བསྲུང་བ་ ༼སྣར། པེ།༽ སྲུང་བ་"
    },
    {
      "span": {
        "start": 5983,
        "end": 5991
      },
      "text": "ཆུང་ངུས་ ༼སྣར། པེ།༽ ཆུང་ངུ་"
    },
    {
      "span": {
        "start": 6268,
        "end": 6276
      },
      "text": "འཁོར་བས་ ༼སྣར། པེ།༽ འཁོར་བ་"
    },
    {
      "span": {
        "start": 6398,
        "end": 6408
      },
      "text": "དེ་དག་གིས་ ༼སྣར། པེ།༽ དེ་དག་གི་"
    },
    {
      "span": {
        "start": 6480,
        "end": 6489
      },
      "text": "ཆེན་པོའི་ ༼སྣར།༽ ཆེན་མོའི་"
    },
    {
      "span": {
        "start": 6519,
        "end": 6526
      },
      "text": "གཅོད་པ་ ༼སྣར། པེ།༽ གཅད་པ་"
    },
    {
      "span": {
        "start": 6729,
        "end": 6736
      },
      "text": "བལྟ་བར་ ༼སྣར། པེ།༽ ལྟ་བར་"
    },
    {
      "span": {
        "start": 6750,
        "end": 6756
      },
      "text": "བླང་པ་ ༼སྣར། པེ།༽ བླངས་པ་"
    },
    {
      "span": {
        "start": 6822,
        "end": 6830
      },
      "text": "ཡུན་རིང་ ༼སྣར། པེ།༽ ཡུན་རིངས་"
    },
    {
      "span": {
        "start": 6857,
        "end": 6864
      },
      "text": "བྱེད་པ་ ༼སྣར། པེ།༽ བྱེད་པར་"
    },
    {
      "span": {
        "start": 6971,
        "end": 6975
      },
      "text": "བཟང་ ༼པེ།༽ བཟངས་"
    },
    {
      "span": {
        "start": 7063,
        "end": 7071
      },
      "text": "དོན་གྱི་ ༼སྣར། པེ།༽ དོན་གྱིས་"
    },
    {
      "span": {
        "start": 7280,
        "end": 7288
      },
      "text": "སྤྱོད་པ་ ༼སྣར། པེ།༽ དཔྱོད་པ་"
    },
    {
      "span": {
        "start": 7426,
        "end": 7435
      },
      "text": "དུ་མ་བྱས་ ༼སྣར། པེ།༽ དུ་བྱ་བ་"
    },
    {
      "span": {
        "start": 7486,
        "end": 7494
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 7707,
        "end": 7719
      },
      "text": "ཡེ་ཤེས་ཀྱིས་ ༼པེ།༽ ཡེ་ཤེས་ཀྱི་"
    }
  ]
}