{
  "durchens": [
    {
      "span": {
        "start": 3287,
        "end": 3300
      },
      "text": "གཞན་བརྗོད་དོ། ༼པེ།༽ གཞན་དུ་བརྗོད།"
    },
    {
      "span": {
        "start": 3309,
        "end": 3319
      },
      "text": "བསྒྲུབ་པར་ ༼པེ།༽ བསྒྲུབ་བྱར་"
    },
    {
      "span": {
        "start": 6127,
        "end": 6134
      },
      "text": "མི་ཡིན་ ༼པེ།༽ ནི་མཚོན་"
    },
    {
      "span": {
        "start": 6763,
        "end": 6767
      },
      "text": "དཔག་ ༼པེ།༽ དཔོག་"
    },
    {
      "span": {
        "start": 6971,
        "end": 6973
      },
      "text": "ན། ༼པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 8697,
        "end": 8703
      },
      "text": "མིན་པ་ ༼པེ།༽ མིན་"
    },
    {
      "span": {
        "start": 9832,
        "end": 9837
      },
      "text": "འདོད་ ༼པེ།༽ འདོད་པ་"
    },
    {
      "span": {
        "start": 9992,
        "end": 9998
      },
      "text": "མིན། ། ༼པེ།༽ ། །དེས་ན་"
    },
    {
      "span": {
        "start": 11887,
        "end": 11894
      },
      "text": "དེ་ལྟར་ ༼པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 13082,
        "end": 13088
      },
      "text": "ཐལ་བར་ ༼པེ།༽ ཐལ་"
    },
    {
      "span": {
        "start": 13294,
        "end": 13298
      },
      "text": "བསལ་ ༼པེ།༽ གསལ་"
    },
    {
      "span": {
        "start": 14420,
        "end": 14427
      },
      "text": "ཤེས་རང་ ༼པེ།༽ ཤེས་པར་"
    },
    {
      "span": {
        "start": 17699,
        "end": 17706
      },
      "text": "བསྒྲུབ་ ༼པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 18318,
        "end": 18323
      },
      "text": "རྗོད་ ༼པེ།༽ བརྗོད་"
    },
    {
      "span": {
        "start": 19958,
        "end": 19964
      },
      "text": "ད་ལྟར་ ༼པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 20370,
        "end": 20377
      },
      "text": "རྟགས་པ་ ༼པེ།༽ བཏགས་པ་"
    },
    {
      "span": {
        "start": 22111,
        "end": 22118
      },
      "text": "དེ་ལྟར་ ༼པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 24390,
        "end": 24399
      },
      "text": "ཁྱེད་མེད་ ༼པེ།༽ ཁྱད་མེད་"
    },
    {
      "span": {
        "start": 24820,
        "end": 24829
      },
      "text": "བརྗོད་མི། ༼པེ།༽ བརྗོད་མིན།"
    },
    {
      "span": {
        "start": 25259,
        "end": 25261
      },
      "text": "ན། ༼པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 25332,
        "end": 25340
      },
      "text": "སྐྱེས་པ་ ༼པེ།༽ སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 25478,
        "end": 25480
      },
      "text": "ན། ༼པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 25638,
        "end": 25643
      },
      "text": "རྗོད་ ༼པེ།༽ བརྗོད་"
    },
    {
      "span": {
        "start": 26695,
        "end": 26704
      },
      "text": "གཞན་གྱིས་ ༼པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 26775,
        "end": 26783
      },
      "text": "སྨྲ་བའི་ ༼པེ།༽ སྨྲ་བོའི་"
    },
    {
      "span": {
        "start": 26794,
        "end": 26801
      },
      "text": "གསུམ་མ། ༼པེ།༽ གསུམ་མོ།"
    },
    {
      "span": {
        "start": 27488,
        "end": 27491
      },
      "text": "སྣ་ ༼པེ།༽ སྣང་"
    },
    {
      "span": {
        "start": 27510,
        "end": 27513
      },
      "text": "ལན་ ༼པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 28042,
        "end": 28048
      },
      "text": "ནི་མི་ ༼པེ།༽ ནི་མ་"
    },
    {
      "span": {
        "start": 29129,
        "end": 29136
      },
      "text": "ཡོན་ཏན་ ༼པེ།༽ ཡོན་"
    }
  ]
}