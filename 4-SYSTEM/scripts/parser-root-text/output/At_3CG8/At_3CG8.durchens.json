{
  "durchens": [
    {
      "span": {
        "start": 278,
        "end": 284
      },
      "text": "བསོག ། ༼སྣར། པེ།༽ གསོག། །"
    },
    {
      "span": {
        "start": 388,
        "end": 394
      },
      "text": "བརྡེག་ ༼སྣར། པེ།༽ རྡེག་"
    },
    {
      "span": {
        "start": 412,
        "end": 426
      },
      "text": "བསྐྱེད་པ་ནི། ། ༼སྣར། པེ།༽ བསྐྱེད་པ་ནས །"
    },
    {
      "span": {
        "start": 432,
        "end": 439
      },
      "text": "མེ་ལྷར་ ༼སྣར། པེ།༽ མེ་ལྷ་"
    },
    {
      "span": {
        "start": 733,
        "end": 742
      },
      "text": "སྲེག་རྫས་ ༼སྣར། པེ།༽ བསྲེག་རྫས་"
    },
    {
      "span": {
        "start": 1004,
        "end": 1010
      },
      "text": "དགྱེད། ༼སྣར། པེ།༽ དགྱེས།"
    },
    {
      "span": {
        "start": 1294,
        "end": 1301
      },
      "text": "བསྲེག ། ༼སྣར། པེ།༽ སྲེག། །"
    },
    {
      "span": {
        "start": 1312,
        "end": 1322
      },
      "text": "སྦྱོང་བའི་ ༼སྣར། པེ།༽ སྦྱང་བའི་"
    },
    {
      "span": {
        "start": 1499,
        "end": 1504
      },
      "text": "མཐུན་ ༼སྣར། པེ།༽ འཐུན་"
    },
    {
      "span": {
        "start": 1518,
        "end": 1523
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 1564,
        "end": 1573
      },
      "text": "འབྱོན་པར་ ༼སྣར། པེ།༽ བྱོན་པར་"
    },
    {
      "span": {
        "start": 1587,
        "end": 1593
      },
      "text": "དམན་པ་ ༼སྣར། པེ།༽ དམན་མ་"
    },
    {
      "span": {
        "start": 1647,
        "end": 1654
      },
      "text": "མེ་ཡིས་ ༼སྣར། པེ།༽ མེ་ཡི་"
    }
  ]
}