{
  "durchens": [
    {
      "span": {
        "start": 183,
        "end": 191
      },
      "text": "མཉམ་སྟེ། ༼སྣར། པེ།༽ མཉམས་ཏེ།"
    },
    {
      "span": {
        "start": 211,
        "end": 221
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 507,
        "end": 510
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 703,
        "end": 708
      },
      "text": "གདུབ་ ༼སྣར། པེ།༽ རྡུབ་"
    },
    {
      "span": {
        "start": 884,
        "end": 887
      },
      "text": "དང་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 1203,
        "end": 1208
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 1431,
        "end": 1433
      },
      "text": "ཧ་ ༼སྣར། པེ།༽ ཧཱ་"
    },
    {
      "span": {
        "start": 1900,
        "end": 1907
      },
      "text": "མེད་པས་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 1990,
        "end": 1995
      },
      "text": "རྒྱན་ ༼སྣར། པེ།༽ བརྒྱན་"
    },
    {
      "span": {
        "start": 2009,
        "end": 2022
      },
      "text": "རས་སྐུད་ཀྱིས་ ༼སྣར། པེ།༽ རས་སྐུད་"
    },
    {
      "span": {
        "start": 2059,
        "end": 2068
      },
      "text": "དམར་པོའི་ ༼སྣར། པེ།༽ དམར་མོའི་"
    },
    {
      "span": {
        "start": 2080,
        "end": 2084
      },
      "text": "བཏབ་ ༼སྣར།༽ བདབ་"
    },
    {
      "span": {
        "start": 2124,
        "end": 2133
      },
      "text": "བཞུགས་སོ། ༼སྣར། པེ།༽ བཞུག་གོ།"
    },
    {
      "span": {
        "start": 2302,
        "end": 2305
      },
      "text": "ཐབ་ ༼སྣར། པེ།༽ ཐབས་"
    },
    {
      "span": {
        "start": 2516,
        "end": 2525
      },
      "text": "ལག་པ་གཡས་ ༼སྣར། པེ།༽ གཡས་"
    },
    {
      "span": {
        "start": 2886,
        "end": 2892
      },
      "text": "ཕུར་པ་ ༼སྣར། པེ།༽ ཕུར་པར་"
    },
    {
      "span": {
        "start": 3085,
        "end": 3088
      },
      "text": "ཏེ། ༼སྣར། པེ།༽ ཏེ། ཕྱོགས་བཅུར་ཁྱབ་པར་བལྟས་ཏེ་"
    },
    {
      "span": {
        "start": 3157,
        "end": 3164
      },
      "text": "ས་གཞིར་ ༼སྣར། པེ།༽ ས་གཞིའི་"
    },
    {
      "span": {
        "start": 3343,
        "end": 3346
      },
      "text": "ཐབ་ ༼སྣར། པེ།༽ ཐབས་"
    },
    {
      "span": {
        "start": 3484,
        "end": 3490
      },
      "text": "བསྔགས། ༼སྣར། པེ།༽ སྔགས།"
    },
    {
      "span": {
        "start": 3571,
        "end": 3574
      },
      "text": "ཐབ་ ༼སྣར། པེ།༽ ཐབས་"
    },
    {
      "span": {
        "start": 3589,
        "end": 3593
      },
      "text": "དང་། ༼སྣར། པེ།༽ བརྗོད་ཅིང་།"
    },
    {
      "span": {
        "start": 3631,
        "end": 3640
      },
      "text": "བསྐྲད་དོ། ༼སྣར།༽ བསྐྲད་དེ།"
    },
    {
      "span": {
        "start": 3656,
        "end": 3659
      },
      "text": "གང་ ༼སྣར། པེ།༽ གོང་"
    },
    {
      "span": {
        "start": 3717,
        "end": 3726
      },
      "text": "ཁྲུ་ཕྱེད་ ༼སྣར། པེ།༽ ཁྲུས་བྱེད་"
    },
    {
      "span": {
        "start": 3730,
        "end": 3737
      },
      "text": "ས་འབྲུ་ ༼སྣར། པེ།༽ ས་"
    },
    {
      "span": {
        "start": 3883,
        "end": 3890
      },
      "text": "སོར་མོ་ ༼སྣར། པེ།༽ སོར་མོའི་"
    },
    {
      "span": {
        "start": 3956,
        "end": 3962
      },
      "text": "གཤིབས་ ༼སྣར། པེ།༽ བཤིབས་"
    },
    {
      "span": {
        "start": 4210,
        "end": 4215
      },
      "text": "དག་པ་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 4805,
        "end": 4807
      },
      "text": "ན་ ༼སྣར། པེ།༽ ཏ་"
    },
    {
      "span": {
        "start": 5286,
        "end": 5294
      },
      "text": "བསྟིམ་པ་ ༼སྣར། པེ།༽ བསྟིམས་པ་"
    },
    {
      "span": {
        "start": 5359,
        "end": 5365
      },
      "text": "གཤིབས་ ༼སྣར། པེ།༽ བཤིབས་"
    },
    {
      "span": {
        "start": 5416,
        "end": 5418
      },
      "text": "ཀ་ ༼སྣར། པེ།༽ ཀི་"
    },
    {
      "span": {
        "start": 5450,
        "end": 5463
      },
      "text": "གཉིས་གཤིབས་ལ་ ༼སྣར། པེ།༽ གཉིས་བཤིབས་"
    },
    {
      "span": {
        "start": 5537,
        "end": 5545
      },
      "text": "གཤིབས་པ་ ༼སྣར། པེ།༽ བཤིབས་པ་"
    },
    {
      "span": {
        "start": 5680,
        "end": 5686
      },
      "text": "གཤིབས་ ༼སྣར། པེ།༽ བཤིབས་"
    },
    {
      "span": {
        "start": 5689,
        "end": 5697
      },
      "text": "བསྒྲེང་། ༼སྣར། པེ།༽ བསྒྲེངས།"
    },
    {
      "span": {
        "start": 5865,
        "end": 5870
      },
      "text": "སྟོད་ ༼སྣར། པེ།༽ བསྐྱོད་"
    },
    {
      "span": {
        "start": 5877,
        "end": 5885
      },
      "text": "བཀྲོལ་བ་ ༼སྣར། པེ།༽ བཀྲོལ་བར་"
    },
    {
      "span": {
        "start": 6146,
        "end": 6150
      },
      "text": "བཛྲ་ ༼སྣར། པེ།༽ ཙ། ཛ་"
    },
    {
      "span": {
        "start": 6290,
        "end": 6297
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ བསྐྱོད་"
    },
    {
      "span": {
        "start": 6362,
        "end": 6368
      },
      "text": "གཤིབས་ ༼སྣར། པེ།༽ བཤིབས་"
    },
    {
      "span": {
        "start": 6444,
        "end": 6467
      },
      "text": "བཀུག་པའི་ཐིག་ཐོག་བཙུགས་ ༼སྣར། པེ།༽ བཀུག་བ་ཐིང་ཐོ་གཙུགས་"
    },
    {
      "span": {
        "start": 6528,
        "end": 6535
      },
      "text": "ཨ་ནི་ལ་ ༼སྣར། པེ།༽ ཨ་ན་ལི་"
    },
    {
      "span": {
        "start": 6608,
        "end": 6615
      },
      "text": "གཏང་བར་ ༼སྣར། པེ།༽ བཏང་བར་"
    },
    {
      "span": {
        "start": 6641,
        "end": 6649
      },
      "text": "བལྟས་ཏོ་ ༼སྣར། པེ།༽ བལྟས་ཏེ་"
    },
    {
      "span": {
        "start": 6690,
        "end": 6696
      },
      "text": "གཤིབས་ ༼སྣར། པེ།༽ བཤིབས་"
    },
    {
      "span": {
        "start": 6839,
        "end": 6848
      },
      "text": "དྲངས་པའོ། ༼སྣར། པེ།༽ དྲང་བའོ།"
    },
    {
      "span": {
        "start": 6878,
        "end": 6882
      },
      "text": "གཏང་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 6981,
        "end": 6987
      },
      "text": "གཤིབས་ ༼སྣར། པེ།༽ བཤིབས་"
    },
    {
      "span": {
        "start": 7062,
        "end": 7068
      },
      "text": "གཞིབས་ ༼སྣར། པེ།༽ བཤིབས་"
    },
    {
      "span": {
        "start": 7192,
        "end": 7199
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ བསྐྱོད་"
    },
    {
      "span": {
        "start": 7371,
        "end": 7374
      },
      "text": "ཐི་ ༼སྣར། པེ།༽ ཏི་"
    },
    {
      "span": {
        "start": 7438,
        "end": 7444
      },
      "text": "གཤིབས་ ༼སྣར། པེ།༽ བཤིབས་"
    },
    {
      "span": {
        "start": 7488,
        "end": 7497
      },
      "text": "བཏང་བ་དང་ ༼སྣར། པེ།༽ བཏང་བ་"
    },
    {
      "span": {
        "start": 7511,
        "end": 7517
      },
      "text": "དགྲོལ་ ༼སྣར། པེ།༽ བཀྲོལ་"
    },
    {
      "span": {
        "start": 7558,
        "end": 7561
      },
      "text": "དྱ་ ༼སྣར། པེ།༽ རྒྱ་"
    },
    {
      "span": {
        "start": 7605,
        "end": 7615
      },
      "text": "བདུག་སྤོས་ ༼སྣར། པེ།༽ བདུག་པ་"
    },
    {
      "span": {
        "start": 7683,
        "end": 7688
      },
      "text": "བསུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 7699,
        "end": 7707
      },
      "text": "ཤིང་ཐོག་ ༼སྣར། པེ།༽ ཤིང་ཏོག་"
    },
    {
      "span": {
        "start": 7914,
        "end": 7922
      },
      "text": "གཏོར་བར་ ༼སྣར། པེ།༽ གཏོར་མ་"
    },
    {
      "span": {
        "start": 7964,
        "end": 7970
      },
      "text": "བརྟོད་ ༼སྣར། པེ།༽ བསྟོད་"
    },
    {
      "span": {
        "start": 7987,
        "end": 7993
      },
      "text": "ཤུག་པ་ ༼སྣར། པེ།༽ ཤུགས་པ་"
    },
    {
      "span": {
        "start": 8086,
        "end": 8091
      },
      "text": "གྱོན་ ༼སྣར། པེ།༽ གྱོན་པ་"
    },
    {
      "span": {
        "start": 8184,
        "end": 8193
      },
      "text": "རྫོགས་པར་ ༼སྣར། པེ།༽ རྫོགས་པ་"
    },
    {
      "span": {
        "start": 8203,
        "end": 8209
      },
      "text": "བཀླགས་ ༼སྣར། པེ།༽ ཀླགས་"
    },
    {
      "span": {
        "start": 8398,
        "end": 8422
      },
      "text": "ལྟེ་བ་ལ་སྔགས་རྒྱས་བསྡུས་ ༼སྣར། པེ།༽ ལྟེ་བ་སྔགས་བརྒྱས་"
    },
    {
      "span": {
        "start": 8425,
        "end": 8434
      },
      "text": "མོས་ཀྱིས་ ༼སྣར། པེ།༽ མོས་ཀྱི་"
    },
    {
      "span": {
        "start": 8583,
        "end": 8586
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 8591,
        "end": 8598
      },
      "text": "ཀྱི་རང་ ༼སྣར། པེ།༽ ཀྱི་"
    },
    {
      "span": {
        "start": 8602,
        "end": 8611
      },
      "text": "འབྱུང་བས་ ༼སྣར། པེ།༽ བྱུང་བས་"
    },
    {
      "span": {
        "start": 8631,
        "end": 8635
      },
      "text": "བབས། ༼སྣར། པེ།༽ བབསཔ།"
    },
    {
      "span": {
        "start": 8711,
        "end": 8717
      },
      "text": "སྦུབས་ ༼སྣར། པེ།༽ སྦུབ་"
    },
    {
      "span": {
        "start": 8849,
        "end": 8856
      },
      "text": "གཅད་པར་ ༼སྣར། པེ།༽ བཅད་པར་"
    },
    {
      "span": {
        "start": 9601,
        "end": 9607
      },
      "text": "འདེབས། ༼སྣར། པེ།༽ འཚལ།"
    },
    {
      "span": {
        "start": 9694,
        "end": 9700
      },
      "text": "བཟུང་། ༼སྣར།༽ གཟུང་།"
    },
    {
      "span": {
        "start": 9736,
        "end": 9743
      },
      "text": "བརྒལ་བ་ ༼སྣར། པེ།༽ རྒལ་བ་"
    },
    {
      "span": {
        "start": 9837,
        "end": 9842
      },
      "text": "རྗེས་ ༼སྣར། པེ།༽ རྗེ་"
    },
    {
      "span": {
        "start": 10292,
        "end": 10300
      },
      "text": "དམིགས་པ་ ༼སྣར། པེ།༽ དམིགས་པར་"
    },
    {
      "span": {
        "start": 10348,
        "end": 10356
      },
      "text": "ཨེ་མ་ཧོ། ༼སྣར། པེ།༽ ཨེ་མའོ།"
    },
    {
      "span": {
        "start": 10828,
        "end": 10834
      },
      "text": "གི་ཝང་ ༼སྣར། པེ།༽ འགི་ཝང་"
    },
