{
  "durchens": [
    {
      "span": {
        "start": 26,
        "end": 29
      },
      "text": "ཏྲ་ ༼སྣར། པེ།༽ ཏྲི་"
    },
    {
      "span": {
        "start": 67,
        "end": 84
      },
      "text": "བསྟོད་པ་ཞེས་བྱ་བ། ༼སྣར། པེ།༽ བསྟོད་པ།"
    },
    {
      "span": {
        "start": 101,
        "end": 115
      },
      "text": "གཞོན་ནུར་གྱུར་ ༼པེ།༽ གཞོན་ནུར་"
    },
    {
      "span": {
        "start": 579,
        "end": 586
      },
      "text": "དམ་པའི་ ༼སྣར། པེ།༽ དམ་པ་"
    },
    {
      "span": {
        "start": 797,
        "end": 805
      },
      "text": "ལ་ལར་ཡང་ ༼སྣར། པེ།༽ ལ་ལ་རུ་"
    },
    {
      "span": {
        "start": 872,
        "end": 880
      },
      "text": "ཐབས་ཚུལ་ ༼སྣར། པེ།༽ ཐབས་ཚུལ་རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 1156,
        "end": 1164
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 1282,
        "end": 1290
      },
      "text": "འཛུད་པར་ ༼སྣར། པེ།༽ འཇུག་པར་"
    }
  ]
}