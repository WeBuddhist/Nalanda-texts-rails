{
  "durchens": [
    {
      "span": {
        "start": 26,
        "end": 28
      },
      "text": "ཨ་ ༼སྣར། པེ།༽ ཨཱ་"
    },
    {
      "span": {
        "start": 42,
        "end": 51
      },
      "text": "ཛ་སྟོ་ཏྲ། ༼སྣར། པེ།༽ ཛ་སྟོཏྟཱ།"
    },
    {
      "span": {
        "start": 513,
        "end": 516
      },
      "text": "བས་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 694,
        "end": 700
      },
      "text": "བསྐུམ་ ༼སྣར། པེ།༽ བརྐུམ་"
    },
    {
      "span": {
        "start": 963,
        "end": 972
      },
      "text": "དབའ་རླབས་ ༼སྣར། པེ།༽ རྦ་རླབས་"
    },
    {
      "span": {
        "start": 1224,
        "end": 1230
      },
      "text": "བཞིའི་ ༼སྣར། པེ།༽ བཞིར་"
    },
    {
      "span": {
        "start": 1704,
        "end": 1709
      },
      "text": "གདུལ་ ༼སྣར། པེ།༽ འདུལ་"
    },
    {
      "span": {
        "start": 2052,
        "end": 2055
      },
      "text": "ཆད་ ༼སྣར། པེ།༽ ཆོད་"
    },
    {
      "span": {
        "start": 2180,
        "end": 2192
      },
      "text": "བདག་ཉིད་ཀྱི། ༼སྣར། པེ།༽ བདག་ཉིད་ཀྱིས།"
    },
    {
      "span": {
        "start": 2440,
        "end": 2449
      },
      "text": "གཏུམ་ཆེན་ ༼སྣར། པེ།༽ སྟོབས་ཆེན་"
    },
    {
      "span": {
        "start": 2597,
        "end": 2600
      },
      "text": "ནག་ ༼སྣར།༽ གནག་"
    },
    {
      "span": {
        "start": 2656,
        "end": 2661
      },
      "text": "གདུལ་ ༼སྣར། པེ།༽ འདུལ་"
    },
    {
      "span": {
        "start": 2897,
        "end": 2903
      },
      "text": "བསྟོད་ ༼ཅོ། སྡེ།༽ སྟོད་"
    },
    {
      "span": {
        "start": 3021,
        "end": 3029
      },
      "text": "གསོལ་བར་ ༼ཅོ། སྡེ།༽ སྩོལ་བར་"
    },
    {
      "span": {
        "start": 3175,
        "end": 3187
      },
      "text": "ཡེ་ཤེས་ཀྱིས་ ༼ཅོ།༽ ཡེ་ཤེས་"
    }
  ]
}