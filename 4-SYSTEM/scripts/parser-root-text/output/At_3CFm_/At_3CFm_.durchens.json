{
  "durchens": [
    {
      "span": {
        "start": 163,
        "end": 168
      },
      "text": "ཆེའི་ ༼སྣར། པེ།༽ ཆེར་"
    },
    {
      "span": {
        "start": 247,
        "end": 249
      },
      "text": "ན་ ༼སྣར། པེ།༽ ཌྱཎ་"
    },
    {
      "span": {
        "start": 319,
        "end": 324
      },
      "text": "དེའི་ ༼སྣར།༽ དེ་"
    },
    {
      "span": {
        "start": 349,
        "end": 357
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ གྲུབ་པ་"
    },
    {
      "span": {
        "start": 384,
        "end": 390
      },
      "text": "བསྐུར་ ༼སྣར། པེ།༽ བསྐུར་བ་"
    },
    {
      "span": {
        "start": 397,
        "end": 406
      },
      "text": "རྫོགས་པས། ༼སྡེ།༽ རྫོགས་ཤིང་།"
    },
    {
      "span": {
        "start": 420,
        "end": 422
      },
      "text": "ན་ ༼སྣར། པེ།༽ ཌྱཎ་"
    },
    {
      "span": {
        "start": 425,
        "end": 430
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 550,
        "end": 555
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 604,
        "end": 616
      },
      "text": "རིམ་པས་དེའི་ ༼སྣར། པེ།༽ རིམ་པས་"
    },
    {
      "span": {
        "start": 699,
        "end": 705
      },
      "text": "བརླབས་ ༼སྣར། པེ།༽ བརླབ་"
    },
    {
      "span": {
        "start": 727,
        "end": 734
      },
      "text": "སྲུང་བ་ ༼སྣར། པེ།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 882,
        "end": 889
      },
      "text": "བརྩེགས་ ༼སྣར། པེ།༽ རྩེག་"
    },
    {
      "span": {
        "start": 1155,
        "end": 1160
      },
      "text": "བསགས་ ༼སྣར།༽ བསོག་"
    },
    {
      "span": {
        "start": 1271,
        "end": 1278
      },
      "text": "གཞུག་པ་ ༼པེ།༽ ཞུག་པ་"
    },
    {
      "span": {
        "start": 1327,
        "end": 1340
      },
      "text": "རྣལ་འབྱོར་མས་ ༼སྣར། པེ།༽ རྣལ་འབྱོར་པས་"
    },
    {
      "span": {
        "start": 1426,
        "end": 1442
      },
      "text": "འདུག་པ་རྣམ་པ་སྣ་ ༼སྣར། པེ།༽ འདུག་པ་རྣམས་"
    },
    {
      "span": {
        "start": 1485,
        "end": 1491
      },
      "text": "འཚལ་བ་ ༼སྣར། པེ།༽ བཙལ་བ་"
    },
    {
      "span": {
        "start": 1603,
        "end": 1606
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལས་སམ་"
    },
    {
      "span": {
        "start": 1842,
        "end": 1850
      },
      "text": "གཡོན་པས་ ༼སྣར། པེ།༽ གཡོན་པ་"
    },
    {
      "span": {
        "start": 1856,
        "end": 1862
      },
      "text": "བསྣམས་ ༼སྣར། པེ།༽ བསྣམ་"
    },
    {
      "span": {
        "start": 2069,
        "end": 2075
      },
      "text": "དབུགས་ ༼སྣར། པེ།༽ དབུས་"
    },
    {
      "span": {
        "start": 2149,
        "end": 2157
      },
      "text": "ཞལ་གཅིག་ ༼སྣར།༽ ཞལ་ཅིག་"
    },
    {
      "span": {
        "start": 2288,
        "end": 2290
      },
      "text": "ལ། ༼སྣར། པེ།༽ ཏེ། གྱུར་ཏེ།"
    },
    {
      "span": {
        "start": 2296,
        "end": 2311
      },
      "text": "མེད་དུ་གྱུར་པར་ ༼སྣར། པེ།༽ མེད་དུ་"
    },
    {
      "span": {
        "start": 2341,
        "end": 2347
      },
      "text": "དཀར་ལ་ ༼སྣར། པེ།༽ དཀར་"
    },
    {
      "span": {
        "start": 2406,
        "end": 2410
      },
      "text": "སྐུ་ ༼སྣར། པེ།༽ སྐུར་"
    },
    {
      "span": {
        "start": 2454,
        "end": 2458
      },
      "text": "བཞག་ ༼སྣར། པེ།༽ གཞག་"
    },
    {
      "span": {
        "start": 2687,
        "end": 2700
      },
      "text": "འཁོར་ལོ་འཁོར་ ༼སྣར། པེ།༽ འཁོར་ལོ་"
    },
    {
      "span": {
        "start": 2714,
        "end": 2722
      },
      "text": "འཁོར་ལོ་ ༼སྣར། པེ།༽ འཁོར་ལོ་ལ་"
    },
    {
      "span": {
        "start": 2883,
        "end": 2888
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 2890,
        "end": 2910
      },
      "text": "དཔྲལ་བའི་གནས་སུ་བྲུ་ ༼སྣར། པེ།༽ དཔྲལ་བའི་གྲུ་"
    },
    {
      "span": {
        "start": 2926,
        "end": 2933
      },
      "text": "ནམ་མཁའ་ ༼སྣར། པེ།༽ ནམ་མཁའི་"
    },
    {
      "span": {
        "start": 3018,
        "end": 3024
      },
      "text": "ཤེས་པ་ ༼སྣར། པེ།༽ ཤེས་པས་"
    },
    {
      "span": {
        "start": 3040,
        "end": 3046
      },
      "text": "བསྒོམ། ༼སྣར། པེ།༽ བསྒོམས།"
    },
    {
      "span": {
        "start": 3097,
        "end": 3102
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 3268,
        "end": 3274
      },
      "text": "པ་དང་། ༼སྣར། པེ།༽ པ་གྱི་"
    },
    {
      "span": {
        "start": 3377,
        "end": 3385
      },
      "text": "དལ་གྱིས་ ༼སྣར། པེ།༽ དལ་"
    },
    {
      "span": {
        "start": 3403,
        "end": 3406
      },
      "text": "དང་ ༼སྣར། པེ།༽ ཞུགས་པ་"
    },
    {
      "span": {
        "start": 3620,
        "end": 3628
      },
      "text": "དུ་ཞུ་བ་ ༼སྣར། པེ།༽ དུ་བཟུང་"
    },
    {
      "span": {
        "start": 3732,
        "end": 3740
      },
      "text": "དེ་གཟུང་ ༼སྣར། པེ།༽ དེ་པ་"
    },
    {
      "span": {
        "start": 3906,
        "end": 3912
      },
      "text": "བཞག་ལ། ༼སྣར། པེ།༽ བཞག་པ།"
    }
  ]
}