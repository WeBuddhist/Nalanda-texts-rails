{
  "durchens": [
    {
      "span": {
        "start": 158,
        "end": 167
      },
      "text": "བསྒྲགས། ། ༼པེ།༽ སྒྲག །"
    },
    {
      "span": {
        "start": 170,
        "end": 175
      },
      "text": "འཕྱར་ ༼པེ།༽ འཆར་"
    },
    {
      "span": {
        "start": 2158,
        "end": 2162
      },
      "text": "བླང་ ༼པེ།༽ བླངས་"
    },
    {
      "span": {
        "start": 2244,
        "end": 2256
      },
      "text": "བསྒྲུབས་པའི་ ༼པེ།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 2982,
        "end": 2987
      },
      "text": "ཕྱོར། ༼པེ།༽ ཆོར།"
    },
    {
      "span": {
        "start": 3015,
        "end": 3019
      },
      "text": "ཆོད། ༼སྣར།༽ ཆོས།"
    },
    {
      "span": {
        "start": 3175,
        "end": 3180
      },
      "text": "སྒྱུ་ ༼པེ།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 3824,
        "end": 3830
      },
      "text": "ལྡིང་། ༼པེ།༽ འདིང་།"
    },
    {
      "span": {
        "start": 4905,
        "end": 4914
      },
      "text": "ཤེས་བྱའི་ ༼པེ།༽ ཤེས་པའི་"
    },
    {
      "span": {
        "start": 5492,
        "end": 5498
      },
      "text": "བསྡུལ་ ༼པེ།༽ སྡུལ་"
    },
    {
      "span": {
        "start": 6113,
        "end": 6120
      },
      "text": "འདིང་བ་ ༼སྣར།༽ ལྡིང་བ་"
    },
    {
      "span": {
        "start": 6180,
        "end": 6183
      },
      "text": "ལས་ ༼པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 8032,
        "end": 8037
      },
      "text": "གདོང་ ༼པེ།༽ སྡོང་"
    },
    {
      "span": {
        "start": 8979,
        "end": 8983
      },
      "text": "རིག་ ༼པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 9264,
        "end": 9270
      },
      "text": "བརྡོས། ༼སྣར།༽ རྡོས།"
    },
    {
      "span": {
        "start": 9398,
        "end": 9402
      },
      "text": "རིག་ ༼པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 9862,
        "end": 9866
      },
      "text": "བཏང་ ༼པེ།༽ གཏང་"
    },
    {
      "span": {
        "start": 10162,
        "end": 10166
      },
      "text": "འཆར། ༼སྡེ། ཅོ། སྣར།༽ འཕྱར།"
    },
    {
      "span": {
        "start": 11322,
        "end": 11330
      },
      "text": "ཐམས་ཐམས་ ༼པེ།༽ ཐམས་"
    },
    {
      "span": {
        "start": 13988,
        "end": 13992
      },
      "text": "རྩི་ ༼པེ།༽ རྫི་"
    },
    {
      "span": {
        "start": 14034,
        "end": 14040
      },
      "text": "བསྐང་། ༼པེ།༽ བསྐངས།"
    },
    {
      "span": {
        "start": 14731,
        "end": 14733
      },
      "text": "ཁ་ ༼སྣར།༽ ཁྭ་"
    },
    {
      "span": {
        "start": 14999,
        "end": 15009
      },
      "text": "ལྕགས་སྤྱང་ ༼པེ།༽ ལྕགས་ཅང་"
    },
    {
      "span": {
        "start": 15448,
        "end": 15451
      },
      "text": "ཙི་ ༼པེ།༽ རྩི་"
    },
    {
      "span": {
        "start": 15906,
        "end": 15910
      },
      "text": "ལྡག་ ༼པེ།༽ འདག་"
    },
    {
      "span": {
        "start": 16186,
        "end": 16191
      },
      "text": "སྟོབ་ ༼པེ།༽ སྟོད་"
    },
    {
      "span": {
        "start": 16280,
        "end": 16285
      },
      "text": "ཆིབས་ ༼པེ།༽ ཕྱིབས་"
    },
    {
      "span": {
        "start": 18308,
        "end": 18313
      },
      "text": "བཏོང་ ༼པེ།༽ སྟོང་"
    },
    {
      "span": {
        "start": 18408,
        "end": 18413
      },
      "text": "སྨུག་ ༼པེ།༽ སྨུ་"
    },
    {
      "span": {
        "start": 20748,
        "end": 20751
      },
      "text": "ཚལ་ ༼སྣར།༽ འཚལ་"
    },
    {
      "span": {
        "start": 24265,
        "end": 24269
      },
      "text": "ཀ་ལ་ ༼པེ།༽ ཀ་ལི་"
    }
  ]
}