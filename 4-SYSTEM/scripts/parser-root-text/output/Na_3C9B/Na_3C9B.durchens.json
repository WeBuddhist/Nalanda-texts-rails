{
  "durchens": [
    {
      "span": {
        "start": 816,
        "end": 822
      },
      "text": "གསུངས། ༼པེ།༽ གཟུངས།"
    },
    {
      "span": {
        "start": 1326,
        "end": 1333
      },
      "text": "ལྟོས་པ་ ༼སྣར། པེ།༽ བལྟོས་པ་"
    },
    {
      "span": {
        "start": 1391,
        "end": 1396
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 1442,
        "end": 1447
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 2391,
        "end": 2398
      },
      "text": "རྟག་པར་ ༼པེ།༽ ལྟག་པར་"
    },
    {
      "span": {
        "start": 2553,
        "end": 2557
      },
      "text": "བའང་ ༼སྣར། པེ།༽ འམ་"
    },
    {
      "span": {
        "start": 2598,
        "end": 2601
      },
      "text": "ཟླ་ ༼སྣར། པེ།༽ ཟླ་བ་"
    },
    {
      "span": {
        "start": 2613,
        "end": 2620
      },
      "text": "མཐོང་བ་ ༼སྣར། པེ།༽ མཐོང་"
    },
    {
      "span": {
        "start": 3124,
        "end": 3129
      },
      "text": "གཟོད་ ༼སྣར། པེ།༽ བཟོད་"
    },
    {
      "span": {
        "start": 3746,
        "end": 3750
      },
      "text": "གསང་ ༼སྣར། པེ།༽ གསུང་"
    },
    {
      "span": {
        "start": 4097,
        "end": 4103
      },
      "text": "ཅི་ཡང་ ༼སྣར། པེ།༽ གཅིག་ཀྱང་"
    },
    {
      "span": {
        "start": 4109,
        "end": 4113
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 4459,
        "end": 4463
      },
      "text": "སླུ་ ༼སྣར། པེ།༽ བསླུ་"
    },
    {
      "span": {
        "start": 4768,
        "end": 4776
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 4968,
        "end": 4978
      },
      "text": "བརྟགས་པའི་ ༼སྣར། པེ།༽ བཏགས་པའི་"
    },
    {
      "span": {
        "start": 5349,
        "end": 5356
      },
      "text": "འཇིག་པ་ ༼སྣར། པེ།༽ འཇིགས་པ་"
    },
    {
      "span": {
        "start": 5715,
        "end": 5725
      },
      "text": "རྣམས་ཀྱིས། ༼སྣར། པེ།༽ རྣམས་ཀྱི།"
    },
    {
      "span": {
        "start": 6020,
        "end": 6029
      },
      "text": "བརྡུངས་པ་ ༼སྣར། པེ།༽ བརྡུང་པ་"
    },
    {
      "span": {
        "start": 6049,
        "end": 6056
      },
      "text": "སྒྲ་བོ་ ༼སྣར། པེ།༽ དགྲ་བོ་"
    },
    {
      "span": {
        "start": 6153,
        "end": 6166
      },
      "text": "རྣམས་ཀུན་གྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་ནི་"
    }
  ]
}