{
  "durchens": [
    {
      "span": {
        "start": 68,
        "end": 77
      },
      "text": "རྗེ་བཙུན་ ༼སྣར། པེ།༽ རྗེ་བཙུན་མ་"
    },
    {
      "span": {
        "start": 1322,
        "end": 1333
      },
      "text": "དེ་ཡོངས་སུ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 1609,
        "end": 1615
      },
      "text": "དཀྱིལ་ ༼སྣར། པེ།༽ དཀྱིལ་འཁོར་"
    },
    {
      "span": {
        "start": 2565,
        "end": 2570
      },
      "text": "ཀྲུང་ ༼སྣར།༽ ཀྲུངས་ ༼པེ།༽ དཀྲུང་"
    },
    {
      "span": {
        "start": 2750,
        "end": 2755
      },
      "text": "ཀྲུང་ ༼སྣར།༽ ཀྲུངས་ ༼པེ།༽ མོ་དཀྲུང་"
    },
    {
      "span": {
        "start": 2919,
        "end": 2924
      },
      "text": "ཀྲུང་ ༼པེ།༽ དཀྲུང་"
    },
    {
      "span": {
        "start": 3111,
        "end": 3119
      },
      "text": "ཁྲག་གིས་ ༼སྣར།༽ ཁྲག་གི་"
    },
    {
      "span": {
        "start": 3141,
        "end": 3149
      },
      "text": "པགས་པའི་ ༼སྣར།༽ ལྤགས་པའི་"
    },
    {
      "span": {
        "start": 3166,
        "end": 3171
      },
      "text": "ཀྲུང་ ༼པེ།༽ དཀྲུང་"
    },
    {
      "span": {
        "start": 3963,
        "end": 3970
      },
      "text": "མཆོད་པ་ ༼སྣར། པེ།༽ མཆོད་པར་"
    },
    {
      "span": {
        "start": 4268,
        "end": 4278
      },
      "text": "བསྐྱོད་པས་ ༼པེ།༽ སྐྱོད་པས་"
    },
    {
      "span": {
        "start": 4675,
        "end": 4686
      },
      "text": "དཀར་པོའོ། ། ༼སྣར། པེ།༽ དཀར་པོ་"
    },
    {
      "span": {
        "start": 4743,
        "end": 4747
      },
      "text": "བཞག་ ༼སྣར། པེ།༽ གཞག་"
    },
    {
      "span": {
        "start": 4749,
        "end": 4764
      },
      "text": "སྤྱི་བོར་གཏུགས་ ༼སྣར། པེ།༽ སྤྱི་བོར་"
    },
    {
      "span": {
        "start": 4881,
        "end": 4886
      },
      "text": "སྤྲད་ ༼སྣར། པེ།༽ ཕྲད་"
    },
    {
      "span": {
        "start": 5051,
        "end": 5061
      },
      "text": "གཏུགས་ཤིང་ ༼སྣར།༽ གཏུག་ཅིང་ ༼པེ།༽ གཏུགས་ཅིང་"
    },
    {
      "span": {
        "start": 5175,
        "end": 5179
      },
      "text": "མཐེ་ ༼པེ།༽ ཐེ་"
    },
    {
      "span": {
        "start": 5217,
        "end": 5231
      },
      "text": "གཏུགས་ཏེ་ཏུ་ཏ་ ༼སྣར། པེ།༽ གཏུགས་ཏེ་"
    },
    {
      "span": {
        "start": 5320,
        "end": 5325
      },
      "text": "གྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 5438,
        "end": 5443
      },
      "text": "གྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 5450,
        "end": 5453
      },
      "text": "གར་ ༼སྣར། པེ།༽ ཀར་"
    },
    {
      "span": {
        "start": 5928,
        "end": 5937
      },
      "text": "བརྟེན་པར་ ༼སྣར། པེ།༽ བརྟན་པར་"
    },
    {
      "span": {
        "start": 6020,
        "end": 6027
      },
      "text": "དགོས་པ་ ༼སྣར། པེ།༽ དགོངས་པ་"
    },
    {
      "span": {
        "start": 6035,
        "end": 6047
      },
      "text": "འཇིག་རྟེན་པ་ ༼སྣར། པེ།༽ འཇིག་རྟེན་"
    },
    {
      "span": {
        "start": 6153,
        "end": 6158
      },
      "text": "ཚུགས་ ༼པེ།༽ ཚུག་"
    },
    {
      "span": {
        "start": 6188,
        "end": 6195
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 6335,
        "end": 6346
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 6536,
        "end": 6541
      },
      "text": "སྐོར་ ༼སྣར། པེ།༽ བསྐོར་"
    },
    {
      "span": {
        "start": 7332,
        "end": 7339
      },
      "text": "ཥཊ་ཅེས་ ༼སྣར། པེ།༽ ཥཊ་ཞེས་"
    },
    {
      "span": {
        "start": 7514,
        "end": 7524
      },
      "text": "། །བཅིང་བ་ ༼སྣར། པེ།༽ ། །བཅིངས་"
    },
    {
      "span": {
        "start": 7561,
        "end": 7564
      },
      "text": "རེ་ ༼སྣར།༽ ར་"
    },
    {
      "span": {
        "start": 7662,
        "end": 7664
      },
      "text": "ཀ་ ༼སྣར། པེ།༽ ཀ་ཤ་"
    },
    {
      "span": {
        "start": 8413,
        "end": 8415
      },
      "text": "ཨ་ ༼སྣར། པེ།༽ ཨཱ་"
    },
    {
      "span": {
        "start": 8444,
        "end": 8447
      },
      "text": "དྱ་ ༼སྣར། པེ།༽ དྱཱ་"
    },
    {
      "span": {
        "start": 8639,
        "end": 8641
      },
      "text": "ད་ ༼སྣར།༽ ། །"
    },
    {
      "span": {
        "start": 8690,
        "end": 8697
      },
      "text": "བྱུང་བ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 8838,
        "end": 8845
      },
      "text": "བདེན་པ་ ༼སྣར།༽ བདེན་"
    },
    {
      "span": {
        "start": 9272,
        "end": 9283
      },
      "text": "བསྒྲུབ་པའི་ ༼པེ།༽ སྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 9283,
        "end": 9289
      },
      "text": "ནུས་པ་ ༼སྣར། པེ།༽ ནུས་པའི་"
    },
    {
      "span": {
        "start": 9485,
        "end": 9500
      },
      "text": "ཆོས་ཀྱི་དབྱིངས་ ༼སྣར། པེ།༽ ཆོས་ཀྱིས་"
    },
    {
      "span": {
        "start": 10001,
        "end": 10012
      },
      "text": "འོད་ཟེར་ཅན་ ༼སྣར། པེ།༽ འོད་ཟེར་"
    },
    {
      "span": {
        "start": 10253,
        "end": 10264
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 10269,
        "end": 10277
      },
      "text": "སྤོང་བར་ ༼སྣར། པེ།༽ སྤོངས་པར་"
    },
    {
      "span": {
        "start": 10464,
        "end": 10470
      },
      "text": "མོ་ནི་ ༼སྣར། པེ།༽ མོ་"
    },
    {
      "span": {
        "start": 11048,
        "end": 11056
      },
      "text": "པགས་པའི་ ༼སྣར། པེ།༽ ལྤགས་པའི་"
    },
    {
      "span": {
        "start": 11258,
        "end": 11263
      },
      "text": "ཀྲུང་ ༼པེ།༽ དཀྲུང་"
    },
    {
      "span": {
        "start": 11448,
        "end": 11456
      },
      "text": "ངོ་བོའི་ ༼སྣར། པེ།༽ ངོ་བོའོ་"
    },
    {
      "span": {
        "start": 11469,
        "end": 11471
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 11769,
        "end": 11773
      },
      "text": "སྐུ་ ༼པེ།༽ སྡུ་"
    },
    {
      "span": {
        "start": 11776,
        "end": 11779
      },
      "text": "ཡང་ ༼པེ།༽ ཡབ་"
    },
    {
      "span": {
        "start": 11794,
        "end": 11797
      },
      "text": "གར་ ༼སྣར། པེ།༽ ཀར་"
    },
    {
      "span": {
        "start": 11850,
        "end": 11853
      },
      "text": "གུ་ ༼པེ།༽ ཀུ་"
    },
    {
      "span": {
        "start": 11893,
        "end": 11902
      },
      "text": "གཙོ་མོའི་ ༼སྣར། པེ།༽ གཙོ་བོའི་"
    },
    {
      "span": {
        "start": 11946,
        "end": 11953
      },
      "text": "བདག་གི་ ༼པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 11997,
        "end": 12001
      },
      "text": "འོད་ ༼སྣར། པེ།༽ འོད་དང་"
    },
    {
      "span": {
        "start": 12051,
        "end": 12060
      },
      "text": "གཙོ་མོའི་ ༼སྣར། པེ།༽ གཙོ་བོའི་"
    },
    {
      "span": {
        "start": 12147,
        "end": 12156
      },
      "text": "གཙོ་མོའི་ ༼སྣར། པེ།༽ གཙོ་བོའི་"
    },
    {
      "span": {
        "start": 12245,
        "end": 12254
      },
      "text": "གཙོ་མོའི་ ༼སྣར། པེ།༽ གཙོ་བོའི་"
    },
    {
      "span": {
        "start": 12302,
        "end": 12309
      },
      "text": "ཏཱཾ་གི་ ༼སྣར། པེ།༽ ཏཱཾ་གྱི་"
    },
    {
      "span": {
        "start": 12374,
        "end": 12378
      },
      "text": "ཐིམ། ༼སྣར།༽ །"
    },
    {
      "span": {
        "start": 12415,
        "end": 12422
      },
      "text": "ཐིམ་མོ། ༼སྣར།༽ ཐིམ་།"
    },
    {
      "span": {
        "start": 12458,
        "end": 12466
      },
      "text": "གྱུར་ཏེ། ༼སྣར། པེ།༽ གྱུར་།"
    },
    {
      "span": {
        "start": 12789,
        "end": 12796
      },
      "text": "སོགས་པ་ ༼སྣར། པེ།༽ སོག་པ་"
    },
    {
      "span": {
        "start": 12900,
        "end": 12915
      },
      "text": "ཀླུ་སྒྲུབ་ཀྱིས་ ༼པེ།༽ ཀླུ་སྒྲུབ་ཀྱི་"
    }
  ]
}