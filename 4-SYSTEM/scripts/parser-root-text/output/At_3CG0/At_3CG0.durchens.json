{
  "durchens": [
    {
      "span": {
        "start": 17,
        "end": 28
      },
      "text": "དུ། །ས་ན་ས་ ༼སྣར།༽ དུ། སཾ་ད་ ༼པེ།༽ དུ། སྃ་ས་"
    },
    {
      "span": {
        "start": 53,
        "end": 62
      },
      "text": "སངྒཱི་ཏི། ༼སྣར། པེ།༽ སངྒཱི་ཏེ།"
    },
    {
      "span": {
        "start": 271,
        "end": 275
      },
      "text": "བཅུ། ༼སྣར། པེ།༽ དགུ།"
    },
    {
      "span": {
        "start": 1191,
        "end": 1196
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 1202,
        "end": 1209
      },
      "text": "སྐྱོ་བ། ༼སྣར། པེ།༽ སྐྱོབ་པ།"
    },
    {
      "span": {
        "start": 1273,
        "end": 1279
      },
      "text": "གསུང་། ༼སྣར།༽ གསུངས།"
    },
    {
      "span": {
        "start": 1295,
        "end": 1303
      },
      "text": "སྐྱེ་བོ་ ༼སྣར། པེ།༽ སྐྱེ་བོས་"
    },
    {
      "span": {
        "start": 1796,
        "end": 1799
      },
      "text": "ཉམ་ ༼སྣར། པེ།༽ ཉམས་"
    },
    {
      "span": {
        "start": 2324,
        "end": 2329
      },
      "text": "གྱུར། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 2476,
        "end": 2479
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 2489,
        "end": 2505
      },
      "text": "བྱ་དེ་ནས་འདི་དང་ ༼སྣར། པེ།༽ བྱ་དེ་ནས་"
    },
    {
      "span": {
        "start": 2875,
        "end": 2885
      },
      "text": "བསྟན་བཅོས་ ༼སྣར། པེ།༽ བསྟན་ཆོས་"
    },
    {
      "span": {
        "start": 2985,
        "end": 2989
      },
      "text": "འདི་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 2994,
        "end": 3002
      },
      "text": "མང་རླུང་ ༼སྣར། པེ།༽ མ་རླུང་"
    },
    {
      "span": {
        "start": 3010,
        "end": 3012
      },
      "text": "པ་ ༼སྣར། པེ།༽ འདྲ་"
    },
    {
      "span": {
        "start": 3329,
        "end": 3334
      },
      "text": "བལྟས་ ༼སྣར། པེ།༽ ལྟས་"
    },
    {
      "span": {
        "start": 3381,
        "end": 3386
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 3482,
        "end": 3492
      },
      "text": "བརྡ་སྤྲོད་ ༼སྣར། པེ།༽ བརྡའ་སྤྲོ་"
    },
    {
      "span": {
        "start": 3745,
        "end": 3754
      },
      "text": "བཙལ་གྱིས་ ༼སྣར། པེ།༽ བཙལ་གྱི་"
    },
    {
      "span": {
        "start": 3861,
        "end": 3868
      },
      "text": "ཕ་མར་མ་ ༼སྣར། པེ།༽ ཕ་མར་"
    },
    {
      "span": {
        "start": 3902,
        "end": 3907
      },
      "text": "སྤངས། ༼སྣར། པེ།༽ སྤང་།"
    },
    {
      "span": {
        "start": 3933,
        "end": 3938
      },
      "text": "སྤངས། ༼སྣར། པེ།༽ སྤང་།"
    },
    {
      "span": {
        "start": 4005,
        "end": 4010
      },
      "text": "སྤངས། ༼སྣར། པེ།༽ སྤང་།"
    },
    {
      "span": {
        "start": 4030,
        "end": 4034
      },
      "text": "སྟི་ ༼སྣར། པེ།༽ བསྟི་"
    },
    {
      "span": {
        "start": 4080,
        "end": 4121
      },
      "text": "། །སློབ་མ་ཡང་སློབ་ཆོས་ཀྱི་འབྲེལ་པ་སྤངས། ། ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 4157,
        "end": 4161
      },
      "text": "སྟག་ ༼སྣར། པེ།༽ རྟག་"
    },
    {
      "span": {
        "start": 4343,
        "end": 4351
      },
      "text": "བཅོས་ངན་ ༼སྣར། པེ།༽ བསམ་ངན་"
    },
    {
      "span": {
        "start": 4662,
        "end": 4666
      },
      "text": "བཏབ། ༼སྣར། པེ།༽ གཏབ།"
    },
    {
      "span": {
        "start": 4754,
        "end": 4757
      },
      "text": "ཞལ་ ༼སྣར། པེ།༽ ཞབས་"
    },
    {
      "span": {
        "start": 4785,
        "end": 4793
      },
      "text": "ཡིད་ཆེས་ ༼སྣར། པེ།༽ ཡིད་ཆེས་ངེས་"
    },
    {
      "span": {
        "start": 4829,
        "end": 4839
      },
      "text": "སློབ་དཔོན་ ༼སྣར། པེ།༽ སློབ་དཔོན་ཆེན་པོ་"
    },
    {
      "span": {
        "start": 4959,
        "end": 4962
      },
      "text": "བི་ ༼སྣར། པེ།༽ འབྲི་"
    },
    {
      "span": {
        "start": 4964,
        "end": 4966
      },
      "text": "མ་ ༼སྣར། པེ།༽ མཱ་"
    },
    {
      "span": {
        "start": 5068,
        "end": 5071
      },
      "text": "ཕབ། ༼སྣར། པེ།༽ ཕབ་པའོ།"
    }
  ]
}