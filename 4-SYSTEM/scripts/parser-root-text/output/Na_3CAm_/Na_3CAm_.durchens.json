{
  "durchens": [
    {
      "span": {
        "start": 190,
        "end": 196
      },
      "text": "དེ་ཡི་ ༼སྣར། པེ།༽ དེ་ཡིས་"
    },
    {
      "span": {
        "start": 447,
        "end": 456
      },
      "text": "སྒྲུབ་པར་ ༼པེ།༽ གྲུབ་པར་"
    },
    {
      "span": {
        "start": 508,
        "end": 517
      },
      "text": "འཕྲད་པའམ་ ༼སྣར། པེ།༽ ཕྲད་པའམ་"
    },
    {
      "span": {
        "start": 519,
        "end": 528
      },
      "text": "འཕྲད་པའི་ ༼སྣར། པེ།༽ ཕྲད་པའི་"
    },
    {
      "span": {
        "start": 534,
        "end": 541
      },
      "text": "གསལ་བར་ ༼སྣར། པེ།༽ བསལ་བར་"
    },
    {
      "span": {
        "start": 649,
        "end": 663
      },
      "text": "འཇིག་རྟེན་པའི་ ༼སྣར། པེ།༽ འཇིག་རྟེན་"
    },
    {
      "span": {
        "start": 755,
        "end": 761
      },
      "text": "གསལ་བ་ ༼སྣར། པེ།༽ བསལ་བ་"
    },
    {
      "span": {
        "start": 961,
        "end": 967
      },
      "text": "འགག་པ་ ༼སྣར། པེ།༽ དགག་པ་"
    },
    {
      "span": {
        "start": 979,
        "end": 985
      },
      "text": "དགག་པ་ ༼པེ།༽ བདག་པ་"
    },
    {
      "span": {
        "start": 985,
        "end": 990
      },
      "text": "གྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 1670,
        "end": 1681
      },
      "text": "། །བྱེ་མ་ལ་ ༼སྣར། པེ།༽ ། །ཕྱི་མ་"
    },
    {
      "span": {
        "start": 1870,
        "end": 1884
      },
      "text": "གཟི་བརྗིད་ཀྱི་ ༼སྣར། པེ།༽ གཟི་བརྗིད་"
    },
    {
      "span": {
        "start": 2101,
        "end": 2107
      },
      "text": "ཐོག་མ་ ༼སྣར། པེ།༽ ཐོག་"
    },
    {
      "span": {
        "start": 2383,
        "end": 2391
      },
      "text": "རྩ་བལ་བ་ ༼སྣར། པེ།༽ རྩྭ་ཕལ་པ་"
    },
    {
      "span": {
        "start": 3243,
        "end": 3248
      },
      "text": "ཕྱིར། ༼སྣར། པེ།༽ ཕྱིར་རོ།"
    },
    {
      "span": {
        "start": 3329,
        "end": 3337
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 3391,
        "end": 3399
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 3801,
        "end": 3807
      },
      "text": "བཅས་པ་ ༼སྣར། པེ།༽ བཅས་པ་མ་"
    },
    {
      "span": {
        "start": 3899,
        "end": 3901
      },
      "text": "ན། ༼སྣར། པེ།༽ ན་འདས་པ་ནི་འདས་པ་མེད་དོ། །"
    },
    {
      "span": {
        "start": 4074,
        "end": 4082
      },
      "text": "ཚིག་དོན་ ༼སྣར། པེ།༽ ཚིགས་དོར་"
    },
    {
      "span": {
        "start": 4222,
        "end": 4230
      },
      "text": "ལྟག་ཆོད་ ༼སྣར། པེ།༽ ལྷག་ཆད་"
    },
    {
      "span": {
        "start": 4305,
        "end": 4313
      },
      "text": "གཅད་པའི་ ༼སྣར། པེ།༽ བཅད་པའི་"
    },
    {
      "span": {
        "start": 4337,
        "end": 4345
      },
      "text": "གཅད་པའི་ ༼སྣར། པེ།༽ བཅད་པའི་"
    }
  ]
}