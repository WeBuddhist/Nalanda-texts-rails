{
  "durchens": [
    {
      "span": {
        "start": 346,
        "end": 350
      },
      "text": "ཡོད་ ༼སྣར། པེ།༽ ཡིད་"
    },
    {
      "span": {
        "start": 708,
        "end": 712
      },
      "text": "དང་། ༼སྣར། པེ།༽ དག།"
    },
    {
      "span": {
        "start": 1070,
        "end": 1081
      },
      "text": "ཆུའི་རྒྱུན་ ༼སྣར། པེ།༽ ཆུ་རྒྱུན་"
    },
    {
      "span": {
        "start": 1411,
        "end": 1422
      },
      "text": "ཕྱག་རྒྱ་དང་ ༼སྣར། པེ།༽ ཕྱག་རྒྱ་ཡིས་"
    },
    {
      "span": {
        "start": 1432,
        "end": 1440
      },
      "text": "བསྟབ་པར་ ༼སྣར། པེ།༽ བཏབ་པར་"
    },
    {
      "span": {
        "start": 1646,
        "end": 1651
      },
      "text": "བསྟབ་ ༼སྣར། པེ།༽ བཏབ་"
    },
    {
      "span": {
        "start": 1661,
        "end": 1668
      },
      "text": "འོག་མས་ ༼སྣར། པེ།༽ འོག་ནས་"
    },
    {
      "span": {
        "start": 2096,
        "end": 2103
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 2324,
        "end": 2332
      },
      "text": "འབར་བའི་ ༼སྣར། པེ།༽ ཆད་པ་"
    },
    {
      "span": {
        "start": 2339,
        "end": 2350
      },
      "text": "གདུངས་པ་ཡི། ༼པེ།༽ གདུངས་པ་ཡིས།"
    },
    {
      "span": {
        "start": 2579,
        "end": 2588
      },
      "text": "རྟོག་པའི་ ༼སྣར། པེ།༽ རྟོགས་པའི་"
    },
    {
      "span": {
        "start": 2718,
        "end": 2723
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 2911,
        "end": 2919
      },
      "text": "བསག་པའི་ ༼སྣར། པེ།༽ བསོགས་པའི་"
    },
    {
      "span": {
        "start": 2942,
        "end": 2946
      },
      "text": "གྱི་ ༼སྣར། པེ།༽ གྱི་ཀྱི་"
    }
  ]
}