{
  "durchens": [
    {
      "span": {
        "start": 156,
        "end": 163
      },
      "text": "གནོད་པ་ ༼སྣར། པེ།༽ གནོད་པའི་"
    },
    {
      "span": {
        "start": 301,
        "end": 306
      },
      "text": "བཏོད་ ༼སྣར། པེ།༽ རྡོད་"
    },
    {
      "span": {
        "start": 577,
        "end": 585
      },
      "text": "ས་གཞིའི་ ༼སྣར། པེ།༽ ས་གཞི་"
    },
    {
      "span": {
        "start": 626,
        "end": 632
      },
      "text": "ཕྱོགས་ ༼སྣར། པེ།༽ ཆ་"
    },
    {
      "span": {
        "start": 710,
        "end": 718
      },
      "text": "བསྲེས་པ་ ༼སྣར། པེ།༽ བསྲེས་པས་"
    },
    {
      "span": {
        "start": 1016,
        "end": 1021
      },
      "text": "བྱའོ། ༼སྣར། པེ།༽ བྱ།"
    },
    {
      "span": {
        "start": 1146,
        "end": 1154
      },
      "text": "སྦྱར་བས་ ༼སྣར། པེ།༽ འབྱར་བས་"
    },
    {
      "span": {
        "start": 1228,
        "end": 1233
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 1263,
        "end": 1270
      },
      "text": "བཏོད་པ་ ༼སྣར། པེ།༽ རྟོད་པ་"
    },
    {
      "span": {
        "start": 1297,
        "end": 1302
      },
      "text": "གདོད་ ༼སྣར། པེ།༽ རྡོད་"
    },
    {
      "span": {
        "start": 1537,
        "end": 1551
      },
      "text": "འཆག་ས་སྔོན་དུ་ ༼སྣར། པེ།༽ འཆག་ས་"
    },
    {
      "span": {
        "start": 1758,
        "end": 1764
      },
      "text": "འཆག་ས་ ༼སྣར། པེ།༽ ཆགས་"
    },
    {
      "span": {
        "start": 1772,
        "end": 1778
      },
      "text": "པའོ། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 1781,
        "end": 1791
      },
      "text": "གཉིས་དབུས་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 2205,
        "end": 2208
      },
      "text": "དེ་ ༼སྣར།༽ དེར་"
    },
    {
      "span": {
        "start": 2360,
        "end": 2364
      },
      "text": "ཆོམ་ ༼སྣར། པེ།༽ ཆོམས་"
    },
    {
      "span": {
        "start": 2415,
        "end": 2423
      },
      "text": "རྣམས་དང་ ༼སྣར། པེ།༽ རྣམ་མང་"
    },
    {
      "span": {
        "start": 2621,
        "end": 2626
      },
      "text": "སྤངས། ༼སྣར། པེ།༽ སྤང་།"
    },
    {
      "span": {
        "start": 2694,
        "end": 2701
      },
      "text": "སྒོ་ནི་ ༼སྣར། པེ།༽ སྒོ་"
    },
    {
      "span": {
        "start": 2708,
        "end": 2712
      },
      "text": "གཏན་ ༼སྣར། པེ།༽ དམ་"
    },
    {
      "span": {
        "start": 2716,
        "end": 2720
      },
      "text": "རྒྱ་ ༼སྣར།༽ བརྒྱ་"
    },
    {
      "span": {
        "start": 2730,
        "end": 2735
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 2844,
        "end": 2849
      },
      "text": "རྣམས་ ༼སྣར།༽ རྣམ་"
    },
    {
      "span": {
        "start": 2958,
        "end": 2973
      },
      "text": "ཐ་མལ་དྲི་དང་ནི། ༼སྣར། པེ།༽ ཐ་ཐལ་གྲི་དང་།"
    },
    {
      "span": {
        "start": 3101,
        "end": 3105
      },
      "text": "བལྟ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 3427,
        "end": 3439
      },
      "text": "སྙིང་རྗེ་ཆེ་ ༼སྣར། པེ།༽ སྙིང་རྗེ་"
    },
    {
      "span": {
        "start": 3442,
        "end": 3448
      },
      "text": "ལྡན་པ་ ༼སྣར།༽ ལྡན་ ༼པེ།༽ ལྡན་དང་"
    },
    {
      "span": {
        "start": 3527,
        "end": 3533
      },
      "text": "དད་པར་ ༼སྣར། པེ།༽ དང་བ་"
    },
    {
      "span": {
        "start": 3615,
        "end": 3620
      },
      "text": "གཞག ། ༼སྣར།༽ བཞག །"
    },
    {
      "span": {
        "start": 3685,
        "end": 3691
      },
      "text": "སྟན་ལ་ ༼སྣར།༽ བསྟན་པ་ ༼པེ།༽ སྟན་པ་"
    },
    {
      "span": {
        "start": 3724,
        "end": 3728
      },
      "text": "གནས་ ༼སྣར། པེ།༽ བཅས་"
    },
    {
      "span": {
        "start": 3791,
        "end": 3798
      },
      "text": "རང་གིས་ ༼སྣར། པེ།༽ རང་གི་"
    },
    {
      "span": {
        "start": 3886,
        "end": 3895
      },
      "text": "འཁྱམས་པར་ ༼སྣར། པེ།༽ འཁྱམས་པའི་"
    },
    {
      "span": {
        "start": 4153,
        "end": 4160
      },
      "text": "དགའ་བར་ ༼སྣར། པེ།༽ དག་པར་"
    },
    {
      "span": {
        "start": 4196,
        "end": 4200
      },
      "text": "དགའ་ ༼སྣར། པེ།༽ དགར་"
    },
    {
      "span": {
        "start": 4203,
        "end": 4207
      },
      "text": "བྱར་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 4273,
        "end": 4281
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་ཉིད་"
    },
    {
      "span": {
        "start": 4497,
        "end": 4505
      },
      "text": "གདམས་ངག་ ༼སྣར།༽ གདམ་ངག་"
    },
    {
      "span": {
        "start": 4565,
        "end": 4569
      },
      "text": "འདབ་ ༼སྣར། པེ།༽ མདའ་"
    },
    {
      "span": {
        "start": 4623,
        "end": 4631
      },
      "text": "དེ་སྲིད་ ༼སྣར། པེ།༽ ཇི་སྲིད་"
    },
    {
      "span": {
        "start": 4806,
        "end": 4813
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 5020,
        "end": 5024
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 5243,
        "end": 5263
      },
      "text": "གཡོག་དང་གྲོགས་དང་དམ་ ༼སྣར།༽ གཡོག་དང་མ་ ༼པེ།༽ གཡོག་མ་"
    },
    {
      "span": {
        "start": 5357,
        "end": 5365
      },
      "text": "བཞག་སྟེ་ ༼སྣར། པེ།༽ གཞག་ཏེ་"
    },
    {
      "span": {
        "start": 5573,
        "end": 5580
      },
      "text": "ནམ་མཁས་ ༼སྣར། པེ།༽ ནམ་མཁའ་"
    },
    {
      "span": {
        "start": 5780,
        "end": 5785
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བས་"
    },
    {
      "span": {
        "start": 5929,
        "end": 5936
      },
      "text": "མཁས་པས་ ༼སྣར།༽ ནམ་མཁའ་ལ་ ༼པེ།༽ མཁའ་ལ་"
    },
    {
      "span": {
        "start": 6056,
        "end": 6064
      },
      "text": "སྙིང་པོ་ ༼སྣར། པེ།༽ སྙིང་པོས་"
    },
    {
      "span": {
        "start": 6088,
        "end": 6093
      },
      "text": "གྱུར་ ༼སྣར།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 6622,
        "end": 6635
      },
      "text": "རྣམས་ལེགས་པར་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 6645,
        "end": 6651
      },
      "text": "བརླབས། ༼སྣར། པེ།༽ བརླབ།"
    },
    {
      "span": {
        "start": 6676,
        "end": 6683
      },
      "text": "གུས་པས་ ༼སྣར། པེ།༽ གྱུར་པས་"
    },
    {
      "span": {
        "start": 6707,
        "end": 6714
      },
      "text": "རྩོད་པ་ ༼སྣར།༽ རྩོག་པ་ ༼པེ།༽ བརྩོད་པ་"
    },
    {
      "span": {
        "start": 6717,
        "end": 6725
      },
      "text": "མངའ་བའམ་ ༼སྣར། པེ།༽ མངའ་"
    },
    {
      "span": {
        "start": 6783,
        "end": 6790
      },
      "text": "རང་ཉིད་ ༼སྣར། པེ།༽ རང་"
    },
    {
      "span": {
        "start": 6891,
        "end": 6895
      },
      "text": "ཚོན་ ༼སྣར།༽ མཚོན་"
    },
    {
      "span": {
        "start": 6918,
        "end": 6924
      },
      "text": "ཡི་ཡི་ ༼སྣར། པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 7080,
        "end": 7084
      },
      "text": "སོང་ ༼སྣར། པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 7154,
        "end": 7168
      },
      "text": "དེ་ཉིད་ནས་སླར་ ༼སྣར། པེ།༽ དེ་ཉིད་ནས་"
    },
    {
      "span": {
        "start": 7168,
        "end": 7173
      },
      "text": "བསྡུ་ ༼སྣར། པེ།༽ བསྡུ་བ་"
    },
    {
      "span": {
        "start": 7405,
        "end": 7411
      },
      "text": "དབྱངས་ ༼སྣར། པེ།༽ དབྱངས་ཀྱི་"
    },
    {
      "span": {
        "start": 7423,
        "end": 7428
      },
      "text": "ལེགས་ ༼སྣར། པེ།༽ ལེགས་པར་"
    },
    {
      "span": {
        "start": 7443,
        "end": 7451
      },
      "text": "རྗེས་སུ། ༼སྣར། པེ།༽ རྗེས།"
    },
    {
      "span": {
        "start": 7453,
        "end": 7465
      },
      "text": "ཉི་མའི་བུ་ལ་ ༼སྣར། པེ།༽ ཉི་མའི་"
    },
    {
      "span": {
        "start": 7547,
        "end": 7566
      },
      "text": "ཕྱེད་ཆའི་ཏ་ཡིས་མཐའ་ ༼སྣར། པེ།༽ ཕྱེད་ཆའིརྟ་ཡིས་"
    },
    {
      "span": {
        "start": 7663,
        "end": 7670
      },
      "text": "གསུམ་པ་ ༼སྣར། པེ།༽ གསུམ་"
    },
    {
      "span": {
        "start": 7944,
        "end": 7949
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 7969,
        "end": 7979
      },
      "text": "ཡི་ཡིད་ནི་ ༼སྣར། པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 8042,
        "end": 8051
      },
      "text": "བཀུག་སྟེ་ ༼སྣར། པེ།༽ བཀུག་ཏེ་"
    },
    {
      "span": {
        "start": 8123,
        "end": 8126
      },
      "text": "ལག་ ༼སྣར། པེ།༽ ལག་པ་"
    },
    {
      "span": {
        "start": 8147,
        "end": 8154
      },
      "text": "དག་གིས་ ༼སྣར། པེ།༽ དལ་གྱིས་"
    },
    {
      "span": {
        "start": 8209,
        "end": 8216
      },
      "text": "འདི་ཡི་ ༼སྣར། པེ།༽ འདི་ཡིས་"
    },
    {
      "span": {
        "start": 8718,
        "end": 8727
      },
      "text": "འཁྲུགས་པ་ ༼སྣར།༽ འཁྲུག་པ་"
    },
    {
      "span": {
        "start": 8826,
        "end": 8834
      },
      "text": "བརླབ་ཏུ་ ༼སྣར། པེ།༽ བརླབ་དུ་"
    },
    {
      "span": {
        "start": 9495,
        "end": 9502
      },
      "text": "མཉམ་པར་ ༼སྣར། པེ།༽ མཉམ་པས་"
    },
    {
      "span": {
        "start": 9535,
        "end": 9543
      },
      "text": "ཐབས་ཀྱི་ ༼སྣར། པེ།༽ ཐབས་ཀྱིས་"
    },
    {
      "span": {
        "start": 9840,
        "end": 9844
      },
      "text": "ཕྱི་ ༼སྣར།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 9862,
        "end": 9867
      },
      "text": "དགོད། ༼སྣར། པེ།༽ རྒོད།"
    },
    {
      "span": {
        "start": 9915,
        "end": 9920
      },
      "text": "མཁུན། ༼སྣར། པེ།༽ འཁུན།"
    },
    {
      "span": {
        "start": 9936,
        "end": 9943
      },
      "text": "དྲི་མི་ ༼སྣར། པེ།༽ དྲི་"
    },
    {
      "span": {
        "start": 10131,
        "end": 10136
      },
      "text": "དགོད། ༼སྣར། པེ།༽ རྒོད།"
    },
    {
      "span": {
        "start": 10378,
        "end": 10384
      },
      "text": "དག་གི་ ༼སྣར། པེ།༽ དག་གིས་"
    },
    {
      "span": {
        "start": 10514,
        "end": 10520
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 10561,
        "end": 10568
      },
      "text": "གཉིས་ཀ་ ༼སྣར། པེ།༽ གཉི་ག་"
    },
    {
      "span": {
        "start": 10577,
        "end": 10587
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 11143,
        "end": 11150
      },
      "text": "གིས་སྔ་ ༼སྣར། པེ།༽ ཞིང་ལྔ་"
    },
    {
      "span": {
        "start": 11196,
        "end": 11201
      },
      "text": "གཅོད་ ༼སྣར། པེ།༽ སྤྱོད་"
    },
    {
      "span": {
        "start": 11222,
        "end": 11227
      },
      "text": "འདིར་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 11321,
        "end": 11327
      },
      "text": "བཟའ་བ་ ༼སྣར། པེ།༽ བཟའ་"
    },
    {
      "span": {
        "start": 11329,
        "end": 11334
      },
      "text": "ལེགས་ ༼སྣར། པེ།༽ ལེགས་པ་"
    },
    {
      "span": {
        "start": 11385,
        "end": 11394
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 11556,
        "end": 11563
      },
      "text": "རྣམ་མང་ ༼སྣར།༽ རྣམས་མ་ ༼པེ།༽ རྣམས་མར་"
    },
    {
      "span": {
        "start": 11714,
        "end": 11723
      },
      "text": "བསྲུང་བར་ ༼སྣར། པེ།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 11878,
        "end": 11883
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 11910,
        "end": 11916
      },
      "text": "བྱ་རི་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 11916,
        "end": 11919
      },
      "text": "རབ་ ༼སྣར། པེ།༽ རབ་རིབ་"
    },
    {
      "span": {
        "start": 11964,
        "end": 11971
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 11982,
        "end": 11985
      },
      "text": "དེ་ ༼སྣར། པེ།༽ ས་"
    },
    {
      "span": {
        "start": 11987,
        "end": 11994
      },
      "text": "ལྷ་མོས་ ༼སྣར། པེ།༽ ལྷ་མོ་"
    },
    {
      "span": {
        "start": 12164,
        "end": 12170
      },
      "text": "རབ་ཏུ་ ༼སྣར། པེ།༽ རབ་ཏུ་བསྒྲུབ་པར་བྱ། །གང་ཚེ་གསུང་བ་མངའ་བ་འབད་པས་རབ་ཏུ་"
    },
    {
      "span": {
        "start": 12522,
        "end": 12533
      },
      "text": "གྲོགས་མཆོག་ ༼སྣར། པེ།༽ གྲོགས་"
    },
    {
      "span": {
        "start": 13151,
        "end": 13159
      },
      "text": "བུད་མེད་ ༼སྣར།༽ བུད་མེད་བུང་"
    },
    {
      "span": {
        "start": 13281,
        "end": 13287
      },
      "text": "དྲེགས་ ༼སྣར། པེ།༽ དྲག་"
    },
    {
      "span": {
        "start": 14014,
        "end": 14019
      },
      "text": "སྡེབ་ ༼སྣར། པེ།༽ སྡེབས་"
    },
    {
      "span": {
        "start": 14586,
        "end": 14599
      },
      "text": "དབྱེ་བའོ།། །། ༼སྣར། པེ།༽ དབྱེ་བའོབ་ཡི། །"
    },
    {
      "span": {
        "start": 14718,
        "end": 14734
      },
      "text": "སྒྲོལ་མ་འབྱུང་བ་ ༼སྣར། པེ།༽ སྒྲོལ་འབྱུང་"
    },
    {
      "span": {
        "start": 14771,
        "end": 14777
      },
      "text": "བསྲུང་ ༼སྣར། པེ།༽ སྲུང་"
    },
    {
      "span": {
        "start": 14820,
        "end": 14824
      },
      "text": "མིན་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 15268,
        "end": 15272
      },
      "text": "གསང་ ༼སྣར།༽ གསོད་"
    },
    {
      "span": {
        "start": 15288,
        "end": 15291
      },
      "text": "དང་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 15304,
        "end": 15306
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 15331,
        "end": 15336
      },
      "text": "སྲེག་ ༼སྣར།༽ བསྲེག་"
    },
    {
      "span": {
        "start": 15357,
        "end": 15366
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 15781,
        "end": 15795
      },
      "text": "མཁན་པོ་ཆེན་པོ་ ༼སྣར། པེ།༽ མཁན་པོ་"
    }
  ]
}