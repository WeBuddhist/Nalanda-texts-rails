{
  "durchens": [
    {
      "span": {
        "start": 170,
        "end": 175
      },
      "text": "བསགས་ ༼པེ།༽ བསག་"
    },
    {
      "span": {
        "start": 1109,
        "end": 1114
      },
      "text": "འཛིན་ ༼པེ།༽ འཛིན་སེམས་"
    },
    {
      "span": {
        "start": 1195,
        "end": 1199
      },
      "text": "ཉིད་ ༼པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 1447,
        "end": 1454
      },
      "text": "ཏིང་ངེ་ ༼པེ།༽ ཏིང་"
    },
    {
      "span": {
        "start": 1604,
        "end": 1609
      },
      "text": "འཛིན་ ༼པེ།༽ ངེ་འཛིན་ནི་"
    },
    {
      "span": {
        "start": 1669,
        "end": 1677
      },
      "text": "དེའི་ཡང་ ༼པེ།༽ དེ་ཡང་"
    },
    {
      "span": {
        "start": 1769,
        "end": 1780
      },
      "text": "ཕྱོགས་སུ་མ་ ༼པེ།༽ ཕྱོགས་གསུམ་"
    },
    {
      "span": {
        "start": 1861,
        "end": 1870
      },
      "text": "བསྒོམས་པ་ ༼པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 2049,
        "end": 2054
      },
      "text": "བསྟན་ ༼པེ།༽ སྟན་"
    },
    {
      "span": {
        "start": 2300,
        "end": 2307
      },
      "text": "བསྟན་པ་ ༼པེ།༽ སྟན་པ་"
    },
    {
      "span": {
        "start": 3032,
        "end": 3037
      },
      "text": "རྣམས་ ༼པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 3332,
        "end": 3337
      },
      "text": "ཁང་པ་ ༼པེ།༽ ཁང་པ་པ་"
    }
  ]
}