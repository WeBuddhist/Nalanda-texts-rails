{
  "durchens": [
    {
      "span": {
        "start": 519,
        "end": 524
      },
      "text": "དབུལ། ༼སྣར། པེ།༽ འབུལ།"
    },
    {
      "span": {
        "start": 659,
        "end": 668
      },
      "text": "བཅའ་བ་དང་ ༼སྣར། པེ།༽ བཅའ་ཞིང་"
    },
    {
      "span": {
        "start": 1416,
        "end": 1426
      },
      "text": "བྱིན་གྱིས་ ༼སྣར། པེ།༽ བྱིན་གྱི་"
    },
    {
      "span": {
        "start": 1623,
        "end": 1631
      },
      "text": "སྦྱང་བར་ ༼སྣར། པེ།༽ སྦྱངས་པར་"
    },
    {
      "span": {
        "start": 1670,
        "end": 1675
      },
      "text": "བརླབ། ༼སྣར། པེ།༽ བརླབས།"
    },
    {
      "span": {
        "start": 1693,
        "end": 1695
      },
      "text": "ཀ་ ༼སྣར། པེ།༽ དྷྲིཀ་"
    },
    {
      "span": {
        "start": 1804,
        "end": 1816
      },
      "text": "རྡོ་རྗེ་རྩེ་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 1831,
        "end": 1833
      },
      "text": "ར་ ༼སྣར། པེ།༽ རྭ་"
    },
    {
      "span": {
        "start": 1850,
        "end": 1858
      },
      "text": "ཨོཾ་གྱི་ ༼སྣར། པེ།༽ ཨོཾ་གྱིས་"
    },
    {
      "span": {
        "start": 1866,
        "end": 1871
      },
      "text": "གྱིས་ ༼སྣར། པེ།༽ གྱི་"
    },
    {
      "span": {
        "start": 2454,
        "end": 2461
      },
      "text": "མཁན་པོ་ ༼སྣར། པེ།༽ མཁས་པ་"
    }
  ]
}