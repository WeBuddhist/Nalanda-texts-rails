{
  "durchens": [
    {
      "span": {
        "start": 290,
        "end": 300
      },
      "text": "སརྦྦ་ཏྲ་ཡ་ ༼སྣར། པེ།༽ སརྦྦཏྲཱ་ཨ་"
    },
    {
      "span": {
        "start": 472,
        "end": 474
      },
      "text": "ག་ ༼སྣར། པེ།༽ བྷ་"
    },
    {
      "span": {
        "start": 474,
        "end": 476
      },
      "text": "ག་ ༼སྣར། པེ།༽ ག་ཝ་"
    },
    {
      "span": {
        "start": 1333,
        "end": 1347
      },
      "text": "ལྷག་པའི་ཆོས་ལ་ ༼སྣར། པེ།༽ ལྷག་མ་དང་"
    },
    {
      "span": {
        "start": 1572,
        "end": 1583
      },
      "text": "པའི་ཆོས་ཏེ་ ༼སྣར། པེ།༽ ཀྱང་རུང་སྟེ་"
    },
    {
      "span": {
        "start": 1767,
        "end": 1774
      },
      "text": "བརྟན་པ་ ༼སྣར། པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 1793,
        "end": 1798
      },
      "text": "བོའི་ ༼སྣར། པེ།༽ བོ་ནི་"
    }
  ]
}