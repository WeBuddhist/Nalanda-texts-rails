{
  "durchens": [
    {
      "span": {
        "start": 245,
        "end": 249
      },
      "text": "རྩད་ ༼སྣར། པེ།༽ རྩ་"
    },
    {
      "span": {
        "start": 536,
        "end": 544
      },
      "text": "སྙན་པའི་ ༼སྣར། པེ།༽ དབེན་པའི་"
    },
    {
      "span": {
        "start": 633,
        "end": 639
      },
      "text": "དེ་ནས་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 679,
        "end": 682
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 802,
        "end": 810
      },
      "text": "གཡོན་པས་ ༼སྣར། པེ།༽ གཡོན་པ་"
    },
    {
      "span": {
        "start": 850,
        "end": 859
      },
      "text": "དཔའ་བོའི་ ༼སྣར། པེ།༽ དཔའ་བོ་"
    },
    {
      "span": {
        "start": 1031,
        "end": 1039
      },
      "text": "ཕྲ་བ་ཡི། ༼སྣར། པེ།༽ ཕྲ་བ་ཡིས།"
    },
    {
      "span": {
        "start": 1314,
        "end": 1318
      },
      "text": "རེག་ ༼པེ།༽ རེ་"
    },
    {
      "span": {
        "start": 1683,
        "end": 1692
      },
      "text": "ངོ་བོ་ཡི། ༼སྣར། པེ།༽ ངོ་བོ་ཡིས།"
    },
    {
      "span": {
        "start": 1836,
        "end": 1839
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 1849,
        "end": 1856
      },
      "text": "འདུ་བས་ ༼སྣར། པེ།༽ འདུ་བར་"
    },
    {
      "span": {
        "start": 1926,
        "end": 1933
      },
      "text": "སྦྱོང་། ༼སྣར། པེ།༽ སྦྱོར་ྱོང་།"
    },
    {
      "span": {
        "start": 2130,
        "end": 2137
      },
      "text": "སྲེག་པ་ ༼སྣར། པེ།༽ བསྲེག་པ་"
    },
    {
      "span": {
        "start": 2284,
        "end": 2288
      },
      "text": "ཡིག་ ༼སྣར། པེ།༽ ཡི་གེ་"
    },
    {
      "span": {
        "start": 2294,
        "end": 2300
      },
      "text": "དང་ནི་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 2322,
        "end": 2328
      },
      "text": "དབྱུང་ ༼སྣར། པེ།༽ དབྱུག་"
    },
    {
      "span": {
        "start": 2395,
        "end": 2402
      },
      "text": "ཉི་མའོ། ༼སྣར། པེ།༽ ཉེ་བའོ།"
    },
    {
      "span": {
        "start": 2479,
        "end": 2485
      },
      "text": "སྐྱོང་ ༼སྣར། པེ།༽ སྐྱོབ་"
    },
    {
      "span": {
        "start": 2574,
        "end": 2584
      },
      "text": "ལ་སོགས་པས། ༼སྣར། པེ།༽ ལ་སོགས་པ།"
    },
    {
      "span": {
        "start": 2632,
        "end": 2640
      },
      "text": "ངོ་བོའི་ ༼སྣར། པེ།༽ ངོ་བོ་"
    },
    {
      "span": {
        "start": 2719,
        "end": 2729
      },
      "text": "སྒྲུབ་ངའི་ ༼སྣར། པེ།༽ དངོས་ཀྱི་"
    },
    {
      "span": {
        "start": 2854,
        "end": 2857
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 3157,
        "end": 3162
      },
      "text": "འདུས་ ༼སྣར། པེ།༽ འདུ་"
    },
    {
      "span": {
        "start": 3204,
        "end": 3209
      },
      "text": "བྱ། ། ༼སྣར། པེ།༽ ། །སྣ་དང་"
    },
    {
      "span": {
        "start": 3212,
        "end": 3217
      },
      "text": "བ་དང་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 3233,
        "end": 3239
      },
      "text": "གོང་མ་ ༼སྣར། པེ།༽ གོང་ལ་"
    },
    {
      "span": {
        "start": 3271,
        "end": 3279
      },
      "text": "ཕྲིན་ལས་ ༼སྣར། པེ།༽ འཕྲིན་ལས་"
    },
    {
      "span": {
        "start": 3287,
        "end": 3290
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 3298,
        "end": 3309
      },
      "text": "ཞི་བ་གསུངས་ ༼སྣར། པེ།༽ བཞི་པར་འདོད་"
    },
    {
      "span": {
        "start": 3311,
        "end": 3314
      },
      "text": "ནི། ༼སྣར། པེ།༽ ཡིས།"
    },
    {
      "span": {
        "start": 3379,
        "end": 3384
      },
      "text": "གདུག་ ༼སྣར། པེ།༽ སྡིག་"
    },
    {
      "span": {
        "start": 3634,
        "end": 3643
      },
      "text": "བཅུད་ཀྱི་ ༼སྣར། པེ།༽ བཅུད་ནི་"
    },
    {
      "span": {
        "start": 3716,
        "end": 3720
      },
      "text": "གཅད་ ༼སྣར། པེ།༽ བཅད་"
    },
    {
      "span": {
        "start": 4177,
        "end": 4182
      },
      "text": "ལུམས་ ༼སྣར། པེ།༽ ཟླུམས་"
    }
  ]
}