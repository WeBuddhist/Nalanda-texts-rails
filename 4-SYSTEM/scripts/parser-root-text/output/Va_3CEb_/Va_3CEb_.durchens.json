{
  "durchens": [
    {
      "span": {
        "start": 213,
        "end": 220
      },
      "text": "དད་པའི་ ༼སྣར། པེ།༽ དག་པའི་"
    },
    {
      "span": {
        "start": 238,
        "end": 244
      },
      "text": "བརྒྱར་ ༼སྣར།༽ བརྒྱ་"
    },
    {
      "span": {
        "start": 437,
        "end": 445
      },
      "text": "སྦྱིན་པ་ ༼སྣར། པེ།༽ སྦྱིན་པར་"
    },
    {
      "span": {
        "start": 579,
        "end": 586
      },
      "text": "ལྡན་པར་ ༼སྣར། པེ།༽ ལྡན་པ་"
    },
    {
      "span": {
        "start": 593,
        "end": 603
      },
      "text": "ཚུལ་ཁྲིམས་ ༼སྣར། པེ།༽ ཁྲུས་ཀྱི་"
    },
    {
      "span": {
        "start": 691,
        "end": 696
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ སྒྱུ་"
    },
    {
      "span": {
        "start": 713,
        "end": 721
      },
      "text": "བགྲོད་པ་ ༼སྣར། པེ།༽ བགྲོད་པ་འམ་"
    },
    {
      "span": {
        "start": 787,
        "end": 795
      },
      "text": "སྟེན་པར་ ༼སྣར། པེ།༽ བརྟེན་པར་"
    },
    {
      "span": {
        "start": 1004,
        "end": 1008
      },
      "text": "དགའ་ ༼སྣར། པེ།༽ འགའ་"
    },
    {
      "span": {
        "start": 1145,
        "end": 1160
      },
      "text": "ཚུལ་ཁྲིམས་ནད་ལ་ ༼སྣར། པེ།༽ ཚུལ་ཁྲིམས་མཆོག་"
    },
    {
      "span": {
        "start": 1200,
        "end": 1208
      },
      "text": "ཉམ་ཐག་ལ་ ༼ཅོ།༽ ཉམ་ཐག་པ་"
    },
    {
      "span": {
        "start": 1228,
        "end": 1234
      },
      "text": "སྲུངས་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 1449,
        "end": 1455
      },
      "text": "སྲུངས། ༼སྣར།༽ བསྲུངས།"
    },
    {
      "span": {
        "start": 1481,
        "end": 1493
      },
      "text": "ཇི་བཞིན་གཞག། ༼སྣར། པེ།༽ ཇི་བཞིན་།"
    },
    {
      "span": {
        "start": 1539,
        "end": 1542
      },
      "text": "རྒ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 1736,
        "end": 1754
      },
      "text": "བསྒྱུར་ཅིང་ཞུས་ཏེ་ ༼སྣར། པེ།༽ བསྒྱུར་ཅིང་"
    }
  ]
}