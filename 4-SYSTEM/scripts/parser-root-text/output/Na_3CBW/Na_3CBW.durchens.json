{
  "durchens": [
    {
      "span": {
        "start": 22,
        "end": 26
      },
      "text": "མང་་ ༼སྣར། པེ།༽ ། །མང་མཾ་གཱ་"
    },
    {
      "span": {
        "start": 47,
        "end": 51
      },
      "text": "བཀྲ་ ༼སྣར།༽ བཀྲི་"
    },
    {
      "span": {
        "start": 286,
        "end": 289
      },
      "text": "ཉེ་ ༼སྣར།༽ ཉེར་"
    },
    {
      "span": {
        "start": 292,
        "end": 297
      },
      "text": "བསྟན་ ༼སྣར།༽ སྟན་"
    },
    {
      "span": {
        "start": 510,
        "end": 519
      },
      "text": "ཡིན་གྱིས་ ༼སྣར། པེ།༽ ཡིན་གྱི་"
    },
    {
      "span": {
        "start": 534,
        "end": 543
      },
      "text": "ཚོགས་ཀྱི་ ༼སྣར། པེ།༽ ཚོགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 1046,
        "end": 1054
      },
      "text": "བལྟམས་པ་ ༼སྣར།༽ བསྟམས་པ་"
    },
    {
      "span": {
        "start": 1054,
        "end": 1056
      },
      "text": "ན། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 1058,
        "end": 1067
      },
      "text": "སྲིད་པའི་ ༼སྣར། པེ།༽ སྲིད་པ་"
    },
    {
      "span": {
        "start": 1403,
        "end": 1410
      },
      "text": "ལྷ་ཡིས་ ༼སྣར། པེ།༽ ལྷ་ཡི་"
    },
    {
      "span": {
        "start": 1516,
        "end": 1522
      },
      "text": "དགྱེས་ ༼སྣར། པེ།༽ གྱེས་"
    },
    {
      "span": {
        "start": 1619,
        "end": 1629
      },
      "text": "ཚོགས་ཀྱིས་ ༼སྣར། པེ།༽ ཚོགས་ཀྱི་"
    },
    {
      "span": {
        "start": 1771,
        "end": 1775
      },
      "text": "རྩྭ་ ༼སྣར། པེ།༽ རྩ་"
    },
    {
      "span": {
        "start": 1902,
        "end": 1908
      },
      "text": "ཙ་ཤའི་ ༼སྣར།༽ རྩ་ཤིའི་ཕྲེང་ ༼པེ།༽ རྩ་ཤིའི་འཕྲེང་"
    },
    {
      "span": {
        "start": 2124,
        "end": 2132
      },
      "text": "བཏུལ་ཏེ་ ༼སྣར།༽ བཏུལ་སྟེ་"
    },
    {
      "span": {
        "start": 2190,
        "end": 2195
      },
      "text": "བྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 2295,
        "end": 2303
      },
      "text": "ནམས་ཀྱི་ ༼སྣར། པེ།༽ ནམ་གྱི་"
    },
    {
      "span": {
        "start": 2325,
        "end": 2329
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 2494,
        "end": 2501
      },
      "text": "བསྟན་པ་ ༼སྣར།༽ བསྟེན་པ་"
    },
    {
      "span": {
        "start": 2525,
        "end": 2529
      },
      "text": "དེང་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 2634,
        "end": 2637
      },
      "text": "དག་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 2655,
        "end": 2658
      },
      "text": "དག་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 2739,
        "end": 2743
      },
      "text": "བཀྲ་ ༼སྣར།༽ ཀྲ་"
    },
    {
      "span": {
        "start": 2799,
        "end": 2809
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 2883,
        "end": 2890
      },
      "text": "པ་རྒྱལ་ ༼སྣར།༽ པའི་རྒྱལ་ ༼པེ།༽ པ་གྱལ་"
    },
    {
      "span": {
        "start": 3324,
        "end": 3330
      },
      "text": "མི་ཡི་ ༼སྣར།༽ མི་ཡིས་"
    },
    {
      "span": {
        "start": 3677,
        "end": 3684
      },
      "text": "བསྒྱུར་ ༼སྣར། པེ།༽ སྒྱུར་"
    }
  ]
}