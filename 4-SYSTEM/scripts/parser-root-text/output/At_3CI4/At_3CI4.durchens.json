{
  "durchens": [
    {
      "span": {
        "start": 47,
        "end": 61
      },
      "text": "ཕྱོགས་སྐྱོང་བ་ ༼སྣར། པེ།༽ ཕྱོགས་སྐྱོང་"
    },
    {
      "span": {
        "start": 282,
        "end": 286
      },
      "text": "བྱས་ ༼སྣར། པེ།༽ བཅས་"
    },
    {
      "span": {
        "start": 640,
        "end": 648
      },
      "text": "ལ་བརྟོད་ ༼སྣར། པེ།༽ ལ་སྟོད་"
    },
    {
      "span": {
        "start": 686,
        "end": 690
      },
      "text": "ཧོམ་ ༼སྣར། པེ།༽ ཧོཾ་"
    },
    {
      "span": {
        "start": 694,
        "end": 701
      },
      "text": "བརྩིགས་ ༼སྣར། པེ།༽ བཙུགས་"
    },
    {
      "span": {
        "start": 832,
        "end": 845
      },
      "text": "བཅུ་གཅིག་གིས་ ༼སྣར། པེ།༽ བཅུ་གཅིག་གི་"
    },
    {
      "span": {
        "start": 860,
        "end": 866
      },
      "text": "མཐའ་མ་ ༼སྣར། པེ།༽ ཐ་མ་"
    },
    {
      "span": {
        "start": 1281,
        "end": 1285
      },
      "text": "བའི་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 1330,
        "end": 1343
      },
      "text": "གོ་རིམས་ཀྱིས་ ༼སྣར། པེ།༽ གོ་རིམས་ཀྱི་"
    },
    {
      "span": {
        "start": 1545,
        "end": 1555
      },
      "text": "རྒྱས་ཀྱིས་ ༼སྣར། པེ།༽ རྒྱས་ཀྱི་"
    },
    {
      "span": {
        "start": 1732,
        "end": 1737
      },
      "text": "དབྱུ་ ༼སྣར། པེ།༽ དབྱུག་"
    },
    {
      "span": {
        "start": 1961,
        "end": 1967
      },
      "text": "གཙིགས་ ༼སྣར།༽ བཙིགས་"
    },
    {
      "span": {
        "start": 2208,
        "end": 2211
      },
      "text": "བེ་ ༼སྣར། པེ།༽ བཻ་"
    },
    {
      "span": {
        "start": 2427,
        "end": 2432
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 2515,
        "end": 2534
      },
      "text": "ཐོགས་པ་བསྐྱེད་དོ། ། ༼སྣར། པེ།༽ ཐོགས་པ་"
    },
    {
      "span": {
        "start": 2578,
        "end": 2585
      },
      "text": "ཐོགས་པ་ ༼སྣར། པེ།༽ ཐོགས་པར་"
    },
    {
      "span": {
        "start": 2805,
        "end": 2810
      },
      "text": "ཆེའི་ ༼སྣར། པེ།༽ ཆེ་"
    },
    {
      "span": {
        "start": 2974,
        "end": 2985
      },
      "text": "བཞུགས་པ་དེ། ༼སྣར། པེ།༽ བཞུགས་པ་སྟེ།"
    },
    {
      "span": {
        "start": 3168,
        "end": 3171
      },
      "text": "ཛྭ་ ༼སྣར། པེ།༽ ཛྭཱ་"
    },
    {
      "span": {
        "start": 3173,
        "end": 3176
      },
      "text": "ཛྭ་ ༼སྣར། པེ།༽ ཛྭཱ་"
    },
    {
      "span": {
        "start": 3213,
        "end": 3218
      },
      "text": "ཛོ་བ་ ༼སྣར། པེ།༽ ཛྭ་བཱ་"
    },
    {
      "span": {
        "start": 3966,
        "end": 3974
      },
      "text": "སྤང་སྟེ་ ༼སྣར། པེ།༽ སྤངས་སྟེངས་"
    },
    {
      "span": {
        "start": 4301,
        "end": 4306
      },
      "text": "བསྐང་ ༼སྣར། པེ།༽ བཀང་"
    },
    {
      "span": {
        "start": 4460,
        "end": 4466
      },
      "text": "རང་བར་ ༼སྣར། པེ།༽ རངས་པར་"
    }
  ]
}