{
  "durchens": [
    {
      "span": {
        "start": 2013,
        "end": 2018
      },
      "text": "བཀུམ་ ༼པེ།༽ བརྐུམ་"
    },
    {
      "span": {
        "start": 2353,
        "end": 2356
      },
      "text": "དྲ་ ༼སྣར།༽ ཏྲ་"
    },
    {
      "span": {
        "start": 2842,
        "end": 2853
      },
      "text": "བརྒྱད་ཀྱིས་ ༼སྣར།༽ བརྒྱད་ཀྱི་"
    },
    {
      "span": {
        "start": 3490,
        "end": 3495
      },
      "text": "འབྱུང་པོ་ ༼སྣར།༽ འབྱུང་པོ་སེམས་ཅན་"
    },
    {
      "span": {
        "start": 4730,
        "end": 4734
      },
      "text": "མཚན་ ༼པེ།༽ ཚན་"
    },
    {
      "span": {
        "start": 4953,
        "end": 4959
      },
      "text": "གཞུག ། ༼པེ།༽ བཞུག །"
    },
    {
      "span": {
        "start": 5033,
        "end": 5040
      },
      "text": "བརྩིབས་ ༼པེ།༽ རྩིབས་"
    },
    {
      "span": {
        "start": 5431,
        "end": 5439
      },
      "text": "མིང་མིང་ ༼པེ།༽ མིང་"
    },
    {
      "span": {
        "start": 5495,
        "end": 5499
      },
      "text": "ལྕེ་ ༼པེ།༽ ལྕེ་ལ་"
    },
    {
      "span": {
        "start": 5577,
        "end": 5583
      },
      "text": "གདིང་། ༼པེ།༽ བདིང་།"
    },
    {
      "span": {
        "start": 5945,
        "end": 5956
      },
      "text": "མགུལ་མཆིངས་ ༼པེ།༽ མགུལ་ཆིངས་"
    },
    {
      "span": {
        "start": 6821,
        "end": 6826
      },
      "text": "བཏུམ། ༼པེ།༽ གཏུམ།"
    },
    {
      "span": {
        "start": 7150,
        "end": 7156
      },
      "text": "གཞུག ། ༼པེ།༽ བཞུག །"
    },
    {
      "span": {
        "start": 7167,
        "end": 7174
      },
      "text": "བསྟན་པ་ ༼པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 7594,
        "end": 7599
      },
      "text": "རྟོང་ ༼སྣར།༽ གཏོང་"
    },
    {
      "span": {
        "start": 8381,
        "end": 8386
      },
      "text": "ལྐོག་ ༼པེ།༽ དགག་"
    },
    {
      "span": {
        "start": 8808,
        "end": 8816
      },
      "text": "བསད་པའི་ ༼པེ།༽ གསད་པའི་"
    },
    {
      "span": {
        "start": 9002,
        "end": 9007
      },
      "text": "ཉུངས་ ༼སྣར།༽ ཉུང་"
    },
    {
      "span": {
        "start": 9760,
        "end": 9762
      },
      "text": "ལ་ ༼སྣར།༽ ལ་ནས་ཀྱིས་"
    },
    {
      "span": {
        "start": 11146,
        "end": 11150
      },
      "text": "དོང་ ༼པེ།༽ ནོང་"
    },
    {
      "span": {
        "start": 11153,
        "end": 11157
      },
      "text": "གཞུག་ ༼པེ།༽ བཞུག་"
    },
    {
      "span": {
        "start": 11281,
        "end": 11293
      },
      "text": "བརྫུས་སྐྱེས་ ༼པེ།༽ རྫུས་སྐྱེས་"
    }
  ]
}