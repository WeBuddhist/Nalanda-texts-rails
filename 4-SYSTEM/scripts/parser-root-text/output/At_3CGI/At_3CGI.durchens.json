{
  "durchens": [
    {
      "span": {
        "start": 306,
        "end": 310
      },
      "text": "བྲིས། ༼པེ། སྣར།༽ ལ།"
    },
    {
      "span": {
        "start": 323,
        "end": 328
      },
      "text": "འཁོར། ༼པེ། སྣར།༽ འཁོར་དུ།"
    },
    {
      "span": {
        "start": 340,
        "end": 345
      },
      "text": "སཱཙྪ། ༼པེ། སྣར།༽ ས་ཏ་ས།"
    },
    {
      "span": {
        "start": 435,
        "end": 445
      },
      "text": "ལྷ་བཤོས་ལ། ༼པེ། སྣར།༽ ལྷ་བཤོས་ལ།"
    },
    {
      "span": {
        "start": 529,
        "end": 537
      },
      "text": "སྟེང་དུ། ༼པེ། སྣར།༽ བསྐོར་བ་ལྟར་བཞག"
    },
    {
      "span": {
        "start": 630,
        "end": 635
      },
      "text": "རུསྐ་ ༼པེ། སྣར།༽ དུ་རུ་ཀ"
    },
    {
      "span": {
        "start": 729,
        "end": 734
      },
      "text": "སཱཙྪ། ༼པེ། སྣར།༽ སཏྶ།"
    },
    {
      "span": {
        "start": 755,
        "end": 760
      },
      "text": "འབུལ་ ༼པེ། སྣར།༽ དབུལ།"
    },
    {
      "span": {
        "start": 811,
        "end": 816
      },
      "text": "གཡོག་ ༼པེ། སྣར།༽ ཡོན།"
    },
    {
      "span": {
        "start": 1419,
        "end": 1424
      },
      "text": "གཏུང་ ༼པེ། སྣར།༽ བཏང་།"
    }
  ]
}