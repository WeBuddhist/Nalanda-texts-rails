{
  "durchens": [
    {
      "span": {
        "start": 86,
        "end": 95
      },
      "text": "བསྐུར་བར་ ༼སྣར། པེ།༽ བསྐུར་"
    },
    {
      "span": {
        "start": 282,
        "end": 294
      },
      "text": "ཐིག་ལེའུ་ཙེ་ ༼སྣར། པེ།༽ ཐིག་ལེ་རྩེ་"
    },
    {
      "span": {
        "start": 305,
        "end": 310
      },
      "text": "ལེའུ་ ༼སྣར། པེ།༽ ལིང་"
    },
    {
      "span": {
        "start": 346,
        "end": 351
      },
      "text": "ལེའུ་ ༼སྣར། པེ།༽ ལིང་"
    },
    {
      "span": {
        "start": 519,
        "end": 525
      },
      "text": "འབབ་པ་ ༼སྣར། པེ།༽ བབ་པ་"
    },
    {
      "span": {
        "start": 559,
        "end": 563
      },
      "text": "རིམ་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 588,
        "end": 597
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 767,
        "end": 771
      },
      "text": "ཁའི་ ༼སྣར། པེ།༽ གའི་"
    },
    {
      "span": {
        "start": 1022,
        "end": 1027
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ བསྒྱུར་"
    },
    {
      "span": {
        "start": 1221,
        "end": 1230
      },
      "text": "ཧཱ་ཞེས་པ་ ༼སྣར། པེ།༽ ཧཱ་ཞེས་"
    },
    {
      "span": {
        "start": 1323,
        "end": 1328
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ སྲུངས་"
    },
    {
      "span": {
        "start": 1416,
        "end": 1423
      },
      "text": "གཡས་པས་ ༼སྣར། པེ།༽ གཡས་པ་"
    },
    {
      "span": {
        "start": 1530,
        "end": 1541
      },
      "text": "མཛུབ་མོ་དང་ ༼སྣར། པེ།༽ མཛུབ་མོ་"
    },
    {
      "span": {
        "start": 1921,
        "end": 1929
      },
      "text": "བསྐོར་བ་ ༼སྣར། པེ།༽ བསྐོར་བ་ལ་"
    },
    {
      "span": {
        "start": 1934,
        "end": 1938
      },
      "text": "དམར་ ༼སྣར། པེ།༽ དམར་བ་"
    },
    {
      "span": {
        "start": 2106,
        "end": 2110
      },
      "text": "ཞེས་ ༼སྣར། པེ།༽ ཞེས་བརྒྱ་"
    },
    {
      "span": {
        "start": 2193,
        "end": 2200
      },
      "text": "རྐྱལ་པ་ ༼སྣར། པེ།༽ བརྐྱལ་པ་"
    },
    {
      "span": {
        "start": 2217,
        "end": 2223
      },
      "text": "བཀང་བ་ ༼སྣར། པེ།༽ བསྐང་བ་"
    },
    {
      "span": {
        "start": 2595,
        "end": 2602
      },
      "text": "གཏོང་བ་ ༼སྣར། པེ།༽ བཏང་བ་"
    }
  ]
}