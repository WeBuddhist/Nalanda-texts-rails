{
  "durchens": [
    {
      "span": {
        "start": 401,
        "end": 405
      },
      "text": "མཆན་ ༼སྣར། པེ།༽ འཆན་"
    },
    {
      "span": {
        "start": 803,
        "end": 813
      },
      "text": "སྔགས་ཀྱིས་ ༼སྣར། པེ།༽ སྔགས་ཀྱི་"
    },
    {
      "span": {
        "start": 1139,
        "end": 1145
      },
      "text": "ཤར་དུ་ ༼སྣར། པེ།༽ ཤར་"
    },
    {
      "span": {
        "start": 1153,
        "end": 1161
      },
      "text": "ཤར་ལྷོར་ ༼སྣར། པེ།༽ ཤར་ལྷོ་"
    },
    {
      "span": {
        "start": 1421,
        "end": 1427
      },
      "text": "གསར་པ་ ༼སྣར། པེ།༽ སར་པ་"
    },
    {
      "span": {
        "start": 1980,
        "end": 1990
      },
      "text": "འཛིན་གྱིས་ ༼སྣར། པེ།༽ འཛིན་གྱི་"
    },
    {
      "span": {
        "start": 2191,
        "end": 2200
      },
      "text": "ཕྱིར་དང་། ༼སྣར། པེ།༽ ཕྱིར།"
    },
    {
      "span": {
        "start": 2252,
        "end": 2258
      },
      "text": "ཕྱི་བ་ ༼སྣར། པེ།༽ ཕྱེ་བ་"
    },
    {
      "span": {
        "start": 2330,
        "end": 2333
      },
      "text": "བི་ ༼སྣར། པེ།༽ བྷི་"
    }
  ]
}