{
  "durchens": [
    {
      "span": {
        "start": 232,
        "end": 240
      },
      "text": "གདམས་ངག་ ༼སྣར། པེ།༽ མན་ངག་"
    },
    {
      "span": {
        "start": 826,
        "end": 833
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 846,
        "end": 865
      },
      "text": "དཀོན་མཆོག་གསུམ་གྱི་ ༼སྣར།༽ དཀོན་མཆོག་གི་"
    },
    {
      "span": {
        "start": 871,
        "end": 876
      },
      "text": "བརྙན་ ༼སྣར། པེ།༽ རྙན་"
    },
    {
      "span": {
        "start": 926,
        "end": 938
      },
      "text": "སེམས་ཅན་གྱི་ ༼སྣར།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 994,
        "end": 999
      },
      "text": "རྫུས་ ༼སྣར། པེ།༽ བརྫུས་"
    },
    {
      "span": {
        "start": 1051,
        "end": 1062
      },
      "text": "འདུ་ཤེས་ཅན་ ༼སྣར།༽ འདུ་ཤེས་"
    },
    {
      "span": {
        "start": 1282,
        "end": 1285
      },
      "text": "ཞལ་ ༼སྣར། པེ།༽ ཞལ་སྔ་"
    },
    {
      "span": {
        "start": 1331,
        "end": 1335
      },
      "text": "རྣམ་ ༼སྣར།༽ རྣམས་"
    },
    {
      "span": {
        "start": 1341,
        "end": 1345
      },
      "text": "ལ། ། ༼པེ།༽ ། །ཕུ་"
    },
    {
      "span": {
        "start": 1390,
        "end": 1398
      },
      "text": "གདོན་པར་ ༼སྣར། པེ།༽ འདོན་པར་"
    },
    {
      "span": {
        "start": 1666,
        "end": 1673
      },
      "text": "ཤེས་པས་ ༼སྣར།༽ ཤེས་"
    },
    {
      "span": {
        "start": 1701,
        "end": 1709
      },
      "text": "དགྲོལ་བ་ ༼སྣར།༽ བགྲོལ་བ་"
    },
    {
      "span": {
        "start": 1814,
        "end": 1821
      },
      "text": "བསག་པར་ ༼སྣར། པེ།༽ བསགས་པར་"
    },
    {
      "span": {
        "start": 2449,
        "end": 2457
      },
      "text": "བརྟགས་ན་ ༼སྣར། པེ།༽ བརྟགས་ནས་"
    },
    {
      "span": {
        "start": 2743,
        "end": 2752
      },
      "text": "རྟོག་པའི་ ༼སྣར། པེ།༽ རྟོགས་པའི་"
    },
    {
      "span": {
        "start": 2836,
        "end": 2843
      },
      "text": "ཅིར་ཡང་ ༼སྣར།༽ ཅིར་"
    },
    {
      "span": {
        "start": 3145,
        "end": 3150
      },
      "text": "གྲངས་ ༼སྣར།༽ མངས་"
    },
    {
      "span": {
        "start": 3190,
        "end": 3203
      },
      "text": "གྱུར་ཅིང་ཅུང་ ༼སྣར།༽ གྱུར་ཅིང་"
    },
    {
      "span": {
        "start": 3206,
        "end": 3213
      },
      "text": "བརྟན་པ་ ༼སྣར།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 3215,
        "end": 3218
      },
      "text": "ཇེ་ ༼སྣར། པེ།༽ ཇི་"
    },
    {
      "span": {
        "start": 3222,
        "end": 3225
      },
      "text": "ཇེ་ ༼སྣར། པེ།༽ ཇི་"
    },
    {
      "span": {
        "start": 3258,
        "end": 3267
      },
      "text": "གཉེན་པོས་ ༼སྣར།༽ གཉེན་པོའི་"
    },
    {
      "span": {
        "start": 3290,
        "end": 3294
      },
      "text": "ཕྱེ་ ༼སྣར།༽ ཆེ་"
    },
    {
      "span": {
        "start": 3452,
        "end": 3460
      },
      "text": "བརྫུན་པ་ ༼སྣར། པེ།༽ རྫུན་པ་"
    },
    {
      "span": {
        "start": 3577,
        "end": 3584
      },
      "text": "ཏེ་ཚ་ཚ་ ༼སྣར། པེ།༽ ཏེ་སཱཙྪ་"
    },
    {
      "span": {
        "start": 3956,
        "end": 3964
      },
      "text": "སེམས་ནི་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 4375,
        "end": 4381
      },
      "text": "རྟོགས་ ༼སྣར། པེ།༽ གཏོགས་"
    },
    {
      "span": {
        "start": 4584,
        "end": 4594
      },
      "text": "བསྒོམས་པས་ ༼པེ།༽ བསྒོམ་པས་"
    },
    {
      "span": {
        "start": 4651,
        "end": 4659
      },
      "text": "གཉིས་པོ་ ༼སྣར།༽ གཉིད་པོ་"
    },
    {
      "span": {
        "start": 4781,
        "end": 4788
      },
      "text": "སྡུད་པ་ ༼སྣར། པེ།༽ བསྡུད་པ་"
    },
    {
      "span": {
        "start": 5068,
        "end": 5075
      },
      "text": "སྡུད་པ་ ༼སྣར། པེ།༽ བསྡུད་པ་"
    },
    {
      "span": {
        "start": 5734,
        "end": 5736
      },
      "text": "པ་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 5841,
        "end": 5847
      },
      "text": "ཞལ་སྔ་ ༼སྣར། པེ།༽ ཞལ་"
    },
    {
      "span": {
        "start": 5856,
        "end": 5866
      },
      "text": "སེམས་ཀྱིས་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 5907,
        "end": 5912
      },
      "text": "བྱ་བ་ ༼སྣར།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 5983,
        "end": 5990
      },
      "text": "སྡུད་པ་ ༼སྣར། པེ།༽ བསྡུད་པ་"
    },
    {
      "span": {
        "start": 6301,
        "end": 6313
      },
      "text": "བྱང་ཆུབ་ཀྱི་ ༼སྣར།༽ བྱང་ཆུབ་ཀྱིས་"
    },
    {
      "span": {
        "start": 6349,
        "end": 6362
      },
      "text": "བསྐྱེད་དུ་ཤས་ ༼སྣར། པེ།༽ སུ་འདུ་ཤས་"
    },
    {
      "span": {
        "start": 6580,
        "end": 6590
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 7223,
        "end": 7227
      },
      "text": "གཞན་ ༼སྣར། པེ།༽ གཞན་དུ་"
    },
    {
      "span": {
        "start": 7513,
        "end": 7526
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 7603,
        "end": 7608
      },
      "text": "སྤངས་ ༼ཅོ།༽ སྤང་"
    },
    {
      "span": {
        "start": 7642,
        "end": 7649
      },
      "text": "བཟུང་བ་ ༼ཅོ།༽ གཟུང་བ་"
    },
    {
      "span": {
        "start": 7684,
        "end": 7690
      },
      "text": "སླུ་བ་ ༼སྣར། པེ།༽ བསླུ་བ་"
    },
    {
      "span": {
        "start": 7732,
        "end": 7739
      },
      "text": "བྱས་པས་ ༼སྣར། པེ།༽ བྱས་པར་"
    },
    {
      "span": {
        "start": 7847,
        "end": 7850
      },
      "text": "ཡི་ ༼སྣར། པེ།༽ ཡིད་"
    },
    {
      "span": {
        "start": 7894,
        "end": 7904
      },
      "text": "འགྱེད་པའི་ ༼སྣར། པེ།༽ དགྱེས་པའི་"
    },
    {
      "span": {
        "start": 8555,
        "end": 8563
      },
      "text": "བཀླགས་པ་ ༼སྣར། པེ།༽ ཀླག་པ་"
    },
    {
      "span": {
        "start": 8855,
        "end": 8863
      },
      "text": "བཀླགས་པ་ ༼སྣར། པེ།༽ ཀླག་པ་"
    },
    {
      "span": {
        "start": 9356,
        "end": 9362
      },
      "text": "སྐྱབས་ ༼སྣར། པེ།༽ སྐྱབས་གནས་"
    },
    {
      "span": {
        "start": 9381,
        "end": 9384
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལས་ནི།"
    },
    {
      "span": {
        "start": 9477,
        "end": 9483
      },
      "text": "མྱ་ངན་ ༼སྣར། པེ།༽ མྱ་ངན་ལས་"
    },
    {
      "span": {
        "start": 9614,
        "end": 9618
      },
      "text": "གཞག་ ༼སྣར།༽ གཞུགས་"
    },
    {
      "span": {
        "start": 9690,
        "end": 9698
      },
      "text": "རྒྱས་པས་ ༼སྣར། པེ།༽ རྒྱས་པར་"
    },
    {
      "span": {
        "start": 9844,
        "end": 9852
      },
      "text": "གི་ཕྱིར་ ༼སྣར། པེ།༽ གི་ཕྱིར་ཡང་"
    },
    {
      "span": {
        "start": 9855,
        "end": 9860
      },
      "text": "གཏོང་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 10012,
        "end": 10020
      },
      "text": "དབུལ་བར་ ༼སྣར།༽ དབུལ་"
    },
    {
      "span": {
        "start": 10083,
        "end": 10088
      },
      "text": "དགོས་ ༼སྡེ།༽ དེ་གོས་"
    },
    {
      "span": {
        "start": 10165,
        "end": 10171
      },
      "text": "སྤང་བ་ ༼སྣར།༽ སྤངས་པ་"
    },
    {
      "span": {
        "start": 10216,
        "end": 10223
      },
      "text": "བྱའོ། ། ༼སྣར། པེ།༽ བྱའི་"
    },
    {
      "span": {
        "start": 10240,
        "end": 10245
      },
      "text": "བསླབ་ ༼སྣར།༽ སླབ་ ༼པེ།༽ སློབ་"
    },
    {
      "span": {
        "start": 10685,
        "end": 10690
      },
      "text": "བལྟས་ ༼སྣར།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 10792,
        "end": 10797
      },
      "text": "དངོས་ ༼པེ།༽ དངོས་པོ་"
    },
    {
      "span": {
        "start": 11050,
        "end": 11059
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་དཔའི་"
    },
    {
      "span": {
        "start": 11114,
        "end": 11122
      },
      "text": "མདོ་སྡེ་ ༼སྣར། པེ།༽ མདོ་སྡེའི་"
    },
    {
      "span": {
        "start": 11711,
        "end": 11718
      },
      "text": "འདུན་པ་ ༼པེ།༽ འདུད་པ་"
    },
    {
      "span": {
        "start": 12016,
        "end": 12020
      },
      "text": "གཞི་ ༼པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 12356,
        "end": 12358
      },
      "text": "ཤ་ ༼སྣར། པེ།༽ ཤཱ་"
    },
    {
      "span": {
        "start": 12360,
        "end": 12363
      },
      "text": "དྭ་ ༼སྣར། པེ།༽ དྭཱ་"
    },
    {
      "span": {
        "start": 12417,
        "end": 12423
      },
      "text": "སྐྱེས་ ༼སྣར།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 12703,
        "end": 12716
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 12822,
        "end": 12830
      },
      "text": "བརྟན་པར་ ༼སྣར། པེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 12953,
        "end": 12964
      },
      "text": "སེམས་པ་དང་། ༼ཅོ།༽ སེམས་པ་སྟེ།"
    },
    {
      "span": {
        "start": 13027,
        "end": 13034
      },
      "text": "གཏོང་བ་ ༼སྣར།༽ བཏང་བ་ ༼པེ།༽ གཏང་བ་"
    },
    {
      "span": {
        "start": 13285,
        "end": 13292
      },
      "text": "གཏོང་བ་ ༼སྣར། པེ།༽ གཏང་བ་"
    },
    {
      "span": {
        "start": 13314,
        "end": 13322
      },
      "text": "སེམས་ཅན་ ༼སྣར། པེ།༽ སེམས་"
    },
    {
      "span": {
        "start": 13325,
        "end": 13332
      },
      "text": "གཏོང་བ་ ༼སྣར། པེ།༽ གཏང་བ་"
    },
    {
      "span": {
        "start": 14137,
        "end": 14147
      },
      "text": "སེམས་ཀྱིས་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 14150,
        "end": 14155
      },
      "text": "གཏོང་ ༼སྣར། པེ།༽ གཏང་"
    },
    {
      "span": {
        "start": 14329,
        "end": 14342
      },
      "text": "ཉེས་པ་ཆེན་པོ་ ༼སྣར། པེ།༽ ཉེས་པ་"
    },
    {
      "span": {
        "start": 14638,
        "end": 14649
      },
      "text": "འདུ་ཤེས་སོ། ༼སྣར། པེ།༽ འདུ་ཤེས་བྱའོ།"
    },
    {
      "span": {
        "start": 14786,
        "end": 14795
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 14799,
        "end": 14803
      },
      "text": "གིས་ ༼སྣར། པེ།༽ གི་"
    },
    {
      "span": {
        "start": 14820,
        "end": 14826
      },
      "text": "བཏུབས་ ༼སྣར། པེ།༽ གཏུབས་"
    },
    {
      "span": {
        "start": 14838,
        "end": 14847
      },
      "text": "གནོད་པའི་ ༼སྣར། པེ།༽ གནོད་"
    },
    {
      "span": {
        "start": 15034,
        "end": 15043
      },
      "text": "གཞན་གྱིས་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 15096,
        "end": 15099
      },
      "text": "ཤད་ ༼སྣར། པེ།༽ བཤད་"
    },
    {
      "span": {
        "start": 15248,
        "end": 15255
      },
      "text": "གཏོང་བ་ ༼སྣར།༽ བཏང་བ་ ༼པེ།༽ གཏང་བ་"
    },
    {
      "span": {
        "start": 15307,
        "end": 15312
      },
      "text": "མཚམས་ ༼སྣར།༽ མཚམ་"
    },
    {
      "span": {
        "start": 15360,
        "end": 15373
      },
      "text": "སྣ་ཚོགས་ཀྱིས་ ༼སྣར། པེ།༽ སྣ་ཚོགས་ཀྱི་"
    },
    {
      "span": {
        "start": 15412,
        "end": 15417
      },
      "text": "གཏོང་ ༼སྣར། པེ།༽ གཏང་"
    },
    {
      "span": {
        "start": 16021,
        "end": 16032
      },
      "text": "མཚམས་མེད་པ་ ༼སྣར། པེ།༽ མཚམས་མེད་"
    },
    {
      "span": {
        "start": 16189,
        "end": 16197
      },
      "text": "སྲུང་བར་ ༼སྣར། པེ།༽ བསྲུང་བར་"
    },
    {
      "span": {
        "start": 16242,
        "end": 16247
      },
      "text": "མེ་མ་ ༼སྣར། པེ།༽ མེ་"
    },
    {
      "span": {
        "start": 16351,
        "end": 16361
      },
      "text": "འགྱུར་ཞེས། ༼སྣར། པེ།༽ འགྱུར་ཅེས།"
    },
    {
      "span": {
        "start": 16363,
        "end": 16371
      },
      "text": "མཆི་མའང་ ༼སྣར། པེ།༽ མཆི་མ་"
    },
    {
      "span": {
        "start": 16590,
        "end": 16597
      },
      "text": "གཏོང་བ་ ༼སྣར།༽ བཏང་བ་ ༼པེ།༽ གཏང་བ་"
    },
    {
      "span": {
        "start": 16609,
        "end": 16619
      },
      "text": "སེམས་ཀྱིས་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 16734,
        "end": 16740
      },
      "text": "རང་གི་ ༼སྣར། པེ།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 16809,
        "end": 16813
      },
      "text": "ཕུག་ ༼སྣར། པེ།༽ ཕུ་"
    },
    {
      "span": {
        "start": 17195,
        "end": 17201
      },
      "text": "རྒྱུད་ ༼སྣར།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 17419,
        "end": 17425
      },
      "text": "བརྒྱད་ ༼སྣར།༽ བརྒྱད་པོ་"
    },
    {
      "span": {
        "start": 17445,
        "end": 17452
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 17502,
        "end": 17508
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 17512,
        "end": 17515
      },
      "text": "ཏུ། ༼སྣར། པེ།༽ གུ།"
    },
    {
      "span": {
        "start": 17589,
        "end": 17604
      },
      "text": "མེད་པར་བྱེད་པར་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 17671,
        "end": 17678
      },
      "text": "གྲོལ་བ་ ༼སྣར། པེ།༽ སྒྲོལ་བ་"
    },
    {
      "span": {
        "start": 17783,
        "end": 17796
      },
      "text": "སྙམ་པའི་སེམས་ ༼སྣར། པེ།༽ སྙམ་"
    },
    {
      "span": {
        "start": 17859,
        "end": 17867
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 18123,
        "end": 18127
      },
      "text": "བདེ་ ༼སྣར། པེ།༽ བདེ་བ་དེ་"
    },
    {
      "span": {
        "start": 18391,
        "end": 18397
      },
      "text": "བསྔོས་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 18639,
        "end": 18646
      },
      "text": "གཟུང་བ་ ༼སྣར། པེ།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 18717,
        "end": 18722
      },
      "text": "བརྔན་ ༼སྣར། པེ།༽ རྔན་"
    },
    {
      "span": {
        "start": 18864,
        "end": 18873
      },
      "text": "བྱུང་བའི་ ༼སྣར། པེ།༽ འབྱུང་བའི་"
    },
    {
      "span": {
        "start": 19373,
        "end": 19376
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 19514,
        "end": 19523
      },
      "text": "བསྟེན་པར་ ༼སྣར། པེ།༽ བརྟེན་པར་"
    },
    {
      "span": {
        "start": 19673,
        "end": 19680
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 20220,
        "end": 20228
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 20420,
        "end": 20425
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱང་བ་"
    },
    {
      "span": {
        "start": 20509,
        "end": 20518
      },
      "text": "བརྗེད་པར་ ༼སྣར། པེ།༽ རྗེད་པར་"
    },
    {
      "span": {
        "start": 20567,
        "end": 20573
      },
      "text": "བསྲུང་ ༼སྣར། པེ།༽ བསྲུང་བར་བྱ་"
    },
    {
      "span": {
        "start": 20685,
        "end": 20691
      },
      "text": "སླུ་བ་ ༼སྣར། པེ།༽ བསླུ་བ་"
    },
    {
      "span": {
        "start": 20804,
        "end": 20811
      },
      "text": "ཡིན་པས་ ༼སྣར། པེ།༽ ཡིན་པ་"
    },
    {
      "span": {
        "start": 21022,
        "end": 21029
      },
      "text": "གསོད་པ་ ༼སྣར། པེ།༽ སོད་པ་"
    },
    {
      "span": {
        "start": 21158,
        "end": 21162
      },
      "text": "སྡང་ ༼སྣར། པེ།༽ ལྡང་"
    },
    {
      "span": {
        "start": 21202,
        "end": 21211
      },
      "text": "བྱེད་པའོ། ༼སྣར། པེ།༽ བྱེད་པ་དང་།"
    },
    {
      "span": {
        "start": 21981,
        "end": 21992
      },
      "text": "བརྗེད་ངས་པ་ ༼སྣར། པེ།༽ བརྗེད་ངས་པ་པ་"
    },
    {
      "span": {
        "start": 22437,
        "end": 22449
      },
      "text": "བལྟ་བར་བྱའོ། ༼སྣར། པེ།༽ བལྟའོ།"
    },
    {
      "span": {
        "start": 23006,
        "end": 23019
      },
      "text": "ཐམས་ཅད་ལ་གསད་ ༼སྣར། པེ།༽ ཐམས་ཅད་བསད་"
    },
    {
      "span": {
        "start": 23047,
        "end": 23051
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིའི་"
    },
    {
      "span": {
        "start": 23051,
        "end": 23058
      },
      "text": "སྡིག་པ་ ༼སྣར། པེ།༽ སྡིག་"
    },
    {
      "span": {
        "start": 23418,
        "end": 23426
      },
      "text": "རུང་གི ། ༼སྣར། པེ།༽ རུང་གིས་"
    },
    {
      "span": {
        "start": 23430,
        "end": 23437
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 23497,
        "end": 23511
      },
      "text": "འཇུག་པ་ལ་སོགས་ ༼སྣར། པེ།༽ འཇུག་"
    },
    {
      "span": {
        "start": 23658,
        "end": 23678
      },
      "text": "བསོད་ནམས་ཀྱི་ཕུང་པོ་ ༼སྣར། པེ།༽ བསོད་ནམས་ཀྱི་"
    },
    {
      "span": {
        "start": 23842,
        "end": 23845
      },
      "text": "དྭ་ ༼སྣར། པེ།༽ དྭཱ་"
    },
    {
      "span": {
        "start": 23861,
        "end": 23884
      },
      "text": "བསྐྱེད་པ་ལ་བར་ཆད་བྱ་བར་ ༼སྣར།༽ ལ་བར་ཆད་"
    },
    {
      "span": {
        "start": 23917,
        "end": 23920
      },
      "text": "དྭ་ ༼སྣར། པེ།༽ དྭཱ་"
    },
    {
      "span": {
        "start": 24722,
        "end": 24732
      },
      "text": "མདོ་སྡེའི་ ༼སྣར། པེ།༽ མདོ་སྡེ་"
    },
    {
      "span": {
        "start": 25117,
        "end": 25125
      },
      "text": "བསྒྲུབས་ ༼སྣར། པེ།༽ སྒྲུབས་"
    },
    {
      "span": {
        "start": 25170,
        "end": 25174
      },
      "text": "བཀབ་ ༼སྣར། པེ།༽ བཀག་"
    },
    {
      "span": {
        "start": 25250,
        "end": 25259
      },
      "text": "གཞན་གྱིས་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 25397,
        "end": 25410
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 25975,
        "end": 25989
      },
      "text": "ལེགས་པར་བརྟགས་ ༼སྣར།༽ ལེགས་"
    },
    {
      "span": {
        "start": 26562,
        "end": 26572
      },
      "text": "སེམས་དཔའི་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 26687,
        "end": 26692
      },
      "text": "སྡུད་ ༼སྣར། པེ།༽ བསྡུད་"
    },
    {
      "span": {
        "start": 27393,
        "end": 27402
      },
      "text": "དེ་དང་དེ་ ༼སྡེ།༽ དེ་"
    },
    {
      "span": {
        "start": 28056,
        "end": 28065
      },
      "text": "གསུམ་གྱི་ ༼སྣར། པེ།༽ གསུམ་"
    },
    {
      "span": {
        "start": 28305,
        "end": 28307
      },
      "text": "ཤ་ ༼སྣར། པེ།༽ ཤཱ་"
    },
    {
      "span": {
        "start": 28309,
        "end": 28312
      },
      "text": "དྭ་ ༼སྣར། པེ།༽ དྭཱ་"
    },
    {
      "span": {
        "start": 28886,
        "end": 28889
      },
      "text": "ཉམ་ ༼སྣར།༽ ཉམས་"
    },
    {
      "span": {
        "start": 29121,
        "end": 29134
      },
      "text": "བརྟན་པར་ཟུང་། ༼ཅོ།༽ བརྟན་པ་བཟུང་ ༼སྣར། པེ།༽ བརྟན་པར་བཟུང་།"
    },
    {
      "span": {
        "start": 29145,
        "end": 29160
      },
      "text": "ལ་སོགས་པ་གསུངས་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 29332,
        "end": 29338
      },
      "text": "། ཡང་། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 29410,
        "end": 29417
      },
      "text": "འཆད་པར་ ༼སྣར། པེ།༽ ཆད་པར་"
    },
    {
      "span": {
        "start": 29614,
        "end": 29624
      },
      "text": "གཞན་ཅི་ཡང་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 30089,
        "end": 30098
      },
      "text": "ད་ལྟར་ཡང་ ༼སྣར། པེ།༽ ད་ལྟར་"
    },
    {
      "span": {
        "start": 30550,
        "end": 30556
      },
      "text": "དེ་ཡང་ ༼ཅོ། སྣར།༽ དེ་སྐད་"
    },
    {
      "span": {
        "start": 31236,
        "end": 31242
      },
      "text": "སྦྱིན་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 31429,
        "end": 31436
      },
      "text": "བཏང་བས་ ༼སྣར། པེ།༽ གཏང་བས་"
    },
    {
      "span": {
        "start": 31596,
        "end": 31603
      },
      "text": "འཁོར་བ་ ༼སྣར། པེ།༽ འཁོར་"
    },
    {
      "span": {
        "start": 32363,
        "end": 32374
      },
      "text": "ཆེན་པོ་དང་། ༼སྣར། པེ།༽ ཆེན་པོ་པ།"
    },
    {
      "span": {
        "start": 32571,
        "end": 32575
      },
      "text": "ཤློ་ ༼སྣར། པེ།༽ ཤོ་ལོ་"
    },
    {
      "span": {
        "start": 32640,
        "end": 32655
      },
      "text": "ཀླུ་སྒྲུབ་ཀྱིས་ ༼སྣར། པེ།༽ ཀླུ་སྒྲུབ་ཀྱི་"
    },
    {
      "span": {
        "start": 32707,
        "end": 32719
      },
      "text": "སློབ་དཔོན་མ་ ༼སྣར། པེ།༽ སློབ་དཔོན་མཱ་"
    },
    {
      "span": {
        "start": 32725,
        "end": 32728
      },
      "text": "ཏྲ་ ༼སྣར། པེ།༽ ཊ་"
    },
    {
      "span": {
        "start": 32737,
        "end": 32742
      },
      "text": "ཀྱིས་ ༼སྣར། པེ།༽ ཀྱི་"
    },
    {
      "span": {
        "start": 33087,
        "end": 33089
      },
      "text": "ལ་ ༼སྣར།༽ ལ་ཆུད་པ་རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 33102,
        "end": 33109
      },
      "text": "བརྟན་པ་ ༼སྡེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 33195,
        "end": 33202
      },
      "text": "དགོས་པ་ ༼སྡེ།༽ དགོངས་པ་"
    },
    {
      "span": {
        "start": 33276,
        "end": 33279
      },
      "text": "པུ་ ༼སྣར། པེ།༽ སྤུ་"
    },
    {
      "span": {
        "start": 33627,
        "end": 33639
      },
      "text": "བྱང་ཆུབ་ཀྱི་ ༼སྣར།༽ བྱང་ཆུབ་"
    },
    {
      "span": {
        "start": 33699,
        "end": 33703
      },
      "text": "དུས་ ༼སྣར། པེ།༽ དུས་སུ་"
    },
    {
      "span": {
        "start": 33720,
        "end": 33722
      },
      "text": "ཏ་ ༼སྣར། པེ།༽ དྷ་"
    },
    {
      "span": {
        "start": 33799,
        "end": 33805
      },
      "text": "གསུང་། ༼ཅོ། སྣར།༽ གསུངས།"
    },
    {
      "span": {
        "start": 34560,
        "end": 34567
      },
      "text": "ཆུད་དོ། ༼སྣར།༽ ཆུད་དེ།"
    },
    {
      "span": {
        "start": 34658,
        "end": 34666
      },
      "text": "བརྟན་པར་ ༼སྣར།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 34773,
        "end": 34778
      },
      "text": "སྡུད་ ༼སྣར། པེ།༽ བསྡུད་"
    },
    {
      "span": {
        "start": 34882,
        "end": 34889
      },
      "text": "མིག་གི་ ༼སྣར།༽ མིག་གིས་"
    },
    {
      "span": {
        "start": 34943,
        "end": 34949
      },
      "text": "སྲུངས་ ༼སྣར། པེ།༽ བསྲུངས་"
    },
    {
      "span": {
        "start": 35114,
        "end": 35118
      },
      "text": "མཐུ་ ༼པེ།༽ མཐུན་"
    },
    {
      "span": {
        "start": 35275,
        "end": 35278
      },
      "text": "བྱ། ༼སྣར། པེ།༽ བྱ་བ་དང་།"
    },
    {
      "span": {
        "start": 35336,
        "end": 35341
      },
      "text": "གནོད་ ༼སྣར། པེ།༽ སྣོད་"
    },
    {
      "span": {
        "start": 35381,
        "end": 35388
      },
      "text": "རྣམས་ལ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 35616,
        "end": 35619
      },
      "text": "ཡང་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 35651,
        "end": 35657
      },
      "text": "ཤེས་ན་ ༼སྣར། པེ།༽ ཤེས་ནས་"
    },
    {
      "span": {
        "start": 35702,
        "end": 35708
      },
      "text": "ཤེས་ན་ ༼སྣར། པེ།༽ ཤེས་ནས་"
    },
    {
      "span": {
        "start": 35983,
        "end": 35990
      },
      "text": "བྱིན་ན་ ༼སྣར།༽ བྱིན་ནས་"
    },
    {
      "span": {
        "start": 36605,
        "end": 36613
      },
      "text": "ཞིང་བདམ་ ༼སྣར།༽ ཞིང་དམ་"
    },
    {
      "span": {
        "start": 36626,
        "end": 36634
      },
      "text": "རྟོག་གེ་ ༼པེ།༽ རྟོག་གེ་ལ་"
    },
    {
      "span": {
        "start": 36848,
        "end": 36860
      },
      "text": "མཉམ་ཉིད་ཀྱི། ༼སྣར། པེ།༽ མཉམ་ཉིད་ཀྱིས།"
    },
    {
      "span": {
        "start": 37082,
        "end": 37090
      },
      "text": "ཞིང་བདམ་ ༼སྣར།༽ ཞིང་དམ་"
    },
    {
      "span": {
        "start": 37133,
        "end": 37153
      },
      "text": "བཤད་པ་རྒྱས་པ་ལ་སོགས་ ༼སྣར། པེ།༽ བཤད་པ་བརྒྱ་"
    },
    {
      "span": {
        "start": 37370,
        "end": 37375
      },
      "text": "གཏང་། ༼སྣར། པེ།༽ བཏང་།"
    },
    {
      "span": {
        "start": 37403,
        "end": 37411
      },
      "text": "བཀླགས་པ་ ༼སྣར། པེ།༽ ཀླག་པ་"
    },
    {
      "span": {
        "start": 37556,
        "end": 37561
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 37635,
        "end": 37648
      },
      "text": "ཡང་སྙིང་རྗེས་ ༼སྣར། པེ།༽ ཡང་སྙིང་རྗེ་"
    },
    {
      "span": {
        "start": 37894,
        "end": 37898
      },
      "text": "ལ་མ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 38229,
        "end": 38236
      },
      "text": "ཕོངས་པ་ ༼སྣར། པེ།༽ འཕངས་པ་"
    },
    {
      "span": {
        "start": 38243,
        "end": 38250
      },
      "text": "གཏང་བར་ ༼སྣར། པེ།༽ བཏང་བར་"
    },
    {
      "span": {
        "start": 38427,
        "end": 38439
      },
      "text": "བརྒྱུད་པ་ཡི། ༼སྣར། པེ།༽ བརྒྱུད་པ་ཡིས།"
    },
    {
      "span": {
        "start": 38946,
        "end": 38953
      },
      "text": "རྩོད་པ་ ༼སྣར། པེ།༽ རྩོད་"
    },
    {
      "span": {
        "start": 39578,
        "end": 39588
      },
      "text": "བརྒྱུད་པས་ ༼སྣར། པེ།༽ བརྒྱུད་པའི་"
    },
    {
      "span": {
        "start": 39608,
        "end": 39616
      },
      "text": "ཨེ་མ་ཧོ་ ༼སྣར། པེ།༽ ཨེ་མའོ་"
    },
    {
      "span": {
        "start": 39831,
        "end": 39840
      },
      "text": "ཡིད་ཀྱིས་ ༼པེ།༽ ཡིད་ཀྱི་"
    },
    {
      "span": {
        "start": 39956,
        "end": 39962
      },
      "text": "འབྲོག་ ༼སྣར།༽ འཕྲོག་"
    },
    {
      "span": {
        "start": 39974,
        "end": 39980
      },
      "text": "རྒྱུད་ ༼སྣར། པེ།༽ བརྒྱུད་"
    },
    {
      "span": {
        "start": 40106,
        "end": 40115
      },
      "text": "རྣམས་ཉམས་ ༼ཅོ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 40161,
        "end": 40168
      },
      "text": "ནམ་མཁའ་ ༼སྣར། པེ།༽ ནམ་མཁའི་"
    },
    {
      "span": {
        "start": 40190,
        "end": 40196
      },
      "text": "བསྒོམ་ ༼སྣར། པེ།༽ བསྒོམས་"
    },
    {
      "span": {
        "start": 40242,
        "end": 40244
      },
      "text": "ན་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 40275,
        "end": 40286
      },
      "text": "ཉོན་མོངས་པ་ ༼སྣར། པེ།༽ ཉོན་མོངས་"
    },
    {
      "span": {
        "start": 40599,
        "end": 40606
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 40819,
        "end": 40829
      },
      "text": "བསྒོམས་པས་ ༼སྣར། པེ།༽ སྒོམ་པས་"
    },
    {
      "span": {
        "start": 40966,
        "end": 40976
      },
      "text": "འབྱེད་པའི་ ༼སྣར། པེ།༽ བྱེད་པའི་"
    },
    {
      "span": {
        "start": 41276,
        "end": 41283
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 41543,
        "end": 41551
      },
      "text": "ཇི་སྲིད་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 41559,
        "end": 41571
      },
      "text": "བར་དུ་ནང་དུ་ ༼སྣར། པེ།༽ བར་དུ་"
    },
    {
      "span": {
        "start": 41781,
        "end": 41791
      },
      "text": "བརྒྱད་ཀྱི་ ༼སྣར། པེ།༽ བརྒྱད་ཀྱིས་"
    },
    {
      "span": {
        "start": 41960,
        "end": 41968
      },
      "text": "ཆོས་ཀྱི་ ༼སྣར། པེ།༽ ཆོས་"
    },
    {
      "span": {
        "start": 43673,
        "end": 43676
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 43772,
        "end": 43779
      },
      "text": "གནས་ནས་ ༼སྣར། པེ།༽ གནས་"
    },
    {
      "span": {
        "start": 44028,
        "end": 44031
      },
      "text": "ངང་ ༼སྣར། པེ།༽ ངང་ཉིད་"
    },
    {
      "span": {
        "start": 45010,
        "end": 45018
      },
      "text": "ལྷགས་པས་ ༼སྣར། པེ།༽ ལྷག་པས་"
    },
    {
      "span": {
        "start": 46015,
        "end": 46020
      },
      "text": "སྤངས་ ༼སྣར།༽ སངས་"
    },
    {
      "span": {
        "start": 47105,
        "end": 47112
      },
      "text": "བསྐྱོད་ ༼སྣར། པེ།༽ སྐྱོད་"
    },
    {
      "span": {
        "start": 47133,
        "end": 47144
      },
      "text": "ཐམས་ཅད་ཀྱི། ༼སྣར།༽ ཐམས་ཅད་ཀྱིས།"
    },
    {
      "span": {
        "start": 47175,
        "end": 47179
      },
      "text": "ཡང་། ༼སྣར།༽ དེ་"
    },
    {
      "span": {
        "start": 47226,
        "end": 47229
      },
      "text": "མི་ ༼པེ།༽ མི་མི་"
    },
    {
      "span": {
        "start": 47280,
        "end": 47285
      },
      "text": "གཏོང་ ༼སྣར། པེ།༽ སྟོངས་"
    },
    {
      "span": {
        "start": 47603,
        "end": 47606
      },
      "text": "དེ་ ༼སྣར།༽ དེའི་"
    },
    {
      "span": {
        "start": 48499,
        "end": 48503
      },
      "text": "ཁྱབ་ ༼སྣར། པེ།༽ ཁྱད་"
    },
    {
      "span": {
        "start": 48568,
        "end": 48571
      },
      "text": "ཡེ་ ༼སྣར། པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 48891,
        "end": 48901
      },
      "text": "བཟློག་པའི་ ༼སྣར། པེ།༽ ཟློག་པའི་"
    },
    {
      "span": {
        "start": 48963,
        "end": 48972
      },
      "text": "གསུངས་ཏེ། ༼སྣར། པེ།༽ གསུང་སྟེ།"
    },
    {
      "span": {
        "start": 49039,
        "end": 49045
      },
      "text": "འཕྲིག་ ༼སྣར། པེ།༽ འཁྲིག་"
    },
    {
      "span": {
        "start": 49303,
        "end": 49322
      },
      "text": "ཀྱང་གོ་བར་མི་འགྱུར་ ༼སྣར། པེ།༽ གོ་བར་མ་གྱུར་"
    },
    {
      "span": {
        "start": 49570,
        "end": 49579
      },
      "text": "བསམ་གྱིས་ ༼སྣར། པེ།༽ བསམ་གྱི་"
    },
    {
      "span": {
        "start": 49826,
        "end": 49836
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 50033,
        "end": 50043
      },
      "text": "ལ་སོགས་པས་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 50104,
        "end": 50110
      },
      "text": "སྲུངས་ ༼སྣར། པེ།༽ བསྲུངས་"
    },
    {
      "span": {
        "start": 50361,
        "end": 50365
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 50785,
        "end": 50787
      },
      "text": "པ་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 50919,
        "end": 50924
      },
      "text": "མ་ཏི་ ༼སྣར། པེ།༽ མཱ་ཏྲི་"
    },
    {
      "span": {
        "start": 50994,
        "end": 51000
      },
      "text": "ལྔ་པོ་ ༼སྣར། པེ།༽ ལྔ་པོས་"
    },
    {
      "span": {
        "start": 51277,
        "end": 51287
      },
      "text": "ལ་སོགས་པས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 51315,
        "end": 51328
      },
      "text": "བྱ་བའི་རྒྱུད་ ༼པེ།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 51545,
        "end": 51550
      },
      "text": "ཡི་པ་ ༼སྣར། པེ།༽ ཨི་པ་"
    },
    {
      "span": {
        "start": 51620,
        "end": 51623
      },
      "text": "བི་ ༼སྣར། པེ།༽ བྷི་"
    },
    {
      "span": {
        "start": 52051,
        "end": 52057
      },
      "text": "སྤྲིང་ ༼སྣར། པེ།༽ སྦྲིངས་"
    },
    {
      "span": {
        "start": 52116,
        "end": 52136
      },
      "text": "བསོད་ནམས་ཆུང་བ་རྣམས་ ༼སྣར།༽ བསོད་ནམས་"
    },
    {
      "span": {
        "start": 52216,
        "end": 52220
      },
      "text": "དང་། ༼སྣར། པེ།༽ མཛད་དོ། །"
    },
    {
      "span": {
        "start": 52351,
        "end": 52358
      },
      "text": "ཆེད་དུ་ ༼སྣར། པེ།༽ ཆེད་ཕྱེད་"
    },
    {
      "span": {
        "start": 52363,
        "end": 52374
      },
      "text": "བསྐྱེད་པའི་ ༼སྣར། པེ།༽ སྐྱེད་པའི་"
    },
    {
      "span": {
        "start": 52522,
        "end": 52530
      },
      "text": "བཟློག་པ་ ༼སྣར། པེ།༽ ཟློག་པ་"
    },
    {
      "span": {
        "start": 52579,
        "end": 52586
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 52824,
        "end": 52833
      },
      "text": "བསམ་གྱིས་ ༼སྣར། པེ།༽ བསམ་གྱི་"
    },
    {
      "span": {
        "start": 52935,
        "end": 52943
      },
      "text": "འགྲེལ་པ་ ༼སྣར། པེ།༽ འབྲེལ་པ་"
    },
    {
      "span": {
        "start": 53433,
        "end": 53439
      },
      "text": "སྦྱིན་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 53732,
        "end": 53737
      },
      "text": "རྟོན་ ༼སྣར། པེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 53959,
        "end": 53969
      },
      "text": "སྒྱུར་བའི་ ༼སྣར། པེ།༽ བསྒྱུར་བའི་"
    },
    {
      "span": {
        "start": 54213,
        "end": 54221
      },
      "text": "ཟབ་མོ་ལ་ ༼སྣར། པེ།༽ ཟབ་མོ་"
    },
    {
      "span": {
        "start": 54542,
        "end": 54548
      },
      "text": "ཙམ་དང་ ༼སྣར། པེ།༽ ཙམ་"
    },
    {
      "span": {
        "start": 54570,
        "end": 54576
      },
      "text": "བསྐྲད་ ༼སྣར། པེ།༽ སྐྲད་"
    },
    {
      "span": {
        "start": 54790,
        "end": 54794
      },
      "text": "མཁར་ ༼སྣར། པེ།༽ ལི་ཁར་"
    },
    {
      "span": {
        "start": 55121,
        "end": 55128
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ སྟན་པ་"
    },
    {
      "span": {
        "start": 55515,
        "end": 55519
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདི་དེ་"
    },
    {
      "span": {
        "start": 55620,
        "end": 55628
      },
      "text": "བྱུང་ནས་ ༼སྣར། པེ།༽ བྱུང་ན་"
    },
    {
      "span": {
        "start": 55672,
        "end": 55676
      },
      "text": "བཏང་ ༼སྣར། པེ།༽ གཏང་"
    },
    {
      "span": {
        "start": 55683,
        "end": 55689
      },
      "text": "བསྲུང་ ༼སྡེ།༽ གསུང་"
    },
    {
      "span": {
        "start": 55726,
        "end": 55731
      },
      "text": "གཞུང་ ༼སྣར། པེ།༽ གཞུངས་"
    },
    {
      "span": {
        "start": 56015,
        "end": 56024
      },
      "text": "བདུད་ཀྱི་ ༼སྣར། པེ།༽ བདུད་ཀྱིས་"
    },
    {
      "span": {
        "start": 56481,
        "end": 56491
      },
      "text": "འཛིན་པ་དེ་ ༼སྣར། པེ།༽ འཛིན་པ་"
    },
    {
      "span": {
        "start": 56919,
        "end": 56927
      },
      "text": "འཇམ་དཔལ་ ༼སྣར།༽ འཇམ་དཔལ་ཡས་"
    },
    {
      "span": {
        "start": 57000,
        "end": 57007
      },
      "text": "རིགས། ། ༼སྣར། པེ།༽ རིག །"
    },
    {
      "span": {
        "start": 57075,
        "end": 57084
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་མང་དུ་"
    },
    {
      "span": {
        "start": 57392,
        "end": 57400
      },
      "text": "མདོར་ཡང་ ༼སྣར།༽ མདོར་"
    },
    {
      "span": {
        "start": 57526,
        "end": 57533
      },
      "text": "བརྩད་པ་ ༼སྣར།༽ བརྩོད་པ་"
    },
    {
      "span": {
        "start": 57645,
        "end": 57653
      },
      "text": "ནས་ཀྱིས་ ༼སྣར། པེ།༽ ནས་ཀྱི་"
    },
    {
      "span": {
        "start": 57657,
        "end": 57661
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱིས་"
    },
    {
      "span": {
        "start": 57682,
        "end": 57691
      },
      "text": "སོ་སོ་རང་ ༼སྣར། པེ།༽ སོ་སོར་"
    },
    {
      "span": {
        "start": 57750,
        "end": 57756
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 57972,
        "end": 57979
      },
      "text": "བལྟ་བས་ ༼སྣར། པེ།༽ ལྟ་བས་"
    },
    {
      "span": {
        "start": 58262,
        "end": 58273
      },
      "text": "བརྒྱུད་པའི་ ༼སྣར། པེ།༽ རྒྱུད་པའི་"
    },
    {
      "span": {
        "start": 58678,
        "end": 58691
      },
      "text": "ཞལ་ནས་བླ་མའི་ ༼སྣར། པེ།༽ ཞལ་ནས་"
    },
    {
      "span": {
        "start": 59413,
        "end": 59419
      },
      "text": "བསླངས་ ༼སྣར། པེ།༽ བླངས་"
    },
    {
      "span": {
        "start": 59492,
        "end": 59499
      },
      "text": "བཏབ་པས་ ༼སྣར། པེ།༽ བཏབ་པ་"
    },
    {
      "span": {
        "start": 59613,
        "end": 59627
      },
      "text": "བསྐོར་བས་དབུས་ ༼སྣར།༽ བསྐོར་བས་"
    },
    {
      "span": {
        "start": 60038,
        "end": 60043
      },
      "text": "བཏགས་ ༼སྣར། པེ།༽ བརྟགས་"
    },
    {
      "span": {
        "start": 60253,
        "end": 60258
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ བཞིན་དུ་"
    },
    {
      "span": {
        "start": 60348,
        "end": 60356
      },
      "text": "བྱང་ཆུབ་ ༼སྣར། པེ།༽ བྱང་ཆུབ་ཏུ་"
    },
    {
      "span": {
        "start": 61264,
        "end": 61277
      },
      "text": "སྡོམ་པ་ཉི་ཤུ་ ༼སྣར། པེ།༽ སྡོམ་པ་"
    },
    {
      "span": {
        "start": 61291,
        "end": 61301
      },
      "text": "བསྲུང་སྟེ་ ༼སྣར། པེ།༽ བསྲུངས་ཏེ་"
    },
    {
      "span": {
        "start": 61531,
        "end": 61538
      },
      "text": "ཚིག་གམ། ༼སྣར། པེ།༽ ཚིགས་སམ།"
    },
    {
      "span": {
        "start": 62528,
        "end": 62533
      },
      "text": "སྦྱང་ ༼སྣར། པེ།༽ སྤྱད་"
    },
    {
      "span": {
        "start": 62606,
        "end": 62615
      },
      "text": "སྙིང་རྗེ་ ༼སྣར། པེ།༽ སྙིང་རྗེས་"
    },
    {
      "span": {
        "start": 63251,
        "end": 63254
      },
      "text": "ཕབ། ༼སྣར། པེ།༽ ཕབ་པའོ།"
    }
  ]
}