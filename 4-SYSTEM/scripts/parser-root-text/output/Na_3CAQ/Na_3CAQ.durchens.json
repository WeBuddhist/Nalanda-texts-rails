{
  "durchens": [
    {
      "span": {
        "start": 49,
        "end": 55
      },
      "text": "ཀུལླེ་ ༼སྣར། པེ།༽ ཀུ་རུ་ལླེ་"
    },
    {
      "span": {
        "start": 97,
        "end": 106
      },
      "text": "བྱུང་བའི་ ༼སྣར། པེ།༽ འབྱུང་བའི་"
    },
    {
      "span": {
        "start": 119,
        "end": 129
      },
      "text": "རིགས་བྱེད་ ༼སྣར། པེ།༽ རིག་བྱེད་"
    },
    {
      "span": {
        "start": 150,
        "end": 155
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིག་"
    },
    {
      "span": {
        "start": 242,
        "end": 247
      },
      "text": "གཞུག་ ༼སྣར། པེ།༽ ཞུགས་"
    },
    {
      "span": {
        "start": 290,
        "end": 296
      },
      "text": "དང་པོ་ ༼སྣར། པེ།༽ དང་པོར་"
    },
    {
      "span": {
        "start": 318,
        "end": 323
      },
      "text": "མཐུན་ ༼སྣར། པེ།༽ འཐུན་"
    },
    {
      "span": {
        "start": 334,
        "end": 346
      },
      "text": "བུད་མེད་ཀྱི་ ༼སྣར། པེ།༽ བུད་མེད་ཀྱིས་"
    },
    {
      "span": {
        "start": 494,
        "end": 501
      },
      "text": "ཡིག་གི་ ༼སྣར། པེ།༽ ཡིག་གིས་"
    },
    {
      "span": {
        "start": 700,
        "end": 705
      },
      "text": "བསམས་ ༼སྣར།༽ བསམ་"
    },
    {
      "span": {
        "start": 790,
        "end": 803
      },
      "text": "མཆོད་པས་མཆོད་ ༼སྣར།༽ མཆོད་"
    },
    {
      "span": {
        "start": 1061,
        "end": 1064
      },
      "text": "ཡི་ ༼སྣར།༽ ཡིད་"
    },
    {
      "span": {
        "start": 1157,
        "end": 1213
      },
      "text": "བསྒོམ་པ་སྔོན་དུ་འགྲོ་བས། ཆོས་ཐམས་ཅད་སྟོང་པ་ཉིད་དུ་བསྒོམ་ ༼སྣར།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 1239,
        "end": 1246
      },
      "text": "བརླབ་པ་ ༼སྣར། པེ།༽ བརླབས་པ་"
    },
    {
      "span": {
        "start": 1255,
        "end": 1260
      },
      "text": "བྱའོ། ༼སྣར།༽ བྱ་སྟེ།"
    },
    {
      "span": {
        "start": 1286,
        "end": 1289
      },
      "text": "སྭ་ ༼སྣར།༽ སྭཱ་"
    },
    {
      "span": {
        "start": 1494,
        "end": 1504
      },
      "text": "ས་བོན་གྱི་ ༼སྣར།༽ ས་བོན་གྱིས་"
    },
    {
      "span": {
        "start": 1512,
        "end": 1522
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 1625,
        "end": 1630
      },
      "text": "མདུན་ ༼སྣར།༽ ནང་"
    },
    {
      "span": {
        "start": 1764,
        "end": 1771
      },
      "text": "བྱས་པས་ ༼སྣར། པེ།༽ བྱས་པ་"
    },
    {
      "span": {
        "start": 1818,
        "end": 1823
      },
      "text": "རྒྱན་ ༼སྣར།༽ བརྒྱན་"
    },
    {
      "span": {
        "start": 1924,
        "end": 1930
      },
      "text": "བསྣམས་ ༼སྣར།༽ བསམས་"
    },
    {
      "span": {
        "start": 1999,
        "end": 2004
      },
      "text": "རྒྱན་ ༼སྣར། པེ།༽ བརྒྱན་"
    },
    {
      "span": {
        "start": 2042,
        "end": 2054
      },
      "text": "སྒྲ་གཅན་ཟིན་ ༼སྣར།༽ སྒྲ་གཅན་"
    },
    {
      "span": {
        "start": 2165,
        "end": 2175
      },
      "text": "རིགས་བྱེད་ ༼སྣར། པེ།༽ རིག་བྱེད་"
    },
    {
      "span": {
        "start": 2193,
        "end": 2202
      },
      "text": "དེ་ལྟར་ན་ ༼སྣར།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 2214,
        "end": 2218
      },
      "text": "དཔའ་ ༼སྣར།༽ གསལ་"
    },
    {
      "span": {
        "start": 2313,
        "end": 2326
      },
      "text": "ཞལ་གྱི་ནང་ནས་ ༼སྣར།༽ ཞལ་གྱིས་"
    },
    {
      "span": {
        "start": 2332,
        "end": 2337
      },
      "text": "གཞུག་ ༼སྣར།༽ ཞུགས་"
    },
    {
      "span": {
        "start": 2337,
        "end": 2340
      },
      "text": "པར་ ༼སྣར།༽ པར་སྒོམ་པར་ ༼པེ།༽ པར་བསྒོམ་པར་"
    },
    {
      "span": {
        "start": 2408,
        "end": 2412
      },
      "text": "གུང་ ༼སྣར།༽ གང་"
    },
    {
      "span": {
        "start": 2480,
        "end": 2485
      },
      "text": "མཛུབ་ ༼སྣར།༽ འཛུབ་"
    },
    {
      "span": {
        "start": 2519,
        "end": 2527
      },
      "text": "ཏུ་གཞུག་ ༼སྣར།༽ ཏུ་རབ་ཏུ་ཞུགས་ ༼པེ།༽ ཏུ་རབ་ཞུགས་"
    },
    {
      "span": {
        "start": 2591,
        "end": 2600
      },
      "text": "རྡོ་རྗེས་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 2698,
        "end": 2703
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 2789,
        "end": 2797
      },
      "text": "ཀུན་གྱི་ ༼སྣར།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 2854,
        "end": 2863
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 2876,
        "end": 2880
      },
      "text": "བཀས་ ༼སྣར།༽ བཀའ་"
    },
    {
      "span": {
        "start": 2918,
        "end": 2923
      },
      "text": "སྟེར་ ༼སྣར།༽ བསྟེར་"
    },
    {
      "span": {
        "start": 2993,
        "end": 3000
      },
      "text": "བཟླས་པ་ ༼སྣར།༽ བསླབས་པར་"
    },
    {
      "span": {
        "start": 3019,
        "end": 3035
      },
      "text": "མིན་བུལ་བའང་མིན། ༼སྣར།༽ མིན།"
    },
    {
      "span": {
        "start": 3040,
        "end": 3070
      },
      "text": "གསལ་མ་ཡིན་ཆ་མཉམ་མིན། །ཡང་དག་མ་ ༼སྣར།༽ གསལ་མ་"
    },
    {
      "span": {
        "start": 3097,
        "end": 3103
      },
      "text": "ཀུལླེ་ ༼སྣར།༽ ཀུ་ལུ་"
    },
    {
      "span": {
        "start": 3127,
        "end": 3131
      },
      "text": "ཐུན་ ༼སྣར།༽ མཐུན་"
    },
    {
      "span": {
        "start": 3145,
        "end": 3152
      },
      "text": "རིམ་པས་ ༼སྣར།༽ རིམས་པས་"
    },
    {
      "span": {
        "start": 3152,
        "end": 3158
      },
      "text": "ཁུར་བ་ ༼སྣར།༽ འཁུར་བ་"
    },
    {
      "span": {
        "start": 3161,
        "end": 3165
      },
      "text": "ཀ་ར་ ༼སྣར།༽ ཀ་ར་བ་"
    },
    {
      "span": {
        "start": 3198,
        "end": 3206
      },
      "text": "འགྲོ་བས་ ༼སྣར།༽ འཕྲོ་བས་"
    },
    {
      "span": {
        "start": 3256,
        "end": 3265
      },
      "text": "བསྒོམ་པར་ ༼སྣར།༽ སྒོམ་པར་"
    },
    {
      "span": {
        "start": 3332,
        "end": 3338
      },
      "text": "དང་པོ་ ༼སྣར།༽ དང་བ་"
    },
    {
      "span": {
        "start": 3404,
        "end": 3415
      },
      "text": "སྟོན་མོ་གྱ་ ༼སྣར།༽ སྟོན་མོ་གྱི་"
    },
    {
      "span": {
        "start": 3432,
        "end": 3440
      },
      "text": "རྙེད་པར་ ༼སྣར།༽ སྙེད་པར་"
    },
    {
      "span": {
        "start": 3440,
        "end": 3449
      },
      "text": "འགྱུར་རོ། ༼སྣར།༽ འགྲུབ་བོ།"
    },
    {
      "span": {
        "start": 3619,
        "end": 3637
      },
      "text": "བུད་མེད་རྣམས་ཀྱིས་ ༼སྣར།༽ བུད་མེད་བྱི་"
    },
    {
      "span": {
        "start": 3983,
        "end": 3990
      },
      "text": "བྱུག་པ་ ༼སྣར།༽ ཕྱུག་པ་"
    },
    {
      "span": {
        "start": 4146,
        "end": 4153
      },
      "text": "མ་གྱུར་ ༼སྣར།༽ མི་འགྱུར་"
    },
    {
      "span": {
        "start": 4281,
        "end": 4289
      },
      "text": "རིལ་པོར་ ༼སྣར།༽ རིལ་པོ་"
    },
    {
      "span": {
        "start": 4318,
        "end": 4322
      },
      "text": "འབར་ ༼སྣར།༽ འདས་"
    },
    {
      "span": {
        "start": 4411,
        "end": 4416
      },
      "text": "སྲེད་ ༼སྣར།༽ སྲིད་"
    },
    {
      "span": {
        "start": 4556,
        "end": 4571
      },
      "text": "རྒས་པ་དང་། འཆི་ ༼སྣར།༽ འཆི་"
    },
    {
      "span": {
        "start": 4607,
        "end": 4616
      },
      "text": "ཁམས་རྣམས་ ༼སྣར།༽ ཁམས་"
    },
    {
      "span": {
        "start": 4740,
        "end": 4743
      },
      "text": "ཀུ་ ༼སྣར།༽ སྐུ་"
    }
  ]
}