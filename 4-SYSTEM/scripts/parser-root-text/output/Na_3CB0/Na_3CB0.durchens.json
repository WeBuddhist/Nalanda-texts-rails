{
  "durchens": [
    {
      "span": {
        "start": 364,
        "end": 375
      },
      "text": "གཟུགས་འཛིན་ ༼སྣར། པེ།༽ གཟུང་འཛིན་"
    },
    {
      "span": {
        "start": 720,
        "end": 725
      },
      "text": "བྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 751,
        "end": 758
      },
      "text": "ཆུ་ལྦུ་ ༼སྣར།༽ ཆུ་བུར་ ༼པེ།༽ ཆུ་སྦུར་"
    },
    {
      "span": {
        "start": 871,
        "end": 875
      },
      "text": "གཤམ་ ༼སྣར། པེ།༽ བཤམ་"
    },
    {
      "span": {
        "start": 1041,
        "end": 1045
      },
      "text": "གསལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 1287,
        "end": 1291
      },
      "text": "མེད་ ༼སྣར། པེ།༽ སེམས་"
    },
    {
      "span": {
        "start": 1373,
        "end": 1381
      },
      "text": "བརྟགས་པ་ ༼སྣར། པེ།༽ བཏགས་པ་"
    },
    {
      "span": {
        "start": 1387,
        "end": 1394
      },
      "text": "ཆུ་ལྦུ་ ༼སྣར། པེ།༽ ཆུ་སྦུར་"
    },
    {
      "span": {
        "start": 1463,
        "end": 1467
      },
      "text": "སླུ་ ༼སྣར། པེ།༽ བསླུ་"
    },
    {
      "span": {
        "start": 1557,
        "end": 1562
      },
      "text": "འཇིག་ ༼སྣར། པེ།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 1656,
        "end": 1660
      },
      "text": "སླུ་ ༼སྣར། པེ།༽ བསླུ་"
    },
    {
      "span": {
        "start": 1709,
        "end": 1717
      },
      "text": "སྙེགས། ། ༼སྣར།༽ རྙེད། ། ༼པེ།༽ རྙེག །"
    },
    {
      "span": {
        "start": 1750,
        "end": 1754
      },
      "text": "གཟོ། ༼སྣར། པེ།༽ བཟོ།"
    },
    {
      "span": {
        "start": 1779,
        "end": 1784
      },
      "text": "སྲིད་ ༼སྣར། པེ།༽ སྲེད་"
    },
    {
      "span": {
        "start": 1947,
        "end": 1951
      },
      "text": "སླུ་ ༼སྣར། པེ།༽ བསླུ་"
    },
    {
      "span": {
        "start": 2005,
        "end": 2011
      },
      "text": "གསུངས། ༼སྣར།༽ གསུང་།"
    },
    {
      "span": {
        "start": 2046,
        "end": 2052
      },
      "text": "འགྲོས། ༼པེ།༽ གྲོས།"
    },
    {
      "span": {
        "start": 2258,
        "end": 2264
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 2389,
        "end": 2391
      },
      "text": "ཀ་ ༼སྣར། པེ།༽ ག་"
    }
  ]
}