{
  "durchens": [
    {
      "span": {
        "start": 24,
        "end": 36
      },
      "text": "ཐེག་པའི་ཚ་ཚ་ ༼སྣར། པེ།༽ ཐེག་པའི་སཱཙྪ་"
    },
    {
      "span": {
        "start": 96,
        "end": 101
      },
      "text": "ལོ། ། ༼སྣར། པེ།༽ ། །ཨོཾ་"
    },
    {
      "span": {
        "start": 125,
        "end": 127
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནཱ་ཡ་"
    },
    {
      "span": {
        "start": 211,
        "end": 218
      },
      "text": "ས་མ་ཏེ་ ༼སྣར། པེ།༽ ཤཱནྟེ་དཱནྟེ། ཨ་"
    },
    {
      "span": {
        "start": 253,
        "end": 256
      },
      "text": "ཤོ། ༼སྣར། པེ།༽ ཤོ། ཝ་ཏི་"
    },
    {
      "span": {
        "start": 265,
        "end": 268
      },
      "text": "ཛེ། ༼སྣར། པེ།༽ ཛ།"
    },
    {
      "span": {
        "start": 280,
        "end": 284
      },
      "text": "ནིར་ ༼སྣར། པེ།༽ ནི་རི་"
    },
    {
      "span": {
        "start": 349,
        "end": 353
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིས་"
    },
    {
      "span": {
        "start": 891,
        "end": 896
      },
      "text": "བརླབ་ ༼སྣར།༽ བརླབས་"
    },
    {
      "span": {
        "start": 1024,
        "end": 1031
      },
      "text": "འཚལ་བར་ ༼སྣར། པེ།༽ བཙལ་བར་"
    },
    {
      "span": {
        "start": 1086,
        "end": 1091
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 1147,
        "end": 1152
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 1482,
        "end": 1491
      },
      "text": "རྫོགས། །། ༼སྣར། པེ།༽ རྫོགསརྫོགས་སོ། །།ཨོཾ་"
    },
    {
      "span": {
        "start": 1538,
        "end": 1543
      },
      "text": "ཧྱ་བ་ ༼སྣར། པེ།༽ ཧྱ་"
    }
  ]
}