{
  "durchens": [
    {
      "span": {
        "start": 30,
        "end": 34
      },
      "text": "སྠཱ། ༼པེ། སྣར།༽ སྠ།"
    },
    {
      "span": {
        "start": 39,
        "end": 42
      },
      "text": "སྟོ། ༼པེ། སྣར།༽ ཏ།"
    },
    {
      "span": {
        "start": 403,
        "end": 409
      },
      "text": "གཡས་ལ། ༼པེ། སྣར།༽ གཡས་པ།"
    },
    {
      "span": {
        "start": 409,
        "end": 415
      },
      "text": "ཚངས་པ། ༼པེ། སྣར།༽ ཚངས་པས།"
    },
    {
      "span": {
        "start": 464,
        "end": 476
      },
      "text": "བཱ་རཱ་ཎ་སཱི། ༼པེ། སྣར།༽ ཝ་ར་ཎཱ་སི།"
    },
    {
      "span": {
        "start": 552,
        "end": 556
      },
      "text": "སོར། ༼པེ། སྣར།༽ སེར།"
    },
    {
      "span": {
        "start": 992,
        "end": 1001
      },
      "text": "འབུལ་བའི། ༼པེ། སྣར།༽ ཕུལ་ཞིང་།"
    },
    {
      "span": {
        "start": 1020,
        "end": 1024
      },
      "text": "བཀའ་དང་། ༼པེ། སྣར།༽ དཀར།"
    },
    {
      "span": {
        "start": 1465,
        "end": 1470
      },
      "text": "ཀྱིས། ༼པེ། སྣར།༽ ཞལ་སྔ་ནས།"
    }
  ]
}