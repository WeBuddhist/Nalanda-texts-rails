{
  "durchens": [
    {
      "span": {
        "start": 468,
        "end": 478
      },
      "text": "དཔག་པར་བྱ་ ༼སྣར། པེ།༽ དཔག་པར་"
    },
    {
      "span": {
        "start": 515,
        "end": 529
      },
      "text": "ཁྱད་པར་མེད་པར་ ༼སྣར། པེ།༽ ཁྱད་པར་"
    },
    {
      "span": {
        "start": 587,
        "end": 594
      },
      "text": "ཡོད་པར་ ༼སྣར། པེ།༽ ཡོད་པར་ནི་"
    },
    {
      "span": {
        "start": 657,
        "end": 661
      },
      "text": "གྱི་ ༼སྣར། པེ།༽ གྱི་བློ་"
    },
    {
      "span": {
        "start": 750,
        "end": 760
      },
      "text": "འགྲོ་བ་ཅན་ ༼སྣར། པེ།༽ འགྲོ་བ་"
    },
    {
      "span": {
        "start": 1357,
        "end": 1364
      },
      "text": "སྣང་བས་ ༼སྣར། པེ།༽ སྣང་བ་"
    },
    {
      "span": {
        "start": 1531,
        "end": 1537
      },
      "text": "ཡིན་ན་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 1638,
        "end": 1645
      },
      "text": "དག་པའི་ ༼སྣར། པེ།༽ དག་གི་"
    },
    {
      "span": {
        "start": 1698,
        "end": 1704
      },
      "text": "དེས་ན་ ༼སྣར།༽ དེ་བས་ན་"
    },
    {
      "span": {
        "start": 1838,
        "end": 1841
      },
      "text": "ཅན་ ༼སྣར། པེ།༽ ཅན་ཁོ་ན་"
    },
    {
      "span": {
        "start": 1959,
        "end": 1966
      },
      "text": "འཕངས་པ་ ༼སྣར། པེ།༽ འཕང་བ་"
    },
    {
      "span": {
        "start": 1971,
        "end": 1978
      },
      "text": "སྒྱོགས་ ༼སྣར། པེ།༽ རྒྱོགས་"
    },
    {
      "span": {
        "start": 2071,
        "end": 2075
      },
      "text": "སྣང་ ༼སྣར། པེ།༽ སྣང་བ་"
    },
    {
      "span": {
        "start": 2429,
        "end": 2450
      },
      "text": "སྤྱི་ནི་གཡོ་བའི་སྤྱི་ ༼སྣར། པེ།༽ སྤྱི་"
    },
    {
      "span": {
        "start": 2480,
        "end": 2487
      },
      "text": "ཇི་ལྟར་ ༼སྣར། པེ།༽ ཇི་ལྟ་"
    },
    {
      "span": {
        "start": 2661,
        "end": 2664
      },
      "text": "མི་ ༼སྣར། པེ།༽ མི་འདི་"
    },
    {
      "span": {
        "start": 2836,
        "end": 2850
      },
      "text": "འདྲ་བར་སྨྲ་བར་ ༼སྣར།༽ འདྲ་བར་་བར་སྣང་ ༼པེ།༽ བར་"
    },
    {
      "span": {
        "start": 2859,
        "end": 2869
      },
      "text": "འདི་དག་ནི་ ༼སྣར། པེ།༽ འདི་དག་"
    },
    {
      "span": {
        "start": 2964,
        "end": 2967
      },
      "text": "ཡང་ ༼སྣར། པེ།༽ ཡང་ཡིན་པར་"
    },
    {
      "span": {
        "start": 3214,
        "end": 3223
      },
      "text": "དོན་གྱིས་ ༼སྣར། པེ།༽ དོན་གྱི་"
    },
    {
      "span": {
        "start": 3304,
        "end": 3312
      },
      "text": "དབང་གིས་ ༼སྣར། པེ།༽ དབང་གི་"
    },
    {
      "span": {
        "start": 3609,
        "end": 3614
      },
      "text": "ཟློག་ ༼སྣར།༽ བཟློག་ ༼པེ།༽ བསློག་"
    },
    {
      "span": {
        "start": 3784,
        "end": 3793
      },
      "text": "མངོན་སུམ་ ༼སྣར། པེ།༽ མངོན་སུམ་དུ་"
    },
    {
      "span": {
        "start": 3856,
        "end": 3865
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 4056,
        "end": 4064
      },
      "text": "འབྲས་བུ་ ༼སྣར། པེ།༽ འབྲས་བུ་གཉིད་"
    },
    {
      "span": {
        "start": 4300,
        "end": 4308
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 4451,
        "end": 4462
      },
      "text": "ཆོས་ཅན་གྱི་ ༼པེ།༽ ཆོས་ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 4563,
        "end": 4571
      },
      "text": "ཙམ་གྱིས་ ༼སྣར། པེ།༽ ཙམ་གྱི་"
    },
    {
      "span": {
        "start": 4622,
        "end": 4632
      },
      "text": "འབྲས་བུའི་ ༼སྣར། པེ།༽ འབྲས་བུ་"
    },
    {
      "span": {
        "start": 4740,
        "end": 4751
      },
      "text": "ཁྱད་པར་འདི་ ༼སྣར། པེ།༽ ཁྱད་པར་"
    },
    {
      "span": {
        "start": 4860,
        "end": 4866
      },
      "text": "གཞན་ན་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 4939,
        "end": 4948
      },
      "text": "ཁྱད་པར་ལ་ ༼སྣར། པེ།༽ ཁྱད་པར་"
    },
    {
      "span": {
        "start": 5546,
        "end": 5553
      },
      "text": "མེད་དོ། ༼སྣར།༽ མེད་དེ།"
    },
    {
      "span": {
        "start": 5594,
        "end": 5600
      },
      "text": "ཉེས་པ་ ༼པེ།༽ ཉེ་བར་"
    },
    {
      "span": {
        "start": 5722,
        "end": 5731
      },
      "text": "འདི་ག་ལས་ ༼སྣར། པེ།༽ འདི་ག་ལ་"
    },
    {
      "span": {
        "start": 5821,
        "end": 5824
      },
      "text": "པས་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 5831,
        "end": 5843
      },
      "text": "པའི་ཕྱིར་དེ་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 5908,
        "end": 5913
      },
      "text": "གླགས་ ༼སྣར། པེ།༽ ཀླགས་"
    },
    {
      "span": {
        "start": 5933,
        "end": 5936
      },
      "text": "ཅན་ ༼སྣར། པེ།༽ ཅན་འདི་"
    },
    {
      "span": {
        "start": 5941,
        "end": 5951
      },
      "text": "ཆེན་པོ་ཅན་ ༼སྣར། པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 5973,
        "end": 5980
      },
      "text": "ངེས་པར་ ༼སྣར། པེ།༽ ངེས་པ་"
    },
    {
      "span": {
        "start": 6050,
        "end": 6056
      },
      "text": "ལས་རང་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 6703,
        "end": 6709
      },
      "text": "རྒྱུད་ ༼སྣར། པེ།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 6840,
        "end": 6852
      },
      "text": "རིག་བྱེད་དག་ ༼སྣར། པེ།༽ རིག་བྱེད་"
    },
    {
      "span": {
        "start": 6929,
        "end": 6933
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 7054,
        "end": 7059
      },
      "text": "གཅིག་ ༼སྣར། པེ།༽ གཅིག་ཏུ་"
    },
    {
      "span": {
        "start": 7276,
        "end": 7282
      },
      "text": "དེ་དག་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 7451,
        "end": 7461
      },
      "text": "ཤེས་པར་དེ་ ༼སྣར། པེ།༽ ཤེས་པར་"
    },
    {
      "span": {
        "start": 7558,
        "end": 7566
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 7703,
        "end": 7713
      },
      "text": "ངོ་བོ་ཉིད་ ༼སྣར། པེ།༽ ངོ་བོ་"
    },
    {
      "span": {
        "start": 7916,
        "end": 7923
      },
      "text": "དག་ཅིག་ ༼སྣར། པེ།༽ དག་གཅིག་"
    },
    {
      "span": {
        "start": 8028,
        "end": 8037
      },
      "text": "སེམས་ཉིད་ ༼སྣར། པེ།༽ སེམས་"
    },
    {
      "span": {
        "start": 8108,
        "end": 8111
      },
      "text": "ཏེ། ༼སྣར། པེ།༽ ཏོ། །"
    },
    {
      "span": {
        "start": 8269,
        "end": 8284
      },
      "text": "འགྱུར་བའི་ཕྱིར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 8337,
        "end": 8478
      },
      "text": "ངོ་བོ་མི་འཛིན་ཀྱང་མངོན་པར་འདོད་པའི་དོན་ལ་མི་སླུ་བས་ཚད་མ་ཉིད་ཡིན་པའི་ཕྱིར་རོ། །དུ་བ་ལ་སོགས་པའི་རྟགས་ལས་སྐྱེས་པ་ཡང་མེ་ལ་སོགས་པའི་རང་གི་ངོ་བོའི་ ༼སྣར། པེ།༽ ངོ་བོ་"
    },
    {
      "span": {
        "start": 8525,
        "end": 8540
      },
      "text": "འགྱུར་བའི་ཕྱིར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 8763,
        "end": 8770
      },
      "text": "བྱེད་པ་ ༼སྣར། པེ།༽ བྱེད་པས་"
    },
    {
      "span": {
        "start": 9020,
        "end": 9027
      },
      "text": "མྱོང་བ་ ༼སྣར། པེ།༽ མྱོང་བ་སྐྱེས་པ་"
    },
    {
      "span": {
        "start": 9101,
        "end": 9105
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ ཉིད་ཀྱིས།"
    },
    {
      "span": {
        "start": 9105,
        "end": 9110
      },
      "text": "ཚད་མ་ ༼སྣར། པེ།༽ ཚད་"
    },
    {
      "span": {
        "start": 9455,
        "end": 9463
      },
      "text": "རེས་འགའ་ ༼སྣར། པེ།༽ རེས་འགའ་དབང་"
    },
    {
      "span": {
        "start": 9800,
        "end": 9806
      },
      "text": "རྒྱུད་ ༼སྣར། པེ།༽ རྒྱུན་"
    },
    {
      "span": {
        "start": 10058,
        "end": 10070
      },
      "text": "མངོན་སུམ་དུ་ ༼སྣར།༽ མངོན་སུམ་འདུ་"
    },
    {
      "span": {
        "start": 10076,
        "end": 10086
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 10113,
        "end": 10123
      },
      "text": "སེམས་ཀྱིས་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 10257,
        "end": 10270
      },
      "text": "མངོན་སུམ་གྱི་ ༼སྣར། པེ།༽ མངོན་སུམ་གྱིས་"
    },
    {
      "span": {
        "start": 10311,
        "end": 10318
      },
      "text": "འོན་ཏེ་ ༼སྣར། པེ།༽ འོ་ན་"
    },
    {
      "span": {
        "start": 10689,
        "end": 10698
      },
      "text": "རླབས་ཀྱི་ ༼སྣར། པེ།༽ རླབས་ཀྱིས་"
    },
    {
      "span": {
        "start": 10768,
        "end": 10783
      },
      "text": "ཡུལ་ཅན་ཉིད་ཀྱི་ ༼སྣར། པེ།༽ ཡུལ་ཅན་"
    },
    {
      "span": {
        "start": 10859,
        "end": 10868
      },
      "text": "ཁོ་ན་ཉིད་ ༼སྣར། པེ།༽ ཁོ་ན་"
    },
    {
      "span": {
        "start": 10901,
        "end": 10906
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བར་"
    },
    {
      "span": {
        "start": 10910,
        "end": 10913
      },
      "text": "པར་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 10918,
        "end": 10921
      },
      "text": "བས་ ༼སྣར། པེ།༽ ནས་"
    },
    {
      "span": {
        "start": 10938,
        "end": 10958
      },
      "text": "མངོན་སུམ་དུ་ནི་དེའི་ ༼སྣར། པེ།༽ མངོན་སུམ་འདི་"
    },
    {
      "span": {
        "start": 11335,
        "end": 11353
      },
