{
  "durchens": [
    {
      "span": {
        "start": 41,
        "end": 43
      },
      "text": "བ། ༼སྣར།༽ ཎྱཾ་ག་མཱརྒཱཥྚ་ཡ ༼པེ།༽ ཎྱཾ་ག་མཱརྒཱཥྚི་ཡ།"
    },
    {
      "span": {
        "start": 675,
        "end": 684
      },
      "text": "འཁོར་ཡུག་ ༼སྣར། པེ།༽ ཁོར་ཡུག་"
    },
    {
      "span": {
        "start": 1042,
        "end": 1051
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 1183,
        "end": 1191
      },
      "text": "སྤྲུལ་ལ། ༼སྣར། པེ།༽ སྤྲུལ་པ།"
    },
    {
      "span": {
        "start": 1456,
        "end": 1458
      },
      "text": "བ་ ༼སྣར། པེ།༽ ཝ་"
    },
    {
      "span": {
        "start": 1912,
        "end": 1918
      },
      "text": "བརྫེས་ ༼སྣར། པེ།༽ རྫེས་"
    },
    {
      "span": {
        "start": 1946,
        "end": 1956
      },
      "text": "འདོར་སྟབས་ ༼སྣར། པེ།༽ དོར་ཐབས་"
    },
    {
      "span": {
        "start": 1990,
        "end": 1996
      },
      "text": "འཁྱུད། ༼སྣར། པེ།༽ ཁྱུད།"
    },
    {
      "span": {
        "start": 2253,
        "end": 2263
      },
      "text": "སྐྱོའི་བར་ ༼སྣར། པེ།༽ སྐྱོ་བར་"
    },
    {
      "span": {
        "start": 2408,
        "end": 2413
      },
      "text": "གཏང་། ༼སྣར། པེ།༽ བཏང་།"
    },
    {
      "span": {
        "start": 2877,
        "end": 2880
      },
      "text": "ཤུ་ ༼སྣར། པེ།༽ ཤ་"
    },
    {
      "span": {
        "start": 3162,
        "end": 3171
      },
      "text": "ཁོང་གསེང་ ༼སྣར། པེ།༽ ཁོང་སེང་"
    },
    {
      "span": {
        "start": 3178,
        "end": 3183
      },
      "text": "ལྗགས། ༼སྣར། པེ།༽ ལྕགས།"
    },
    {
      "span": {
        "start": 3341,
        "end": 3348
      },
      "text": "ཛ་ཧོ། ། ༼སྣར། པེ།༽ ཛའོ།། །།"
    },
    {
      "span": {
        "start": 3407,
        "end": 3414
      },
      "text": "ཛ་ཧོ། ། ༼སྣར། པེ།༽ ཛའོ།། །།"
    },
    {
      "span": {
        "start": 3426,
        "end": 3431
      },
      "text": "བསྔོ་ ༼སྣར། པེ།༽ བསྔོ་བ་"
    },
    {
      "span": {
        "start": 3583,
        "end": 3587
      },
      "text": "གཏང་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 3909,
        "end": 3916
      },
      "text": "ཆ་བྱེད་ ༼སྣར། པེ།༽ ཆ་བྱད་"
    },
    {
      "span": {
        "start": 4258,
        "end": 4265
      },
      "text": "སྐ་རགས་ ༼སྣར།༽ སྐེ་རགས་"
    },
    {
      "span": {
        "start": 4375,
        "end": 4386
      },
      "text": "ཆེན་པོ་ཡིས། ༼སྣར། པེ།༽ ཆེན་པོ་ནི།"
    },
    {
      "span": {
        "start": 4395,
        "end": 4400
      },
      "text": "དགོད་ ༼སྣར། པེ།༽ རྒོད་"
    },
    {
      "span": {
        "start": 4675,
        "end": 4683
      },
      "text": "ཧ་ན་ད་ཧ་ ༼སྣར། པེ།༽ ཧ་"
    },
    {
      "span": {
        "start": 4838,
        "end": 4841
      },
      "text": "ཡི་ ༼སྣར། པེ།༽ ཡའི་"
    },
    {
      "span": {
        "start": 5027,
        "end": 5030
      },
      "text": "ནན་ ༼སྣར། པེ།༽ ནཎ་"
    },
    {
      "span": {
        "start": 5136,
        "end": 5139
      },
      "text": "ནན། ༼སྣར། པེ།༽ ནཎ།"
    },
    {
      "span": {
        "start": 5385,
        "end": 5389
      },
      "text": "ར་ཡ་ ༼སྣར། པེ།༽ ར་"
    },
    {
      "span": {
        "start": 5404,
        "end": 5407
      },
      "text": "ནན། ༼སྣར། པེ།༽ ནཎ།"
    },
    {
      "span": {
        "start": 5408,
        "end": 5414
      },
      "text": "ཀླད་པ་ ༼སྣར། པེ།༽ གླད་པ་"
    },
    {
      "span": {
        "start": 5414,
        "end": 5417
      },
      "text": "ནན། ༼སྣར། པེ།༽ ནཎ།"
    },
    {
      "span": {
        "start": 5424,
        "end": 5427
      },
      "text": "ཀུ་ ༼སྣར། པེ།༽ གུ་"
    },
    {
      "span": {
        "start": 5430,
        "end": 5433
      },
      "text": "ནན། ༼སྣར། པེ།༽ ནཎ།"
    },
    {
      "span": {
        "start": 5491,
        "end": 5493
      },
      "text": "ག་ ༼སྣར། པེ།༽ གྷ་"
    },
    {
      "span": {
        "start": 5499,
        "end": 5502
      },
      "text": "ནན། ༼སྣར། པེ།༽ ནཎ།"
    },
    {
      "span": {
        "start": 5545,
        "end": 5549
      },
      "text": "གསད་ ༼སྣར། པེ།༽ བསད་"
    },
    {
      "span": {
        "start": 5650,
        "end": 5655
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 5670,
        "end": 5676
      },
      "text": "འགྲེས་ ༼སྣར། པེ།༽ འདྲེས་"
    },
    {
      "span": {
        "start": 5770,
        "end": 5772
      },
      "text": "ཡ། ༼སྣར། པེ།༽ ཡེ།"
    },
    {
      "span": {
        "start": 5885,
        "end": 5891
      },
      "text": "ཧུ་ལུ། ༼སྣར། པེ།༽ ཧཱུ་ལུ་ཧཱུ་ལུ།"
    },
    {
      "span": {
        "start": 5911,
        "end": 5914
      },
      "text": "ཧུ་ ༼སྣར། པེ།༽ ། ཧཱུ་"
    },
    {
      "span": {
        "start": 5917,
        "end": 5920
      },
      "text": "ཧུ་ ༼སྣར། པེ།༽ ཧཱུ་"
    },
    {
      "span": {
        "start": 6063,
        "end": 6065
      },
      "text": "ཡ། ༼སྣར།༽ ཡཱ།"
    },
    {
      "span": {
        "start": 6081,
        "end": 6083
      },
      "text": "ཡ། ༼སྣར། པེ།༽ ཡཱ།"
    },
    {
      "span": {
        "start": 6084,
        "end": 6092
      },
      "text": "ཛྲི་རྦམ་ ༼སྣར། པེ།༽ ཛྲཱིརྦམ་"
    },
    {
      "span": {
        "start": 6112,
        "end": 6120
      },
      "text": "བཏབ་སྟེ་ ༼སྣར། པེ།༽ བཏབ་ཏེ་"
    },
    {
      "span": {
        "start": 6171,
        "end": 6173
      },
      "text": "ཡ་ ༼སྣར། པེ།༽ ཡཱ་"
    },
    {
      "span": {
        "start": 6176,
        "end": 6188
      },
      "text": "ཙ་ནི་མོ་ཙ་ཡ། ༼སྣར།༽ ཙ་ནི་མོ་ཙ་ཡཱ ༼པེ།༽ ཙ་ཡཱ།"
    },
    {
      "span": {
        "start": 6204,
        "end": 6206
      },
      "text": "ཡ། ༼སྣར། པེ།༽ ཡཱ།"
    },
    {
      "span": {
        "start": 6431,
        "end": 6437
      },
      "text": "གཏུམས་ ༼སྣར། པེ།༽ བཏུམས་"
    },
    {
      "span": {
        "start": 6818,
        "end": 6826
      },
      "text": "སྲེག་པར་ ༼སྣར། པེ།༽ བསྲེག་པར་"
    },
    {
      "span": {
        "start": 7114,
        "end": 7119
      },
      "text": "ཤྲ་བ་ ༼སྣར། པེ།༽ ཤྲ་མ་"
    },
    {
      "span": {
        "start": 7446,
        "end": 7449
      },
      "text": "ཁང་ ༼སྣར།༽ གང་"
    },
    {
      "span": {
        "start": 7483,
        "end": 7488
      },
      "text": "སྤུང་ ༼སྣར། པེ།༽ དཔུངས་"
    },
    {
      "span": {
        "start": 7559,
        "end": 7562
      },
      "text": "པོ་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 7699,
        "end": 7708
      },
      "text": "པིར་གྱིས་ ༼སྣར། པེ།༽ པིར་གྱི་"
    },
    {
      "span": {
        "start": 7767,
        "end": 7776
      },
      "text": "ཀྲ་སྟ་ཡེ་ ༼སྣར། པེ།༽ ཀྲ་སྟེ་"
    },
    {
      "span": {
        "start": 7912,
        "end": 7919
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 7924,
        "end": 7932
      },
      "text": "བདག་ཉིད་ ༼སྣར། པེ།༽ བདག་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 8073,
        "end": 8080
      },
      "text": "བསྟིམས་ ༼སྣར། པེ།༽ བསྟིམ་"
    },
    {
      "span": {
        "start": 8256,
        "end": 8274
      },
      "text": "ཤངས་དབྱེ་བ་ནི་ཨོཾ་ ༼སྣར། པེ།༽ ཨོཾ་"
    },
    {
      "span": {
        "start": 8327,
        "end": 8331
      },
      "text": "བཟའ་ ༼སྣར།༽ གཟའ་"
    },
    {
      "span": {
        "start": 8428,
        "end": 8456
      },
      "text": "སེམས་དཔའི་བྱ་བ་བྱའོ། །པུསྟི་ ༼སྣར། པེ།༽ སེམས་དཔའ་བྱི་བའོ། །པོ་ཏི་"
    },
    {
      "span": {
        "start": 8632,
        "end": 8640
      },
      "text": "བརླབ་བོ། ༼སྣར། པེ།༽ བརླབ་པའོ།"
    },
    {
      "span": {
        "start": 8931,
        "end": 8941
      },
      "text": "འདོད་ལྷའི་ ༼སྣར། པེ།༽ འདོད་པའི་"
    },
    {
      "span": {
        "start": 9025,
        "end": 9035
      },
      "text": "བསྟིམས་ཏེ། ༼སྣར། པེ།༽ བསྟིམ་སྟེ་"
    },
    {
      "span": {
        "start": 9230,
        "end": 9271
      },
      "text": "དཀོན་མཆོག་བདེན་པས་དུག་མི་མངའ། །དཀོན་མཆོག་ ༼སྣར། པེ།༽ དཀོན་མཆོག་"
    },
    {
      "span": {
        "start": 9404,
        "end": 9409
      },
      "text": "བསྟན་ ༼སྣར། པེ།༽ སྟན་"
    },
    {
      "span": {
        "start": 9564,
        "end": 9568
      },
      "text": "ཏ་ལ་ ༼སྣར། པེ།༽ རྟ་ལ་"
    },
    {
      "span": {
        "start": 9620,
        "end": 9624
      },
      "text": "སྨན་ ༼སྣར། པེ།༽ བསྣན་"
    },
    {
      "span": {
        "start": 9738,
        "end": 9742
      },
      "text": "ཐོག་ ༼སྣར། པེ།༽ ཏོག་"
    },
    {
      "span": {
        "start": 9756,
        "end": 9763
      },
      "text": "དྲག་པོ་ ༼སྣར། པེ།༽ དྲག་པོའི་"
    },
    {
      "span": {
        "start": 10024,
        "end": 10027
      },
      "text": "རུ་ ༼སྣར། པེ།༽ རུ་ཡེ་"
    },
    {
      "span": {
        "start": 10035,
        "end": 10045
      },
      "text": "ཞི་བའི་འོ། ༼སྣར། པེ།༽ ཞི་བའི་བའོ།"
    },
    {
      "span": {
        "start": 10054,
        "end": 10060
      },
      "text": "ཀུ་རུ་ ༼སྣར།༽ ཀུ་རུ་ཡེ་ ༼པེ།༽ ཀུ་རུ་ཡ་"
    },
    {
      "span": {
        "start": 10086,
        "end": 10092
      },
      "text": "ཀུ་རུ་ ༼སྣར། པེ།༽ ཀུ་རུ་ཡེ་"
    },
    {
      "span": {
        "start": 10118,
        "end": 10124
      },
      "text": "ཀུ་རུ་ ༼སྣར། པེ།༽ ཀུ་རུ་ཡེ་"
    },
    {
      "span": {
        "start": 10243,
        "end": 10264
      },
      "text": "རྡོ་རྗེའིའོ།། །།༄༅། ། ༼སྣར། པེ།༽ རྡོ་རྗེའིའོརྗེའོ།། །།"
    },
    {
      "span": {
        "start": 10350,
        "end": 10356
      },
      "text": "གཟུངས་ ༼སྣར། པེ།༽ གཟུགས་"
    },
    {
      "span": {
        "start": 10393,
        "end": 10397
      },
      "text": "བྱབ། ༼སྣར། པེ།༽ བྱ།"
    },
    {
      "span": {
        "start": 10641,
        "end": 10648
      },
      "text": "བསྡིགས་ ༼སྣར། པེ།༽ སྡིགས་"
    },
    {
      "span": {
        "start": 10658,
        "end": 10669
      },
      "text": "མདོངས་ཀྱིས་ ༼སྣར། པེ།༽ མདོངས་ཀྱི་"
    },
    {
      "span": {
        "start": 10677,
        "end": 10688
      },
      "text": "ལྟ་བུར་བྱབ། ༼སྣར། པེ།༽ ལྟར་བྱ་བ།"
    },
    {
      "span": {
        "start": 10805,
        "end": 10811
      },
      "text": "འཇོམས། ༼སྣར། པེ།༽ འཇིལ།"
    },
    {
      "span": {
        "start": 10844,
        "end": 10849
      },
      "text": "རླངས་ ༼སྣར། པེ།༽ བླངས་"
    },
    {
      "span": {
        "start": 10856,
        "end": 10864
      },
      "text": "བསམ་པའི་ ༼སྣར། པེ།༽ བསམས་པའི་"
    },
    {
      "span": {
        "start": 11027,
        "end": 11032
      },
      "text": "བསྡུ་ ༼སྣར། པེ།༽ བསྡུས་"
    },
    {
      "span": {
        "start": 11051,
        "end": 11057
      },
      "text": "བརྒྱད། ༼སྣར། པེ།༽ རྒྱས།"
    },
    {
      "span": {
        "start": 11174,
        "end": 11186
      },
      "text": "བརྟག་པ་གཅེས་ ༼སྣར། པེ།༽ བརྟག་པ་ཅེས་"
    },
    {
      "span": {
        "start": 11283,
        "end": 11291
      },
      "text": "སྔོན་དུ་ ༼སྣར། པེ།༽ མངོན་དུ་"
    },
    {
      "span": {
        "start": 11373,
        "end": 11378
      },
      "text": "རྩུབ་ ༼སྣར། པེ།༽ བརྩུབ་"
    },
    {
      "span": {
        "start": 11382,
        "end": 11385
      },
      "text": "རྣ་ ༼སྣར། པེ།༽ སྣ་"
    },
    {
      "span": {
        "start": 11396,
        "end": 11406
      },
      "text": "རྔབས་རུའི་ ༼སྣར། པེ།༽ སྔ་སྦྲུལ་"
    },
    {
      "span": {
        "start": 11453,
        "end": 11460
      },
      "text": "རིག་པས་ ༼སྣར། པེ།༽ རིགས་པས་"
    },
    {
      "span": {
        "start": 11515,
        "end": 11520
      },
      "text": "བརྟག་ ༼སྣར། པེ།༽ བརྟག་ཐབས་བརྒྱད་ལ་གསོ་ཐབས་བརྒྱད། །བརྟག་"
    },
    {
      "span": {
        "start": 11649,
        "end": 11659
      },
      "text": "གཏེར་གྱིས་ ༼སྣར། པེ།༽ གཏེར་གྱི་"
    }
  ]
}