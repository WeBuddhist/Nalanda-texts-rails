{
  "durchens": [
    {
      "span": {
        "start": 26,
        "end": 28
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནཱ་"
    },
    {
      "span": {
        "start": 48,
        "end": 58
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ སྒོམ་པའི་"
    },
    {
      "span": {
        "start": 109,
        "end": 116
      },
      "text": "ཆེན་པོ་ ༼སྣར། པེ།༽ ཆེན་པོའི་"
    },
    {
      "span": {
        "start": 153,
        "end": 163
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ སྒོམ་པའི་"
    },
    {
      "span": {
        "start": 595,
        "end": 610
      },
      "text": "སྒྲིབ་པ་མཐའ་དག་ ༼སྣར། པེ།༽ སྒྲིབ་པ་"
    },
    {
      "span": {
        "start": 769,
        "end": 776
      },
      "text": "མུན་པར་ ༼སྣར། པེ།༽ ནི་མུན་པ་"
    },
    {
      "span": {
        "start": 832,
        "end": 841
      },
      "text": "རྟོགས་པས་ ༼སྣར། པེ།༽ རྟོག་པས་"
    },
    {
      "span": {
        "start": 1203,
        "end": 1212
      },
      "text": "ལ་མོས་ནས་ ༼སྣར། པེ།༽ ལ་མོས་པས་"
    },
    {
      "span": {
        "start": 1316,
        "end": 1319
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་ལ་"
    },
    {
      "span": {
        "start": 1501,
        "end": 1514
      },
      "text": "ལྷག་མཐོང་གིས་ ༼སྣར། པེ།༽ ལྷག་མཐོང་གི་"
    },
    {
      "span": {
        "start": 1534,
        "end": 1547
      },
      "text": "སྤྱོད་པ་དེའི་ ༼སྣར། པེ།༽ སྤྱོད་པའི་"
    },
    {
      "span": {
        "start": 1580,
        "end": 1590
      },
      "text": "རྟོགས་པའི་ ༼སྣར། པེ།༽ རྟོག་པའི་"
    },
    {
      "span": {
        "start": 1723,
        "end": 1734
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 1737,
        "end": 1744
      },
      "text": "བོ་ཉིད་ ༼སྣར། པེ།༽ བོ་"
    },
    {
      "span": {
        "start": 1782,
        "end": 1791
      },
      "text": "བཞིན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 1791,
        "end": 1802
      },
      "text": "གཟུགས་བརྙན་ ༼སྡེ།༽ གཟུགས་"
    },
    {
      "span": {
        "start": 1933,
        "end": 1941
      },
      "text": "རྟོག་པར་ ༼སྣར། པེ།༽ རྟོགས་པར་"
    },
    {
      "span": {
        "start": 2031,
        "end": 2037
      },
      "text": "དེས་ན་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 2041,
        "end": 2051
      },
      "text": "བཅུད་ཀྱིས་ ༼སྣར། པེ།༽ བཅུད་ཀྱི་"
    },
    {
      "span": {
        "start": 2077,
        "end": 2087
      },
      "text": "ལམ་གྱིས་ས་ ༼སྣར། པེ།༽ ལམ་གྱིས་"
    },
    {
      "span": {
        "start": 2191,
        "end": 2200
      },
      "text": "སྤངས་པའི་ ༼སྣར། པེ།༽ སྤང་བའི་"
    },
    {
      "span": {
        "start": 2247,
        "end": 2264
      },
      "text": "སངས་རྒྱས་ཀྱི་ས་ལ་ ༼སྣར། པེ།༽ སངས་རྒྱས་ཀྱི་"
    },
    {
      "span": {
        "start": 2422,
        "end": 2426
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 2480,
        "end": 2485
      },
      "text": "འཐོབ་ ༼སྣར། པེ།༽ ཐོབ་"
    },
    {
      "span": {
        "start": 2546,
        "end": 2554
      },
      "text": "འདོད་པས་ ༼སྣར། པེ།༽ འདོད་པ་"
    },
    {
      "span": {
        "start": 2591,
        "end": 2602
      },
      "text": "གང་དེ་གཉིས་ ༼སྣར། པེ།༽ གང་དེ་ཉིད་"
    },
    {
      "span": {
        "start": 2607,
        "end": 2614
      },
      "text": "སྒོམ་པ་ ༼སྣར།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 2643,
        "end": 2649
      },
      "text": "རྟོགས། ༼སྣར། པེ།༽ རྟོག།"
    },
    {
      "span": {
        "start": 2665,
        "end": 2673
      },
      "text": "གྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 2951,
        "end": 2965
      },
      "text": "དག་པ་ལ་སོགས་པ་ ༼ཅོ།༽ དག་པ་་པ་ལ་སོགས་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 3030,
        "end": 3037
      },
      "text": "བསྐྱེད་ ༼པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 3223,
        "end": 3231
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 3327,
        "end": 3340
      },
      "text": "བསམ་པ་ཅན་གྱི་ ༼སྣར། པེ།༽ བསམ་པ་ཅན་"
    },
    {
      "span": {
        "start": 3552,
        "end": 3561
      },
      "text": "ནུས་ཀྱིས་ ༼སྣར། པེ།༽ ནུས་ཀྱི་"
    },
    {
      "span": {
        "start": 3624,
        "end": 3635
      },
      "text": "བསོད་ནམས་ལ་ ༼སྣར། པེ།༽ བསོད་ནམས་"
    },
    {
      "span": {
        "start": 3646,
        "end": 3651
      },
      "text": "རང་བ་ ༼སྣར། པེ།༽ རང་བར་"
    },
    {
      "span": {
        "start": 3655,
        "end": 3658
      },
      "text": "ནས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 3794,
        "end": 3803
      },
      "text": "འཛུམས་པར་ ༼སྣར། པེ།༽ འཛུམ་པར་"
    },
    {
      "span": {
        "start": 3816,
        "end": 3820
      },
      "text": "གཏད་ ༼སྣར། པེ།༽ བསྟད་"
    },
    {
      "span": {
        "start": 3841,
        "end": 3845
      },
      "text": "སྒུ་ ༼སྣར། པེ།༽ དགུ་"
    },
    {
      "span": {
        "start": 3979,
        "end": 3982
      },
      "text": "ཡོ་ ༼སྣར། པེ།༽ གཡོ་"
    },
    {
      "span": {
        "start": 4059,
        "end": 4061
      },
      "text": "ཡ་ ༼སྣར། པེ།༽ ཡས་"
    },
    {
      "span": {
        "start": 4074,
        "end": 4081
      },
      "text": "བཞར་རོ། ༼སྣར། པེ།༽ གཞག་གོ།"
    },
    {
      "span": {
        "start": 4366,
        "end": 4378
      },
      "text": "སེམས་གཏད་དེ་ ༼སྣར། པེ།༽ སེམས་"
    },
    {
      "span": {
        "start": 4392,
        "end": 4402
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 4685,
        "end": 4693
      },
      "text": "བཞུགས་པ་ ༼སྣར། པེ།༽ བཞུགས་"
    },
    {
      "span": {
        "start": 4763,
        "end": 4779
      },
      "text": "གཤེགས་པའི་སྐུའི་ ༼པེ།༽ གཤེགས་པའི་"
    },
    {
      "span": {
        "start": 4977,
        "end": 4986
      },
      "text": "ཉིད་ཀྱིས་ ༼པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 5049,
        "end": 5058
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 5167,
        "end": 5174
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 5441,
        "end": 5451
      },
      "text": "གཅིག་ཏུ་ན་ ༼སྣར། པེ།༽ གཅིག་ཏུ་"
    },
    {
      "span": {
        "start": 5707,
        "end": 5718
      },
      "text": "ལ་སོགས་པའི་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 5980,
        "end": 5989
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 6163,
        "end": 6174
      },
      "text": "བདག་དང་བདག་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 6211,
        "end": 6220
      },
      "text": "གང་དེ་དག་ ༼སྣར། པེ།༽ གང་དེ་དག་ཉིད་"
    },
    {
      "span": {
        "start": 6321,
        "end": 6324
      },
      "text": "དེ། ༼སྣར། པེ།༽ དོ། །"
    },
    {
      "span": {
        "start": 6328,
        "end": 6331
      },
      "text": "མི་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 6408,
        "end": 6414
      },
      "text": "གང་ཟག་ ༼སྣར། པེ།༽ གང་ཟག་དེ་"
    },
    {
      "span": {
        "start": 6588,
        "end": 6594
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ རྟགས་"
    },
    {
      "span": {
        "start": 6641,
        "end": 6683
      },
      "text": "རུང་བའི་གང་ཟག་གི་དངོས་པོ་ཡོད་པར་ནི་མི་རུང་ ༼སྣར།༽ རུང་བའི་གང་ཟག་གི་དངོས་པོ་ཡོད་པ་ནི་མི་རུང་ ༼པེ།༽ རུང་"
    },
    {
      "span": {
        "start": 6812,
        "end": 6818
      },
      "text": "བརྫུན་ ༼སྣར། པེ།༽ རྫུན་"
    },
    {
      "span": {
        "start": 6878,
        "end": 6886
      },
      "text": "རྟོག་པར་ ༼སྣར། པེ།༽ རྟོགས་པར་"
    },
    {
      "span": {
        "start": 7067,
        "end": 7075
      },
      "text": "དཔྱད་པར་ ༼སྣར། པེ།༽ སྤྱད་པར་"
    },
    {
      "span": {
        "start": 7262,
        "end": 7270
      },
      "text": "སེམས་ཙམ་ ༼སྣར། པེ།༽ སེམས་ཅན་"
    },
    {
      "span": {
        "start": 7388,
        "end": 7393
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 7511,
        "end": 7517
      },
      "text": "དུས་ན་ ༼སྣར། པེ།༽ དུས་ནས་"
    },
    {
      "span": {
        "start": 7566,
        "end": 7574
      },
      "text": "དབང་གིས་ ༼སྣར། པེ།༽ དབང་གི་"
    },
    {
      "span": {
        "start": 7642,
        "end": 7651
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 7783,
        "end": 7789
      },
      "text": "རྟོགས་ ༼སྣར། པེ།༽ རྟོག་"
    },
    {
      "span": {
        "start": 7918,
        "end": 7927
      },
      "text": "དཔྱོད་དོ། ༼སྣར། པེ།༽ དཔྱོད་དེ།"
    },
    {
      "span": {
        "start": 7989,
        "end": 7999
      },
      "text": "བརྫུན་པའི་ ༼སྣར། པེ།༽ རྫུན་པའི་"
    },
    {
      "span": {
        "start": 8373,
        "end": 8379
      },
      "text": "ཚེ་ཡང་ ༼སྣར། པེ།༽ ཚེ་"
    },
    {
      "span": {
        "start": 8427,
        "end": 8437
      },
      "text": "གཉིས་ཀ་ལས་ ༼སྣར། པེ།༽ གཉིས་ཀ་ལ་"
    },
    {
      "span": {
        "start": 8609,
        "end": 8613
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 8621,
        "end": 8625
      },
      "text": "གིས་ ༼སྣར། པེ།༽ གི་ཚེ་"
    },
    {
      "span": {
        "start": 8763,
        "end": 8771
      },
      "text": "བརྟགས་ན་ ༼སྣར། པེ།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 8803,
        "end": 8807
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 8813,
        "end": 8819
      },
      "text": "ཚེ་མི་ ༼སྣར། པེ།༽ ཚེ་"
    },
    {
      "span": {
        "start": 8870,
        "end": 8878
      },
      "text": "སྡོང་པོ་ ༼སྣར། པེ།༽ སྡོང་བུ་"
    },
    {
      "span": {
        "start": 8901,
        "end": 8909
      },
      "text": "རྟོགས་ན་ ༼སྣར། པེ།༽ རྟོགས་ནས་"
    },
    {
      "span": {
        "start": 8912,
        "end": 8915
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 8950,
        "end": 8960
      },
      "text": "ལ་སོགས་པར་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 9196,
        "end": 9203
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 9355,
        "end": 9361
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 9394,
        "end": 9401
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 9401,
        "end": 9406
      },
      "text": "དེའི་ ༼སྣར། པེ།༽ དེ་ཡང་"
    },
    {
      "span": {
        "start": 9648,
        "end": 9655
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 9838,
        "end": 9844
      },
      "text": "ཚེ་དེ་ ༼སྣར། པེ།༽ ཚེ་"
    },
    {
      "span": {
        "start": 9925,
        "end": 9940
      },
      "text": "དུས་གསུམ་དུ་ཡང་ ༼སྣར། པེ།༽ དུས་གསུམ་དུ་"
    },
    {
      "span": {
        "start": 9951,
        "end": 9967
      },
      "text": "དམིགས་པ་དེའི་ཚེ་ ༼སྣར།༽ དམིགས་ལ་དེའི་ ༼པེ།༽ དམིགས་པ་དེའི་"
    },
    {
      "span": {
        "start": 10043,
        "end": 10053
      },
      "text": "གཉིས་ཀྱིས་ ༼སྣར། པེ།༽ གཉིས་ཀྱི་"
    },
    {
      "span": {
        "start": 10141,
        "end": 10152
      },
      "text": "བྱེད་པ་མེད་ ༼ཅོ།༽ བྱ་བ་མེད་ ༼སྣར། པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 10292,
        "end": 10304
      },
      "text": "ཤེས་རབ་ཀྱིས་ ༼སྣར། པེ།༽ ཤེས་རབ་ཀྱི་"
    },
    {
      "span": {
        "start": 10336,
        "end": 10342
      },
      "text": "ཉིད་མ་ ༼ཅོ།༽ ཉིད་མི་"
    },
    {
      "span": {
        "start": 10380,
        "end": 10382
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 10456,
        "end": 10461
      },
      "text": "བྱ་བ་ ༼ཅོ།༽ བྱ་"
    },
    {
      "span": {
        "start": 10496,
        "end": 10504
      },
      "text": "དཔྱོད་པ་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 10512,
        "end": 10524
      },
      "text": "བརྗོད་པ་མེད་ ༼སྣར། པེ།༽ བརྗོད་"
    },
    {
      "span": {
        "start": 10649,
        "end": 10654
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 10673,
        "end": 10677
      },
      "text": "དེར་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 10710,
        "end": 10715
      },
      "text": "གཡེང་ ༼སྣར། པེ།༽ གཡོ་"
    },
    {
      "span": {
        "start": 10768,
        "end": 10777
      },
      "text": "གཡེངས་པར་ ༼སྣར། པེ།༽ གཡེང་བར་"
    },
    {
      "span": {
        "start": 10809,
        "end": 10815
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 10825,
        "end": 10833
      },
      "text": "གཡེངས་པ་ ༼སྣར། པེ།༽ གཡེང་པ་"
    },
    {
      "span": {
        "start": 11258,
        "end": 11265
      },
      "text": "བྱས་ནས་ ༼སྣར། པེ།༽ བྱས་ལ་"
    },
    {
      "span": {
        "start": 11284,
        "end": 11292
      },
      "text": "བསྟན་པར་ ༼སྣར། པེ།༽ བརྟན་པར་"
    },
    {
      "span": {
        "start": 11328,
        "end": 11340
      },
      "text": "དམུས་ལོང་དང་ ༼སྣར། པེ།༽ དམུས་ལོང་"
    },
    {
      "span": {
        "start": 11834,
        "end": 11848
      },
      "text": "རིག་པར་བྱའོ། ། ༼པེ།༽ རིག་པར་"
    },
    {
      "span": {
        "start": 11935,
        "end": 11943
      },
      "text": "དེ་ཁོ་ན་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 12011,
        "end": 12018
      },
      "text": "བྱས་ཏེ། ༼སྣར། པེ།༽ བྱ་སྟེ།"
    },
    {
      "span": {
        "start": 12087,
        "end": 12094
      },
      "text": "བྱའོ། ། ༼སྣར། པེ།༽ ། །དེ་"
    },
    {
      "span": {
        "start": 12115,
        "end": 12125
      },
      "text": "བསྒོམས་པས་ ༼སྣར། པེ།༽ བསྒོམ་པས་"
    },
    {
      "span": {
        "start": 12170,
        "end": 12180
      },
      "text": "མཚུངས་པའི་ ༼ཅོ།༽ ཆུངས་པའི་ ༼སྣར། པེ།༽ ཆུང་བའི་"
    },
    {
      "span": {
        "start": 12351,
        "end": 12367
      },
      "text": "བཞིན་དུ་དེ་ཁོ་ན་ ༼སྣར། པེ།༽ བཞིན་དུ་"
    },
    {
      "span": {
        "start": 12802,
        "end": 12811
      },
      "text": "བསྒོམ་པར་ ༼སྣར། པེ།༽ སྒོམ་པར་"
    },
    {
      "span": {
        "start": 13245,
        "end": 13253
      },
      "text": "ལྡོག་པར་ ༼སྣར། པེ།༽ ཟློག་པར་"
    },
    {
      "span": {
        "start": 13264,
        "end": 13272
      },
      "text": "དེ་བས་ན་ ༼སྣར། པེ།༽ དེ་བས་"
    },
    {
      "span": {
        "start": 13411,
        "end": 13445
      },
      "text": "གཉིས་ཀྱི་གཉེན་པོ་སྟེ། དེས་དེ་གཉིས་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 13483,
        "end": 13492
      },
      "text": "རྒོད་པ་མ་ ༼སྣར། པེ།༽ རྒོད་པ་"
    },
    {
      "span": {
        "start": 13691,
        "end": 13700
      },
      "text": "བསྒོམ་པར་ ༼པེ།༽ སྒོམ་པར་"
    },
    {
      "span": {
        "start": 13919,
        "end": 13925
      },
      "text": "ཞུམ་པ་ ༼ཅོ།༽ ཞུམ་པར་"
    },
    {
      "span": {
        "start": 14221,
        "end": 14230
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 14237,
        "end": 14247
      },
      "text": "དེ་སྐད་དུ་ ༼སྣར། པེ།༽ དེ་སྐད་"
    },
    {
      "span": {
        "start": 14491,
        "end": 14500
      },
      "text": "རྟོགས་ནས་ ༼སྣར། པེ།༽ རྟོགས་ན་"
    },
    {
      "span": {
        "start": 14541,
        "end": 14547
      },
      "text": "བྱས་ལ་ ༼སྣར། པེ།༽ བྱས་པ་"
    },
    {
      "span": {
        "start": 14745,
        "end": 14752
      },
      "text": "བསྩོགས་ ༼སྣར། པེ།༽ སོགས་"
    },
    {
      "span": {
        "start": 14889,
        "end": 14897
      },
      "text": "བསོས་ཏེ། ༼སྣར། པེ།༽ བསོ་སྟེ།"
    },
    {
      "span": {
        "start": 14992,
        "end": 15000
      },
      "text": "བསོས་ཏེ་ ༼སྣར།༽ བསོ་ཏེ་ ༼པེ།༽ བསོ་སྟེ་"
    },
    {
      "span": {
        "start": 15084,
        "end": 15093
      },
      "text": "ཐུན་གཅིག་ ༼སྣར། པེ།༽ ཐུན་ཅིག་"
    },
    {
      "span": {
        "start": 15505,
        "end": 15511
      },
      "text": "རྟག་པ་ ༼སྣར། པེ།༽ སྟོང་པ་"
    },
    {
      "span": {
        "start": 16386,
        "end": 16401
      },
      "text": "སེམས་ཅན་ཐམས་ཅད་ ༼སྣར། པེ།༽ སེམས་ཅན་"
    },
    {
      "span": {
        "start": 16587,
        "end": 16597
      },
      "text": "བསྐྱེད་པར་ ༼སྣར། པེ།༽ སྐྱེད་པར་"
    },
    {
      "span": {
        "start": 16644,
        "end": 16651
      },
      "text": "དག་གིས་ ༼སྣར། པེ།༽ དག་གི་"
    },
    {
      "span": {
        "start": 16731,
        "end": 16750
      },
      "text": "བྱའོ་སྙམ་དུ་བསམ་མོ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 16752,
        "end": 16759
      },
      "text": "དེ་སྐད་ ༼སྣར། པེ།༽ དེ་སྐད་དུ་"
    },
    {
      "span": {
        "start": 16853,
        "end": 16861
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 17164,
        "end": 17172
      },
      "text": "གཅིག་པུ་ ༼སྣར། པེ།༽ གཅིག་དུ་"
    },
    {
      "span": {
        "start": 17392,
        "end": 17402
      },
      "text": "འགྲུབ་པའི་ ༼སྣར། པེ།༽ གྲུབ་པའི་"
    },
    {
      "span": {
        "start": 17591,
        "end": 17600
      },
      "text": "ཐམས་ཅད་ལ་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 17649,
        "end": 17658
      },
      "text": "སྐྱེས་སོ་ ༼སྣར། པེ།༽ སྐྱེས་པའོ། །"
    },
    {
      "span": {
        "start": 18467,
        "end": 18471
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 18510,
        "end": 18523
      },
      "text": "ཐེག་པ་ཆེན་པོ་ ༼སྣར། པེ།༽ ཐེག་པ་"
    },
    {
      "span": {
        "start": 18565,
        "end": 18570
      },
      "text": "སྤངས་ ༼པེ།༽ སྤང་"
    },
    {
      "span": {
        "start": 18756,
        "end": 18773
      },
      "text": "ཡིན་པས་ན་དེ་སྤངས་ ༼སྣར། པེ།༽ ཡིན་པས་"
    },
    {
      "span": {
        "start": 18863,
        "end": 18874
      },
      "text": "སྤྱད་པར་མི་ ༼པེ།༽ སྤྱད་པར་"
    },
    {
      "span": {
        "start": 18935,
        "end": 18942
      },
      "text": "སྤངས་པ་ ༼སྣར། པེ།༽ སྤང་བ་"
    },
    {
      "span": {
        "start": 19022,
        "end": 19028
      },
      "text": "མགོའི་ ༼སྣར། པེ།༽ གོའི་"
    },
    {
      "span": {
        "start": 19080,
        "end": 19090
      },
      "text": "མདོར་བསྡུ་ ༼སྣར། པེ།༽ མདོར་བསྡུས་"
    },
    {
      "span": {
        "start": 19168,
        "end": 19184
      },
      "text": "གཤེགས་པའི་གསང་བ་ ༼སྣར། པེ།༽ གཤེགས་པའི་མདོ་"
    },
    {
      "span": {
        "start": 19417,
        "end": 19422
      },
      "text": "ལྟ་བ་ ༼སྣར། པེ།༽ ལྟ་བ་ལ་"
    },
    {
      "span": {
        "start": 19686,
        "end": 19693
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ འདི་ལྟར་"
    },
    {
      "span": {
        "start": 19762,
        "end": 19770
      },
      "text": "ཡང་དག་པ་ ༼སྣར། པེ།༽ ཡང་དག་"
    },
    {
      "span": {
        "start": 19888,
        "end": 19895
      },
      "text": "དུས་ནས་ ༼སྣར། པེ།༽ དུས་"
    },
    {
      "span": {
        "start": 19938,
        "end": 19947
      },
      "text": "གོམས་པའི་ ༼སྣར། པེ།༽ གོམ་པའི་"
    },
    {
      "span": {
        "start": 19973,
        "end": 19986
      },
      "text": "ལ་རྣམ་པར་གཞག་ ༼སྣར། པེ།༽ ལ་བཞག་"
    },
    {
      "span": {
        "start": 19989,
        "end": 19992
      },
      "text": "བྱ། ༼སྣར། པེ།༽ བྱའོ། །"
    },
    {
      "span": {
        "start": 20203,
        "end": 20211
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 20564,
        "end": 20570
      },
      "text": "རྒྱུར་ ༼སྣར། པེ།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 20574,
        "end": 20577
      },
      "text": "བར་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 20593,
        "end": 20600
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 20636,
        "end": 20639
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 20721,
        "end": 20729
      },
      "text": "བརྒྱལ་བ་ ༼སྣར། པེ།༽ རྒྱལ་བ་"
    },
    {
      "span": {
        "start": 20842,
        "end": 20851
      },
      "text": "གཞན་གྱིས་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 20878,
        "end": 20885
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 20932,
        "end": 20943
      },
      "text": "བྱེད་པ་མེད་ ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 21022,
        "end": 21030
      },
      "text": "འཇུག་པར་ ༼སྣར། པེ།༽ འཇུག་པ་"
    },
    {
      "span": {
        "start": 21109,
        "end": 21119
      },
      "text": "རྟོག་པ་དེ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 21125,
        "end": 21152
      },
      "text": "དེ་དག་གིས་སྟོང་པ་ཉིད་རྟོགས་ ༼སྣར། པེ།༽ དེ་དག་སྟོང་པར་རྟོག་"
    },
    {
      "span": {
        "start": 21331,
        "end": 21345
      },
      "text": "དྲན་པ་ཉམས་པའམ། ༼སྣར། པེ།༽ དྲན་པའམ།"
    },
    {
      "span": {
        "start": 21425,
        "end": 21438
      },
      "text": "རྣལ་འབྱོར་པར་ ༼སྣར། པེ།༽ རྣལ་འབྱོར་པས་"
    },
    {
      "span": {
        "start": 21911,
        "end": 21917
      },
      "text": "བྱས་ན་ ༼སྣར། པེ།༽ བྱས་ནས་"
    },
    {
      "span": {
        "start": 22030,
        "end": 22036
      },
      "text": "དྲང་བ་ ༼ཅོ།༽ བགྲང་བ་ ༼སྣར། པེ།༽ གྲང་བ་"
    },
    {
      "span": {
        "start": 22036,
        "end": 22046
      },
      "text": "བསྟེན་པའི་ ༼སྣར། པེ།༽ སྟེན་པའི་"
    },
    {
      "span": {
        "start": 22438,
        "end": 22455
      },
      "text": "སོ་སོའི་སྐྱེ་བའི་ ༼སྣར། པེ།༽ སོ་སོའི་"
    },
    {
      "span": {
        "start": 22512,
        "end": 22514
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 22609,
        "end": 22616
      },
      "text": "བལྟ་བར་ ༼སྣར། པེ།༽ ལྟ་བར་"
    },
    {
      "span": {
        "start": 22829,
        "end": 22835
      },
      "text": "གང་ཡང་ ༼སྣར།༽ གང་ཡངས་"
    },
    {
      "span": {
        "start": 22888,
        "end": 22902
      },
      "text": "། དོན་དམ་པར་ན་ ༼སྣར། པེ།༽ དོན་དམ་པར་"
    },
    {
      "span": {
        "start": 22906,
        "end": 22911
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ སུ་"
    },
    {
      "span": {
        "start": 22931,
        "end": 22946
      },
      "text": "མེད་པ་གང་ཡིན་པ་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 22995,
        "end": 22998
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 23149,
        "end": 23166
      },
      "text": "སྤངས་པར་འགྱུར་རོ། ༼སྣར། པེ།༽ སྤངས་པ་ཡིན་ནོ།"
    },
    {
      "span": {
        "start": 23481,
        "end": 23488
      },
      "text": "རྣམ་པར་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 23515,
        "end": 23518
      },
      "text": "ཏེ། ༼སྣར། པེ།༽ ཏོ། །"
    },
    {
      "span": {
        "start": 23703,
        "end": 23714
      },
      "text": "ཤེས་རབ་ཀྱི་ ༼སྣར། པེ།༽ ཤེས་རབ་ཀྱིས་"
    },
    {
      "span": {
        "start": 23719,
        "end": 23724
      },
      "text": "གྱིས་ ༼སྣར། པེ།༽ གྱི་"
    },
    {
      "span": {
        "start": 23775,
        "end": 23788
      },
      "text": "གནས་པའི་ཕྱིར་ ༼སྣར། པེ།༽ གནས་པར་བྱའི་"
    },
    {
      "span": {
        "start": 23926,
        "end": 23932
      },
      "text": "བརྟགས་ ༼སྣར།༽ བརྟག་"
    },
    {
      "span": {
        "start": 24005,
        "end": 24009
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 24120,
        "end": 24127
      },
      "text": "གཞན་དག་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 24147,
        "end": 24152
      },
      "text": "ལ་མི་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 24190,
        "end": 24202
      },
      "text": "ལྷག་མཐོང་ནི་ ༼སྣར། པེ།༽ ལྷག་མཐོང་གི་"
    },
    {
      "span": {
        "start": 24356,
        "end": 24369
      },
      "text": "ལྷག་མཐོང་གིས་ ༼སྣར། པེ།༽ ལྷག་མཐོང་གི་"
    },
    {
      "span": {
        "start": 24528,
        "end": 24532
      },
      "text": "མཚན་ ༼སྣར། པེ།༽ མཚན་ཉིད་"
    },
    {
      "span": {
        "start": 24689,
        "end": 24691
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 24890,
        "end": 24899
      },
      "text": "འདས་ཀྱིས་ ༼སྣར། པེ།༽ འདས་ཀྱི་"
    },
    {
      "span": {
        "start": 24937,
        "end": 24946
      },
      "text": "དུ་ཡང་དེ་ ༼སྣར། པེ།༽ དུ་ཡང་"
    },
    {
      "span": {
        "start": 25290,
        "end": 25298
      },
      "text": "དེ་དག་ལ་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 25592,
        "end": 25617
      },
      "text": "སྨྲས་མ་ཉམས་ན་དེའི་སླད་དུ་ ༼སྣར། པེ།༽ སྨྲས་པ་ནི་མ་ཡིན་ཏེ།"
    },
    {
      "span": {
        "start": 25617,
        "end": 25620
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་ནི་མདོ་སྡེ་ཀུན་ལས་ཀྱང་"
    },
    {
      "span": {
        "start": 25901,
        "end": 25910
      },
      "text": "དེ་དག་ནི་ ༼སྣར། པེ།༽ དེ་དག་གི་"
    },
    {
      "span": {
        "start": 26163,
        "end": 26169
      },
      "text": "སོ་སོ་ ༼པེ།༽ སོ་སོར་"
    },
    {
      "span": {
        "start": 26232,
        "end": 26242
      },
      "text": "སེམས་པ་ཡང་ ༼སྣར། པེ།༽ སེམས་པ་"
    },
    {
      "span": {
        "start": 26438,
        "end": 26450
      },
      "text": "ཤེས་རབ་ཀྱིས་ ༼སྣར། པེ།༽ ཤེས་རབ་ཀྱི་"
    },
    {
      "span": {
        "start": 26501,
        "end": 26511
      },
      "text": "ཀྱི་བསྒོམ་ ༼སྣར།༽ ཀྱིས་སྒོམ་ ༼པེ།༽ ཀྱིས་བསྒོམ་"
    },
    {
      "span": {
        "start": 26543,
        "end": 26553
      },
      "text": "དཀྱུས་ཀྱི་ ༼སྣར། པེ།༽ དཀྱུས་"
    },
    {
      "span": {
        "start": 26563,
        "end": 26571
      },
      "text": "རྒྱུག་པ་ ༼སྣར། པེ།༽ བརྒྱུག་པ་"
    },
    {
      "span": {
        "start": 26642,
        "end": 26652
      },
      "text": "ངོ་བོ་ཉིད་ ༼སྣར། པེ།༽ ངོ་བོ་"
    },
    {
      "span": {
        "start": 26792,
        "end": 26801
      },
      "text": "བརྟེན་པར་ ༼སྣར། པེ།༽ བསྟེན་པར་"
    },
    {
      "span": {
        "start": 26900,
        "end": 26909
      },
      "text": "བསྲེགས་པ་ ༼སྣར། པེ།༽ སྲེགས་པ་"
    },
    {
      "span": {
        "start": 26941,
        "end": 26950
      },
      "text": "བསྲེག་པར་ ༼སྣར། པེ།༽ སྲེག་པར་"
    },
    {
      "span": {
        "start": 27142,
        "end": 27147
      },
      "text": "བླངས་ ༼སྣར། པེ།༽ བླང་"
    },
    {
      "span": {
        "start": 27213,
        "end": 27247
      },
      "text": "འགྱུར་གྱི། ལས་ཟད་ནས་གྲོལ་བར་འགྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 27291,
        "end": 27294
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱ་བར་"
    },
    {
      "span": {
        "start": 27415,
        "end": 27429
      },
      "text": "མེད་པར་མ་གྱུར་ ༼སྣར། པེ།༽ མེད་པར་འགྱུར་"
    },
    {
      "span": {
        "start": 27473,
        "end": 27488
      },
      "text": "མར་མེ་མ་འགགས་ན་ ༼སྣར། པེ།༽ མར་མེ་འགག་ནས་"
    },
    {
      "span": {
        "start": 27595,
        "end": 27599
      },
      "text": "ཡིན་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 27651,
        "end": 27660
      },
      "text": "བརྟེན་པར་ ༼སྣར། པེ།༽ བསྟེན་པར་"
    },
    {
      "span": {
        "start": 27677,
        "end": 27682
      },
      "text": "ན་ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 27879,
        "end": 27890
      },
      "text": "ན་ཡང་དེ་ནི་ ༼སྣར། པེ།༽ ན་ཡང་"
    },
    {
      "span": {
        "start": 27938,
        "end": 27943
      },
      "text": "བསླང་ ༼སྣར། པེ།༽ སླང་"
    },
    {
      "span": {
        "start": 27947,
        "end": 27967
      },
      "text": "དགེ་བའི་ལས་གང་ཡིན་པ་ ༼སྣར། པེ།༽ དགེ་བ་"
    },
    {
      "span": {
        "start": 28051,
        "end": 28058
      },
      "text": "བསླང་བ་ ༼སྣར། པེ།༽ སླང་བ་"
    },
    {
      "span": {
        "start": 28144,
        "end": 28151
      },
      "text": "དེ་སྐད་ ༼སྣར། པེ།༽ དེ་སྐད་དུ་"
    },
    {
      "span": {
        "start": 28217,
        "end": 28224
      },
      "text": "བསྔོ་བ་ ༼སྣར། པེ།༽ སྔོ་བ་"
    },
    {
      "span": {
        "start": 28385,
        "end": 28394
      },
      "text": "བརྩེགས་པ་ ༼སྣར། པེ།༽ རྩེགས་པ་"
    },
    {
      "span": {
        "start": 28799,
        "end": 28810
      },
      "text": "མདོ་སྡེ་དེ་ ༼སྣར། པེ།༽ མདོ་སྡེ་"
    },
    {
      "span": {
        "start": 28990,
        "end": 28997
      },
      "text": "དང་ཆོས་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 29137,
        "end": 29146
      },
      "text": "དོན་བྱ་བ་ ༼སྣར། པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 29217,
        "end": 29227
      },
      "text": "བསྲིངས་པར་ ༼སྣར། པེ།༽ སྲིང་བར་"
    },
    {
      "span": {
        "start": 29361,
        "end": 29373
      },
      "text": "ལ་ཤིན་ཏུ་མི་ ༼སྣར། པེ།༽ ལ་མངོན་དུ་"
    },
    {
      "span": {
        "start": 29425,
        "end": 29432
      },
      "text": "ངས་ལུང་ ༼སྣར། པེ།༽ ངས་"
    },
    {
      "span": {
        "start": 29466,
        "end": 29471
      },
      "text": "ཉེ་བ་ ༼སྣར།༽ ཉེ་བར་"
    },
    {
      "span": {
        "start": 29579,
        "end": 29584
      },
      "text": "བསྟན་ ༼སྣར། པེ།༽ སྟན་"
    },
    {
      "span": {
        "start": 29614,
        "end": 29628
      },
      "text": "ཚུལ་ཁྲིམས་ཀྱི་ ༼སྣར། པེ།༽ ཚུལ་ཁྲིམས་"
    },
    {
      "span": {
        "start": 29749,
        "end": 29758
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 29767,
        "end": 29774
      },
      "text": "ཐབས་དང་ ༼སྣར། པེ།༽ ཐབས་ཀྱིས་"
    },
    {
      "span": {
        "start": 29858,
        "end": 29865
      },
      "text": "ཐབས་ནི་ ༼སྣར། པེ།༽ ཤེས་རབ་ཀྱང་"
    },
    {
      "span": {
        "start": 29952,
        "end": 29960
      },
      "text": "འཁོར་བར་ ༼སྣར། པེ།༽ འཁོར་བས་"
    },
    {
      "span": {
        "start": 30066,
        "end": 30072
      },
      "text": "བྱས་པ་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 30404,
        "end": 30412
      },
      "text": "ཡིན་གྱི། ༼སྣར། པེ།༽ ཡིན་ཏེ།"
    },
    {
      "span": {
        "start": 30525,
        "end": 30534
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་ལ་"
    },
    {
      "span": {
        "start": 30623,
        "end": 30628
      },
      "text": "བསླང་ ༼སྣར། པེ།༽ སླང་"
    },
    {
      "span": {
        "start": 30947,
        "end": 30973
      },
      "text": "སེམས་ཅན་ཕྱིན་ཅི་ལོག་གི་ལས་ ༼སྣར། པེ།༽ སེམས་ཅན་"
    },
    {
      "span": {
        "start": 31079,
        "end": 31086
      },
      "text": "བསྔོ་བ་ ༼སྣར། པེ།༽ བསྔོས་པ་"
    },
    {
      "span": {
        "start": 31107,
        "end": 31115
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 31333,
        "end": 31342
      },
      "text": "བསྒོམས་པ་ ༼སྣར། པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 31446,
        "end": 31456
      },
      "text": "འདུ་ཤེས་པ་ ༼སྣར། པེ།༽ འདུ་ཤེས་པ་ལ་"
    },
    {
      "span": {
        "start": 31493,
        "end": 31498
      },
      "text": "བསླང་ ༼སྣར། པེ།༽ སླང་"
    },
    {
      "span": {
        "start": 31552,
        "end": 31565
      },
      "text": "ཕྱིར་བཤད་ཀྱི། ༼སྣར། པེ།༽ ཕྱིར་བཤགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 31763,
        "end": 31771
      },
      "text": "ལས་ཀྱང་། ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 31914,
        "end": 31917
      },
      "text": "པར་ ༼སྣར། པེ།༽ པས་"
    },
    {
      "span": {
        "start": 31973,
        "end": 31981
      },
      "text": "བཤད་ཀྱི། ༼སྣར། པེ།༽ བཤད་ཀྱིས།"
    },
    {
      "span": {
        "start": 32136,
        "end": 32138
      },
      "text": "པ་ ༼སྣར། པེ།༽ པས་"
    },
    {
      "span": {
        "start": 32188,
        "end": 32197
      },
      "text": "སྤྱོད་པར་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 32259,
        "end": 32262
      },
      "text": "སུ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 32297,
        "end": 32303
      },
      "text": "བསྙེན་ ༼སྣར། པེ།༽ སྙེན་"
    },
    {
      "span": {
        "start": 32345,
        "end": 32365
      },
      "text": "བསྐལ་པར་ཡང་བརྗོད་པར་ ༼སྣར། པེ།༽ བསྐལ་པར་ཡང་"
    },
    {
      "span": {
        "start": 32509,
        "end": 32517
      },
      "text": "འདས་ཀྱི་ ༼སྣར། པེ།༽ འདས་ཀྱིས་"
    },
    {
      "span": {
        "start": 32525,
        "end": 32534
      },
      "text": "དགག་པར་མ་ ༼སྣར། པེ།༽ དགག་པར་"
    },
    {
      "span": {
        "start": 32709,
        "end": 32718
      },
      "text": "སེམས་དཔའ་ ༼སྣར།༽ སེམས་པ་"
    },
    {
      "span": {
        "start": 32757,
        "end": 32766
      },
      "text": "དེ་དག་དེ་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 33001,
        "end": 33007
      },
      "text": "སྦྱིན་ ༼སྣར། པེ།༽ བྱིན་"
    },
    {
      "span": {
        "start": 33021,
        "end": 33028
      },
      "text": "སྨིན་པ་ ༼སྣར། པེ།༽ སྨིན་པ་དེ་"
    },
    {
      "span": {
        "start": 33404,
        "end": 33413
      },
      "text": "སྤྱོད་པར་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 33487,
        "end": 33492
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 33717,
        "end": 33722
      },
      "text": "ཉེ་བ་ ༼སྣར། པེ།༽ ཉེ་བར་"
    },
    {
      "span": {
        "start": 33849,
        "end": 33856
      },
      "text": "སྩལ་ཏོ། ༼སྣར། པེ།༽ སྩལ་ཏེ།"
    },
    {
      "span": {
        "start": 33977,
        "end": 33992
      },
      "text": "རྫུ་འཕྲུལ་གྱིས་ ༼སྣར། པེ།༽ རྫུ་འཕྲུལ་གྱི་"
    },
    {
      "span": {
        "start": 34010,
        "end": 34016
      },
      "text": "བསྔགས་ ༼སྣར། པེ།༽ སྔགས་"
    },
    {
      "span": {
        "start": 34038,
        "end": 34053
      },
      "text": "རྫུ་འཕྲུལ་གྱིས་ ༼སྣར། པེ།༽ རྫུ་འཕྲུལ་གྱི་"
    },
    {
      "span": {
        "start": 34088,
        "end": 34097
      },
      "text": "ཕ་རོལ་ཏུ་ ༼སྣར། པེ།༽ ཕ་རོལ་"
    },
    {
      "span": {
        "start": 34148,
        "end": 34157
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 34200,
        "end": 34204
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 34213,
        "end": 34223
      },
      "text": "རྒྱུད་འདག་ ༼སྣར། པེ།༽ རྒྱུད་གསེར་དག་"
    },
    {
      "span": {
        "start": 34316,
        "end": 34322
      },
      "text": "ས་བཅུ་ ༼སྣར། པེ།༽ ས་བཅུ་པ་"
    },
    {
      "span": {
        "start": 34508,
        "end": 34518
      },
      "text": "སྩལ་པ་སྟེ། ༼སྣར། པེ།༽ སྩལ་ཏེ།"
    },
    {
      "span": {
        "start": 34550,
        "end": 34555
      },
      "text": "ལས་མ་ ༼སྣར། པེ།༽ ལ་མ་"
    },
    {
      "span": {
        "start": 34573,
        "end": 34581
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར། པེ།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 34621,
        "end": 34628
      },
      "text": "མེད་དེ། ༼སྣར། པེ།༽ མེད།"
    },
    {
      "span": {
        "start": 34668,
        "end": 34674
      },
      "text": "གང་ལས་ ༼སྣར། པེ།༽ གང་ནས་"
    },
    {
      "span": {
        "start": 34809,
        "end": 34842
      },
      "text": "སྦྱིན་པ་ལ་སོགས་པ་ཕ་རོལ་ཏུ་ཕྱིན་པ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 35435,
        "end": 35442
      },
      "text": "རེ་རེར་ ༼སྣར། པེ།༽ རེ་རེ་"
    },
    {
      "span": {
        "start": 35626,
        "end": 35635
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 35665,
        "end": 35675
      },
      "text": "བསྒྲུབས་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 35892,
        "end": 35899
      },
      "text": "གཞན་དག་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 36707,
        "end": 36713
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ སྟེན་"
    },
    {
      "span": {
        "start": 37034,
        "end": 37043
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 37057,
        "end": 37065
      },
      "text": "བཤད་ཀྱི། ༼སྣར། པེ།༽ བཤད་ཀྱིས།"
    },
    {
      "span": {
        "start": 37144,
        "end": 37150
      },
      "text": "ལྡན་པ་ ༼སྣར། པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 37225,
        "end": 37233
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 37237,
        "end": 37244
      },
      "text": "བཟུང་བ་ ༼སྣར། པེ།༽ གཟུང་བ་"
    },
    {
      "span": {
        "start": 37376,
        "end": 37385
      },
      "text": "བསྒོམ་པར་ ༼པེ།༽ སྒོམ་པར་"
    },
    {
      "span": {
        "start": 37454,
        "end": 37463
      },
      "text": "བརྩེགས་པ་ ༼སྣར། པེ།༽ རྩེགས་པ་"
    },
    {
      "span": {
        "start": 37591,
        "end": 37615
      },
      "text": "ཤེས་རབ་ཐབས་མཁས་པས་ཟིན་པ་ ༼སྣར། པེ།༽ ཐབས་མཁས་པས་"
    },
    {
      "span": {
        "start": 37695,
        "end": 37703
      },
      "text": "བསྟེན་ན་ ༼སྣར། པེ།༽ བསྟེན་ནས་"
    },
    {
      "span": {
        "start": 37757,
        "end": 37766
      },
      "text": "འདས་ཀྱིས་ ༼སྣར། པེ།༽ འདས་ཀྱི་"
    },
    {
      "span": {
        "start": 37861,
        "end": 37870
      },
      "text": "བརྟེན་པར་ ༼སྣར། པེ།༽ བསྟེན་པར་"
    },
    {
      "span": {
        "start": 37879,
        "end": 37888
      },
      "text": "གསུངས་སོ། ༼སྣར། པེ།༽ གསུངས་ཏེ།"
    },
    {
      "span": {
        "start": 37976,
        "end": 37985
      },
      "text": "འགྱུར་རོ། ༼སྣར། པེ།༽ འགྱུར་ཏེ།"
    },
    {
      "span": {
        "start": 37998,
        "end": 38006
      },
      "text": "དམིགས་པ་ ༼སྣར། པེ།༽ དམིགས་པ་ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 38316,
        "end": 38321
      },
      "text": "ལ་ཡང་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 38369,
        "end": 38379
      },
      "text": "དམིགས་པ་ལ་ ༼སྡེ།༽ དམིགས་པ་"
    },
    {
      "span": {
        "start": 38382,
        "end": 38388
      },
      "text": "བལྟའོ། ༼སྣར། པེ།༽ ལྟའོ།"
    },
    {
      "span": {
        "start": 38483,
        "end": 38487
      },
      "text": "དབང་ ༼པེ།༽ དབང་པོ་"
    },
    {
      "span": {
        "start": 38557,
        "end": 38583
      },
      "text": "དམིགས་པ་གང་ཅི་ཡང་རུང་། དེ་ ༼སྣར། པེ།༽ གང་ཅི་ཡང་རུངསྟེ་"
    },
    {
      "span": {
        "start": 38887,
        "end": 38892
      },
      "text": "ན་གང་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 39046,
        "end": 39053
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 39493,
        "end": 39496
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱའོ་"
    },
    {
      "span": {
        "start": 39518,
        "end": 39525
      },
      "text": "བསྟན་པ་ ༼པེ།༽ སྟན་པ་"
    },
    {
      "span": {
        "start": 39554,
        "end": 39561
      },
      "text": "ལྡན་པས་ ༼སྣར། པེ།༽ ལྡན་པར་"
    },
    {
      "span": {
        "start": 39734,
        "end": 39744
      },
      "text": "བསྐྱེད་ནས། ༼སྣར། པེ།༽ བསྐྱེད་ན།"
    },
    {
      "span": {
        "start": 40034,
        "end": 40040
      },
      "text": "བརྩོན། ༼སྣར། པེ།༽ རྩོན།"
    },
    {
      "span": {
        "start": 40401,
        "end": 40412
      },
      "text": "བསྒོམ་པ་རབ་ ༼སྣར། པེ།༽ སྒོམ་པ་ཤེས་རབ་"
    },
    {
      "span": {
        "start": 40420,
        "end": 40428
      },
      "text": "ཕྱིན་པར་ ༼སྣར། པེ།༽ ཕྱིན་པར་མ་"
    },
    {
      "span": {
        "start": 40516,
        "end": 40523
      },
      "text": "གསལ་བར་ ༼སྣར། པེ།༽ གསལ་བ་"
    },
    {
      "span": {
        "start": 40782,
        "end": 40788
      },
      "text": "ལུས་པ་ ༼སྣར། པེ།༽ ལུས་པར་"
    },
    {
      "span": {
        "start": 40795,
        "end": 40801
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 40980,
        "end": 40988
      },
      "text": "འདོད་པས་ ༼སྣར། པེ།༽ འདོད་པ་"
    },
    {
      "span": {
        "start": 41052,
        "end": 41060
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 41144,
        "end": 41167
      },
      "text": "ལ་སོགས་དྲི་མ་ཐག་བསྲིངས་ ༼སྣར། པེ།༽ དྲི་མ་མཐའ་སྲིངས་"
    },
    {
      "span": {
        "start": 41275,
        "end": 41277
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 41328,
        "end": 41333
      },
      "text": "ལྟུང་ ༼སྣར། པེ།༽ རླུང་"
    },
    {
      "span": {
        "start": 41348,
        "end": 41354
      },
      "text": "སྤོངས་ ༼སྣར། པེ།༽ སྤོང་"
    },
    {
      "span": {
        "start": 41409,
        "end": 41419
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ སྒོམ་པའི་"
    },
    {
      "span": {
        "start": 41442,
        "end": 41448
      },
      "text": "ཀ་མ་ལ་ ༼པེ།༽ ཀ་མ་"
    }
  ]
}