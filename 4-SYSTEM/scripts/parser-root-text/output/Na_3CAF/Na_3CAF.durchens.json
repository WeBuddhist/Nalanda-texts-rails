{
  "durchens": [
    {
      "span": {
        "start": 62,
        "end": 73
      },
      "text": "འདོད་འཇོ། ། ༼སྣར། པེ།༽ འདོད་འཇོའོ།། །།"
    },
    {
      "span": {
        "start": 631,
        "end": 643
      },
      "text": "རྣམས་འཇོ་བས་ ༼སྣར།༽ རྣམས་འཇོམས་ ༼པེ།༽ རྣམས་འཇོམ་"
    },
    {
      "span": {
        "start": 673,
        "end": 681
      },
      "text": "སྤྲོས་པ་ ༼སྣར། པེ།༽ སྤྲོས་པ་དང་"
    },
    {
      "span": {
        "start": 1166,
        "end": 1180
      },
      "text": "བྱ། །སྔགས་ཀུན་ ༼སྣར།༽ བྱ་ཞེས་བྱ་བ་ལས། །སྔགས་ཀུན་ ༼པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 1189,
        "end": 1203
      },
      "text": "ནི་སྦྱར་བར་བྱ་ ༼པེ།༽ ལས། །སྔགས་ཀུན་"
    },
    {
      "span": {
        "start": 1386,
        "end": 1392
      },
      "text": "པས་ནི་ ༼སྣར། པེ།༽ པས་"
    },
    {
      "span": {
        "start": 1943,
        "end": 1951
      },
      "text": "བསད་པ་ལ་ ༼སྣར། པེ།༽ བསད་པ་"
    },
    {
      "span": {
        "start": 1995,
        "end": 2005
      },
      "text": "བསྐྲད་པ་ལ་ ༼སྣར། པེ།༽ བསྐྲད་པ་"
    },
    {
      "span": {
        "start": 2073,
        "end": 2076
      },
      "text": "སྱ་ ༼སྣར། པེ།༽ སྱེ་"
    },
    {
      "span": {
        "start": 2183,
        "end": 2191
      },
      "text": "གདབ་པ་ལ་ ༼སྣར། པེ།༽ གདབ་པ་"
    },
    {
      "span": {
        "start": 2214,
        "end": 2218
      },
      "text": "སརྦ་ ༼སྣར། པེ།༽ སརྦན་"
    },
    {
      "span": {
        "start": 2261,
        "end": 2267
      },
      "text": "སྤར་བ་ ༼སྣར། པེ།༽ སྦྱར་བ་"
    },
    {
      "span": {
        "start": 2428,
        "end": 2436
      },
      "text": "རླུང་གི་ ༼སྣར། པེ།༽ རླུང་གིས་"
    },
    {
      "span": {
        "start": 2616,
        "end": 2618
      },
      "text": "ལ། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 2678,
        "end": 2681
      },
      "text": "ནི་ ༼སྣར།༽ ནི་དེ་"
    },
    {
      "span": {
        "start": 2938,
        "end": 2943
      },
      "text": "འཐོབ་ ༼སྣར། པེ།༽ ཐོབ་"
    },
    {
      "span": {
        "start": 3035,
        "end": 3043
      },
      "text": "སྟེང་དུ་ ༼སྣར། པེ།༽ སྟེང་"
    },
    {
      "span": {
        "start": 3102,
        "end": 3105
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 4431,
        "end": 4444
      },
      "text": "སྣ་གུང་གཡས་པ་ ༼སྣར། པེ།༽ སྣ་སྒོ་གཡས་"
    },
    {
      "span": {
        "start": 4641,
        "end": 4649
      },
      "text": "དྲངས་ཏེ་ ༼སྣར། པེ།༽ དྲངས་ན་"
    },
    {
      "span": {
        "start": 4745,
        "end": 4751
      },
      "text": "རང་གི་ ༼སྣར། པེ།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 5013,
        "end": 5021
      },
      "text": "ར་ད། ཀི་ ༼སྣར། པེ།༽ ར་དེ་ཀ་"
    },
    {
      "span": {
        "start": 5031,
        "end": 5034
      },
      "text": "ཀི་ ༼སྣར། པེ།༽ ཀཱི་"
    },
    {
      "span": {
        "start": 5145,
        "end": 5152
      },
      "text": "མ་ཧེ་ལ་ ༼སྣར། པེ།༽ མ་ཧེ་"
    },
    {
      "span": {
        "start": 5191,
        "end": 5193
      },
      "text": "ར་ ༼སྣར། པེ།༽ རི་"
    },
    {
      "span": {
        "start": 5196,
        "end": 5199
      },
      "text": "དེ་ ༼སྣར། པེ།༽ ད་"
    },
    {
      "span": {
        "start": 5296,
        "end": 5299
      },
      "text": "ཏེ། ༼སྣར། པེ།༽ ནོ། །"
    },
    {
      "span": {
        "start": 5370,
        "end": 5378
      },
      "text": "ཕྱག་མཚན་ ༼སྣར། པེ།༽ མཚོན་"
    },
    {
      "span": {
        "start": 5672,
        "end": 5679
      },
      "text": "བཟླས་པ་ ༼སྣར། པེ།༽ བཟླས་པས་"
    },
    {
      "span": {
        "start": 5721,
        "end": 5731
      },
      "text": "རི་ལུ་རུས་ ༼སྣར། པེ།༽ རི་ལུ་"
    },
    {
      "span": {
        "start": 6251,
        "end": 6259
      },
      "text": "ཞིང་བའི་ ༼སྣར། པེ།༽ ཞི་བའི་"
    },
    {
      "span": {
        "start": 6392,
        "end": 6402
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 6869,
        "end": 6872
      },
      "text": "སི་ ༼སྣར། པེ།༽ ས་"
    },
    {
      "span": {
        "start": 6883,
        "end": 6890
      },
      "text": "བྱ་བའོ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 6981,
        "end": 6992
      },
      "text": "འགྱུར་བ་དེ་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 7112,
        "end": 7116
      },
      "text": "ཁྲུ་ ༼སྣར། པེ།༽ ཁྲུས་"
    },
    {
      "span": {
        "start": 7168,
        "end": 7175
      },
      "text": "བསྲེགས་ ༼སྣར། པེ།༽ སྲེགས་"
    },
    {
      "span": {
        "start": 7349,
        "end": 7355
      },
      "text": "སྒྲིབ་ ༼སྣར། པེ།༽ སྒྲིབས་"
    },
    {
      "span": {
        "start": 7599,
        "end": 7606
      },
      "text": "བཀྲམ་པ་ ༼སྣར། པེ།༽ བཀྲི་བ་"
    },
    {
      "span": {
        "start": 7972,
        "end": 7977
      },
      "text": "རྒྱན་ ༼སྣར། པེ།༽ བརྒྱན་"
    },
    {
      "span": {
        "start": 8049,
        "end": 8058
      },
      "text": "དཀར་པོའི་ ༼སྣར། པེ།༽ དཀར་མོའི་"
    },
    {
      "span": {
        "start": 8376,
        "end": 8381
      },
      "text": "བཀྱེ་ ༼སྣར། པེ།༽ བཙེས་"
    },
    {
      "span": {
        "start": 8569,
        "end": 8578
      },
      "text": "ཆེན་མོའི་ ༼སྣར། པེ།༽ ཆེན་པོའི་"
    },
    {
      "span": {
        "start": 8784,
        "end": 8789
      },
      "text": "ཁྱིམ་ ༼སྣར། པེ།༽ ཁྱི་"
    },
    {
      "span": {
        "start": 8822,
        "end": 8827
      },
      "text": "སྦྱར་ ༼སྣར། པེ།༽ སྦྱོར་"
    },
    {
      "span": {
        "start": 8882,
        "end": 8887
      },
      "text": "བདུག་ ༼སྣར། པེ།༽ བདུགས་"
    },
    {
      "span": {
        "start": 8922,
        "end": 8926
      },
      "text": "ཀླད་ ༼སྣར། པེ།༽ གླད་"
    },
    {
      "span": {
        "start": 9003,
        "end": 9020
      },
      "text": "དང་འབྲུ་ཕྲན་ཚེགས་ ༼སྣར། པེ།༽ དང་འབྲུམ་"
    },
    {
      "span": {
        "start": 9175,
        "end": 9187
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 9358,
        "end": 9363
      },
      "text": "བསྐུ་ ༼སྣར། པེ།༽ སྐྲ་"
    },
    {
      "span": {
        "start": 9463,
        "end": 9468
      },
      "text": "ཧི་ན་ ༼སྣར། པེ།༽ ཧ་ནཱི་"
    },
    {
      "span": {
        "start": 9485,
        "end": 9489
      },
      "text": "ས་བ་ ༼སྣར། པེ།༽ ས་པ་བ་"
    },
    {
      "span": {
        "start": 9506,
        "end": 9515
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་བྱ་"
    },
    {
      "span": {
        "start": 9946,
        "end": 9954
      },
      "text": "རྫོགས་པ་ ༼སྣར། པེ།༽ རྫོགས་པར་"
    },
    {
      "span": {
        "start": 10939,
        "end": 10946
      },
      "text": "རི་བོང་ ༼སྣར། པེ།༽ རི་མོ་"
    },
    {
      "span": {
        "start": 10950,
        "end": 10953
      },
      "text": "གི་ ༼པེ།༽ གིས་"
    },
    {
      "span": {
        "start": 11828,
        "end": 11835
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 11840,
        "end": 11852
      },
      "text": "དཔྲལ་བར་བྲི་ ༼སྣར།༽ དཔྲལ་བར་ ༼པེ།༽ དཔྲལ་བ་"
    },
    {
      "span": {
        "start": 11970,
        "end": 11975
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ ཆུ་"
    },
    {
      "span": {
        "start": 12501,
        "end": 12513
      },
      "text": "ན་ཁ་འཆིང་བར་ ༼སྣར། པེ།༽ ན་བཅིངས་པར་"
    },
    {
      "span": {
        "start": 12575,
        "end": 12583
      },
      "text": "འཆིང་བར་ ༼སྣར། པེ།༽ བཅིངས་པར་"
    },
    {
      "span": {
        "start": 12648,
        "end": 12652
      },
      "text": "མཐར་ ༼སྣར། པེ།༽ མཐའ་"
    },
    {
      "span": {
        "start": 12669,
        "end": 12674
      },
      "text": "འདིས། ༼སྣར། པེ།༽ ནིས།"
    },
    {
      "span": {
        "start": 13788,
        "end": 13795
      },
      "text": "སོ་སོར་ ༼པེ།༽ སོ་སོ་"
    },
    {
      "span": {
        "start": 13925,
        "end": 13940
      },
      "text": "དཀར་པོས་མགུལ་པ་ ༼སྣར། པེ།༽ དཀར་པོས་"
    },
    {
      "span": {
        "start": 14188,
        "end": 14195
      },
      "text": "བསམ་མོ། ༼སྣར།༽ བསམས་མོ ༼པེ།༽ བསམས་སོ།"
    },
    {
      "span": {
        "start": 14695,
        "end": 14701
      },
      "text": "ས་ཏྱེ་ ༼སྣར། པེ།༽ སད་དྱེ་"
    },
    {
      "span": {
        "start": 14781,
        "end": 14795
      },
      "text": "པའི་མཐེ་བོངའམ། ༼སྣར། པེ།༽ པའི་ཐོ་བའམ་"
    },
    {
      "span": {
        "start": 14842,
        "end": 14850
      },
      "text": "ཁྱེའུའམ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 15052,
        "end": 15057
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བ་ལ་"
    },
    {
      "span": {
        "start": 15138,
        "end": 15142
      },
      "text": "ལྕི་ ༼སྣར། པེ།༽ གཙོ་"
    },
    {
      "span": {
        "start": 15403,
        "end": 15409
      },
      "text": "ཀེ་ཤེ་ ༼སྣར། པེ།༽ ཀེ་ཤི་"
    },
    {
      "span": {
        "start": 15784,
        "end": 15790
      },
      "text": "ཨུརྣེ་ ༼པེ།༽ ཨཪྣ་"
    },
    {
      "span": {
        "start": 16116,
        "end": 16125
      },
      "text": "མཐུག་པོས་ ༼སྣར། པེ།༽ འཐུག་པོས་"
    },
    {
      "span": {
        "start": 16143,
        "end": 16148
      },
      "text": "གཉིད་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 16195,
        "end": 16200
      },
      "text": "མེ་ད་ ༼སྣར། པེ།༽ མེ་"
    },
    {
      "span": {
        "start": 16306,
        "end": 16309
      },
      "text": "རང་ ༼སྣར། པེ།༽ རང་གི་"
    },
    {
      "span": {
        "start": 16419,
        "end": 16423
      },
      "text": "སྐུ་ ༼སྣར། པེ།༽ དྲི་"
    },
    {
      "span": {
        "start": 16494,
        "end": 16499
      },
      "text": "ཐོ་བ་ ༼སྣར། པེ།༽ ཐོད་པ་"
    },
    {
      "span": {
        "start": 16759,
        "end": 16767
      },
      "text": "ཛཱ་ཏིའི་ ༼སྣར། པེ།༽ ཛཱ་ཏི་"
    },
    {
      "span": {
        "start": 17071,
        "end": 17074
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 17118,
        "end": 17125
      },
      "text": "ཏེ་སོས་ ༼སྣར། པེ།༽ ཏེ་སོ་"
    },
    {
      "span": {
        "start": 17229,
        "end": 17236
      },
      "text": "བྱེད་པ་ ༼སྣར། པེ།༽ བྱེད་པར་"
    },
    {
      "span": {
        "start": 17897,
        "end": 17906
      },
      "text": "ཤིང་རྩ་བ་ ༼སྣར། པེ།༽ ཤིང་རྩད་"
    },
    {
      "span": {
        "start": 17936,
        "end": 17948
      },
      "text": "ཞབས་དྲུང་དུ་ ༼སྣར། པེ།༽ ཞབས་དྲུང་ན་"
    },
    {
      "span": {
        "start": 18090,
        "end": 18093
      },
      "text": "ཆེ་ ༼སྣར། པེ།༽ ཧྲི་ཆེ་"
    },
    {
      "span": {
        "start": 18124,
        "end": 18127
      },
      "text": "རེ་ ༼སྣར། པེ།༽ རེ་ན་"
    },
    {
      "span": {
        "start": 18308,
        "end": 18317
      },
      "text": "འགྱུར་རོ་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 18566,
        "end": 18574
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 18803,
        "end": 18810
      },
      "text": "བྱ་བའོ། ༼ཅོ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 18831,
        "end": 18838
      },
      "text": "དཀར་པོ་ ༼སྣར། པེ།༽ དཀར་པོའི་"
    },
    {
      "span": {
        "start": 19116,
        "end": 19121
      },
      "text": "གྲངས་ ༼སྣར། པེ།༽ གྲགས་"
    },
    {
      "span": {
        "start": 19745,
        "end": 19748
      },
      "text": "ཟླ་ ༼སྣར། པེ།༽ ཟླ་བ་"
    },
    {
      "span": {
        "start": 19844,
        "end": 19850
      },
      "text": "བཀྲོལ་ ༼སྣར། པེ།༽ དཀྲོལ་"
    },
    {
      "span": {
        "start": 20298,
        "end": 20302
      },
      "text": "པའོ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 20575,
        "end": 20582
      },
      "text": "བཟུང་བ་ ༼སྣར། པེ།༽ གཟུང་བ་"
    },
    {
      "span": {
        "start": 21356,
        "end": 21369
      },
      "text": "མི་དབང་གི་ནི་ ༼སྣར། པེ།༽ མི་དབང་གི་"
    },
    {
      "span": {
        "start": 21714,
        "end": 21724
      },
      "text": "བདུན་བདུན་ ༼སྣར། པེ།༽ བདུན་"
    },
    {
      "span": {
        "start": 21849,
        "end": 21857
      },
      "text": "དྲུག་ཏུ་ ༼སྣར། པེ།༽ དྲུག་"
    },
    {
      "span": {
        "start": 22090,
        "end": 22099
      },
      "text": "རྐང་པ་དང་ ༼སྣར། པེ།༽ རྐང་པ་"
    },
    {
      "span": {
        "start": 23022,
        "end": 23031
      },
      "text": "བསྲེག་པས་ ༼སྣར། པེ།༽ བསྲེགས་པས་"
    },
    {
      "span": {
        "start": 23080,
        "end": 23085
      },
      "text": "ཀརྟི་ ༼སྣར། པེ།༽ རག་ཏི་"
    },
    {
      "span": {
        "start": 23296,
        "end": 23303
      },
      "text": "དང་པོར་ ༼སྣར། པེ།༽ དང་པོ་"
    },
    {
      "span": {
        "start": 23579,
        "end": 23583
      },
      "text": "བཟང་ ༼སྣར། པེ།༽ བཟངས་"
    },
    {
      "span": {
        "start": 23649,
        "end": 23657
      },
      "text": "སྦྱོར་བ་ ༼སྣར། པེ།༽ སྦྱོར་བ་ནི་"
    },
    {
      "span": {
        "start": 23768,
        "end": 23771
      },
      "text": "གང་ ༼སྣར། པེ།༽ གང་ཡང་"
    },
    {
      "span": {
        "start": 24013,
        "end": 24017
      },
      "text": "བཟང་ ༼སྣར། པེ།༽ བཟངས་"
    },
    {
      "span": {
        "start": 24160,
        "end": 24166
      },
      "text": "སྦྱོར་ ༼སྣར། པེ།༽ སྦྱར་"
    },
    {
      "span": {
        "start": 24446,
        "end": 24452
      },
      "text": "འགྱུར། ༼སྣར། པེ།༽ འགྱུར་རོ།"
    },
    {
      "span": {
        "start": 24586,
        "end": 24591
      },
      "text": "གནག ། ༼སྣར། པེ།༽ གནས། །"
    },
    {
      "span": {
        "start": 24599,
        "end": 24603
      },
      "text": "སེང་ ༼སྣར། པེ།༽ སེན་"
    },
    {
      "span": {
        "start": 24622,
        "end": 24626
      },
      "text": "ཅེས་ ༼སྣར། པེ།༽ བསྡུས་ཞེས་"
    },
    {
      "span": {
        "start": 24670,
        "end": 24676
      },
      "text": "བྱ་བས་ ༼སྣར། པེ།༽ བྱས་པས་"
    },
    {
      "span": {
        "start": 24963,
        "end": 24968
      },
      "text": "སྡུད་ ༼སྣར། པེ།༽ བསྡུད་"
    },
    {
      "span": {
        "start": 25181,
        "end": 25190
      },
      "text": "རྨིག་པའི་ ༼སྣར། པེ།༽ རྨིག་པས་"
    },
    {
      "span": {
        "start": 25207,
        "end": 25223
      },
      "text": "རྨིག་པ་གཞན་གྱིས་ ༼སྣར། པེ།༽ རྨིག་པས་ཞན་གྱི་"
    },
    {
      "span": {
        "start": 25231,
        "end": 25237
      },
      "text": "བཀབ་པ་ ༼སྣར། པེ།༽ བཏབ་པ་"
    },
    {
      "span": {
        "start": 25237,
        "end": 25259
      },
      "text": "པ་ལ་དུ་བ་བཏང་སྟེ་དུ་བ་ ༼སྣར། པེ།༽ ལ་དུ་བ་"
    },
    {
      "span": {
        "start": 25360,
        "end": 25363
      },
      "text": "རེ་ ༼སྣར། པེ།༽ རི་"
    },
    {
      "span": {
        "start": 25517,
        "end": 25522
      },
      "text": "ད་ནེ་ ༼སྣར། པེ།༽ ད་"
    },
    {
      "span": {
        "start": 25522,
        "end": 25524
      },
      "text": "ན་ ༼སྣར། པེ།༽ ན་ནེ་"
    },
    {
      "span": {
        "start": 25535,
        "end": 25537
      },
      "text": "མ་ ༼སྣར། པེ།༽ མ་ས་"
    },
    {
      "span": {
        "start": 26048,
        "end": 26058
      },
      "text": "བསྲུབ་ཤིང་ ༼སྣར། པེ།༽ སྲུབས་ཤིང་"
    },
    {
      "span": {
        "start": 26290,
        "end": 26298
      },
      "text": "བཞི་ཡིས་ ༼སྣར། པེ།༽ བཞི་ཡི་"
    },
    {
      "span": {
        "start": 26715,
        "end": 26724
      },
      "text": "དང་བཅས་པ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 26797,
        "end": 26806
      },
      "text": "སྲེག་བྱས་ ༼སྣར། པེ།༽ བསྲེག་བྱས་"
    },
    {
      "span": {
        "start": 27330,
        "end": 27337
      },
      "text": "ཨུ་མའི་ ༼སྣར།༽ ཨུ་མིའི་"
    },
    {
      "span": {
        "start": 27356,
        "end": 27360
      },
      "text": "བཟླ། ༼སྡེ། ཅོ།༽ བཟླས།"
    },
    {
      "span": {
        "start": 27401,
        "end": 27409
      },
      "text": "སྐོང་བར་ ༼སྣར། པེ།༽ བསྐོང་བར་"
    },
    {
      "span": {
        "start": 27901,
        "end": 27906
      },
      "text": "འགོས་ ༼སྣར། པེ།༽ མགོས་"
    }
  ]
}