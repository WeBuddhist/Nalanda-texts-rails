{
  "durchens": [
    {
      "span": {
        "start": 36,
        "end": 41
      },
      "text": "ཀུལླ་ ༼སྣར།༽ ལེ་ ༼པེ།༽ ཀུལླེ་"
    },
    {
      "span": {
        "start": 63,
        "end": 70
      },
      "text": "རྟོག་པ་ ༼སྣར།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 89,
        "end": 94
      },
      "text": "རིགས་ ༼སྣར།༽ རིག་"
    },
    {
      "span": {
        "start": 94,
        "end": 103
      },
      "text": "བྱེད་མའི་ ༼པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 124,
        "end": 129
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིག་"
    },
    {
      "span": {
        "start": 209,
        "end": 217
      },
      "text": "ཅི་བགྱི་ ༼སྣར།༽ ཅི་གྱིས་"
    },
    {
      "span": {
        "start": 246,
        "end": 253
      },
      "text": "འཚལ་ནས། ༼སྣར།༽ འཚལ་ལོ།"
    },
    {
      "span": {
        "start": 255,
        "end": 261
      },
      "text": "དང་པོ་ ༼སྣར། པེ།༽ དང་པོར་"
    },
    {
      "span": {
        "start": 291,
        "end": 296
      },
      "text": "མཐུན་ ༼སྣར།༽ འཐུན་"
    },
    {
      "span": {
        "start": 558,
        "end": 566
      },
      "text": "སྔོན་དུ་ ༼སྣར།༽ མངོན་དུ་"
    },
    {
      "span": {
        "start": 575,
        "end": 585
      },
      "text": "རིགས་བྱེད་ ༼སྣར།༽ རིག་བྱེད་"
    },
    {
      "span": {
        "start": 589,
        "end": 594
      },
      "text": "རི་ལ་ ༼སྣར།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 602,
        "end": 612
      },
      "text": "རིགས་བྱེད་ ༼སྣར།༽ རིག་བྱེད་"
    },
    {
      "span": {
        "start": 697,
        "end": 703
      },
      "text": "ས་བོན་ ༼སྣར།༽ ས་བོན་གྱིས་འོད་"
    },
    {
      "span": {
        "start": 793,
        "end": 799
      },
      "text": "བཙལ་བ་ ༼པེ།༽ འཚལ་བ་"
    },
    {
      "span": {
        "start": 982,
        "end": 989
      },
      "text": "སོ་སོར་ ༼སྣར།༽ སོའི་སོ་"
    },
    {
      "span": {
        "start": 1049,
        "end": 1060
      },
      "text": "ཀྱིས་གཟུང་། ༼སྣར།༽ ཀྱི་བཟུང་།"
    },
    {
      "span": {
        "start": 1062,
        "end": 1066
      },
      "text": "ཞེས་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 1069,
        "end": 1078
      },
      "text": "གསུམ་གྱི་ ༼སྣར།༽ གསུམ་གྱིས་"
    },
    {
      "span": {
        "start": 1152,
        "end": 1163
      },
      "text": "སྟོང་པ་ཉིད་ ༼སྣར།༽ སྟོང་པ་"
    },
    {
      "span": {
        "start": 1167,
        "end": 1176
      },
      "text": "པར་བསྒོམ་ ༼སྣར།༽ པར་ཉིད་བསྒོམས་"
    },
    {
      "span": {
        "start": 1186,
        "end": 1192
      },
      "text": "དེ་ནས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 1197,
        "end": 1202
      },
      "text": "གྱིས་ ༼སྣར།༽ གྱི་"
    },
    {
      "span": {
        "start": 1308,
        "end": 1315
      },
      "text": "མཐའ་དག་ ༼སྣར།༽ མཐའ་དག་ལ་"
    },
    {
      "span": {
        "start": 1345,
        "end": 1355
      },
      "text": "ས་བོན་གྱི་ ༼སྣར།༽ ས་བོན་གྱིས་"
    },
    {
      "span": {
        "start": 1418,
        "end": 1434
      },
      "text": "དབྱངས་ཡིག་དང་པོ་ ༼སྣར། པེ།༽ དབྱངས་ཡིག་"
    },
    {
      "span": {
        "start": 1466,
        "end": 1476
      },
      "text": "ས་བོན་གྱི་ ༼སྣར།༽ ས་བོན་གྱིས་"
    },
    {
      "span": {
        "start": 1584,
        "end": 1591
      },
      "text": "དྲངས་ལ་ ༼སྣར།༽ དྲངས་"
    },
    {
      "span": {
        "start": 1697,
        "end": 1703
      },
      "text": "བཞུགས་ ༼སྣར།༽ ཞུགས་"
    },
    {
      "span": {
        "start": 1775,
        "end": 1783
      },
      "text": "རྣ་རྒྱན་ ༼སྣར།༽ བརྒྱན་པ་"
    },
    {
      "span": {
        "start": 1797,
        "end": 1802
      },
      "text": "རྒྱན་ ༼སྣར།༽ བརྒྱན་"
    },
    {
      "span": {
        "start": 1855,
        "end": 1857
      },
      "text": "པ་ ༼སྣར། པེ།༽ པས་"
    },
    {
      "span": {
        "start": 1915,
        "end": 1917
      },
      "text": "ལ་ ༼སྣར།༽ ཨུད་པ་"
    },
    {
      "span": {
        "start": 1936,
        "end": 1940
      },
      "text": "དཔག་ ༼སྣར།༽ དཔག་ཏུ་"
    },
    {
      "span": {
        "start": 1961,
        "end": 1971
      },
      "text": "རིགས་བྱེད་ ༼སྣར།༽ རིག་བྱེད་"
    },
    {
      "span": {
        "start": 2004,
        "end": 2011
      },
      "text": "མགོ་བོ་ ༼སྣར།༽ མགོ་"
    },
    {
      "span": {
        "start": 2088,
        "end": 2101
      },
      "text": "འཕེལ་བའི་དབང་ ༼སྣར། པེ།༽ འཕེལ་བ་"
    },
    {
      "span": {
        "start": 2175,
        "end": 2179
      },
      "text": "ཚིག་ ༼སྣར།༽ ཚིགས་"
    },
    {
      "span": {
        "start": 2213,
        "end": 2221
      },
      "text": "ཙམ་གྱིས་ ༼སྣར།༽ ཙམ་གྱི་"
    },
    {
      "span": {
        "start": 2250,
        "end": 2261
      },
      "text": "ལ་ཡང་དག་པར་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 2270,
        "end": 2280
      },
      "text": "དམ་ཚིག་གི་ ༼སྣར།༽ དམ་ཚིག་"
    },
    {
      "span": {
        "start": 2295,
        "end": 2300
      },
      "text": "གཞུག་ ༼སྣར།༽ གཞུགས་"
    },
    {
      "span": {
        "start": 2412,
        "end": 2417
      },
      "text": "མཛུབ་ ༼སྣར།༽ འཛུབ་"
    },
    {
      "span": {
        "start": 2450,
        "end": 2459
      },
      "text": "མཐེབ་ཆེན་ ༼སྣར། པེ།༽ མཐེབ་མོ་"
    },
    {
      "span": {
        "start": 2459,
        "end": 2464
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ གཉིས་ཕྱེད་"
    },
    {
      "span": {
        "start": 2475,
        "end": 2477
      },
      "text": "པ་ ༼སྣར།༽ ལ་"
    },
    {
      "span": {
        "start": 2538,
        "end": 2547
      },
      "text": "རྡོ་རྗེས་ ༼སྣར།༽ རྡོ་རྗེ་ཕྱག་རྒྱ་"
    },
    {
      "span": {
        "start": 2595,
        "end": 2605
      },
      "text": "བསྲུང་བའི་ ༼སྣར།༽ སྲུང་བའི་"
    },
    {
      "span": {
        "start": 2639,
        "end": 2641
      },
      "text": "ལ་ ༼སྣར། པེ།༽ གསོལ་"
    },
    {
      "span": {
        "start": 2669,
        "end": 2675
      },
      "text": "བསྐུར་ ༼སྣར།༽ སྐུར་"
    },
    {
      "span": {
        "start": 2734,
        "end": 2742
      },
      "text": "ཀུན་གྱི་ ༼སྣར། པེ།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 2746,
        "end": 2755
      },
      "text": "གསུམ་གྱི། ༼སྣར།༽ གསུམ་གྱིས།"
    },
    {
      "span": {
        "start": 2884,
        "end": 2891
      },
      "text": "བསམ་པར་ ༼སྣར།༽ བསམས་པར་"
    },
    {
      "span": {
        "start": 3090,
        "end": 3094
      },
      "text": "རིམ་ ༼སྣར།༽ གོ་རིམས་"
    },
    {
      "span": {
        "start": 3177,
        "end": 3183
      },
      "text": "བསམ་པ་ ༼སྣར།༽ བསམ་གཏན་"
    },
    {
      "span": {
        "start": 3205,
        "end": 3214
      },
      "text": "བསྒོམ་པར་ ༼སྣར།༽ བསྒོམས་པར་"
    },
    {
      "span": {
        "start": 3214,
        "end": 3220
      },
      "text": "བྱས་ན་ ༼སྣར།༽ བྱས་ནས་"
    },
    {
      "span": {
        "start": 3585,
        "end": 3590
      },
      "text": "རོ། ། ༼སྣར། པེ།༽ ། །ཟླ་བ་"
    },
    {
      "span": {
        "start": 3597,
        "end": 3605
      },
      "text": "ལ་ལྷ་དང་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 3625,
        "end": 3627
      },
      "text": "པ་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 3685,
        "end": 3692
      },
      "text": "བསྒོམས་ ༼སྣར།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 3707,
        "end": 3716
      },
      "text": "ཀྱིས་འཚོ་ ༼སྣར།༽ ཀྱིས་འཚེ་ ༼པེ།༽ ཀྱི་འཚེ་"
    },
    {
      "span": {
        "start": 3773,
        "end": 3784
      },
      "text": "འདས་མ་སྒོམ་ ༼སྣར།༽ འདས་མ་བསྒོམ་ ༼པེ།༽ འདས་བསྒོམ་"
    },
    {
      "span": {
        "start": 3848,
        "end": 3852
      },
      "text": "མིག་ ༼སྣར།༽ སྨིག་"
    },
    {
      "span": {
        "start": 3928,
        "end": 3934
      },
      "text": "ལེན་པ་ ༼སྣར།༽ ལེན་"
    },
    {
      "span": {
        "start": 3988,
        "end": 3990
      },
      "text": "པ་ ༼སྣར།༽ པའི་དངོས་གྲུབ་"
    },
    {
      "span": {
        "start": 4065,
        "end": 4074
      },
      "text": "བཅིང་སྟེ། ༼སྣར།༽ བཅིངས་ཏེ།"
    },
    {
      "span": {
        "start": 4116,
        "end": 4124
      },
      "text": "དྲུག་གི་ ༼སྣར།༽ དྲུག་གིས་"
    },
    {
      "span": {
        "start": 4179,
        "end": 4186
      },
      "text": "འབར་ཏེ་ ༼སྣར།༽ འབར་སྟེ་"
    },
    {
      "span": {
        "start": 4328,
        "end": 4336
      },
      "text": "སྒྲུབ་པ་ ༼སྣར།༽ གྲུབ་པ་"
    },
    {
      "span": {
        "start": 4403,
        "end": 4413
      },
      "text": "། ན་བ་དང་། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 4430,
        "end": 4444
      },
      "text": "འཇིག་རྟེན་གྱི་ ༼སྣར།༽ འཇིག་རྟེན་གྱིས་"
    },
    {
      "span": {
        "start": 4455,
        "end": 4459
      },
      "text": "སོང་ ༼སྣར། པེ།༽ སོང་སོང་"
    },
    {
      "span": {
        "start": 4498,
        "end": 4504
      },
      "text": "གཟུངས་ ༼སྣར།༽ གཟུགས་"
    },
    {
      "span": {
        "start": 4604,
        "end": 4614
      },
      "text": "ཀླུ་སྒྲུབ་ ༼སྣར།༽ ཀླུ་གྲུབ་ ༼པེ།༽ ཀླུའི་སྒྲུབ་"
    }
  ]
}