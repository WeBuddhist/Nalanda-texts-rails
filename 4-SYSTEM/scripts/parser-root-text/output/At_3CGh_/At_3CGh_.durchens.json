{
  "durchens": [
    {
      "span": {
        "start": 472,
        "end": 476
      },
      "text": "དང་། ༼པེ།༽ དང་། བདུན་པ་སྟེ་"
    },
    {
      "span": {
        "start": 695,
        "end": 700
      },
      "text": "བསྟན་ ༼པེ།༽ བསྟོན་"
    },
    {
      "span": {
        "start": 877,
        "end": 887
      },
      "text": "ནས་མདུན་ན་ ༼པེ།༽ ནས་"
    },
    {
      "span": {
        "start": 1164,
        "end": 1168
      },
      "text": "བསང་ ༼པེ།༽ བསད་"
    },
    {
      "span": {
        "start": 1523,
        "end": 1527
      },
      "text": "བྱས་ ༼པེ།༽ བྱས་བྱེད་དུ་བཅུག་པ་"
    },
    {
      "span": {
        "start": 1553,
        "end": 1562
      },
      "text": "མོས་ཀྱིས་ ༼པེ།༽ མོས་ཀྱི་"
    },
    {
      "span": {
        "start": 2246,
        "end": 2250
      },
      "text": "ཐོབ་ ༼པེ།༽ ཐོས་"
    },
    {
      "span": {
        "start": 2253,
        "end": 2264
      },
      "text": "དཀྱིལ་འཁོར་ ༼པེ།༽ དཀྱིལ་འཁོར་ལས་"
    },
    {
      "span": {
        "start": 2464,
        "end": 2470
      },
      "text": "བསྟོན་ ༼པེ།༽ སྟོན་"
    },
    {
      "span": {
        "start": 2783,
        "end": 2787
      },
      "text": "རིག་ ༼པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 3058,
        "end": 3062
      },
      "text": "བསམ་ ༼པེ།༽ བསམས་"
    }
  ]
}