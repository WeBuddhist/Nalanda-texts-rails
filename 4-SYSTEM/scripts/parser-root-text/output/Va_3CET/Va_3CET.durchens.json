{
  "durchens": [
    {
      "span": {
        "start": 20,
        "end": 24
      },
      "text": "ཏའི་ ༼སྣར། པེ།༽ ཏཱའི་"
    },
    {
      "span": {
        "start": 416,
        "end": 423
      },
      "text": "ཆོས་སོ། ༼སྣར། པེ།༽ ཆོས་དང་།"
    },
    {
      "span": {
        "start": 471,
        "end": 482
      },
      "text": "ཕན་ཚུན་ལྡན་ ༼སྣར། པེ།༽ ཕན་ཚུན་"
    },
    {
      "span": {
        "start": 496,
        "end": 501
      },
      "text": "མངོན་ ༼སྣར། པེ།༽ མངོན་སུམ་"
    },
    {
      "span": {
        "start": 629,
        "end": 641
      },
      "text": "ངོ་བོ་བརྒྱད་ ༼སྣར། པེ།༽ ངོ་བོ་"
    },
    {
      "span": {
        "start": 1217,
        "end": 1226
      },
      "text": "ངེས་པ་ལྔ་ ༼པེ།༽ ངེས་པ་"
    },
    {
      "span": {
        "start": 1361,
        "end": 1367
      },
      "text": "ཡོད་པ་ ༼པེ།༽ ཆད་པ་"
    },
    {
      "span": {
        "start": 1713,
        "end": 1720
      },
      "text": "འཚིག་པ་ ༼སྣར།༽ འཆིག་པ་"
    },
    {
      "span": {
        "start": 1725,
        "end": 1731
      },
      "text": "འཆབ་པ་ ༼པེ།༽ འཆི་བ་"
    },
    {
      "span": {
        "start": 1760,
        "end": 1765
      },
      "text": "སྒྱུ་ ༼སྣར། པེ།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 1972,
        "end": 1980
      },
      "text": "འགྱུར་བ་ ༼སྣར།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 2429,
        "end": 2437
      },
      "text": "འདུ་ཤེས་ ༼སྣར། པེ།༽ འདུ་ཤེས་མེད་"
    },
    {
      "span": {
        "start": 2444,
        "end": 2451
      },
      "text": "འགོག་པ་ ༼སྣར།༽ འགོག་པའི་"
    },
    {
      "span": {
        "start": 2489,
        "end": 2509
      },
      "text": "ཚིག་གི་ཚོགས་དང་། ཡི་ ༼སྣར།༽ ཡི་"
    },
    {
      "span": {
        "start": 2649,
        "end": 2654
      },
      "text": "རིམས་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 2716,
        "end": 2724
      },
      "text": "སྤྱོད་པ་ ༼སྣར། པེ།༽ སྤྱོད་པའི་"
    },
    {
      "span": {
        "start": 2727,
        "end": 2736
      },
      "text": "མཐུན་པའི་ ༼སྣར།༽ ཐུན་པའི་"
    },
    {
      "span": {
        "start": 2979,
        "end": 2987
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 3224,
        "end": 3227
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 3237,
        "end": 3253
      },
      "text": "དབྱིག་གཉེན་གྱིས་ ༼སྣར།༽ དབྱིག་གཉེན་གྱི་"
    },
    {
      "span": {
        "start": 3257,
        "end": 3260
      },
      "text": "པར་ ༼སྣར། པེ།༽ པ་"
    }
  ]
}