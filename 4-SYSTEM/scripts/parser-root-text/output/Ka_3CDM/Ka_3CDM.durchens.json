{
  "durchens": [
    {
      "span": {
        "start": 181,
        "end": 203
      },
      "text": "ནས་ཉོན་མོངས་པ་མ་ལུས་པ་ ༼ཅོ།༽ ཉོན་མོངས་པ་ལུས་པ་་པ་ལུས་པ་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 249,
        "end": 258
      },
      "text": "ཕྱིར་འདི་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 365,
        "end": 373
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 2011,
        "end": 2014
      },
      "text": "ནི། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 2805,
        "end": 2813
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར། པེ།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 3631,
        "end": 3640
      },
      "text": "དོན་དམ་པ་ ༼སྣར། པེ།༽ དོན་དམ་"
    },
    {
      "span": {
        "start": 3881,
        "end": 3888
      },
      "text": "ཡིན་པར་ ༼སྣར། པེ།༽ ཡིན་པས་"
    },
    {
      "span": {
        "start": 4063,
        "end": 4070
      },
      "text": "བཀྲམ་པ་ ༼སྣར།༽ དཀྲམ་པ་"
    },
    {
      "span": {
        "start": 4074,
        "end": 4082
      },
      "text": "འདུག་པར་ ༼སྣར།༽ འདུག་པ་"
    },
    {
      "span": {
        "start": 4106,
        "end": 4117
      },
      "text": "རྣམ་པ་རྣམས་ ༼སྡེ།༽ རྣམ་པ་"
    },
    {
      "span": {
        "start": 4620,
        "end": 4624
      },
      "text": "གསལ་ ༼སྣར། པེ།༽ གསལ་བར་"
    },
    {
      "span": {
        "start": 4671,
        "end": 4680
      },
      "text": "སྐྱེད་པར་ ༼སྣར། པེ།༽ བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 4770,
        "end": 4776
      },
      "text": "བཅས་པ་ ༼སྣར། པེ།༽ བཅས་པར་"
    },
    {
      "span": {
        "start": 4779,
        "end": 4786
      },
      "text": "བླང་བར་ ༼སྣར། པེ།༽ བླངས་པར་"
    },
    {
      "span": {
        "start": 4858,
        "end": 4865
      },
      "text": "བླངས་པ་ ༼སྣར། པེ།༽ བླངས་པར་"
    },
    {
      "span": {
        "start": 5196,
        "end": 5203
      },
      "text": "དོན་དམ་ ༼སྣར། པེ།༽ དོན་དམ་པ་"
    },
    {
      "span": {
        "start": 5578,
        "end": 5587
      },
      "text": "འབྲས་བུར་ ༼སྣར། པེ།༽ འབྲས་བུ་"
    },
    {
      "span": {
        "start": 6112,
        "end": 6118
      },
      "text": "སྤྱིར་ ༼སྡེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 6290,
        "end": 6301
      },
      "text": "བསྒྲུབ་པའི་ ༼སྣར། པེ།༽ བསྒྲུབས་པའི་"
    },
    {
      "span": {
        "start": 6416,
        "end": 6426
      },
      "text": "དམ་བཅས་པར་ ༼སྣར། པེ།༽ དམ་བཅའ་བར་"
    },
    {
      "span": {
        "start": 6788,
        "end": 6799
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱིས་"
    },
    {
      "span": {
        "start": 7137,
        "end": 7145
      },
      "text": "བསྟན་པར་ ༼སྣར། པེ།༽ བརྟན་པར་"
    },
    {
      "span": {
        "start": 8692,
        "end": 8701
      },
      "text": "གཅིག་པའི་ ༼སྣར། པེ།༽ གཅིག་པ་"
    },
    {
      "span": {
        "start": 8728,
        "end": 8737
      },
      "text": "ཉེས་པ་སོ་ ༼སྣར། པེ།༽ ཉེས་པ་པོ་"
    },
    {
      "span": {
        "start": 9161,
        "end": 9164
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 9337,
        "end": 9342
      },
      "text": "གཅོད་ ༼པེ།༽ བཅོད་"
    },
    {
      "span": {
        "start": 9353,
        "end": 9363
      },
      "text": "བཟློག་པའི་ ༼སྣར། པེ།༽ ཟློག་པའི་"
    },
    {
      "span": {
        "start": 9376,
        "end": 9379
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ནི་དེ་"
    },
    {
      "span": {
        "start": 9387,
        "end": 9394
      },
      "text": "གཅོད་པ་ ༼སྣར། པེ།༽ བཅད་པ་"
    },
    {
      "span": {
        "start": 9784,
        "end": 9789
      },
      "text": "འདིར་ ༼སྣར། པེ།༽ འདི་རབ་ཏུ་"
    },
    {
      "span": {
        "start": 10303,
        "end": 10311
      },
      "text": "པའི་གནས་ ༼པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 10435,
        "end": 10445
      },
      "text": "ཆོས་ཅན་ནི་ ༼སྣར། པེ།༽ ཆོས་ཅན་གྱི་"
    },
    {
      "span": {
        "start": 11891,
        "end": 11900
      },
      "text": "ཤེས་བྱའི་ ༼སྣར། པེ།༽ ཤེས་བྱ་བའི་"
    },
    {
      "span": {
        "start": 12507,
        "end": 12514
      },
      "text": "དག་གིས་ ༼སྣར། པེ།༽ དག་གི་"
    },
    {
      "span": {
        "start": 13422,
        "end": 13430
      },
      "text": "བརྟགས་པ་ ༼སྣར། པེ།༽ བཏགས་པ་"
    },
    {
      "span": {
        "start": 13625,
        "end": 13633
      },
      "text": "རྟོག་པར་ ༼སྣར། པེ།༽ རྟག་པར་"
    },
    {
      "span": {
        "start": 13737,
        "end": 13741
      },
      "text": "དེས་ ༼པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 13979,
        "end": 13986
      },
      "text": "འདོད་པ་ ༼སྣར། པེ།༽ འདོད་"
    },
    {
      "span": {
        "start": 14065,
        "end": 14073
      },
      "text": "བརྟན་པར་ ༼སྣར། པེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 14491,
        "end": 14505
      },
      "text": "ཉིད་དོ་སྙམ་དུ་ ༼སྣར།༽ ཉིད་དོ་མཉམ་"
    },
    {
      "span": {
        "start": 14634,
        "end": 14642
      },
      "text": "མི་ཟ་བར་ ༼སྣར། པེ།༽ མི་ཟར་"
    },
    {
      "span": {
        "start": 14905,
        "end": 14910
      },
      "text": "ན་ནི་ ༼སྣར། པེ།༽ ན་མི་"
    },
    {
      "span": {
        "start": 15019,
        "end": 15025
      },
      "text": "ཉེ་ཡང་ ༼ཅོ།༽ ཉེ་བར་"
    },
    {
      "span": {
        "start": 15446,
        "end": 15450
      },
      "text": "གིས་ ༼སྣར། པེ།༽ གིས་ན་"
    },
    {
      "span": {
        "start": 15842,
        "end": 15849
      },
      "text": "ཆུང་ཟད་ ༼སྣར། པེ།༽ ཅུང་ཟད་"
    },
    {
      "span": {
        "start": 15913,
        "end": 15919
      },
      "text": "དེ་མི་ ༼སྣར། པེ།༽ དེའི་མིང་"
    },
    {
      "span": {
        "start": 16124,
        "end": 16136
      },
      "text": "པའི་ངོ་བོའི་ ༼པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 16519,
        "end": 16524
      },
      "text": "བླངས་ ༼སྣར། པེ།༽ བླང་"
    },
    {
      "span": {
        "start": 16546,
        "end": 16553
      },
      "text": "ལ་རྒྱུ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 16663,
        "end": 16672
      },
      "text": "གསུངས་སོ། ༼སྣར། པེ།༽ གསུང་ངོ་།"
    },
    {
      "span": {
        "start": 16674,
        "end": 16682
      },
      "text": "དེ་ལྟ་མ་ ༼སྣར། པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 16752,
        "end": 16758
      },
      "text": "དག་གི་ ༼སྣར། པེ།༽ དག་གིས་"
    },
    {
      "span": {
        "start": 17239,
        "end": 17245
      },
      "text": "ཤེས་པ་ ༼སྣར། པེ།༽ ཤེས་པའི་"
    },
    {
      "span": {
        "start": 17370,
        "end": 17377
      },
      "text": "ཁྱད་པར་ ༼སྣར། པེ།༽ ཁྱད་པར་བརྗོད་པར་"
    },
    {
      "span": {
        "start": 18066,
        "end": 18075
      },
      "text": "དེའི་དོན་ ༼སྣར། པེ།༽ དེ་དོན་"
    },
    {
      "span": {
        "start": 19016,
        "end": 19023
      },
      "text": "བྱ་བའི་ ༼སྣར། པེ།༽ བྱའི་"
    },
    {
      "span": {
        "start": 19252,
        "end": 19262
      },
      "text": "སྐྱེད་པའི་ ༼སྣར། པེ།༽ བསྐྱེད་པའི་"
    },
    {
      "span": {
        "start": 19344,
        "end": 19352
      },
      "text": "སྐྱེད་པ་ ༼སྡེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 19854,
        "end": 19857
      },
      "text": "ལྷ་ ༼སྣར། པེ།༽ ལྷས་"
    },
    {
      "span": {
        "start": 20074,
        "end": 20082
      },
      "text": "བརྟགས་པ་ ༼སྣར། པེ།༽ བརྟག་པ་"
    },
    {
      "span": {
        "start": 20350,
        "end": 20354
      },
      "text": "དོན་ ༼སྣར། པེ།༽ དོན་བྱེད་"
    },
    {
      "span": {
        "start": 20675,
        "end": 20681
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 20944,
        "end": 20952
      },
      "text": "དབང་གིས་ ༼སྣར། པེ།༽ དབང་གི་"
    },
    {
      "span": {
        "start": 21000,
        "end": 21003
      },
      "text": "དེ་ ༼སྣར།༽ ད་"
    },
    {
      "span": {
        "start": 22059,
        "end": 22064
      },
      "text": "འཇིག་ ༼སྣར། པེ།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 23128,
        "end": 23138
      },
      "text": "ཡིན་ཡང་རང་ ༼སྡེ།༽ ཡིན་ཡང་"
    },
    {
      "span": {
        "start": 23320,
        "end": 23328
      },
      "text": "བཞིན་དུ་ ༼སྡེ།༽ བཞིན་མ་"
    },
    {
      "span": {
        "start": 23362,
        "end": 23371
      },
      "text": "བྱེད་པ་མ་ ༼སྣར། པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 23754,
        "end": 23759
      },
      "text": "དུ་མ་ ༼སྣར། པེ།༽ དུ་མ་དང་"
    },
    {
      "span": {
        "start": 24214,
        "end": 24221
      },
      "text": "ཐ་དད་པ་ ༼སྣར། པེ།༽ ཐ་དད་པ་དང་ཐ་དད་པ་"
    },
    {
      "span": {
        "start": 24258,
        "end": 24265
      },
      "text": "ཡིན་པར་ ༼སྣར། པེ།༽ ཡིན་པས་"
    },
    {
      "span": {
        "start": 24311,
        "end": 24316
      },
      "text": "ལས་མ་ ༼སྣར། པེ།༽ ལ་མ་"
    },
    {
      "span": {
        "start": 25072,
        "end": 25080
      },
      "text": "ཡུལ་གྱི་ ༼སྣར། པེ།༽ ཡུལ་གྱིས་"
    },
    {
      "span": {
        "start": 25305,
        "end": 25313
      },
      "text": "བརྟགས་པ་ ༼སྣར། པེ།༽ བརྟག་པ་"
    },
    {
      "span": {
        "start": 25483,
        "end": 25491
      },
      "text": "ཕྱིར་དེ་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 26274,
        "end": 26282
      },
      "text": "བདག་ཉིད་ ༼སྣར། པེ།༽ བདག་ཉིད་དག་"
    },
    {
      "span": {
        "start": 26473,
        "end": 26481
      },
      "text": "སྐྱེ་བར་ ༼སྣར། པེ།༽ སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 27213,
        "end": 27222
      },
      "text": "སྐྱེད་པར་ ༼སྣར། པེ།༽ བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 27520,
        "end": 27529
      },
      "text": "བསྐྱེད་པ་ ༼སྣར། པེ།༽ སྐྱེད་པ་"
    },
    {
      "span": {
        "start": 27707,
        "end": 27716
      },
      "text": "ལོང་བ་དང་ ༼སྣར། པེ།༽ ལོང་བ་"
    },
    {
      "span": {
        "start": 28017,
        "end": 28024
      },
      "text": "ཡིན་ཏེ། ༼སྣར། པེ།༽ ཡིན་པ་སྟེ།"
    },
    {
      "span": {
        "start": 28592,
        "end": 28599
      },
      "text": "འཕྱི་བ་ ༼སྣར། པེ།༽ འཆི་བ་"
    },
    {
      "span": {
        "start": 28776,
        "end": 28785
      },
      "text": "། །དེ་ནི་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 29187,
        "end": 29192
      },
      "text": "གཅིག་ ༼སྣར། པེ།༽ གཅིག་གིས་"
    },
    {
      "span": {
        "start": 29578,
        "end": 29588
      },
      "text": "སྐད་ཅིག་མ་ ༼སྣར།༽ སྐད་ཅིག་"
    },
    {
      "span": {
        "start": 29658,
        "end": 29666
      },
      "text": "སྦྱོར་བ་ ༼སྣར།༽ སྐྱོར་བ་"
    },
    {
      "span": {
        "start": 29901,
        "end": 29908
      },
      "text": "བསྐལ་པ་ ༼སྡེ།༽ སྐལ་པ་"
    },
    {
      "span": {
        "start": 30193,
        "end": 30201
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 30296,
        "end": 30304
      },
      "text": "བརྟགས་པ་ ༼སྣར། པེ།༽ བརྟག་པ་"
    },
    {
      "span": {
        "start": 30381,
        "end": 30393
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 31258,
        "end": 31263
      },
      "text": "བསགས་ ༼སྣར། པེ།༽ སྩགས་"
    },
    {
      "span": {
        "start": 31429,
        "end": 31436
      },
      "text": "ཉིད་དུ་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 31451,
        "end": 31459
      },
      "text": "བརྟག་པར་ ༼སྣར། པེ།༽ བརྟག་པ་"
    },
    {
      "span": {
        "start": 32068,
        "end": 32076
      },
      "text": "འདས་ཀྱི་ ༼སྣར། པེ།༽ འདས་ཀྱིས་"
    },
    {
      "span": {
        "start": 33280,
        "end": 33289
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 34114,
        "end": 34126
      },
      "text": "ལྟོས་ནས་དཔེ་ ༼སྣར། པེ།༽ ལྟོས་ནས་"
    },
    {
      "span": {
        "start": 34182,
        "end": 34194
      },
      "text": "བྱ་བ་མ་ཚང་བ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 34530,
        "end": 34544
      },
      "text": "མངོན་སུམ་གྱིས་ ༼སྣར། པེ།༽ མངོན་སུམ་གྱི་"
    },
    {
      "span": {
        "start": 34757,
        "end": 34764
      },
      "text": "ཡོད་དོ། ༼སྣར། པེ།༽ ཡོད་དེ།"
    },
    {
      "span": {
        "start": 35117,
        "end": 35126
      },
      "text": "རྟེན་པའི་ ༼སྣར། པེ།༽ བརྟེན་པའི་"
    },
    {
      "span": {
        "start": 35202,
        "end": 35220
      },
      "text": "རྒོལ་བ་གཉི་ག་ལ་ནི་ ༼སྣར། པེ།༽ གཉི་ག་ལ་"
    },
    {
      "span": {
        "start": 35290,
        "end": 35295
      },
      "text": "རྩོད་ ༼སྣར། པེ།༽ བརྩོད་"
    },
    {
      "span": {
        "start": 35401,
        "end": 35412
      },
      "text": "བསྒྲུབ་པའི་ ༼སྣར། པེ།༽ སྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 35752,
        "end": 35762
      },
      "text": "བསལ་བས་དེ་ ༼སྣར། པེ།༽ བསལ་བས་ཏེ་"
    },
    {
      "span": {
        "start": 36490,
        "end": 36496
      },
      "text": "གསལ་བ་ ༼སྣར། པེ།༽ བསལ་བ་"
    },
    {
      "span": {
        "start": 36509,
        "end": 36516
      },
      "text": "གསལ་བར་ ༼སྣར། པེ།༽ བསལ་བར་"
    },
    {
      "span": {
        "start": 36549,
        "end": 36557
      },
      "text": "གསལ་བའི་ ༼སྣར། པེ།༽ བསལ་བའི་"
    },
    {
      "span": {
        "start": 36580,
        "end": 36589
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 37583,
        "end": 37593
      },
      "text": "བསྐྱེད་པར་ ༼སྣར། པེ།༽ སྐྱེད་པར་"
    },
    {
      "span": {
        "start": 37602,
        "end": 37614
      },
      "text": "སྒྲིབ་པ་མེད་ ༼སྣར། པེ།༽ སྒྲིབ་"
    },
    {
      "span": {
        "start": 37770,
        "end": 37774
      },
      "text": "ལུས་ ༼སྣར། པེ།༽ ཡུལ་"
    },
    {
      "span": {
        "start": 37934,
        "end": 37942
      },
      "text": "ནུས་པའང་ ༼སྣར། པེ།༽ ནུས་པའམ་"
    },
    {
      "span": {
        "start": 38009,
        "end": 38022
      },
      "text": "བདག་ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ བདག་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 38126,
        "end": 38149
      },
      "text": "སྒྲིབ་པར་བྱེད་པ་ཡིན་པར་ ༼སྣར། པེ།༽ སྒྲིབ་པར་"
    },
    {
      "span": {
        "start": 38684,
        "end": 38691
      },
      "text": "ཆུང་ཟད་ ༼སྣར། པེ།༽ ཅུང་ཟད་"
    },
    {
      "span": {
        "start": 38792,
        "end": 38798
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 39047,
        "end": 39054
      },
      "text": "ཉིད་དུ་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 39851,
        "end": 39857
      },
      "text": "ཤེས་པ་ ༼སྣར། པེ།༽ ཤེས་པའི་"
    },
    {
      "span": {
        "start": 40119,
        "end": 40127
      },
      "text": "ནུས་པའང་ ༼སྣར། པེ།༽ ནུས་པའམ་"
    },
    {
      "span": {
        "start": 40553,
        "end": 40560
      },
      "text": "ཆུང་ཟད་ ༼སྣར། པེ།༽ ཅུང་ཟད་"
    },
    {
      "span": {
        "start": 41102,
        "end": 41115
      },
      "text": "དུས་ཀྱིས་ཀྱང་ ༼སྣར། པེ།༽ དུས་ཀྱིས་"
    },
    {
      "span": {
        "start": 41734,
        "end": 41741
      },
      "text": "སྡུད་པ་ ༼སྣར། པེ།༽ བསྡུད་པ་"
    },
    {
      "span": {
        "start": 42277,
        "end": 42285
      },
      "text": "གྲགས་པས་ ༼སྣར། པེ།༽ གྲགས་པ་"
    },
    {
      "span": {
        "start": 42402,
        "end": 42408
      },
      "text": "བཞུགས་ ༼སྣར། པེ།༽ ཞུགས་"
    },
    {
      "span": {
        "start": 43189,
        "end": 43203
      },
      "text": "རྒྱལ་པོའི་མདོ་ ༼སྣར། པེ།༽ རྒྱལ་པོ་"
    },
    {
      "span": {
        "start": 43242,
        "end": 43245
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 43991,
        "end": 43996
      },
      "text": "སྟོང་ ༼སྣར། པེ།༽ སྟོངས་"
    },
    {
      "span": {
        "start": 44079,
        "end": 44086
      },
      "text": "ཡིན་ནོ། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 45275,
        "end": 45280
      },
      "text": "དེའི་ ༼སྣར། པེ།༽ དེ་ཅིའི་"
    },
    {
      "span": {
        "start": 45402,
        "end": 45408
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པ་མེད་པ་"
    },
    {
      "span": {
        "start": 45527,
        "end": 45535
      },
      "text": "ཡིན་པའོ་ ༼སྣར། པེ།༽ ཡིན་པ་"
    },
    {
      "span": {
        "start": 46274,
        "end": 46281
      },
      "text": "ཅི་སྟེ་ ༼སྣར། པེ།༽ ཅི་སྟེ་དེ་"
    },
    {
      "span": {
        "start": 46566,
        "end": 46573
      },
      "text": "སྤྱད་པ་ ༼སྣར། པེ།༽ དཔྱད་པ་"
    },
    {
      "span": {
        "start": 46839,
        "end": 46849
      },
      "text": "གང་ཡིན་པས་ ༼སྣར། པེ།༽ གང་ཡིན་པ་"
    },
    {
      "span": {
        "start": 47210,
        "end": 47215
      },
      "text": "བྱེད་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 47958,
        "end": 47966
      },
      "text": "གདུལ་བྱ་ ༼སྣར། པེ།༽ གདུལ་བ་"
    },
    {
      "span": {
        "start": 47968,
        "end": 47975
      },
      "text": "ཁྱད་པར་ ༼སྣར། པེ།༽ ཆད་པར་"
    },
    {
      "span": {
        "start": 48096,
        "end": 48103
      },
      "text": "བསྟན་པ་ ༼སྡེ།༽ བརྟན་པ་"
    },
    {
      "span": {
        "start": 48334,
        "end": 48339
      },
      "text": "སྐྲག་ ༼སྣར། པེ།༽ བཀག་"
    },
    {
      "span": {
        "start": 48386,
        "end": 48393
      },
      "text": "སྐྱེ་བ་ ༼སྣར། པེ།༽ སྐྱེ་བོ་"
    },
    {
      "span": {
        "start": 48529,
        "end": 48533
      },
      "text": "མེད་ ༼སྣར། པེ།༽ མེད་དོན་མེད་"
    },
    {
      "span": {
        "start": 48582,
        "end": 48585
      },
      "text": "པར་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 48900,
        "end": 48904
      },
      "text": "བཙལ་ ༼སྣར། པེ།༽ བསྩལ་"
    },
    {
      "span": {
        "start": 49233,
        "end": 49240
      },
      "text": "བཅོམ་ན་ ༼སྣར། པེ།༽ བཅོམ་པ་"
    },
    {
      "span": {
        "start": 49655,
        "end": 49660
      },
      "text": "བསྩལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 49754,
        "end": 49760
      },
      "text": "གཞིགས་ ༼སྣར། པེ།༽ བཞིགས་"
    },
    {
      "span": {
        "start": 49953,
        "end": 49961
      },
      "text": "ཕྱོགས་ཆ་ ༼སྣར། པེ།༽ ཕྱོགས་"
    },
    {
      "span": {
        "start": 50057,
        "end": 50064
      },
      "text": "ལ་སོགས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 50310,
        "end": 50315
      },
      "text": "བླངས་ ༼སྣར། པེ།༽ བླང་"
    },
    {
      "span": {
        "start": 50343,
        "end": 50358
      },
      "text": "རྟོག་པའི་ངོ་བོ་ ༼པེ།༽ རྟོག་པའི་ངོ་"
    },
    {
      "span": {
        "start": 50392,
        "end": 50418
      },
      "text": "ཡིན་ཡང་ཡུལ་འཛིན་པར་རྣམ་པར་ ༼སྣར། པེ།༽ ཡུལ་འཛིན་པར་"
    },
    {
      "span": {
        "start": 50560,
        "end": 50565
      },
      "text": "བརྩལ་ ༼སྣར། པེ།༽ བཙལ་"
    },
    {
      "span": {
        "start": 50714,
        "end": 50725
      },
      "text": "བསྒྲུབ་པའི་ ༼སྣར། པེ།༽ བསྒྲུབས་པའི་"
    },
    {
      "span": {
        "start": 50833,
        "end": 50839
      },
      "text": "གཞིགས་ ༼སྣར། པེ།༽ བཞིགས་"
    },
    {
      "span": {
        "start": 51109,
        "end": 51118
      },
      "text": "གཟུང་བའི་ ༼སྣར། པེ།༽ བཟུང་བའི་"
    },
    {
      "span": {
        "start": 51347,
        "end": 51352
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བར་"
    },
    {
      "span": {
        "start": 51390,
        "end": 51397
      },
      "text": "དཔྱད་པ་ ༼སྣར། པེ།༽ དཔྱད་"
    },
    {
      "span": {
        "start": 51715,
        "end": 51720
      },
      "text": "ལས་མ་ ༼སྣར། པེ།༽ ལ་མ་"
    },
    {
      "span": {
        "start": 51998,
        "end": 52000
      },
      "text": "པ་ ༼སྣར། པེ།༽ བར་"
    },
    {
      "span": {
        "start": 52222,
        "end": 52231
      },
      "text": "ཡིན་པ་ནི་ ༼སྣར། པེ།༽ ཡིན་པ་"
    },
    {
      "span": {
        "start": 53140,
        "end": 53148
      },
      "text": "བསལ་བའི་ ༼སྣར། པེ།༽ གསལ་བའི་"
    },
    {
      "span": {
        "start": 53400,
        "end": 53409
      },
      "text": "སྐྱེས་པར་ ༼སྣར། པེ།༽ སྐྱེས་པ་"
    },
    {
      "span": {
        "start": 53412,
        "end": 53421
      },
      "text": "མི་རྟག་པ་ ༼སྣར། པེ།༽ མི་རྟག་པར་"
    },
    {
      "span": {
        "start": 53743,
        "end": 53746
      },
      "text": "ཚེ་ ༼སྣར། པེ།༽ ཙེ་"
    },
    {
      "span": {
        "start": 53844,
        "end": 53852
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 53920,
        "end": 53930
      },
      "text": "སྒྲིབ་པའི་ ༼སྣར། པེ།༽ སྲིད་པའི་"
    },
    {
      "span": {
        "start": 54864,
        "end": 54869
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 55287,
        "end": 55304
      },
      "text": "ཚེ་ཉོན་མོངས་པ་དང་ ༼སྣར། པེ།༽ ཉོན་མོངས་པ་"
    },
    {
      "span": {
        "start": 55886,
        "end": 55896
      },
      "text": "ལ་སོགས་པས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 55944,
        "end": 55956
      },
      "text": "ཕྱིར་སྤངས་ན་ ༼ཅོ།༽ ཕྱིར་སྤངས་ནས་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 56804,
        "end": 56813
      },
      "text": "བརྟེན་པར་ ༼སྣར། པེ།༽ བསྟེན་པར་"
    },
    {
      "span": {
        "start": 56876,
        "end": 56882
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 56962,
        "end": 56971
      },
      "text": "བརྟེན་པས་ ༼སྣར། པེ།༽ བསྟེན་པས་"
    },
    {
      "span": {
        "start": 57184,
        "end": 57190
      },
      "text": "ངོ་བོ་ ༼སྣར། པེ།༽ ངོ་བོ་ནི་"
    },
    {
      "span": {
        "start": 57259,
        "end": 57263
      },
      "text": "མགོ་ ༼སྣར། པེ།༽ གོ་"
    },
    {
      "span": {
        "start": 57533,
        "end": 57541
      },
      "text": "གྲགས་པར་ ༼སྣར། པེ།༽ གྲགས་པས་"
    },
    {
      "span": {
        "start": 58178,
        "end": 58187
      },
      "text": "ཀུན་རྫོབ་ ༼པེ།༽ ཀུན་"
    },
    {
      "span": {
        "start": 58354,
        "end": 58363
      },
      "text": "བརྟེན་པར་ ༼སྣར། པེ།༽ བསྟེན་པར་"
    },
    {
      "span": {
        "start": 59454,
        "end": 59462
      },
      "text": "བརྟེན་པ་ ༼སྣར། པེ།༽ བསྟེན་པ་"
    },
    {
      "span": {
        "start": 59989,
        "end": 59994
      },
      "text": "སྤངས་ ༼སྣར། པེ།༽ སྤང་"
    },
    {
      "span": {
        "start": 60020,
        "end": 60023
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 60386,
        "end": 60391
      },
      "text": "།། །། ༼སྣར།༽ །། །།པའོ།། །།འདིས་ཀྱང་འཁོར་བའི་སྡུག་བསྔལ་གྱི་རྒྱ་མཚོ་བསྐེམས་ཏེ། རྣམ་མཁྱེན་རྫོགས་པའི་སངས་རྒྱས་ཐོབ་པར་གྱུར་ཅིག །སརྦ་མངྒ་ལམ།། །། ༼པེ།༽ །། །།པའོ།། །།འདིས་ཀྱང་འཁོར་བའི་སྡུག་བསྔལ་གྱི་རྒྱ་མཚོ་བསྐེམས་ཏེ། རྣམ་མཁྱེན་རྫོགས་པའི་སངས་རྒྱས་ཐོབ་པར་གྱུར་ཅིག །།"
    }
  ]
}