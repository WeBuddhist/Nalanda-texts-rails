{
  "durchens": [
    {
      "span": {
        "start": 633,
        "end": 639
      },
      "text": "སྤོངས་ ༼སྣར། པེ།༽ སྤངས་"
    },
    {
      "span": {
        "start": 683,
        "end": 687
      },
      "text": "ཞིང་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 691,
        "end": 693
      },
      "text": "ལ་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 1226,
        "end": 1237
      },
      "text": "བྱིང་བ་ཡིས། ༼སྣར། པེ།༽ བྱིང་བ་ཡི།"
    },
    {
      "span": {
        "start": 1701,
        "end": 1706
      },
      "text": "བརླབ་ ༼ཅོ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 1720,
        "end": 1725
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 2305,
        "end": 2313
      },
      "text": "བསམས་ཏེ། ༼སྣར། པེ།༽ བསམ་སྟེ།"
    },
    {
      "span": {
        "start": 2469,
        "end": 2479
      },
      "text": "མཐར་ཐུག་པ་ ༼སྣར། པེ།༽ མཐར་ཐུག་པར་"
    },
    {
      "span": {
        "start": 2521,
        "end": 2524
      },
      "text": "དེ། ༼ཅོ།༽ དོ། །"
    },
    {
      "span": {
        "start": 2897,
        "end": 2905
      },
      "text": "ཕྱག་རྒྱ་ ༼སྣར། པེ།༽ ཕྱག་"
    },
    {
      "span": {
        "start": 2910,
        "end": 2917
      },
      "text": "དགུག་པ་ ༼སྣར། པེ།༽ དགུགས་པ་"
    },
    {
      "span": {
        "start": 3040,
        "end": 3049
      },
      "text": "སྦྱར་བའི་ ༼སྣར། པེ།༽ སྦྱང་བའི་"
    },
    {
      "span": {
        "start": 3083,
        "end": 3089
      },
      "text": "བརླབས་ ༼ཅོ།༽ བརླབ་"
    },
    {
      "span": {
        "start": 3123,
        "end": 3125
      },
      "text": "ཡ་ ༼སྣར། པེ།༽ ཡེ་"
    },
    {
      "span": {
        "start": 3316,
        "end": 3323
      },
      "text": "དི་ཏ་ཡ་ ༼སྣར། པེ།༽ དི་པྱ་"
    },
    {
      "span": {
        "start": 3880,
        "end": 3884
      },
      "text": "བདག་ ༼པེ།༽ དག་"
    },
    {
      "span": {
        "start": 3910,
        "end": 3920
      },
      "text": "མི་སླུ་བར། ༼པེ།༽ མ་བསླུ་ར།"
    },
    {
      "span": {
        "start": 4361,
        "end": 4370
      },
      "text": "རྡོ་རྗེས་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 4382,
        "end": 4389
      },
      "text": "ཁྲུ་གང་ ༼སྣར། པེ།༽ ཁྲུ་"
    },
    {
      "span": {
        "start": 4402,
        "end": 4408
      },
      "text": "ཞོག་མ་ ༼སྣར། པེ།༽ ཞོགས་མ་"
    },
    {
      "span": {
        "start": 4468,
        "end": 4471
      },
      "text": "དང་ ༼སྣར། པེ།༽ དང་ནི་"
    },
    {
      "span": {
        "start": 4511,
        "end": 4520
      },
      "text": "ཞིང་སྣུམ་ ༼སྣར། པེ།༽ ཞིམ་བསྣུམ་"
    },
    {
      "span": {
        "start": 4789,
        "end": 4795
      },
      "text": "ནང་གི་ ༼སྣར། པེ།༽ ནང་གིས་"
    },
    {
      "span": {
        "start": 4830,
        "end": 4836
      },
      "text": "གའོ། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 4884,
        "end": 4889
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 5119,
        "end": 5125
      },
      "text": "སྦུབས་ ༼སྣར། པེ།༽ སྦུབ་"
    },
    {
      "span": {
        "start": 5469,
        "end": 5481
      },
      "text": "དེ་ནས་དཀྱིལ་ ༼སྣར། པེ།༽ དཀྱིལ་"
    },
    {
      "span": {
        "start": 5500,
        "end": 5507
      },
      "text": "གསོལ་བ་ ༼སྣར། པེ།༽ གསོལ་བར་"
    },
    {
      "span": {
        "start": 5763,
        "end": 5766
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 5939,
        "end": 5946
      },
      "text": "བསྒྱུར། ༼སྣར། པེ།༽ སྒྱུར།"
    },
    {
      "span": {
        "start": 6041,
        "end": 6049
      },
      "text": "ཆེན་པོར་ ༼སྣར། པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 6176,
        "end": 6191
      },
      "text": "དེ་ལས་ཁྲོ་བོའི་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 6346,
        "end": 6353
      },
      "text": "བསྒོམས་ ༼སྣར།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 6441,
        "end": 6450
      },
      "text": "སྟང་སྟབས་ ༼སྣར། པེ།༽ སྟངས་སྟབས་"
    },
    {
      "span": {
        "start": 6455,
        "end": 6500
      },
      "text": "གཡས་སྐོར་དུ་དཀྱིལ་འཁོར་གྱི་ས་ལ་ལན་གསུམ་བསྐོར་ ༼སྣར། པེ།༽ གཡས་སྐོར་"
    },
    {
      "span": {
        "start": 6856,
        "end": 6861
      },
      "text": "གཤེག་ ༼སྣར། པེ།༽ གཤོག་"
    },
    {
      "span": {
        "start": 6973,
        "end": 6979
      },
      "text": "ཕུར་པ་ ༼སྣར། པེ།༽ ཕུར་པ་ལ་"
    },
    {
      "span": {
        "start": 7035,
        "end": 7042
      },
      "text": "བཏགས་པ་ ༼སྣར། པེ།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 7042,
        "end": 7047
      },
      "text": "སྟོད་ ༼པེ།༽ བསྟོད་"
    },
    {
      "span": {
        "start": 7101,
        "end": 7107
      },
      "text": "བརླབས་ ༼སྣར། པེ།༽ བརླབ་"
    },
    {
      "span": {
        "start": 7182,
        "end": 7191
      },
      "text": "གཟུང་བའི་ ༼སྣར། པེ།༽ བཟུང་བའི་"
    },
    {
      "span": {
        "start": 7614,
        "end": 7626
      },
      "text": "ཐམས་ཅད་ཀྱིས། ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི།"
    },
    {
      "span": {
        "start": 7771,
        "end": 7779
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 7907,
        "end": 7915
      },
      "text": "གསོལ་ཏེ་ ༼སྣར། པེ།༽ གསོལ་ཏོ་"
    },
    {
      "span": {
        "start": 8460,
        "end": 8464
      },
      "text": "རིག་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 8638,
        "end": 8645
      },
      "text": "གནང་བར་ ༼སྣར། པེ།༽ སྣང་བར་"
    },
    {
      "span": {
        "start": 8686,
        "end": 8691
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ རྩོལ།"
    },
    {
      "span": {
        "start": 8937,
        "end": 8947
      },
      "text": "ཡོ་བྱད་ཅི་ ༼ཅོ།༽ ཡོ་བྱད་ཅིང་"
    },
    {
      "span": {
        "start": 8999,
        "end": 9007
      },
      "text": "བརྩེ་བར་ ༼སྣར། པེ།༽ རྩེ་བར་"
    },
    {
      "span": {
        "start": 9150,
        "end": 9165
      },
      "text": "ཕྱོགས་དང་ཕྱོགས་ ༼སྣར། པེ།༽ ཕྱོགས་"
    },
    {
      "span": {
        "start": 9445,
        "end": 9451
      },
      "text": "རང་རང་ ༼པེ།༽ རང་"
    },
    {
      "span": {
        "start": 9535,
        "end": 9543
      },
      "text": "ཤིང་གིས་ ༼སྣར། པེ།༽ ཤིང་གི་"
    },
    {
      "span": {
        "start": 9563,
        "end": 9571
      },
      "text": "བཏབ་པའི་ ༼སྣར། པེ།༽ བཏབ་པ་"
    },
    {
      "span": {
        "start": 10607,
        "end": 10615
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 11199,
        "end": 11203
      },
      "text": "གནང་ ༼སྣར། པེ།༽ སྣང་"
    },
    {
      "span": {
        "start": 11374,
        "end": 11385
      },
      "text": "སྟོན་པ་པོས། ༼སྣར། པེ།༽ སྟོན་པ་བས།"
    },
    {
      "span": {
        "start": 11529,
        "end": 11534
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 11590,
        "end": 11595
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 11951,
        "end": 11959
      },
      "text": "བསྒོམ་པ་ ༼སྣར། པེ།༽ བསྒོམས་པ་"
    },
    {
      "span": {
        "start": 12222,
        "end": 12227
      },
      "text": "བྱའི་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 12421,
        "end": 12433
      },
      "text": "བདག་ཉིད་ཀྱི་ ༼སྣར། པེ།༽ བདག་ཉིད་"
    },
    {
      "span": {
        "start": 12558,
        "end": 12569
      },
      "text": "ཡེ་ཤེས་ཀྱི་ ༼སྣར། པེ།༽ ཡེ་ཤེས་"
    },
    {
      "span": {
        "start": 12715,
        "end": 12730
      },
      "text": "སློབ་དཔོན་གྱིས་ ༼སྣར། པེ།༽ སློབ་དཔོན་གྱི་"
    },
    {
      "span": {
        "start": 13208,
        "end": 13212
      },
      "text": "རྟག་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 13464,
        "end": 13468
      },
      "text": "གསད་ ༼སྣར། པེ།༽ བསད་"
    },
    {
      "span": {
        "start": 13492,
        "end": 13496
      },
      "text": "བླང་ ༼སྣར།༽ སླང་"
    },
    {
      "span": {
        "start": 13655,
        "end": 13660
      },
      "text": "སྤང་། ༼སྣར། པེ།༽ སྤངས།"
    },
    {
      "span": {
        "start": 13744,
        "end": 13748
      },
      "text": "དག ། ༼སྣར། པེ།༽ བྱ། །"
    },
    {
      "span": {
        "start": 13906,
        "end": 13912
      },
      "text": "སྤོང་། ༼སྣར། པེ།༽ སྤངས།"
    },
    {
      "span": {
        "start": 14092,
        "end": 14098
      },
      "text": "སྲུངས། ༼སྣར། པེ།༽ བསྲུངས།"
    },
    {
      "span": {
        "start": 14147,
        "end": 14154
      },
      "text": "བྱའོ། ། ༼སྣར། པེ།༽ ། །ཆགས་འགྱུར་ལས། ཕྱོགས་བཅུ་ན་བཞུགས་པའི་སངས་རྒྱས་དང་བྱང་ཆུབ་སེམས་དཔའ་ཐམས་ཅད་བདག་ལ་དགོངས་སུ་གསོལ། བདག་མིང་འདི་ཞེས་བགྱི་བ། དུས་འདི་ནས་བཟུང་ནས་ཇི་སྲིད་བྱང་ཆུབ་སྙིང་པོ་ལ་མཆིས་ཀྱི་བར་དུ། ཇི་ལྟར་དུས་གསུམ་མགོན་པོ་རྣམས། །བྱང་ཆུབ་ཏུ་ནི་ངེས་མཛད་པའི། །བྱང་ཆུབ་སེམས་ནི་བླ་མེད་པས། །དམ་པ་བདག་གིས་བསྐྱེད་པར་བགྱི་ཟེར་"
    },
    {
      "span": {
        "start": 14946,
        "end": 14954
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 14977,
        "end": 14983
      },
      "text": "རྒལ་བ་ ༼སྣར།༽ བརྒལ་བ་ ༼པེ།༽ བསྒྲལ་བ་"
    },
    {
      "span": {
        "start": 15018,
        "end": 15028
      },
      "text": "གིས་དགྲོལ། ༼སྣར། པེ།༽ གི་སྒྲོལ།"
    },
    {
      "span": {
        "start": 15149,
        "end": 15152
      },
      "text": "ཡི་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 15228,
        "end": 15235
      },
      "text": "བརྙས་པ་ ༼པེ།༽ བརྙེས་པ་"
    },
    {
      "span": {
        "start": 15631,
        "end": 15639
      },
      "text": "སྤོས་སོ། ༼སྣར། པེ།༽ སྤོས་དང་།"
    },
    {
      "span": {
        "start": 15902,
        "end": 15912
      },
      "text": "བསྔགས་པའི་ ༼སྣར། པེ།༽ སྔགས་པའི་"
    },
    {
      "span": {
        "start": 16065,
        "end": 16073
      },
      "text": "བརྒྱན་པ་ ༼སྣར། པེ།༽ བརྒྱན་པའི་"
    },
    {
      "span": {
        "start": 16186,
        "end": 16194
      },
      "text": "ལྟས་བལྟ་ ༼སྣར། པེ།༽ བལྟས་ལྟ་"
    },
    {
      "span": {
        "start": 16238,
        "end": 16241
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལྟས་"
    },
    {
      "span": {
        "start": 16456,
        "end": 16461
      },
      "text": "དངོས་ ༼སྣར། པེ།༽ གིས་ངོས་"
    },
    {
      "span": {
        "start": 16495,
        "end": 16504
      },
      "text": "སྦྱང་བའི་ ༼སྣར། པེ།༽ སྦྱངས་པའི་"
    },
    {
      "span": {
        "start": 16514,
        "end": 16519
      },
      "text": "འཐུང་ ༼སྣར།༽ ཐུང་"
    },
    {
      "span": {
        "start": 16593,
        "end": 16598
      },
      "text": "སརྦྦ་ ༼སྣར། པེ།༽ སརྦ་"
    },
    {
      "span": {
        "start": 16605,
        "end": 16610
      },
      "text": "སརྦྦ་ ༼སྣར། པེ།༽ སརྦ་"
    },
    {
      "span": {
        "start": 16642,
        "end": 16646
      },
      "text": "ཀལྤ་ ༼སྣར། པེ།༽ ཀལ་པཾ་"
    },
    {
      "span": {
        "start": 16694,
        "end": 16699
      },
      "text": "གཞུག་ ༼སྣར། པེ།༽ བཞུག་"
    },
    {
      "span": {
        "start": 16764,
        "end": 16774
      },
      "text": "བརྒྱ་ལམ་ན་ ༼སྣར། པེ།༽ བརྒྱ་ལམ་"
    },
    {
      "span": {
        "start": 16785,
        "end": 16790
      },
      "text": "ཞིག ། ༼སྣར། པེ།༽ ཞིགཡིན། །"
    },
    {
      "span": {
        "start": 16944,
        "end": 16950
      },
      "text": "བྱེ་མ་ ༼སྣར། པེ།༽ བྱེ་བ་"
    },
    {
      "span": {
        "start": 17033,
        "end": 17045
      },
      "text": "འགྱུར་ཡིན་ན། ༼སྣར། པེ།༽ འགྱུར་བ་ཡིན།"
    },
    {
      "span": {
        "start": 17124,
        "end": 17131
      },
      "text": "བཟླས་ན་ ༼སྣར། པེ།༽ བཟླས་ནས་"
    },
    {
      "span": {
        "start": 17139,
        "end": 17143
      },
      "text": "འཕང་ ༼སྣར། པེ།༽ འཕངས་"
    },
    {
      "span": {
        "start": 17217,
        "end": 17227
      },
      "text": "དེ་དག་གིས་ ༼སྣར། པེ།༽ དེ་དག་གི་"
    },
    {
      "span": {
        "start": 17544,
        "end": 17547
      },
      "text": "ལམ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 17948,
        "end": 17954
      },
      "text": "ཡིན། །ཡོད་དང་མེད་ལས་རྣམ་པར་འདས། །ནམ་མཁའ་བཞིན་དུ་དྲི་མ་མེད། ། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 18023,
        "end": 18033
      },
      "text": "བསྐྱེད་པར་ ༼སྣར། པེ།༽ སྐྱེད་པར་"
    },
    {
      "span": {
        "start": 18182,
        "end": 18192
      },
      "text": "ལྟས་བལྟའོ། ༼སྣར། པེ།༽ བལྟས་ལྟའོ།"
    },
    {
      "span": {
        "start": 18205,
        "end": 18209
      },
      "text": "ལྟས་ ༼སྣར། པེ།༽ བལྟས་"
    },
    {
      "span": {
        "start": 18250,
        "end": 18255
      },
      "text": "ཟློས་ ༼སྣར། པེ།༽ བཟློས་"
    },
    {
      "span": {
        "start": 18446,
        "end": 18450
      },
      "text": "གཞག་ ༼སྣར། པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 18603,
        "end": 18610
      },
      "text": "སྐུད་པ་ ༼སྣར།༽ བསྐུད་པ་"
    },
    {
      "span": {
        "start": 18700,
        "end": 18708
      },
      "text": "བསླབས་པ་ ༼སྣར། པེ།༽ བསླབ་པར་"
    },
    {
      "span": {
        "start": 18853,
        "end": 18859
      },
      "text": "རང་རང་ ༼སྣར།༽ རང་རང་གི་"
    },
    {
      "span": {
        "start": 19039,
        "end": 19046
      },
      "text": "མིག་གི་ ༼སྣར། པེ།༽ མིག་གིས་"
    },
    {
      "span": {
        "start": 19109,
        "end": 19114
      },
      "text": "བལྟས་ ༼སྣར། པེ།༽ ལྟས་"
    },
    {
      "span": {
        "start": 19118,
        "end": 19120
      },
      "text": "ཛ་ ༼སྣར། པེ།༽ ཛ་་"
    },
    {
      "span": {
        "start": 19228,
        "end": 19239
      },
      "text": "དམ་ཚིག་གིས་ ༼སྣར། པེ།༽ དམ་ཚིག་གི་"
    },
    {
      "span": {
        "start": 19959,
        "end": 19969
      },
      "text": "སེམས་དཔའི་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 20114,
        "end": 20124
      },
      "text": "གཡོན་གྱིས་ ༼སྣར། པེ།༽ གཡོན་གྱི་"
    },
    {
      "span": {
        "start": 20152,
        "end": 20157
      },
      "text": "ཏྲ་མ་ ༼སྣར། པེ།༽ ཏྲ་མཱ་"
    },
    {
      "span": {
        "start": 20903,
        "end": 20907
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 20913,
        "end": 20919
      },
      "text": "བརྒྱད་ ༼སྣར། པེ།༽ བརྒྱ་"
    },
    {
      "span": {
        "start": 20988,
        "end": 20995
      },
      "text": "བྱའོ། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 21324,
        "end": 21335
      },
      "text": "གསུམ་པས་ནི་ ༼སྣར། པེ།༽ གསུམ་པའི་"
    },
    {
      "span": {
        "start": 21501,
        "end": 21504
      },
      "text": "ནང་ ༼སྣར།༽ རང་"
    },
    {
      "span": {
        "start": 21707,
        "end": 21710
      },
      "text": "སར་ ༼སྣར། པེ།༽ སའི་"
    },
    {
      "span": {
        "start": 21830,
        "end": 21841
      },
      "text": "ཁོར་ཡུག་ཏེ་ ༼སྣར། པེ།༽ ཁོར་ཡུག་སྟེ་"
    },
    {
      "span": {
        "start": 22130,
        "end": 22157
      },
      "text": "དཀྱིལ་འཁོར་གྱི་ཉེ་འཁོར་གྱི་ ༼སྣར། པེ།༽ དཀྱིལ་འཁོར་གྱི་"
    },
    {
      "span": {
        "start": 22406,
        "end": 22410
      },
      "text": "གདབ་ ༼སྣར། པེ།༽ བཏབ་"
    },
    {
      "span": {
        "start": 22429,
        "end": 22437
      },
      "text": "ལྟ་སྟངས་ ༼སྣར། པེ།༽ སྟང་སྟབས་"
    },
    {
      "span": {
        "start": 22441,
        "end": 22454
      },
      "text": "འོད་ཟེར་གྱིས་ ༼སྣར། པེ།༽ འོད་ཟེར་གྱི་"
    },
    {
      "span": {
        "start": 22501,
        "end": 22508
      },
      "text": "རྣམས་ལ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 22552,
        "end": 22577
      },
      "text": "ལྔ་དང་འགྲམ་གྱི་ཚོན་སྣ་ལྔ་ ༼སྣར། པེ།༽ ལྔ་"
    },
    {
      "span": {
        "start": 22592,
        "end": 22598
      },
      "text": "ཕྱིའི་ ༼སྣར། པེ།༽ ཕྱིས་པས་"
    },
    {
      "span": {
        "start": 22726,
        "end": 22731
      },
      "text": "རྒྱན་ ༼སྣར། པེ།༽ བརྒྱན་"
    },
    {
      "span": {
        "start": 22826,
        "end": 22833
      },
      "text": "བྲེལ་པ་ ༼སྣར། པེ།༽ འབྲེལ་པ་"
    },
    {
      "span": {
        "start": 23074,
        "end": 23087
      },
      "text": "རི་དྭགས་ཀྱིས་ ༼སྣར། པེ།༽ རི་དྭགས་ཀྱི་"
    },
    {
      "span": {
        "start": 23719,
        "end": 23725
      },
      "text": "དེ་དག་ ༼སྣར། པེ།༽ དེ་དག་གི་"
    },
    {
      "span": {
        "start": 23956,
        "end": 23960
      },
      "text": "ཡ་མ་ ༼སྣར། པེ།༽ ཡ་མཱ་"
    },
    {
      "span": {
        "start": 24054,
        "end": 24059
      },
      "text": "གྲོལ་ ༼སྣར། པེ།༽ སྒྲོལ་"
    },
    {
      "span": {
        "start": 24324,
        "end": 24333
      },
      "text": "དེ་ནས་ནི་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 24354,
        "end": 24632
      },
      "text": "ནག་པོའོ། །དེ་ཡང་སྦོམ་ཕྲ་དང་ཡོན་པོ་དང་གཡོན་སྐོར་ལ་སོགས་པའི་སྐྱོན་སྤངས་ཏེ་བྲིའོ། །དེ་ནས་དབུས་ནས་བྲིའོ། །དེ་ནས་ལས་ཀྱི་རྡོ་རྗེ་ལ་སོགས་པས་ཅི་བདེར་བྲིའོ། །དབུས་དང་ཤར་ལ་སོགས་པའི་རེའུ་ཆ་རྣམས་ནི་ནག་པོ་དང་། དཀར་པོ་དང་། སེར་པོ་དང་། དམར་པོ་དང་། ལྗང་གུ་གོ་རིམ་བཞིན་ནོ། །མཆོད་སྣམ་ནི་དམར་པོའོ། ༼སྣར། པེ།༽ ནག་པོའོ།"
    },
    {
      "span": {
        "start": 24854,
        "end": 24870
      },
      "text": "སྦྱོར་གྱི་སྦྱོར་ ༼སྣར། པེ།༽ སྦྱོར་"
    },
    {
      "span": {
        "start": 25176,
        "end": 25187
      },
      "text": "ཚམ་ངམ་གྱིས་ ༼སྣར། པེ།༽ ཚམ་ངམ་"
    },
    {
      "span": {
        "start": 25283,
        "end": 25297
      },
      "text": "བྲིས་ནས་དེ་ནས་ ༼སྣར། པེ།༽ བྲིས་ནས་"
    },
    {
      "span": {
        "start": 25380,
        "end": 25425
      },
      "text": "ཕྱག་རྒྱའམ། ཕྱག་དང་ཞབས་ལ་སོགས་པ་སྐུའི་ཕྱག་རྒྱ་ ༼སྣར། པེ།༽ ཕྱག་རྒྱ་"
    },
    {
      "span": {
        "start": 26195,
        "end": 26208
      },
      "text": "གཞན་སེམས་དཔའ་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 26211,
        "end": 26214
      },
      "text": "ནི་ ༼སྣར། པེ།༽ གི་"
    },
    {
      "span": {
        "start": 26232,
        "end": 26243
      },
      "text": "ཕྱག་མཚན་དང་ ༼སྣར། པེ།༽ ཕྱག་མཚན་དུ་"
    },
    {
      "span": {
        "start": 26723,
        "end": 26738
      },
      "text": "འཁོར་ལོས་སྒྱུར་ ༼སྣར། པེ།༽ འཁོར་ལོ་བསྒྱུར་"
    },
    {
      "span": {
        "start": 27000,
        "end": 27010
      },
      "text": "ཆོས་འབྱུང་ ༼སྣར། པེ།༽ ཆོས་འབྱུང་བ་"
    },
    {
      "span": {
        "start": 27125,
        "end": 27135
      },
      "text": "སེམས་དཔའི་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 27222,
        "end": 27230
      },
      "text": "འཁོར་ལོ་ ༼སྣར། པེ།༽ འཁོར་"
    },
    {
      "span": {
        "start": 27917,
        "end": 27933
      },
      "text": "ཀྱིས་ཐུགས་ལའོ། ། ༼སྣར། པེ།༽ ཀྱིས་དབུ་ལ་"
    },
    {
      "span": {
        "start": 28068,
        "end": 28073
      },
      "text": "བསྟན། ༼སྣར། པེ།༽ བསྟན་པའི།"
    },
    {
      "span": {
        "start": 28131,
        "end": 28140
      },
      "text": "སེམས་པའི་ ༼སྣར། པེ།༽ སེམས་དཔའི་"
    },
    {
      "span": {
        "start": 28274,
        "end": 28281
      },
      "text": "བྱས་ཏེ། ༼སྣར། པེ།༽ བྱ་སྟེ།"
    },
    {
      "span": {
        "start": 28676,
        "end": 28684
      },
      "text": "བསྟོད་པ་ ༼སྣར། པེ།༽ སྟོད་པ་"
    },
    {
      "span": {
        "start": 28753,
        "end": 28770
      },
      "text": "ཕྱོགས་སྐྱོང་རྣམས་ ༼སྣར། པེ།༽ ཕྱོགས་སྐྱོང་སོ་"
    },
    {
      "span": {
        "start": 28773,
        "end": 28777
      },
      "text": "སོར་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 28953,
        "end": 28961
      },
      "text": "བསྐོར་བ་ ༼སྣར། པེ།༽ བསྐོར་བ་ལ་"
    },
    {
      "span": {
        "start": 28969,
        "end": 28976
      },
      "text": "བྱས་ཏེ། ༼སྣར། པེ།༽ བྱ་སྟེ།"
    },
    {
      "span": {
        "start": 28981,
        "end": 28998
      },
      "text": "བྱས་ནས་མེ་ཏོག་གི་ ༼སྣར། པེ།༽ བྱས་ནས་"
    },
    {
      "span": {
        "start": 29049,
        "end": 29054
      },
      "text": "བླངས་ ༼སྣར། པེ།༽ བསླངས་"
    },
    {
      "span": {
        "start": 29360,
        "end": 29367
      },
      "text": "བྱ་སྟེ། ༼སྣར། པེ།༽ བྱའོ། །"
    },
    {
      "span": {
        "start": 29400,
        "end": 29405
      },
      "text": "འཐོར་ ༼སྣར། པེ།༽ མཐོར་"
    },
    {
      "span": {
        "start": 29417,
        "end": 29422
      },
      "text": "ཞུགས་ ༼སྣར། པེ།༽ བཞུགས་པ་"
    },
    {
      "span": {
        "start": 29530,
        "end": 29538
      },
      "text": "བརླབས་པ་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 30003,
        "end": 30012
      },
      "text": "སེམས་དཔར་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 30435,
        "end": 30439
      },
      "text": "གསལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 30895,
        "end": 30907
      },
      "text": "ཞེས་ལན་གསུམ་ ༼སྣར། པེ།༽ ཞེས་"
    },
    {
      "span": {
        "start": 30929,
        "end": 30936
      },
      "text": "མེ་ཏོག་ ༼སྣར། པེ།༽ མེ་ཏོག་གི་"
    },
    {
      "span": {
        "start": 31228,
        "end": 31232
      },
      "text": "སརྦ་ ༼སྣར། པེ།༽ སརྦྦ་"
    },
    {
      "span": {
        "start": 31328,
        "end": 31330
      },
      "text": "ཐ་ ༼སྣར། པེ།༽ ཐཱ་"
    },
    {
      "span": {
        "start": 31393,
        "end": 31404
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱིས་"
    },
    {
      "span": {
        "start": 31553,
        "end": 31566
      },
      "text": "ནོ་ཞེས་བརྗོད་ ༼སྣར། པེ།༽ ནོ་ཞེས་"
    },
    {
      "span": {
        "start": 31815,
        "end": 31824
      },
      "text": "ཞུགས་ཀྱི། ༼སྣར། པེ།༽ ཞུགས་ཀྱིས།"
    },
    {
      "span": {
        "start": 31951,
        "end": 31957
      },
      "text": "བྱ་ཡི། ༼སྣར། པེ།༽ བྱ་ཡིས།"
    },
    {
      "span": {
        "start": 32091,
        "end": 32095
      },
      "text": "བཞག་ ༼སྣར།༽ གཞག་"
    },
    {
      "span": {
        "start": 32338,
        "end": 32346
      },
      "text": "སྲེག་པར་ ༼སྣར། པེ།༽ བསྲེག་པར་"
    },
    {
      "span": {
        "start": 32762,
        "end": 32773
      },
      "text": "རློབས་ཤིག ། ༼སྣར། པེ།༽ བརླབས་ལས། །"
    },
    {
      "span": {
        "start": 32816,
        "end": 32831
      },
      "text": "གསོལ་བ་ལན་གསུམ་ ༼སྣར། པེ།༽ གསོལ་བ་"
    },
    {
      "span": {
        "start": 32909,
        "end": 32939
      },
      "text": "ཡི་གེ་ཨ་དམར་པོ་བཀོད་ལ་སྙིང་གར་ ༼སྣར། པེ།༽ ཡི་གེ་"
    },
    {
      "span": {
        "start": 33107,
        "end": 33114
      },
      "text": "ལྟེ་བར་ ༼སྣར། པེ།༽ ལྟོ་བར་"
    },
    {
      "span": {
        "start": 33328,
        "end": 33337
      },
      "text": "རླུང་གིས་ ༼སྣར། པེ།༽ རླུང་གི་"
    },
    {
      "span": {
        "start": 33340,
        "end": 33346
      },
      "text": "སྦར་བ་ ༼སྣར། པེ།༽ འབར་བ་"
    },
    {
      "span": {
        "start": 33410,
        "end": 33412
      },
      "text": "ཧ་ ༼སྣར། པེ།༽ ཧ་ཨ་"
    },
    {
      "span": {
        "start": 33461,
        "end": 33468
      },
      "text": "ཕེབས་པ་ ༼སྣར། པེ།༽ ཕབ་པ་"
    },
    {
      "span": {
        "start": 33522,
        "end": 33524
      },
      "text": "ཨ་ ༼སྣར། པེ།༽ ལྔ་"
    },
    {
      "span": {
        "start": 33687,
        "end": 33725
      },
      "text": "དེ་ནི་དེའི་ལྷའོ། །མེ་ཏོག་བབ་པའི་མཚན་མ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 34098,
        "end": 34102
      },
      "text": "རྒལ་ ༼སྣར། པེ།༽ བརྒལ་"
    },
    {
      "span": {
        "start": 34430,
        "end": 34433
      },
      "text": "སྭ་ ༼སྣར། པེ།༽ ཏྭ་"
    },
    {
      "span": {
        "start": 34551,
        "end": 34566
      },
      "text": "མཆོག་འགྲུབ་པའོ། ༼སྣར།༽ འགྲུབ་པར་བྱའོ།"
    },
    {
      "span": {
        "start": 34591,
        "end": 34598
      },
      "text": "ཡེ་ཤེས་ ༼སྣར། པེ།༽ ཡེ་ཤེས་སོ། །དམར་པོ་མཐོང་ན་རྗེས་སུ་ཆགས་པའི་ཡེ་ཤེས་"
    },
    {
      "span": {
        "start": 34598,
        "end": 34603
      },
      "text": "སོ། ། ༼སྣར། པེ།༽ །།"
    },
    {
      "span": {
        "start": 34689,
        "end": 34695
      },
      "text": "དེ་ནས། ༼སྣར། པེ།༽ དེ་ན།"
    },
    {
      "span": {
        "start": 34716,
        "end": 34725
      },
      "text": "ཁྱོད་ཀྱི། ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས།"
    },
    {
      "span": {
        "start": 34786,
        "end": 34796
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 35148,
        "end": 35152
      },
      "text": "དབབ་ ༼སྣར། པེ།༽ བཏབ་"
    },
    {
      "span": {
        "start": 35366,
        "end": 35374
      },
      "text": "དག་པ་ཡི། ༼སྣར། པེ།༽ དག་པ་ཡིས།"
    },
    {
      "span": {
        "start": 35498,
        "end": 35510
      },
      "text": "ཅོད་པན་གྱིས་ ༼སྣར། པེ།༽ ཅོད་པན་གྱི་"
    },
    {
      "span": {
        "start": 35616,
        "end": 35622
      },
      "text": "ཕབ་པས་ ༼སྣར། པེ།༽ ཕབ་པ་"
    },
    {
      "span": {
        "start": 35885,
        "end": 35917
      },
      "text": "ཡབ་ཡུམ་གྱིས་དབང་བསྐུར་བར་བསྒོམས་ ༼སྣར། པེ།༽ ཡབ་ཡུམ་གྱི་བསྐུར་སྒོམས་"
    },
    {
      "span": {
        "start": 36284,
        "end": 36316
      },
      "text": "གྱུར་པའི་རྡོ་རྗེ་དང་དྲིལ་བུའོ། ། ༼སྣར། པེ།༽ གྱུར་པའི་དྲིལ་བུས་"
    },
    {
      "span": {
        "start": 36356,
        "end": 36367
      },
      "text": "བསྐུར་རོ། ། ༼སྣར། པེ།༽ བསྐུར་"
    },
    {
      "span": {
        "start": 36739,
        "end": 36743
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 37087,
        "end": 37092
      },
      "text": "བཏགས་ ༼སྣར། པེ།༽ བརྟགས་"
    },
    {
      "span": {
        "start": 37143,
        "end": 37151
      },
      "text": "གནང་བའི་ ༼སྣར། པེ།༽ སྣང་བའི་"
    },
    {
      "span": {
        "start": 37162,
        "end": 37170
      },
      "text": "ཀྱེ་ཡིས་ ༼སྣར།༽ ཀྱེའི་ ༼པེ།༽ ཀྱེའོ་"
    },
    {
      "span": {
        "start": 37199,
        "end": 37207
      },
      "text": "མིང་གིས་ ༼སྣར། པེ།༽ མིང་གི་"
    },
    {
      "span": {
        "start": 37356,
        "end": 37363
      },
      "text": "ཞེས་པས་ ༼སྣར། པེ།༽ ཞེས་"
    },
    {
      "span": {
        "start": 37785,
        "end": 37798
      },
      "text": "། འདི་སྐད་དུ། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 37819,
        "end": 37823
      },
      "text": "ཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 37843,
        "end": 37854
      },
      "text": "ཐམས་ཅད་ཀྱི། ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱིས།"
    },
    {
      "span": {
        "start": 37863,
        "end": 37870
      },
      "text": "སྒྲ་ཡི་ ༼སྣར། པེ།༽ སྒྲ་ཡིས་"
    },
    {
      "span": {
        "start": 37917,
        "end": 37927
      },
      "text": "བྱང་ཆུབ་ང་ ༼སྣར། པེ།༽ བྱང་ཆུབ་"
    },
    {
      "span": {
        "start": 37927,
        "end": 37932
      },
      "text": "རྒྱལ་ ༼སྣར། པེ།༽ རྒྱལ་བ་"
    },
    {
      "span": {
        "start": 37990,
        "end": 37999
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 38009,
        "end": 38018
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ནས་"
    },
    {
      "span": {
        "start": 38048,
        "end": 38057
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་པ་"
    },
    {
      "span": {
        "start": 38147,
        "end": 38154
      },
      "text": "བསྟིམས་ ༼སྣར། པེ།༽ བལྟས་"
    },
    {
      "span": {
        "start": 38189,
        "end": 38194
      },
      "text": "སྤྱད་ ༼སྣར། པེ།༽ སྦྱངས་"
    },
    {
      "span": {
        "start": 38334,
        "end": 38342
      },
      "text": "བཞུགས་པ་ ༼སྣར།༽ བཞུག་པ་"
    },
    {
      "span": {
        "start": 38528,
        "end": 38537
      },
      "text": "སངས་རྒྱས་ ༼སྣར། པེ།༽ སངས་རྒྱས་བྱང་ཆུབ་"
    },
    {
      "span": {
        "start": 38879,
        "end": 38889
      },
      "text": "བསྒོམས་པས་ ༼སྣར།༽ བསྒོམ་པས་"
    },
    {
      "span": {
        "start": 39194,
        "end": 39199
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 39377,
        "end": 39383
      },
      "text": "འདབ་མ་ ༼སྣར། པེ།༽ འདབ་"
    },
    {
      "span": {
        "start": 39414,
        "end": 39420
      },
      "text": "མཚན་པ་ ༼སྣར། པེ།༽ མཚན་པ་ལ་"
    },
    {
      "span": {
        "start": 39503,
        "end": 39510
      },
      "text": "བཀླུབས་ ༼སྣར། པེ།༽ ཀླུབས་"
    },
    {
      "span": {
        "start": 39824,
        "end": 39833
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་ནི་"
    },
    {
      "span": {
        "start": 39860,
        "end": 39867
      },
      "text": "བཅད་ནི་ ༼སྣར། པེ།༽ སུ་བཅད་པ་"
    },
    {
      "span": {
        "start": 39952,
        "end": 39962
      },
      "text": "བྱུང་བ་ཡི། ༼པེ།༽ བྱུང་བ་ཡིས།"
    },
    {
      "span": {
        "start": 40118,
        "end": 40126
      },
      "text": "དེ་ཁོ་ན་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 40152,
        "end": 40160
      },
      "text": "བསྟན་ཏེ། ༼སྣར། པེ།༽ བསྟན་ཏོ།"
    },
    {
      "span": {
        "start": 40202,
        "end": 40210
      },
      "text": "དག་པ་ནི་ ༼སྣར། པེ།༽ དག་པ་"
    },
    {
      "span": {
        "start": 40236,
        "end": 40240
      },
      "text": "གནས་ ༼སྣར། པེ།༽ གནས་པ་"
    },
    {
      "span": {
        "start": 40439,
        "end": 40450
      },
      "text": "བཞི་རྣམ་པར་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 40529,
        "end": 40571
      },
      "text": "། །བསམ་གཏན་བཞི་རྣམ་པར་དག་པ་ནི་སྒོ་བཞིའོ། ། ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 40741,
        "end": 40760
      },
      "text": "ཡེ་ཤེས་ཀྱིས་ཀུན་ནས་ ༼སྣར། པེ།༽ ཡེ་ཤེས་ཀུན་"
    },
    {
      "span": {
        "start": 40857,
        "end": 40868
      },
      "text": "བཞི་རྣམ་པར་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 40888,
        "end": 40913
      },
      "text": "གཟུངས་ཀྱི་སྒོ་བཞི་རྣམ་པར་ ༼སྣར། པེ།༽ གཟུངས་རྣམ་པ་བཞི་"
    },
    {
      "span": {
        "start": 41047,
        "end": 41052
      },
      "text": "རྒྱན་ ༼སྣར། པེ།༽ བརྒྱན་"
    },
    {
      "span": {
        "start": 41187,
        "end": 41193
      },
      "text": "པའོ། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 41311,
        "end": 41319
      },
      "text": "དགའ་བའོ། ༼སྣར། པེ།༽ དགའོ།"
    },
    {
      "span": {
        "start": 41547,
        "end": 41553
      },
      "text": "དེ་ནས་ ༼སྣར། པེ།༽ དེ་ན་"
    },
    {
      "span": {
        "start": 42327,
        "end": 42336
      },
      "text": "རྩ་རྒྱུས་ ༼སྣར།༽ རྩ་རྒྱུད་"
    },
    {
      "span": {
        "start": 42596,
        "end": 42602
      },
      "text": "སྙན་པ་ ༼སྣར། པེ།༽ ཉན་པ་"
    },
    {
      "span": {
        "start": 42955,
        "end": 42963
      },
      "text": "སྒྱུར་བ་ ༼སྣར། པེ།༽ བསྒྱུར་བ་"
    },
    {
      "span": {
        "start": 42973,
        "end": 42981
      },
      "text": "མཛེས་ཏེ་ ༼སྣར། པེ།༽ མཛེས་"
    },
    {
      "span": {
        "start": 43278,
        "end": 43286
      },
      "text": "ལྷའི་དེ་ ༼སྣར། པེ།༽ ལྷའི་"
    },
    {
      "span": {
        "start": 43651,
        "end": 43660
      },
      "text": "སྟོང་སྟེ། ༼སྣར། པེ།༽ སྟོང་ཡིན།"
    },
    {
      "span": {
        "start": 43758,
        "end": 43770
      },
      "text": "སྦྱོར་བ་ཡིས། ༼སྣར། པེ།༽ སྦྱོར་བ་ཡི།"
    },
    {
      "span": {
        "start": 43772,
        "end": 43782
      },
      "text": "བསྒྲུབས་ན་ ༼སྣར། པེ།༽ བསྒྲུབས་ནས་"
    },
    {
      "span": {
        "start": 44047,
        "end": 44055
      },
      "text": "རིག་པའི་ ༼སྣར། པེ།༽ རིགས་པའི་"
    },
    {
      "span": {
        "start": 44180,
        "end": 44207
      },
      "text": "བདུད་རྩི་རྣམ་པ་ལྔ་དང་དྲིའི་ ༼སྣར། པེ།༽ དྲིའི་"
    },
    {
      "span": {
        "start": 44211,
        "end": 44219
      },
      "text": "བྱུགས་པ་ ༼སྣར། པེ།༽ བྱུག་པ་"
    },
    {
      "span": {
        "start": 44375,
        "end": 44385
      },
      "text": "རྒྱལ་སྲིད་ ༼སྣར། པེ།༽ རིན་པོ་ཆེ་"
    },
    {
      "span": {
        "start": 44404,
        "end": 44413
      },
      "text": "སྡུ་གུའི་ ༼སྣར། པེ།༽ སྡུག་གུའི་"
    },
    {
      "span": {
        "start": 44523,
        "end": 44531
      },
      "text": "ཞིམ་པའི་ ༼སྣར། པེ།༽ ཞིམ་པོའི་"
    },
    {
      "span": {
        "start": 44621,
        "end": 44629
      },
      "text": "ལོགས་པར་ ༼སྣར། པེ།༽ ལེགས་པར་"
    },
    {
      "span": {
        "start": 44648,
        "end": 44657
      },
      "text": "ཚོགས་ཀྱི་ ༼སྣར། པེ།༽ ཚོགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 45008,
        "end": 45025
      },
      "text": "ཉིད་ཀྱིས་མཉེས་པར་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 45159,
        "end": 45167
      },
      "text": "སྤྱད་པས་ ༼སྣར། པེ།༽ སྤྱོད་པས་"
    },
    {
      "span": {
        "start": 45275,
        "end": 45278
      },
      "text": "བས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 45305,
        "end": 45311
      },
      "text": "བསྐམས་ ༼སྣར། པེ།༽ སྐམས་"
    },
    {
      "span": {
        "start": 45487,
        "end": 45491
      },
      "text": "རླག་ ༼སྣར། པེ།༽ བརླག་"
    },
    {
      "span": {
        "start": 45662,
        "end": 45667
      },
      "text": "སྟོན་ ༼སྣར། པེ།༽ བསྟོད་"
    },
    {
      "span": {
        "start": 45730,
        "end": 45739
      },
      "text": "ཚོགས་ཀྱི་ ༼སྣར། པེ།༽ ཚོགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 45811,
        "end": 45818
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ མཐོང་"
    },
    {
      "span": {
        "start": 45846,
        "end": 45853
      },
      "text": "གཞག་པས་ ༼སྣར། པེ།༽ བཞག་པས་"
    },
    {
      "span": {
        "start": 46154,
        "end": 46164
      },
      "text": "སེམས་ཀྱིས་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 46507,
        "end": 46515
      },
      "text": "སྟོན་པར་ ༼སྣར། པེ།༽ སྟོད་པར་"
    },
    {
      "span": {
        "start": 47125,
        "end": 47132
      },
      "text": "གཙོ་བོ་ ༼སྣར། པེ།༽ གཙོ་བོས་"
    },
    {
      "span": {
        "start": 47587,
        "end": 47597
      },
      "text": "རྣམས་ཀྱིས་ ༼པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 48044,
        "end": 48052
      },
      "text": "སློབ་མས་ ༼སྣར། པེ།༽ སློབ་མ་"
    },
    {
      "span": {
        "start": 48110,
        "end": 48113
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 48143,
        "end": 48154
      },
      "text": "སྤངས་པ་ཡིས། ༼སྣར། པེ།༽ སྤངས་པ་ཡི།"
    },
    {
      "span": {
        "start": 48591,
        "end": 48597
      },
      "text": "ཕྱིའི་ ༼སྣར། པེ།༽ ཕྱི་མའི་"
    },
    {
      "span": {
        "start": 48676,
        "end": 48682
      },
      "text": "བསྐུར་ ༼སྣར། པེ།༽ སྐུར་"
    },
    {
      "span": {
        "start": 48847,
        "end": 48855
      },
      "text": "བསླབ་པར་ ༼པེ།༽ བརླབ་པར་"
    },
    {
      "span": {
        "start": 48868,
        "end": 48887
      },
      "text": "ཐུན་མོང་དང་ཐུན་མོང་ ༼སྣར། པེ།༽ ཐུན་མོང་"
    },
    {
      "span": {
        "start": 49038,
        "end": 49043
      },
      "text": "ཚོགས་ ༼སྣར། པེ།༽ རྫོགས་"
    },
    {
      "span": {
        "start": 49480,
        "end": 49490
      },
      "text": "སྤུན་གྱིས་ ༼སྣར། པེ།༽ ཡུན་གྱི་"
    },
    {
      "span": {
        "start": 50185,
        "end": 50190
      },
      "text": "རློམ་ ༼སྣར། པེ།༽ སློབ་"
    },
    {
      "span": {
        "start": 50792,
        "end": 50801
      },
      "text": "ཀུན་གྱིས་ ༼སྣར། པེ།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 51220,
        "end": 51229
      },
      "text": "མཐོང་བའམ་ ༼པེ།༽ མཐོ་བའམ་"
    },
    {
      "span": {
        "start": 51437,
        "end": 51497
      },
      "text": "། །སྲིད་པའི་སྡུག་བསྔལ་ལས་ཁྱོད་འདས། །སྲིད་པ་ཤིན་ཏུ་དག་པས་ན། ། ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 51502,
        "end": 51506
      },
      "text": "པའི་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 51571,
        "end": 51578
      },
      "text": "གྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 51578,
        "end": 51582
      },
      "text": "འདི། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 51707,
        "end": 51711
      },
      "text": "རྒྱ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 51920,
        "end": 51933
      },
      "text": "དཀའ་ཐུབ་ཀྱིས་ ༼སྣར། པེ།༽ དཀའ་ཐུབ་ཅི་"
    },
    {
      "span": {
        "start": 52730,
        "end": 52737
      },
      "text": "བྱིན་པ་ ༼སྣར། པེ།༽ སྦྱིན་པ་"
    },
    {
      "span": {
        "start": 53025,
        "end": 53034
      },
      "text": "རྒྱལ་བའི་ ༼སྣར། པེ།༽ རྒྱལ་པོའི་"
    },
    {
      "span": {
        "start": 53247,
        "end": 53256
      },
      "text": "བསྟེན་པར་ ༼སྣར། པེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 53635,
        "end": 53641
      },
      "text": "དང་། ། ༼སྣར། པེ།༽ སྡུག །"
    },
    {
      "span": {
        "start": 53661,
        "end": 53666
      },
      "text": "བྱ་ན། ༼སྣར། པེ།༽ བྱས་ནས།"
    },
    {
      "span": {
        "start": 54020,
        "end": 54024
      },
      "text": "ཟབས་ ༼སྣར། པེ།༽ ཟབས་ནི་"
    },
    {
      "span": {
        "start": 54024,
        "end": 54029
      },
      "text": "ཞི་བ་ ༼སྣར། པེ།༽ ཞི་"
    },
    {
      "span": {
        "start": 54114,
        "end": 54118
      },
      "text": "གྲུ་ ༼སྣར། པེ།༽ གྲྭ་"
    },
    {
      "span": {
        "start": 54144,
        "end": 54149
      },
      "text": "བཞིར་ ༼པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 54154,
        "end": 54176
      },
      "text": "ཕྱེད་པ་ལ་རྡོ་རྗེ་ཕྱེད་ ༼སྣར། པེ།༽ ཕྱེད་"
    },
    {
      "span": {
        "start": 54233,
        "end": 54236
      },
      "text": "ཐབ་ ༼སྣར། པེ།༽ ཐབས་"
    },
    {
      "span": {
        "start": 54240,
        "end": 54245
      },
      "text": "དབུས་ ༼སྣར། པེ།༽ དབུས་ཀྱི་"
    },
    {
      "span": {
        "start": 54303,
        "end": 54308
      },
      "text": "ལ་ནི་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 54618,
        "end": 54629
      },
      "text": "མཉམ་པར་བཅད་ ༼སྣར། པེ།༽ མཉམ་པོར་སྤྱད་"
    },
    {
      "span": {
        "start": 54713,
        "end": 54722
      },
      "text": "སུ་ཆང་གང་ ༼སྣར། པེ།༽ སུ་ཆགས་"
    },
    {
      "span": {
        "start": 54752,
        "end": 54755
      },
      "text": "ཤྭ་ ༼སྣར། པེ།༽ ཤོ་"
    },
    {
      "span": {
        "start": 54811,
        "end": 54887
      },
      "text": "ཚད་དུ་བྱའོ། །མངོན་སྤྱོད་ལ་སེང་ལྡེང་དང་པོ་སོན་ཆའི་ཤིང་ལས་སོར་བརྒྱད་པའི་ཚད་དུ་ ༼སྣར། པེ།༽ ཚད་དུ་"
    },
    {
      "span": {
        "start": 54991,
        "end": 55008
      },
      "text": "ནི་བ་ལང་གི་ཤ་ཡིས་ ༼སྣར། པེ།༽ ནི་ཕ་ཝང་གིས་ཤས་"
    },
    {
      "span": {
        "start": 55181,
        "end": 55196
      },
      "text": "དང་སྲེག་རྫས་དང་ ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 55201,
        "end": 55205
      },
      "text": "ཡོན་ ༼སྣར། པེ།༽ གཡོགས་"
    },
    {
      "span": {
        "start": 55228,
        "end": 55233
      },
      "text": "རྒྱན་ ༼སྣར། པེ།༽ རྒྱན་ཆ་"
    },
    {
      "span": {
        "start": 55415,
        "end": 55421
      },
      "text": "གསད་པ་ ༼སྣར།༽ བསད་པ་"
    },
    {
      "span": {
        "start": 55429,
        "end": 55437
      },
      "text": "ལྷོར་རོ། ༼སྣར། པེ།༽ དུ་བལྟའོ།"
    },
    {
      "span": {
        "start": 55626,
        "end": 55631
      },
      "text": "དཔངས་ ༼སྣར། པེ།༽ སྤངས་"
    },
    {
      "span": {
        "start": 55638,
        "end": 55641
      },
      "text": "གང་ ༼སྣར། པེ།༽ གང་བ་"
    },
    {
      "span": {
        "start": 56122,
        "end": 56128
      },
      "text": "སྐྱབས་ ༼སྣར། པེ།༽ བསྐྱབས་"
    },
    {
      "span": {
        "start": 56223,
        "end": 56228
      },
      "text": "བགྲང་ ༼ཅོ། པེ།༽ འགྲང་"
    },
    {
      "span": {
        "start": 56664,
        "end": 56682
      },
      "text": "གཤེད་ཀྱིས་སྐྱེས་པ་ ༼སྣར། པེ།༽ གཤེད་ཀྱིས་"
    },
    {
      "span": {
        "start": 56825,
        "end": 56832
      },
      "text": "དགུག་པ་ ༼སྣར། པེ།༽ དགུག་པ་ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 56999,
        "end": 57005
      },
      "text": "གསད་པ་ ༼སྣར། པེ།༽ བསད་པ་"
    },
    {
      "span": {
        "start": 57417,
        "end": 57423
      },
      "text": "ནི་ལས་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 57536,
        "end": 57586
      },
      "text": "གང་སོར་བཞི་ཟབས་སུ་དེའི་ཕྱེད། ཐབ་ཁུང་གི་ཕྱི་རོལ་དུ་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 58107,
        "end": 58116
      },
      "text": "གྲྭ་བཞིར་ ༼སྣར། པེ།༽ གྲུ་བཞིར་"
    },
    {
      "span": {
        "start": 58224,
        "end": 58242
      },
      "text": "རེའུ་མིག་བརྒྱད་དུ་ ༼སྣར། པེ།༽ རེའུ་མིག་དང་"
    },
    {
      "span": {
        "start": 58369,
        "end": 58371
      },
      "text": "ཏ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 58502,
        "end": 58509
      },
      "text": "ཉིད་དོ། ༼སྣར། པེ།༽ ཉིད་དེ།"
    },
    {
      "span": {
        "start": 58535,
        "end": 58545
      },
      "text": "ཡང་ཤིང་ལོ་ ༼སྣར། པེ།༽ ཡང་ཤིང་"
    },
    {
      "span": {
        "start": 58681,
        "end": 58701
      },
      "text": "རྫས་ནི་གཡོན་དུ་དགྲམ། ༼སྣར། པེ།༽ རྫས་"
    },
    {
      "span": {
        "start": 58757,
        "end": 58759
      },
      "text": "པ་ ༼སྣར། པེ།༽ པས་"
    },
    {
      "span": {
        "start": 58775,
        "end": 58785
      },
      "text": "བྱིན་གྱིས་ ༼སྣར། པེ།༽ བྱིན་"
    },
    {
      "span": {
        "start": 58820,
        "end": 58892
      },
      "text": "གང་སོར་བཞི་ཟབས་སུ་སོར་གཉིས་བླུགས་གཟར་རྒྱར་སོར་བཞི་ཟབས་སུ་སོར་གཉིས་མཆུ་ལ་ ༼སྣར། པེ།༽ གང་རྒྱར་"
    },
    {
      "span": {
        "start": 59008,
        "end": 59012
      },
      "text": "མཆུ་ ༼སྣར། པེ།༽ ཆུ་"
    },
    {
      "span": {
        "start": 59389,
        "end": 59397
      },
      "text": "སྨ་ར་ཡེ་ ༼སྣར། པེ།༽ སྨ་ར་རི་"
    },
    {
      "span": {
        "start": 59474,
        "end": 59476
      },
      "text": "ཡ་ ༼སྣར། པེ།༽ ཡེ་"
    },
    {
      "span": {
        "start": 59486,
        "end": 59496
      },
      "text": "ཤྭདྠའི་འོ། ༼སྣར། པེ།༽ ཤྭདྠའི་ཤྭཏྛའིའོ།"
    },
    {
      "span": {
        "start": 59693,
        "end": 59699
      },
      "text": "བསྔགས་ ༼སྣར། པེ།༽ སྔགས་"
    },
    {
      "span": {
        "start": 59791,
        "end": 59796
      },
      "text": "ཧེའི་ ༼སྣར། པེ།༽ ཧོའི་"
    },
    {
      "span": {
        "start": 59822,
        "end": 59831
      },
      "text": "ན་མ་ཧིའི་ ༼སྣར། པེ།༽ མ་ནི་ཧྲིའི་"
    },
    {
      "span": {
        "start": 59985,
        "end": 59995
      },
      "text": "ཡམ་ཤིང་དང་ ༼སྣར། པེ།༽ ཡམ་ཤིང་"
    },
    {
      "span": {
        "start": 60002,
        "end": 60012
      },
      "text": "བསྲེས་པའི་ ༼སྣར། པེ།༽ བསྲེགས་པའི་"
    },
    {
      "span": {
        "start": 61145,
        "end": 61148
      },
      "text": "པེ་ ༼སྣར། པེ།༽ པི་"
    },
    {
      "span": {
        "start": 61196,
        "end": 61200
      },
      "text": "དྱེ་ ༼སྣར།༽ བིདྱཱ་ ༼པེ།༽ བིདྱ་"
    },
    {
      "span": {
        "start": 61241,
        "end": 61255
      },
      "text": "དགང་བླུགས་ཀྱི་ ༼སྣར། པེ།༽ དགང་བླུགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 61265,
        "end": 61268
      },
      "text": "མར་ ༼སྣར། པེ།༽ མར་གྱི་"
    },
    {
      "span": {
        "start": 61474,
        "end": 61481
      },
      "text": "བྱ་བའོ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 61508,
        "end": 61515
      },
      "text": "བྱ་སྟེ། ༼སྣར། པེ།༽ བྱའོ། །"
    },
    {
      "span": {
        "start": 61686,
        "end": 61691
      },
      "text": "ལ་ཛྭ་ ༼སྣར། པེ།༽ རཾ་ཛ་"
    },
    {
      "span": {
        "start": 61725,
        "end": 61727
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནཱ་"
    },
    {
      "span": {
        "start": 61964,
        "end": 61973
      },
      "text": "རྡོ་རྗེར་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 62036,
        "end": 62039
      },
      "text": "མར་ ༼སྣར། པེ།༽ མར་གྱི་"
    },
    {
      "span": {
        "start": 62062,
        "end": 62067
      },
      "text": "དབུལ་ ༼སྣར། པེ།༽ འབུལ་"
    },
    {
      "span": {
        "start": 62315,
        "end": 62323
      },
      "text": "། དེ་ནས། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 62456,
        "end": 62461
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 62680,
        "end": 62689
      },
      "text": "། །དེ་ནས་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 62814,
        "end": 62820
      },
      "text": "རང་རང་ ༼སྣར། པེ།༽ རང་"
    },
    {
      "span": {
        "start": 62898,
        "end": 62914
      },
      "text": "མཆོད་པ་དང་བསྟོད་ ༼སྣར། པེ།༽ མཆོད་"
    },
    {
      "span": {
        "start": 62929,
        "end": 62934
      },
      "text": "ལ་མར་ ༼སྣར། པེ།༽ ལ་མར་གྱི་"
    },
    {
      "span": {
        "start": 63231,
        "end": 63239
      },
      "text": "སྔོན་དུ་ ༼སྣར། པེ།༽ མངོན་དུ་"
    },
    {
      "span": {
        "start": 63454,
        "end": 63463
      },
      "text": "ནུས་ཀྱིས་ ༼སྣར། པེ།༽ ནུས་ཀྱི་"
    },
    {
      "span": {
        "start": 63556,
        "end": 63565
      },
      "text": "གཞན་གྱིས་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 63859,
        "end": 63862
      },
      "text": "དང་ ༼སྣར། པེ།༽ དང་ལྡན་པ་"
    },
    {
      "span": {
        "start": 63992,
        "end": 64011
      },
      "text": "བརྐོས་པ་ལ་སོགས་པ་ལ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 64568,
        "end": 64571
      },
      "text": "ཞུ་ ༼སྣར། པེ།༽ ཞུས་"
    },
    {
      "span": {
        "start": 64636,
        "end": 64639
      },
      "text": "ཕབ། ༼སྣར། པེ།༽ ཕབ་པའོ། །"
    }
  ]
}