{
  "durchens": [
    {
      "span": {
        "start": 565,
        "end": 571
      },
      "text": "འཇོམས་ ༼སྣར། པེ།༽ འཇོམ་"
    },
    {
      "span": {
        "start": 1226,
        "end": 1232
      },
      "text": "བསྟོད། ༼སྣར།༽ སྟོད།"
    },
    {
      "span": {
        "start": 1234,
        "end": 1242
      },
      "text": "བདེ་ཆེན་ ༼སྣར། པེ།༽ རིན་ཆེན་"
    },
    {
      "span": {
        "start": 1477,
        "end": 1482
      },
      "text": "བྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 1809,
        "end": 1814
      },
      "text": "སྦུད། ༼སྣར། པེ།༽ སྤུངས།"
    },
    {
      "span": {
        "start": 1974,
        "end": 1983
      },
      "text": "འཕྲུལ་མོ་ ༼སྣར།༽ འཕྲུལ་མ་"
    },
    {
      "span": {
        "start": 2138,
        "end": 2144
      },
      "text": "བའོ། ། ༼སྣར།༽ ། །མངྒ་ལཾ་ ༼པེ།༽ ། །སརྦ་མངྒ་ལཾ།"
    }
  ]
}