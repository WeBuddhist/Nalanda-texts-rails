{
  "durchens": [
    {
      "span": {
        "start": 32,
        "end": 34
      },
      "text": "ཀ་ ༼སྣར། པེ།༽ ཀི་"
    },
    {
      "span": {
        "start": 401,
        "end": 410
      },
      "text": "མཐུན་གནས་ ༼སྣར། པེ།༽ མཐུན་ནས་"
    },
    {
      "span": {
        "start": 503,
        "end": 513
      },
      "text": "དང་པོ་བདག་ ༼སྣར།༽ དང་པོ་"
    },
    {
      "span": {
        "start": 2074,
        "end": 2083
      },
      "text": "བྱུང་བའི་ ༼སྣར། པེ།༽ བྱུང་གི་"
    },
    {
      "span": {
        "start": 2206,
        "end": 2215
      },
      "text": "ཐུགས་ཀའི་ ༼སྣར། པེ།༽ ཐུགས་ཀར་"
    },
    {
      "span": {
        "start": 2281,
        "end": 2286
      },
      "text": "སྐོར་ ༼སྣར།༽ བསྐོར་"
    },
    {
      "span": {
        "start": 2498,
        "end": 2503
      },
      "text": "མཛོད། ༼སྣར།༽ མཛད།"
    },
    {
      "span": {
        "start": 3114,
        "end": 3121
      },
      "text": "དཀྲུགས། ༼སྣར། པེ།༽ བཀུག།"
    },
    {
      "span": {
        "start": 3152,
        "end": 3157
      },
      "text": "འབུལ། ༼སྣར། པེ།༽ དབུལ།"
    },
    {
      "span": {
        "start": 3162,
        "end": 3164
      },
      "text": "ཨ་ ༼པེ།༽ ཨཱ་"
    },
    {
      "span": {
        "start": 3363,
        "end": 3365
      },
      "text": "ས་ ༼སྣར། པེ།༽ མུས་"
    }
  ]
}