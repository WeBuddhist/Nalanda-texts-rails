{
  "durchens": [
    {
      "span": {
        "start": 21,
        "end": 26
      },
      "text": "ས་ཏྱ་ ༼སྣར།༽ སཏྟྱ་"
    },
    {
      "span": {
        "start": 113,
        "end": 123
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 371,
        "end": 376
      },
      "text": "འཇིག་ ༼སྣར།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 564,
        "end": 572
      },
      "text": "ཚིག་གིས་ ༼སྣར། པེ།༽ ཚིག་གི་"
    },
    {
      "span": {
        "start": 1113,
        "end": 1118
      },
      "text": "སྤངས། ༼སྣར། པེ།༽ སྤོང་།"
    },
    {
      "span": {
        "start": 1637,
        "end": 1647
      },
      "text": "མེད་པ་ཡིས། ༼སྣར།༽ མེད་པ་ཡི།"
    },
    {
      "span": {
        "start": 2004,
        "end": 2014
      },
      "text": "འགྱུར་གྱི། ༼སྣར། པེ།༽ འགྱུར་གྱིས།"
    },
    {
      "span": {
        "start": 2315,
        "end": 2322
      },
      "text": "ཕུང་བར་ ༼སྣར། པེ།༽ འཕུང་བར་"
    },
    {
      "span": {
        "start": 2477,
        "end": 2486
      },
      "text": "རྟོགས་པས་ ༼སྣར།༽ རྟོག་པས་"
    },
    {
      "span": {
        "start": 3342,
        "end": 3347
      },
      "text": "གསུང་ ༼སྣར། པེ།༽ གསུངས་"
    },
    {
      "span": {
        "start": 3842,
        "end": 3849
      },
      "text": "ཕབ། །། ༼སྣར། པེ།༽ ཕབཕབ་པའོ། །།"
    }
  ]
}