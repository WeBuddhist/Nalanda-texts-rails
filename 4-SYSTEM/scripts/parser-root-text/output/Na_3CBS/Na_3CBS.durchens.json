{
  "durchens": [
    {
      "span": {
        "start": 330,
        "end": 340
      },
      "text": "སྒྲིབ་པའི་ ༼སྣར། པེ།༽ སྒྲིབ་པ་"
    },
    {
      "span": {
        "start": 373,
        "end": 389
      },
      "text": "། །སྐྱེ་བོ་འགྲོ་ ༼སྣར། པེ།༽ ། །པ་འགྲོན་"
    },
    {
      "span": {
        "start": 400,
        "end": 414
      },
      "text": "འབྱུང་བའི་གནས། ༼སྣར། པེ།༽ འབྱུང་བའི་ལམ།"
    },
    {
      "span": {
        "start": 462,
        "end": 488
      },
      "text": "རྒྱལ་སྲིད་མཚོ་ལས་རྒལ་ཅིང་། ༼སྣར། པེ།༽ རྒྱལ་སྲིད་འཚོ་ལས་བརྒལ།"
    },
    {
      "span": {
        "start": 962,
        "end": 968
      },
      "text": "བསྐོར་ ༼སྣར། པེ།༽ དཀོར་"
    },
    {
      "span": {
        "start": 997,
        "end": 1006
      },
      "text": "མཚམས་མེད་ ༼སྣར།༽ མཚན་མེད་"
    },
    {
      "span": {
        "start": 1028,
        "end": 1033
      },
      "text": "རྣམས། ༼སྣར། པེ།༽ བགྱིས།"
    },
    {
      "span": {
        "start": 1066,
        "end": 1072
      },
      "text": "བསྡམས། ༼སྣར། པེ།༽ བསྡམ།"
    },
    {
      "span": {
        "start": 1311,
        "end": 1315
      },
      "text": "སླད་ ༼སྣར།༽ སྨད་"
    },
    {
      "span": {
        "start": 1518,
        "end": 1527
      },
      "text": "བསྐྱབ་ཏུ་ ༼སྣར།༽ བསྐྱབ་དུ་"
    },
    {
      "span": {
        "start": 1534,
        "end": 1542
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 1605,
        "end": 1609
      },
      "text": "བསབ་ ༼སྣར།༽ གསག་ ༼པེ།༽ གསབ་"
    },
    {
      "span": {
        "start": 1666,
        "end": 1674
      },
      "text": "མཆོག་ཏུ་ ༼སྣར།༽ མཆོག་དུ་"
    },
    {
      "span": {
        "start": 1678,
        "end": 1689
      },
      "text": "ཀུན་བསྐྱེད། ༼སྣར། པེ།༽ ཀུན་མཁྱེན།"
    },
    {
      "span": {
        "start": 1741,
        "end": 1748
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 1821,
        "end": 1825
      },
      "text": "དེང་ ༼སྣར།༽ དེར་"
    },
    {
      "span": {
        "start": 1837,
        "end": 1845
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 1872,
        "end": 1880
      },
      "text": "ཆོས་གནས་ ༼སྣར། པེ།༽ མཆོད་གནས་"
    },
    {
      "span": {
        "start": 1919,
        "end": 1930
      },
      "text": "བགྱི་བགྱིས་ ༼སྣར། པེ།༽ དགྱེས་བགྱིད་"
    },
    {
      "span": {
        "start": 2099,
        "end": 2104
      },
      "text": "འགྲོ་ ༼སྣར།༽ གྲོ་"
    },
    {
      "span": {
        "start": 2234,
        "end": 2240
      },
      "text": "སྤྱོད་ ༼སྣར།༽ སྦྱོང་"
    },
    {
      "span": {
        "start": 2298,
        "end": 2303
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 2597,
        "end": 2600
      },
      "text": "བས་ ༼སྣར།༽ དང་"
    }
  ]
}