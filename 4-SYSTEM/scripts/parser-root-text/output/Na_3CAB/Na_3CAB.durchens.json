{
  "durchens": [
    {
      "span": {
        "start": 25,
        "end": 32
      },
      "text": "འཚལ་ལོ། ༼པེ།༽ འཚལ་ཏེ།"
    },
    {
      "span": {
        "start": 54,
        "end": 59
      },
      "text": "འཇིག་ ༼སྣར། པེ།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 110,
        "end": 117
      },
      "text": "བསྒོམས་ ༼སྣར།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 131,
        "end": 136
      },
      "text": "རྒྱུ་ ༼སྣར།༽ བརྒྱུད་ ༼པེ།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 164,
        "end": 186
      },
      "text": "དཀྱིལ་འཁོར་བསྐྱེད། །མ་ ༼སྣར།༽ དཀྱིལ་འཁོར་བསྐྱེད། མཾ་ ༼པེ།༽ དལ་བསྐྱེད་དེ། སཾ་"
    },
    {
      "span": {
        "start": 336,
        "end": 340
      },
      "text": "བྱད་ ༼སྣར།༽ བྱས་"
    },
    {
      "span": {
        "start": 608,
        "end": 613
      },
      "text": "མངོན་ ༼པེ།༽ སྔོན་"
    },
    {
      "span": {
        "start": 641,
        "end": 646
      },
      "text": "རྫུས་ ༼པེ།༽ བརྫུས་"
    },
    {
      "span": {
        "start": 774,
        "end": 784
      },
      "text": "བརྡབས་པའི་ ༼སྣར། པེ།༽ བརྡབས་པས་"
    },
    {
      "span": {
        "start": 789,
        "end": 794
      },
      "text": "འཇིག་ ༼སྣར། པེ།༽ འཇིགས་"
    }
  ]
}