{
  "durchens": [
    {
      "span": {
        "start": 274,
        "end": 288
      },
      "text": "ནི་གང་ཡང་རུང་། ༼སྣར། པེ།༽ ནི་ལ་ལ་རུ།"
    },
    {
      "span": {
        "start": 309,
        "end": 318
      },
      "text": "བཀྲམ་སྟེ། ༼སྣར། པེ།༽ བཀྲམ་ཏེ།"
    },
    {
      "span": {
        "start": 320,
        "end": 330
      },
      "text": "སྤོས་ཀྱིས་ ༼སྣར། པེ།༽ སྤོས་ཀྱི་"
    },
    {
      "span": {
        "start": 417,
        "end": 425
      },
      "text": "ཅན་གྱིས་ ༼སྣར། པེ།༽ ཅན་གྱི་"
    },
    {
      "span": {
        "start": 476,
        "end": 486
      },
      "text": "ཚོགས་ཀྱིས་ ༼སྣར། པེ།༽ ཚོགས་ཀྱི་"
    },
    {
      "span": {
        "start": 540,
        "end": 547
      },
      "text": "དེ་བདག་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 903,
        "end": 925
      },
      "text": "བདག་ཉིད་ཡི་དམ་སྒྲོལ་མ་ ༼སྣར། པེ།༽ བདག་ཉིད་"
    },
    {
      "span": {
        "start": 1309,
        "end": 1318
      },
      "text": "མཁྲེགས་པ་ ༼སྣར། པེ།༽ མཁྲེང་བ་"
    },
    {
      "span": {
        "start": 1391,
        "end": 1460
      },
      "text": "ཀྱིས་རྗེ་བཙུན་མ་ཡང་དག་པར་བསྐུལ་ལ། ས་བོན་ལས་བྱུང་བའི་མཆོད་པ་རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ ཀྱིས་ཡེ་ཤེས་སེམས་དཔའ་བཀུག་སྟེ་"
    },
    {
      "span": {
        "start": 1760,
        "end": 1771
      },
      "text": "བཀོད་པར་བྱ། ༼སྣར། པེ།༽ བཀོད་དེ།"
    },
    {
      "span": {
        "start": 1984,
        "end": 1991
      },
      "text": "ཐམས་ཅད་ ༼སྣར།༽ ཐམས་ཅད་དྲངས་ ༼པེ།༽ ཐམས་ཅད་དྲང་"
    },
    {
      "span": {
        "start": 1991,
        "end": 1997
      },
      "text": "ལ་ཕོག་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 2021,
        "end": 2030
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 2046,
        "end": 2050
      },
      "text": "བལྟ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 2181,
        "end": 2190
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 2449,
        "end": 2456
      },
      "text": "གསོལ་བ་ ༼སྣར། པེ།༽ གསོལ་"
    },
    {
      "span": {
        "start": 2507,
        "end": 2515
      },
      "text": "གསོལ་ལོ། ༼སྣར།༽ གསོལ།"
    },
    {
      "span": {
        "start": 2542,
        "end": 2551
      },
      "text": "བསྒོམས་ན་ ༼སྣར། པེ།༽ བསྒོམས་ནས་"
    },
    {
      "span": {
        "start": 2556,
        "end": 2573
      },
      "text": "བར་དངོས་གྲུབ་ཐོབ་ ༼སྣར། པེ།༽ བར་འགྲུབ་"
    },
    {
      "span": {
        "start": 2592,
        "end": 2602
      },
      "text": "བསྲུང་བའི་ ༼སྣར། པེ།༽ སྲུང་བའི་"
    },
    {
      "span": {
        "start": 2819,
        "end": 2826
      },
      "text": "བཟླས་པ་ ༼སྣར།༽ ཟླས་པ་"
    },
    {
      "span": {
        "start": 3023,
        "end": 3028
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 3055,
        "end": 3062
      },
      "text": "སྲུང་བ་ ༼སྣར། པེ།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 3229,
        "end": 3236
      },
      "text": "གྲོལ་བ་ ༼སྣར། པེ།༽ གྲོལ་བར་"
    },
    {
      "span": {
        "start": 3376,
        "end": 3383
      },
      "text": "སྐྱོ་བ་ ༼སྣར། པེ།༽ སྐྱོ་"
    },
    {
      "span": {
        "start": 3543,
        "end": 3549
      },
      "text": "ཏུ་རེ་ ༼སྣར། པེ།༽ ཏུ་རེ་སྭཱ་ཧཱ་"
    },
    {
      "span": {
        "start": 3570,
        "end": 3572
      },
      "text": "ན། ༼སྣར། པེ།༽ དུཥྚན།"
    },
    {
      "span": {
        "start": 3603,
        "end": 3608
      },
      "text": "མོ་ཧ་ ༼སྣར། པེ།༽ མ་ཧཱ་"
    },
    {
      "span": {
        "start": 3783,
        "end": 3787
      },
      "text": "དོར་ ༼སྣར། པེ།༽ བོར་"
    },
    {
      "span": {
        "start": 3795,
        "end": 3804
      },
      "text": "དྲན་པ་དང་ ༼སྣར།༽ དྲན་པར་ ༼པེ།༽ དྲན་པ་"
    },
    {
      "span": {
        "start": 3818,
        "end": 3827
      },
      "text": "ཆོམ་རྐུན་ ༼སྣར། པེ།༽ ཆོམ་རྐུན་པ་"
    },
    {
      "span": {
        "start": 3879,
        "end": 3881
      },
      "text": "བ་ ༼སྣར།༽ བར་"
    },
    {
      "span": {
        "start": 3994,
        "end": 4002
      },
      "text": "ཡུན་རིང་ ༼སྣར། པེ།༽ ཡུན་རིངས་"
    },
    {
      "span": {
        "start": 4201,
        "end": 4216
      },
      "text": "མཛད་པ་རྫོགས་སོ། ༼སྣར། པེ།༽ མཛད།"
    }
  ]
}