{
  "durchens": [
    {
      "span": {
        "start": 225,
        "end": 230
      },
      "text": "རལླི་ ༼སྣར། པེ།༽ ཨཱཿཨ་ར་ལི་"
    },
    {
      "span": {
        "start": 682,
        "end": 687
      },
      "text": "ལྤགས་ ༼སྣར།༽ པགས་"
    },
    {
      "span": {
        "start": 911,
        "end": 924
      },
      "text": "བསྐྱོད་པ་ཡིས་ ༼སྣར། པེ།༽ བསྐྱོད་པ་ཡི་"
    },
    {
      "span": {
        "start": 1306,
        "end": 1314
      },
      "text": "གཅིག་གི་ ༼སྣར། པེ།༽ གཅིག་གིས་"
    },
    {
      "span": {
        "start": 1514,
        "end": 1519
      },
      "text": "སོ། ། ༼སྣར། པེ།༽ ། །སློབ་དཔོན་འཕགས་པ་ཀླུ་སྒྲུབ་ཞབས་ཀྱིས་བོད་ནས་གདན་དྲངས་པའོ།། །།"
    }
  ]
}