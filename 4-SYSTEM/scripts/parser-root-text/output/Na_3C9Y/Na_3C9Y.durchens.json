{
  "durchens": [
    {
      "span": {
        "start": 169,
        "end": 173
      },
      "text": "སྒྲ་ ༼སྣར། པེ།༽ དགྲ་"
    },
    {
      "span": {
        "start": 304,
        "end": 309
      },
      "text": "མདུང་ ༼པེ།༽ གདུང་"
    },
    {
      "span": {
        "start": 433,
        "end": 439
      },
      "text": "སྲུངས། ༼སྣར། པེ།༽ བསྲུངས།"
    },
    {
      "span": {
        "start": 802,
        "end": 807
      },
      "text": "ཁེངས་ ༼སྣར། པེ།༽ ཁེང་"
    },
    {
      "span": {
        "start": 820,
        "end": 827
      },
      "text": "འོ་དོད་ ༼སྣར། པེ།༽ འོད་འདོད་"
    },
    {
      "span": {
        "start": 932,
        "end": 939
      },
      "text": "དགོད་པ་ ༼སྣར། པེ།༽ རྒོད་པ་"
    },
    {
      "span": {
        "start": 939,
        "end": 943
      },
      "text": "ཡིས་ ༼སྣར། པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 995,
        "end": 1001
      },
      "text": "སྐྱེས་ ༼སྣར། པེ།༽ སྐྱེ་"
    },
    {
      "span": {
        "start": 1051,
        "end": 1059
      },
      "text": "སྲུང་བར་ ༼སྣར། པེ།༽ བསྲུང་བར་"
    },
    {
      "span": {
        "start": 1186,
        "end": 1189
      },
      "text": "ཏི་ ༼སྣར། པེ།༽ རཾ་"
    },
    {
      "span": {
        "start": 1473,
        "end": 1478
      },
      "text": "རྩོད་ ༼སྣར། པེ།༽ རྩོ་"
    },
    {
      "span": {
        "start": 1616,
        "end": 1626
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 1631,
        "end": 1635
      },
      "text": "ཀྱི་ ༼སྣར།༽ ཀྱིས་"
    },
    {
      "span": {
        "start": 2252,
        "end": 2260
      },
      "text": "དུ་གཅོད་ ༼སྣར། པེ།༽ ཏུ་གནོད་"
    },
    {
      "span": {
        "start": 2264,
        "end": 2269
      },
      "text": "གེགས་ ༼སྣར། པེ།༽ བགེགས་"
    },
    {
      "span": {
        "start": 2400,
        "end": 2404
      },
      "text": "བསལ་ ༼སྣར། པེ།༽ གསལ་"
    },
    {
      "span": {
        "start": 2886,
        "end": 2893
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    }
  ]
}