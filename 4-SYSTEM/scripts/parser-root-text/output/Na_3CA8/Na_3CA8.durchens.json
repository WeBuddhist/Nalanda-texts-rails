{
  "durchens": [
    {
      "span": {
        "start": 300,
        "end": 304
      },
      "text": "དཀར་ ༼ཅོ། སྡེ།༽ ཧྲཱིཿདཀར་ ༼པེ།༽ ཧྲི་དཀར་"
    },
    {
      "span": {
        "start": 307,
        "end": 312
      },
      "text": "གཅིག་ ༼སྣར།༽ ཞིག་"
    },
    {
      "span": {
        "start": 351,
        "end": 357
      },
      "text": "རི་པོ་ ༼སྣར། པེ།༽ རི་པོ་པོ་"
    },
    {
      "span": {
        "start": 453,
        "end": 460
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 1073,
        "end": 1086
      },
      "text": "དཔག་མེད་ཀྱིས་ ༼པེ།༽ དཔག་མེད་ཀྱི་"
    },
    {
      "span": {
        "start": 1277,
        "end": 1280
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ཧྲི་ལས་"
    },
    {
      "span": {
        "start": 1421,
        "end": 1430
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 1473,
        "end": 1481
      },
      "text": "ཟློས་པར་ ༼སྣར།༽ ཟློས་པ་ ༼པེ།༽ ཟློས་པས་"
    },
    {
      "span": {
        "start": 1730,
        "end": 1738
      },
      "text": "ཉུང་ངུར་ ༼སྣར། པེ།༽ ཉུང་ངུ་"
    }
  ]
}