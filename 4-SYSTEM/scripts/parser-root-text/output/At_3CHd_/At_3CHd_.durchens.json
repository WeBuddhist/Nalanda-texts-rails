{
  "durchens": [
    {
      "span": {
        "start": 273,
        "end": 280
      },
      "text": "ཕྱེ་མས་ ༼སྣར། པེ།༽ ཕྱེ་མ་"
    },
    {
      "span": {
        "start": 394,
        "end": 399
      },
      "text": "གཟིག་ ༼སྣར། པེ།༽ གཟིགས་"
    },
    {
      "span": {
        "start": 410,
        "end": 418
      },
      "text": "སྨྱུག་མ་ ༼སྣར། པེ།༽ སྙུག་མ་"
    },
    {
      "span": {
        "start": 653,
        "end": 662
      },
      "text": "གང་བ་ཅིག་ ༼སྣར། པེ།༽ གང་བ་གཅིག་"
    },
    {
      "span": {
        "start": 682,
        "end": 687
      },
      "text": "བཏོད་ ༼སྣར། པེ།༽ བསྟོད་"
    },
    {
      "span": {
        "start": 997,
        "end": 999
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 1089,
        "end": 1099
      },
      "text": "བདུན་པོའི་ ༼སྣར། པེ།༽ བདུན་པའི་"
    },
    {
      "span": {
        "start": 1107,
        "end": 1109
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་སྙིང་པོ་"
    },
    {
      "span": {
        "start": 1174,
        "end": 1192
      },
      "text": "ཚོགས་ཁྱེ། ངར་རྟུལ། ༼སྣར།༽ ཚོགས་ཁྱེད་དར་བརྟུལ། ༼པེ།༽ ཚོགས་ཁྱེ་དར་བརྟུལ། །"
    },
    {
      "span": {
        "start": 1206,
        "end": 1216
      },
      "text": "བརྗོད་ཅིང་ ༼སྣར། པེ།༽ བརྗོད་"
    },
    {
      "span": {
        "start": 1350,
        "end": 1354
      },
      "text": "མཉེ་ ༼སྣར། པེ།༽ བསྙེ་"
    },
    {
      "span": {
        "start": 1368,
        "end": 1376
      },
      "text": "ལན་གཅིག་ ༼སྣར། པེ།༽ ལན་ཅིག་"
    },
    {
      "span": {
        "start": 1586,
        "end": 1595
      },
      "text": "བརྒྱད་པོ་ ༼སྣར། པེ།༽ བརྒྱད་པོ་ལ་"
    },
    {
      "span": {
        "start": 1624,
        "end": 1631
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ དེ་ལྟར་ཕྱོགས་མ་ནོར་བར་བཏང་དེ་ལྟར་"
    },
    {
      "span": {
        "start": 1797,
        "end": 1802
      },
      "text": "ཕྱེད་ ༼སྣར། པེ།༽ ཕྱེ་"
    },
    {
      "span": {
        "start": 1854,
        "end": 1860
      },
      "text": "བསྐྱར་ ༼སྣར། པེ།༽ བསྐྱལ་"
    }
  ]
}