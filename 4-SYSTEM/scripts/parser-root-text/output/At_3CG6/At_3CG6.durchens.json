{
  "durchens": [
    {
      "span": {
        "start": 39,
        "end": 44
      },
      "text": "ནཱ་མ། ༼པེ།༽ ནཱ་མ་།"
    },
    {
      "span": {
        "start": 202,
        "end": 211
      },
      "text": "རིགས་ཆེན་ ༼སྣར། པེ།༽ རིགས་ཅན་"
    },
    {
      "span": {
        "start": 233,
        "end": 244
      },
      "text": "ཡོན་ཏན་དང་། ༼སྣར། པེ།༽ ཡོན་ཏན་ཅན།"
    },
    {
      "span": {
        "start": 525,
        "end": 531
      },
      "text": "དེ་ལས་ ༼ཅོ། སྡེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 1343,
        "end": 1346
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 1422,
        "end": 1428
      },
      "text": "འཇིགས་ ༼པེ།༽ འཇིག་"
    },
    {
      "span": {
        "start": 1736,
        "end": 1746
      },
      "text": "དྲི་མེད་མ། ༼སྣར། པེ།༽ དྲི་མེད་པ།"
    },
    {
      "span": {
        "start": 1894,
        "end": 1900
      },
      "text": "སྐྱོང་ ༼སྣར། པེ།༽ བསྐྱོང་"
    },
    {
      "span": {
        "start": 1920,
        "end": 1929
      },
      "text": "བསྒོམ་པར་ ༼སྣར།༽ བསྒོམས་པར་ ༼པེ།༽ སྒོམ་པར་"
    },
    {
      "span": {
        "start": 2075,
        "end": 2089
      },
      "text": "བསྒོམས་བསྟིམས་ ༼སྣར། པེ།༽ བསྒོམ་སྟིམ་"
    },
    {
      "span": {
        "start": 2134,
        "end": 2145
      },
      "text": "ཇི་བཞིན་པར། ༼སྣར། པེ།༽ ཇི་བཞིན་དུ།"
    },
    {
      "span": {
        "start": 2246,
        "end": 2252
      },
      "text": "དྲང་པ་ ༼སྣར། པེ།༽ བགྲང་བ་"
    },
    {
      "span": {
        "start": 2310,
        "end": 2317
      },
      "text": "བརྩེགས་ ༼སྣར། པེ།༽ བརྩེག་"
    },
    {
      "span": {
        "start": 2475,
        "end": 2484
      },
      "text": "དགོངས་པར་ ༼སྣར། པེ།༽ དགྱེས་པར་"
    },
    {
      "span": {
        "start": 2555,
        "end": 2562
      },
      "text": "བསྐྱེད་ ༼སྣར།༽ བཀྱེ་ ༼པེ།༽ བཀྱེད་"
    },
    {
      "span": {
        "start": 2723,
        "end": 2727
      },
      "text": "དྱེ་ ༼སྣར། པེ།༽ དྱ་"
    },
    {
      "span": {
        "start": 2992,
        "end": 3005
      },
      "text": "རང་དོན་དུ་ནི་ ༼སྣར། པེ།༽ རང་དོན་"
    },
    {
      "span": {
        "start": 3054,
        "end": 3064
      },
      "text": "སྒྲུབ་པའི་ ༼པེ།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 3082,
        "end": 3089
      },
      "text": "ཤིབ་བུ་ ༼སྣར། པེ།༽ ཤུབ་བུ་"
    },
    {
      "span": {
        "start": 3106,
        "end": 3115
      },
      "text": "ཡིད་ཀྱིས་ ༼སྣར། པེ།༽ ཡིད་ཀྱི་"
    },
    {
      "span": {
        "start": 3128,
        "end": 3132
      },
      "text": "བཞི། ༼སྣར། པེ།༽ བཞིན།"
    },
    {
      "span": {
        "start": 3140,
        "end": 3151
      },
      "text": "སྒྲ་དང་སྒྲ་ ༼སྣར།༽ སྒྲ་"
    },
    {
      "span": {
        "start": 3218,
        "end": 3225
      },
      "text": "གཏོང་མ་ ༼སྣར། པེ།༽ གཏོང་ན་"
    },
    {
      "span": {
        "start": 3243,
        "end": 3248
      },
      "text": "བཏང་། ༼སྣར། པེ།༽ གཏང་།"
    },
    {
      "span": {
        "start": 3420,
        "end": 3429
      },
      "text": "རླུང་གིས་ ༼སྣར། པེ།༽ རླུང་གི་"
    },
    {
      "span": {
        "start": 3500,
        "end": 3504
      },
      "text": "ཡིས། ༼སྣར། པེ།༽ ཡི།"
    },
    {
      "span": {
        "start": 3556,
        "end": 3561
      },
      "text": "བཞིན། ༼སྣར། པེ།༽ ཞིང་།"
    },
    {
      "span": {
        "start": 3741,
        "end": 3744
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 3820,
        "end": 3832
      },
      "text": "འཁྲུགས་པ་ཡི་ ༼སྣར། པེ།༽ འཁྲུགས་པ་ཡིས་"
    }
  ]
}