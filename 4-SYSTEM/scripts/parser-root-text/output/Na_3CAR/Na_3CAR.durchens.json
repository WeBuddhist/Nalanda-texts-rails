{
  "durchens": [
    {
      "span": {
        "start": 349,
        "end": 358
      },
      "text": "བརྗོད་པས་ ༼སྣར། པེ།༽ བརྗོད་"
    },
    {
      "span": {
        "start": 397,
        "end": 403
      },
      "text": "དེ་ནས་ ༼སྣར། པེ།༽ དེས་ན་"
    },
    {
      "span": {
        "start": 1287,
        "end": 1294
      },
      "text": "སེར་མོ་ ༼སྣར། པེ།༽ སེར་པོ་"
    },
    {
      "span": {
        "start": 1415,
        "end": 1418
      },
      "text": "ཤོ་ ༼སྣར། པེ།༽ ཤྭ་"
    },
    {
      "span": {
        "start": 1588,
        "end": 1598
      },
      "text": "སྒྱུར་བའི་ ༼སྣར། པེ།༽ བསྒྱུར་བའི་"
    },
    {
      "span": {
        "start": 1834,
        "end": 1841
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ བརྟན་པ་"
    },
    {
      "span": {
        "start": 1995,
        "end": 2003
      },
      "text": "སྤྲོས་པ་ ༼སྣར། པེ།༽ སྤྲོས་པ་མེད་པ་"
    },
    {
      "span": {
        "start": 2013,
        "end": 2018
      },
      "text": "བསམས། ༼སྣར། པེ།༽ བསམ།"
    },
    {
      "span": {
        "start": 2091,
        "end": 2103
      },
      "text": "རང་བཞིན་གྱི་ ༼སྣར། པེ།༽ རང་བཞིན་གྱིས་"
    },
    {
      "span": {
        "start": 2279,
        "end": 2286
      },
      "text": "བར་བསམ། ༼སྣར། པེ།༽ བར་གྱུར་པར་བསམས་"
    },
    {
      "span": {
        "start": 2406,
        "end": 2416
      },
      "text": "སྡིག་པ་དང་ ༼སྣར། པེ།༽ སྡིག་པ་"
    },
    {
      "span": {
        "start": 2520,
        "end": 2525
      },
      "text": "དཔོག་ ༼སྣར། པེ།༽ དཔོགས་"
    },
    {
      "span": {
        "start": 2594,
        "end": 2604
      },
      "text": "ངུར་སྨྲིག་ ༼སྣར། པེ།༽ ངུར་སྨྲིག་ཅན་"
    },
    {
      "span": {
        "start": 3028,
        "end": 3033
      },
      "text": "ལྕོག་ ༼སྣར། པེ།༽ ལྕོགས་"
    },
    {
      "span": {
        "start": 3144,
        "end": 3158
      },
      "text": "བཙོ་མའི་ཁ་དོག་ ༼སྣར། པེ།༽ བཙོ་མའི་མདོག་"
    },
    {
      "span": {
        "start": 3169,
        "end": 3183
      },
      "text": "ལ་བསྣམས་པའོ། ། ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 3188,
        "end": 3191
      },
      "text": "དུ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 3258,
        "end": 3262
      },
      "text": "བལྟ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 4172,
        "end": 4184
      },
      "text": "འོ་མས་དགང་བ་ ༼སྣར། པེ།༽ འོ་མ་མགོད་པ་"
    },
    {
      "span": {
        "start": 4403,
        "end": 4407
      },
      "text": "རྫས་ ༼སྣར།༽ བརྫས་"
    },
    {
      "span": {
        "start": 5062,
        "end": 5067
      },
      "text": "བྱའོ། ༼སྣར།༽ བྱ།"
    },
    {
      "span": {
        "start": 5566,
        "end": 5568
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལ་ཕབ་པའོ་དགེ་ལེགས་འཕེལ་གྱུར་ཅིག།"
    }
  ]
}