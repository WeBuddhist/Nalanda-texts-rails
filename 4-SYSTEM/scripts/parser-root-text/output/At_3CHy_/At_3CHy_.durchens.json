{
  "durchens": [
    {
      "span": {
        "start": 25,
        "end": 29
      },
      "text": "ཀརྨ་ ༼སྣར། པེ།༽ ཀརྨཱ་"
    },
    {
      "span": {
        "start": 105,
        "end": 113
      },
      "text": "འཇོམས་པ་ ༼སྣར། པེ།༽ སྦྱོང་པ་"
    },
    {
      "span": {
        "start": 342,
        "end": 350
      },
      "text": "བརྟེན། ། ༼སྣར། པེ།༽ བསྟེན །"
    },
    {
      "span": {
        "start": 443,
        "end": 448
      },
      "text": "མཐུན་ ༼སྣར། པེ།༽ འཐུན་"
    },
    {
      "span": {
        "start": 815,
        "end": 820
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 967,
        "end": 974
      },
      "text": "ཡོ་ལོང་ ༼སྣར། པེ།༽ ཡོ་ལང་"
    },
    {
      "span": {
        "start": 981,
        "end": 988
      },
      "text": "དག་གིས་ ༼སྣར། པེ།༽ དག་གི་"
    },
    {
      "span": {
        "start": 1060,
        "end": 1069
      },
      "text": "ཚིག་རྐྱང་ ༼སྣར། པེ།༽ ཚིག་ཀྱང་"
    },
    {
      "span": {
        "start": 1373,
        "end": 1379
      },
      "text": "བསང་བ་ ༼སྣར། པེ།༽ གསང་བ་"
    },
    {
      "span": {
        "start": 1605,
        "end": 1617
      },
      "text": "འདབ་མ་བརྒྱད་ ༼སྣར། པེ།༽ འདབ་མ་"
    },
    {
      "span": {
        "start": 1617,
        "end": 1619
      },
      "text": "པ་ ༼སྣར། པེ།༽ པ་བརྒྱད་"
    },
    {
      "span": {
        "start": 1817,
        "end": 1822
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ གཞན། །བསྲུང་"
    },
    {
      "span": {
        "start": 1880,
        "end": 1890
      },
      "text": "སྐུ་གཟུངས་ ༼སྣར། པེ།༽ སྐུ་གཟུགས་"
    },
    {
      "span": {
        "start": 2178,
        "end": 2181
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 2291,
        "end": 2296
      },
      "text": "བེའུ་ ༼སྣར། པེ།༽ བེ་"
    },
    {
      "span": {
        "start": 2556,
        "end": 2566
      },
      "text": "སེམས་དཔའི་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 2590,
        "end": 2601
      },
      "text": "རྒྱབ་བརྟེན་ ༼སྣར། པེ།༽ རྒྱབ་རྟེན་"
    },
    {
      "span": {
        "start": 3007,
        "end": 3016
      },
      "text": "བརྩམ་པའི་ ༼སྣར། པེ།༽ རྩོམ་པའི་"
    },
    {
      "span": {
        "start": 3128,
        "end": 3134
      },
      "text": "བརྡེག་ ༼སྣར། པེ།༽ བརྡེགས་"
    },
    {
      "span": {
        "start": 3273,
        "end": 3281
      },
      "text": "སྦྱིན་པ་ ༼སྣར། པེ།༽ སྦྱིན་པའི་"
    },
    {
      "span": {
        "start": 3285,
        "end": 3288
      },
      "text": "ཡི་ ༼སྣར། པེ།༽ ཡིས་"
    },
    {
      "span": {
        "start": 3403,
        "end": 3412
      },
      "text": "བསྲུང་བར་ ༼སྣར། པེ།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 3470,
        "end": 3476
      },
      "text": "བཟློག་ ༼སྣར། པེ།༽ ཟློག་"
    },
    {
      "span": {
        "start": 3537,
        "end": 3546
      },
      "text": "བཀུར་བའི་ ༼སྣར། པེ།༽ བསྐུར་བའི་"
    },
    {
      "span": {
        "start": 3707,
        "end": 3715
      },
      "text": "སྦྱང་ཐར་ ༼སྣར། པེ།༽ སྦྱོང་ཐལ་"
    },
    {
      "span": {
        "start": 3780,
        "end": 3788
      },
      "text": "མཛད་པའི་ ༼སྣར། པེ།༽ མཛད་པ་"
    }
  ]
}