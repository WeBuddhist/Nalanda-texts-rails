{
  "durchens": [
    {
      "span": {
        "start": 31,
        "end": 35
      },
      "text": "ཀ་ཨ་ ༼སྣར། པེ།༽ ཀཱ་"
    },
    {
      "span": {
        "start": 496,
        "end": 506
      },
      "text": "གྱུར་ཅིང་། ༼སྡེ།༽ གྱུར་ཞིང་།"
    },
    {
      "span": {
        "start": 508,
        "end": 515
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 781,
        "end": 791
      },
      "text": "གྱུར་ཅིང་། ༼ཅོ། སྡེ།༽ གྱུར་ཞིང་།"
    },
    {
      "span": {
        "start": 1197,
        "end": 1204
      },
      "text": "གོང་མར་ ༼སྣར། པེ།༽ གོང་མ་"
    },
    {
      "span": {
        "start": 1477,
        "end": 1483
      },
      "text": "དག་གི་ ༼སྣར། པེ།༽ དག་གིས་"
    },
    {
      "span": {
        "start": 2326,
        "end": 2335
      },
      "text": "བྱིན་ཅིག་ ༼ཅོ། སྡེ།༽ བྱིན་ཞིག་"
    },
    {
      "span": {
        "start": 2574,
        "end": 2577
      },
      "text": "ནི། ༼སྣར། པེ།༽ དེ།"
    },
    {
      "span": {
        "start": 2700,
        "end": 2708
      },
      "text": "གསུམ་པོ་ ༼སྣར། པེ།༽ གསུམ་པ་"
    },
    {
      "span": {
        "start": 2846,
        "end": 2851
      },
      "text": "རྙེད་ ༼སྣར། པེ།༽ སྙེད་"
    },
    {
      "span": {
        "start": 3117,
        "end": 3124
      },
      "text": "སོག་པར་ ༼སྣར། པེ།༽ གསོག་པར་"
    },
    {
      "span": {
        "start": 3497,
        "end": 3504
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 3977,
        "end": 3984
      },
      "text": "ལེགས་པ་ ༼སྣར།༽ ལེགས་པར་"
    },
    {
      "span": {
        "start": 4001,
        "end": 4009
      },
      "text": "རྒྱུ་ནི་ ༼པེ།༽ རྒྱུའི་"
    },
    {
      "span": {
        "start": 4906,
        "end": 4914
      },
      "text": "ཆོས་ཀྱང་ ༼སྣར། པེ།༽ ཆོས་ཀུན་"
    },
    {
      "span": {
        "start": 4927,
        "end": 4932
      },
      "text": "བརྙན་ ༼སྣར།༽ བསྙན་"
    },
    {
      "span": {
        "start": 5000,
        "end": 5005
      },
      "text": "བཀོན་ ༼སྣར། པེ།༽ དཀོན་"
    },
    {
      "span": {
        "start": 5051,
        "end": 5055
      },
      "text": "དེར་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 5092,
        "end": 5101
      },
      "text": "ཕ་རོལ་དང་ ༼སྣར། པེ།༽ ཕ་རོལ་ཡང་"
    },
    {
      "span": {
        "start": 5273,
        "end": 5282
      },
      "text": "འཁྲིད་པར་ ༼སྣར། པེ།༽ ཁྲིད་པར་"
    },
    {
      "span": {
        "start": 5470,
        "end": 5477
      },
      "text": "མིན་པར་ ༼སྣར། པེ།༽ མིན་པ་"
    },
    {
      "span": {
        "start": 5831,
        "end": 5835
      },
      "text": "རིག་ ༼པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 6068,
        "end": 6077
      },
      "text": "ཕྱིན་ཅེས་ ༼ཅོ། སྡེ།༽ ཕྱིན་ཞེས་"
    },
    {
      "span": {
        "start": 6724,
        "end": 6731
      },
      "text": "གྱུར་པ་ ༼སྣར།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 6754,
        "end": 6759
      },
      "text": "འཕྲོ་ ༼སྣར། པེ།༽ འགྲོ་"
    },
    {
      "span": {
        "start": 6820,
        "end": 6829
      },
      "text": "བསྒོམས་པ་ ༼སྣར། པེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 6896,
        "end": 6902
      },
      "text": "འབྲེལ་ ༼སྣར། པེ།༽ འགྲེལ་"
    },
    {
      "span": {
        "start": 7234,
        "end": 7244
      },
      "text": "འཇིག་རྟེན་ ༼སྣར། པེ།༽ འདི་བརྟེན་"
    },
    {
      "span": {
        "start": 7391,
        "end": 7399
      },
      "text": "འཁྲིད་པ་ ༼སྣར། པེ།༽ ཁྲིད་པ་"
    },
    {
      "span": {
        "start": 8022,
        "end": 8030
      },
      "text": "སྟེན་པར་ ༼སྣར། པེ།༽ བསྟེན་པར་"
    },
    {
      "span": {
        "start": 8407,
        "end": 8413
      },
      "text": "འབྱུང་ ༼སྣར། པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 9151,
        "end": 9154
      },
      "text": "དག་ ༼སྣར། པེ།༽ ང་"
    },
    {
      "span": {
        "start": 9766,
        "end": 9772
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 9816,
        "end": 9825
      },
      "text": "གཏོགས་དང་ ༼སྣར། པེ།༽ གཏོགས་པ་"
    },
    {
      "span": {
        "start": 10366,
        "end": 10369
      },
      "text": "ནི་ ༼ཅོ། སྡེ།༽ ན་"
    },
    {
      "span": {
        "start": 10489,
        "end": 10495
      },
      "text": "དེ་ཡང་ ༼སྣར། པེ།༽ དེ་ཡོད་"
    },
    {
      "span": {
        "start": 10529,
        "end": 10538
      },
      "text": "ཕྱོགས་པས་ ༼སྣར། པེ།༽ ཕྱོགས་པ་"
    },
    {
      "span": {
        "start": 10926,
        "end": 10934
      },
      "text": "སྐྱེད་པ་ ༼སྣར། པེ།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 10991,
        "end": 10997
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 11160,
        "end": 11166
      },
      "text": "རིག་པ་ ༼སྣར། པེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 11321,
        "end": 11329
      },
      "text": "བརྫུན་པ་ ༼སྣར། པེ།༽ རྫུན་པ་"
    },
    {
      "span": {
        "start": 11422,
        "end": 11430
      },
      "text": "བརྫུན་པ་ ༼སྣར། པེ།༽ རྫུན་པ་"
    },
    {
      "span": {
        "start": 11462,
        "end": 11472
      },
      "text": "བརྫུན་པའང་ ༼སྣར། པེ།༽ རྫུན་པའང་"
    },
    {
      "span": {
        "start": 11778,
        "end": 11785
      },
      "text": "བསྐྱོང་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 11896,
        "end": 11904
      },
      "text": "ཀྱང་ཡོད་ ༼སྣར། པེ།༽ ཀྱང་ཡང་"
    },
    {
      "span": {
        "start": 12051,
        "end": 12055
      },
      "text": "ཡིན། ༼སྣར།༽ མིན།"
    },
    {
      "span": {
        "start": 12106,
        "end": 12111
      },
      "text": "བཅོས་ ༼སྣར། པེ།༽ བཅོམ་"
    },
    {
      "span": {
        "start": 12443,
        "end": 12451
      },
      "text": "ལམ་གྱིས་ ༼སྣར། པེ།༽ ལམ་གྱི་"
    },
    {
      "span": {
        "start": 12707,
        "end": 12713
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 12740,
        "end": 12746
      },
      "text": "བཙུགས་ ༼སྣར། པེ།༽ གཙུགས་"
    },
    {
      "span": {
        "start": 12756,
        "end": 12761
      },
      "text": "རྟོག་ ༼སྣར།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 12990,
        "end": 12998
      },
      "text": "སྐུར་བས་ ༼སྣར།༽ བྱུང་ལ་"
    },
    {
      "span": {
        "start": 13290,
        "end": 13293
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 13305,
        "end": 13313
      },
      "text": "མིན་པའི། ༼སྣར། པེ།༽ མིན་པ།"
    },
    {
      "span": {
        "start": 13914,
        "end": 13926
      },
      "text": "རང་བཞིན་ཡོད་ ༼ཅོ། སྡེ།༽ རང་བཞིན་ཡང་"
    },
    {
      "span": {
        "start": 13957,
        "end": 13963
      },
      "text": "ཡོད་པ་ ༼ཅོ། སྡེ།༽ ཡོད་མ་"
    },
    {
      "span": {
        "start": 14371,
        "end": 14378
      },
      "text": "རིག་པར་ ༼སྣར།༽ རིགས་པར་"
    },
    {
      "span": {
        "start": 14874,
        "end": 14882
      },
      "text": "དངོས་པོ་ ༼སྣར།༽ དངོས་"
    },
    {
      "span": {
        "start": 15276,
        "end": 15278
      },
      "text": "ན་ ༼ཅོ། སྡེ།༽ ནང་"
    },
    {
      "span": {
        "start": 15452,
        "end": 15456
      },
      "text": "ཡིད་ ༼ཅོ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 15499,
        "end": 15505
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 15534,
        "end": 15542
      },
      "text": "བརྫུན་པ་ ༼སྣར། པེ།༽ རྫུན་པ་"
    },
    {
      "span": {
        "start": 15630,
        "end": 15636
      },
      "text": "བརྫུན་ ༼སྣར། པེ།༽ རྫུན་"
    },
    {
      "span": {
        "start": 15734,
        "end": 15736
      },
      "text": "མ་ ༼ཅོ། སྡེ།༽ མི་"
    },
    {
      "span": {
        "start": 15963,
        "end": 15971
      },
      "text": "བརྫུན་པ་ ༼སྣར། པེ།༽ རྫུན་པ་"
    },
    {
      "span": {
        "start": 16617,
        "end": 16626
      },
      "text": "རྒྱུན་ཅན་ ༼སྣར། པེ།༽ རྒྱུ་ཅན་"
    },
    {
      "span": {
        "start": 16882,
        "end": 16884
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 16927,
        "end": 16932
      },
      "text": "ཀྱིས་ ༼སྣར། པེ།༽ ཀྱི་"
    },
    {
      "span": {
        "start": 17002,
        "end": 17009
      },
      "text": "གང་ཞིག་ ༼སྣར།༽ གང་དག་"
    },
    {
      "span": {
        "start": 17019,
        "end": 17022
      },
      "text": "ཐག་ ༼སྣར།༽ འོག་"
    },
    {
      "span": {
        "start": 17244,
        "end": 17252
      },
      "text": "བཟུང་བར་ ༼སྣར། པེ།༽ གཟུང་བར་"
    },
    {
      "span": {
        "start": 17632,
        "end": 17638
      },
      "text": "ཇི་ལྟ་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 17792,
        "end": 17802
      },
      "text": "བརྫུན་པའི་ ༼སྣར། པེ།༽ རྫུན་པའི་"
    },
    {
      "span": {
        "start": 18096,
        "end": 18103
      },
      "text": "བྱེད་པ་ ༼སྣར། པེ།༽ བྱེད་པར་"
    },
    {
      "span": {
        "start": 18237,
        "end": 18243
      },
      "text": "འབྱུང་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 18249,
        "end": 18258
      },
      "text": "བརྫུན་པར་ ༼སྣར། པེ།༽ རྫུན་པར་"
    },
    {
      "span": {
        "start": 18296,
        "end": 18304
      },
      "text": "མཚུངས་ལ། ༼སྣར། པེ།༽ མཚུངས་པ།"
    },
    {
      "span": {
        "start": 18583,
        "end": 18589
      },
      "text": "འགྲུབ་ ༼སྣར། པེ།༽ གྲུབ་"
    },
    {
      "span": {
        "start": 18637,
        "end": 18647
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར།༽ བསྒྲུབས་པར་"
    },
    {
      "span": {
        "start": 19000,
        "end": 19007
      },
      "text": "རང་རིག་ ༼སྣར། པེ།༽ རང་གི་"
    },
    {
      "span": {
        "start": 19214,
        "end": 19220
      },
      "text": "ཡོད་པ་ ༼སྣར། པེ།༽ ཡོད་པར་"
    },
    {
      "span": {
        "start": 19444,
        "end": 19447
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 19643,
        "end": 19646
      },
      "text": "གང་ ༼སྣར།༽ གང་གང་"
    },
    {
      "span": {
        "start": 19703,
        "end": 19713
      },
      "text": "ཁྱོད་ཀྱིས་ ༼པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 21372,
        "end": 21377
      },
      "text": "ཅིག ། ༼ཅོ། སྡེ།༽ ཞིག །"
    },
    {
      "span": {
        "start": 21386,
        "end": 21390
      },
      "text": "ཉིད་ ༼ཅོ། སྡེ།༽ འདི་"
    },
    {
      "span": {
        "start": 21411,
        "end": 21416
      },
      "text": "ཅིག ། ༼ཅོ། སྡེ།༽ ཞིག །"
    },
    {
      "span": {
        "start": 21602,
        "end": 21607
      },
      "text": "གདོད་ ༼སྣར། པེ།༽ འདོད་"
    },
    {
      "span": {
        "start": 21977,
        "end": 21981
      },
      "text": "བླག་ ༼སྣར། པེ།༽ གླག་"
    },
    {
      "span": {
        "start": 22231,
        "end": 22239
      },
      "text": "གཉིས་ལས་ ༼སྣར། པེ།༽ གཉིས་ལམ་"
    },
    {
      "span": {
        "start": 22756,
        "end": 22771
      },
      "text": "འཛིན་པའང་དེ་ཡི་ ༼སྣར། པེ།༽ འཛིན་པའང་ཡིན་དེའི་"
    },
    {
      "span": {
        "start": 23415,
        "end": 23421
      },
      "text": "ཡོད་པ་ ༼སྣར། པེ།༽ ཡོད་དམ་"
    },
    {
      "span": {
        "start": 23718,
        "end": 23722
      },
      "text": "ལོག་ ༼པེ།༽ ལོགས་"
    },
    {
      "span": {
        "start": 23800,
        "end": 23803
      },
      "text": "ལྟ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 23931,
        "end": 23940
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 24605,
        "end": 24609
      },
      "text": "སྨྲ་ ༼ཅོ། སྡེ།༽ ས་"
    },
    {
      "span": {
        "start": 24877,
        "end": 24884
      },
      "text": "གྱུར་པ། ༼སྣར།༽ གྱུར་ལ ༼པེ།༽ འགྱུར་ལ།"
    },
    {
      "span": {
        "start": 24901,
        "end": 24908
      },
      "text": "སྐྱེ་བ་ ༼ཅོ། སྡེ།༽ སྐྱེ་བོ་"
    },
    {
      "span": {
        "start": 25018,
        "end": 25027
      },
      "text": "འབྱུང་བས་ ༼སྣར། པེ།༽ འགྱུར་བས་"
    },
    {
      "span": {
        "start": 25075,
        "end": 25080
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 25292,
        "end": 25297
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 25356,
        "end": 25361
      },
      "text": "རྟོག་ ༼ཅོ། སྡེ།༽ རྟག་"
    },
    {
      "span": {
        "start": 25380,
        "end": 25388
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 26020,
        "end": 26030
      },
      "text": "གྱུར་ཞིང་། ༼སྣར། པེ།༽ གྱུར་ཅིང་།"
    },
    {
      "span": {
        "start": 26533,
        "end": 26537
      },
      "text": "ཁྱད་ ༼སྣར། པེ།༽ བྱད་"
    },
    {
      "span": {
        "start": 26579,
        "end": 26590
      },
      "text": "བདག་མེད་དེ། ༼སྣར། པེ།༽ བདག་མེད་དོ།"
    },
    {
      "span": {
        "start": 26713,
        "end": 26722
      },
      "text": "དུད་འགྲོ་ ༼སྣར། པེ།༽ དུད་འགྲོར་"
    },
    {
      "span": {
        "start": 26730,
        "end": 26736
      },
      "text": "བརྐྱལ་ ༼སྣར། པེ།༽ རྐྱལ་"
    },
    {
      "span": {
        "start": 26745,
        "end": 26749
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 27509,
        "end": 27514
      },
      "text": "སྤངས་ ༼སྣར། པེ།༽ སྤང་"
    },
    {
      "span": {
        "start": 28336,
        "end": 28346
      },
      "text": "དབྱིབས་ཤེ་ ༼སྣར། པེ།༽ དབྱིབས་ཞེ་"
    },
    {
      "span": {
        "start": 28420,
        "end": 28425
      },
      "text": "ཚོགས་ ༼སྣར། པེ།༽ ཚུགས་"
    },
    {
      "span": {
        "start": 28486,
        "end": 28493
      },
      "text": "ལེན་པོ་ ༼སྣར། པེ།༽ ལེན་པོར་"
    },
    {
      "span": {
        "start": 28760,
        "end": 28766
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 29151,
        "end": 29161
      },
      "text": "སྦྲུལ་གྱི་ ༼སྣར། པེ།༽ སྦྲུལ་གྱིས་"
    },
    {
      "span": {
        "start": 30658,
        "end": 30664
      },
      "text": "ལ་མིན་ ༼སྣར། པེ།༽ མ་ཡིན་"
    },
    {
      "span": {
        "start": 31021,
        "end": 31029
      },
      "text": "ཉིད་དུས་ ༼སྣར། པེ།༽ ཉིད་དུ་"
    },
    {
      "span": {
        "start": 31597,
        "end": 31603
      },
      "text": "དུ་འམ་ ༼སྣར། པེ།༽ དུ་ལས་"
    },
    {
      "span": {
        "start": 32049,
        "end": 32053
      },
      "text": "ཡིན་ ༼སྣར། པེ།༽ རྨིན་"
    },
    {
      "span": {
        "start": 32346,
        "end": 32355
      },
      "text": "བརྟན་མིན་ ༼སྣར།༽ བརྟེན་མིང་ ༼པེ།༽ བརྟན་མིང་"
    },
    {
      "span": {
        "start": 32461,
        "end": 32465
      },
      "text": "མིན། ༼སྣར། པེ།༽ མེད།"
    },
    {
      "span": {
        "start": 32467,
        "end": 32475
      },
      "text": "གང་ཕྱིར་ ༼སྣར། པེ།༽ གང་ལ་"
    },
    {
      "span": {
        "start": 32580,
        "end": 32586
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ རྟགས་"
    },
    {
      "span": {
        "start": 32907,
        "end": 32914
      },
      "text": "བསྙད་པ་ ༼སྣར། པེ།༽ བསྙེད་པ་"
    },
    {
      "span": {
        "start": 33256,
        "end": 33262
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 34023,
        "end": 34026
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 34301,
        "end": 34307
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་མི་"
    },
    {
      "span": {
        "start": 34992,
        "end": 34995
      },
      "text": "བྱ། ༼སྣར།༽ བྱར།"
    },
    {
      "span": {
        "start": 35223,
        "end": 35231
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ དངོས་པོར་"
    },
    {
      "span": {
        "start": 35247,
        "end": 35252
      },
      "text": "གཞུག་ ༼སྣར།༽ གཞུགས་"
    },
    {
      "span": {
        "start": 35260,
        "end": 35267
      },
      "text": "ཞུས་པར་ ༼སྣར། པེ།༽ ནུས་པར་"
    },
    {
      "span": {
        "start": 35274,
        "end": 35282
      },
      "text": "ཇི་ལ་དེ་ ༼སྣར། པེ།༽ ཇི་"
    },
    {
      "span": {
        "start": 35393,
        "end": 35398
      },
      "text": "རྩོལ་ ༼སྣར། པེ།༽ བཅོལ་"
    },
    {
      "span": {
        "start": 35591,
        "end": 35600
      },
      "text": "རྟོགས་པར་ ༼སྣར།༽ རྟོགས་པར་པར་"
    },
    {
      "span": {
        "start": 35627,
        "end": 35632
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 35717,
        "end": 35725
      },
      "text": "གདུལ་བྱ་ ༼སྣར། པེ།༽ གདུལ་བ་"
    },
    {
      "span": {
        "start": 35744,
        "end": 35747
      },
      "text": "མང་ ༼སྣར།༽ མེད་"
    },
    {
      "span": {
        "start": 35793,
        "end": 35800
      },
      "text": "བཤད་ནས་ ༼སྣར།༽ བཤད་ཞེས་"
    },
    {
      "span": {
        "start": 35823,
        "end": 35828
      },
      "text": "བཞིར་ ༼སྣར། པེ།༽ གཞིར་"
    },
    {
      "span": {
        "start": 35961,
        "end": 35970
      },
      "text": "ཡིད་ཀྱིས་ ༼སྣར། པེ།༽ ཡིད་ཀྱང་"
    },
    {
      "span": {
        "start": 36471,
        "end": 36484
      },
      "text": "སྟོང་ཉིད་ཅེས་ ༼སྣར། པེ།༽ སྟོང་ཉིད་ཞེས་"
    },
    {
      "span": {
        "start": 36525,
        "end": 36533
      },
      "text": "འདོད་དེ། ༼སྣར།༽ འདོད་དོ།"
    },
    {
      "span": {
        "start": 36664,
        "end": 36672
      },
      "text": "མེད་དཔེ་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 37132,
        "end": 37139
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 37241,
        "end": 37247
      },
      "text": "ནི་དེ་ ༼པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 37612,
        "end": 37622
      },
      "text": "དོར་བ་ཅེས་ ༼སྣར། པེ།༽ དོར་བ་ཞེས་"
    },
    {
      "span": {
        "start": 37665,
        "end": 37673
      },
      "text": "དོར་མེད་ ༼ཅོ།༽ དོན་མེད་"
    },
    {
      "span": {
        "start": 38990,
        "end": 38996
      },
      "text": "འཁྲུག་ ༼སྣར། པེ།༽ འཁྲུགས་"
    },
    {
      "span": {
        "start": 39400,
        "end": 39403
      },
      "text": "ནི། ༼ཅོ། སྡེ།༽ ན།"
    },
    {
      "span": {
        "start": 39596,
        "end": 39603
      },
      "text": "ཅན་ཞེས་ ༼སྣར། པེ།༽ ཅན་ཤེས་"
    },
    {
      "span": {
        "start": 39672,
        "end": 39677
      },
      "text": "སྟོན་ ༼ཅོ། སྡེ།༽ སྟེན་"
    },
    {
      "span": {
        "start": 39901,
        "end": 39907
      },
      "text": "རེ་རེ་ ༼སྣར། པེ།༽ དེ་དེ་"
    },
    {
      "span": {
        "start": 40119,
        "end": 40128
      },
      "text": "མིན་འཇིག་ ༼སྣར།༽ མི་འཇིག་ ༼པེ།༽ མི་འཇིགས་"
    },
    {
      "span": {
        "start": 40132,
        "end": 40135
      },
      "text": "པས། ༼སྣར། པེ།༽ པ།"
    },
    {
      "span": {
        "start": 40781,
        "end": 40786
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 41520,
        "end": 41526
      },
      "text": "འགྱུར་ ༼ཅོ། སྡེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 42450,
        "end": 42467
      },
      "text": "བྱུང་བར་གྱུར་པའང་ ༼སྣར།༽ བྱུང་བ་འགྱུར་བའང་"
    },
    {
      "span": {
        "start": 42685,
        "end": 42695
      },
      "text": "བྱིན་གྱིས་ ༼ཅོ། སྡེ།༽ བྱིན་གྱི་"
    },
    {
      "span": {
        "start": 43537,
        "end": 43550
      },
      "text": "ཁྲག་ཁྲིག་ཕྲག་ ༼པེ།༽ ཁྲག་ཁྲིག་"
    },
    {
      "span": {
        "start": 43565,
        "end": 43572
      },
      "text": "བསྒྱུར་ ༼ཅོ། སྡེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 44363,
        "end": 44373
      },
      "text": "གྱུར་ཞིང་། ༼སྣར། པེ།༽ གྱུར་ཅིང་།"
    },
    {
      "span": {
        "start": 44612,
        "end": 44619
      },
      "text": "ཆུད་པར་ ༼སྣར། པེ།༽ ཆུད་པ་"
    },
    {
      "span": {
        "start": 44779,
        "end": 44788
      },
      "text": "རིགས་པའང་ ༼སྣར།༽ རིགས་ཀྱང་ ༼པེ།༽ རིག་པའང་"
    },
    {
      "span": {
        "start": 44984,
        "end": 44989
      },
      "text": "སྟེན་ ༼སྣར། པེ།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 45117,
        "end": 45123
      },
      "text": "རིག་པ་ ༼སྣར། པེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 45764,
        "end": 45774
      },
      "text": "གྱུར་ཞིང་། ༼སྣར། པེ།༽ གྱུར་ཅིང་།"
    },
    {
      "span": {
        "start": 47002,
        "end": 47006
      },
      "text": "ཡུལ་ ༼སྣར། པེ།༽ གུལ་"
    },
    {
      "span": {
        "start": 47312,
        "end": 47316
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 47735,
        "end": 47741
      },
      "text": "བཟློག་ ༼སྣར། པེ།༽ ཟློག་"
    },
    {
      "span": {
        "start": 47745,
        "end": 47749
      },
      "text": "མིན་ ༼སྣར། པེ།༽ མི་"
    },
    {
      "span": {
        "start": 47841,
        "end": 47844
      },
      "text": "ཟད་ ༼སྣར། པེ།༽ ཟས་"
    },
    {
      "span": {
        "start": 48120,
        "end": 48124
      },
      "text": "ལའང་ ༼ཅོ། སྡེ།༽ ལ་"
    },
    {
      "span": {
        "start": 48165,
        "end": 48175
      },
      "text": "སྟོབས་ཞེས་ ༼ཅོ། སྡེ།༽ སྟོབས་ཤེས་"
    },
    {
      "span": {
        "start": 48215,
        "end": 48225
      },
      "text": "རྣམས་ཀྱིས། ༼སྣར། པེ།༽ རྣམས་ཀྱི།"
    },
    {
      "span": {
        "start": 48377,
        "end": 48382
      },
      "text": "རྟོག་ ༼སྣར།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 48769,
        "end": 48793
      },
      "text": "བསམ་གཏན་རྣམ་ཐར་བརྒྱད་གང་ ༼སྣར། པེ།༽ བསམ་གཏན་མཐར་བརྒྱད་"
    },
    {
      "span": {
        "start": 48841,
        "end": 48844
      },
      "text": "པར་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 49014,
        "end": 49019
      },
      "text": "གཞིར་ ༼སྣར། པེ།༽ བཞིར་"
    },
    {
      "span": {
        "start": 49153,
        "end": 49160
      },
      "text": "ནམ་མཁའ་ ༼སྣར། པེ།༽ ནམ་མཁའི་"
    },
    {
      "span": {
        "start": 49328,
        "end": 49331
      },
      "text": "བག་ ༼སྣར།༽ བག་མ་"
    },
    {
      "span": {
        "start": 49492,
        "end": 49496
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིར་"
    },
    {
      "span": {
        "start": 49879,
        "end": 49887
      },
      "text": "འཐོབ་པར་ ༼སྣར། པེ།༽ ཐོབ་པར་"
    },
    {
      "span": {
        "start": 50031,
        "end": 50036
      },
      "text": "ཁྱོད་ ༼སྣར། པེ།༽ ཁྱེད་"
    },
    {
      "span": {
        "start": 50074,
        "end": 50080
      },
      "text": "ཞགས་པ་ ༼པེ།༽ ཞབས་པ་"
    },
    {
      "span": {
        "start": 50310,
        "end": 50316
      },
      "text": "ཡིན་ལ། ༼སྣར། པེ།༽ ཡིན་པ།"
    },
    {
      "span": {
        "start": 50881,
        "end": 50891
      },
      "text": "ཕྱོགས་ཤིང་ ༼སྣར། པེ།༽ ཕྱོགས་ཞིང་"
    },
    {
      "span": {
        "start": 51044,
        "end": 51049
      },
      "text": "བསྙད་ ༼སྣར།༽ བསྙད་ན་"
    },
    {
      "span": {
        "start": 51689,
        "end": 51699
      },
      "text": "ཐུགས་རྗེས་ ༼སྣར།༽ ཐུགས་རྗེའི་"
    },
    {
      "span": {
        "start": 51704,
        "end": 51709
      },
      "text": "ཐུགས་ ༼སྣར།༽ ལུགས་"
    },
    {
      "span": {
        "start": 51939,
        "end": 51945
      },
      "text": "གཞན་ན་ ༼སྣར།༽ གཞན་"
    },
    {
      "span": {
        "start": 52115,
        "end": 52117
      },
      "text": "ཏ་ ༼སྣར། པེ།༽ ད་"
    },
    {
      "span": {
        "start": 52595,
        "end": 52604
      },
      "text": "སེམས་ཀྱི་ ༼སྣར། པེ།༽ སེམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 52695,
        "end": 52705
      },
      "text": "བདེ་གཤེགས་ ༼སྣར། པེ།༽ བདེར་གཤེགས་"
    },
    {
      "span": {
        "start": 52757,
        "end": 52764
      },
      "text": "གསལ་བར་ ༼སྣར། པེ།༽ བསལ་བར་"
    },
    {
      "span": {
        "start": 52881,
        "end": 52886
      },
      "text": "དྲུས་ ༼པེ།༽ དྲུས་མ་"
    }
  ]
}