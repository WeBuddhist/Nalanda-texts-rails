{
  "durchens": [
    {
      "span": {
        "start": 525,
        "end": 530
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིག་"
    },
    {
      "span": {
        "start": 634,
        "end": 638
      },
      "text": "རྣམ་ ༼སྣར།༽ རྣམས་"
    },
    {
      "span": {
        "start": 664,
        "end": 671
      },
      "text": "སྡོམ་ལ་ ༼སྣར། པེ།༽ སྡོམ་པ་"
    },
    {
      "span": {
        "start": 910,
        "end": 915
      },
      "text": "བློས་ ༼སྣར། པེ།༽ ཟློས་"
    },
    {
      "span": {
        "start": 967,
        "end": 973
      },
      "text": "བསྙེན་ ༼སྣར།༽ སྙེན་"
    },
    {
      "span": {
        "start": 1076,
        "end": 1080
      },
      "text": "གཅལ་ ༼སྣར། པེ།༽ བཅལ་"
    },
    {
      "span": {
        "start": 1356,
        "end": 1365
      },
      "text": "ལོག་རྟོག་ ༼སྣར།༽ ལོ་ཏོག་"
    },
    {
      "span": {
        "start": 1732,
        "end": 1744
      },
      "text": "གྱུར་ཅིང་། ། ༼སྣར། པེ།༽ གྱུར་ཅིག །"
    },
    {
      "span": {
        "start": 2219,
        "end": 2223
      },
      "text": "གསལ། ༼སྡེ། ཅོ། པེ།༽ སེལ།"
    },
    {
      "span": {
        "start": 2592,
        "end": 2597
      },
      "text": "གཞོམ། ༼སྣར། པེ།༽ གཞོལ།"
    },
    {
      "span": {
        "start": 3011,
        "end": 3018
      },
      "text": "ཟླ་བའི་ ༼སྣར། པེ།༽ ཟླ་བ་"
    },
    {
      "span": {
        "start": 3043,
        "end": 3047
      },
      "text": "རྣམ་ ༼སྣར།༽ རྣམས་"
    },
    {
      "span": {
        "start": 3054,
        "end": 3059
      },
      "text": "དེང་། ༼ཅོ།༽ དང་ ༼སྣར། པེ།༽ དེར།"
    },
    {
      "span": {
        "start": 3191,
        "end": 3200
      },
      "text": "མཆོག་ཤེལ་ ༼སྣར།༽ མཆོག་ཤེས་"
    },
    {
      "span": {
        "start": 3215,
        "end": 3219
      },
      "text": "སྔོ་ ༼སྣར།༽ བསྔོ་"
    },
    {
      "span": {
        "start": 3277,
        "end": 3282
      },
      "text": "རྒྱན་ ༼སྣར།༽ བརྒྱན་"
    },
    {
      "span": {
        "start": 3563,
        "end": 3572
      },
      "text": "སྣོད་ཀྱི་ ༼སྣར།༽ སྣོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 3641,
        "end": 3646
      },
      "text": "གཞུག་ ༼སྣར།༽ གཞུགས་"
    },
    {
      "span": {
        "start": 3671,
        "end": 3676
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིག་"
    },
    {
      "span": {
        "start": 3857,
        "end": 3869
      },
      "text": "དབུགས་དབྱུང་ ༼སྣར། པེ།༽ དབུགས་ཕྱུང་"
    },
    {
      "span": {
        "start": 3987,
        "end": 3996
      },
      "text": "འབྲས་ཐོབ་ ༼སྣར། པེ།༽ འབྲས་"
    },
    {
      "span": {
        "start": 4019,
        "end": 4024
      },
      "text": "ཕྱིར་ ༼སྣར། པེ།༽ ཕྱིན་"
    },
    {
      "span": {
        "start": 4335,
        "end": 4344
      },
      "text": "རིམ་གྱིས་ ༼སྣར། པེ།༽ རཾ་གྱི་"
    },
    {
      "span": {
        "start": 4380,
        "end": 4386
      },
      "text": "རིག་པ་ ༼སྣར།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 4862,
        "end": 4879
      },
      "text": "གནས་ཀྱི་དབང་ཕྱུག་ ༼སྣར། པེ།༽ གནས་ཀྱི་"
    },
    {
      "span": {
        "start": 4884,
        "end": 4887
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ནི་དབང་ཕྱུག་"
    },
    {
      "span": {
        "start": 4904,
        "end": 4910
      },
      "text": "དགའ་བ་ ༼སྣར། པེ།༽ དགའ་བས་"
    },
    {
      "span": {
        "start": 4940,
        "end": 4946
      },
      "text": "བསྐྱབ་ ༼སྣར། པེ།༽ སྐྱབ་"
    },
    {
      "span": {
        "start": 5060,
        "end": 5070
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 5276,
        "end": 5286
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 5332,
        "end": 5338
      },
      "text": "དག་གི་ ༼སྣར།༽ དག་གིས་"
    },
    {
      "span": {
        "start": 5485,
        "end": 5495
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 5902,
        "end": 5905
      },
      "text": "ཅར་ ༼སྣར། པེ།༽ རཾ་"
    },
    {
      "span": {
        "start": 5912,
        "end": 5915
      },
      "text": "རང་ ༼སྣར། པེ།༽ རབ་"
    },
    {
      "span": {
        "start": 6128,
        "end": 6136
      },
      "text": "རྡོ་རྗེ་ ༼སྣར། པེ།༽ རྡོ་རྗེར་"
    },
    {
      "span": {
        "start": 6143,
        "end": 6149
      },
      "text": "འགྱུར། ༼སྣར། པེ།༽ གྱུར།"
    },
    {
      "span": {
        "start": 7020,
        "end": 7026
      },
      "text": "བརླབས་ ༼སྣར། པེ།༽ བརླབ་"
    },
    {
      "span": {
        "start": 7129,
        "end": 7138
      },
      "text": "བརླབས་ནས་ ༼སྣར། པེ།༽ བརླབ་གནས་"
    },
    {
      "span": {
        "start": 7263,
        "end": 7272
      },
      "text": "བརླབས་ནས་ ༼སྣར།༽ བརླབས་གནས་ ༼པེ།༽ བརླབ་གནས་"
    },
    {
      "span": {
        "start": 7435,
        "end": 7444
      },
      "text": "བརླབས་ནས་ ༼སྣར། པེ།༽ བརླབ་གནས་"
    },
    {
      "span": {
        "start": 7491,
        "end": 7501
      },
      "text": "གཞུགས་པའི་ ༼སྣར། པེ།༽ བཞུགས་པའི་"
    },
    {
      "span": {
        "start": 7568,
        "end": 7577
      },
      "text": "བརླབས་ནས་ ༼སྣར། པེ།༽ བརླབ་གནས་"
    },
    {
      "span": {
        "start": 7739,
        "end": 7748
      },
      "text": "བརླབས་ནས་ ༼སྣར། པེ།༽ བརླབ་གནས་"
    },
    {
      "span": {
        "start": 7871,
        "end": 7880
      },
      "text": "བརླབས་ནས་ ༼སྣར། པེ།༽ བརླབ་གནས་"
    },
    {
      "span": {
        "start": 7961,
        "end": 7966
      },
      "text": "རྗེས་ ༼སྣར།༽ རྗེ་"
    },
    {
      "span": {
        "start": 8036,
        "end": 8046
      },
      "text": "བྱིན་བརླབ་ ༼སྣར།༽ བརླབས་ ༼པེ།༽ བྱིན་རླབས་"
    },
    {
      "span": {
        "start": 8297,
        "end": 8303
      },
      "text": "རྩིའི་ ༼སྣར། པེ།༽ རྩི་"
    },
    {
      "span": {
        "start": 8435,
        "end": 8442
      },
      "text": "སྦྱོང་། ༼སྣར། པེ།༽ སྦྱང་།"
    },
    {
      "span": {
        "start": 9001,
        "end": 9005
      },
      "text": "མཛད་ ༼སྣར། པེ།༽ བརྒྱད་"
    },
    {
      "span": {
        "start": 9980,
        "end": 9984
      },
      "text": "དགའ་ ༼སྣར། པེ།༽ དགར་"
    },
    {
      "span": {
        "start": 10593,
        "end": 10599
      },
      "text": "སྐྱིལ་ ༼སྣར། པེ།༽ དཀྱིལ་"
    },
    {
      "span": {
        "start": 10691,
        "end": 10694
      },
      "text": "དང་ ༼སྣར། པེ།༽ དབང་"
    },
    {
      "span": {
        "start": 10808,
        "end": 10813
      },
      "text": "གསུང་ ༼སྣར། པེ།༽ གསུམ་"
    },
    {
      "span": {
        "start": 11036,
        "end": 11041
      },
      "text": "གདངས་ ༼སྣར།༽ གདང་"
    },
    {
      "span": {
        "start": 11118,
        "end": 11126
      },
      "text": "དབྱིག་པ་ ༼སྣར། པེ།༽ དབྱུག་པ་"
    },
    {
      "span": {
        "start": 11235,
        "end": 11242
      },
      "text": "ཀུན་ནས་ ༼སྣར། པེ།༽ ཀུན་ན་"
    },
    {
      "span": {
        "start": 11471,
        "end": 11477
      },
      "text": "གཞུག ། ༼པེ།༽ བཞུག །"
    },
    {
      "span": {
        "start": 11646,
        "end": 11655
      },
      "text": "གསུང་དབང་ ༼སྣར། པེ།༽ གསུང་བ་"
    },
    {
      "span": {
        "start": 11709,
        "end": 11719
      },
      "text": "སྙིང་པོའོ། ༼སྣར། པེ།༽ སྙིང་པའི།"
    },
    {
      "span": {
        "start": 12146,
        "end": 12150
      },
      "text": "མཁའ་ ༼སྣར། པེ།༽ མཁས་"
    },
    {
      "span": {
        "start": 12702,
        "end": 12711
      },
      "text": "རླུང་མའི་ ༼སྣར། པེ།༽ རླུང་མེའི་"
    },
    {
      "span": {
        "start": 13430,
        "end": 13438
      },
      "text": "ཐུབ་པའི་ ༼སྣར། པེ།༽ ཐུག་པའི་"
    },
    {
      "span": {
        "start": 13673,
        "end": 13677
      },
      "text": "བཟླ་ ༼སྣར།༽ ཟླ་"
    },
    {
      "span": {
        "start": 13924,
        "end": 13928
      },
      "text": "རིམ་ ༼སྣར། པེ།༽ རིམས་"
    },
    {
      "span": {
        "start": 13933,
        "end": 13937
      },
      "text": "རིམ་ ༼སྣར། པེ།༽ རིམས་"
    },
    {
      "span": {
        "start": 14016,
        "end": 14026
      },
      "text": "སྔོན་བཞིན་ ༼སྣར། པེ།༽ སྔོ་ཞིང་"
    },
    {
      "span": {
        "start": 14089,
        "end": 14094
      },
      "text": "སྒེག་ ༼སྣར།༽ སྒེགས་"
    },
    {
      "span": {
        "start": 14135,
        "end": 14139
      },
      "text": "པའི། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 14428,
        "end": 14432
      },
      "text": "བཏབ་ ༼སྣར། པེ།༽ གཏབ་"
    },
    {
      "span": {
        "start": 14479,
        "end": 14488
      },
      "text": "སེམས་ཀྱི་ ༼སྣར། པེ།༽ སེམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 14562,
        "end": 14569
      },
      "text": "ངལ་བསོ་ ༼སྣར། པེ།༽ ངལ་གསོ་"
    },
    {
      "span": {
        "start": 14613,
        "end": 14616
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེང་"
    },
    {
      "span": {
        "start": 14736,
        "end": 14746
      },
      "text": "སྙིང་རྗེས་ ༼སྣར།༽ སྙིང་རྗེ་"
    },
    {
      "span": {
        "start": 14860,
        "end": 14869
      },
      "text": "རྟོགས་ཚེ་ ༼སྣར། པེ།༽ གཏོགས་ཆེ་"
    },
    {
      "span": {
        "start": 14886,
        "end": 14895
      },
      "text": "ཡུལ་གྱིས་ ༼སྣར།༽ ཡུལ་གྱི་"
    },
    {
      "span": {
        "start": 15495,
        "end": 15507
      },
      "text": "དགེ་ཚུལ་གྱི། ༼སྣར།༽ དགེ་ཚུལ་གྱིས།"
    },
    {
      "span": {
        "start": 15546,
        "end": 15553
      },
      "text": "མེ་ཡིས་ ༼སྣར། པེ།༽ མེ་ཡི་"
    },
    {
      "span": {
        "start": 15569,
        "end": 15579
      },
      "text": "བསྲེགས་པས་ ༼སྣར། པེ།༽ བསྲེག་པས་"
    },
    {
      "span": {
        "start": 15813,
        "end": 15820
      },
      "text": "གཞག་པས་ ༼སྣར། པེ།༽ བཞག་པས་"
    },
    {
      "span": {
        "start": 16248,
        "end": 16250
      },
      "text": "ཁ། ༼ཅོ།༽ ཁཾ ༼སྣར།༽ ཁམས ༼པེ།༽ ཁམ།"
    },
    {
      "span": {
        "start": 16411,
        "end": 16416
      },
      "text": "མཆོད་ ༼སྣར།༽ ཆོས་"
    },
    {
      "span": {
        "start": 16437,
        "end": 16445
      },
      "text": "བཞིན་དུ་ ༼སྣར།༽ བཞིན་དུས་"
    },
    {
      "span": {
        "start": 16458,
        "end": 16471
      },
      "text": "འཁོར་ལོ་མཆོག་ ༼སྣར། པེ།༽ འཁོར་ལོ་མཆོད་"
    },
    {
      "span": {
        "start": 16525,
        "end": 16535
      },
      "text": "ལྷ་མོ་ཡིས། ༼སྣར། པེ།༽ ལྷ་མོ་ཡི།"
    },
    {
      "span": {
        "start": 16598,
        "end": 16603
      },
      "text": "ཟློས་ ༼སྣར།༽ འདོད་"
    },
    {
      "span": {
        "start": 16967,
        "end": 16975
      },
      "text": "དོན་གྱི་ ༼སྣར། པེ།༽ དོན་གྱིས་"
    },
    {
      "span": {
        "start": 17107,
        "end": 17116
      },
      "text": "གཞན་གྱིས་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 17472,
        "end": 17479
      },
      "text": "ལས་ཆོས་ ༼སྣར།༽ ལས་ཆོད་"
    },
    {
      "span": {
        "start": 17505,
        "end": 17513
      },
      "text": "གསུམ་དམ་ ༼སྣར། པེ།༽ གསུམ་ཕྱག་"
    },
    {
      "span": {
        "start": 17630,
        "end": 17634
      },
      "text": "རིག་ ༼སྣར། པེ།༽ རིག་པར་"
    },
    {
      "span": {
        "start": 18227,
        "end": 18231
      },
      "text": "གཅད་ ༼སྣར། པེ།༽ བཅད་"
    },
    {
      "span": {
        "start": 18296,
        "end": 18303
      },
      "text": "ནམ་མཁར་ ༼སྣར།༽ ནམ་མཁའ་"
    },
    {
      "span": {
        "start": 18528,
        "end": 18539
      },
      "text": "བདུད་རྩིའི་ ༼སྣར།༽ བདུད་རྩི་"
    },
    {
      "span": {
        "start": 19110,
        "end": 19117
      },
      "text": "བཟང་པོ་ ༼སྣར། པེ།༽ བཟང་པོའི་"
    },
    {
      "span": {
        "start": 19350,
        "end": 19359
      },
      "text": "འཁོར་ལོས་ ༼སྣར། པེ།༽ འཁོར་ལོ་"
    },
    {
      "span": {
        "start": 19461,
        "end": 19467
      },
      "text": "བརྗོད་ ༼སྣར། པེ།༽ བཛྲོཏ་"
    },
    {
      "span": {
        "start": 19504,
        "end": 19513
      },
      "text": "འདེགས་པར་ ༼སྣར། པེ།༽ བརྡེག་པར་"
    },
    {
      "span": {
        "start": 19666,
        "end": 19674
      },
      "text": "གསོར་བར་ ༼སྣར། པེ།༽ གསོར་བས་"
    },
    {
      "span": {
        "start": 19908,
        "end": 19917
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 19949,
        "end": 19955
      },
      "text": "བསྒོམ་ ༼སྣར། པེ།༽ བསྒོ་"
    },
    {
      "span": {
        "start": 20028,
        "end": 20033
      },
      "text": "འཇིག་ ༼སྣར། པེ།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 20070,
        "end": 20075
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 20115,
        "end": 20120
      },
      "text": "སྔགས་ ༼སྣར།༽ བསྔགས་"
    },
    {
      "span": {
        "start": 20442,
        "end": 20446
      },
      "text": "ཟེར་ ༼སྣར། པེ།༽ གཟེར་"
    },
    {
      "span": {
        "start": 20693,
        "end": 20701
      },
      "text": "བདག་གིས་ ༼སྣར།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 20748,
        "end": 20752
      },
      "text": "གཞི་ ༼སྣར།༽ བཞི་"
    },
    {
      "span": {
        "start": 21008,
        "end": 21014
      },
      "text": "ཨ་སྨྲ་ ༼སྣར། པེ།༽ ཨ་མྲ་"
    },
    {
      "span": {
        "start": 21069,
        "end": 21079
      },
      "text": "སྔགས་ཀྱིས་ ༼སྣར། པེ།༽ སྔགས་ཀྱི་"
    },
    {
      "span": {
        "start": 21126,
        "end": 21131
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 21289,
        "end": 21294
      },
      "text": "དྲིས་ ༼སྣར། པེ།༽ དྲི་"
    },
    {
      "span": {
        "start": 21314,
        "end": 21323
      },
      "text": "དྲི་བཟངས་ ༼སྣར། པེ།༽ དྲི་བཟང་"
    },
    {
      "span": {
        "start": 21388,
        "end": 21392
      },
      "text": "བཟླ། ༼སྣར།༽ ཟླ།"
    },
    {
      "span": {
        "start": 23198,
        "end": 23205
      },
      "text": "འདི་ཡི་ ༼སྣར།༽ འདི་ཡིས་"
    },
    {
      "span": {
        "start": 23308,
        "end": 23311
      },
      "text": "དག་ ༼སྣར།༽ བདག་"
    },
    {
      "span": {
        "start": 23332,
        "end": 23338
      },
      "text": "འདེབས། ༼སྣར།༽ འདེབ།"
    },
    {
      "span": {
        "start": 23424,
        "end": 23429
      },
      "text": "བསྟན་ ༼སྣར། པེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 23554,
        "end": 23563
      },
      "text": "ཆེན་པོའི་ ༼སྣར། པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 23957,
        "end": 23966
      },
      "text": "ཀུན་གྱིས་ ༼སྣར། པེ།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 24524,
        "end": 24532
      },
      "text": "གཏུགས། ། ༼སྣར། པེ།༽ གཏུག །"
    },
    {
      "span": {
        "start": 24552,
        "end": 24558
      },
      "text": "བརྗོད་ ༼ཅོ། སྡེ།༽ ཨཱཿབརྗོད་"
    },
    {
      "span": {
        "start": 24667,
        "end": 24677
      },
      "text": "གུས་པ་ཡིས། ༼སྣར། པེ།༽ གུས་པ་ཡི།"
    },
    {
      "span": {
        "start": 24842,
        "end": 24849
      },
      "text": "ལྟོས་པ་ ༼སྣར། པེ།༽ བལྟོས་པ་"
    },
    {
      "span": {
        "start": 24910,
        "end": 24915
      },
      "text": "བསྟན། ༼སྣར། པེ།༽ བརྟན།"
    },
    {
      "span": {
        "start": 25119,
        "end": 25125
      },
      "text": "ཡ་སརྦ་ ༼སྣར། པེ།༽ ཡ་"
    },
    {
      "span": {
        "start": 25162,
        "end": 25177
      },
      "text": "ཀུན་མཁྱེན་རྣམས། ༼སྣར།༽ ཀུན་མཁྱེན་ནས།"
    },
    {
      "span": {
        "start": 25383,
        "end": 25385
      },
      "text": "པ་ ༼སྣར།༽ སྐལ་བ་"
    },
    {
      "span": {
        "start": 25504,
        "end": 25515
      },
      "text": "སྔགས་སྤྱོད་ ༼སྣར།༽ བསྔགས་སྤྱད་ ༼པེ།༽ སྔགས་སྤྱད་"
    },
    {
      "span": {
        "start": 25717,
        "end": 25721
      },
      "text": "བཅད། ༼སྣར། པེ།༽ བཅས།"
    },
    {
      "span": {
        "start": 25877,
        "end": 25882
      },
      "text": "བཟུང་ ༼སྣར།༽ གཟུང་"
    },
    {
      "span": {
        "start": 26333,
        "end": 26337
      },
      "text": "ཐབས་ ༼སྣར། པེ།༽ ཐབ་"
    },
    {
      "span": {
        "start": 26383,
        "end": 26387
      },
      "text": "ཐབས་ ༼སྣར། པེ།༽ ཐབ་"
    },
    {
      "span": {
        "start": 26400,
        "end": 26405
      },
      "text": "གཞོམ། ༼སྣར། པེ།༽ གཞོལ།"
    },
    {
      "span": {
        "start": 26497,
        "end": 26501
      },
      "text": "སྩལ་ ༼སྣར། པེ།༽ རྩལ་"
    },
    {
      "span": {
        "start": 26611,
        "end": 26616
      },
      "text": "སྡོམ་ ༼སྣར།༽ སྡོམ་པ་"
    },
    {
      "span": {
        "start": 26933,
        "end": 26936
      },
      "text": "ལས་ ༼ཅོ། སྡེ།༽ ཛཿལས་"
    },
    {
      "span": {
        "start": 26994,
        "end": 27002
      },
      "text": "བལྟ་བའི་ ༼སྣར། པེ།༽ ལྟ་བའི་"
    },
    {
      "span": {
        "start": 27336,
        "end": 27341
      },
      "text": "ཕྱེད་ ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 27345,
        "end": 27355
      },
      "text": "བཟངས་ཀྱིས། ༼སྣར། པེ།༽ བཟང་གིས།"
    },
    {
      "span": {
        "start": 27386,
        "end": 27390
      },
      "text": "ཡིག་ ༼སྣར།༽ ཡིས་"
    },
    {
      "span": {
        "start": 27465,
        "end": 27469
      },
      "text": "བཏང་ ༼སྣར། པེ།༽ གཏང་"
    },
    {
      "span": {
        "start": 27529,
        "end": 27538
      },
      "text": "བཟུང་སྟེ་ ༼སྣར། པེ།༽ བཟུང་དང་"
    },
    {
      "span": {
        "start": 27756,
        "end": 27761
      },
      "text": "འདིར་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 28007,
        "end": 28013
      },
      "text": "བརྒྱད་ ༼སྣར།༽ རྒྱད་"
    },
    {
      "span": {
        "start": 28069,
        "end": 28073
      },
      "text": "བཞག་ ༼སྣར།༽ གཞག་"
    },
    {
      "span": {
        "start": 28081,
        "end": 28091
      },
      "text": "འཁོར་ལོའི་ ༼སྣར།༽ འཁོར་ལོ་"
    },
    {
      "span": {
        "start": 28095,
        "end": 28097
      },
      "text": "པ་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 28127,
        "end": 28132
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ ཉིས་"
    },
    {
      "span": {
        "start": 28355,
        "end": 28363
      },
      "text": "མྱོས་པར་ ༼སྣར།༽ མྱང་བར་ ༼པེ།༽ མྱོང་བར་"
    },
    {
      "span": {
        "start": 28918,
        "end": 28922
      },
      "text": "སྣམ་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 28968,
        "end": 28973
      },
      "text": "ལོགས་ ༼སྣར།༽ ལོག་"
    },
    {
      "span": {
        "start": 29465,
        "end": 29471
      },
      "text": "བསམ་པ་ ༼སྣར།༽ བསམས་པ་"
    },
    {
      "span": {
        "start": 29630,
        "end": 29638
      },
      "text": "འཁོར་ལོ་ ༼སྣར། པེ།༽ འཁོར་ལོའི་"
    },
    {
      "span": {
        "start": 29665,
        "end": 29672
      },
      "text": "བལྟ་བས་ ༼སྣར། པེ།༽ ལྟ་བས་"
    },
    {
      "span": {
        "start": 30064,
        "end": 30069
      },
      "text": "སྐོར་ ༼སྣར། པེ།༽ བསྐོར་"
    },
    {
      "span": {
        "start": 30217,
        "end": 30225
      },
      "text": "ཡོན་པོས་ ༼སྣར། པེ།༽ ཡོན་པས་"
    },
    {
      "span": {
        "start": 30234,
        "end": 30239
      },
      "text": "ཆད་པ་ ༼སྣར།༽ འཆད་པ་"
    },
    {
      "span": {
        "start": 30273,
        "end": 30278
      },
      "text": "སྐོར་ ༼སྣར། པེ།༽ བསྐོར་"
    },
    {
      "span": {
        "start": 30685,
        "end": 30693
      },
      "text": "མཉམ་གཞག་ ༼པེ།༽ མཉམ་བཞག་"
    },
    {
      "span": {
        "start": 30765,
        "end": 30768
      },
      "text": "ཐབ་ ༼སྣར། པེ།༽ ཐབས་"
    },
    {
      "span": {
        "start": 30969,
        "end": 30972
      },
      "text": "པར་ ༼སྣར། པེ།༽ རི་"
    },
    {
      "span": {
        "start": 31292,
        "end": 31298
      },
      "text": "རྩིབས་ ༼སྣར།༽ བརྩིབས་"
    },
    {
      "span": {
        "start": 31374,
        "end": 31378
      },
      "text": "མཐོ་ ༼སྣར། པེ།༽ མཐོང་"
    },
    {
      "span": {
        "start": 32900,
        "end": 32904
      },
      "text": "བྱད་ ༼སྣར།༽ བྱས་"
    },
    {
      "span": {
        "start": 32943,
        "end": 32949
      },
      "text": "འབྱོར་ ༼སྣར།༽ འབྱོར་བ་"
    },
    {
      "span": {
        "start": 33002,
        "end": 33012
      },
      "text": "གྱིས་བསང་། ༼སྣར།༽ གྱི་གསང་།"
    },
    {
      "span": {
        "start": 33168,
        "end": 33173
      },
      "text": "རྒྱས་ ༼སྣར།༽ བརྒྱད་"
    },
    {
      "span": {
        "start": 33202,
        "end": 33210
      },
      "text": "དབྱིག་པ་ ༼སྣར། པེ།༽ དབྱུག་པ་"
    },
    {
      "span": {
        "start": 33299,
        "end": 33304
      },
      "text": "དྲངས། ༼སྣར། པེ།༽ དྲང་།"
    },
    {
      "span": {
        "start": 33433,
        "end": 33438
      },
      "text": "རྒྱར་ ༼སྣར། པེ།༽ བརྒྱར་"
    },
    {
      "span": {
        "start": 33618,
        "end": 33621
      },
      "text": "ཁར་ ༼སྣར། པེ།༽ ཁ་"
    },
    {
      "span": {
        "start": 34072,
        "end": 34076
      },
      "text": "སརྦ་ ༼སྣར། པེ།༽ བཛྲ་"
    },
    {
      "span": {
        "start": 35031,
        "end": 35036
      },
      "text": "གྲུབ་ ༼སྣར།༽ འགྲུབ་"
    },
    {
      "span": {
        "start": 35053,
        "end": 35058
      },
      "text": "ཕྱུག་ ༼སྣར།༽ ཕྱུགས་"
    },
    {
      "span": {
        "start": 35235,
        "end": 35247
      },
      "text": "དེ་ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ དེ་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 35424,
        "end": 35429
      },
      "text": "རྒྱལ་ ༼སྣར། པེ།༽ རྒྱ་"
    },
    {
      "span": {
        "start": 35520,
        "end": 35525
      },
      "text": "སྙིང་ ༼སྣར། པེ།༽ ཡིད་"
    },
    {
      "span": {
        "start": 35668,
        "end": 35671
      },
      "text": "དག་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 35993,
        "end": 35998
      },
      "text": "སྤྱི་ ༼སྣར།༽ ཅི་"
    },
    {
      "span": {
        "start": 36128,
        "end": 36136
      },
      "text": "གཡོགས། ། ༼སྣར། པེ།༽ གཡོག །"
    },
    {
      "span": {
        "start": 36232,
        "end": 36237
      },
      "text": "ཐོགས་ ༼སྣར།༽ ཐོག་"
    },
    {
      "span": {
        "start": 36916,
        "end": 36937
      },
      "text": "། དེ་ལྟ་བུའི་རྡོ་རྗེ་ ༼སྣར། པེ།༽ དེ་ལྟ་བུའི་"
    },
    {
      "span": {
        "start": 36962,
        "end": 36972
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 37024,
        "end": 37028
      },
      "text": "ཉམས་ ༼སྣར།༽ ཉམ་"
    },
    {
      "span": {
        "start": 37170,
        "end": 37174
      },
      "text": "དྲལ་ ༼པེ།༽ བྲལ་"
    },
    {
      "span": {
        "start": 37185,
        "end": 37192
      },
      "text": "པད་གནས་ ༼སྣར།༽ པད་ནས་"
    },
    {
      "span": {
        "start": 37246,
        "end": 37253
      },
      "text": "དམ་ཚིག་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 37302,
        "end": 37309
      },
      "text": "བསྲུངས་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 37364,
        "end": 37370
      },
      "text": "བཛྲོད་ ༼པེ།༽ བཛྲོ་"
    },
    {
      "span": {
        "start": 37431,
        "end": 37440
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 37923,
        "end": 37931
      },
      "text": "མཚན་ཅིང་ ༼སྣར། པེ།༽ མཚན་ཅིག་"
    },
    {
      "span": {
        "start": 38025,
        "end": 38031
      },
      "text": "བསྒོམ། ༼སྣར། པེ།༽ བསྒོ།"
    },
    {
      "span": {
        "start": 38065,
        "end": 38068
      },
      "text": "ལས་ ༼སྣར།༽ ལཾ་"
    },
    {
      "span": {
        "start": 38415,
        "end": 38418
      },
      "text": "ཏི་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 38474,
        "end": 38482
      },
      "text": "མཚན་མའམ་ ༼སྣར།༽ མཚན་འམ་"
    },
    {
      "span": {
        "start": 38488,
        "end": 38496
      },
      "text": "ཉེ་བ་རུ། ༼སྣར། པེ།༽ ཉེ་བ་རུང་།"
    },
    {
      "span": {
        "start": 38749,
        "end": 38755
      },
      "text": "བརྩམས་ ༼པེ།༽ བརྩས་"
    },
    {
      "span": {
        "start": 38922,
        "end": 38929
      },
      "text": "འཛིན་ལ། ༼སྣར།༽ འཛིན་པ།"
    },
    {
      "span": {
        "start": 39011,
        "end": 39020
      },
      "text": "བསྐུར་བར་ ༼སྣར། པེ།༽ སྐུར་བར་"
    },
    {
      "span": {
        "start": 39020,
        "end": 39026
      },
      "text": "འགྱུར། ༼སྣར། པེ།༽ གྱུར།"
    },
    {
      "span": {
        "start": 39420,
        "end": 39424
      },
      "text": "དེར། ༼སྣར། པེ།༽ དེ།"
    },
    {
      "span": {
        "start": 39433,
        "end": 39442
      },
      "text": "འཁོར་ལོས་ ༼སྣར། པེ།༽ འཁོར་ལོ་"
    },
    {
      "span": {
        "start": 39457,
        "end": 39465
      },
      "text": "མཚན་གྱི་ ༼སྣར།༽ མཚན་གྱིས་"
    },
    {
      "span": {
        "start": 39655,
        "end": 39667
      },
      "text": "ཡེ་ཤེས་རིགས་ ༼སྣར། པེ།༽ ཡེ་ཤེས་རིག་"
    },
    {
      "span": {
        "start": 39703,
        "end": 39707
      },
      "text": "དབང་ ༼སྣར།༽ ཀྱིས་བང་"
    },
    {
      "span": {
        "start": 39751,
        "end": 39760
      },
      "text": "རིགས་དབང་ ༼སྣར། པེ།༽ རིགས་མང་"
    },
    {
      "span": {
        "start": 39960,
        "end": 39966
      },
      "text": "ཡཱ་མི་ ༼པེ།༽ ཡཱ་མ་"
    },
    {
      "span": {
        "start": 40006,
        "end": 40011
      },
      "text": "བྱིན་ ༼སྣར། པེ།༽ འབྱིན་"
    },
    {
      "span": {
        "start": 40191,
        "end": 40193
      },
      "text": "བ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 40203,
        "end": 40211
      },
      "text": "སྒྲ་ཡིས་ ༼སྣར། པེ།༽ སྒྲ་ཡི་"
    },
    {
      "span": {
        "start": 40303,
        "end": 40307
      },
      "text": "རྟག་ ༼སྣར།༽ བརྟག་"
    },
    {
      "span": {
        "start": 40333,
        "end": 40341
      },
      "text": "རྒྱལ་བས་ ༼སྣར། པེ།༽ རྒྱལ་བ་"
    },
    {
      "span": {
        "start": 40360,
        "end": 40366
      },
      "text": "དཀྲོལ་ ༼སྣར།༽ བཀྲོལ་"
    },
    {
      "span": {
        "start": 40397,
        "end": 40406
      },
      "text": "ཀྱིས་དག ། ༼སྣར།༽ ཀྱི་བདག །"
    },
    {
      "span": {
        "start": 40605,
        "end": 40608
      },
      "text": "ཚང་ ༼སྣར།༽ མཚང་"
    },
    {
      "span": {
        "start": 40748,
        "end": 40751
      },
      "text": "ཟད་ ༼སྣར། པེ།༽ བཟད་"
    },
    {
      "span": {
        "start": 41152,
        "end": 41161
      },
      "text": "སྔགས་ཀྱི་ ༼སྣར། པེ།༽ སྔགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 41240,
        "end": 41246
      },
      "text": "གཟུང་། ༼པེ།༽ གཟུངས།"
    },
    {
      "span": {
        "start": 41404,
        "end": 41411
      },
      "text": "གཟུང་བ་ ༼སྣར། པེ།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 41585,
        "end": 41591
      },
      "text": "བསྐྱབ་ ༼སྣར།༽ སྐྱབ་"
    },
    {
      "span": {
        "start": 42381,
        "end": 42386
      },
      "text": "མདུན་ ༼སྣར། པེ།༽ འདུན་"
    },
    {
      "span": {
        "start": 42716,
        "end": 42721
      },
      "text": "གཡེན་ ༼ཅོ།༽ གཡཾ་ ༼སྣར།༽ གཡོན་"
    },
    {
      "span": {
        "start": 42733,
        "end": 42737
      },
      "text": "ཚིག་ ༼སྣར།༽ ཚིགས་"
    },
    {
      "span": {
        "start": 42748,
        "end": 42754
      },
      "text": "གཟུངས་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 43508,
        "end": 43513
      },
      "text": "བརླན་ ༼སྣར། པེ།༽ རླན་"
    },
    {
      "span": {
        "start": 43737,
        "end": 43742
      },
      "text": "རྣམས་ ༼སྣར།༽ རྣཾ་ ༼པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 43919,
        "end": 43924
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ སྲུངས་"
    },
    {
      "span": {
        "start": 44144,
        "end": 44150
      },
      "text": "རྟོག ། ༼པེ།༽ རྟོགས། །"
    },
    {
      "span": {
        "start": 44736,
        "end": 44739
      },
      "text": "ཚོ་ ༼སྣར།༽ མཚོ་"
    },
    {
      "span": {
        "start": 45061,
        "end": 45066
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 45391,
        "end": 45395
      },
      "text": "ཐུག་ ༼སྣར།༽ ཐུགས་"
    },
    {
      "span": {
        "start": 45619,
        "end": 45627
      },
      "text": "བདག་ཉིད་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 45727,
        "end": 45736
      },
      "text": "སངས་རྒྱས་ ༼སྣར། པེ།༽ སངས་ཀྱིས་"
    },
    {
      "span": {
        "start": 45809,
        "end": 45819
      },
      "text": "འཁོར་ལོའི་ ༼སྣར།༽ འཁོར་ལོས་"
    },
    {
      "span": {
        "start": 46421,
        "end": 46435
      },
      "text": "སློབ་དཔོན་གྱི་ ༼སྣར།༽ སློབ་དཔོན་གྱིས་"
    },
    {
      "span": {
        "start": 46669,
        "end": 46678
      },
      "text": "བསྐྱང་བར་ ༼སྣར། པེ།༽ བརྐྱང་བར་"
    },
    {
      "span": {
        "start": 46683,
        "end": 46687
      },
      "text": "བཅུ་ ༼སྣར། པེ།༽ བཅུད་"
    },
    {
      "span": {
        "start": 46692,
        "end": 46700
      },
      "text": "སྒྲོན་མ་ ༼སྣར། པེ།༽ སྒྲོལ་མ་"
    },
    {
      "span": {
        "start": 47107,
        "end": 47112
      },
      "text": "བཏོན། ༼སྣར།༽ གཏོན།"
    },
    {
      "span": {
        "start": 47307,
        "end": 47315
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར། པེ།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 47517,
        "end": 47527
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 47573,
        "end": 47577
      },
      "text": "ཉིས་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 47582,
        "end": 47614
      },
      "text": "ཡིན། །རིག་པ་འཛིན་པ་སུམ་སྟོང་གིས། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 48013,
        "end": 48063
      },
      "text": "། །དེ་ནས་དབུགས་དབྱུང་བ་དཔལ་མཆོག་དང་པོ་ལས་བྱུང་བ། ། ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 48369,
        "end": 48374
      },
      "text": "གསོད་ ༼སྣར། པེ།༽ སོད་"
    },
    {
      "span": {
        "start": 48574,
        "end": 48583
      },
      "text": "བསྲུང་བར་ ༼སྣར། པེ།༽ སྲུང་བར་"
    },
    {
      "span": {
        "start": 48693,
        "end": 48698
      },
      "text": "དོགས་ ༼སྣར།༽ དོག་"
    },
    {
      "span": {
        "start": 48724,
        "end": 48728
      },
      "text": "གཏང་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 49163,
        "end": 49167
      },
      "text": "དེས་ ༼སྣར།༽ དེ་"
    },
    {
      "span": {
        "start": 49516,
        "end": 49523
      },
      "text": "དེས་ནི་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 49547,
        "end": 49552
      },
      "text": "ཕྱིར་ ༼སྣར།༽ ཕྱི་"
    },
    {
      "span": {
        "start": 49805,
        "end": 49810
      },
      "text": "གྱུར། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 49957,
        "end": 49959
      },
      "text": "པ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 50041,
        "end": 50052
      },
      "text": "བསྟན་པ་ཡིས། ༼སྣར། པེ།༽ བསྟན་པ་ཡིན།"
    },
    {
      "span": {
        "start": 50069,
        "end": 50112
      },
      "text": "རྣམ་རྒྱལ་ཏེ། །རྒྱལ་པོའི་བདག་པོར་བསྟན་པ་ཡིན། ༼སྣར། པེ།༽ རྣམ་རྒྱལ་ཏེ།"
    },
    {
      "span": {
        "start": 50264,
        "end": 50267
      },
      "text": "ཟད་ ༼སྣར། པེ།༽ བཟད་"
    },
    {
      "span": {
        "start": 50271,
        "end": 50278
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 50367,
        "end": 50376
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ གཏོགས་པར་"
    },
    {
      "span": {
        "start": 50483,
        "end": 50487
      },
      "text": "བདག་ ༼སྣར། པེ།༽ བཀའ་"
    },
    {
      "span": {
        "start": 50515,
        "end": 50525
      },
      "text": "རྣམས་ཀྱིས། ༼སྣར། པེ།༽ རྣམས་ཀྱི།"
    },
    {
      "span": {
        "start": 50728,
        "end": 50732
      },
      "text": "བླང་ ༼སྣར། པེ།༽ བསླང་"
    },
    {
      "span": {
        "start": 51316,
        "end": 51322
      },
      "text": "གསུངས། ༼སྣར།༽ གསུངས་སོ།"
    },
    {
      "span": {
        "start": 51339,
        "end": 51349
      },
      "text": "ལས་ཅན་གྱི། ༼སྡེ།༽ ལས་ཅན་གྱིས།"
    },
    {
      "span": {
        "start": 51594,
        "end": 51598
      },
      "text": "དཀར་ ༼སྣར། པེ།༽ དམར་"
    },
    {
      "span": {
        "start": 51891,
        "end": 51900
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 51921,
        "end": 51932
      },
      "text": "བྱིན་བརླབས་ ༼སྣར། པེ།༽ བྱིན་རླབས་"
    },
    {
      "span": {
        "start": 52585,
        "end": 52589
      },
      "text": "གསང་ ༼སྣར།༽ སང་"
    },
    {
      "span": {
        "start": 52957,
        "end": 52961
      },
      "text": "འགའ་ ༼སྣར། པེ།༽ འགག་"
    },
    {
      "span": {
        "start": 53180,
        "end": 53190
      },
      "text": "གོམས་གྱུར་ ༼སྣར།༽ གོམས་འགྱུར་ ༼པེ།༽ གོམ་འགྱུར་"
    },
    {
      "span": {
        "start": 53369,
        "end": 53377
      },
      "text": "བསྐལ་པར་ ༼སྣར། པེ།༽ སྐལ་བར་"
    },
    {
      "span": {
        "start": 53482,
        "end": 53486
      },
      "text": "མིན། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 54227,
        "end": 54237
      },
      "text": "རྟོགས་པའི་ ༼སྣར།༽ རྟོག་པའི་"
    },
    {
      "span": {
        "start": 54386,
        "end": 54393
      },
      "text": "བྱས་པས། ༼སྣར། པེ།༽ བྱས་པའི།"
    },
    {
      "span": {
        "start": 54395,
        "end": 54401
      },
      "text": "སྐྱེས་ ༼སྣར། པེ།༽ སྐྱེ་"
    },
    {
      "span": {
        "start": 54478,
        "end": 54483
      },
      "text": "བཟུང་ ༼སྣར།༽ གཟུང་"
    },
    {
      "span": {
        "start": 54784,
        "end": 54814
      },
      "text": "།བདག་ཀྱང་རྒྱལ་བ་ཉིད་གྱུར་ཅིག ། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 55114,
        "end": 55121
      },
      "text": "བསྒྱུར་ ༼སྣར།༽ སྒྱུར་"
    }
  ]
}