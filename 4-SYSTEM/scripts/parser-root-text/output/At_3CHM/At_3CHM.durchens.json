{
  "durchens": [
    {
      "span": {
        "start": 52,
        "end": 61
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 100,
        "end": 108
      },
      "text": "གཤེད་པོ་ ༼སྣར། པེ།༽ གཤེད་"
    },
    {
      "span": {
        "start": 201,
        "end": 208
      },
      "text": "སྲུང་བ་ ༼སྣར།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 240,
        "end": 251
      },
      "text": "རྫོགས་པ་ཡི། ༼སྣར། པེ།༽ རྫོགས་པ་ཡིས།"
    },
    {
      "span": {
        "start": 463,
        "end": 471
      },
      "text": "སྤྲོ་བས་ ༼སྣར། པེ།༽ སྤྲོ་བར་"
    },
    {
      "span": {
        "start": 624,
        "end": 627
      },
      "text": "ཞི་ ༼སྣར།༽ བཞི་"
    },
    {
      "span": {
        "start": 1064,
        "end": 1069
      },
      "text": "རེའུ་ ༼སྣར། པེ།༽ རེ་"
    },
    {
      "span": {
        "start": 1116,
        "end": 1120
      },
      "text": "བྲི་ ༼སྣར། པེ།༽ དྲི་"
    },
    {
      "span": {
        "start": 1274,
        "end": 1279
      },
      "text": "རེའུ་ ༼སྣར། པེ།༽ རི་"
    },
    {
      "span": {
        "start": 1370,
        "end": 1375
      },
      "text": "རེའུ་ ༼སྣར། པེ།༽ རེ་"
    },
    {
      "span": {
        "start": 1414,
        "end": 1419
      },
      "text": "རེའུ་ ༼སྣར། པེ།༽ རེ་"
    },
    {
      "span": {
        "start": 1529,
        "end": 1534
      },
      "text": "སྐོར་ ༼སྣར།༽ བསྐོར་"
    },
    {
      "span": {
        "start": 1557,
        "end": 1565
      },
      "text": "སྐོར་དང་ ༼སྣར།༽ བསྐོར་དག་ ༼པེ།༽ སྐོར་དག་"
    },
    {
      "span": {
        "start": 1573,
        "end": 1587
      },
      "text": "ལས་བཟློག །ཡིག་ ༼སྣར། པེ།༽ ལས་སྡོག ཡིད་"
    },
    {
      "span": {
        "start": 1606,
        "end": 1612
      },
      "text": "སྤྲོད་ ༼པེ།༽ སྤྲད་"
    },
    {
      "span": {
        "start": 1624,
        "end": 1628
      },
      "text": "མཉམ་ ༼སྣར། པེ།༽ མཉན་"
    },
    {
      "span": {
        "start": 1659,
        "end": 1663
      },
      "text": "གཙང་ ༼སྣར། པེ།༽ བཙང་"
    },
    {
      "span": {
        "start": 1844,
        "end": 1849
      },
      "text": "སྟེང་ ༼སྣར། པེ།༽ སྟེངས་"
    },
    {
      "span": {
        "start": 2032,
        "end": 2037
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 2326,
        "end": 2335
      },
      "text": "སྔགས་ཀྱི་ ༼སྣར།༽ སྔགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 2341,
        "end": 2345
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱིས་"
    },
    {
      "span": {
        "start": 2363,
        "end": 2368
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 2663,
        "end": 2673
      },
      "text": "སྤྲོ་བསྡུ་ ༼སྣར།༽ སྤྲོས་སྡུ་"
    },
    {
      "span": {
        "start": 2865,
        "end": 2869
      },
      "text": "བགོ་ ༼སྣར།༽ བློ་"
    },
    {
      "span": {
        "start": 3194,
        "end": 3204
      },
      "text": "བསྐུལ་ཚིག་ ༼སྣར། པེ།༽ སྐུལ་ཚིག་"
    },
    {
      "span": {
        "start": 3350,
        "end": 3357
      },
      "text": "སྲུང་བ་ ༼སྣར།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 3524,
        "end": 3532
      },
      "text": "ཀུན་གྱི་ ༼སྣར། པེ།༽ ཀུན་གྱིས་"
    }
  ]
}