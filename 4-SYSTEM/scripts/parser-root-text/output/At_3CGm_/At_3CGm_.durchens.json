{
  "durchens": [
    {
      "span": {
        "start": 512,
        "end": 518
      },
      "text": "གཞུག ། ༼པེ།༽ བཞུག །"
    },
    {
      "span": {
        "start": 1048,
        "end": 1055
      },
      "text": "བསྟིམས་ ༼པེ།༽ སྟིམས་"
    },
    {
      "span": {
        "start": 1537,
        "end": 1548
      },
      "text": "བསྒྱུར་བའི་ ༼པེ།༽ སྒྱུར་བའི་"
    },
    {
      "span": {
        "start": 1833,
        "end": 1837
      },
      "text": "ཁམས་ ༼པེ།༽ ཁམ་"
    },
    {
      "span": {
        "start": 2415,
        "end": 2423
      },
      "text": "ཀུན་གྱི་ ༼པེ།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 3055,
        "end": 3060
      },
      "text": "རྟེན་ ༼པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 3104,
        "end": 3112
      },
      "text": "བའོ།། །། ༼པེ།༽ བའོབབའོ་མངྒཱ་ལཾ། །།"
    }
  ]
}