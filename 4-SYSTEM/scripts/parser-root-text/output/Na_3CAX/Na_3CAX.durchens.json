{
  "durchens": [
    {
      "span": {
        "start": 30,
        "end": 33
      },
      "text": "གྲ་ ༼པེ།༽ ཀྲ་"
    },
    {
      "span": {
        "start": 1065,
        "end": 1076
      },
      "text": "སྐྱིལ་ཀྲུང་ ༼པེ།༽ དཀྱིལ་དཀྲུངས་"
    },
    {
      "span": {
        "start": 1891,
        "end": 1896
      },
      "text": "བསྟས་ ༼པེ།༽ བལྟས་"
    },
    {
      "span": {
        "start": 2300,
        "end": 2307
      },
      "text": "གདུག་པ་ ༼པེ།༽ གདུགས་པ་"
    },
    {
      "span": {
        "start": 2808,
        "end": 2816
      },
      "text": "སྒོམ་པར་ ༼པེ།༽ བསྒོམ་པར་"
    },
    {
      "span": {
        "start": 5206,
        "end": 5217
      },
      "text": "འགྲོ་བར་ཏེ། ༼པེ།༽ འགྲོ་བར་སྟེ།"
    },
    {
      "span": {
        "start": 6501,
        "end": 6510
      },
      "text": "བརྩམས་པར་ ༼པེ།༽ བསམ་པར་"
    },
    {
      "span": {
        "start": 8165,
        "end": 8174
      },
      "text": "བཤིན་རྗེ་ ༼པེ།༽ གཤིན་རྗེ་"
    },
    {
      "span": {
        "start": 8344,
        "end": 8352
      },
      "text": "དབྱུག་པ་ ༼པེ།༽ དབྱུགས་པ་"
    },
    {
      "span": {
        "start": 8667,
        "end": 8671
      },
      "text": "བསམ། ༼པེ།༽ བསམས།"
    },
    {
      "span": {
        "start": 9436,
        "end": 9444
      },
      "text": "ཀུན་གྱི་ ༼པེ།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 9712,
        "end": 9721
      },
      "text": "བསྔགས་པས་ ༼པེ།༽ སྔགས་པས་"
    },
    {
      "span": {
        "start": 9887,
        "end": 9896
      },
      "text": "བརླབས་ནས་ ༼པེ།༽ བརླབས་གནས་"
    },
    {
      "span": {
        "start": 10319,
        "end": 10322
      },
      "text": "སྭ་ ༼པེ།༽ སྭཱ་"
    },
    {
      "span": {
        "start": 10379,
        "end": 10384
      },
      "text": "བསམས་ ༼པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 10640,
        "end": 10645
      },
      "text": "བརླབ་ ༼པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 10772,
        "end": 10777
      },
      "text": "བརླབ་ ༼པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 10962,
        "end": 10970
      },
      "text": "གསང་བའི་ ༼པེ།༽ གསང་བ་པའི་"
    },
    {
      "span": {
        "start": 11442,
        "end": 11451
      },
      "text": "ཏིང་འཛིན་ ༼པེ།༽ ཏིང་ངེ་འཛིན་"
    },
    {
      "span": {
        "start": 12408,
        "end": 12415
      },
      "text": "གཡོན་པ་ ༼པེ།༽ གཡོན་"
    },
    {
      "span": {
        "start": 13862,
        "end": 13869
      },
      "text": "འདུག་པ་ ༼པེ།༽ འདུག་པར་"
    },
    {
      "span": {
        "start": 13957,
        "end": 13964
      },
      "text": "གྱུར་ན། ༼པེ།༽ གྱུར་ནས།"
    },
    {
      "span": {
        "start": 14763,
        "end": 14773
      },
      "text": "དབུ་བརྒྱན་ ༼པེ།༽ དབུ་རྒྱན་"
    },
    {
      "span": {
        "start": 15452,
        "end": 15462
      },
      "text": "གཉིས་ཀྱིས། ༼པེ།༽ གཉིས།"
    },
    {
      "span": {
        "start": 16060,
        "end": 16064
      },
      "text": "ཧ་ར་ ༼པེ།༽ ཧ་"
    },
    {
      "span": {
        "start": 16721,
        "end": 16731
      },
      "text": "། །ཨུད་པལ་ ༼པེ།༽ ། །ཨཏྤལ་"
    },
    {
      "span": {
        "start": 16858,
        "end": 16865
      },
      "text": "བསྲུངས་ ༼པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 17766,
        "end": 17771
      },
      "text": "ཞུགས་ ༼པེ།༽ བཞུགས་"
    },
    {
      "span": {
        "start": 18463,
        "end": 18470
      },
      "text": "སྔ་སྒྲ་ ༼པེ།༽ རྔ་སྒྲ་"
    },
    {
      "span": {
        "start": 20209,
        "end": 20217
      },
      "text": "སྔགས་ལས་ ༼པེ།༽ སྔགས་པས་"
    },
    {
      "span": {
        "start": 20239,
        "end": 20242
      },
      "text": "པས་ ༼པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 21180,
        "end": 21183
      },
      "text": "ནི་ ༼པེ།༽ ནཱི་"
    },
    {
      "span": {
        "start": 21304,
        "end": 21309
      },
      "text": "གསུས་ ༼པེ།༽ སུས་"
    },
    {
      "span": {
        "start": 21627,
        "end": 21634
      },
      "text": "འབྱུང་། ༼པེ།༽ དབྱུང་།"
    },
    {
      "span": {
        "start": 21681,
        "end": 21691
      },
      "text": "དབུ་བརྒྱན་ ༼པེ།༽ དབུ་རྒྱན་"
    },
    {
      "span": {
        "start": 22665,
        "end": 22676
      },
      "text": "སྡིགས་འཛུབ་ ༼པེ།༽ སྡིགས་མཛུབ་"
    },
    {
      "span": {
        "start": 23105,
        "end": 23116
      },
      "text": "སྡིགས་འཛུབ་ ༼པེ།༽ སྡིགས་མཛུབ་"
    },
    {
      "span": {
        "start": 23187,
        "end": 23194
      },
      "text": "སྙམས་པ་ ༼པེ།༽ སྙེམས་པ་"
    },
    {
      "span": {
        "start": 23747,
        "end": 23751
      },
      "text": "འོག་ ༼པེ།༽ འོད་"
    },
    {
      "span": {
        "start": 23912,
        "end": 23917
      },
      "text": "བསམས། ༼པེ།༽ བརྩམ།"
    },
    {
      "span": {
        "start": 23919,
        "end": 23924
      },
      "text": "ཉུངས་ ༼པེ།༽ ཉུང་"
    },
    {
      "span": {
        "start": 25164,
        "end": 25168
      },
      "text": "རྩེ་ ༼པེ།༽ བརྩེ་"
    },
    {
      "span": {
        "start": 26090,
        "end": 26096
      },
      "text": "བསྙེས། ༼པེ།༽ བརྙེས།"
    },
    {
      "span": {
        "start": 26920,
        "end": 26927
      },
      "text": "ཐེ་ཚོམ་ ༼པེ།༽ ཐེ་ཙོམ་"
    },
    {
      "span": {
        "start": 27957,
        "end": 27965
      },
      "text": "ཕྲེང་བས་ ༼པེ།༽ ཕྲེང་བ་"
    }
  ]
}