{
  "durchens": [
    {
      "span": {
        "start": 313,
        "end": 322
      },
      "text": "མཛད་ཅིང་། ༼སྣར། པེ།༽ མཛད་པ།"
    },
    {
      "span": {
        "start": 376,
        "end": 380
      },
      "text": "མཐུ་ ༼སྣར། པེ།༽ མཆུ་"
    },
    {
      "span": {
        "start": 463,
        "end": 470
      },
      "text": "པའི་ཁྭ་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 500,
        "end": 503
      },
      "text": "སྨ་ ༼སྣར། པེ།༽ རྨ་"
    },
    {
      "span": {
        "start": 505,
        "end": 509
      },
      "text": "ཆེས་ ༼སྣར། པེ།༽ ཆེར་"
    },
    {
      "span": {
        "start": 577,
        "end": 585
      },
      "text": "སྤྱན་མར་ ༼སྣར། པེ།༽ སྤྱན་དམར་"
    },
    {
      "span": {
        "start": 595,
        "end": 602
      },
      "text": "བསྒྱུར་ ༼སྣར། པེ།༽ སྒྱུར་"
    },
    {
      "span": {
        "start": 863,
        "end": 873
      },
      "text": "བ་འཐུངས་པ་ ༼སྣར། པེ།༽ དེ་འཐུང་བ་"
    },
    {
      "span": {
        "start": 953,
        "end": 961
      },
      "text": "མཛད་པའི། ༼སྣར། པེ།༽ མཛད་པ།"
    },
    {
      "span": {
        "start": 999,
        "end": 1002
      },
      "text": "ཚད་ ༼སྣར། པེ།༽ མཛད་"
    },
    {
      "span": {
        "start": 1147,
        "end": 1155
      },
      "text": "ཐུགས་ཅན་ ༼སྣར། པེ།༽ གཟུགས་ཅན་"
    },
    {
      "span": {
        "start": 1191,
        "end": 1196
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 1211,
        "end": 1236
      },
      "text": "སྣ་ཚོགས་མནན་ཅིང་མནན་ནས་ཧ་ ༼སྣར།༽ སྣ་ཚོགས་བསྣན་ཅིང་བསྣན་ནས་ ༼པེ།༽ སྣ་ཚོགས་བསྣན་ཅིང་བསྣན་ནས་ཀ་ཧ་"
    },
    {
      "span": {
        "start": 1238,
        "end": 1242
      },
      "text": "ཧ་ཀ་ ༼སྣར།༽ ཧ་ཀ་ཧ་ ༼པེ།༽ ཧ་"
    },
    {
      "span": {
        "start": 1294,
        "end": 1307
      },
      "text": "རྒྱུ་མས་བྲེལ་ ༼སྣར། པེ།༽ རྒྱུ་མ་སྦྲེལ་"
    },
    {
      "span": {
        "start": 1311,
        "end": 1321
      },
      "text": "རྒྱན་གྱིས་ ༼སྣར། པེ།༽ ཕྲེང་བས་"
    },
    {
      "span": {
        "start": 1425,
        "end": 1430
      },
      "text": "ཚོགས། ༼སྣར། པེ།༽ ཆགས།"
    },
    {
      "span": {
        "start": 1438,
        "end": 1443
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 1469,
        "end": 1478
      },
      "text": "མགོ་བོའི་ ༼སྣར། པེ།༽ མགོ་བོ་"
    },
    {
      "span": {
        "start": 1622,
        "end": 1626
      },
      "text": "མཚོ་ ༼སྣར། པེ།༽ ས་"
    },
    {
      "span": {
        "start": 1648,
        "end": 1656
      },
      "text": "སྲུང་བར་ ༼སྣར། པེ།༽ བསྲུང་བར་"
    },
    {
      "span": {
        "start": 1656,
        "end": 1660
      },
      "text": "མཛད། ༼སྣར། པེ།༽ མཛོད།"
    },
    {
      "span": {
        "start": 1684,
        "end": 1686
      },
      "text": "པ་ ༼སྣར། པེ།༽ པས་"
    },
    {
      "span": {
        "start": 1729,
        "end": 1735
      },
      "text": "བཞུགས་ ༼པེ།༽ གཞུགས་"
    },
    {
      "span": {
        "start": 1759,
        "end": 1767
      },
      "text": "སྲུང་བར་ ༼སྣར། པེ།༽ སྐྱོད་པར་"
    },
    {
      "span": {
        "start": 1785,
        "end": 1794
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 1816,
        "end": 1826
      },
      "text": "མཛོད་ཅིག ། ༼སྣར། པེ།༽ མཛོད། །"
    },
    {
      "span": {
        "start": 1888,
        "end": 1896
      },
      "text": "བརྙེས་པ་ ༼སྣར། པེ།༽ མཉེས་པ་"
    },
    {
      "span": {
        "start": 2104,
        "end": 2115
      },
      "text": "དག་ཐོས་ཅིང་ ༼སྣར། པེ།༽ དམ་ཚིག་ཐོགས་"
    },
    {
      "span": {
        "start": 2182,
        "end": 2187
      },
      "text": "འགྲོ་ ༼སྣར། པེ།༽ ཁྲོ་"
    },
    {
      "span": {
        "start": 2399,
        "end": 2405
      },
      "text": "གང་། ། ༼སྣར། པེ།༽ ། །ཀྵཾ་ཀྵཾ་ཀྵཾ་ཞེས་ཕན་པར་མཛད་ཅིང་གནོད་པ་སྐད་ཅིག་གིས་སེལ་ཞིང་སྐྱོང་ཁྱོད་ཀྱིས་སྐྱོངས།"
    },
    {
      "span": {
        "start": 2511,
        "end": 2520
      },
      "text": "ཐུགས་ཀྱི་ ༼སྣར། པེ།༽ ཐུགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 2532,
        "end": 2542
      },
      "text": "ལ་འབྲས་བུ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 2546,
        "end": 2551
      },
      "text": "གྲོས་ ༼སྣར། པེ།༽ གྲོས་འབྲས་བུ་"
    },
    {
      "span": {
        "start": 2674,
        "end": 2682
      },
      "text": "འགའ་ཞིག་ ༼སྣར། པེ།༽ གང་ཞིག་"
    },
    {
      "span": {
        "start": 2682,
        "end": 2689
      },
      "text": "དམ་ཚིག་ ༼སྣར། པེ།༽ དམ་ཚིག་ཐོས་འཛིན་"
    },
    {
      "span": {
        "start": 2704,
        "end": 2710
      },
      "text": "གུས་པ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 2710,
        "end": 2715
      },
      "text": "ཡི། ། ༼སྣར། པེ།༽ དག །"
    },
    {
      "span": {
        "start": 2719,
        "end": 2727
      },
      "text": "གཉིས་སུ་ ༼སྣར། པེ།༽ གསུམ་དུ་"
    },
    {
      "span": {
        "start": 2781,
        "end": 2788
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 2858,
        "end": 2870
      },
      "text": "མཚུངས་པ་མེད། ༼སྣར། པེ།༽ མཚུངས་མེད་སྟེར།"
    },
    {
      "span": {
        "start": 3035,
        "end": 3042
      },
      "text": "ཞལ་མངའ་ ༼སྣར། པེ།༽ ཞལ་སྔ་"
    },
    {
      "span": {
        "start": 3068,
        "end": 3075
      },
      "text": "མཁན་པོ་ ༼སྣར། པེ།༽ མཁན་པོ་ཀོ་ས་ལའི་རྣལ་འབྱོར་པ་"
    },
    {
      "span": {
        "start": 3119,
        "end": 3126
      },
      "text": "ལྡི་རི་ ༼སྣར། པེ།༽ དིང་རི་"
    }
  ]
}