{
  "durchens": [
    {
      "span": {
        "start": 196,
        "end": 201
      },
      "text": "ལོ། ། ༼པེ།༽ ཁམས་གསུམ་ལ་ནི་ཡེ་ཤེས་ཉིན་མོར་བྱེད་པ་ཡི། །དཔལ་ལྡན་ཤཱཀྱ་སེང་གེ་བྱམས་པ་མགོན་པོ་དང་། །འཇམ་དབྱངས་བཅས་པ་ཡིད་བཞིན་ནོར་དང་གྲགས་པ་དང་། །རྡོ་རྗེ་འཛིན་པ་རྣམས་ལ་ཕྱག་འཚལ་དགོངས་སུ་གསོལ་ ༼སྣར།༽ འཕགས་པ་སྤྱན་རས་གཟིགས་དབང་ཕྱུག་ལ་སྨྲེ་སྔགས་ཀྱི་སྒོ་ནས་བསྟོད་པ་བྱིན་རླབས་ཅན་སློབ་དཔོན་ཟླ་བ་གྲགས་པས་མཛད་པ་བཞུགས་སོ། །༄། ན་མོ་ལོ་ཀེ་ཤྭ་རཱ་ཡ་"
    },
    {
      "span": {
        "start": 574,
        "end": 579
      },
      "text": "འཁྱམ། ༼སྣར། པེ།༽ འཁྱམས།"
    },
    {
      "span": {
        "start": 642,
        "end": 645
      },
      "text": "རབ་ ༼སྣར། པེ།༽ རང་"
    },
    {
      "span": {
        "start": 915,
        "end": 923
      },
      "text": "འཚུབ་མས་ ༼སྣར།༽ ཚུབ་མས་ ༼པེ།༽ འཚུབས་པས་"
    },
    {
      "span": {
        "start": 1070,
        "end": 1075
      },
      "text": "དུགས་ ༼སྣར།༽ གདུགས་ ༼པེ།༽ དུག་"
    },
    {
      "span": {
        "start": 1286,
        "end": 1292
      },
      "text": "བསྡོས་ ༼སྣར།༽ བསྡོམས་ ༼པེ།༽ སྔོས་"
    },
    {
      "span": {
        "start": 1543,
        "end": 1546
      },
      "text": "ཡི་ ༼སྣར། པེ།༽ ཡིད་"
    },
    {
      "span": {
        "start": 1634,
        "end": 1642
      },
      "text": "འབོག་པར་ ༼སྣར།༽ ཟློག་པར་ ༼པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 2191,
        "end": 2200
      },
      "text": "ཕོངས་པའི་ ༼སྣར།༽ འཕོངས་པའི་"
    },
    {
      "span": {
        "start": 2903,
        "end": 2912
      },
      "text": "གཅིག་གིས་ ༼སྣར།༽ གཅིག་ཅིག་ ༼པེ།༽ གཅིག་གཅིག་"
    },
    {
      "span": {
        "start": 3083,
        "end": 3091
      },
      "text": "དྲག་པོས་ ༼སྣར།༽ དྲག་པོའི་"
    },
    {
      "span": {
        "start": 3184,
        "end": 3228
      },
      "text": "། །བྱམས་མགོན་ཐུགས་རྗེ་ཅན་གྱིས་བཟོད་ལགས་སམ། ། ༼པེ།༽ ། །"
    },
    {
      "span": {
        "start": 3533,
        "end": 3542
      },
      "text": "ཐུགས་རྗེ་ ༼སྣར།༽ ཐུགས་རྗེས་"
    },
    {
      "span": {
        "start": 3725,
        "end": 4102
      },
      "text": "། །སྡུག་བསྔལ་ཆེན་པོས་མནར་རོ་ར་མདའ་མཛོད། །རེ་སས་སླུ་བར་མ་མཛད་སྤྱན་རས་གཟིགས། །གང་ལ་གང་འདུལ་འགྲོ་བའི་དོན་མཛད་པར། །ཞལ་བཞེས་མང་པོའི་དམ་བཅའ་མི་མཛད་དམ། །མཐོང་ཐོས་དྲན་རེག་འབྱུང་བར་མ་གསུངས་སམ། །སྙིགས་མའི་དུས་ཀྱི་ངན་སྤྱོད་མ་གཟིགས་སམ། །ངན་སོང་རྒྱུ་འབྲས་བསྒྲུབ་པ་མ་གཟིགས་སམ། །སྡུག་བསྔལ་དབའ་ཀློང་འཁྲུགས་པ་མ་མཁྱེན་ནམ། །ནུས་མཐུ་དཔག་མེད་མངའ་བ་མ་ལགས་སམ། །བྱམས་མགོན་འགྲོ་དོན་མཛད་པར་འཕྱིས་པ་ཙམ། ། ༼པེ།༽ ། །"
    },
    {
      "span": {
        "start": 4234,
        "end": 4241
      },
      "text": "རང་སོར་ ༼སྣར། པེ།༽ རང་སར་"
    },
    {
      "span": {
        "start": 4287,
        "end": 4370
      },
      "text": "། །ཐུགས་རྗེས་འགྲོ་རྣམས་སྒྲོལ་བར་ཞལ་བཞེས་པའི། །དམ་བཅས་དོན་དེ་དེ་རིང་དགོངས་སུ་གསོལ། ། ༼པེ།༽ ། །"
    },
    {
      "span": {
        "start": 4755,
        "end": 4761
      },
      "text": "།། །།།༄༅༅། ། ༼པེ།༽ ། །ཐུགས་རྗེ་ཆེན་པོའི་གསོལ་འདེབས་སློབ་དཔོན་ཟླ་བ་གྲགས་པས་མཛད་པའོ། །།༄༅༅། །"
    },
    {
      "span": {
        "start": 5209,
        "end": 5215
      },
      "text": "བརྟྟི། ༼སྣར།༽ ཏི།"
    }
  ]
}