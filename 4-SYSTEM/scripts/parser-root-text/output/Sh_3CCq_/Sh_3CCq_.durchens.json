{
  "durchens": [
    {
      "span": {
        "start": 135,
        "end": 142
      },
      "text": "བསལ་བར་ ༼སྣར།༽ གསལ་བར་"
    },
    {
      "span": {
        "start": 293,
        "end": 307
      },
      "text": "པའི་སྡུག་བསྔལ་ ༼སྣར། པེ།༽ གྱི་གནོད་པ་"
    },
    {
      "span": {
        "start": 555,
        "end": 559
      },
      "text": "ཁྲོ་ ༼སྣར། པེ།༽ ཁྲོ་བ་"
    },
    {
      "span": {
        "start": 615,
        "end": 624
      },
      "text": "གྲུབ་པའི་ ༼སྣར། པེ།༽ འགྲུབ་པའི་"
    },
    {
      "span": {
        "start": 667,
        "end": 670
      },
      "text": "དག་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 943,
        "end": 950
      },
      "text": "འདོད་ལ། ༼སྣར། པེ།༽ འདོད་པ།"
    },
    {
      "span": {
        "start": 1002,
        "end": 1007
      },
      "text": "བཟང་། ༼སྣར།༽ བཟངས།"
    },
    {
      "span": {
        "start": 1040,
        "end": 1052
      },
      "text": "དཔག་བསམ་གྱི་ ༼སྣར། པེ།༽ དཔག་བསམ་གྱིས་"
    },
    {
      "span": {
        "start": 1224,
        "end": 1229
      },
      "text": "མཁའི་ ༼སྣར། པེ།༽ ཁས་"
    },
    {
      "span": {
        "start": 1304,
        "end": 1308
      },
      "text": "ཉེར་ ༼སྣར། པེ།༽ ཉེ་"
    },
    {
      "span": {
        "start": 1327,
        "end": 1335
      },
      "text": "བདག་གིས་ ༼སྣར།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 1369,
        "end": 1377
      },
      "text": "བརྩམས་པ་ ༼པེ།༽ བསམས་པ་"
    },
    {
      "span": {
        "start": 1501,
        "end": 1505
      },
      "text": "བདག་ ༼སྣར།༽ དག་"
    },
    {
      "span": {
        "start": 1508,
        "end": 1522
      },
      "text": "བསོད་ནམས་ཀྱིས། ༼སྣར།༽ བསོད་ནམས་ཀྱི།"
    },
    {
      "span": {
        "start": 1581,
        "end": 1587
      },
      "text": "བར་དུ་ ༼སྣར།༽ བར་ཏུ་"
    },
    {
      "span": {
        "start": 1591,
        "end": 1594
      },
      "text": "ལས་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 1713,
        "end": 1722
      },
      "text": "དེ་དག་ཏུ་ ༼སྣར། པེ།༽ དེ་དག་དུ་"
    },
    {
      "span": {
        "start": 1739,
        "end": 1747
      },
      "text": "བདེ་ཆེན་ ༼སྣར། པེ།༽ བདེ་ཅན་"
    },
    {
      "span": {
        "start": 1840,
        "end": 1848
      },
      "text": "ཡས་ཀྱིས། ༼སྣར།༽ ཡས་ཀྱི།"
    },
    {
      "span": {
        "start": 1913,
        "end": 1923
      },
      "text": "སྡུག་དགུར་ ༼སྣར། པེ།༽ སྡུག་གུར་"
    },
    {
      "span": {
        "start": 1968,
        "end": 1977
      },
      "text": "འཁྲུང་བར་ ༼སྣར། པེ།༽ འཁྲུངས་པར་"
    },
    {
      "span": {
        "start": 2065,
        "end": 2073
      },
      "text": "བསུང་ཆེ་ ༼སྣར།༽ གསུང་ཆེན་"
    },
    {
      "span": {
        "start": 2577,
        "end": 2581
      },
      "text": "འབབ་ ༼སྣར། པེ།༽ འབབས་"
    },
    {
      "span": {
        "start": 2598,
        "end": 2602
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིར་"
    },
    {
      "span": {
        "start": 2715,
        "end": 2723
      },
      "text": "ཡིན་སྙམ་ ༼སྣར།༽ ཡིན་པས་ ༼པེ།༽ པམ་"
    },
    {
      "span": {
        "start": 2774,
        "end": 2780
      },
      "text": "འབར་བ་ ༼སྣར།༽ འབར་བར་"
    },
    {
      "span": {
        "start": 2926,
        "end": 2934
      },
      "text": "གསོད་པར་ ༼སྣར། པེ།༽ གསོད་པ་"
    },
    {
      "span": {
        "start": 2977,
        "end": 2983
      },
      "text": "བསམ་པ་ ༼སྣར། པེ།༽ བསམས་པ་"
    },
    {
      "span": {
        "start": 2999,
        "end": 3009
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 3082,
        "end": 3088
      },
      "text": "དུ་ནི། ༼སྣར། པེ།༽ དུ་དུ་"
    },
    {
      "span": {
        "start": 3156,
        "end": 3168
      },
      "text": "ཀུན་ནས་ཡོངས་ ༼སྣར། པེ།༽ ཀུན་"
    },
    {
      "span": {
        "start": 3182,
        "end": 3187
      },
      "text": "སེམས་ ༼སྣར། པེ།༽ སེམས་དཔའ་འོད་"
    },
    {
      "span": {
        "start": 3297,
        "end": 3303
      },
      "text": "དག་གི་ ༼སྣར། པེ།༽ དག་གིས་"
    },
    {
      "span": {
        "start": 3307,
        "end": 3311
      },
      "text": "ཀྱི་ ༼པེ།༽ ཀྱིས་"
    },
    {
      "span": {
        "start": 3337,
        "end": 3341
      },
      "text": "རླན་ ༼སྣར། པེ།༽ བརླན་"
    },
    {
      "span": {
        "start": 3346,
        "end": 3351
      },
      "text": "དབུལ་ ༼སྣར།༽ མ་"
    },
    {
      "span": {
        "start": 3495,
        "end": 3500
      },
      "text": "ཅ་ཅོ་ ༼སྣར། པེ།༽ ཀུ་ཅོ་"
    },
    {
      "span": {
        "start": 3611,
        "end": 3622
      },
      "text": "དྲི་ཞིམ་ངད་ ༼སྣར།༽ དྲི་ཞིམ་པ་"
    },
    {
      "span": {
        "start": 3964,
        "end": 3975
      },
      "text": "རྟག་ཏུ་སྒྲ་ ༼སྣར། པེ།༽ རྟག་ཏུ་"
    },
    {
      "span": {
        "start": 3975,
        "end": 3979
      },
      "text": "ཐོས་ ༼སྣར། པེ།༽ ཐོས་པར་"
    },
    {
      "span": {
        "start": 4051,
        "end": 4061
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 4082,
        "end": 4092
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 4214,
        "end": 4217
      },
      "text": "ཡི་ ༼སྣར། པེ།༽ ཡིད་"
    },
    {
      "span": {
        "start": 4229,
        "end": 4233
      },
      "text": "ཡིད་ ༼སྣར། པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 4244,
        "end": 4251
      },
      "text": "བརྟན་པ་ ༼སྣར། པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 4481,
        "end": 4486
      },
      "text": "མཉེན་ ༼སྣར།༽ གཉེན་"
    },
    {
      "span": {
        "start": 4643,
        "end": 4649
      },
      "text": "བསམ་པ་ ༼སྣར། པེ།༽ བསམས་པ་"
    },
    {
      "span": {
        "start": 4708,
        "end": 4715
      },
      "text": "དགའ་བར་ ༼སྣར།༽ དག་པར་"
    },
    {
      "span": {
        "start": 4877,
        "end": 4888
      },
      "text": "མགོན་མེད་པ། ༼སྣར། པེ།༽ མགོན་མེད་པར།"
    },
    {
      "span": {
        "start": 5018,
        "end": 5027
      },
      "text": "ཕུན་ཚོགས་ ༼སྣར། པེ།༽ སྣ་ཚོགས་"
    },
    {
      "span": {
        "start": 5192,
        "end": 5196
      },
      "text": "ཆུང་ ༼སྣར།༽ ཆུ་"
    },
    {
      "span": {
        "start": 5351,
        "end": 5355
      },
      "text": "རབས་ ༼སྣར།༽ རབ་"
    },
    {
      "span": {
        "start": 5360,
        "end": 5367
      },
      "text": "ནི་མཐོ་ ༼སྣར།༽ ཀྱི་ཐོ་ ༼པེ།༽ ཀྱི་ཐོབ་"
    },
    {
      "span": {
        "start": 5625,
        "end": 5633
      },
      "text": "སྤོང་བར་ ༼སྣར། པེ།༽ སྤངས་པར་"
    },
    {
      "span": {
        "start": 5827,
        "end": 5836
      },
      "text": "གང་པ་ཡིས། ༼སྣར།༽ གང་པ་ཡི།"
    },
    {
      "span": {
        "start": 5920,
        "end": 5925
      },
      "text": "མཐིལ་ ༼སྣར། པེ།༽ འཐིལ་"
    },
    {
      "span": {
        "start": 6052,
        "end": 6060
      },
      "text": "ས་སྟེངས་ ༼སྣར། པེ།༽ ས་སྟེང་"
    },
    {
      "span": {
        "start": 6395,
        "end": 6410
      },
      "text": "བྱེད་གྱུར་ཅིག ། ༼སྣར། པེ།༽ བྱེད་པ་དང་། །"
    },
    {
      "span": {
        "start": 6486,
        "end": 6494
      },
      "text": "གྲུབ་པར་ ༼སྣར། པེ།༽ འགྲུབ་པར་"
    },
    {
      "span": {
        "start": 6589,
        "end": 6595
      },
      "text": "འཇིགས་ ༼སྣར། པེ།༽ འཇིག་"
    },
    {
      "span": {
        "start": 6926,
        "end": 6934
      },
      "text": "སྤོང་བར་ ༼སྣར། པེ།༽ སྤངས་པར་"
    },
    {
      "span": {
        "start": 7338,
        "end": 7349
      },
      "text": "འགྲུབ་ཤོག ། ༼སྣར། པེ།༽ གྲུབ་འགྱུར། །"
    },
    {
      "span": {
        "start": 7425,
        "end": 7437
      },
      "text": "བསམ་ཡས་ཀྱིས། ༼སྣར། པེ།༽ བསམ་ཡས་ཀྱི།"
    },
    {
      "span": {
        "start": 7521,
        "end": 7527
      },
      "text": "འགྲུབ་ ༼སྣར། པེ།༽ གྲུབ་"
    },
    {
      "span": {
        "start": 7736,
        "end": 7743
      },
      "text": "བྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 7822,
        "end": 7834
      },
      "text": "དབེན་གནས་པར། ༼སྣར། པེ།༽ དབེན་གནས་པ།"
    },
    {
      "span": {
        "start": 7854,
        "end": 7862
      },
      "text": "པར་ཤོག ། ༼སྣར། པེ།༽ གྱུར་ཅིག །"
    },
    {
      "span": {
        "start": 8024,
        "end": 8035
      },
      "text": "བསྒྲུབ་པའི་ ༼སྣར། པེ།༽ བསྒྲུབ་བྱའི་"
    },
    {
      "span": {
        "start": 8135,
        "end": 8137
      },
      "text": "བ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 8243,
        "end": 8246
      },
      "text": "འང་ ༼སྣར།༽ དུ་ཅིའི་"
    },
    {
      "span": {
        "start": 8361,
        "end": 8370
      },
      "text": "སྨན་གཅིག་ ༼སྣར། པེ།༽ སྨན་ཅིག་"
    },
    {
      "span": {
        "start": 8411,
        "end": 8416
      },
      "text": "རྙེད་ ༼སྣར།༽ སྙེད་"
    },
    {
      "span": {
        "start": 8535,
        "end": 8544
      },
      "text": "བྱུང་བའི་ ༼སྣར། པེ།༽ འབྱུང་བའི་"
    }
  ]
}