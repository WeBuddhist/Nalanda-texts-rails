{
  "durchens": [
    {
      "span": {
        "start": 153,
        "end": 163
      },
      "text": "སྒྲོལ་མ་ལ་ ༼པེ།༽ སྒྲོལ་མ་"
    },
    {
      "span": {
        "start": 353,
        "end": 366
      },
      "text": "འགྲོ་བ་མ་ལུས་ ༼པེ།༽ འགྲོ་བ་མ་"
    },
    {
      "span": {
        "start": 501,
        "end": 504
      },
      "text": "དལ་ ༼པེ།༽ དཀྱིལ་འཁོར་"
    },
    {
      "span": {
        "start": 1101,
        "end": 1127
      },
      "text": "བཞི་སེམས་བསྐྱེད་པའི་རང་ངོ་ ༼པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 1538,
        "end": 1546
      },
      "text": "བདག་ཉིད་ ༼པེ།༽ བདག་ཉིད་ཉིད་"
    },
    {
      "span": {
        "start": 1798,
        "end": 1810
      },
      "text": "དྲི་ཞིམ་པོས་ ༼པེ།༽ དྲི་ཞིམ་པོ་"
    },
    {
      "span": {
        "start": 2392,
        "end": 2402
      },
      "text": "དུ་སྐྱེ་བ་ ༼པེ།༽ དུ་བྱེད་"
    },
    {
      "span": {
        "start": 2772,
        "end": 2782
      },
      "text": "བསྒྱུར་བར་ ༼པེ།༽ སྒྱུར་བར་"
    },
    {
      "span": {
        "start": 2869,
        "end": 2878
      },
      "text": "འབུལ་བ་བ་ ༼པེ།༽ འབུལ་བ་"
    }
  ]
}