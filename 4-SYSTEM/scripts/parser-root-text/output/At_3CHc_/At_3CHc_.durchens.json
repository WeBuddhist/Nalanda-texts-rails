{
  "durchens": [
    {
      "span": {
        "start": 533,
        "end": 536
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 619,
        "end": 626
      },
      "text": "སོགས་པ་ ༼སྣར། པེ།༽ སོགས་"
    },
    {
      "span": {
        "start": 913,
        "end": 917
      },
      "text": "བཅས་ ༼སྣར། པེ།༽ དང་བཅས་པ་"
    },
    {
      "span": {
        "start": 975,
        "end": 979
      },
      "text": "ཧྱེ་ ༼སྣར། པེ།༽ ཧེ་"
    },
    {
      "span": {
        "start": 1209,
        "end": 1216
      },
      "text": "འབུལ་བ་ ༼སྣར། པེ།༽ དབུལ་བ་"
    },
    {
      "span": {
        "start": 1271,
        "end": 1280
      },
      "text": "གཏམས་པའི་ ༼སྣར། པེ།༽ བལྟམས་པའི་"
    },
    {
      "span": {
        "start": 1316,
        "end": 1321
      },
      "text": "འབུལ། ༼སྣར། པེ།༽ དབུལ།"
    },
    {
      "span": {
        "start": 1359,
        "end": 1391
      },
      "text": "བཅུ་ཀུན་ནས་རྣམ་དག་རྫས་ཀྱི་མཆོག ། ༼སྣར། པེ།༽ བཅུ། །"
    },
    {
      "span": {
        "start": 1399,
        "end": 1408
      },
      "text": "གཏམས་པའི་ ༼སྣར། པེ།༽ བལྟམས་པའི་"
    },
    {
      "span": {
        "start": 1425,
        "end": 1430
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམས་སྣང་གསལ་འདི། གཟའ་རྣམས། གདུག །སྤོས། གཤོས་གཙང་། སིལ་སྙན་"
    },
    {
      "span": {
        "start": 1943,
        "end": 2098
      },
      "text": "རྣམས་འཁོར་དང་བཅས་ལ་འབུལ། །དམ་ཚིག་དབང་གིས་བཞེས་སུ་གསོལ། །ཕྱོགས་བཅུ་ཀུན་ནས་རྣམ་དག་རྫས་ཀྱི་མཆོག །མཛེས་པར་གཏམས་པའི་སིལ་སྙན་འདི། །གཟའ་རྣམས་འཁོར་དང་བཅས་ལ་འབུལ། ། ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 2162,
        "end": 2169
      },
      "text": "འབུལ་བ་ ༼སྣར། པེ།༽ དབུལ་བ་"
    },
    {
      "span": {
        "start": 3063,
        "end": 3073
      },
      "text": "རྐེད་ཆིངས་ ༼སྣར། པེ།༽ བསྐྱེད་བཅིངས་"
    },
    {
      "span": {
        "start": 3130,
        "end": 3136
      },
      "text": "འགེངས། ༼སྣར། པེ།༽ འགྱེངས།"
    },
    {
      "span": {
        "start": 3745,
        "end": 3750
      },
      "text": "འབུལ། ༼སྣར། པེ།༽ དབུལ།"
    },
    {
      "span": {
        "start": 3799,
        "end": 3804
      },
      "text": "འབུལ་ ༼སྣར། པེ།༽ དབུལ་"
    }
  ]
}