{
  "durchens": [
    {
      "span": {
        "start": 1242,
        "end": 1244
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 1269,
        "end": 1271
      },
      "text": "ན་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 1449,
        "end": 1457
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 1543,
        "end": 1547
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 1665,
        "end": 1677
      },
      "text": "གནོན་པས་ཞུས་ ༼སྣར། པེ།༽ གནོན་"
    },
    {
      "span": {
        "start": 1711,
        "end": 1719
      },
      "text": "འདས་ཀྱི་ ༼སྣར། པེ།༽ འདས་ཀྱིས་"
    },
    {
      "span": {
        "start": 1827,
        "end": 1832
      },
      "text": "དེ་ན་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 2064,
        "end": 2070
      },
      "text": "དེས་ན་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 2499,
        "end": 2507
      },
      "text": "གདམས་ངག་ ༼སྣར།༽ གདམ་ངག་"
    }
  ]
}