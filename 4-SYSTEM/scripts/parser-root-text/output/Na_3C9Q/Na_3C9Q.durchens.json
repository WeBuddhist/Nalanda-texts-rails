{
  "durchens": [
    {
      "span": {
        "start": 470,
        "end": 472
      },
      "text": "ལ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 558,
        "end": 567
      },
      "text": "ཆེན་པོའི་ ༼སྣར། པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 1054,
        "end": 1061
      },
      "text": "ལྔ་ཡིས་ ༼སྣར། པེ།༽ ལྔ་ཡི་"
    },
    {
      "span": {
        "start": 1088,
        "end": 1098
      },
      "text": "དབུ་བརྒྱན་ ༼པེ།༽ དབུ་རྒྱན་"
    },
    {
      "span": {
        "start": 1224,
        "end": 1230
      },
      "text": "ནག་པོ་ ༼སྣར། པེ།༽ ནག་མོ་"
    },
    {
      "span": {
        "start": 1234,
        "end": 1237
      },
      "text": "མོ་ ༼སྣར། པེ།༽ པོ་"
    },
    {
      "span": {
        "start": 1563,
        "end": 1569
      },
      "text": "གཙིགས་ ༼སྣར། པེ།༽ གཙིག་"
    },
    {
      "span": {
        "start": 1663,
        "end": 1668
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམས་ན་"
    },
    {
      "span": {
        "start": 2239,
        "end": 2246
      },
      "text": "སྦྱར་བ་ ༼སྣར། པེ།༽ སྦྱར་"
    },
    {
      "span": {
        "start": 2294,
        "end": 2299
      },
      "text": "བཀླག་ ༼སྣར། པེ།༽ ཀླག་"
    },
    {
      "span": {
        "start": 2444,
        "end": 2447
      },
      "text": "ཏི་ ༼སྣར། པེ།༽ ཊི་"
    },
    {
      "span": {
        "start": 2472,
        "end": 2477
      },
      "text": "ཤ་ལྔ་ ༼སྣར། པེ།༽ ཤ་ལྔའི་"
    },
    {
      "span": {
        "start": 2482,
        "end": 2491
      },
      "text": "རྩི་ལྔའི་ ༼སྣར། པེ།༽ རྩིའི་"
    },
    {
      "span": {
        "start": 2512,
        "end": 2515
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 3107,
        "end": 3109
      },
      "text": "ཁ། ༼སྣར། པེ།༽ ཁཱ།"
    },
    {
      "span": {
        "start": 3212,
        "end": 3218
      },
      "text": "ཅེས་པ་ ༼སྣར། པེ།༽ ཞེས་པ་"
    },
    {
      "span": {
        "start": 3243,
        "end": 3248
      },
      "text": "ཀཱ་ལ་ ༼སྣར། པེ།༽ ཀཱ་ལི་"
    },
    {
      "span": {
        "start": 3265,
        "end": 3271
      },
      "text": "ནག་པོ་ ༼སྣར། པེ།༽ ནག་མོ་"
    },
    {
      "span": {
        "start": 3372,
        "end": 3376
      },
      "text": "མའོ། ༼སྣར། པེ།༽ མའི་འོ།"
    },
    {
      "span": {
        "start": 3662,
        "end": 3668
      },
      "text": "གའོ། ། ༼སྣར།༽ །། །།"
    },
    {
      "span": {
        "start": 3992,
        "end": 3996
      },
      "text": "ཚོམ་ ༼སྣར། པེ།༽ ཚོན་"
    },
    {
      "span": {
        "start": 4215,
        "end": 4221
      },
      "text": "དག་པར་ ༼སྣར། པེ།༽ དག་པས་"
    },
    {
      "span": {
        "start": 4545,
        "end": 4553
      },
      "text": "བྱས་ཤིང་ ༼སྣར། པེ།༽ བྱ་ཞིང་"
    },
    {
      "span": {
        "start": 4638,
        "end": 4643
      },
      "text": "ཉི་མ་ ༼སྣར། པེ།༽ ཉི་མ་ལ་"
    },
    {
      "span": {
        "start": 4911,
        "end": 4919
      },
      "text": "མཚན་མ་མ་ ༼པེ།༽ མཚན་མ་"
    },
    {
      "span": {
        "start": 5090,
        "end": 5095
      },
      "text": "བགོས་ ༼པེ།༽ བགོགས་"
    },
    {
      "span": {
        "start": 5413,
        "end": 5416
      },
      "text": "ཡང་ ༼སྣར། པེ།༽ ཡ་"
    },
    {
      "span": {
        "start": 5459,
        "end": 5467
      },
      "text": "ཅིག་ཅེས་ ༼སྣར། པེ།༽ ཅིག་ཞེས་"
    },
    {
      "span": {
        "start": 5531,
        "end": 5546
      },
      "text": "མངོན་སྤྱོད་ཀྱི་ ༼པེ།༽ མངོན་སྤྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 5842,
        "end": 5846
      },
      "text": "རིང་ ༼སྣར།༽ རིངས་"
    },
    {
      "span": {
        "start": 5870,
        "end": 5872
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 5935,
        "end": 5938
      },
      "text": "ལི་ ༼སྣར། པེ།༽ ལཱི་"
    },
    {
      "span": {
        "start": 5976,
        "end": 5978
      },
      "text": "ཡ་ ༼སྣར། པེ།༽ ཡ་ཧཱུཾ་ཧཱུཾ་"
    },
    {
      "span": {
        "start": 6004,
        "end": 6009
      },
      "text": "ལྔའི་ ༼སྣར། པེ།༽ ལྔ་"
    },
    {
      "span": {
        "start": 6009,
        "end": 6014
      },
      "text": "སྔགས་ ༼སྣར། པེ།༽ སྔགས་ནི་"
    },
    {
      "span": {
        "start": 6134,
        "end": 6148
      },
      "text": "འཇིག་རྟེན་གྱི་ ༼སྣར། པེ།༽ འཇིག་རྟེན་གྱིས་"
    },
    {
      "span": {
        "start": 6400,
        "end": 6404
      },
      "text": "ཞེས་ ༼སྣར། པེ།༽ ཧོཿས་ཞེས་"
    },
    {
      "span": {
        "start": 6523,
        "end": 6531
      },
      "text": "སྤྲ་ཚིལ་ ༼སྣར། པེ།༽ པྲ་ཚིལ་"
    },
    {
      "span": {
        "start": 6550,
        "end": 6553
      },
      "text": "རྩ་ ༼སྣར། པེ།༽ རྩལ་"
    },
    {
      "span": {
        "start": 6600,
        "end": 6606
      },
      "text": "བཙུགས་ ༼སྣར།༽ བཙུག་ ༼པེ།༽ ཐར་ག་"
    },
    {
      "span": {
        "start": 6622,
        "end": 6627
      },
      "text": "ཐད་ཀ་ ༼སྣར། པེ།༽ ཐང་ག་"
    },
    {
      "span": {
        "start": 6630,
        "end": 6639
      },
      "text": "མཐོན་དམན་ ༼སྣར། པེ།༽ མཐོ་དམན་"
    },
    {
      "span": {
        "start": 6699,
        "end": 6707
      },
      "text": "བྱུགས་པ་ ༼སྣར། པེ།༽ བྱུག་པར་"
    },
    {
      "span": {
        "start": 6722,
        "end": 6731
      },
      "text": "རྡོ་རྗེས་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 7035,
        "end": 7040
      },
      "text": "ཡུངས་ ༼སྣར། པེ།༽ ཡུང་"
    },
    {
      "span": {
        "start": 7072,
        "end": 7076
      },
      "text": "བསལ་ ༼སྣར། པེ།༽ གསལ་"
    },
    {
      "span": {
        "start": 7686,
        "end": 7693
      },
      "text": "གསད་པར་ ༼སྣར།༽ བསད་པར་"
    },
    {
      "span": {
        "start": 7994,
        "end": 8002
      },
      "text": "ཀྱི་རྩང་ ༼སྣར། པེ།༽ ཀྱིས་ཙང་"
    },
    {
      "span": {
        "start": 8065,
        "end": 8072
      },
      "text": "གཡབ་པས་ ༼སྣར། པེ།༽ གཡས་པས་"
    },
    {
      "span": {
        "start": 8858,
        "end": 8865
      },
      "text": "ཡུམ་ཅན་ ༼སྣར། པེ།༽ ཡུམ་"
    },
    {
      "span": {
        "start": 8965,
        "end": 8967
      },
      "text": "བ་ ༼སྣར། པེ།༽ བཱ་"
    },
    {
      "span": {
        "start": 8978,
        "end": 8981
      },
      "text": "སྔ་ ༼སྣར། པེ།༽ མངའ་"
    }
  ]
}