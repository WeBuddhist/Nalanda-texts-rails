{
  "durchens": [
    {
      "span": {
        "start": 373,
        "end": 380
      },
      "text": "ཡིད་ནི་ ༼སྣར།༽ ཡིད་ཀྱི་"
    },
    {
      "span": {
        "start": 484,
        "end": 496
      },
      "text": "རྡོ་རྗེ་ཡིས། ༼སྣར། པེ།༽ རྡོ་རྗེ་ཡི།"
    },
    {
      "span": {
        "start": 641,
        "end": 649
      },
      "text": "ངེས་བསལ་ ༼སྣར། པེ།༽ ངེས་གསལ་"
    },
    {
      "span": {
        "start": 664,
        "end": 668
      },
      "text": "ཡིན། ༼སྣར།༽ ཡི།"
    },
    {
      "span": {
        "start": 932,
        "end": 940
      },
      "text": "འཐོབ་པར་ ༼སྣར། པེ།༽ ཐོབ་པར་"
    },
    {
      "span": {
        "start": 1381,
        "end": 1388
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 1398,
        "end": 1400
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 1447,
        "end": 1451
      },
      "text": "དེར་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 1471,
        "end": 1478
      },
      "text": "མྱུར་བ། ༼སྣར། པེ།༽ མྱུར་བར།"
    }
  ]
}