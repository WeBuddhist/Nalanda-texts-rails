{
  "durchens": [
    {
      "span": {
        "start": 42,
        "end": 44
      },
      "text": "ཡ་ ༼སྣར།༽ ཡཱ་"
    },
    {
      "span": {
        "start": 90,
        "end": 98
      },
      "text": "བསྟོད་པ། ༼སྣར། པེ།༽ བསྟོད་པ་ཞེས་བྱ་བ།"
    },
    {
      "span": {
        "start": 575,
        "end": 577
      },
      "text": "ལ་ ༼སྣར། པེ།༽ མཛད་"
    },
    {
      "span": {
        "start": 608,
        "end": 614
      },
      "text": "མི་ཡི་ ༼སྣར། པེ།༽ མི་ཡིས་"
    },
    {
      "span": {
        "start": 766,
        "end": 770
      },
      "text": "ཁ་ན་ ༼པེ།༽ ཁ་ནས་"
    },
    {
      "span": {
        "start": 1527,
        "end": 1535
      },
      "text": "འཁོར་མོ་ ༼སྣར། པེ།༽ ཁོར་མོ་"
    },
    {
      "span": {
        "start": 1560,
        "end": 1565
      },
      "text": "བཏུལ། ༼པེ།༽ བཏུད།"
    },
    {
      "span": {
        "start": 1689,
        "end": 1698
      },
      "text": "ཀུན་གྱིས་ ༼སྣར།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 1846,
        "end": 1851
      },
      "text": "བཤིག་ ༼པེ།༽ བཤིགས་"
    },
    {
      "span": {
        "start": 2095,
        "end": 2107
      },
      "text": "བསྟོད་པ་ཡིས། ༼སྣར།༽ བསྟོད་བ་ཡི ༼པེ།༽ བསྟོད་པ་ཡི།"
    },
    {
      "span": {
        "start": 2228,
        "end": 2252
      },
      "text": "སློབ་དཔོན་ཆེན་པོ་འཕགས་པ་ ༼སྣར། པེ།༽ སློབ་དཔོན་"
    }
  ]
}