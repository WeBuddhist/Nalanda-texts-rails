{
  "durchens": [
    {
      "span": {
        "start": 281,
        "end": 286
      },
      "text": "བཀྱེ་ ༼སྣར། པེ།༽ དགྱེ་"
    },
    {
      "span": {
        "start": 799,
        "end": 807
      },
      "text": "འཇོམས་པ་ ༼སྣར། པེ།༽ འཇོམས་པའི་"
    },
    {
      "span": {
        "start": 1273,
        "end": 1279
      },
      "text": "བརྫེས་ ༼སྣར། པེ།༽ རྫེས་"
    },
    {
      "span": {
        "start": 1282,
        "end": 1294
      },
      "text": "སྤྱན་དམར་པོ་ ༼སྣར། པེ།༽ སྤྱན་དམར་བ་"
    },
    {
      "span": {
        "start": 1402,
        "end": 1406
      },
      "text": "ཐོད་ ༼སྣར། པེ།༽ ཐོག་"
    },
    {
      "span": {
        "start": 1905,
        "end": 1914
      },
      "text": "སྟོང་གིས་ ༼སྣར། པེ།༽ སྟོང་གི་"
    },
    {
      "span": {
        "start": 1921,
        "end": 1926
      },
      "text": "འབུལ། ༼སྣར། པེ།༽ དབུལ།"
    },
    {
      "span": {
        "start": 1972,
        "end": 1986
      },
      "text": "དང་བསྟོད་པ་རེ་ ༼སྣར། པེ།༽ དང་བསྟོད་པར་"
    },
    {
      "span": {
        "start": 2013,
        "end": 2019
      },
      "text": "སོ་སོ་ ༼སྣར། པེ།༽ སོ་སོའི་"
    },
    {
      "span": {
        "start": 2026,
        "end": 2029
      },
      "text": "ཞུ་ ༼སྣར། པེ།༽ བཞུ་"
    },
    {
      "span": {
        "start": 2052,
        "end": 2058
      },
      "text": "ལྷ་མོ་ ༼སྣར། པེ།༽ ལྷ་"
    },
    {
      "span": {
        "start": 2101,
        "end": 2110
      },
      "text": "བསྐུར་བར་ ༼སྣར། པེ།༽ བསྐུར་བ་ལས་དེ་"
    },
    {
      "span": {
        "start": 2209,
        "end": 2214
      },
      "text": "གཏང་། ༼སྣར། པེ།༽ བཏང་།"
    },
    {
      "span": {
        "start": 2301,
        "end": 2311
      },
      "text": "བསྐུར་བའི་ ༼སྣར། པེ།༽ བསྐུར་བའི་དཀྱིལ་འཁོར་གྱི་"
    }
  ]
}