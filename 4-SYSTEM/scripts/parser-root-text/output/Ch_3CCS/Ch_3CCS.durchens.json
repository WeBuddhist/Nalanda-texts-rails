{
  "durchens": [
    {
      "span": {
        "start": 43,
        "end": 45
      },
      "text": "ན། ༼སྣར། པེ།༽ ནཾ།"
    },
    {
      "span": {
        "start": 77,
        "end": 83
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 884,
        "end": 895
      },
      "text": "བརྐྱང་པ་ཡི་ ༼སྣར། པེ།༽ བརྐྱང་པ་ཡིས་"
    },
    {
      "span": {
        "start": 942,
        "end": 944
      },
      "text": "ཨ་ ༼ཅོ།༽ ཨཱ་"
    },
    {
      "span": {
        "start": 1086,
        "end": 1091
      },
      "text": "ལྔ་ལ་ ༼སྣར། པེ།༽ ལྔ་པ་"
    },
    {
      "span": {
        "start": 1441,
        "end": 1446
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 1617,
        "end": 1624
      },
      "text": "བྱའོ། །༼སྣར། པེ།༽ ། །རྣལ་འབྱོར་གསལ་ནས་བཟླས་པ་བྱའོ། །"
    },
    {
      "span": {
        "start": 1852,
        "end": 1855
      },
      "text": "བར་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 2234,
        "end": 2236
      },
      "text": "པ་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 2480,
        "end": 2487
      },
      "text": "སྲུང་བ་ ༼སྣར། པེ།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 2507,
        "end": 2514
      },
      "text": "བྱ་བའི་ ༼སྣར། པེ།༽ བྱེད་པའི་"
    },
    {
      "span": {
        "start": 2569,
        "end": 2571
      },
      "text": "ས་ ༼སྣར། པེ།༽ མ་ས་"
    },
    {
      "span": {
        "start": 2802,
        "end": 2806
      },
      "text": "ཧསྟ་ ༼སྣར། པེ།༽ ཧ་ཏ་"
    },
    {
      "span": {
        "start": 2927,
        "end": 2929
      },
      "text": "ཡ་ ༼སྣར། པེ།༽ ཡ་ཧཱུཾ་"
    },
    {
      "span": {
        "start": 3150,
        "end": 3157
      },
      "text": "ལམ་གྱི་ ༼སྣར། པེ།༽ ལས་ཀྱི་"
    },
    {
      "span": {
        "start": 3196,
        "end": 3201
      },
      "text": "ད་དུ་ ༼སྣར། པེ།༽ དྷ་དྷུ་"
    },
    {
      "span": {
        "start": 3441,
        "end": 3447
      },
      "text": "སྦས་ན་ ༼སྣར།༽ སྦས་ནས་"
    },
    {
      "span": {
        "start": 3583,
        "end": 3585
      },
      "text": "ས་ ༼སྣར། པེ།༽ མཿམ་ས་"
    },
    {
      "span": {
        "start": 3886,
        "end": 3894
      },
      "text": "ཡུངས་ཀར་ ༼སྣར། པེ།༽ ཡུངས་མར་"
    },
    {
      "span": {
        "start": 3929,
        "end": 3931
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལ། དེའི་"
    },
    {
      "span": {
        "start": 3994,
        "end": 4002
      },
      "text": "འཆིང་བར་ ༼སྣར། པེ།༽ འཆི་བར་"
    },
    {
      "span": {
        "start": 4151,
        "end": 4158
      },
      "text": "ལྟེ་བར་ ༼སྣར། པེ།༽ ལྟེ་བ་"
    },
    {
      "span": {
        "start": 4166,
        "end": 4182
      },
      "text": "དཀྱིལ་འཁོར་གྱིས་ ༼སྣར། པེ།༽ དཀྱིལ་འཁོར་"
    },
    {
      "span": {
        "start": 4324,
        "end": 4332
      },
      "text": "སྲུང་བར་ ༼སྣར། པེ།༽ བསྲུང་བར་"
    }
  ]
}