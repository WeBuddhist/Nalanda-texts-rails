{
  "durchens": [
    {
      "span": {
        "start": 339,
        "end": 348
      },
      "text": "ཆེན་པོའི་ ༼སྣར། པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 1561,
        "end": 1565
      },
      "text": "སྐམ་ ༼སྣར། པེ།༽ སྐོམ་"
    },
    {
      "span": {
        "start": 1712,
        "end": 1718
      },
      "text": "རྣམ་པ་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 1718,
        "end": 1723
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ གསུམ་པ་"
    },
    {
      "span": {
        "start": 1754,
        "end": 1764
      },
      "text": "སྡུག་བསྔལ་ ༼སྣར། པེ།༽ སྡུག་བསྔལ་བ་"
    },
    {
      "span": {
        "start": 1791,
        "end": 1795
      },
      "text": "སྟེ། ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 1802,
        "end": 1805
      },
      "text": "དེ་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 2112,
        "end": 2118
      },
      "text": "གཞན་པ་ ༼སྣར། པེ།༽ གཞན་པ་བ་"
    },
    {
      "span": {
        "start": 2960,
        "end": 2968
      },
      "text": "གཡེངས་པ་ ༼སྣར། པེ།༽ གཡེང་བ་"
    },
    {
      "span": {
        "start": 3283,
        "end": 3292
      },
      "text": "སེམས་ཀྱི་ ༼སྣར། པེ།༽ སེམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 3342,
        "end": 3356
      },
      "text": "གཉི་ག་མ་ཡིན་པ་ ༼སྣར། པེ།༽ གཉི་ག་མ་"
    },
    {
      "span": {
        "start": 3388,
        "end": 3396
      },
      "text": "ཡིད་ཀྱི་ ༼ཅོ།༽ ཡིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 3618,
        "end": 3627
      },
      "text": "བརྟག་པའི་ ༼སྣར། པེ།༽ བརྟགས་པའི་"
    },
    {
      "span": {
        "start": 3716,
        "end": 3723
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 3916,
        "end": 3924
      },
      "text": "བྱས་སྟེ། ༼སྣར། པེ།༽ བྱས་ཏེ།"
    },
    {
      "span": {
        "start": 4002,
        "end": 4008
      },
      "text": "ཐོ་བས་ ༼སྣར། པེ།༽ ཐོ་བས་གཞན་ལ་"
    },
    {
      "span": {
        "start": 4177,
        "end": 4184
      },
      "text": "པོ་སྟེ། ༼སྣར། པེ།༽ པོ་"
    },
    {
      "span": {
        "start": 4321,
        "end": 4329
      },
      "text": "ལེན་གྱི་ ༼སྣར། པེ།༽ ལེན་གྱིས་"
    },
    {
      "span": {
        "start": 4477,
        "end": 4481
      },
      "text": "སྤང་ ༼སྣར། པེ།༽ སྤོང་"
    },
    {
      "span": {
        "start": 4678,
        "end": 4684
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 4695,
        "end": 4702
      },
      "text": "ཅན་གྱི་ ༼སྣར། པེ།༽ ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 4853,
        "end": 4863
      },
      "text": "ཕུང་པོ་ལྔ་ ༼སྣར། པེ།༽ ཕུང་པོ་"
    },
    {
      "span": {
        "start": 4986,
        "end": 4995
      },
      "text": "བདུན་སྟེ། ༼སྣར། པེ།༽ བདུན་ཏེ།"
    },
    {
      "span": {
        "start": 5362,
        "end": 5367
      },
      "text": "ཆེ་བ་ ༼སྣར། པེ།༽ ཆེ་"
    },
    {
      "span": {
        "start": 5571,
        "end": 5576
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 5663,
        "end": 5670
      },
      "text": "ཁྱད་པར་ ༼སྣར། པེ།༽ ཁྱད་"
    },
    {
      "span": {
        "start": 6086,
        "end": 6094
      },
      "text": "གཏི་མུག་ ༼སྣར། པེ།༽ གཏི་མུག་གི་"
    },
    {
      "span": {
        "start": 6141,
        "end": 6146
      },
      "text": "འཇིག་ ༼སྣར། པེ།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 6272,
        "end": 6277
      },
      "text": "འཇིག་ ༼སྣར། པེ།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 6580,
        "end": 6585
      },
      "text": "འཇིག་ ༼སྣར། པེ།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 6930,
        "end": 6937
      },
      "text": "ལྟ་བའི་ ༼སྣར།༽ བལྟ་བའི་"
    },
    {
      "span": {
        "start": 7414,
        "end": 7420
      },
      "text": "འཁྲུག་ ༼སྣར། པེ།༽ འཁྲུགས་"
    },
    {
      "span": {
        "start": 7465,
        "end": 7475
      },
      "text": "སེམས་ཀྱིས་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 7511,
        "end": 7517
      },
      "text": "སླུ་བ་ ༼སྣར། པེ།༽ བསླུ་བ་"
    },
    {
      "span": {
        "start": 7588,
        "end": 7593
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 7747,
        "end": 7755
      },
      "text": "ཐོ་འཚམས་ ༼སྣར། པེ།༽ མཐོ་མཚམས་"
    },
    {
      "span": {
        "start": 7802,
        "end": 7807
      },
      "text": "འཛེམ་ ༼སྣར། པེ།༽ འཛེམས་"
    },
    {
      "span": {
        "start": 7854,
        "end": 7859
      },
      "text": "འཛེམ་ ༼སྣར། པེ།༽ འཛེམས་"
    },
    {
      "span": {
        "start": 7906,
        "end": 7912
      },
      "text": "བླང་བ་ ༼སྣར། པེ།༽ བློང་བ་"
    },
    {
      "span": {
        "start": 8297,
        "end": 8303
      },
      "text": "བསྒོམ་ ༼སྣར། པེ།༽ སྒོམ་"
    },
    {
      "span": {
        "start": 8428,
        "end": 8438
      },
      "text": "ཆ་ཤས་ཀྱིས་ ༼སྣར། པེ།༽ ཆ་ཤས་ཀྱི་"
    },
    {
      "span": {
        "start": 8454,
        "end": 8463
      },
      "text": "ལྔ་པོ་དག་ ༼སྣར། པེ།༽ ལྔ་པོ་"
    },
    {
      "span": {
        "start": 8729,
        "end": 8737
      },
      "text": "ཚོལ་བའི་ ༼སྣར། པེ།༽ འཚོལ་བའི་"
    },
    {
      "span": {
        "start": 8807,
        "end": 8815
      },
      "text": "དཔྱོད་པ་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 8945,
        "end": 8953
      },
      "text": "དང་སེམས་ ༼སྣར། པེ།༽ དང་སེམས་དང་སེམས་"
    },
    {
      "span": {
        "start": 9122,
        "end": 9128
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པ་པ་"
    },
    {
      "span": {
        "start": 9538,
        "end": 9554
      },
      "text": "བཏང་བའི་འདུ་ཤེས་ ༼སྣར། པེ།༽ བཏང་བའི་"
    },
    {
      "span": {
        "start": 9771,
        "end": 9779
      },
      "text": "སྔོན་དུ་ ༼སྣར། པེ།༽ མངོན་དུ་"
    },
    {
      "span": {
        "start": 9856,
        "end": 9863
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ བརྟན་པ་"
    },
    {
      "span": {
        "start": 10068,
        "end": 10075
      },
      "text": "བརྟན་པ་ ༼སྣར། པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 10200,
        "end": 10204
      },
      "text": "དུས་ ༼སྣར།༽ དུབ་"
    },
    {
      "span": {
        "start": 10245,
        "end": 10254
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 10322,
        "end": 10329
      },
      "text": "བྱུང་བ་ ༼སྣར།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 10356,
        "end": 10363
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 10450,
        "end": 10459
      },
      "text": "མི་རྟག་པ་ ༼སྣར། པེ།༽ མི་རྟག་"
    },
    {
      "span": {
        "start": 10650,
        "end": 10658
      },
      "text": "ཡི་གེའི་ ༼སྣར། པེ།༽ ཡི་གེ་"
    },
    {
      "span": {
        "start": 10677,
        "end": 10684
      },
      "text": "གསལ་བར་ ༼སྣར། པེ།༽ བསལ་བར་"
    },
    {
      "span": {
        "start": 10741,
        "end": 10747
      },
      "text": "བརྟེན་ ༼སྣར།༽ རྟེན་"
    },
    {
      "span": {
        "start": 10991,
        "end": 11007
      },
      "text": "། །སྣ་ཚོགས་པ་དང་ ༼སྣར། པེ།༽ སྣ་ཚོགས་པ་"
    },
    {
      "span": {
        "start": 11045,
        "end": 11053
      },
      "text": "སེམས་ནི་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 11304,
        "end": 11309
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམས་ལས་"
    },
    {
      "span": {
        "start": 11398,
        "end": 11403
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 11694,
        "end": 11697
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 11789,
        "end": 11796
      },
      "text": "ང་རྒྱལ་ ༼པེ།༽ ང་རྒྱལ་བ་"
    },
    {
      "span": {
        "start": 11834,
        "end": 11842
      },
      "text": "ལྡན་པའི་ ༼སྣར། པེ།༽ ལྡན་པར་"
    },
    {
      "span": {
        "start": 12052,
        "end": 12059
      },
      "text": "གྲོལ་བ་ ༼སྣར། པེ།༽ འགྲོ་བ་"
    },
    {
      "span": {
        "start": 13847,
        "end": 13853
      },
      "text": "བརྟེན་ ༼སྣར།༽ རྟེན་"
    },
    {
      "span": {
        "start": 13924,
        "end": 13929
      },
      "text": "འགགས་ ༼སྣར། པེ།༽ འགག་"
    },
    {
      "span": {
        "start": 13967,
        "end": 13976
      },
      "text": "བརྟན་པའི་ ༼སྣར། པེ།༽ བསྟན་པའི་"
    },
    {
      "span": {
        "start": 14458,
        "end": 14465
      },
      "text": "བཤད་ཅེ་ ༼སྣར། པེ།༽ བཤད་ཅེས་"
    },
    {
      "span": {
        "start": 14497,
        "end": 14505
      },
      "text": "གཉེན་པོ་ ༼སྣར། པེ།༽ གཉེན་པོར་"
    },
    {
      "span": {
        "start": 14724,
        "end": 14730
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 14808,
        "end": 14811
      },
      "text": "ནི་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 14898,
        "end": 14905
      },
      "text": "ཐོགས་པ་ ༼པེ།༽ ཐོག་པ་"
    },
    {
      "span": {
        "start": 14973,
        "end": 14978
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ གསུམ་གྱི་ཆའོ། །མི་ལྡན་པ་དུ་ཞེ་ན། གསུམ་"
    },
    {
      "span": {
        "start": 15005,
        "end": 15010
      },
      "text": "སྐྱེ་ ༼སྣར།༽ སྐྱེས་"
    },
    {
      "span": {
        "start": 16103,
        "end": 16109
      },
      "text": "བཞིའི་ ༼སྣར། པེ།༽ ཕྱིའི་"
    },
    {
      "span": {
        "start": 16216,
        "end": 16223
      },
      "text": "བསྟན་པ་ ༼སྣར།༽ བསྟེན་པ་"
    },
    {
      "span": {
        "start": 16394,
        "end": 16399
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིག་"
    }
  ]
}