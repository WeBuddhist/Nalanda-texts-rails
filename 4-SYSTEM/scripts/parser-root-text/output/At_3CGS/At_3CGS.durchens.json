{
  "durchens": [
    {
      "span": {
        "start": 773,
        "end": 777
      },
      "text": "ཉིས་ ༼པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 1032,
        "end": 1044
      },
      "text": "སྲིན་ལག་གིས་ ༼པེ།༽ སྲིན་ལག་གི་"
    },
    {
      "span": {
        "start": 1383,
        "end": 1387
      },
      "text": "སྐུ་ ༼པེ།༽ སྐུའི་"
    },
    {
      "span": {
        "start": 2203,
        "end": 2209
      },
      "text": "ཅན་ཏེ་ ༼པེ།༽ ཅན་སྟེ་"
    },
    {
      "span": {
        "start": 2255,
        "end": 2260
      },
      "text": "མཐེབ་ ༼པེ།༽ འཐེབ་"
    },
    {
      "span": {
        "start": 5242,
        "end": 5248
      },
      "text": "བརྒྱད་ ༼པེ།༽ རྒྱད་"
    },
    {
      "span": {
        "start": 5534,
        "end": 5538
      },
      "text": "སྐུ་ ༼པེ།༽ བསྐུ་"
    },
    {
      "span": {
        "start": 5611,
        "end": 5617
      },
      "text": "འབྱུང་ ༼པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 6088,
        "end": 6093
      },
      "text": "བགོའ་ ༼པེ།༽ བཀོའ་"
    },
    {
      "span": {
        "start": 6365,
        "end": 6378
      },
      "text": "མེ་ཏོག་དབུ་ལ། ༼པེ།༽ མེ་ཏོག་དབུའལ།"
    },
    {
      "span": {
        "start": 6379,
        "end": 6389
      },
      "text": "གདུག་སྤོས་ ༼པེ།༽ བདུག་སྤོས་"
    },
    {
      "span": {
        "start": 7002,
        "end": 7007
      },
      "text": "བདུག་ ༼སྣར།༽ ། བདུག་ ༼པེ།༽ ། བསྡུག་"
    },
    {
      "span": {
        "start": 7072,
        "end": 7075
      },
      "text": "ཀར་ ༼པེ།༽ དཀར་"
    },
    {
      "span": {
        "start": 7149,
        "end": 7157
      },
      "text": "རྡོ་རྗེ་ ༼པེ།༽ རྡོ་རྗེ་མ་"
    },
    {
      "span": {
        "start": 7509,
        "end": 7513
      },
      "text": "གཤམ་ ༼པེ།༽ བཤམ་"
    },
    {
      "span": {
        "start": 7597,
        "end": 7605
      },
      "text": "ད་ལྟར་བ་ ༼པེ།༽ ད་ལྟར་"
    },
    {
      "span": {
        "start": 8538,
        "end": 8549
      },
      "text": "མཚན་པ་གཅིག་ ༼པེ།༽ མཚན་པ་ཅིག་"
    },
    {
      "span": {
        "start": 8928,
        "end": 8937
      },
      "text": "བདུད་རྩི་ ༼པེ།༽ བདུད་རྩིར་"
    },
    {
      "span": {
        "start": 9530,
        "end": 9536
      },
      "text": "བསྡམས་ ༼པེ།༽ བསྡམ་"
    },
    {
      "span": {
        "start": 10812,
        "end": 10820
      },
      "text": "གཏོར་མས་ ༼པེ།༽ གཏོར་མར་"
    },
    {
      "span": {
        "start": 11018,
        "end": 11031
      },
      "text": "ཁྱད་པར་དུ་ནི་ ༼པེ།༽ ཁྱད་པར་དུ་"
    }
  ]
}