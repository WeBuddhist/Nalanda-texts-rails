{
  "durchens": [
    {
      "span": {
        "start": 337,
        "end": 343
      },
      "text": "བསྩགས་ ༼སྣར། པེ།༽ བསགས་"
    },
    {
      "span": {
        "start": 346,
        "end": 355
      },
      "text": "དངོས་པོར་ ༼སྣར། པེ།༽ དངོས་པོ་"
    },
    {
      "span": {
        "start": 557,
        "end": 563
      },
      "text": "བཟོའི་ ༼སྣར། པེ།༽ གཟོའི་"
    },
    {
      "span": {
        "start": 662,
        "end": 672
      },
      "text": "གདོན་གྱིས་ ༼སྣར།༽ གདོན་གིས་"
    },
    {
      "span": {
        "start": 849,
        "end": 858
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 1311,
        "end": 1318
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 1693,
        "end": 1699
      },
      "text": "སྩོགས་ ༼སྣར། པེ།༽ སོགས་"
    },
    {
      "span": {
        "start": 1762,
        "end": 1769
      },
      "text": "སྦངས་པ་ ༼སྣར། པེ།༽ སྦང་བ་"
    },
    {
      "span": {
        "start": 2119,
        "end": 2126
      },
      "text": "ཅན་གྱི་ ༼སྣར། པེ།༽ ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 2134,
        "end": 2143
      },
      "text": "སྐྱེད་པར་ ༼སྣར། པེ།༽ བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 2949,
        "end": 2958
      },
      "text": "རྒྱུ་གཞན་ ༼སྣར།༽ རྒྱུ་བ་ཞན་"
    },
    {
      "span": {
        "start": 3361,
        "end": 3370
      },
      "text": "བྱ་བ་ཤིང་ ༼སྣར། པེ།༽ བྱ་བ་ཤ་པ་"
    },
    {
      "span": {
        "start": 3928,
        "end": 3935
      },
      "text": "གང་ཞིག་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 3975,
        "end": 3987
      },
      "text": "མེད་གྱུར་པས། ༼སྣར།༽ མེ་འགྱུར་པ ༼པེ།༽ མེད་གྱུར་པ།"
    },
    {
      "span": {
        "start": 4179,
        "end": 4192
      },
      "text": "དེ་བཞིན་གྱིས་ ༼སྣར། པེ།༽ དེ་ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 4196,
        "end": 4198
      },
      "text": "ན། ༼སྣར། པེ།༽ ནས།"
    },
    {
      "span": {
        "start": 4215,
        "end": 4220
      },
      "text": "བརྟན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 4304,
        "end": 4314
      },
      "text": "། །ཇི་ལྟར་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 4939,
        "end": 4948
      },
      "text": "རྒྱུ་ཉིད་ ༼སྣར། པེ།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 5109,
        "end": 5126
      },
      "text": "ངེས་པར་བསྐྱེད་པར་ ༼སྣར། པེ།༽ ངེས་པར་"
    },
    {
      "span": {
        "start": 5314,
        "end": 5327
      },
      "text": "བུད་མེད་གཅིག་ ༼སྣར། པེ།༽ བུད་མེད་ཅིག་"
    },
    {
      "span": {
        "start": 5579,
        "end": 5582
      },
      "text": "མི་ ༼སྣར། པེ།༽ མ་"
    },
    {
      "span": {
        "start": 5710,
        "end": 5716
      },
      "text": "དེ་ལྟ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 6400,
        "end": 6415
      },
      "text": "བརྩེགས་པའི་མདོ་ ༼སྣར། པེ།༽ རྩེགས་པ་"
    },
    {
      "span": {
        "start": 6554,
        "end": 6565
      },
      "text": "ཡིན་ནོ་ཞེས་ ༼པེ།༽ ཡིན་ནོ་"
    },
    {
      "span": {
        "start": 6578,
        "end": 6591
      },
      "text": "འོད་སྲུངས་དེ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 7070,
        "end": 7080
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 7123,
        "end": 7128
      },
      "text": "ཉེ་བ་ ༼སྣར། པེ།༽ ཉེ་བར་"
    },
    {
      "span": {
        "start": 7569,
        "end": 7582
      },
      "text": "ཕྱིར་འབྱོར་པ་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 7753,
        "end": 7761
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 7816,
        "end": 7823
      },
      "text": "ལུགས་མ་ ༼སྣར། པེ།༽ ལུགས་"
    },
    {
      "span": {
        "start": 7823,
        "end": 7825
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 7857,
        "end": 7868
      },
      "text": "འགྱུར་གྱིས། ༼སྣར། པེ།༽ འགྱུར་གྱི།"
    },
    {
      "span": {
        "start": 7929,
        "end": 7937
      },
      "text": "བདག་ཉིད་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 8008,
        "end": 8014
      },
      "text": "བཟུང་། ༼སྣར། པེ།༽ གཟུང་།"
    },
    {
      "span": {
        "start": 8061,
        "end": 8066
      },
      "text": "སྡོམ་ ༼སྣར། པེ།༽ བསྡམ་"
    },
    {
      "span": {
        "start": 8069,
        "end": 8074
      },
      "text": "དགོས། ༼སྣར།༽ གོས།"
    },
    {
      "span": {
        "start": 8140,
        "end": 8146
      },
      "text": "དང་ནི་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 8448,
        "end": 8474
      },
      "text": "བསྟེན་པ་ལས་འབྲས་བུ་དེ་ཐོབ་ ༼སྣར། པེ།༽ ལས་འབྲས་བུ་འཐོབ་"
    },
    {
      "span": {
        "start": 8493,
        "end": 8510
      },
      "text": "ཕྱིར་རོ། །དེ་ཅིར་ ༼སྣར། པེ།༽ ཕྱིར་ཅི་དེར་"
    },
    {
      "span": {
        "start": 8724,
        "end": 8735
      },
      "text": "བསྟེན་པ་མི་ ༼སྣར། པེ།༽ བསྟེན་པ་མ་"
    },
    {
      "span": {
        "start": 8750,
        "end": 8759
      },
      "text": "གཟུང་བའི་ ༼སྣར། པེ།༽ བཟུང་བའི་"
    },
    {
      "span": {
        "start": 8773,
        "end": 8782
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 8950,
        "end": 8956
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 9610,
        "end": 9618
      },
      "text": "འཐོབ་པར་ ༼སྣར། པེ།༽ ཐོབ་པར་"
    },
    {
      "span": {
        "start": 9674,
        "end": 9686
      },
      "text": "ཁྱད་པར་གྱིས་ ༼སྣར། པེ།༽ ཁྱད་པར་གྱི་"
    },
    {
      "span": {
        "start": 9845,
        "end": 9849
      },
      "text": "ཀུན་ ༼སྣར།༽ ཀྲུན་"
    },
    {
      "span": {
        "start": 9922,
        "end": 9929
      },
      "text": "ཡི་དབང་ ༼སྣར།༽ ཡིས་ ༼པེ།༽ ཡིད་དབང་"
    },
    {
      "span": {
        "start": 10403,
        "end": 10409
      },
      "text": "འོས་མ་ ༼སྣར།༽ འོས་"
    },
    {
      "span": {
        "start": 10545,
        "end": 10552
      },
      "text": "སྒྱུ་མ་ ༼སྣར།༽ རྒྱུ་མ་"
    },
    {
      "span": {
        "start": 11048,
        "end": 11056
      },
      "text": "འཕྲོ་བར་ ༼སྣར། པེ།༽ འཕྱོས་པར་"
    },
    {
      "span": {
        "start": 11123,
        "end": 11127
      },
      "text": "གཞག་ ༼པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 11615,
        "end": 11621
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 11710,
        "end": 11720
      },
      "text": "ཀྱི་བརྟུལ་ ༼སྣར། པེ།༽ ཀྱིས་རྟུལ་"
    },
    {
      "span": {
        "start": 11725,
        "end": 11728
      },
      "text": "ཇི་ ༼སྣར། པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 12044,
        "end": 12053
      },
      "text": "བསྟེན་པར་ ༼སྣར། པེ།༽ བརྟེན་པར་"
    },
    {
      "span": {
        "start": 12245,
        "end": 12249
      },
      "text": "འཕོ་ ༼པེ།༽ འཐོ་"
    },
    {
      "span": {
        "start": 12458,
        "end": 12464
      },
      "text": "བསྟེན། ༼སྣར། པེ།༽ བསྟན།"
    },
    {
      "span": {
        "start": 12598,
        "end": 12606
      },
      "text": "ལས་འཕྲོ་ ༼སྣར། པེ།༽ ལ་འཕོ་"
    },
    {
      "span": {
        "start": 12792,
        "end": 12801
      },
      "text": "མཐོང་སྟེ་ ༼སྣར། པེ།༽ མཐོང་དེ་"
    },
    {
      "span": {
        "start": 13224,
        "end": 13232
      },
      "text": "བརྟེན་པ་ ༼སྣར། པེ།༽ བརྟན་པ་"
    },
    {
      "span": {
        "start": 14117,
        "end": 14125
      },
      "text": "གདུངས་པ་ ༼སྣར། པེ།༽ གདུང་པ་"
    },
    {
      "span": {
        "start": 14402,
        "end": 14407
      },
      "text": "སློང་ ༼སྣར། པེ།༽ སློངས་"
    },
    {
      "span": {
        "start": 14429,
        "end": 14434
      },
      "text": "སློང་ ༼སྣར། པེ།༽ སློངས་"
    },
    {
      "span": {
        "start": 14657,
        "end": 14671
      },
      "text": "ནོར་བུ་ཆེན་པོ་ ༼སྣར། པེ།༽ ནོར་བུ་ཚོན་"
    },
    {
      "span": {
        "start": 15494,
        "end": 15502
      },
      "text": "འགལ་བའི་ ༼སྣར། པེ།༽ འགལ་བ་"
    },
    {
      "span": {
        "start": 15551,
        "end": 15561
      },
      "text": "མཐུན་པ་དང་ ༼སྣར། པེ།༽ མཐུན་པ་"
    },
    {
      "span": {
        "start": 16526,
        "end": 16539
      },
      "text": "གོམས་པར་བྱེད་ ༼སྣར། པེ།༽ གོམས་"
    },
    {
      "span": {
        "start": 16725,
        "end": 16733
      },
      "text": "ལྡོག་པར་ ༼སྣར། པེ།༽ ཟློག་པར་"
    },
    {
      "span": {
        "start": 17210,
        "end": 17215
      },
      "text": "དེ་ལ་ ༼སྣར།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 17442,
        "end": 17447
      },
      "text": "ཐར་པ་ ༼སྣར། པེ།༽ མཐར་པ་"
    },
    {
      "span": {
        "start": 18420,
        "end": 18426
      },
      "text": "ལོག་པ་ ༼སྣར། པེ།༽ ལེགས་པ་"
    },
    {
      "span": {
        "start": 18525,
        "end": 18532
      },
      "text": "ཁྱད་པར་ ༼སྣར། པེ།༽ ན་ཁྱད་པ་"
    },
    {
      "span": {
        "start": 18778,
        "end": 18782
      },
      "text": "དགེ་ ༼སྣར། པེ།༽ དགེ་བའི་རྩ་"
    },
    {
      "span": {
        "start": 18919,
        "end": 18924
      },
      "text": "མངོན་ ༼སྣར། པེ།༽ སྔོན་"
    },
    {
      "span": {
        "start": 18948,
        "end": 18952
      },
      "text": "གཞན་ ༼སྣར།༽ བཞན་"
    },
    {
      "span": {
        "start": 19071,
        "end": 19082
      },
      "text": "སྟོབས་ཤིང་། ༼སྣར། པེ།༽ སྟོབ་ཅིང་།"
    },
    {
      "span": {
        "start": 19506,
        "end": 19515
      },
      "text": "སྟོབས་པར་ ༼སྣར། པེ།༽ སྟོབ་པར་"
    },
    {
      "span": {
        "start": 19657,
        "end": 19669
      },
      "text": "པའི་འབྲས་བུ་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 19935,
        "end": 19943
      },
      "text": "བརྟན་པར་ ༼སྣར། པེ།༽ བརྟེན་པར་"
    },
    {
      "span": {
        "start": 20043,
        "end": 20050
      },
      "text": "ཁྱད་པར་ ༼སྣར། པེ།༽ ཁྱད་"
    },
    {
      "span": {
        "start": 20250,
        "end": 20258
      },
      "text": "འཐོབ་པར་ ༼སྣར།༽ ཐོབ་པར་"
    },
    {
      "span": {
        "start": 20623,
        "end": 20630
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 20704,
        "end": 20711
      },
      "text": "འདྲ་བར་ ༼སྣར།༽ འདྲ་མར་"
    },
    {
      "span": {
        "start": 20755,
        "end": 20762
      },
      "text": "འདས་མེ་ ༼སྣར། པེ།༽ འདས་མི་"
    },
    {
      "span": {
        "start": 21380,
        "end": 21387
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ འགྱུར་པ་"
    },
    {
      "span": {
        "start": 21621,
        "end": 21626
      },
      "text": "སྙིང་ ༼སྣར། པེ།༽ བསྙིང་"
    },
    {
      "span": {
        "start": 23061,
        "end": 23070
      },
      "text": "བསྒོམས་པ་ ༼སྣར།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 23591,
        "end": 23594
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ནི་དེའི་"
    },
    {
      "span": {
        "start": 23647,
        "end": 23658
      },
      "text": "བསྲེགས་པའི་ ༼སྣར།༽ བསྲེག་པའི་"
    },
    {
      "span": {
        "start": 23671,
        "end": 23676
      },
      "text": "ལྡོག་ ༼སྣར།༽ ལོག་"
    },
    {
      "span": {
        "start": 23817,
        "end": 23820
      },
      "text": "པས་ ༼སྣར། པེ།༽ བར་"
    },
    {
      "span": {
        "start": 23882,
        "end": 23889
      },
      "text": "དག་ཀྱང་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 23990,
        "end": 23995
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ རྒྱུས་"
    },
    {
      "span": {
        "start": 24021,
        "end": 24030
      },
      "text": "སྐྱེད་པར་ ༼སྣར། པེ།༽ བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 24030,
        "end": 24038
      },
      "text": "བྱེད་དེ། ༼སྣར།༽ བྱེད་དོ།"
    },
    {
      "span": {
        "start": 24217,
        "end": 24226
      },
      "text": "བྱུང་བའི་ ༼སྣར། པེ།༽ བྱུང་བའི་དགའ་བའི་"
    },
    {
      "span": {
        "start": 24384,
        "end": 24387
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་ལ་"
    },
    {
      "span": {
        "start": 24509,
        "end": 24516
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 24834,
        "end": 24842
      },
      "text": "རིག་པའི་ ༼སྣར།༽ རིར་བའི་"
    },
    {
      "span": {
        "start": 25139,
        "end": 25149
      },
      "text": "སྐྱེད་པའི་ ༼སྣར།༽ སྐྱེས་པའི་"
    },
    {
      "span": {
        "start": 25245,
        "end": 25251
      },
      "text": "དེ་ནས་ ༼སྣར། པེ།༽ དེས་ན་"
    },
    {
      "span": {
        "start": 25306,
        "end": 25314
      },
      "text": "བསྟེན་པ་ ༼སྣར། པེ།༽ བརྟན་པ་"
    },
    {
      "span": {
        "start": 26236,
        "end": 26246
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ བསྒྲུབས་པར་"
    },
    {
      "span": {
        "start": 26891,
        "end": 26898
      },
      "text": "འཇུག་པ་ ༼སྣར། པེ།༽ འཇུག་པ་མ་"
    },
    {
      "span": {
        "start": 27043,
        "end": 27051
      },
      "text": "བུད་མེད་ ༼སྣར། པེ།༽ བུད་མེད་ལ་"
    },
    {
      "span": {
        "start": 27109,
        "end": 27117
      },
      "text": "བསྟེན་པ་ ༼སྣར། པེ།༽ བརྟེན་པ་"
    },
    {
      "span": {
        "start": 27310,
        "end": 27318
      },
      "text": "སྩོགས་པ་ ༼སྣར།༽ སྩོགས་"
    },
    {
      "span": {
        "start": 27444,
        "end": 27450
      },
      "text": "དེ་ནས་ ༼སྣར། པེ།༽ དེས་ན་"
    },
    {
      "span": {
        "start": 28251,
        "end": 28254
      },
      "text": "ཅན་ ༼སྣར། པེ།༽ ཅན་གྱི་"
    },
    {
      "span": {
        "start": 28317,
        "end": 28323
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 28359,
        "end": 28366
      },
      "text": "ཁྱད་པར་ ༼སྣར། པེ།༽ ཁྱད་པར་དུ་"
    },
    {
      "span": {
        "start": 28391,
        "end": 28400
      },
      "text": "འདོད་ཆགས་ ༼པེ།༽ འདོད་པ་"
    },
    {
      "span": {
        "start": 28659,
        "end": 28667
      },
      "text": "རང་བཞིན་ ༼སྣར། པེ།༽ རང་བཞིན་ཡིན་"
    },
    {
      "span": {
        "start": 28951,
        "end": 28966
      },
      "text": "མེད་པའི་ཐ་མ་ནི། ༼སྣར། པེ།༽ མེད་པའི་ཕྱིར་རོ།"
    },
    {
      "span": {
        "start": 28975,
        "end": 28981
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པ་ཡང་"
    },
    {
      "span": {
        "start": 29477,
        "end": 29486
      },
      "text": "བསྒྱུར་བ་ ༼སྣར། པེ།༽ སྒྱུར་བ་"
    },
    {
      "span": {
        "start": 29913,
        "end": 29923
      },
      "text": "བཅུད་ཀྱིས་ ༼སྣར། པེ།༽ བཅུད་ཀྱི་"
    },
    {
      "span": {
        "start": 29971,
        "end": 29980
      },
      "text": "སྦྱོར་བས་ ༼སྣར། པེ།༽ སྦྱོར་བ་"
    },
    {
      "span": {
        "start": 30403,
        "end": 30408
      },
      "text": "དྲུག་ ༼སྣར། པེ།༽ གཏུགས་"
    },
    {
      "span": {
        "start": 30420,
        "end": 30427
      },
      "text": "བསལ་བས་ ༼སྣར། པེ།༽ བསམ་པས་"
    },
    {
      "span": {
        "start": 30495,
        "end": 30503
      },
      "text": "འཐོབ་པར་ ༼སྣར།༽ འཐོབ་པ་"
    },
    {
      "span": {
        "start": 30542,
        "end": 30548
      },
      "text": "བརྙེས་ ༼སྣར།༽ བརྙེད་"
    },
    {
      "span": {
        "start": 30625,
        "end": 30632
      },
      "text": "དུ་སྤང་ ༼སྣར། པེ།༽ དུ་ཡང་"
    },
    {
      "span": {
        "start": 30675,
        "end": 30683
      },
      "text": "གཟུང་བས་ ༼སྣར། པེ།༽ བཟུང་བས་"
    },
    {
      "span": {
        "start": 30717,
        "end": 30724
      },
      "text": "དག་སྤང་ ༼སྣར། པེ།༽ དག་ཡང་"
    },
    {
      "span": {
        "start": 31728,
        "end": 31741
      },
      "text": "། འཛིན་པ་དང་། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 31834,
        "end": 31836
      },
      "text": "པ་ ༼པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 32311,
        "end": 32316
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 32493,
        "end": 32501
      },
      "text": "འཇིགས་པ་ ༼སྣར། པེ།༽ འཇིག་པ་"
    },
    {
      "span": {
        "start": 32611,
        "end": 32625
      },
      "text": "ཉམས་པར་གྱུར་པ་ ༼སྣར། པེ།༽ ཉམས་པའམ་མ་ཉམས་"
    },
    {
      "span": {
        "start": 32737,
        "end": 32748
      },
      "text": "འཇིགས་ཚོགས་ ༼སྡེ།༽ འཇིག་ཚོགས་"
    },
    {
      "span": {
        "start": 33126,
        "end": 33132
      },
      "text": "དག་པར་ ༼སྣར། པེ།༽ དགག་པ་"
    },
    {
      "span": {
        "start": 34058,
        "end": 34065
      },
      "text": "གཟུང་བ་ ༼པེ།༽ གསུང་བ་"
    },
    {
      "span": {
        "start": 35071,
        "end": 35083
      },
      "text": "ཀྱི་ཕྱིར་ཡང་ ༼སྣར། པེ།༽ ཀྱི་ཕྱིར་"
    },
    {
      "span": {
        "start": 35125,
        "end": 35129
      },
      "text": "ངའི། ༼སྣར།༽ མིན ༼པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 35269,
        "end": 35277
      },
      "text": "ཡིད་ཀྱི་ ༼པེ།༽ ཡིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 35299,
        "end": 35306
      },
      "text": "དབང་གི་ ༼སྣར། པེ།༽ དབང་གིས་"
    },
    {
      "span": {
        "start": 35452,
        "end": 35461
      },
      "text": "དོན་གྱིས་ ༼སྣར། པེ།༽ སྒྲོ་བཏགས་པའི་དོན་གྱི་"
    },
    {
      "span": {
        "start": 35627,
        "end": 35635
      },
      "text": "བརྟག་པར་ ༼སྣར།༽ བརྟགས་པར་"
    },
    {
      "span": {
        "start": 35641,
        "end": 35648
      },
      "text": "གཟུང་བ་ ༼སྣར།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 35675,
        "end": 35684
      },
      "text": "བསྐྱེད་པ་ ༼སྣར། པེ།༽ བསྐྱེད་པ་དེ་"
    },
    {
      "span": {
        "start": 35691,
        "end": 35695
      },
      "text": "སྣང་ ༼སྣར། པེ།༽ སྣང་བ་ཉིད་དུ་སྣང་"
    },
    {
      "span": {
        "start": 35924,
        "end": 35929
      },
      "text": "བསྟན་ ༼སྣར། པེ།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 35933,
        "end": 35940
      },
      "text": "གཟུང་བ་ ༼སྣར།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 36062,
        "end": 36067
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིགས་མི་"
    },
    {
      "span": {
        "start": 36458,
        "end": 36463
      },
      "text": "ནི་མ་ ༼སྣར། པེ།༽ ན་མི་"
    },
    {
      "span": {
        "start": 36533,
        "end": 36540
      },
      "text": "སྟོང་པ་ ༼སྣར། པེ།༽ སྟོང་པའི་"
    },
    {
      "span": {
        "start": 36555,
        "end": 36562
      },
      "text": "ཙམ་སྟེ། ༼ཅོ།༽ ཙམ་ཏེ།"
    },
    {
      "span": {
        "start": 36841,
        "end": 36848
      },
      "text": "བྱིན་པ་ ༼སྣར། པེ།༽ ཕྱིན་པ་"
    },
    {
      "span": {
        "start": 37262,
        "end": 37266
      },
      "text": "གནས་ ༼སྣར། པེ།༽ མནས་"
    },
    {
      "span": {
        "start": 37290,
        "end": 37297
      },
      "text": "རྟོག་པ་ ༼སྣར།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 37490,
        "end": 37499
      },
      "text": "བསྒོམས་པ་ ༼པེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 37961,
        "end": 37965
      },
      "text": "བཞི་ ༼སྣར། པེ།༽ བཞི་པོ་"
    },
    {
      "span": {
        "start": 37968,
        "end": 37974
      },
      "text": "ཡིན་པ་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 37996,
        "end": 37999
      },
      "text": "གང་ ༼སྣར། པེ།༽ གང་ཅི་"
    },
    {
      "span": {
        "start": 38089,
        "end": 38093
      },
      "text": "བཞག་ ༼སྣར། པེ།༽ གཞག་"
    },
    {
      "span": {
        "start": 38220,
        "end": 38228
      },
      "text": "པ་བསྒོམ་ ༼སྣར། པེ།༽ པའི་སྒོམ་"
    },
    {
      "span": {
        "start": 38307,
        "end": 38313
      },
      "text": "གང་དུ་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 38396,
        "end": 38401
      },
      "text": "ཁོངས་ ༼སྣར། པེ།༽ ཁམས་"
    },
    {
      "span": {
        "start": 38578,
        "end": 38582
      },
      "text": "བཞག་ ༼སྣར། པེ།༽ གཞག་"
    },
    {
      "span": {
        "start": 38841,
        "end": 38847
      },
      "text": "བརྟག ། ༼སྣར། པེ།༽ བརྟགས། །"
    },
    {
      "span": {
        "start": 39344,
        "end": 39352
      },
      "text": "འགྱུར། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 39405,
        "end": 39410
      },
      "text": "ཞི་བ་ ༼པེ།༽ ཞི་བའི་"
