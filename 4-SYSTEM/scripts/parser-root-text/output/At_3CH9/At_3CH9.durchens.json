{
  "durchens": [
    {
      "span": {
        "start": 29,
        "end": 31
      },
      "text": "ཤ་ ༼སྣར། པེ།༽ ཤཱ་"
    },
    {
      "span": {
        "start": 148,
        "end": 155
      },
      "text": "སྤང་བར་ ༼སྣར། པེ།༽ སྤངས་པར་"
    },
    {
      "span": {
        "start": 187,
        "end": 200
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 390,
        "end": 398
      },
      "text": "ལུས་ཀྱི་ ༼སྣར། པེ།༽ ལུས་ཀྱིས་"
    },
    {
      "span": {
        "start": 420,
        "end": 428
      },
      "text": "བྱིན་པར་ ༼སྣར། པེ།༽ བྱིན་པ་"
    },
    {
      "span": {
        "start": 475,
        "end": 481
      },
      "text": "བརྫུན་ ༼སྣར། པེ།༽ རྫུན་"
    },
    {
      "span": {
        "start": 547,
        "end": 552
      },
      "text": "བརྣབ་ ༼སྣར། པེ།༽ རྣབ་"
    },
    {
      "span": {
        "start": 660,
        "end": 667
      },
      "text": "གྱུར་པ་ ༼པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 741,
        "end": 749
      },
      "text": "འགགས་པར་ ༼སྣར། པེ།༽ འགག་པར་"
    },
    {
      "span": {
        "start": 1062,
        "end": 1072
      },
      "text": "གཡེམ་པ་ནི་ ༼སྣར། པེ།༽ གཡེམ་པའི་"
    },
    {
      "span": {
        "start": 1140,
        "end": 1148
      },
      "text": "འགྲོ་བར་ ༼སྣར།༽ བགྲོད་པར་"
    },
    {
      "span": {
        "start": 1497,
        "end": 1503
      },
      "text": "བསྙེན་ ༼སྣར།༽ བརྙེན་"
    },
    {
      "span": {
        "start": 1636,
        "end": 1644
      },
      "text": "འགྲོ་བར་ ༼སྣར།༽ འགྲོད་པར་ ༼པེ།༽ བགྲོད་པར་"
    },
    {
      "span": {
        "start": 1722,
        "end": 1731
      },
      "text": "བསྲུངས་པ་ ༼སྣར།༽ སྲུངས་པ་"
    },
    {
      "span": {
        "start": 2086,
        "end": 2092
      },
      "text": "བརྫུན་ ༼སྣར། པེ།༽ རྫུན་"
    },
    {
      "span": {
        "start": 2144,
        "end": 2150
      },
      "text": "བརྫུན་ ༼སྣར། པེ།༽ རྫུན་"
    },
    {
      "span": {
        "start": 2590,
        "end": 2594
      },
      "text": "གཏག་ ༼སྣར། པེ།༽ བཏག་"
    },
    {
      "span": {
        "start": 2633,
        "end": 2636
      },
      "text": "ནི་ ༼སྣར།༽ ནི་མ་"
    },
    {
      "span": {
        "start": 3077,
        "end": 3082
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ རྒྱུན་"
    }
  ]
}