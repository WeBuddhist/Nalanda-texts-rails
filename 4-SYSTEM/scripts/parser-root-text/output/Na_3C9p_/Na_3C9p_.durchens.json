{
  "durchens": [
    {
      "span": {
        "start": 21,
        "end": 29
      },
      "text": "པྲ་ཏིཥྛ་ ༼སྣར། པེ།༽ ཏིཥྛ་"
    },
    {
      "span": {
        "start": 137,
        "end": 145
      },
      "text": "ལྟ་བུའི་ ༼སྣར། པེ།༽ ལྟ་བུ་"
    },
    {
      "span": {
        "start": 214,
        "end": 224
      },
      "text": "ཚོགས་སོགས་ ༼སྣར། པེ།༽ ཚོགས་གསོག་"
    },
    {
      "span": {
        "start": 560,
        "end": 564
      },
      "text": "འཐས་ ༼པེ།༽ མཐས་"
    },
    {
      "span": {
        "start": 1092,
        "end": 1097
      },
      "text": "རྟགས་ ༼སྣར། པེ།༽ རྟག་"
    },
    {
      "span": {
        "start": 1115,
        "end": 1120
      },
      "text": "འདུས་ ༼སྣར། པེ།༽ དུས་"
    },
    {
      "span": {
        "start": 1247,
        "end": 1257
      },
      "text": "རྫོག་སོ། ། ༼སྣར། པེ།༽ རྫོག །"
    },
    {
      "span": {
        "start": 1403,
        "end": 1410
      },
      "text": "། །ཚ་ཚ་ ༼སྣར། པེ།༽ ། །སཱཙྪ་"
    },
    {
      "span": {
        "start": 1456,
        "end": 1467
      },
      "text": "ཡེ་ཤེས་ཚ་ཚ་ ༼སྣར། པེ།༽ ཡེ་ཤེས་སཱཙྪ་"
    },
    {
      "span": {
        "start": 1560,
        "end": 1563
      },
      "text": "གང་ ༼སྣར། པེ།༽ གོང་"
    },
    {
      "span": {
        "start": 1615,
        "end": 1621
      },
      "text": "འགྱིང་ ༼སྣར། པེ།༽ འགྱིངས་"
    },
    {
      "span": {
        "start": 1748,
        "end": 1753
      },
      "text": "རྟགས་ ༼སྣར། པེ།༽ རྟག་"
    },
    {
      "span": {
        "start": 1763,
        "end": 1770
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 1901,
        "end": 1911
      },
      "text": "རྒྱལ་པོའི་ ༼སྣར། པེ།༽ རྒྱལ་པོ་"
    },
    {
      "span": {
        "start": 2201,
        "end": 2210
      },
      "text": "གཙང་རིགས་ ༼སྣར། པེ།༽ གཙང་རིས་"
    },
    {
      "span": {
        "start": 2225,
        "end": 2230
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིས་"
    },
    {
      "span": {
        "start": 2505,
        "end": 2510
      },
      "text": "ཀརྟི་ ༼སྣར། པེ།༽ ཀ་ཏི་"
    },
    {
      "span": {
        "start": 2584,
        "end": 2586
      },
      "text": "ས་ ༼སྣར། པེ།༽ མནྟྲ་"
    },
    {
      "span": {
        "start": 2894,
        "end": 2899
      },
      "text": "དྲངས་ ༼སྣར། པེ།༽ དྲང་"
    },
    {
      "span": {
        "start": 3087,
        "end": 3098
      },
      "text": "བརྩམས་པ་ཡང་ ༼སྣར། པེ།༽ བརྩམས་པ་ཡི་"
    },
    {
      "span": {
        "start": 3157,
        "end": 3168
      },
      "text": "རྩད་ནས་ཆོད། ༼སྣར། པེ།༽ རྩད་ཆོད་ནས།"
    }
  ]
}