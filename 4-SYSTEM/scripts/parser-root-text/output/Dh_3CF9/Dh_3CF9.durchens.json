{
  "durchens": [
    {
      "span": {
        "start": 233,
        "end": 239
      },
      "text": "མེད། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 277,
        "end": 283
      },
      "text": "ཡིན་ན་ ༼སྣར། པེ།༽ ལ་དེའང་"
    },
    {
      "span": {
        "start": 385,
        "end": 391
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 398,
        "end": 403
      },
      "text": "ལྟོས། ༼སྣར།༽ བལྟོས ༼པེ།༽ བལྟའོ།"
    },
    {
      "span": {
        "start": 473,
        "end": 481
      },
      "text": "གཅིག་པུ་ ༼སྣར། པེ།༽ གཅིག་དུ་"
    },
    {
      "span": {
        "start": 627,
        "end": 633
      },
      "text": "དེ་བས་ ༼པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 668,
        "end": 674
      },
      "text": "འདྲེས་ ༼སྣར། པེ།༽ འབྲེལ་"
    },
    {
      "span": {
        "start": 778,
        "end": 786
      },
      "text": "འགོད་པར་ ༼པེ།༽ འགོག་པར་"
    },
    {
      "span": {
        "start": 1036,
        "end": 1038
      },
      "text": "ན། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 1050,
        "end": 1053
      },
      "text": "ནི་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 1226,
        "end": 1229
      },
      "text": "རྭ་ ༼སྣར།༽ རྭས་"
    },
    {
      "span": {
        "start": 1235,
        "end": 1239
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 2144,
        "end": 2146
      },
      "text": "པ་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 2252,
        "end": 2260
      },
      "text": "འབྲེལ་པ་ ༼ཅོ།༽ འགྲེལ་པ་"
    },
    {
      "span": {
        "start": 2309,
        "end": 2320
      },
      "text": "བྱེད་ན་ཡང་། ༼སྣར། པེ།༽ བྱེད་པ་ན།"
    },
    {
      "span": {
        "start": 2434,
        "end": 2440
      },
      "text": "འབྲེལ་ ༼སྣར།༽ འབྲལ་"
    },
    {
      "span": {
        "start": 2692,
        "end": 2699
      },
      "text": "བྲལ་བར་ ༼སྣར།༽ བྲལ་བ་"
    },
    {
      "span": {
        "start": 2891,
        "end": 2898
      },
      "text": "སོ་སོར་ ༼སྣར། པེ།༽ སོ་སོ་"
    }
  ]
}