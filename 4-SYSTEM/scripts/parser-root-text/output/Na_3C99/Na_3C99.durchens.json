{
  "durchens": [
    {
      "span": {
        "start": 304,
        "end": 311
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 696,
        "end": 705
      },
      "text": "འགྱུར་རོ། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 1040,
        "end": 1046
      },
      "text": "ང་ཡིས་ ༼སྣར། པེ།༽ ང་ཡི་"
    },
    {
      "span": {
        "start": 1316,
        "end": 1322
      },
      "text": "བརྟེན་ ༼སྣར།༽ བརྟན་"
    },
    {
      "span": {
        "start": 2776,
        "end": 2783
      },
      "text": "མཁན་པོ་ ༼སྣར། པེ།༽ མཁན་པོ་པཎྜི་ཏ་"
    }
  ]
}