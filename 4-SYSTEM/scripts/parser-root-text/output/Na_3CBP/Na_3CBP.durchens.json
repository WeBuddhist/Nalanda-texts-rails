{
  "durchens": [
    {
      "span": {
        "start": 25,
        "end": 28
      },
      "text": "ཏི་ ༼སྣར། པེ།༽ ཏཱི་"
    },
    {
      "span": {
        "start": 301,
        "end": 311
      },
      "text": "བསྲུངས་ནས། ༼སྣར། པེ།༽ བསྲུངས་ན།"
    },
    {
      "span": {
        "start": 348,
        "end": 355
      },
      "text": "གཅེས་པ་ ༼སྣར། པེ།༽ གཅེས་པས་"
    },
    {
      "span": {
        "start": 496,
        "end": 501
      },
      "text": "སྤང་། ༼སྣར།༽ སྤོངས ༼པེ།༽ སྤོང་།"
    },
    {
      "span": {
        "start": 524,
        "end": 529
      },
      "text": "སྤང་། ༼སྣར། པེ།༽ སྤོངས།"
    },
    {
      "span": {
        "start": 536,
        "end": 543
      },
      "text": "དཀའ་སོ་ ༼སྣར། པེ།༽ དཀའ་གསོ་"
    },
    {
      "span": {
        "start": 575,
        "end": 580
      },
      "text": "སྤང་། ༼སྣར། པེ།༽ སྤོངས།"
    },
    {
      "span": {
        "start": 674,
        "end": 680
      },
      "text": "འགྲུབ་ ༼སྣར། པེ།༽ གྲུབ་"
    },
    {
      "span": {
        "start": 698,
        "end": 703
      },
      "text": "བརྟན་ ༼སྣར། པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 737,
        "end": 744
      },
      "text": "ཤིན་ཏུ་ ༼སྣར། པེ།༽ མིས་ནི་"
    },
    {
      "span": {
        "start": 830,
        "end": 835
      },
      "text": "བརྟན་ ༼སྣར། པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 921,
        "end": 928
      },
      "text": "འཆར་བར་ ༼པེ།༽ འཆར་བ་"
    },
    {
      "span": {
        "start": 1030,
        "end": 1033
      },
      "text": "རྩ་ ༼སྣར།༽ རྩད་"
    },
    {
      "span": {
        "start": 1036,
        "end": 1043
      },
      "text": "གཅད་པར་ ༼སྣར། པེ།༽ བཅད་པར་"
    },
    {
      "span": {
        "start": 1135,
        "end": 1149
      },
      "text": "ཀྱི་སྐལ། །འདི་ ༼སྣར། པེ།༽ ཀྱིས་བསྐལ། དེ་"
    },
    {
      "span": {
        "start": 1547,
        "end": 1552
      },
      "text": "ཁ་ཡི་ ༼པེ།༽ ཁ་ཡིས་"
    },
    {
      "span": {
        "start": 1559,
        "end": 1563
      },
      "text": "ཕུང་ ༼སྣར། པེ།༽ འཕུང་"
    },
    {
      "span": {
        "start": 1580,
        "end": 1589
      },
      "text": "རི་སྐེགས་ ༼པེ།༽ རི་སྐྱེགས་"
    },
    {
      "span": {
        "start": 1716,
        "end": 1724
      },
      "text": "སྨྱུང་བ་ ༼སྣར། པེ།༽ བསྙུང་བ་"
    },
    {
      "span": {
        "start": 2216,
        "end": 2223
      },
      "text": "ཁུ་ཚུར་ ༼སྣར། པེ།༽ ཁུར་ཁུར་"
    },
    {
      "span": {
        "start": 2229,
        "end": 2232
      },
      "text": "སླ། ༼སྡེ། ཅོ།༽ བླ།"
    },
    {
      "span": {
        "start": 2255,
        "end": 2258
      },
      "text": "སླ། ༼སྡེ། ཅོ།༽ བླ།"
    },
    {
      "span": {
        "start": 2283,
        "end": 2286
      },
      "text": "སླ། ༼སྡེ། ཅོ།༽ བླ།"
    },
    {
      "span": {
        "start": 2774,
        "end": 2781
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 3025,
        "end": 3028
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 3231,
        "end": 3235
      },
      "text": "མཛའ་ ༼སྣར།༽ མཛད་"
    },
    {
      "span": {
        "start": 3289,
        "end": 3299
      },
      "text": "གྲོགས་འཁར་ ༼སྣར། པེ།༽ སྲོག་མཁར་"
    },
    {
      "span": {
        "start": 3344,
        "end": 3348
      },
      "text": "དུས་ ༼སྣར། པེ།༽ འདུ་"
    },
    {
      "span": {
        "start": 3396,
        "end": 3406
      },
      "text": "གྲོགས་འཁར་ ༼སྣར།༽ གྲོག་མཁར་ ༼པེ།༽ གྲོགས་མཁར་"
    },
    {
      "span": {
        "start": 3548,
        "end": 3554
      },
      "text": "ལ་ཉེས་ ༼སྣར། པེ།༽ ལས་ཉེས་"
    },
    {
      "span": {
        "start": 3667,
        "end": 3673
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 3743,
        "end": 3750
      },
      "text": "གྲགས་པ་ ༼སྣར། པེ།༽ གྲགས་པས་"
    },
    {
      "span": {
        "start": 3793,
        "end": 3799
      },
      "text": "བིལ་བ་ ༼སྣར། པེ།༽ བིལྭ་"
    },
    {
      "span": {
        "start": 3802,
        "end": 3805
      },
      "text": "ནང་ ༼སྣར། པེ།༽ ངན་"
    },
    {
      "span": {
        "start": 3825,
        "end": 3833
      },
      "text": "སྟོང་པར་ ༼སྣར། པེ།༽ སྟོངས་པར་"
    },
    {
      "span": {
        "start": 4183,
        "end": 4191
      },
      "text": "སྦྱོར་བ་ ༼པེ།༽ སྦྱར་བ་"
    },
    {
      "span": {
        "start": 4409,
        "end": 4416
      },
      "text": "འདོད་ཕ་ ༼སྣར། པེ།༽ འདོགས་པ་"
    },
    {
      "span": {
        "start": 4423,
        "end": 4430
      },
      "text": "བསྡིགས་ ༼སྣར། པེ།༽ སྡིགས་"
    },
    {
      "span": {
        "start": 4476,
        "end": 4483
      },
      "text": "བརྟན་པ་ ༼སྣར། པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 4564,
        "end": 4570
      },
      "text": "བྱ་ཡི། ༼པེ།༽ བྱ་ཡིས།"
    },
    {
      "span": {
        "start": 4767,
        "end": 4776
      },
      "text": "ཁྱོད་ཀྱི་ ༼པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 4802,
        "end": 4811
      },
      "text": "བསྲེགས་པ་ ༼སྣར། པེ།༽ སྲེག་པ་"
    },
    {
      "span": {
        "start": 5269,
        "end": 5278
      },
      "text": "རིགས་རུས་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 5282,
        "end": 5286
      },
      "text": "བའི་ ༼སྣར། པེ།༽ བ་ཡི་"
    },
    {
      "span": {
        "start": 5336,
        "end": 5342
      },
      "text": "ལ་རྩྭ་ ༼སྣར། པེ།༽ ལ་རྩ་"
    },
    {
      "span": {
        "start": 5702,
        "end": 5705
      },
      "text": "བླ་ ༼སྣར། པེ།༽ སླ་"
    },
    {
      "span": {
        "start": 5771,
        "end": 5776
      },
      "text": "གདུད་ ༼སྣར།༽ བཏུད་ ༼པེ།༽ བདུད་"
    },
    {
      "span": {
        "start": 5836,
        "end": 5841
      },
      "text": "བསླང་ ༼སྣར། པེ།༽ བསླངས་"
    },
    {
      "span": {
        "start": 5954,
        "end": 5961
      },
      "text": "བརྒལ་ན་ ༼སྣར། པེ།༽ བརྒལ་ནས་"
    },
    {
      "span": {
        "start": 6104,
        "end": 6107
      },
      "text": "སླ། ༼སྡེ། ཅོ།༽ བླ།"
    },
    {
      "span": {
        "start": 6163,
        "end": 6166
      },
      "text": "ཁྭ་ ༼པེ།༽ ཁ་"
    },
    {
      "span": {
        "start": 6311,
        "end": 6320
      },
      "text": "འཇིགས་པར་ ༼སྣར། པེ།༽ འཇིག་པར་"
    },
    {
      "span": {
        "start": 6357,
        "end": 6364
      },
      "text": "ཆང་གསར་ ༼སྣར། པེ།༽ ཆང་སར་"
    },
    {
      "span": {
        "start": 6370,
        "end": 6378
      },
      "text": "གཞོན་ནུ་ ༼ཅོ།༽ གཞོན་ནུར་"
    },
    {
      "span": {
        "start": 6568,
        "end": 6572
      },
      "text": "ཕངས་ ༼སྣར། པེ།༽ ཕོངས་"
    },
    {
      "span": {
        "start": 6783,
        "end": 6789
      },
      "text": "སྤང་བ་ ༼སྣར། པེ།༽ སྤོང་བ་"
    },
    {
      "span": {
        "start": 6854,
        "end": 6860
      },
      "text": "བརྟེན། ༼སྣར། པེ།༽ སྟེན།"
    },
    {
      "span": {
        "start": 6981,
        "end": 6992
      },
      "text": "སྦྲང་རྩིའི་ ༼སྣར། པེ།༽ སྦྲང་རྩི་"
    },
    {
      "span": {
        "start": 6999,
        "end": 7005
      },
      "text": "འཛག་པ་ ༼སྣར། པེ།༽ འཛགས་པ་"
    },
    {
      "span": {
        "start": 7050,
        "end": 7059
      },
      "text": "རིགས་ལྡན་ ༼སྣར།༽ རིག་ལྡན་"
    },
    {
      "span": {
        "start": 7067,
        "end": 7075
      },
      "text": "བརྟེན་པ་ ༼སྣར།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 7086,
        "end": 7090
      },
      "text": "ཕངས་ ༼སྣར།༽ ཕོངས་"
    },
    {
      "span": {
        "start": 7271,
        "end": 7289
      },
      "text": "འདོད་གླནཞིང་ལྐུགས་ ༼སྣར། པེ།༽ འདོད་གླེན་ཞིང་ལྐུག་"
    },
    {
      "span": {
        "start": 7478,
        "end": 7483
      },
      "text": "འཁྲི་ ༼སྣར། པེ།༽ མཁྲི་"
    },
    {
      "span": {
        "start": 7729,
        "end": 7738
      },
      "text": "སླར་ཡང་མ་ ༼སྣར།༽ སླར་ཡང་"
    },
    {
      "span": {
        "start": 7845,
        "end": 7849
      },
      "text": "མཉམ་ ༼སྣར།༽ ཉམས་"
    },
    {
      "span": {
        "start": 8043,
        "end": 8048
      },
      "text": "འགྲན། ༼སྣར། པེ།༽ འདྲན།"
    },
    {
      "span": {
        "start": 8089,
        "end": 8098
      },
      "text": "འདེགས་པར་ ༼སྣར། པེ།༽ འདེབས་པར་"
    },
    {
      "span": {
        "start": 8122,
        "end": 8127
      },
      "text": "སྐུར་ ༼སྣར། པེ།༽ སྐྱུར་"
    },
    {
      "span": {
        "start": 8194,
        "end": 8207
      },
      "text": "སྦྱོར་བྱེད་པ། ༼སྣར། པེ།༽ སྦྱོར་བྱེད་པའི།"
    },
    {
      "span": {
        "start": 8209,
        "end": 8213
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 8223,
        "end": 8227
      },
      "text": "ཕུང་ ༼སྣར། པེ།༽ འཕུང་"
    },
    {
      "span": {
        "start": 8238,
        "end": 8244
      },
      "text": "ཁྱིའུ་ ༼སྣར། པེ།༽ ཁྱེའུ་"
    },
    {
      "span": {
        "start": 8668,
        "end": 8679
      },
      "text": "ཆེན་པོ་གང་། ༼སྣར། པེ།༽ ཆེན།"
    },
    {
      "span": {
        "start": 8799,
        "end": 8808
      },
      "text": "བསྡོ་བའི་ ༼སྣར། པེ།༽ སྡོ་བའི་"
    },
    {
      "span": {
        "start": 8855,
        "end": 8861
      },
      "text": "བཞུགས་ ༼སྣར།༽ ཞུགས་"
    },
    {
      "span": {
        "start": 8925,
        "end": 8932
      },
      "text": "རྩེ་བར་ ༼སྣར། པེ།༽ བརྩེ་བར་"
    },
    {
      "span": {
        "start": 9030,
        "end": 9039
      },
      "text": "སྐྱེ་དགུ་ ༼སྣར།༽ སྐྱེས་བུ་ ༼པེ།༽ སྐྱེས་དགུ་"
    },
    {
      "span": {
        "start": 9313,
        "end": 9317
      },
      "text": "ཕུང་ ༼སྣར། པེ།༽ འཕུང་"
    },
    {
      "span": {
        "start": 9324,
        "end": 9329
      },
      "text": "ཕུང་། ༼སྣར། པེ།༽ འཕུང་།"
    },
    {
      "span": {
        "start": 9360,
        "end": 9367
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གང་"
    },
    {
      "span": {
        "start": 9454,
        "end": 9458
      },
      "text": "དགྲ་ ༼སྣར། པེ།༽ སྒྲ་"
    },
    {
      "span": {
        "start": 9485,
        "end": 9494
      },
      "text": "སྒྲོགས་ལ། ༼སྣར། པེ།༽ སྒྲོགས་པ།"
    },
    {
      "span": {
        "start": 9691,
        "end": 9695
      },
      "text": "ངའི་ ༼སྣར།༽ པའི་"
    },
    {
      "span": {
        "start": 9708,
        "end": 9714
      },
      "text": "ལྷུང་། ༼སྣར། པེ།༽ ལྟུང་།"
    },
    {
      "span": {
        "start": 9736,
        "end": 9741
      },
      "text": "བགོད་ ༼སྣར། པེ།༽ རྒོད་"
    },
    {
      "span": {
        "start": 9810,
        "end": 9815
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 9825,
        "end": 9832
      },
      "text": "གཏང་བར་ ༼སྣར། པེ།༽ བཏང་བར་"
    },
    {
      "span": {
        "start": 9844,
        "end": 9850
      },
      "text": "ཤན་པས་ ༼སྣར། པེ།༽ བཤན་པས་"
    },
    {
      "span": {
        "start": 9950,
        "end": 9956
      },
      "text": "འཛེགས་ ༼སྣར། པེ།༽ འཛེག་"
    },
    {
      "span": {
        "start": 10047,
        "end": 10054
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 10127,
        "end": 10131
      },
      "text": "གི ། ༼སྣར། པེ།༽ གིས། །"
    },
    {
      "span": {
        "start": 10137,
        "end": 10144
      },
      "text": "དག་གསད་ ༼སྣར།༽ དག་གི་བསད་ ༼པེ།༽ དག་བསད་"
    },
    {
      "span": {
        "start": 10341,
        "end": 10349
      },
      "text": "ཚོགས་པས་ ༼སྣར། པེ།༽ ཚོགས་པ་"
    },
    {
      "span": {
        "start": 10364,
        "end": 10368
      },
      "text": "ཕུང་ ༼སྣར། པེ།༽ འཕུང་"
    },
    {
      "span": {
        "start": 10482,
        "end": 10495
      },
      "text": "བསྒྲུབས་པ་ཡི། ༼སྣར།༽ བསྒྲུབས་པ་ཡིས།"
    },
    {
      "span": {
        "start": 10570,
        "end": 10577
      },
      "text": "གིས་མི་ ༼སྣར།༽ གིས་མ་"
    },
    {
      "span": {
        "start": 10618,
        "end": 10625
      },
      "text": "ཚིག་གི་ ༼པེ།༽ ཚིག་གིས་"
    },
    {
      "span": {
        "start": 10769,
        "end": 10771
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 10837,
        "end": 10839
      },
      "text": "ལ། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 11072,
        "end": 11077
      },
      "text": "སྣུམ་ ༼སྣར།༽ སྣུན་ ༼པེ།༽ བསྣུན་"
    },
    {
      "span": {
        "start": 11079,
        "end": 11087
      },
      "text": "ལྟོས་པར་ ༼སྣར། པེ།༽ བལྟོས་པར་"
    },
    {
      "span": {
        "start": 11120,
        "end": 11125
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 11191,
        "end": 11198
      },
      "text": "སྡིག་པ་ ༼སྣར། པེ།༽ སྡུག་པ་"
    },
    {
      "span": {
        "start": 11261,
        "end": 11266
      },
      "text": "གྱུར་ ༼སྣར།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 11390,
        "end": 11397
      },
      "text": "བཅས་པར་ ༼ཅོ།༽ བཅོས་པར་"
    },
    {
      "span": {
        "start": 11482,
        "end": 11492
      },
      "text": "བརྟུལ་ཕོད་ ༼སྣར། པེ།༽ རྟུལ་ཕོད་"
    },
    {
      "span": {
        "start": 11591,
        "end": 11600
      },
      "text": "སྐྱོན་ཆད་ ༼སྣར། པེ།༽ སྔོན་ཆད་"
    },
    {
      "span": {
        "start": 11817,
        "end": 11820
      },
      "text": "ཡི་ ༼སྣར། པེ།༽ ཡིས་"
    },
    {
      "span": {
        "start": 11864,
        "end": 11867
      },
      "text": "ཅི་ ༼སྣར། པེ།༽ ཅིས་"
    },
    {
      "span": {
        "start": 11943,
        "end": 11954
      },
      "text": "སྦུད་པ་ཡིན། ༼སྣར།༽ སྦུད་པ་བཞིན ༼པེ།༽ སྦུད་བཞིན་པ།"
    },
    {
      "span": {
        "start": 12187,
        "end": 12189
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 12370,
        "end": 12374
      },
      "text": "མཉམ་ ༼སྣར། པེ།༽ ཉམས་"
    },
    {
      "span": {
        "start": 12434,
        "end": 12439
      },
      "text": "འཐུང་ ༼སྣར། པེ།༽ འཐུངས་"
    },
    {
      "span": {
        "start": 12527,
        "end": 12532
      },
      "text": "སློང་ ༼སྣར། པེ།༽ སློངས་"
    },
    {
      "span": {
        "start": 12664,
        "end": 12671
      },
      "text": "མེད་དེ། ༼སྣར།༽ མེད།"
    },
    {
      "span": {
        "start": 12713,
        "end": 12720
      },
      "text": "མི་བཟད་ ༼སྣར། པེ།༽ མི་ཟད་"
    },
    {
      "span": {
        "start": 12775,
        "end": 12781
      },
      "text": "བཟློག་ ༼སྣར། པེ།༽ ཟློག་"
    },
    {
      "span": {
        "start": 12812,
        "end": 12827
      },
      "text": "གྲོགས་པོ་འདི་ན་ ༼སྣར།༽ གྲོགས་པོ་འདིས་"
    },
    {
      "span": {
        "start": 12861,
        "end": 12866
      },
      "text": "ཁྱེད་ ༼ཅོ།༽ ཁྱེར་ ༼སྣར། པེ།༽ ཁྱོད་"
    },
    {
      "span": {
        "start": 12919,
        "end": 12925
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 12929,
        "end": 12933
      },
      "text": "དེར་ ༼སྣར།༽ དེ་"
    },
    {
      "span": {
        "start": 12963,
        "end": 12968
      },
      "text": "ཕུང་། ༼སྣར། པེ།༽ འཕུང་།"
    },
    {
      "span": {
        "start": 12977,
        "end": 12985
      },
      "text": "ས་སྟེངས་ ༼པེ།༽ ས་སྟེང་"
    },
    {
      "span": {
        "start": 13128,
        "end": 13136
      },
      "text": "ཉུགས་པར་ ༼སྣར། པེ།༽ ཉུག་པར་"
    },
    {
      "span": {
        "start": 13217,
        "end": 13222
      },
      "text": "བརྟན་ ༼སྣར།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 13278,
        "end": 13286
      },
      "text": "མིན་གྱི། ༼སྣར། པེ།༽ མིན་གྱིས།"
    },
    {
      "span": {
        "start": 13308,
        "end": 13313
      },
      "text": "བརྟན། ༼སྣར། པེ།༽ བསྟན།"
    },
    {
      "span": {
        "start": 13360,
        "end": 13367
      },
      "text": "ཀྱིས་མ་ ༼སྣར། པེ།༽ ཀྱིས་མི་"
    },
    {
      "span": {
        "start": 13447,
        "end": 13454
      },
      "text": "ངོམས་པ་ ༼སྣར།༽ ངོམ་པ་"
    },
    {
      "span": {
        "start": 13467,
        "end": 13475
      },
      "text": "འདོད་པས་ ༼པེ།༽ འདོད་པ་"
    },
    {
      "span": {
        "start": 13677,
        "end": 13683
      },
      "text": "བཅིང་། ༼སྣར། པེ།༽ བཅིངས།"
    },
    {
      "span": {
        "start": 13789,
        "end": 13793
      },
      "text": "ཕྲད་ ༼པེ།༽ འཕྲད་"
    },
    {
      "span": {
        "start": 13835,
        "end": 13839
      },
      "text": "རྩྭ་ ༼སྣར། པེ།༽ རྩ་"
    },
    {
      "span": {
        "start": 13882,
        "end": 13885
      },
      "text": "ཟར་ ༼ཅོ།༽ སར་"
    },
    {
      "span": {
        "start": 13894,
        "end": 13902
      },
      "text": "སྦེགས་པ་ ༼སྣར། པེ།༽ རྦེག་པ་"
    },
    {
      "span": {
        "start": 13946,
        "end": 13951
      },
      "text": "བྱེད། ༼སྣར།༽ མྱེད།"
    },
    {
      "span": {
        "start": 14038,
        "end": 14044
      },
      "text": "ག་ནའང་ ༼སྣར། པེ།༽ གང་ན་"
    },
    {
      "span": {
        "start": 14169,
        "end": 14175
      },
      "text": "ཆུ་ཡི་ ༼པེ།༽ ཆུ་ཡིས་"
    },
    {
      "span": {
        "start": 14246,
        "end": 14250
      },
      "text": "རྩྭ་ ༼སྣར། པེ།༽ རྩ་"
    },
    {
      "span": {
        "start": 14337,
        "end": 14340
      },
      "text": "ནང་ ༼སྣར། པེ།༽ ངན་"
    },
    {
      "span": {
        "start": 14431,
        "end": 14435
      },
      "text": "ནོར་ ༼ཅོ།༽ ནང་"
    },
    {
      "span": {
        "start": 14498,
        "end": 14506
      },
      "text": "ལུས་ཀྱི་ ༼པེ།༽ ལུས་ཀྱིས་"
    },
    {
      "span": {
        "start": 14674,
        "end": 14681
      },
      "text": "བྱ་སྟེ། ༼སྣར། པེ།༽ བྱས་ཏེ།"
    },
    {
      "span": {
        "start": 14749,
        "end": 14758
      },
      "text": "སྐིགས་བུ་ ༼སྣར། པེ།༽ སྐྱིགས་བུ་"
    },
    {
      "span": {
        "start": 14848,
        "end": 14857
      },
      "text": "གཉེན་ཅིར་ ༼སྣར།༽ གཉོན་ཅིར་ ༼པེ།༽ གཉེན་ཅིང་"
    },
    {
      "span": {
        "start": 15021,
        "end": 15025
      },
      "text": "རིང་ ༼སྣར།༽ རིག་ ༼པེ།༽ རིག་ས་"
    },
    {
      "span": {
        "start": 15038,
        "end": 15042
      },
      "text": "ཞིང་ ༼སྣར། པེ།༽ ཞིང་རྒྱལ་བ་"
    },
    {
      "span": {
        "start": 15193,
        "end": 15197
      },
      "text": "ལུས་ ༼སྣར། པེ།༽ མིན་ལུས་མི་"
    },
    {
      "span": {
        "start": 15288,
        "end": 15296
      },
      "text": "བྲེག་པར་ ༼སྣར།༽ རེག་པར་"
    },
    {
      "span": {
        "start": 15404,
        "end": 15409
      },
      "text": "ཚེམས། ༼སྣར། པེ།༽ སེམས།"
    },
    {
      "span": {
        "start": 15787,
        "end": 15793
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 15926,
        "end": 15937
      },
      "text": "ལོངས་སྤྱོད་ ༼སྣར། པེ།༽ ལོག་སྤྱོད་"
    },
    {
      "span": {
        "start": 15946,
        "end": 15951
      },
      "text": "རྩོལ་ ༼སྣར། པེ།༽ སྩོལ་"
    },
    {
      "span": {
        "start": 15994,
        "end": 16000
      },
      "text": "སྐྱེད། ༼སྣར། པེ།༽ སྐྱིད།"
    },
    {
      "span": {
        "start": 16018,
        "end": 16028
      },
      "text": "དཔྱོད་པའི་ ༼པེ།༽ སྤྱོད་པའི་"
    },
    {
      "span": {
        "start": 16063,
        "end": 16067
      },
      "text": "རྣམ་ ༼པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 16122,
        "end": 16128
      },
      "text": "ཕྱུགས་ ༼སྣར། པེ།༽ ཕྱུག་"
    },
    {
      "span": {
        "start": 16197,
        "end": 16204
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 16216,
        "end": 16222
      },
      "text": "དེ་བས་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 16527,
        "end": 16532
      },
      "text": "བསགས་ ༼སྣར།༽ བསག་"
    },
    {
      "span": {
        "start": 16927,
        "end": 16932
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ སྲུངས་"
    },
    {
      "span": {
        "start": 16965,
        "end": 16967
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནའང་"
    },
    {
      "span": {
        "start": 17250,
        "end": 17256
      },
      "text": "ངང་པས་ ༼སྣར། པེ།༽ ངང་པ་"
    },
    {
      "span": {
        "start": 17259,
        "end": 17273
      },
      "text": "ནང་ནས་ནི་འོ་མ་ ༼སྣར། པེ།༽ ལ་འོ་མ་ལེན་པ་"
    },
    {
      "span": {
        "start": 17552,
        "end": 17561
      },
      "text": "སྐྱེས་བུ་ ༼སྣར། པེ།༽ སྐྱེས་བུས་"
    },
    {
      "span": {
        "start": 17596,
        "end": 17601
      },
      "text": "སེམས་ ༼སྣར། པེ།༽ སེམས་ཅན་ལས་"
    },
    {
      "span": {
        "start": 17646,
        "end": 17654
      },
      "text": "ས་སྟེངས་ ༼སྣར། པེ།༽ ས་སྟེང་"
    },
    {
      "span": {
        "start": 17710,
        "end": 17718
      },
      "text": "སྐྱེས་པ་ ༼སྣར། པེ།༽ སྐྱེད་པ་"
    },
    {
      "span": {
        "start": 18226,
        "end": 18230
      },
      "text": "མིན། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 18278,
        "end": 18280
      },
      "text": "ན་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 18610,
        "end": 18617
      },
      "text": "དཔའ་བོ་ ༼པེ།༽ དཔའོ་"
    },
    {
      "span": {
        "start": 18629,
        "end": 18632
      },
      "text": "ཁྭ་ ༼ཅོ།༽ ཁ་ ༼སྣར།༽ ཁྲ་"
    },
    {
      "span": {
        "start": 18808,
        "end": 18816
      },
      "text": "རྩྭ་སྙམ་ ༼སྣར། པེ།༽ རྩ་མཉམ་"
    },
    {
      "span": {
        "start": 18885,
        "end": 18890
      },
      "text": "གྲངས་ ༼སྣར། པེ།༽ གྲགས་"
    },
    {
      "span": {
        "start": 18941,
        "end": 18945
      },
      "text": "མེད་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 19410,
        "end": 19414
      },
      "text": "རྗེ་ ༼སྣར།༽ རྗེས་"
    },
    {
      "span": {
        "start": 19454,
        "end": 19458
      },
      "text": "བཞད་ ༼སྣར། པེ།༽ གཞད་"
    },
    {
      "span": {
        "start": 19508,
        "end": 19512
      },
      "text": "བཞད་ ༼པེ།༽ གཞད་"
    },
    {
      "span": {
        "start": 19641,
        "end": 19651
      },
      "text": "ཀྱིས་ཕོངས་ ༼སྣར། པེ།༽ ཀྱི་ཕོང་"
    },
    {
      "span": {
        "start": 19675,
        "end": 19682
      },
      "text": "འཐབ་པར་ ༼སྣར།༽ འཐོབ་པར་"
    },
    {
      "span": {
        "start": 19848,
        "end": 19855
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 20030,
        "end": 20036
      },
      "text": "བྱ་ཡི། ༼སྣར།༽ བྱ་མི།"
    },
    {
      "span": {
        "start": 20093,
        "end": 20099
      },
      "text": "ལ་ཚོལ་ ༼སྣར། པེ།༽ ལས་ཚོར་"
    },
    {
      "span": {
        "start": 20268,
        "end": 20276
      },
      "text": "མི་བྱིན། ༼སྣར། པེ།༽ མ་ཡིན།"
    },
    {
      "span": {
        "start": 20340,
        "end": 20347
      },
      "text": "ཙམ་གྱི་ ༼པེ།༽ ཙམ་གྱིས་"
    },
    {
      "span": {
        "start": 20351,
        "end": 20359
      },
      "text": "བཅས་དང་། ༼སྣར། པེ།༽ བཅས་ཀྱང་།"
    },
    {
      "span": {
        "start": 20434,
        "end": 20441
      },
      "text": "བསྒྲུབ། ༼སྣར། པེ།༽ སྒྲུབ།"
    },
    {
      "span": {
        "start": 20783,
        "end": 20789
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 20827,
        "end": 20834
      },
      "text": "མཁས་པས་ ༼སྣར། པེ།༽ མཁས་པ་"
    },
    {
      "span": {
        "start": 21022,
        "end": 21030
      },
      "text": "སྐྱེ་བོ་ ༼སྣར།༽ སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 21087,
        "end": 21090
      },
      "text": "ལས་ ༼སྣར། པེ།༽ བས་"
    },
    {
      "span": {
        "start": 21191,
        "end": 21196
      },
      "text": "བརྒྱ་ ༼སྣར། པེ།༽ རྒྱ་"
    },
    {
      "span": {
        "start": 21265,
        "end": 21274
      },
      "text": "རིགས་ལྡན་ ༼སྣར། པེ།༽ རིག་ལྡན་"
    },
    {
      "span": {
        "start": 21446,
        "end": 21452
      },
      "text": "འགྱུར། ༼པེ།༽ གྱུར།"
    },
    {
      "span": {
        "start": 21974,
        "end": 21979
      },
      "text": "ངན་པ་ ༼སྣར། པེ།༽ ངན་པས་"
    },
    {
      "span": {
        "start": 22209,
        "end": 22214
      },
      "text": "ཕྱུང་ ༼པེ།༽ ཆུང་"
    },
    {
      "span": {
        "start": 22392,
        "end": 22400
      },
      "text": "མཆོད་པས་ ༼པེ།༽ ཆོས་པས་"
    },
    {
      "span": {
        "start": 22423,
        "end": 22431
      },
      "text": "བརྟན་པས་ ༼སྣར། པེ།༽ བསྟན་པས་"
    },
    {
      "span": {
        "start": 22555,
        "end": 22561
      },
      "text": "སྨྲ་བ། ༼སྣར། པེ།༽ སྨྲས་པ།"
    },
    {
      "span": {
        "start": 22577,
        "end": 22580
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེར་"
    },
    {
      "span": {
        "start": 22786,
        "end": 22793
      },
      "text": "གང་ཞིག་ ༼སྣར། པེ།༽ གང་ཞིང་"
    },
    {
      "span": {
        "start": 23181,
        "end": 23191
      },
      "text": "བཟུང་བ་ཡི། ༼སྣར།༽ བཟུང་བ་ཡིས།"
    },
    {
      "span": {
        "start": 23320,
        "end": 23324
      },
      "text": "ཡིན། ༼སྣར།༽ ཡིན་ནོ།"
    },
    {
      "span": {
        "start": 23498,
        "end": 23504
      },
      "text": "ཏ་ལྟར་ ༼སྣར། པེ།༽ ད་ལྟར་"
    },
    {
      "span": {
        "start": 23897,
        "end": 23907
      },
      "text": "ལམ་བརྒྱགས་ ༼སྣར། པེ།༽ ལམ་རྒྱགས་"
    },
    {
      "span": {
        "start": 23973,
        "end": 23977
      },
      "text": "ཁྱེ། ༼སྡེ། ཅོ།༽ ཁྱེར།"
    },
    {
      "span": {
        "start": 24100,
        "end": 24106
      },
      "text": "སྦྱིན་ ༼སྣར། པེ།༽ བྱིན་"
    },
    {
      "span": {
        "start": 24169,
        "end": 24176
      },
      "text": "འཇིག་པ་ ༼སྣར། པེ།༽ འཇིགས་པ་"
    },
    {
      "span": {
        "start": 24368,
        "end": 24374
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 24399,
        "end": 24401
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 24409,
        "end": 24413
      },
      "text": "གཏང་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 24469,
        "end": 24476
      },
      "text": "མཐའ་ཡས་ ༼སྣར། པེ།༽ མཐའ་ཡང་"
    },
    {
      "span": {
        "start": 24496,
        "end": 24503
      },
      "text": "མཐའ་ཡས་ ༼སྣར། པེ།༽ མཐའ་ཡང་"
    },
    {
      "span": {
        "start": 24623,
        "end": 24631
      },
      "text": "ཡབ་གཅིག་ ༼སྣར། པེ།༽ ཡབ་ཅིག་"
    },
    {
      "span": {
        "start": 24676,
        "end": 24680
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིར་"
    },
    {
      "span": {
        "start": 24856,
        "end": 24859
      },
      "text": "ལས་ ༼པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 24875,
        "end": 24879
      },
      "text": "ཐོས་ ༼སྣར།༽ གོས་"
    },
    {
      "span": {
        "start": 24963,
        "end": 24966
      },
      "text": "ཆག་ ༼སྣར། པེ།༽ ཆགས་"
    },
    {
      "span": {
        "start": 25254,
        "end": 25261
      },
      "text": "བཅས་པས་ ༼པེ།༽ བཅས་པར་"
    },
    {
      "span": {
        "start": 25282,
        "end": 25290
      },
      "text": "སྐྱེ་བོ་ ༼སྣར། པེ།༽ སྐྱེ་བོའི་"
    },
    {
      "span": {
        "start": 25310,
        "end": 25317
      },
      "text": "ཚིག་ནི་ ༼སྣར། པེ།༽ ཚིག་གི་"
    },
    {
      "span": {
        "start": 25435,
        "end": 25439
      },
      "text": "བསད་ ༼སྣར། པེ།༽ གསོད་"
    },
    {
      "span": {
        "start": 25470,
        "end": 25476
      },
      "text": "གྱི། ། ༼སྣར། པེ།༽ ། །རང་གི་ཁྲོ་བ་ཉིད་བསད་ན། །"
    },
    {
      "span": {
        "start": 25583,
        "end": 25594
      },
      "text": "བཟོད་པར་བྱ་ ༼སྣར།༽ བཟོད་པ་བྱར་"
    },
    {
      "span": {
        "start": 25621,
        "end": 25628
      },
      "text": "འོས་པས་ ༼སྣར། པེ།༽ ཡིན་པས་"
    },
    {
      "span": {
        "start": 25910,
        "end": 25915
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 26000,
        "end": 26007
      },
      "text": "ཤེས་པར་ ༼ཅོ།༽ ཤེས་རབ་ ༼སྣར། པེ།༽ ཤེས་པའམ་"
    },
    {
      "span": {
        "start": 26013,
        "end": 26020
      },
      "text": "སུ་ཞིག་ ༼སྣར། པེ།༽ སུ་མི་"
    },
    {
      "span": {
        "start": 26105,
        "end": 26116
      },
      "text": "ཀྱིས་འཇིག ། ༼སྣར།༽ གྱིས་འཇིགས། ། ༼པེ།༽ གྱིས་འཇིག །"
    },
    {
      "span": {
        "start": 26138,
        "end": 26143
      },
      "text": "གཅིག་ ༼སྣར། པེ།༽ གཙིགས་"
    },
    {
      "span": {
        "start": 26506,
        "end": 26512
      },
      "text": "སང་གི་ ༼སྣར།༽ སེང་གེ་ ༼པེ།༽ སང་བ་"
    },
    {
      "span": {
        "start": 26539,
        "end": 26547
      },
      "text": "བྱ་བ་སྔ་ ༼སྣར།༽ བྱ་བས་"
    },
    {
      "span": {
        "start": 26655,
        "end": 26660
      },
      "text": "འཇུག་ ༼སྣར། པེ།༽ འདུག་"
    },
    {
      "span": {
        "start": 26706,
        "end": 26712
      },
      "text": "ཕྱུགས་ ༼པེ།༽ ཕྱུག་"
    },
    {
      "span": {
        "start": 26848,
        "end": 26856
      },
      "text": "གྱུར་པར། ༼སྣར། པེ།༽ གྱུར་པ།"
    },
    {
      "span": {
        "start": 27517,
        "end": 27521
      },
      "text": "མེད་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 27549,
        "end": 27554
      },
      "text": "བསླབ་ ༼སྣར། པེ།༽ བསླབས་"
    },
    {
      "span": {
        "start": 27617,
        "end": 27624
      },
      "text": "གྱུར་པ། ༼སྣར། པེ།༽ འགྱུར་བ།"
    },
    {
      "span": {
        "start": 27675,
        "end": 27678
      },
      "text": "ཡི། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 27895,
        "end": 27900
      },
      "text": "རིགས་ ༼སྣར།༽ རིག་"
    },
    {
      "span": {
        "start": 27969,
        "end": 27975
      },
      "text": "མཆོག ། ༼སྣར། པེ།༽ མཆོད། །"
    },
    {
      "span": {
        "start": 27988,
        "end": 27995
      },
      "text": "རླག་པར་ ༼སྣར། པེ།༽ བརླག་པར་"
    },
    {
      "span": {
        "start": 28021,
        "end": 28026
      },
      "text": "འདོར། ༼སྡེ། ཅོ། པེ།༽ དོར།"
    },
    {
      "span": {
        "start": 28104,
        "end": 28109
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིག་"
    },
    {
      "span": {
        "start": 28167,
        "end": 28172
      },
      "text": "རིགས་ ༼སྣར།༽ རིག་"
    },
    {
      "span": {
        "start": 28226,
        "end": 28231
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིག་"
    },
    {
      "span": {
        "start": 28238,
        "end": 28240
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 28422,
        "end": 28430
      },
      "text": "ཆོད་པའང་ ༼སྣར།༽ མཆོད་པའང་"
    },
    {
      "span": {
        "start": 28442,
        "end": 28448
      },
      "text": "རིག་པ་ ༼སྣར། པེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 28478,
        "end": 28486
      },
      "text": "ཐད་རྣམས་ ༼སྣར། པེ།༽ ཐད་ནས་"
    },
    {
      "span": {
        "start": 28757,
        "end": 28765
      },
      "text": "ས་སྟེངས་ ༼སྣར། པེ།༽ ས་སྟེང་"
    },
    {
      "span": {
        "start": 28898,
        "end": 28908
      },
      "text": "བློན་པོའི་ ༼སྣར། པེ།༽ བློན་པོ་"
    },
    {
      "span": {
        "start": 29368,
        "end": 29375
      },
      "text": "གང་ལའང་ ༼སྣར། པེ།༽ ག་ལའང་"
    },
    {
      "span": {
        "start": 29618,
        "end": 29625
      },
      "text": "སྒྲོགས་ ༼སྣར། པེ།༽ སྒྲོག་"
    },
    {
      "span": {
        "start": 29798,
        "end": 29803
      },
      "text": "སྲུན་ ༼སྣར།༽ བསླུན་ ༼པེ།༽ བསྲུན་"
    },
    {
      "span": {
        "start": 29817,
        "end": 29823
      },
      "text": "དྲེགས། ༼སྣར། པེ།༽ གོས།"
    },
    {
      "span": {
        "start": 29825,
        "end": 29835
      },
      "text": "བརྡུངས་ནས་ ༼སྣར། པེ།༽ བརྡུངས་ན་"
    },
    {
      "span": {
        "start": 29943,
        "end": 29948
      },
      "text": "ཁྱིམ་ ༼སྣར། པེ།༽ ཁྱི་"
    },
    {
      "span": {
        "start": 29969,
        "end": 29973
      },
      "text": "ལྷག་ ༼སྣར། པེ།༽ བལྡག་"
    },
    {
      "span": {
        "start": 30018,
        "end": 30023
      },
      "text": "སྲུན་ ༼སྣར།༽ བསྲུན་"
    },
    {
      "span": {
        "start": 30135,
        "end": 30140
      },
      "text": "འཇུག་ ༼སྣར། པེ།༽ འདུག་"
    },
    {
      "span": {
        "start": 30191,
        "end": 30196
      },
      "text": "སྲུན་ ༼སྣར།༽ བསྲུན་"
    },
    {
      "span": {
        "start": 30709,
        "end": 30713
      },
      "text": "པའང་ ༼སྣར། པེ།༽ ནའང་"
    },
    {
      "span": {
        "start": 30809,
        "end": 30814
      },
      "text": "བརྐམ་ ༼སྣར། པེ།༽ བསྐམ་"
    },
    {
      "span": {
        "start": 30845,
        "end": 30854
      },
      "text": "སྐྱོང་བར་ ༼སྣར། པེ།༽ སྐྱོ་བར་"
    },
    {
      "span": {
        "start": 30944,
        "end": 30953
      },
      "text": "འཐོབ་པའི། ༼སྣར། པེ།༽ མཐོང་བའི།"
    },
    {
      "span": {
        "start": 31220,
        "end": 31230
      },
      "text": "འདིར་རིགས་ ༼སྣར། པེ།༽ འདི་རིག་"
    },
    {
      "span": {
        "start": 31358,
        "end": 31365
      },
      "text": "རྒལ་བར་ ༼སྣར། པེ།༽ བརྒལ་བར་"
    },
    {
      "span": {
        "start": 31387,
        "end": 31391
      },
      "text": "འཆི་ ༼སྣར། པེ།༽ འམ་མི་"
    }
  ]
}