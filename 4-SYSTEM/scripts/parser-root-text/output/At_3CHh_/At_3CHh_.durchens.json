{
  "durchens": [
    {
      "span": {
        "start": 218,
        "end": 227
      },
      "text": "ཀྱིས་མཐའ་ ༼སྣར། པེ།༽ ཀྱི་ཐ་"
    },
    {
      "span": {
        "start": 401,
        "end": 408
      },
      "text": "ཚོགས་པ་ ༼སྣར། པེ།༽ ཚོགས་"
    },
    {
      "span": {
        "start": 411,
        "end": 418
      },
      "text": "ལྡན་པར་ ༼སྣར། པེ།༽ ལྡན་པ་"
    },
    {
      "span": {
        "start": 421,
        "end": 428
      },
      "text": "བཤམ་མོ། ༼སྣར། པེ།༽ བཤམ།"
    },
    {
      "span": {
        "start": 574,
        "end": 578
      },
      "text": "གཏང་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 780,
        "end": 790
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 914,
        "end": 921
      },
      "text": "དབུལ་བ་ ༼སྣར། པེ།༽ འབུལ་བ་"
    },
    {
      "span": {
        "start": 1136,
        "end": 1141
      },
      "text": "བགྱི། ༼སྣར། པེ།༽ བགྱིའོ།"
    },
    {
      "span": {
        "start": 3101,
        "end": 3108
      },
      "text": "སྡུ་གུ་ ༼སྣར། པེ།༽ སྡུག་གུ་"
    },
    {
      "span": {
        "start": 3334,
        "end": 3347
      },
      "text": "འདབ་ཆགས་ཚོགས་ ༼སྣར། པེ།༽ འདབ་ཆགས་"
    },
    {
      "span": {
        "start": 3347,
        "end": 3350
      },
      "text": "དང་ ༼སྣར། པེ།༽ དང་ནི་"
    },
    {
      "span": {
        "start": 3366,
        "end": 3374
      },
      "text": "རྐང་མངས་ ༼སྣར། པེ།༽ རྐང་མང་"
    },
    {
      "span": {
        "start": 3514,
        "end": 3524
      },
      "text": "ཁྱེད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱེད་ཀྱི་"
    },
    {
      "span": {
        "start": 3596,
        "end": 3601
      },
      "text": "གཏོང་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 3628,
        "end": 3640
      },
      "text": "བུམ་པའི་ཆུས་ ༼སྣར། པེ།༽ བུམ་པའི་"
    }
  ]
}