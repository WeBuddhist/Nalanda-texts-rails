{
  "durchens": [
    {
      "span": {
        "start": 231,
        "end": 238
      },
      "text": "བསྒྲུབ་ ༼པེ།༽ བསྒྲུབས་"
    },
    {
      "span": {
        "start": 523,
        "end": 529
      },
      "text": "གསུངས། ༼སྣར། པེ།༽ གསུང་།"
    },
    {
      "span": {
        "start": 573,
        "end": 578
      },
      "text": "གདེང་ ༼སྣར། པེ།༽ གདེངས་"
    },
    {
      "span": {
        "start": 623,
        "end": 631
      },
      "text": "མྱུར་དུ་ ༼སྣར། པེ།༽ མྱུར་དེ་"
    },
    {
      "span": {
        "start": 643,
        "end": 648
      },
      "text": "བརྩམ། ༼སྣར། པེ།༽ བརྩམས།"
    },
    {
      "span": {
        "start": 667,
        "end": 681
      },
      "text": "འཇིག་རྟེན་གྱི། ༼སྣར། པེ།༽ འཇིག་རྟེན་གྱིས།"
    },
    {
      "span": {
        "start": 861,
        "end": 870
      },
      "text": "སྙིང་པོར་ ༼སྣར། པེ།༽ སྙིང་པོ་"
    },
    {
      "span": {
        "start": 876,
        "end": 881
      },
      "text": "རིག ། ༼སྣར། པེ།༽ རིགས། །"
    },
    {
      "span": {
        "start": 890,
        "end": 894
      },
      "text": "གཞི་ ༼སྣར།༽ བཞི་"
    },
    {
      "span": {
        "start": 1207,
        "end": 1213
      },
      "text": "དང་། ། ༼སྣར། པེ།༽ དག །"
    },
    {
      "span": {
        "start": 1463,
        "end": 1471
      },
      "text": "གྱུར་པས། ༼སྣར། པེ།༽ གྱུར་པ།"
    },
    {
      "span": {
        "start": 1473,
        "end": 1480
      },
      "text": "རྩ་བའི་ ༼སྣར། པེ།༽ རྩྭ་ཡི་"
    },
    {
      "span": {
        "start": 1676,
        "end": 1683
      },
      "text": "ལམ་ཀའི་ ༼སྣར། པེ།༽ ལམ་ཁའི་"
    },
    {
      "span": {
        "start": 1752,
        "end": 1757
      },
      "text": "ཕུང་། ༼སྣར། པེ།༽ འཕུང་།"
    },
    {
      "span": {
        "start": 1968,
        "end": 1975
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 2412,
        "end": 2420
      },
      "text": "རྒལ་བའི་ ༼སྣར། པེ།༽ རྒོལ་བའི་"
    },
    {
      "span": {
        "start": 2460,
        "end": 2466
      },
      "text": "སྙོམས་ ༼སྣར། པེ།༽ སྙམ་"
    },
    {
      "span": {
        "start": 2480,
        "end": 2488
      },
      "text": "ཁྱིམ་ནས་ ༼སྣར། པེ།༽ ཁྱིམ་གནས་"
    },
    {
      "span": {
        "start": 2951,
        "end": 2955
      },
      "text": "ཡོང་ ༼སྣར། པེ།༽ ཡོངས་"
    },
    {
      "span": {
        "start": 3712,
        "end": 3718
      },
      "text": "བསྲུང་ ༼པེ།༽ སྲུང་"
    },
    {
      "span": {
        "start": 3762,
        "end": 3771
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 3824,
        "end": 3833
      },
      "text": "ཆོས་ཀྱིས་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 4074,
        "end": 4082
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར། པེ།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 4313,
        "end": 4320
      },
      "text": "བཞོན་པ་ ༼པེ།༽ བཞོམ་པ་"
    },
    {
      "span": {
        "start": 4324,
        "end": 4330
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 4339,
        "end": 4352
      },
      "text": "རྗེས་དྲན་གྱི། ༼སྣར། པེ།༽ རྗེས་དྲན་ཀྱིས།"
    },
    {
      "span": {
        "start": 4354,
        "end": 4358
      },
      "text": "ལྕག་ ༼པེ།༽ ལྕག་ས་"
    },
    {
      "span": {
        "start": 4390,
        "end": 4403
      },
      "text": "འཇིགས་པ་ཆེ་བ་ ༼སྣར། པེ།༽ འཇིགས་པ་ཆེས་"
    },
    {
      "span": {
        "start": 4515,
        "end": 4517
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 4698,
        "end": 4708
      },
      "text": "བསྟན་བཅོས་ ༼སྣར། པེ།༽ བསྟན་ཆོས་"
    },
    {
      "span": {
        "start": 4714,
        "end": 4723
      },
      "text": "ཆོས་ཀྱིས་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 4828,
        "end": 4839
      },
      "text": "བསྔགས་པ་ཡི། ༼པེ།༽ བསྔགས་པ་ཡིས།"
    },
    {
      "span": {
        "start": 4841,
        "end": 4846
      },
      "text": "བཤེས་ ༼སྣར། པེ།༽ གཤེས་"
    },
    {
      "span": {
        "start": 5001,
        "end": 5010
      },
      "text": "བརྟེན་པར་ ༼སྣར། པེ།༽ བརྟན་པར་"
    },
    {
      "span": {
        "start": 5253,
        "end": 5262
      },
      "text": "བཤེས་ཀྱི་ ༼སྣར། པེ།༽ བཤེས་ཀྱིས་"
    },
    {
      "span": {
        "start": 5327,
        "end": 5330
      },
      "text": "ཙམ། ༼སྣར། པེ།༽ བརྩམ།"
    },
    {
      "span": {
        "start": 5380,
        "end": 5385
      },
      "text": "སྤང་། ༼སྣར།༽ སྤངས།"
    },
    {
      "span": {
        "start": 5648,
        "end": 5655
      },
      "text": "གང་ལའང་ ༼སྣར། པེ།༽ གང་ལ་"
    },
    {
      "span": {
        "start": 5730,
        "end": 5734
      },
      "text": "ཚིག་ ༼སྣར།༽ ཚིགས་"
    },
    {
      "span": {
        "start": 5995,
        "end": 6003
      },
      "text": "རང་བྱུང་ ༼སྣར། པེ།༽ རབ་བྱུང་"
    },
    {
      "span": {
        "start": 6040,
        "end": 6044
      },
      "text": "སྟི་ ༼སྣར། པེ།༽ བསྟི་"
    },
    {
      "span": {
        "start": 6050,
        "end": 6057
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 6069,
        "end": 6074
      },
      "text": "སྤང་། ༼སྣར། པེ།༽ སྤངས།"
    },
    {
      "span": {
        "start": 6083,
        "end": 6086
      },
      "text": "དེ་ ༼སྣར།༽ དེས་"
    },
    {
      "span": {
        "start": 6262,
        "end": 6273
      },
      "text": "ཆོག་ཤེས་བྱ། ༼སྣར། པེ།༽ ཆོག་ཤེས་བྱས།"
    },
    {
      "span": {
        "start": 6562,
        "end": 6566
      },
      "text": "ཡིན་ ༼སྣར། པེ།༽ ཡན་"
    },
    {
      "span": {
        "start": 6610,
        "end": 6622
      },
      "text": "ཉིན་མཚན་གྱི་ ༼སྣར། པེ།༽ ཉིན་མཚན་གྱིས་"
    },
    {
      "span": {
        "start": 6904,
        "end": 6911
      },
      "text": "བདག་གི་ ༼པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 7065,
        "end": 7071
      },
      "text": "འཇིགས་ ༼སྣར། པེ།༽ འཇིག་"
    },
    {
      "span": {
        "start": 7230,
        "end": 7236
      },
      "text": "ནང་དུ་ ༼སྣར། པེ།༽ གནས་སུ་"
    },
    {
      "span": {
        "start": 7512,
        "end": 7517
      },
      "text": "སྤང་། ༼སྣར། པེ།༽ སྤངས།"
    },
    {
      "span": {
        "start": 7525,
        "end": 7532
      },
      "text": "དགའ་ཡང་ ༼སྣར། པེ།༽ དགའ་སྤང་"
    },
    {
      "span": {
        "start": 7752,
        "end": 7757
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིག་"
    },
    {
      "span": {
        "start": 7796,
        "end": 7801
      },
      "text": "སོམས་ ༼སྣར། པེ།༽ སེམས་"
    },
    {
      "span": {
        "start": 7822,
        "end": 7834
      },
      "text": "སེམས་ཅན་གྱི། ༼སྣར། པེ།༽ སེམས་ཅན་གྱིས།"
    },
    {
      "span": {
        "start": 8057,
        "end": 8061
      },
      "text": "རིག་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 8501,
        "end": 8512
      },
      "text": "བདེར་གཤེགས་ ༼སྣར། པེ།༽ བདེ་གཤེགས་"
    },
    {
      "span": {
        "start": 8551,
        "end": 8555
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ ཡི།"
    },
    {
      "span": {
        "start": 8707,
        "end": 8714
      },
      "text": "ཕྱིར་ཡ་ ༼སྣར། པེ།༽ ཕྱིར་ཡང་"
    },
    {
      "span": {
        "start": 8718,
        "end": 8725
      },
      "text": "འཆིང་བ་ ༼སྣར།༽ འཆིངས་པར་ ༼པེ།༽ འཆིང་བར་"
    },
    {
      "span": {
        "start": 8895,
        "end": 8901
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 8922,
        "end": 8929
      },
      "text": "རྩ་ཤིང་ ༼སྣར། པེ།༽ རྩྭ་ཤིང་"
    },
    {
      "span": {
        "start": 8970,
        "end": 8974
      },
      "text": "བློ་ ༼སྣར།༽ བློས་"
    },
    {
      "span": {
        "start": 9034,
        "end": 9039
      },
      "text": "སྐྱོ་ ༼སྣར། པེ།༽ སྐྱོན་"
    },
    {
      "span": {
        "start": 9093,
        "end": 9097
      },
      "text": "བསག་ ༼སྣར། པེ།༽ བསགས་"
    },
    {
      "span": {
        "start": 9126,
        "end": 9132
      },
      "text": "བསག་པ་ ༼སྣར། པེ།༽ བསགས་པ་"
    },
    {
      "span": {
        "start": 9193,
        "end": 9198
      },
      "text": "སྐྱེ། ༼སྣར། པེ།༽ སྐྱེད།"
    },
    {
      "span": {
        "start": 9340,
        "end": 9354
      },
      "text": "འཇིག་རྟེན་གྱི། ༼པེ།༽ འཇིག་རྟེན་གྱིས།"
    },
    {
      "span": {
        "start": 9621,
        "end": 9623
      },
      "text": "པ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 9673,
        "end": 9678
      },
      "text": "གཙུབ་ ༼སྣར། པེ།༽ གཙུགས་"
    },
    {
      "span": {
        "start": 9789,
        "end": 9795
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 10073,
        "end": 10077
      },
      "text": "ལྟར་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 10086,
        "end": 10096
      },
      "text": "བསླབས་པའི་ ༼སྣར། པེ།༽ བརླབ་པའི་"
    },
    {
      "span": {
        "start": 10123,
        "end": 10131
      },
      "text": "བཞི་ཐོབ་ ༼སྣར།༽ བཞིས་ཐོས་ ༼པེ།༽ བཞི་ཐོས་"
    },
    {
      "span": {
        "start": 10160,
        "end": 10166
      },
      "text": "སྐྱེད། ༼སྣར།༽ སྐྱེ ༼པེ།༽ སྐྱེས།"
    },
    {
      "span": {
        "start": 10303,
        "end": 10312
      },
      "text": "གཞུང་མངས་ ༼སྣར། པེ།༽ གཞུངས་མ་"
    }
  ]
}