{
  "durchens": [
    {
      "span": {
        "start": 286,
        "end": 291
      },
      "text": "རྟོག་ ༼སྣར།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 505,
        "end": 514
      },
      "text": "བསྡུས་ཏེ་ ༼སྣར། པེ།༽ བསྡུས་ནས་"
    },
    {
      "span": {
        "start": 1227,
        "end": 1235
      },
      "text": "གོམས་པར་ ༼སྣར། པེ།༽ གོམ་པར་"
    },
    {
      "span": {
        "start": 1257,
        "end": 1261
      },
      "text": "ཐོག་ ༼སྣར།༽ ཐོགས་"
    },
    {
      "span": {
        "start": 1294,
        "end": 1300
      },
      "text": "བརླབས་ ༼སྣར།༽ བརླམ་ ༼པེ།༽ བརླམས་"
    },
    {
      "span": {
        "start": 1619,
        "end": 1627
      },
      "text": "སྐྱོབ་པ་ ༼སྣར།༽ སྐྱབ་པ་"
    },
    {
      "span": {
        "start": 1718,
        "end": 1722
      },
      "text": "ཐེག་ ༼པེ།༽ ཐེགས་"
    },
    {
      "span": {
        "start": 1767,
        "end": 1773
      },
      "text": "བསྐྱབ་ ༼སྣར། པེ།༽ སྐྱབས་"
    },
    {
      "span": {
        "start": 1831,
        "end": 1841
      },
      "text": "བསྐྱེད་པར་ ༼པེ།༽ སྐྱེད་པར་"
    },
    {
      "span": {
        "start": 2037,
        "end": 2045
      },
      "text": "ལངས་པའི་ ༼སྣར།༽ ཡངས་པའི་"
    },
    {
      "span": {
        "start": 2078,
        "end": 2086
      },
      "text": "བསྟན་པར་ ༼སྣར། པེ།༽ བརྟན་པར་"
    },
    {
      "span": {
        "start": 2101,
        "end": 2110
      },
      "text": "རིམ་གྱིས་ ༼སྣར། པེ།༽ རིམ་གྱི་"
    },
    {
      "span": {
        "start": 2450,
        "end": 2464
      },
      "text": "སངས་རྒྱས་ཀྱིས་ ༼སྣར།༽ སངས་རྒྱས་ཀྱི་"
    },
    {
      "span": {
        "start": 2525,
        "end": 2529
      },
      "text": "སྤང་ ༼སྣར། པེ།༽ སྤོང་"
    },
    {
      "span": {
        "start": 2637,
        "end": 2642
      },
      "text": "མང་བ་ ༼སྣར། པེ།༽ མང་པོ་"
    },
    {
      "span": {
        "start": 2648,
        "end": 2657
      },
      "text": "ཡུན་རིངས་ ༼སྣར། པེ།༽ ཡུན་རིང་"
    },
    {
      "span": {
        "start": 2950,
        "end": 2960
      },
      "text": "སེམས་ཀྱིས་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 3080,
        "end": 3106
      },
      "text": "ཀྱི་ཞལ་སྔ་ནས་དབུས་ཀྱི་གཉེ་ ༼སྣར།༽ ཀྱིས། ཞལ་གནས་དེ་བས་ཀྱི་སྙེ་ ༼པེ།༽ ཀྱིས། ཞལ་སྔ་ནས་དབུས་ཀྱི་སྙེ་"
    }
  ]
}