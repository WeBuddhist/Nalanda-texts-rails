{
  "durchens": [
    {
      "span": {
        "start": 382,
        "end": 389
      },
      "text": "རང་གིས་ ༼པེ།༽ རང་གི་"
    },
    {
      "span": {
        "start": 878,
        "end": 884
      },
      "text": "བཞི་པ། ༼པེ།༽ ཞི་བ།"
    },
    {
      "span": {
        "start": 937,
        "end": 945
      },
      "text": "དབུགས། ། ༼སྣར།༽ དབུགས།། །། ༼པེ།༽ དབྱུགས།། །།"
    },
    {
      "span": {
        "start": 1512,
        "end": 1519
      },
      "text": "སྤོ་བར་ ༼པེ།༽ སྤྲོ་བར་"
    },
    {
      "span": {
        "start": 1620,
        "end": 1631
      },
      "text": "སྣང་བ་སྐྱེ། ༼པེ།༽ སྣང་བ་སྟེ།"
    },
    {
      "span": {
        "start": 3355,
        "end": 3361
      },
      "text": "དགའ་བ་ ༼པེ།༽ དཀའ་བ་"
    },
    {
      "span": {
        "start": 4587,
        "end": 4596
      },
      "text": "སྙིང་གའི་ ༼པེ།༽ སྙིང་ཁའི་"
    },
    {
      "span": {
        "start": 4958,
        "end": 4963
      },
      "text": "སྲོག་ ༼པེ།༽ སྲོགས་"
    },
    {
      "span": {
        "start": 6358,
        "end": 6365
      },
      "text": "ཁྱབ་པར་ ༼པེ།༽ ཁྱད་པར་"
    },
    {
      "span": {
        "start": 6861,
        "end": 6867
      },
      "text": "སྙོམས་ ༼པེ།༽ སྙོམས་པར་"
    }
  ]
}