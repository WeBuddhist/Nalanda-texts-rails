{
  "durchens": [
    {
      "span": {
        "start": 1035,
        "end": 1041
      },
      "text": "བརྟགས་ ༼པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 1356,
        "end": 1366
      },
      "text": "རྡུལ་གཅིག་ ༼སྣར། པེ།༽ རྡུལ་ཅིག་"
    },
    {
      "span": {
        "start": 1413,
        "end": 1418
      },
      "text": "ལྟ་བ་ ༼སྣར། པེ།༽ བལྟ་བ་"
    },
    {
      "span": {
        "start": 1561,
        "end": 1564
      },
      "text": "ཕྲ་ ༼སྣར། པེ།༽ ཕྲ་བའི་"
    },
    {
      "span": {
        "start": 1564,
        "end": 1572
      },
      "text": "རྡུལ་ཇི་ ༼སྣར། པེ།༽ རྡུལ་"
    },
    {
      "span": {
        "start": 1789,
        "end": 1800
      },
      "text": "ཁྱད་པར་ཡང་། ༼སྣར། པེ།༽ ཁྱད་པར་དང་།"
    },
    {
      "span": {
        "start": 1883,
        "end": 1887
      },
      "text": "བེམ་ ༼ཅོ། སྡེ།༽ བེམས་"
    },
    {
      "span": {
        "start": 2007,
        "end": 2013
      },
      "text": "རིག་པ་ ༼སྣར། པེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 2065,
        "end": 2074
      },
      "text": "ཤེས་པ་ཡི། ༼སྣར། པེ།༽ ཤེས་པ་ཡིས།"
    },
    {
      "span": {
        "start": 2274,
        "end": 2279
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 2289,
        "end": 2291
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 2382,
        "end": 2390
      },
      "text": "དོན་གྱི་ ༼སྣར། པེ།༽ དོན་གྱིས་"
    },
    {
      "span": {
        "start": 2394,
        "end": 2397
      },
      "text": "པས་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 2893,
        "end": 2904
      },
      "text": "འབྱུང་བ་ཡི། ༼པེ།༽ འབྱུང་བའི་བློ།"
    },
    {
      "span": {
        "start": 3196,
        "end": 3204
      },
      "text": "འཁོར་ལོ་ ༼སྣར། པེ།༽ འཁོར་ལོར་"
    },
    {
      "span": {
        "start": 3351,
        "end": 3354
      },
      "text": "བས་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 3371,
        "end": 3375
      },
      "text": "ཡུན་ ༼སྣར། པེ།༽ ཡུལ་"
    },
    {
      "span": {
        "start": 3600,
        "end": 3608
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ འགྱུར་བར་"
    },
    {
      "span": {
        "start": 3651,
        "end": 3659
      },
      "text": "སྣ་གཅིག་ ༼སྣར། པེ།༽ སྣ་ཅིག་"
    },
    {
      "span": {
        "start": 4448,
        "end": 4457
      },
      "text": "རྣམ་གཅིག་ ༼སྣར། པེ།༽ རྣམ་ཅིག་"
    },
    {
      "span": {
        "start": 4561,
        "end": 4567
      },
      "text": "རྟག་པ་ ༼སྣར། པེ།༽ རྟགས་པ་"
    },
    {
      "span": {
        "start": 4613,
        "end": 4620
      },
      "text": "རུང་བར་ ༼པེ།༽ རུང་བའི་"
    },
    {
      "span": {
        "start": 4744,
        "end": 4756
      },
      "text": "སྣ་ཚོགས་མིན་ ༼སྣར། པེ།༽ སྣ་ཚོགས་མི་"
    },
    {
      "span": {
        "start": 5130,
        "end": 5141
      },
      "text": "བརྟགས་གཅིག་ ༼སྣར། པེ།༽ བརྟགས་ཅིག་"
    },
    {
      "span": {
        "start": 5329,
        "end": 5338
      },
      "text": "གཅིག་གིས་ ༼སྣར། པེ།༽ གཅིག་གི་"
    },
    {
      "span": {
        "start": 5437,
        "end": 5442
      },
      "text": "གཅིག་ ༼སྣར། པེ།༽ ཅིག་"
    },
    {
      "span": {
        "start": 5901,
        "end": 5906
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 6285,
        "end": 6290
      },
      "text": "གདགས་ ༼སྣར། པེ།༽ རྟགས་"
    },
    {
      "span": {
        "start": 6574,
        "end": 6579
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 6822,
        "end": 6824
      },
      "text": "པ། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 7555,
        "end": 7559
      },
      "text": "བའི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 7661,
        "end": 7667
      },
      "text": "བྱ་མི་ ༼སྣར། པེ།༽ བྱ་མ་"
    },
    {
      "span": {
        "start": 7783,
        "end": 7789
      },
      "text": "གསུངས། ༼སྣར། པེ།༽ གསུང་།"
    },
    {
      "span": {
        "start": 7848,
        "end": 7859
      },
      "text": "ཡང་དག་ཏུ་ན་ ༼སྣར།༽ ཡང་དག་ཏུ་"
    },
    {
      "span": {
        "start": 8078,
        "end": 8085
      },
      "text": "རྟེན་ལ་ ༼སྣར། པེ།༽ བརྟན་ན་"
    },
    {
      "span": {
        "start": 8121,
        "end": 8126
      },
      "text": "འོ་ན་ ༼སྣར། པེ།༽ འོ་ཏེ་"
    },
    {
      "span": {
        "start": 8226,
        "end": 8230
      },
      "text": "ཅིས་ ༼སྣར། པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 8342,
        "end": 8351
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 8477,
        "end": 8482
      },
      "text": "མངོན་ ༼སྣར། པེ།༽ དངོས་"
    },
    {
      "span": {
        "start": 8501,
        "end": 8511
      },
      "text": "སྐྱེད་པའི་ ༼སྣར། པེ།༽ བསྐྱེད་པའི་"
    },
    {
      "span": {
        "start": 8620,
        "end": 8631
      },
      "text": "བསྒྲུབ་པའི་ ༼སྣར། པེ།༽ སྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 8792,
        "end": 8801
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 8887,
        "end": 8893
      },
      "text": "རྟོགས་ ༼སྣར། པེ།༽ རྟོག་"
    },
    {
      "span": {
        "start": 9168,
        "end": 9174
      },
      "text": "དང་པོ་ ༼སྣར། པེ།༽ དང་པོར་"
    },
    {
      "span": {
        "start": 9464,
        "end": 9469
      },
      "text": "ནི་མ་ ༼སྣར། པེ།༽ ནི་མི་"
    },
    {
      "span": {
        "start": 9753,
        "end": 9756
      },
      "text": "དག་ ༼སྣར། པེ།༽ རྟག་"
    },
    {
      "span": {
        "start": 9919,
        "end": 9925
      },
      "text": "ཡོད་པ་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 9989,
        "end": 9992
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 10821,
        "end": 10830
      },
      "text": "འཆེལ་བའི་ ༼སྣར།༽ འཚལ་བའི་"
    }
  ]
}