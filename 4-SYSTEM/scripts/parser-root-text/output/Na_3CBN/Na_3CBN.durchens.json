{
  "durchens": [
    {
      "span": {
        "start": 14413,
        "end": 14422
      },
      "text": "འཇིགས་པར་ ༼སྣར།༽ འཇིག་པར་"
    },
    {
      "span": {
        "start": 15847,
        "end": 15852
      },
      "text": "སྨྲང་ ༼སྣར།༽ སྨང་"
    },
    {
      "span": {
        "start": 18562,
        "end": 18566
      },
      "text": "གོས་ ༼སྣར།༽ བོས་"
    },
    {
      "span": {
        "start": 19972,
        "end": 19981
      },
      "text": "སྲིད་པའི་ ༼སྣར།༽ སྲེད་པའི་"
    },
    {
      "span": {
        "start": 20266,
        "end": 20271
      },
      "text": "བརྟག་ ༼སྣར།༽ བརྟག་གེ་"
    },
    {
      "span": {
        "start": 21970,
        "end": 21976
      },
      "text": "ལྟོགས་ ༼སྣར།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 22831,
        "end": 22835
      },
      "text": "ཚིག་ ༼སྣར།༽ ཚིགས་"
    },
    {
      "span": {
        "start": 24285,
        "end": 24289
      },
      "text": "འབག་ ༼སྣར།༽ འབགས་"
    },
    {
      "span": {
        "start": 24436,
        "end": 24441
      },
      "text": "སྐྲག་ ༼སྣར།༽ བསྐྲག་"
    },
    {
      "span": {
        "start": 24826,
        "end": 24830
      },
      "text": "གོས་ ༼སྣར།༽ གོས་དེ་"
    },
    {
      "span": {
        "start": 26616,
        "end": 26622
      },
      "text": "མ་རིག་ ༼སྣར།༽ མ་རིག་པའི་"
    }
  ]
}