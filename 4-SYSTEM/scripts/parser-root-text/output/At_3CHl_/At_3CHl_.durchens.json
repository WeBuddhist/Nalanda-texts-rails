{
  "durchens": [
    {
      "span": {
        "start": 709,
        "end": 716
      },
      "text": "གཞལ་ཡང་ ༼སྣར། པེ།༽ གཞལ་ཡས་"
    },
    {
      "span": {
        "start": 719,
        "end": 724
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ རྟེན་པ་"
    },
    {
      "span": {
        "start": 771,
        "end": 787
      },
      "text": "ཡིན་མིན་གྱི་མཐའ་ ༼སྣར། པེ།༽ ཡིན་མེན་ཐབས་"
    },
    {
      "span": {
        "start": 831,
        "end": 839
      },
      "text": "འཁོར་ཅན་ ༼སྣར། པེ།༽ འཁོར་རྐྱེན་"
    },
    {
      "span": {
        "start": 855,
        "end": 863
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར། པེ།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 1202,
        "end": 1209
      },
      "text": "བཅོས་པ་ ༼སྣར།༽ བཅས་པ་"
    },
    {
      "span": {
        "start": 1411,
        "end": 1415
      },
      "text": "གཏན་ ༼སྣར། པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 1627,
        "end": 1635
      },
      "text": "དྲངས་ཏེ། ༼སྣར། པེ།༽ དྲང་སྟེ།"
    },
    {
      "span": {
        "start": 1807,
        "end": 1816
      },
      "text": "མགོ་མཇུག་ ༼སྣར།༽ མགོ་གཞུག་ ༼པེ།༽ བཞུག་"
    },
    {
      "span": {
        "start": 1841,
        "end": 1853
      },
      "text": "འོད་དུ་ལྟེམ་ ༼སྣར།༽ འོད་སྟིམ་ ༼པེ།༽ འོད་སྟིམས་"
    },
    {
      "span": {
        "start": 2118,
        "end": 2123
      },
      "text": "ལུགས་ ༼སྣར། པེ།༽ ལུས་"
    },
    {
      "span": {
        "start": 2228,
        "end": 2233
      },
      "text": "བྱའོ། ༼སྣར། པེ།༽ བྱ།"
    },
    {
      "span": {
        "start": 2360,
        "end": 2363
      },
      "text": "ཉག་ ༼སྣར། པེ།༽ ཉ་"
    },
    {
      "span": {
        "start": 2441,
        "end": 2444
      },
      "text": "ཡས་ ༼སྣར། པེ།༽ ཡལ་"
    },
    {
      "span": {
        "start": 2522,
        "end": 2532
      },
      "text": "ངོས་གཟུང་། ༼སྣར། པེ།༽ ངོས་བཟུང་།"
    },
    {
      "span": {
        "start": 2543,
        "end": 2551
      },
      "text": "དྲང་གནས་ ༼སྣར། པེ།༽ གྲང་གནས་"
    },
    {
      "span": {
        "start": 2554,
        "end": 2563
      },
      "text": "གཟུད་པའོ། ༼སྣར། པེ།༽ བཟུང་བའོ།"
    },
    {
      "span": {
        "start": 2744,
        "end": 2747
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 2764,
        "end": 2774
      },
      "text": "ནང་སེམས་ལ་ ༼སྣར། པེ།༽ ནང་སེམས་ལས་"
    },
    {
      "span": {
        "start": 2781,
        "end": 2790
      },
      "text": "རྟོག་པའི་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 3010,
        "end": 3016
      },
      "text": "གསལ་བ་ ༼སྣར། པེ།༽ བསལ་བ་"
    },
    {
      "span": {
        "start": 3224,
        "end": 3231
      },
      "text": "འགྱུ་བ་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 3231,
        "end": 3234
      },
      "text": "ཡང་ ༼སྣར། པེ།༽ རང་"
    },
    {
      "span": {
        "start": 3279,
        "end": 3289
      },
      "text": "ཕུགས་རྡིབ་ ༼སྣར། པེ།༽ ཕུབས་བརྟིབས་"
    },
    {
      "span": {
        "start": 3349,
        "end": 3358
      },
      "text": "བྱུང་བའི་ ༼སྣར། པེ།༽ བྱུང་བས་"
    },
    {
      "span": {
        "start": 3475,
        "end": 3484
      },
      "text": "ལུས་གཅུད་ ༼སྣར། པེ།༽ ལུས་བཅུད་"
    },
    {
      "span": {
        "start": 4173,
        "end": 4183
      },
      "text": "མཚོམས་མེད་ ༼སྣར། པེ།༽ མཚམས་མེད་"
    },
    {
      "span": {
        "start": 4357,
        "end": 4363
      },
      "text": "བཟློག་ ༼སྣར། པེ།༽ ཟློ་"
    },
    {
      "span": {
        "start": 4385,
        "end": 4391
      },
      "text": "འབྲུག་ ༼སྣར། པེ།༽ འབྲུ་"
    },
    {
      "span": {
        "start": 4500,
        "end": 4510
      },
      "text": "སྐྱེད་པའི་ ༼སྣར། པེ།༽ བསྐྱེད་པའི་"
    },
    {
      "span": {
        "start": 4618,
        "end": 4626
      },
      "text": "ཁྱེར་བར་ ༼སྣར། པེ།༽ ཁྱེར་བས་"
    },
    {
      "span": {
        "start": 4668,
        "end": 4677
      },
      "text": "རྟོགས་པས་ ༼སྣར། པེ།༽ རྟོག་པས་"
    },
    {
      "span": {
        "start": 4677,
        "end": 4683
      },
      "text": "བསྒོམ་ ༼སྣར། པེ།༽ སྒོམ་"
    },
    {
      "span": {
        "start": 4720,
        "end": 4727
      },
      "text": "གནས་པས་ ༼སྣར། པེ།༽ གནས་"
    },
    {
      "span": {
        "start": 4826,
        "end": 4834
      },
      "text": "བསྒོམ་པ་ ༼སྣར། པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 5099,
        "end": 5111
      },
      "text": "ཆོས་ཉིད་སྒྲ་ ༼སྣར། པེ།༽ ཆོས་ཉིད་"
    },
    {
      "span": {
        "start": 5140,
        "end": 5146
      },
      "text": "བཟློག་ ༼སྣར། པེ།༽ ཟློག་"
    },
    {
      "span": {
        "start": 5369,
        "end": 5378
      },
      "text": "འགྱུ་མེད་ ༼སྣར། པེ།༽ འགྱུར་མེད་"
    },
    {
      "span": {
        "start": 5389,
        "end": 5396
      },
      "text": "གཅད་པས་ ༼སྣར། པེ།༽ བཅད་པས་"
    },
    {
      "span": {
        "start": 5485,
        "end": 5491
      },
      "text": "ངན་ལམ་ ༼སྣར། པེ།༽ ངན་ལམ་པ་"
    },
    {
      "span": {
        "start": 5582,
        "end": 5591
      },
      "text": "ཁ་དོག་གི་ ༼སྣར། པེ།༽ ཁ་དོག་ནི་"
    },
    {
      "span": {
        "start": 6034,
        "end": 6042
      },
      "text": "ཡིད་ཉིད་ ༼སྣར། པེ།༽ ཡིད་གཉིས་"
    }
  ]
}