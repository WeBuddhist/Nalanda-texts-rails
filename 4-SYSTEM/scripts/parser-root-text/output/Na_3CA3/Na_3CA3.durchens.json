{
  "durchens": [
    {
      "span": {
        "start": 202,
        "end": 210
      },
      "text": "ཀུན་གྱི་ ༼སྣར། པེ།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 358,
        "end": 362
      },
      "text": "རིམ་ ༼སྣར། པེ།༽ རིག་"
    },
    {
      "span": {
        "start": 534,
        "end": 543
      },
      "text": "མ་ཉམས་ཏེ། ༼སྣར། པེ།༽ ཆ་མཉམ་སྟེ།"
    },
    {
      "span": {
        "start": 792,
        "end": 807
      },
      "text": "བརྒྱ་པ་ཡི་སྔགས་ ༼སྣར། པེ།༽ བརྒྱའི་བསྔགས་"
    },
    {
      "span": {
        "start": 822,
        "end": 833
      },
      "text": "བདེན་པ་ཡིས། ༼སྣར། པེ།༽ བདེན་པས་བདེན།"
    },
    {
      "span": {
        "start": 877,
        "end": 882
      },
      "text": "དྲང་། ༼སྣར།༽ དྲངས།"
    },
    {
      "span": {
        "start": 989,
        "end": 996
      },
      "text": "རྒྱལ་བ་ ༼སྣར། པེ།༽ རྒྱལ་བའི་"
    },
    {
      "span": {
        "start": 996,
        "end": 1009
      },
      "text": "སྲས་དང་བཅས་པ་ ༼སྣར། པེ།༽ སྲས་བཅས་"
    },
    {
      "span": {
        "start": 1323,
        "end": 1333
      },
      "text": "བསྲེག་པའི་ ༼སྣར། པེ།༽ བསྲེགས་པའི་"
    },
    {
      "span": {
        "start": 1439,
        "end": 1447
      },
      "text": "ཏུ་རུསྐ་ ༼སྣར།༽ ཧཱུཾ་ལུ་ག་ ༼པེ།༽ ཧཱུ་ལུ་ག་"
    },
    {
      "span": {
        "start": 1585,
        "end": 1593
      },
      "text": "སྒྲ་སྙན་ ༼སྣར།༽ བསྙན་ ༼པེ།༽ སྒྲ་བརྙན་"
    },
    {
      "span": {
        "start": 2027,
        "end": 2036
      },
      "text": "འཇིགས་སོ་ ༼སྣར། པེ།༽ འཇིགས་དང་"
    },
    {
      "span": {
        "start": 2219,
        "end": 2221
      },
      "text": "བ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 2268,
        "end": 2273
      },
      "text": "བསྔོ། ༼སྣར། པེ།༽ སྔོ།"
    },
    {
      "span": {
        "start": 2335,
        "end": 2347
      },
      "text": "བསྐྱབ་སྐྱོབ་ ༼སྣར། པེ།༽ ཀྱང་སྐྱོབས་"
    },
    {
      "span": {
        "start": 2401,
        "end": 2411
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 2502,
        "end": 2511
      },
      "text": "གྲོལ་བའི་ ༼སྣར། པེ།༽ འདུལ་བའི་"
    },
    {
      "span": {
        "start": 3009,
        "end": 3020
      },
      "text": "གཟུང་བ་ཉིད་ ༼སྣར། པེ།༽ གཟུང་བ་"
    },
    {
      "span": {
        "start": 3106,
        "end": 3115
      },
      "text": "རིམ་གྱིས་ ༼སྣར། པེ།༽ རིམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 3286,
        "end": 3295
      },
      "text": "འཕྲོ་འདུ་ ༼སྣར། པེ།༽ འཕྲོས་འདུས་"
    },
    {
      "span": {
        "start": 3355,
        "end": 3363
      },
      "text": "འཁོར་ལོ་ ༼སྣར། པེ།༽ སྟེང་དུ་"
    },
    {
      "span": {
        "start": 3527,
        "end": 3530
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ཧྲི་ལས་"
    },
    {
      "span": {
        "start": 3666,
        "end": 3672
      },
      "text": "འགྱེད། ༼སྣར། པེ།༽ དགྱེས།"
    },
    {
      "span": {
        "start": 3925,
        "end": 3933
      },
      "text": "རིན་ཆེན་ ༼སྣར།༽ རིན་ཆེན་གྱིས་"
    },
    {
      "span": {
        "start": 3933,
        "end": 3942
      },
      "text": "རྒྱན་ལྡན་ ༼སྣར། པེ།༽ རྒྱན་"
    },
    {
      "span": {
        "start": 4004,
        "end": 4014
      },
      "text": "གསིལ་བྱེད་ ༼སྣར། པེ།༽ བསིལ་བྱེད་"
    },
    {
      "span": {
        "start": 4024,
        "end": 4030
      },
      "text": "བཙུགས་ ༼སྣར། པེ།༽ གཙུགས་"
    },
    {
      "span": {
        "start": 4927,
        "end": 4930
      },
      "text": "ངག་ ༼སྣར། པེ།༽ སྔགས་"
    },
    {
      "span": {
        "start": 5064,
        "end": 5068
      },
      "text": "བདག་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 5183,
        "end": 5193
      },
      "text": "སྔགས་ཀྱིས་ ༼སྣར། པེ།༽ སྔགས་ཀྱི་"
    },
    {
      "span": {
        "start": 5215,
        "end": 5221
      },
      "text": "སྦྱངས་ ༼སྣར། པེ།༽ སྦྱང་"
    },
    {
      "span": {
        "start": 5258,
        "end": 5265
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ བསྟེན་པ་"
    },
    {
      "span": {
        "start": 5391,
        "end": 5399
      },
      "text": "བློ་ཡིས་ ༼སྣར། པེ།༽ བློ་ཡི་"
    },
    {
      "span": {
        "start": 5713,
        "end": 5722
      },
      "text": "ཕྱིན་པའི་ ༼སྣར། པེ།༽ ཕྱིན་པ་"
    }
  ]
}