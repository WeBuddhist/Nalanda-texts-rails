{
  "durchens": [
    {
      "span": {
        "start": 381,
        "end": 387
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 541,
        "end": 547
      },
      "text": "བདེ་བ་ ༼སྣར། པེ།༽ བདེ་མ་"
    },
    {
      "span": {
        "start": 601,
        "end": 615
      },
      "text": "ཕུན་ཚོགས་རྣམས། ༼སྣར། པེ།༽ ཕུན་སུམ་ཚོགས།"
    },
    {
      "span": {
        "start": 783,
        "end": 787
      },
      "text": "ཉིད། ༼སྣར། པེ།༽ ཡི།"
    },
    {
      "span": {
        "start": 1127,
        "end": 1133
      },
      "text": "དེ་ལས་ ༼སྣར། པེ།༽ དེ་བས་"
    },
    {
      "span": {
        "start": 1499,
        "end": 1504
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 1579,
        "end": 1584
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 2377,
        "end": 2379
      },
      "text": "བ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 2570,
        "end": 2577
      },
      "text": "སྤྲོ་བ་ ༼སྣར། པེ།༽ སྤྲོས་པ་"
    },
    {
      "span": {
        "start": 2664,
        "end": 2668
      },
      "text": "སརྦ་ ༼སྣར། པེ།༽ སརྦྦ་"
    },
    {
      "span": {
        "start": 2741,
        "end": 2753
      },
      "text": "སེམས་དཔའ་དང་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 3119,
        "end": 3123
      },
      "text": "ཡིད་ ༼སྣར། པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 3360,
        "end": 3368
      },
      "text": "རྣམས་ནི་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 3501,
        "end": 3510
      },
      "text": "མཆོག་གིས་ ༼སྣར། པེ།༽ མཆོག་གི་"
    },
    {
      "span": {
        "start": 3928,
        "end": 3932
      },
      "text": "བྱས། ༼སྣར། པེ།༽ བྱས་ནས།"
    },
    {
      "span": {
        "start": 4210,
        "end": 4217
      },
      "text": "བརླབ་པ་ ༼སྣར།༽ བརླབས་པ་"
    },
    {
      "span": {
        "start": 4374,
        "end": 4376
      },
      "text": "ཨ་ ༼སྣར། པེ།༽ ཨཾ་"
    },
    {
      "span": {
        "start": 4430,
        "end": 4434
      },
      "text": "བསམ། ༼སྣར། པེ།༽ བསམས།"
    },
    {
      "span": {
        "start": 4730,
        "end": 4735
      },
      "text": "བརྒྱ་ ༼སྣར། པེ།༽ བརྒྱད་"
    },
    {
      "span": {
        "start": 4757,
        "end": 4769
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 4795,
        "end": 4805
      },
      "text": "ཐམས་ཅད་དུ་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 5062,
        "end": 5069
      },
      "text": "དཀར་བར་ ༼སྣར། པེ།༽ དཀར་བ་"
    },
    {
      "span": {
        "start": 5398,
        "end": 5405
      },
      "text": "དཀར་པོ་ ༼སྣར། པེ།༽ དཀར་པོ་ཞལ་གཡས་དཀར་པོ་"
    },
    {
      "span": {
        "start": 5955,
        "end": 5964
      },
      "text": "རླུང་གིས་ ༼སྣར།༽ རླུང་གི་"
    },
    {
      "span": {
        "start": 6681,
        "end": 6690
      },
      "text": "སྐྱེད་པར་ ༼སྣར།༽ བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 6962,
        "end": 6978
      },
      "text": "བཞིན་གྱིས་རྟོགས་ ༼སྣར། པེ།༽ དང་གཞན་གྱི་རྟོག་"
    },
    {
      "span": {
        "start": 7189,
        "end": 7204
      },
      "text": "བསམས་ལ། རྗེད་པ་ ༼སྣར། པེ།༽ བསམས་པས། བརྗོད་"
    },
    {
      "span": {
        "start": 7337,
        "end": 7347
      },
      "text": "ཚོགས་ཀྱིས་ ༼སྣར། པེ།༽ ཚོགས་ཀྱི་"
    },
    {
      "span": {
        "start": 7352,
        "end": 7359
      },
      "text": "བ་རྣམས་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 7674,
        "end": 7682
      },
      "text": "ཤེལ་གོང་ ༼སྣར། པེ།༽ ཤེལ་སྒོང་"
    },
    {
      "span": {
        "start": 7847,
        "end": 7855
      },
      "text": "གསུམ་པས་ ༼སྣར། པེ།༽ གསུམ་པ་ན་"
    },
    {
      "span": {
        "start": 8034,
        "end": 8043
      },
      "text": "བསྐྱེད་པ་ ༼སྣར། པེ།༽ བསྐྱེད་པ་པོའི་"
    },
    {
      "span": {
        "start": 8284,
        "end": 8292
      },
      "text": "གཤེགས་པ་ ༼སྣར། པེ།༽ གཤེགས་པའི་"
    },
    {
      "span": {
        "start": 8540,
        "end": 8548
      },
      "text": "ཧཱུྃ་གི་ ༼སྣར། པེ།༽ ཧཱུྃ་གིས་"
    },
    {
      "span": {
        "start": 9303,
        "end": 9311
      },
      "text": "རཾ་གྱིས་ ༼སྣར།༽ རཾ་གྱི་"
    },
    {
      "span": {
        "start": 9563,
        "end": 9572
      },
      "text": "དབྱུང་བར་ ༼སྣར། པེ།༽ འབྱུང་བར་"
    },
    {
      "span": {
        "start": 9745,
        "end": 9754
      },
      "text": "དབྱུང་བར་ ༼སྣར། པེ།༽ འབྱུང་བར་"
    },
    {
      "span": {
        "start": 10341,
        "end": 10354
      },
      "text": "འདོད་ཆགས་ཀྱི་ ༼སྣར། པེ།༽ འདོད་ཆགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 10378,
        "end": 10388
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 10985,
        "end": 10995
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 11040,
        "end": 11049
      },
      "text": "བསྐྱབ་ཏུ་ ༼སྣར། པེ།༽ སྐྱབས་སུ་"
    },
    {
      "span": {
        "start": 11161,
        "end": 11169
      },
      "text": "རྡོ་རྗེ་ ༼སྣར།༽ རྡོ་རྗེའི་"
    },
    {
      "span": {
        "start": 12107,
        "end": 12116
      },
      "text": "དམར་པོའི་ ༼སྣར། པེ།༽ དམར་པོ་"
    },
    {
      "span": {
        "start": 12228,
        "end": 12242
      },
      "text": "འཇིག་རྟེན་གྱི་ ༼སྣར།༽ འཇིག་རྟེན་གྱིས་"
    },
    {
      "span": {
        "start": 12899,
        "end": 12905
      },
      "text": "འདས་པ་ ༼སྣར། པེ།༽ འདས་པ་ལ་"
    },
    {
      "span": {
        "start": 13746,
        "end": 13757
      },
      "text": "དོན་ཡོད་པར་ ༼སྣར། པེ།༽ དོན་ཡོད་"
    },
    {
      "span": {
        "start": 14178,
        "end": 14183
      },
      "text": "ལྔ་པ་ ༼སྣར། པེ།༽ ལྔ་པ་སྟེ་"
    },
    {
      "span": {
        "start": 14287,
        "end": 14309
      },
      "text": "རྣམས་ཀྱིས་འགྲོ་བ་རྣམས་ ༼པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 14324,
        "end": 14339
      },
      "text": "རྣམ་པ་བསྐྱེད་པ། ༼སྣར།༽ རྣམ་པར་བསྐྱེད་ལ ༼པེ།༽ རྣམ་པར་སྐྱེད་ལ།"
    },
    {
      "span": {
        "start": 14465,
        "end": 14473
      },
      "text": "ལྟ་བུའི་ ༼སྣར། པེ།༽ ལྟ་བུ་"
    },
    {
      "span": {
        "start": 14626,
        "end": 14639
      },
      "text": "འོད་ཟེར་གྱིས་ ༼སྣར། པེ།༽ འོད་ཟེར་གྱི་"
    },
    {
      "span": {
        "start": 14751,
        "end": 14758
      },
      "text": "དེ་ཉིད་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 14852,
        "end": 14861
      },
      "text": "བརླབ་པའི་ ༼སྣར།༽ བརླབས་པའི་"
    },
    {
      "span": {
        "start": 14969,
        "end": 14975
      },
      "text": "བརླབས་ ༼སྣར། པེ།༽ བརླབ་"
    },
    {
      "span": {
        "start": 15103,
        "end": 15112
      },
      "text": "བརླབས་ནས་ ༼སྣར། པེ།༽ བརླབ་གནས་"
    },
    {
      "span": {
        "start": 15197,
        "end": 15206
      },
      "text": "རྡོ་རྗེར་ ༼སྣར།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 15216,
        "end": 15232
      },
      "text": "བརླབས་པར་ལྷག་པར་ ༼སྣར། པེ།༽ བརླབས་པར་"
    },
    {
      "span": {
        "start": 15710,
        "end": 15717
      },
      "text": "གོང་དུ་ ༼སྣར། པེ།༽ གོང་"
    },
    {
      "span": {
        "start": 16509,
        "end": 16518
      },
      "text": "བརླབས་ནས་ ༼པེ།༽ བརླབ་གནས་"
    },
    {
      "span": {
        "start": 16642,
        "end": 16651
      },
      "text": "བརླབས་ནས་ ༼སྣར། པེ།༽ བརླབ་གནས་"
    },
    {
      "span": {
        "start": 16712,
        "end": 16721
      },
      "text": "རྡོ་རྗེར་ ༼སྣར།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 16887,
        "end": 16890
      },
      "text": "ལས་ ༼སྣར།༽ ལ་"
    },
    {
      "span": {
        "start": 17278,
        "end": 17287
      },
      "text": "བརླབས་ནས་ ༼པེ།༽ བརླབ་གནས་"
    },
    {
      "span": {
        "start": 17410,
        "end": 17419
      },
      "text": "བརླབས་ནས་ ༼སྣར།༽ བརླབ་ནས་ ༼པེ།༽ བརླབ་གནས་"
    },
    {
      "span": {
        "start": 17491,
        "end": 17500
      },
      "text": "རྡོ་རྗེས་ ༼སྣར། པེ།༽ རྡོ་རྗེར་"
    },
    {
      "span": {
        "start": 17891,
        "end": 17900
      },
      "text": "རྟོགས་པར་ ༼སྡེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 17938,
        "end": 17943
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 17949,
        "end": 17955
      },
      "text": "བྱ་བས་ ༼སྣར། པེ།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 18262,
        "end": 18272
      },
      "text": "བདག་ཉིད་ལ་ ༼སྣར། པེ།༽ བདག་ཉིད་"
    },
    {
      "span": {
        "start": 18780,
        "end": 18789
      },
      "text": "རིམ་པ་ནི་ ༼སྣར། པེ།༽ རིམ་པ་"
    },
    {
      "span": {
        "start": 19276,
        "end": 19297
      },
      "text": "གྱུར་པ་ལས་དོན་ཡོད་པར་ ༼སྣར། པེ།༽ ལས་དོན་ཡོད་"
    },
    {
      "span": {
        "start": 19555,
        "end": 19562
      },
      "text": "ལྟེ་བར་ ༼སྣར། པེ།༽ ལྟེ་བ་"
    },
    {
      "span": {
        "start": 20592,
        "end": 20612
      },
      "text": "དེའི་སྐུར་བཅུག་ལ་དེ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 20647,
        "end": 20652
      },
      "text": "གཞུག་ ༼སྣར། པེ།༽ བཞུག་"
    },
    {
      "span": {
        "start": 21334,
        "end": 21343
      },
      "text": "གསུམ་པ་ན་ ༼སྣར། པེ།༽ གསུམ་པར་"
    },
    {
      "span": {
        "start": 22015,
        "end": 22026
      },
      "text": "དཀྱིལ་འཁོར་ ༼ཅོ།༽ དཀྱིལ་འཁོར་པ་"
    },
    {
      "span": {
        "start": 22349,
        "end": 22359
      },
      "text": "ཞལ་དང་ཕྱག་ ༼སྣར། པེ།༽ ཞལ་"
    },
    {
      "span": {
        "start": 22782,
        "end": 22786
      },
      "text": "རིམ་ ༼སྣར། པེ།༽ རིམ་པ་"
    },
    {
      "span": {
        "start": 22907,
        "end": 22912
      },
      "text": "རིམས་ ༼སྣར། པེ།༽ རིམ་"
    },
    {
      "span": {
        "start": 23685,
        "end": 23697
      },
      "text": "ཕྱུང་ལ་སྤྲོ་ ༼སྣར། པེ།༽ ཕྱུང་"
    },
    {
      "span": {
        "start": 23840,
        "end": 23847
      },
      "text": "དམར་པོ་ ༼སྣར། པེ།༽ དཀར་པོ་"
    },
    {
      "span": {
        "start": 23969,
        "end": 23977
      },
      "text": "དབྱིག་པ་ ༼སྣར། པེ།༽ དབྱུག་པ་"
    },
    {
      "span": {
        "start": 24549,
        "end": 24556
      },
      "text": "པོ་དང་། ༼སྣར། པེ།༽ པོ་"
    },
    {
      "span": {
        "start": 25173,
        "end": 25184
      },
      "text": "ཡེ་ཤེས་ཀྱི་ ༼པེ།༽ ཡེ་ཤེས་ཀྱིས་"
    },
    {
      "span": {
        "start": 25352,
        "end": 25359
      },
      "text": "རྣམ་པར་ ༼སྣར། པེ།༽ ལེགས་པར་"
    },
    {
      "span": {
        "start": 25426,
        "end": 25434
      },
      "text": "གོ་རིམས་ ༼སྣར། པེ།༽ གོ་རིམ་"
    },
    {
      "span": {
        "start": 25918,
        "end": 25926
      },
      "text": "བསྐུལ་ལ་ ༼སྣར། པེ།༽ བསྐུལ་"
    },
    {
      "span": {
        "start": 25936,
        "end": 25945
      },
      "text": "མདུན་གྱི་ ༼སྣར། པེ།༽ མདུན་དུ་"
    },
    {
      "span": {
        "start": 26054,
        "end": 26062
      },
      "text": "གཤེགས་པ་ ༼སྣར། པེ།༽ གཤེགས་པ་དེ་"
    },
    {
      "span": {
        "start": 26854,
        "end": 26859
      },
      "text": "རིམས་ ༼སྣར། པེ།༽ རིམ་"
    },
    {
      "span": {
        "start": 27287,
        "end": 27305
      },
      "text": "ས་བོན་གྱི་འོད་ཟེར་ ༼པེ།༽ ས་བོན་གྱི་"
    },
    {
      "span": {
        "start": 27463,
        "end": 27470
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ གྱུར་པར་"
    },
    {
      "span": {
        "start": 27518,
        "end": 27529
      },
      "text": "ལ་སོགས་པའི་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 27681,
        "end": 27686
      },
      "text": "སརྦྦ་ ༼སྣར།༽ སརྦ་"
    },
    {
      "span": {
        "start": 27825,
        "end": 27832
      },
      "text": "ནམ་མཁར་ ༼སྣར། པེ།༽ ནམ་མཁའ་"
    },
    {
      "span": {
        "start": 27885,
        "end": 27890
      },
      "text": "གསུང་ ༼པེ།༽ གསུངས་"
    },
    {
      "span": {
        "start": 28822,
        "end": 28831
      },
      "text": "བརླབས་པར་ ༼པེ།༽ བརླབ་པར་"
    },
    {
      "span": {
        "start": 29286,
        "end": 29295
      },
      "text": "མྱོང་བའི་ ༼སྣར། པེ།༽ མྱང་བའི་"
    },
    {
      "span": {
        "start": 29405,
        "end": 29415
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 29461,
        "end": 29468
      },
      "text": "ཐིག་ལེ་ ༼སྣར། པེ།༽ ཐིག་ལེའི་"
    },
    {
      "span": {
        "start": 29614,
        "end": 29624
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 29789,
        "end": 29794
      },
      "text": "གོ། ། ༼སྣར།༽ ། །དེ་ནས་"
    },
    {
      "span": {
        "start": 30077,
        "end": 30089
      },
      "text": "འོད་ཟེར་གྱི་ ༼སྣར། པེ།༽ འོད་ཟེར་གྱིས་"
    },
    {
      "span": {
        "start": 30289,
        "end": 30304
      },
      "text": "དཀྱིལ་འཁོར་གྱི་ ༼སྣར། པེ།༽ དཀྱིལ་འཁོར་"
    },
    {
      "span": {
        "start": 30939,
        "end": 30944
      },
      "text": "ཡོངས་ ༼སྣར། པེ།༽ ཧྲི་ཡོངས་"
    },
    {
      "span": {
        "start": 31320,
        "end": 31330
      },
      "text": "བསྒོམས་པས་ ༼སྣར། པེ།༽ བསྒོམ་པས་"
    },
    {
      "span": {
        "start": 31358,
        "end": 31377
      },
      "text": "སེམས་དཔའི་ཐུགས་ཀའི་ ༼སྣར། པེ།༽ སེམས་དཔའི་"
    },
    {
      "span": {
        "start": 31789,
        "end": 31798
      },
      "text": "སྔགས་ཀྱི་ ༼སྣར། པེ།༽ སྔགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 31920,
        "end": 31928
      },
      "text": "བསལ་བའི་ ༼སྣར།༽ གསལ་བའི་"
    },
    {
      "span": {
        "start": 31985,
        "end": 31996
      },
      "text": "གྱི་ས་དཔགས་ ༼སྣར། པེ།༽ གྱི་ས་སྤགས་"
    },
    {
      "span": {
        "start": 32154,
        "end": 32161
      },
      "text": "ངལ་བསོ་ ༼སྣར། པེ།༽ ངལ་གསོ་"
    },
    {
      "span": {
        "start": 32359,
        "end": 32368
      },
      "text": "མདུན་གྱི་ ༼སྣར། པེ།༽ མདུན་དུ་"
    },
    {
      "span": {
        "start": 33008,
        "end": 33012
      },
      "text": "འཕང་ ༼སྣར། པེ།༽ འཕངས་"
    },
    {
      "span": {
        "start": 33117,
        "end": 33122
      },
      "text": "སྔགས་ ༼སྣར།༽ བསྔགས་"
    },
    {
      "span": {
        "start": 33169,
        "end": 33177
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 33292,
        "end": 33299
      },
      "text": "བལྟ་བར་ ༼སྣར། པེ།༽ ལྟ་བར་"
    },
    {
      "span": {
        "start": 33401,
        "end": 33405
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 33458,
        "end": 33466
      },
      "text": "སྦྱོར་བ་ ༼སྣར།༽ སྦྱར་བ་"
    },
    {
      "span": {
        "start": 33482,
        "end": 33486
      },
      "text": "ལྷག་ ༼སྣར། པེ།༽ ལྷ་"
    },
    {
      "span": {
        "start": 33907,
        "end": 33915
      },
      "text": "མཚན་མའི་ ༼སྣར། པེ།༽ མཚན་པའི་"
    },
    {
      "span": {
        "start": 33923,
        "end": 33930
      },
      "text": "ཆུ་དབང་ ༼སྣར། པེ།༽ ཆུད་པར་"
    },
    {
      "span": {
        "start": 34533,
        "end": 34545
      },
      "text": "ལེགས་བྲིས་པ། ༼སྣར། པེ།༽ ལེགས་བྲིས་པས།"
    },
    {
      "span": {
        "start": 34710,
        "end": 34718
      },
      "text": "བསྒྲུབས་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 34912,
        "end": 34917
      },
      "text": "།། །། ༼སྣར། པེ།༽ །། །།ཏོ་ལོང་ཉིས་བརྒྱ་ཕུལ། བོ་ལོང་ཉི་ཤུ་ལ། ཏོ་ལོང་གཅིག །བོ་ལོང་བཅུ་གཉིས་ཞོ་གཅིག་"
    }
  ]
}