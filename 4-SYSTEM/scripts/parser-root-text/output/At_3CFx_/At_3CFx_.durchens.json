      },
      "text": "ཐིགས་པ་ ༼སྣར། པེ།༽ ཐིག་པ་"
    },
    {
      "span": {
        "start": 620,
        "end": 629
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 867,
        "end": 873
      },
      "text": "དཔྱངས་ ༼སྣར། པེ།༽ སྤྱངས་"
    },
    {
      "span": {
        "start": 900,
        "end": 905
      },
      "text": "རྒྱན་ ༼སྣར།༽ བརྒྱན་"
    }
  ]
