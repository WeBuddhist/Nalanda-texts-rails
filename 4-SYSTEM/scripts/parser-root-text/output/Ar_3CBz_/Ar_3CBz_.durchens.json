{
  "durchens": [
    {
      "span": {
        "start": 172,
        "end": 179
      },
      "text": "མཐོང་ན་ ༼སྣར། པེ།༽ མཐོང་ནས་"
    },
    {
      "span": {
        "start": 345,
        "end": 353
      },
      "text": "བརྟགས་པ་ ༼སྣར། པེ།༽ བཏགས་པ་"
    },
    {
      "span": {
        "start": 387,
        "end": 391
      },
      "text": "ཐ་མ་ ༼སྣར། པེ།༽ ཐ་མར་"
    },
    {
      "span": {
        "start": 579,
        "end": 588
      },
      "text": "ཞིབ་མོའི་ ༼སྣར། པེ།༽ ཞིབ་མོ་"
    },
    {
      "span": {
        "start": 663,
        "end": 674
      },
      "text": "སྦྲུལ་གྱིས་ ༼སྣར། པེ།༽ སྦྲུལ་གྱི་"
    },
    {
      "span": {
        "start": 679,
        "end": 689
      },
      "text": "བཞིན་སྤངས། ༼སྣར། པེ།༽ བཞིན་པོ་སྤོང་།"
    },
    {
      "span": {
        "start": 770,
        "end": 774
      },
      "text": "སྤང་ ༼སྣར། པེ།༽ སྤོང་"
    },
    {
      "span": {
        "start": 899,
        "end": 914
      },
      "text": "བརྟུལ་ཞུགས་ཀྱི་ ༼སྣར། པེ།༽ བརྟུལ་ཞུགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 927,
        "end": 933
      },
      "text": "འགྲུབ། ༼སྣར། པེ།༽ གྲུབ།"
    }
  ]
}