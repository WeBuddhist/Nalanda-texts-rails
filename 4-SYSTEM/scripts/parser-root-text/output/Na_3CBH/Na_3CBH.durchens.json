{
  "durchens": [
    {
      "span": {
        "start": 57,
        "end": 66
      },
      "text": "སྤྲིང་ཡིག ༼སྣར། པེ།༽ ཕྲིན་ཡིག"
    },
    {
      "span": {
        "start": 243,
        "end": 248
      },
      "text": "ཁྱོད་ ༼སྣར།༽ ཁྱད་"
    },
    {
      "span": {
        "start": 415,
        "end": 420
      },
      "text": "བགྱི། ༼སྣར། པེ།༽ བགྱིད།"
    },
    {
      "span": {
        "start": 444,
        "end": 448
      },
      "text": "སྨན་ ༼སྣར། པེ།༽ སྙན་"
    },
    {
      "span": {
        "start": 457,
        "end": 466
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 504,
        "end": 510
      },
      "text": "བགྱིས་ ༼སྣར། པེ།༽ བགྱིད་"
    },
    {
      "span": {
        "start": 559,
        "end": 565
      },
      "text": "བགྱིད་ ༼སྣར། པེ།༽ བགྱིས་"
    },
    {
      "span": {
        "start": 773,
        "end": 779
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 957,
        "end": 961
      },
      "text": "སྩལ་ ༼སྣར། པེ།༽ རྩལ་"
    },
    {
      "span": {
        "start": 1016,
        "end": 1025
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 1064,
        "end": 1071
      },
      "text": "སྦགས་པ་ ༼སྣར། པེ།༽ སྩགས་པ་"
    },
    {
      "span": {
        "start": 1074,
        "end": 1083
      },
      "text": "བསྟེན་པར་ ༼སྣར། པེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 1696,
        "end": 1703
      },
      "text": "ལྷ་ལུས་ ༼སྣར། པེ།༽ ལྷ་ཡུལ་"
    },
    {
      "span": {
        "start": 1977,
        "end": 1986
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 2071,
        "end": 2073
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལས།"
    },
    {
      "span": {
        "start": 2075,
        "end": 2079
      },
      "text": "ཕྱི་ ༼སྣར། པེ།༽ ཕྱིས་"
    },
    {
      "span": {
        "start": 2095,
        "end": 2103
      },
      "text": "གྱུར་ཏེ་ ༼སྣར། པེ།༽ གྱུར་དེ་"
    },
    {
      "span": {
        "start": 2225,
        "end": 2235
      },
      "text": "ཁྱོད་ཀྱིས་ ༼པེ།༽ ཁྲོད་ཀྱང་"
    },
    {
      "span": {
        "start": 2365,
        "end": 2369
      },
      "text": "གཏག་ ༼སྣར། པེ།༽ བཏགས་"
    },
    {
      "span": {
        "start": 2406,
        "end": 2414
      },
      "text": "གྱུར་ཏོ་ ༼ཅོ། སྡེ།༽ གྱུར་ཏེ་"
    },
    {
      "span": {
        "start": 2420,
        "end": 2424
      },
      "text": "ཁོན་ ༼སྣར། པེ།༽ འཁོན་"
    },
    {
      "span": {
        "start": 2445,
        "end": 2449
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 2551,
        "end": 2563
      },
      "text": "རིག་པར་བགྱི། ༼སྣར། པེ།༽ རིག་པར་གྱིས།"
    },
    {
      "span": {
        "start": 2692,
        "end": 2701
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 2769,
        "end": 2774
      },
      "text": "སྤང་། ༼སྣར། པེ།༽ སྤངས།"
    },
    {
      "span": {
        "start": 2903,
        "end": 2910
      },
      "text": "དང་པོར་ ༼སྣར། པེ།༽ དང་པོ་"
    },
    {
      "span": {
        "start": 3379,
        "end": 3388
      },
      "text": "བསྐྱེད་པ་ ༼སྣར། པེ།༽ སྐྱེད་པ་"
    },
    {
      "span": {
        "start": 3442,
        "end": 3446
      },
      "text": "སྤང་ ༼སྣར། པེ།༽ སྤངས་"
    },
    {
      "span": {
        "start": 3560,
        "end": 3570
      },
      "text": "བརྟེན་གཡོ་ ༼སྣར། པེ།༽ བརྟན་གཡོ་"
    },
    {
      "span": {
        "start": 3579,
        "end": 3584
      },
      "text": "ཅིག ། ༼སྣར། པེ།༽ གཅིག །"
    },
    {
      "span": {
        "start": 3861,
        "end": 3866
      },
      "text": "བསྟན་ ༼སྣར། པེ།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 3998,
        "end": 4006
      },
      "text": "བགྱིད་པ་ ༼སྣར། པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 4041,
        "end": 4050
      },
      "text": "ལྡན་པ་ཡི། ༼པེ།༽ ལྡན་པ་ཡིས།"
    },
    {
      "span": {
        "start": 4067,
        "end": 4074
      },
      "text": "མཆིས་པ་ ༼པེ།༽ འཆིས་པ་"
    },
    {
      "span": {
        "start": 4151,
        "end": 4156
      },
      "text": "བཀུར་ ༼སྣར། པེ།༽ སྐུར་"
    },
    {
      "span": {
        "start": 4388,
        "end": 4398
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 4425,
        "end": 4431
      },
      "text": "མགྲོན་ ༼སྣར། པེ།༽ མགོན་"
    },
    {
      "span": {
        "start": 4643,
        "end": 4650
      },
      "text": "ལས་ཀྱི་ ༼སྣར།༽ ལས་ཀྱིས་"
    },
    {
      "span": {
        "start": 4851,
        "end": 4856
      },
      "text": "ལྟ་བ་ ༼སྣར།༽ བལྟ་བ་"
    },
    {
      "span": {
        "start": 4960,
        "end": 4965
      },
      "text": "སྤང་། ༼སྣར། པེ།༽ སྤོངས།"
    },
    {
      "span": {
        "start": 5263,
        "end": 5268
      },
      "text": "དགྲར་ ༼སྣར། པེ།༽ དགྲ་"
    },
    {
      "span": {
        "start": 5298,
        "end": 5306
      },
      "text": "ཐབ་བརྙས་ ༼སྣར། པེ།༽ འཐབ་པ་སྙད་"
    },
    {
      "span": {
        "start": 5566,
        "end": 5573
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 5602,
        "end": 5608
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 5660,
        "end": 5664
      },
      "text": "འཚག་ ༼སྣར། པེ།༽ མཚར་"
    },
    {
      "span": {
        "start": 5698,
        "end": 5706
      },
      "text": "རིག་པའི་ ༼སྣར། པེ།༽ རིགས་པའི་"
    },
    {
      "span": {
        "start": 5734,
        "end": 5741
      },
      "text": "མཚན་མོ་ ༼སྣར། པེ།༽ མཚན་མོའི་"
    },
    {
      "span": {
        "start": 5900,
        "end": 5906
      },
      "text": "བསྒོམ་ ༼སྣར། པེ།༽ སྒོམས་"
    },
    {
      "span": {
        "start": 6131,
        "end": 6135
      },
      "text": "ཐོབ། ༼སྣར། པེ།༽ འཐོབ།"
    },
    {
      "span": {
        "start": 6188,
        "end": 6192
      },
      "text": "བཞི་ ༼སྣར། པེ།༽ གཞི་"
    },
    {
      "span": {
        "start": 6289,
        "end": 6293
      },
      "text": "འགས་ ༼སྣར། པེ།༽ འགའ་"
    },
    {
      "span": {
        "start": 6314,
        "end": 6321
      },
      "text": "བསྒྱུར་ ༼ཅོ། སྡེ།༽ བསྐྱུར་"
    },
    {
      "span": {
        "start": 6397,
        "end": 6405
      },
      "text": "རྩ་བ་ཡང་ ༼སྣར། པེ།༽ རྩ་བ་ཡངས་"
    },
    {
      "span": {
        "start": 6535,
        "end": 6541
      },
      "text": "འཕྲོག་ ༼ཅོ།༽ འཕྲོགས་"
    },
    {
      "span": {
        "start": 6561,
        "end": 6570
      },
      "text": "མཁྱེན་པར་ ༼སྣར། པེ།༽ རིགས་པར་"
    },
    {
      "span": {
        "start": 7086,
        "end": 7090
      },
      "text": "བཞག་ ༼སྣར། པེ།༽ གཞག་"
    },
    {
      "span": {
        "start": 7127,
        "end": 7136
      },
      "text": "ཕུང་ཁྲོལ་ ༼སྣར། པེ།༽ འཕུང་བཀྲོལ་"
    },
    {
      "span": {
        "start": 7163,
        "end": 7172
      },
      "text": "གསུངས་ཏེ་ ༼སྣར། པེ།༽ གསུང་སྟེ་"
    },
    {
      "span": {
        "start": 7183,
        "end": 7189
      },
      "text": "དང་མི་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 7189,
        "end": 7193
      },
      "text": "ལྡན་ ༼སྣར། པེ།༽ ལྡན་མིན་"
    },
    {
      "span": {
        "start": 7409,
        "end": 7414
      },
      "text": "སྲེད་ ༼སྣར། པེ།༽ སྲད་"
    },
    {
      "span": {
        "start": 7591,
        "end": 7595
      },
      "text": "བདག་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 7678,
        "end": 7688
      },
      "text": "ལྡན་པ་ཡིས། ༼སྣར། པེ།༽ ལྡན་པ་ཡི།"
    },
    {
      "span": {
        "start": 7821,
        "end": 7829
      },
      "text": "ལྷག་ཅིག་ ༼སྣར། པེ།༽ ལྷག་གཅིག་"
    },
    {
      "span": {
        "start": 7883,
        "end": 7888
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ གཏོགས་"
    },
    {
      "span": {
        "start": 8114,
        "end": 8124
      },
      "text": "གཉིད་ཀྱིས་ ༼སྣར། པེ།༽ གཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 8192,
        "end": 8198
      },
      "text": "འདྲུལ་ ༼སྣར། པེ།༽ འབྲུལ་"
    },
    {
      "span": {
        "start": 8354,
        "end": 8361
      },
      "text": "བསྲེགས་ ༼སྣར། པེ།༽ སྲེགས་"
    },
    {
      "span": {
        "start": 8386,
        "end": 8391
      },
      "text": "ཐལ་བ་ ༼སྣར། པེ།༽ ཐལ་བར་"
    },
    {
      "span": {
        "start": 8553,
        "end": 8556
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 8566,
        "end": 8575
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 8792,
        "end": 8801
      },
      "text": "འཕྱགས་པར་ ༼སྣར། པེ།༽ འཆག་པར་"
    },
    {
      "span": {
        "start": 8956,
        "end": 8964
      },
      "text": "བདག་ཉིད་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 8991,
        "end": 8997
      },
      "text": "བགྱིད། ༼སྡེ། ཅོ།༽ བགྱིས།"
    },
    {
      "span": {
        "start": 9052,
        "end": 9060
      },
      "text": "བསྟེན་པ་ ༼སྣར། པེ།༽ བརྟེན་པར་"
    },
    {
      "span": {
        "start": 9083,
        "end": 9091
      },
      "text": "རྫོགས་པ་ ༼སྣར། པེ།༽ རྫོགས་པར་"
    },
    {
      "span": {
        "start": 9130,
        "end": 9136
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 9281,
        "end": 9289
      },
      "text": "འཁོབ་ཏུ། ༼སྣར། པེ།༽ ཁོབ་དུ།"
    },
    {
      "span": {
        "start": 9350,
        "end": 9357
      },
      "text": "རུང་བར་ ༼སྣར། པེ།༽ རུང་བ་"
    },
    {
      "span": {
        "start": 9695,
        "end": 9702
      },
      "text": "མཆི་བས་ ༼སྣར། པེ།༽ མཆིས་པས་"
    },
    {
      "span": {
        "start": 9956,
        "end": 9961
      },
      "text": "མ་ཡི་ ༼སྣར། པེ།༽ མ་མི་"
    },
    {
      "span": {
        "start": 9977,
        "end": 9983
      },
      "text": "ཚི་གུ་ ༼སྣར། པེ།༽ ཚིག་གུ་"
    },
    {
      "span": {
        "start": 9988,
        "end": 9995
      },
      "text": "རི་ལུར་ ༼སྣར། པེ།༽ རི་ལུས་"
    },
    {
      "span": {
        "start": 10059,
        "end": 10065
      },
      "text": "ནས་ནི། ༼སྣར། པེ།༽ ནས་ཀྱང་།"
    },
    {
      "span": {
        "start": 10129,
        "end": 10134
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 10272,
        "end": 10288
      },
      "text": "འཁྲུལ་འཁོར་གྱིས། ༼སྣར། པེ།༽ འཁྲུལ་འཁོར་གྱི།"
    },
    {
      "span": {
        "start": 10410,
        "end": 10417
      },
      "text": "རོ་མྱག་ ༼སྣར། པེ།༽ རོ་མྱགས་"
    },
    {
      "span": {
        "start": 10477,
        "end": 10484
      },
      "text": "བུ་མོས་ ༼སྣར། པེ།༽ བུ་མོ་"
    },
    {
      "span": {
        "start": 10616,
        "end": 10624
      },
      "text": "དལ་གྱིས་ ༼སྣར། པེ།༽ དལ་གྱི་"
    },
    {
      "span": {
        "start": 10670,
        "end": 10680
      },
      "text": "ལྷན་བཞུགས་ ༼སྣར། པེ།༽ ལྡན་ཞུགས་"
    },
    {
      "span": {
        "start": 10848,
        "end": 10858
      },
      "text": "གྱུར་པ་ཡི། ༼སྣར། པེ།༽ གྱུར་པ་ཡིས།"
    },
    {
      "span": {
        "start": 11139,
        "end": 11144
      },
      "text": "བརྫི་ ༼སྣར། པེ།༽ རྫི་"
    },
    {
      "span": {
        "start": 11499,
        "end": 11505
      },
      "text": "བཞུ་བ་ ༼སྣར། པེ།༽ བཞུས་པ་"
    },
    {
      "span": {
        "start": 11530,
        "end": 11535
      },
      "text": "ལྡུད་ ༼སྣར། པེ།༽ ལྷུད་"
    },
    {
      "span": {
        "start": 11572,
        "end": 11578
      },
      "text": "འབར་བ། ༼སྣར། པེ།༽ འབར་བའི།"
    },
    {
      "span": {
        "start": 11727,
        "end": 11737
      },
      "text": "སེན་མོ་མི་ ༼སྣར། པེ།༽ སེན་མོ་"
    },
    {
      "span": {
        "start": 11805,
        "end": 11822
      },
      "text": "སྦྲང་བུ་མཆུ་རིངས་ ༼སྣར། པེ།༽ སྦྲང་མ་ནག་པོ་"
    },
    {
      "span": {
        "start": 11850,
        "end": 11859
      },
      "text": "སྲོལ་ཆེར་ ༼སྣར། པེ།༽ སོལ་ཆར་"
    },
    {
      "span": {
        "start": 11918,
        "end": 11925
      },
      "text": "མདག་མེ་ ༼སྣར། པེ།༽ མདག་མ་"
    },
    {
      "span": {
        "start": 11965,
        "end": 11971
      },
      "text": "བསྲེག་ ༼སྣར། པེ།༽ སྲེགས་"
    },
    {
      "span": {
        "start": 11976,
        "end": 11981
      },
      "text": "བགྲད། ༼སྣར། པེ།༽ དགྲད།"
    },
    {
      "span": {
        "start": 12039,
        "end": 12048
      },
      "text": "ཅུང་འཕེད་ ༼སྣར། པེ།༽ ཅུང་པེང་"
    },
    {
      "span": {
        "start": 12083,
        "end": 12090
      },
      "text": "འགགས་པ་ ༼སྣར། པེ།༽ འགག་པ་"
    },
    {
      "span": {
        "start": 12178,
        "end": 12183
      },
      "text": "འཇིག་ ༼སྣར། པེ།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 12388,
        "end": 12395
      },
      "text": "ཟད་པ། ། ༼སྣར། པེ།༽ ཟད་པའི་"
    },
    {
      "span": {
        "start": 12399,
        "end": 12403
      },
      "text": "བའི་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 12579,
        "end": 12583
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 12629,
        "end": 12635
      },
      "text": "བགྱིད་ ༼སྣར། པེ།༽ བགྱི་"
    },
    {
      "span": {
        "start": 12677,
        "end": 12684
      },
      "text": "མི་བཟད་ ༼སྣར། པེ།༽ མི་ཟད་"
    },
    {
      "span": {
        "start": 12773,
        "end": 12780
      },
      "text": "འབལ་བར་ ༼སྣར། པེ།༽ བྲལ་བར་"
    },
    {
      "span": {
        "start": 12839,
        "end": 12847
      },
      "text": "ཡིད་ཀྱི་ ༼སྣར། པེ།༽ ཡིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 12987,
        "end": 12993
      },
      "text": "བརྡེག་ ༼སྣར། པེ།༽ རྡེག་"
    },
    {
      "span": {
        "start": 13111,
        "end": 13117
      },
      "text": "དང་། ། ༼སྣར། པེ།༽ ཁྲག །"
    },
    {
      "span": {
        "start": 13202,
        "end": 13211
      },
      "text": "འདེབས་པས་ ༼སྣར། པེ།༽ བཏབ་པས་"
    },
    {
      "span": {
        "start": 13246,
        "end": 13257
      },
      "text": "ཕོངས་པ་ཡིས། ༼སྣར། པེ།༽ ཕོངས་པ་ཡི།"
    },
    {
      "span": {
        "start": 13531,
        "end": 13543
      },
      "text": "གཅེར་བུ་སྟེ། ༼སྣར། པེ།༽ གཅེར་བུ་ཡི།"
    },
    {
      "span": {
        "start": 13588,
        "end": 13597
      },
      "text": "ཞིང་ཁ་ནས་ ༼སྣར། པེ།༽ ཞིང་ཁ་ན་"
    },
    {
      "span": {
        "start": 13912,
        "end": 13920
      },
      "text": "བསྐམ་པར་ ༼སྣར། པེ།༽ བསྐམས་པར་"
    },
    {
      "span": {
        "start": 14211,
        "end": 14217
      },
      "text": "གསུངས། ༼སྣར། པེ།༽ གསུང་།"
    },
    {
      "span": {
        "start": 14458,
        "end": 14461
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 14497,
        "end": 14502
      },
      "text": "བགྱི་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 14528,
        "end": 14538
      },
      "text": "བགྱིད་འཆི་ ༼སྣར། པེ།༽ བྱེད་ལྔ་"
    },
    {
      "span": {
        "start": 14899,
        "end": 14908
      },
      "text": "སྒྲིབ་པས་ ༼སྣར།༽ བསྒྲིབས་པས་"
    },
    {
      "span": {
        "start": 14967,
        "end": 14981
      },
      "text": "དམྱལ་བ་ཡི་དགས་ ༼སྣར། པེ།༽ དམྱལ་བ་"
    },
    {
      "span": {
        "start": 14985,
        "end": 14990
      },
      "text": "འགྲོ་ ༼སྣར། པེ།༽ འགྲོ་ཡི་དྭགས་"
    },
    {
      "span": {
        "start": 15108,
        "end": 15120
      },
      "text": "དེ་དག་བཟློག་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 15120,
        "end": 15125
      },
      "text": "ཕྱིར་ ༼སྣར། པེ།༽ ཕྱིར་བཟློག་"
    },
    {
      "span": {
        "start": 15183,
        "end": 15186
      },
      "text": "དེ་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 15231,
        "end": 15242
      },
      "text": "དང་བསམ་གཏན་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 15246,
        "end": 15254
      },
      "text": "རབ་ཀྱིས། ༼སྣར། པེ།༽ རབ་བསམ་གཏན་གྱིས།"
    },
    {
      "span": {
        "start": 15299,
        "end": 15302
      },
      "text": "རྒ་ ༼སྣར། པེ།༽ རྒས་"
    },
    {
      "span": {
        "start": 15757,
        "end": 15764
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 15883,
        "end": 15892
      },
      "text": "དེ་ལས་ནི། ༼སྣར། པེ།༽ དེ་དག་ལས།"
    },
    {
      "span": {
        "start": 16319,
        "end": 16330
      },
      "text": "མཐོང་བ་དེས། ༼སྣར། པེ།༽ མཐོང་བ་སྟེ།"
    },
    {
      "span": {
        "start": 16348,
        "end": 16355
      },
      "text": "རིག་པས་ ༼སྣར། པེ།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 16411,
        "end": 16420
      },
      "text": "ཏིང་འཛིན་ ༼སྣར། པེ།༽ ཏིང་ངེ་འཛིན་"
    },
    {
      "span": {
        "start": 16420,
        "end": 16426
      },
      "text": "དག་དང་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 16429,
        "end": 16437
      },
      "text": "མཐའ་དག ་ ༼སྣར། པེ།༽ མཐའ་དགདང་"
    },
    {
      "span": {
        "start": 16504,
        "end": 16509
      },
      "text": "བགྱི། ༼སྣར། པེ།༽ བགྱིད།"
    },
    {
      "span": {
        "start": 16556,
        "end": 16559
      },
      "text": "དེ་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 16608,
        "end": 16614
      },
      "text": "ཏེ་དེ། ༼སྣར། པེ།༽ ཏེ་ལམ།"
    },
    {
      "span": {
        "start": 16616,
        "end": 16627
      },
      "text": "འཐོབ་བགྱིད་ ༼སྣར། པེ།༽ དེ་ཐོབ་"
    },
    {
      "span": {
        "start": 16792,
        "end": 16797
      },
      "text": "བརྒལ་ ༼སྣར། པེ།༽ རྒལ་"
    },
    {
      "span": {
        "start": 16818,
        "end": 16826
      },
      "text": "བགྱིས་པ་ ༼སྣར། པེ།༽ བགྱིད་པ་"
    },
    {
      "span": {
        "start": 16839,
        "end": 16843
      },
      "text": "གནམ་ ༼སྣར། པེ།༽ གནས་"
    },
    {
      "span": {
        "start": 16874,
        "end": 16881
      },
      "text": "རུམ་ལས་ ༼སྣར། པེ།༽ རུམ་ནས་"
    },
    {
      "span": {
        "start": 17167,
        "end": 17169
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 17206,
        "end": 17214
      },
      "text": "བསྟན་པས་ ༼སྣར། པེ།༽ བསྟེན་པས་"
    },
    {
      "span": {
        "start": 17269,
        "end": 17277
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར། པེ།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 17808,
        "end": 17816
      },
      "text": "བདེ་དགས་ ༼སྣར། པེ།༽ བདེ་དགའ་"
    },
    {
      "span": {
        "start": 17925,
        "end": 17929
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 18039,
        "end": 18049
      },
      "text": "སྤྲིང་ཡིག་ ༼སྣར། པེ།༽ ཕྲིན་ཡིག་"
    },
    {
      "span": {
        "start": 18110,
        "end": 18118
      },
      "text": "བསྐུར་བ་ ༼སྣར། པེ།༽ བཀུར་བ་"
    },
    {
      "span": {
        "start": 18195,
        "end": 18202
      },
      "text": "བརྩེགས་ ༼སྣར། པེ།༽ རྩེགས་"
    }
  ]
}