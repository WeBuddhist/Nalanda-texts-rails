{
  "durchens": [
    {
      "span": {
        "start": 450,
        "end": 455
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 693,
        "end": 703
      },
      "text": "ཚོགས་རྣམས་ ༼སྣར། པེ།༽ ཚོགས་"
    },
    {
      "span": {
        "start": 715,
        "end": 725
      },
      "text": "ཚོགས་རྣམས་ ༼སྣར། པེ།༽ ཚོགས་"
    },
    {
      "span": {
        "start": 738,
        "end": 748
      },
      "text": "ཚོགས་རྣམས་ ༼སྣར། པེ།༽ ཚོགས་"
    },
    {
      "span": {
        "start": 929,
        "end": 936
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 1313,
        "end": 1320
      },
      "text": "དབང་པོ་ ༼སྣར། པེ།༽ དབང་པོའི་"
    },
    {
      "span": {
        "start": 1785,
        "end": 1793
      },
      "text": "ལྟོས་པར་ ༼སྣར། པེ།༽ བལྟོས་པར་"
    },
    {
      "span": {
        "start": 1847,
        "end": 1856
      },
      "text": "རྟོག་པའི་ ༼སྣར། པེ།༽ རྟོགས་པའི་"
    },
    {
      "span": {
        "start": 2251,
        "end": 2258
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་པར་བྱེད་"
    },
    {
      "span": {
        "start": 2271,
        "end": 2281
      },
      "text": "སྒྲུབ་པའི་ ༼སྣར། པེ།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 2927,
        "end": 2934
      },
      "text": "གང་གིས་ ༼སྣར།༽ གང་གི་"
    },
    {
      "span": {
        "start": 3398,
        "end": 3405
      },
      "text": "ནི་མིང་ ༼སྣར།༽ ནི་མིའི་"
    },
    {
      "span": {
        "start": 3473,
        "end": 3481
      },
      "text": "མིང་གིས་ ༼སྣར།༽ མིང་གི་"
    },
    {
      "span": {
        "start": 3579,
        "end": 3585
      },
      "text": "འདོགས་ ༼སྣར།༽ འདོག་"
    },
    {
      "span": {
        "start": 3893,
        "end": 3901
      },
      "text": "མིང་གིས་ ༼སྣར། པེ།༽ མིང་གི་"
    },
    {
      "span": {
        "start": 4027,
        "end": 4041
      },
      "text": "བླ་དགས་ཀྱི་ལམ་ ༼སྣར། པེ།༽ བླ་དགས་"
    },
    {
      "span": {
        "start": 4423,
        "end": 4430
      },
      "text": "ངེས་པར་ ༼སྣར།༽ ངེས་"
    },
    {
      "span": {
        "start": 4732,
        "end": 4738
      },
      "text": "ངག་ནི་ ༼སྣར། པེ།༽ ངག་གི་"
    },
    {
      "span": {
        "start": 5228,
        "end": 5235
      },
      "text": "རྟེན་པ་ ༼པེ།༽ བརྟེན་པ་"
    },
    {
      "span": {
        "start": 5302,
        "end": 5305
      },
      "text": "མི་ ༼སྣར། པེ།༽ མ་"
    },
    {
      "span": {
        "start": 5568,
        "end": 5578
      },
      "text": "ཚོགས་རྣམས་ ༼སྣར། པེ།༽ ཚོགས་"
    },
    {
      "span": {
        "start": 5946,
        "end": 5965
      },
      "text": "དང་དོན་དང་ལྡན་པ་དང་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 6522,
        "end": 6531
      },
      "text": "བཤད་པ་ནི་ ༼སྣར།༽ བཤད་པ་"
    },
    {
      "span": {
        "start": 6837,
        "end": 6848
      },
      "text": "དབྱེ་བས་ནི་ ༼སྣར། པེ།༽ དབྱེ་བས་"
    },
    {
      "span": {
        "start": 7011,
        "end": 7019
      },
      "text": "འདའ་བའི་ ༼སྣར། པེ།༽ འདས་པའི་"
    },
    {
      "span": {
        "start": 7101,
        "end": 7115
      },
      "text": "དང་ཞུགས་པ་དང་། ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 7478,
        "end": 7484
      },
      "text": "བསྡུས་ ༼སྣར། པེ།༽ བསྡུས་པས་"
    },
    {
      "span": {
        "start": 8075,
        "end": 8085
      },
      "text": "མདོར་བསྡུ་ ༼སྣར། པེ།༽ མདོར་བསྡུས་"
    },
    {
      "span": {
        "start": 8198,
        "end": 8204
      },
      "text": "བྱས་ན་ ༼སྣར། པེ།༽ བྱ་ན་"
    },
    {
      "span": {
        "start": 8265,
        "end": 8277
      },
      "text": "མེད་པའི་སའི་ ༼སྣར། པེ།༽ མེད་པའི་"
    },
    {
      "span": {
        "start": 8324,
        "end": 8330
      },
      "text": "རྣམ་པ་ ༼སྣར།༽ རྣམ་"
    },
    {
      "span": {
        "start": 8407,
        "end": 8414
      },
      "text": "རྒྱུའི་ ༼སྣར།༽ སྒྱུའི་"
    },
    {
      "span": {
        "start": 8450,
        "end": 8459
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 8725,
        "end": 8732
      },
      "text": "སར་སྔར་ ༼ཅོ།༽ སར་ ༼སྣར།༽ སར་སྔ་"
    },
    {
      "span": {
        "start": 9172,
        "end": 9179
      },
      "text": "སར་སྔར་ ༼སྣར། པེ།༽ སར་"
    },
    {
      "span": {
        "start": 9285,
        "end": 9290
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམས་རྣམ་པར་"
    },
    {
      "span": {
        "start": 9691,
        "end": 9698
      },
      "text": "ལྔ་པའོ། ༼སྣར།༽ ལྔའོ།"
    },
    {
      "span": {
        "start": 10432,
        "end": 10439
      },
      "text": "དེ་ལྟར་ ༼སྣར།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 10667,
        "end": 10673
      },
      "text": "གཞིའི་ ༼སྣར།༽ བཞིའི་"
    },
    {
      "span": {
        "start": 11480,
        "end": 11488
      },
      "text": "བཟློག་པ་ ༼སྣར། པེ།༽ ཟློག་པ་"
    },
    {
      "span": {
        "start": 11552,
        "end": 11558
      },
      "text": "གཟེངས་ ༼སྣར། པེ།༽ གཟིང་"
    },
    {
      "span": {
        "start": 11706,
        "end": 11708
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 11725,
        "end": 11727
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 12236,
        "end": 12242
      },
      "text": "ཁོ་ནར་ ༼སྣར། པེ།༽ ཁོ་ན་"
    },
    {
      "span": {
        "start": 12329,
        "end": 12338
      },
      "text": "འདས་པ་ནས་ ༼སྣར། པེ།༽ འདས་པ་ནི་"
    },
    {
      "span": {
        "start": 12356,
        "end": 12363
      },
      "text": "བཅས་པས་ ༼སྣར། པེ།༽ བཅས་པ་"
    },
    {
      "span": {
        "start": 12995,
        "end": 12999
      },
      "text": "ནམས་ ༼སྣར། པེ།༽ ཉམས་"
    },
    {
      "span": {
        "start": 13103,
        "end": 13112
      },
      "text": "ཆོས་ཀྱིས་ ༼སྣར།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 13392,
        "end": 13403
      },
      "text": "སྤྱོད་པ་ནི་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 14459,
        "end": 14461
      },
      "text": "ས་ ༼སྣར། པེ།༽ སའི་"
    },
    {
      "span": {
        "start": 14572,
        "end": 14574
      },
      "text": "ས་ ༼སྣར། པེ།༽ སའི་"
    },
    {
      "span": {
        "start": 14761,
        "end": 14771
      },
      "text": "སྒྲུབ་པ་ལ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 15233,
        "end": 15240
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 15362,
        "end": 15371
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 15422,
        "end": 15431
      },
      "text": "བགྱི་ཞེས་ ༼སྣར། པེ།༽ བགྱི་"
    },
    {
      "span": {
        "start": 15439,
        "end": 15460
      },
      "text": "ཁྱོད་ཀྱིས་འདི་ལྟ་འདི་ ༼སྣར།༽ ཁྱོད་ཀྱི་འདི་ ༼པེ།༽ ཁྱོད་ཀྱིས་འདི་"
    },
    {
      "span": {
        "start": 15464,
        "end": 15471
      },
      "text": "སྒྲུབས་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 15531,
        "end": 15537
      },
      "text": "གཟེངས་ ༼སྣར། པེ།༽ གཟེང་"
    },
    {
      "span": {
        "start": 15599,
        "end": 15604
      },
      "text": "ཚེ་ན་ ༼སྣར། པེ།༽ ཚེ་"
    },
    {
      "span": {
        "start": 15764,
        "end": 15772
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 15910,
        "end": 15919
      },
      "text": "བྱེད་ཅིག་ ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 15946,
        "end": 15951
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 16121,
        "end": 16126
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 16265,
        "end": 16273
      },
      "text": "སྟོན་པར་ ༼སྣར། པེ།༽ སྟོན་པར་ཡང་"
    },
    {
      "span": {
        "start": 16285,
        "end": 16290
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 16290,
        "end": 16293
      },
      "text": "པར་ ༼སྣར། པེ།༽ པར་ཡང་"
    },
    {
      "span": {
        "start": 16355,
        "end": 16360
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 16421,
        "end": 16432
      },
      "text": "གཟེངས་སྟོད་ ༼སྣར། པེ།༽ གཟེང་བསྟོད་"
    },
    {
      "span": {
        "start": 16911,
        "end": 16920
      },
      "text": "གང་དང་གང་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 17211,
        "end": 17220
      },
      "text": "སྒྲུབ་པར་ ༼སྣར། པེ།༽ བསྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 18230,
        "end": 18238
      },
      "text": "འདའ་བའི་ ༼སྣར། པེ།༽ འདས་པའི་"
    },
    {
      "span": {
        "start": 18325,
        "end": 18334
      },
      "text": "གཞན་གྱིས་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 18374,
        "end": 18383
      },
      "text": "གཞན་གྱིས་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 18448,
        "end": 18463
      },
      "text": "བཅུ་གཉིས་པོ་དེ་ ༼སྣར། པེ།༽ བཅུ་གཉིས་པོ་"
    },
    {
      "span": {
        "start": 19849,
        "end": 19855
      },
      "text": "ལས་སོ། ༼སྣར། པེ།༽ ལས་ཏེ།"
    },
    {
      "span": {
        "start": 19911,
        "end": 19945
      },
      "text": "ཆོས་སྟོན་པ་ཡང་བྱེད་རྒྱས་པར་སྟོན་པ་ ༼སྣར། པེ།༽ ཆོས་སྟོན་པར་"
    },
    {
      "span": {
        "start": 20042,
        "end": 20052
      },
      "text": "མདོའི་སྡེ་ ༼སྣར། པེ།༽ མདོ་སྡེ་"
    },
    {
      "span": {
        "start": 20144,
        "end": 20152
      },
      "text": "ཚིག་འདི་ ༼སྣར། པེ།༽ ཚིག་འབྲུ་"
    },
    {
      "span": {
        "start": 20316,
        "end": 20326
      },
      "text": "ནི་རེ་ཞིག་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 20456,
        "end": 20463
      },
      "text": "དོན་དུ་ ༼སྣར། པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 20878,
        "end": 20888
      },
      "text": "མདོའི་སྡེ་ ༼སྣར། པེ།༽ མདོ་སྡེ་"
    },
    {
      "span": {
        "start": 21131,
        "end": 21142
      },
      "text": "པའི་སྡེ་ནི་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 21202,
        "end": 21213
      },
      "text": "ཉན་ཐོས་ཀྱི་ ༼སྣར། པེ།༽ ཉན་ཐོས་"
    },
    {
      "span": {
        "start": 21442,
        "end": 21451
      },
      "text": "བརྟེན་པར་ ༼སྣར།༽ བརྟེན་པ་"
    },
    {
      "span": {
        "start": 21641,
        "end": 21649
      },
      "text": "བརྗོད་པ་ ༼སྣར། པེ།༽ བརྗོད་པས་"
    },
    {
      "span": {
        "start": 21656,
        "end": 21669
      },
      "text": "བརྗོད་པར་མཛད་ ༼སྣར། པེ།༽ བརྗོད་"
    },
    {
      "span": {
        "start": 22100,
        "end": 22103
      },
      "text": "དེ་ ༼སྣར།༽ ནི་"
    },
    {
      "span": {
        "start": 22676,
        "end": 22682
      },
      "text": "དེ་དེ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 23025,
        "end": 23032
      },
      "text": "དབབ་པར་ ༼སྣར། པེ།༽ བབ་པར་"
    },
    {
      "span": {
        "start": 23032,
        "end": 23045
      },
      "text": "བསྟན་པའི་སྡེ་ ༼སྣར། པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 23222,
        "end": 23230
      },
      "text": "མཐོང་བས་ ༼སྣར། པེ།༽ མཐོང་བ་"
    },
    {
      "span": {
        "start": 23411,
        "end": 23418
      },
      "text": "རྣམ་པར་ ༼སྣར། པེ།༽ རྣམ་པ་"
    },
    {
      "span": {
        "start": 23424,
        "end": 23433
      },
      "text": "ཡང་དག་པར་ ༼སྣར། པེ།༽ ཡང་"
    },
    {
      "span": {
        "start": 23511,
        "end": 23521
      },
      "text": "མདོའི་སྡེ་ ༼སྣར། པེ།༽ མདོ་སྡེ་"
    },
    {
      "span": {
        "start": 23789,
        "end": 23796
      },
      "text": "དབབ་པར་ ༼སྣར། པེ།༽ བབ་པར་"
    },
    {
      "span": {
        "start": 23903,
        "end": 23911
      },
      "text": "རིགས་པར་ ༼སྣར།༽ རིག་པར་"
    },
    {
      "span": {
        "start": 24053,
        "end": 24063
      },
      "text": "དགའ་བར་བྱ་ ༼སྣར། པེ།༽ དགའ་"
    },
    {
      "span": {
        "start": 24355,
        "end": 24360
      },
      "text": "ད་ཡང་ ༼སྣར། པེ།༽ ད་"
    },
    {
      "span": {
        "start": 24432,
        "end": 24451
      },
      "text": "། ཡང་དག་པར་བསྒྲུབས་ ༼སྣར། པེ།༽ ཡང་དག་པ་སྒྲུབ་"
    },
    {
      "span": {
        "start": 24475,
        "end": 24487
      },
      "text": "བསྒྲུབས་པའི་ ༼སྣར། པེ།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 24835,
        "end": 24842
      },
      "text": "བལྟ་བར་ ༼སྣར། པེ།༽ ལྟ་བར་"
    },
    {
      "span": {
        "start": 25558,
        "end": 25582
      },
      "text": "། འབྲིང་གི་གནས་སྐབས་དང་། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 25703,
        "end": 25707
      },
      "text": "དང་། ༼པེ།༽ དང་། མི་"
    },
    {
      "span": {
        "start": 25809,
        "end": 25818
      },
      "text": "བསམས་པའི་ ༼སྣར།༽ བསམ་པའི་"
    },
    {
      "span": {
        "start": 26352,
        "end": 26355
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 27085,
        "end": 27093
      },
      "text": "མཐུན་པར་ ༼སྣར། པེ།༽ མཐུན་པས་"
    },
    {
      "span": {
        "start": 27291,
        "end": 27298
      },
      "text": "ཞིག་གི་ ༼སྣར། པེ།༽ མོ་ཞིག་གིས་ནི་"
    },
    {
      "span": {
        "start": 27469,
        "end": 27473
      },
      "text": "པའི་ ༼སྣར། པེ།༽ པར་བྱ་བའི་"
    },
    {
      "span": {
        "start": 27510,
        "end": 27521
      },
      "text": "ཚུལ་དང་ཚུལ་ ༼སྣར། པེ།༽ ཚུལ་"
    },
    {
      "span": {
        "start": 27636,
        "end": 27642
      },
      "text": "ཚོལ་བ་ ༼སྣར། པེ།༽ ཚུལ་བ་"
    },
    {
      "span": {
        "start": 27685,
        "end": 27688
      },
      "text": "ལན་ ༼སྣར།༽ ལན་པ་"
    },
    {
      "span": {
        "start": 28172,
        "end": 28189
      },
      "text": "གྲུབ་པའི་ཕྱིར་ཡང་ ༼སྣར། པེ།༽ གྲུབ་པའི་ཕྱིར་"
    },
    {
      "span": {
        "start": 28198,
        "end": 28201
      },
      "text": "ཏུ་ ༼སྣར། པེ།༽ ཏུ་ཡང་"
    },
    {
      "span": {
        "start": 28490,
        "end": 28505
      },
      "text": "མཆོག་ཏུ་ཤིན་ཏུ་ ༼སྣར། པེ།༽ མཆོག་ཏུ་"
    },
    {
      "span": {
        "start": 28587,
        "end": 28596
      },
      "text": "གཞོན་ནུར་ ༼སྣར།༽ གཞོན་ནུ་"
    },
    {
      "span": {
        "start": 28635,
        "end": 28656
      },
      "text": "ངའི་གནས་ཁང་བཟངས་རྩིག་ ༼སྣར། པེ།༽ གནས་ཁང་བཟང་བ་བརྩིག་"
    },
    {
      "span": {
        "start": 28709,
        "end": 28718
      },
      "text": "གཞོན་ནུར་ ༼སྣར། པེ།༽ གཞོན་ནུ་"
    },
    {
      "span": {
        "start": 28939,
        "end": 28951
      },
      "text": "སྡུག་བསྔལ་བ་ ༼སྣར། པེ།༽ སྡུག་བསྔལ་"
    },
    {
      "span": {
        "start": 29066,
        "end": 29069
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེར་"
    },
    {
      "span": {
        "start": 29095,
        "end": 29105
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 29365,
        "end": 29416
      },
      "text": "ལ་ལན་འགའ་ནི་ཚིག་ཕྱི་མ་ཚིག་སྔ་མའི་བསྒྲུབ་པ་ཡིན་ནོ། ། ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 29638,
        "end": 29644
      },
      "text": "ཇི་ལྟ་ ༼སྣར། པེ།༽ ཇི་སྐད་"
    },
    {
      "span": {
        "start": 29854,
        "end": 29861
      },
      "text": "དྲན་པས་ ༼སྣར། པེ།༽ དྲན་པ་"
    },
    {
      "span": {
        "start": 30162,
        "end": 30168
      },
      "text": "སུ་དད་ ༼སྣར། པེ།༽ སུ་"
    },
    {
      "span": {
        "start": 30398,
        "end": 30406
      },
      "text": "སྒུལ་བར་ ༼སྣར།༽ བརྒུལ་ ༼པེ།༽ བསྒུལ་བར་"
    },
    {
      "span": {
        "start": 30409,
        "end": 30417
      },
      "text": "བྱེད་དེ། ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 30448,
        "end": 30457
      },
      "text": "སྐྱོད་པར་ ༼སྣར། པེ།༽ བསྐྱོད་པར་"
    },
    {
      "span": {
        "start": 30470,
        "end": 30479
      },
      "text": "སྒྱུར་བར་ ༼སྣར། པེ།༽ བསྒྱུར་བར་"
    },
    {
      "span": {
        "start": 30493,
        "end": 30502
      },
      "text": "སྒྱུར་བར་ ༼སྣར། པེ།༽ བསྒྱུར་བར་"
    },
    {
      "span": {
        "start": 30514,
        "end": 30523
      },
      "text": "སྒྱུར་བར་ ༼སྣར། པེ།༽ བསྒྱུར་བར་"
    },
    {
      "span": {
        "start": 30851,
        "end": 30855
      },
      "text": "ཡིད་ ༼སྣར། པེ།༽ ཡིད་ལ་"
    },
    {
      "span": {
        "start": 30988,
        "end": 30996
      },
      "text": "བརྒལ་ཏམ་ ༼སྣར། པེ།༽ བརྒལ་གཏམ་"
    },
    {
      "span": {
        "start": 31001,
        "end": 31009
      },
      "text": "བརྒལ་ཏམ་ ༼སྣར། པེ།༽ བརྒལ་གཏམ་"
    },
    {
      "span": {
        "start": 31025,
        "end": 31033
      },
      "text": "ནོངས་པར་ ༼སྣར། པེ།༽ ནང་བར་"
    },
    {
      "span": {
        "start": 31538,
        "end": 31568
      },
      "text": "ཚིག་གི་བྱ་བ་དང་ལྡན་པ་དང་། ཚིག་ ༼སྣར། པེ།༽ ཚིག་"
    },
    {
      "span": {
        "start": 31711,
        "end": 31717
      },
      "text": "སྒྲོག་ ༼སྣར། པེ།༽ སྒྲོགས་"
    },
    {
      "span": {
        "start": 31802,
        "end": 31808
      },
      "text": "སྤང་བ་ ༼སྣར། པེ།༽ སྤངས་པ་"
    },
    {
      "span": {
        "start": 31959,
        "end": 31965
      },
      "text": "སྒྲོག་ ༼སྣར། པེ།༽ སྒྲོགས་"
    },
    {
      "span": {
        "start": 32115,
        "end": 32126
      },
      "text": "དབྱངས་ཀྱིས་ ༼སྣར།༽ དབྱངས་ཀྱི་"
    },
    {
      "span": {
        "start": 32213,
        "end": 32224
      },
      "text": "སྡུད་པར་མི་ ༼སྣར། པེ།༽ སྡུད་པར་"
    },
    {
      "span": {
        "start": 32334,
        "end": 32339
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 32400,
        "end": 32414
      },
      "text": "འབྱེད་པར་བྱེད་ ༼སྣར། པེ།༽ འབྱེད་"
    },
    {
      "span": {
        "start": 32514,
        "end": 32516
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 32656,
        "end": 32663
      },
      "text": "སྟོང་པ་ ༼སྣར། པེ།༽ བསྟོད་པ་"
    },
    {
      "span": {
        "start": 32728,
        "end": 32733
      },
      "text": "ཕྱིར་ ༼སྣར། པེ།༽ ཕྱིར་རོ། །"
    },
    {
      "span": {
        "start": 33099,
        "end": 33108
      },
      "text": "སྦྱོར་བར་ ༼སྣར། པེ།༽ སྦྱར་བར་"
    },
    {
      "span": {
        "start": 33221,
        "end": 33229
      },
      "text": "གིས་ཀྱང་ ༼སྣར། པེ།༽ གིས་ནི་"
    },
    {
      "span": {
        "start": 33280,
        "end": 33286
      },
      "text": "ཡང་དེ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 33371,
        "end": 33380
      },
      "text": "བླངས་པའི་ ༼སྣར། པེ།༽ བླང་བའི་"
    },
    {
      "span": {
        "start": 33524,
        "end": 33533
      },
      "text": "སྨྲ་བ་དང་ ༼སྣར། པེ།༽ སྨྲ་བ་"
    },
    {
      "span": {
        "start": 33613,
        "end": 33622
      },
      "text": "སྨྲ་བ་དང་ ༼སྣར། པེ།༽ སྨྲ་བ་"
    },
    {
      "span": {
        "start": 33905,
        "end": 33909
      },
      "text": "མདོ་ ༼སྣར། པེ།༽ མདོའི་"
    },
    {
      "span": {
        "start": 33938,
        "end": 33945
      },
      "text": "རྣམ་པར་ ༼སྣར། པེ།༽ རྣམ་པར་ཤེས་པར་"
    },
    {
      "span": {
        "start": 34063,
        "end": 34069
      },
      "text": "དེ་དག་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 34308,
        "end": 34317
      },
      "text": "འདས་ཀྱིས་ ༼སྣར། པེ།༽ འདས་ཀྱི་"
    },
    {
      "span": {
        "start": 34401,
        "end": 34408
      },
      "text": "གནོན་པ་ ༼སྣར། པེ།༽ གནོད་པ་"
    },
    {
      "span": {
        "start": 34549,
        "end": 34556
      },
      "text": "ལྔས་ཏེ། ༼སྣར། པེ།༽ ལྔ་སྟེ།"
    },
    {
      "span": {
        "start": 34724,
        "end": 34732
      },
      "text": "རྟགས་པར་ ༼སྣར། པེ།༽ རྟོགས་པར་"
    },
    {
      "span": {
        "start": 34794,
        "end": 34801
      },
      "text": "བསམས་པ་ ༼སྣར།༽ བསམ་པ་"
    },
    {
      "span": {
        "start": 34926,
        "end": 34936
      },
      "text": "གཉིས་ཀྱིས་ ༼སྣར།༽ གཉིས་ཀྱི་"
    },
    {
      "span": {
        "start": 35124,
        "end": 35138
      },
      "text": "འདི་དམ་པ་གཅིག་ ༼སྣར། པེ།༽ འདི་བདག་ཅག་"
    },
    {
      "span": {
        "start": 35350,
        "end": 35356
      },
      "text": "ལ་དོན་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 35373,
        "end": 35383
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 35386,
        "end": 35389
      },
      "text": "སོ་ ༼སྣར། པེ།༽ སོར་"
    },
    {
      "span": {
        "start": 35642,
        "end": 35649
      },
      "text": "ཆོས་ནི་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 36158,
        "end": 36167
      },
      "text": "བདུན་གྱི་ ༼སྣར། པེ།༽ བདུན་གྱིས་"
    },
    {
      "span": {
        "start": 36358,
        "end": 36365
      },
      "text": "ཟློག་པ་ ༼སྣར། པེ།༽ བཟློག་པ་"
    },
    {
      "span": {
        "start": 36522,
        "end": 36531
      },
      "text": "སྲེད་པའི་ ༼སྣར། པེ།༽ སྲིད་པའི་"
    },
    {
      "span": {
        "start": 36826,
        "end": 36834
      },
      "text": "ཐོབ་པའི་ ༼སྣར། པེ།༽ ཐོས་པའི་"
    },
    {
      "span": {
        "start": 36869,
        "end": 36878
      },
      "text": "ཆོས་ཀྱིས་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 36898,
        "end": 36907
      },
      "text": "སྒྲུབ་པར་ ༼སྣར། པེ།༽ བསྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 36916,
        "end": 36930
      },
      "text": "བབ་ཅོལ་གྱིས་མ་ ༼སྣར།༽ བབ་ཅོལ་གྱིས་"
    },
    {
      "span": {
        "start": 37534,
        "end": 37543
      },
      "text": "སྣང་བ་ཅན་ ༼སྣར། པེ།༽ སྣང་བ་རྐྱེན་"
    },
    {
      "span": {
        "start": 37594,
        "end": 37602
      },
      "text": "མཐུན་པར་ ༼སྣར། པེ།༽ མཐུན་པ་"
    },
    {
      "span": {
        "start": 38075,
        "end": 38083
      },
      "text": "ཐོབ་པའི་ ༼སྣར། པེ།༽ འཐོབ་པའི་"
    },
    {
      "span": {
        "start": 38507,
        "end": 38513
      },
      "text": "སྨྲ་བ་ ༼སྣར། པེ།༽ སྨྲ་བས་"
    },
    {
      "span": {
        "start": 38869,
        "end": 38881
      },
      "text": "བསྡམས་པ་ཉིད་ ༼སྣར། པེ།༽ བསྡམས་པ་"
    },
    {
      "span": {
        "start": 39246,
        "end": 39249
      },
      "text": "དེ་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 39261,
        "end": 39269
      },
      "text": "འདས་ཀྱི་ ༼སྣར། པེ།༽ འདས་ཀྱིས་"
    },
    {
      "span": {
        "start": 39616,
        "end": 39624
      },
      "text": "འདས་ཀྱི་ ༼སྣར།༽ འདས་ཀྱིས་"
    },
    {
      "span": {
        "start": 39976,
        "end": 39984
      },
      "text": "ཕྱིར་དང་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 39994,
        "end": 40009
      },
      "text": "འབྱོར་པའི་ཕྱིར་ ༼སྣར། པེ།༽ འབྱོར་པའི་"
    },
    {
      "span": {
        "start": 40123,
        "end": 40129
      },
      "text": "ནང་ནས་ ༼སྣར། པེ།༽ ནང་ན་"
    },
    {
      "span": {
        "start": 40532,
        "end": 40542
      },
      "text": "རྟོགས་པའི་ ༼སྣར། པེ།༽ རྟོགས་པའི་དོན་"
    },
    {
      "span": {
        "start": 40703,
        "end": 40710
      },
      "text": "བསྙེངས་ ༼སྣར།༽ སྙེངས་"
    },
    {
      "span": {
        "start": 40962,
        "end": 40969
      },
      "text": "བརྒྱུད་ ༼སྣར། པེ།༽ བརྒྱུ་"
    },
    {
      "span": {
        "start": 41001,
        "end": 41010
      },
      "text": "གྱིས་མནན་ ༼སྣར།༽ གྱི་གནན་"
    },
    {
      "span": {
        "start": 41106,
        "end": 41119
      },
      "text": "མནན་པའི་ཕྱིར་ ༼སྣར། པེ།༽ མནན་པའི་"
    },
    {
      "span": {
        "start": 41279,
        "end": 41282
      },
      "text": "མི་ ༼སྣར། པེ།༽ མི་མཉམ་པ་རྣམས་དང་"
    },
    {
      "span": {
        "start": 41446,
        "end": 41462
      },
      "text": "དྲང་སྲོང་ཆེན་པོ་ ༼སྣར། པེ།༽ དྲང་སྲོང་"
    },
    {
      "span": {
        "start": 41479,
        "end": 41494
      },
      "text": "རྟོགས་པའི་ཕྱིར་ ༼སྣར། པེ།༽ རྟོགས་པའི་"
    },
    {
      "span": {
        "start": 41723,
        "end": 41731
      },
      "text": "སྐྱེ་བོ་ ༼སྣར། པེ།༽ སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 41881,
        "end": 41896
      },
      "text": "རྒལ་བའི་ཕྱིར་ཕ་ ༼སྣར། པེ།༽ རྒལ་བའི་ཕྱི་"
    },
    {
      "span": {
        "start": 42359,
        "end": 42363
      },
      "text": "སྒོ་ ༼སྣར། པེ།༽ སྒོ་བ་"
    },
    {
      "span": {
        "start": 42397,
        "end": 42403
      },
      "text": "དུལ་བ་ ༼སྣར།༽ རྡུལ་བ་"
    },
    {
      "span": {
        "start": 42427,
        "end": 42434
      },
      "text": "བླངས་པ་ ༼སྣར། པེ།༽ སླངས་པ་"
    },
    {
      "span": {
        "start": 42500,
        "end": 42508
      },
      "text": "འབྱིན་པ་ ༼སྣར། པེ།༽ ཕྱིན་པ་"
    },
    {
      "span": {
        "start": 42537,
        "end": 42550
      },
      "text": "ཕྱིར་ཡོངས་སུ་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 42756,
        "end": 42764
      },
      "text": "ལ་རབ་ཏུ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 42948,
        "end": 42961
      },
      "text": "རྣམས་ཡོངས་སུ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 43010,
        "end": 43016
      },
      "text": "དྲལ་བ་ ༼སྣར།༽ བྲལ་བ་"
    },
    {
      "span": {
        "start": 43029,
        "end": 43035
      },
      "text": "རྒལ་བ་ ༼སྣར། པེ།༽ བརྒལ་བ་"
    },
    {
      "span": {
        "start": 43332,
        "end": 43338
      },
      "text": "བརྙེས་ ༼སྣར།༽ བརྙེད་"
    },
    {
      "span": {
        "start": 43339,
        "end": 43358
      },
      "text": "། ཡང་དག་པའི་ཤེས་པས་ ༼སྣར། པེ།༽ ཡང་དག་པའི་"
    },
    {
      "span": {
        "start": 43398,
        "end": 43416
      },
      "text": "ཐམས་ཅད་ཀྱི་དམ་པའི་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 43433,
        "end": 43441
      },
      "text": "སྲིད་པར་ ༼སྣར། པེ།༽ སྲིད་པ་"
    },
    {
      "span": {
        "start": 43685,
        "end": 43693
      },
      "text": "མཁྱེན་པ་ ༼སྣར། པེ།༽ མཁྱེན་"
    },
    {
      "span": {
        "start": 43704,
        "end": 43710
      },
      "text": "བར་ཡང་ ༼སྣར། པེ།༽ བར་"
    },
    {
      "span": {
        "start": 43774,
        "end": 43783
      },
      "text": "དྲི་མ་དང་ ༼སྣར། པེ།༽ དྲི་མ་"
    },
    {
      "span": {
        "start": 44167,
        "end": 44177
      },
      "text": "གཟིགས་པའི་ ༼སྣར། པེ།༽ རིག་པའི་"
    },
    {
      "span": {
        "start": 44235,
        "end": 44244
      },
      "text": "པོ་རྣམ་པ་ ༼སྣར། པེ།༽ པོ་རྣམས་"
    },
    {
      "span": {
        "start": 44510,
        "end": 44517
      },
      "text": "ཅན་དང་། ༼སྣར། པེ།༽ ཅན་"
    },
    {
      "span": {
        "start": 44780,
        "end": 44782
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་མི་"
    },
    {
      "span": {
        "start": 44810,
        "end": 44822
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 44843,
        "end": 44853
      },
      "text": "ཐམས་ཅད་དང་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 45034,
        "end": 45042
      },
      "text": "གཞག་པ་ལ་ ༼སྣར། པེ།༽ གཞག་པ་"
    },
    {
      "span": {
        "start": 45120,
        "end": 45139
      },
      "text": "བྱ་བས་ཆོས་སྟོན་པ་ན་ ༼པེ།༽ ཆོས་སྟོན་པ་"
    },
    {
      "span": {
        "start": 45242,
        "end": 45248
      },
      "text": "ལྡན་པ་ ༼སྣར། པེ།༽ ལྡན་པའི་"
    },
    {
      "span": {
        "start": 45427,
        "end": 45431
      },
      "text": "གིས་ ༼སྣར། པེ།༽ གིས་དེ་"
    },
    {
      "span": {
        "start": 45527,
        "end": 45535
      },
      "text": "བསྔགས་པ་ ༼སྣར། པེ།༽ སྔགས་པ་"
    },
    {
      "span": {
        "start": 45648,
        "end": 45658
      },
      "text": "དགའ་བ་རྒྱ་ ༼སྣར། པེ།༽ དགའ་བ་"
    },
    {
      "span": {
        "start": 45912,
        "end": 45929
      },
      "text": "གཞན་གྱི་རྒྱུད་དག་ ༼སྣར། པེ།༽ གཞན་གྱིས་རྒྱུད་"
    },
    {
      "span": {
        "start": 46094,
        "end": 46102
      },
      "text": "རྒྱས་པར་ ༼སྣར། པེ།༽ ངེས་པར་"
    },
    {
      "span": {
        "start": 46524,
        "end": 46531
      },
      "text": "བསྟན་པ་ ༼སྣར།༽ བརྟན་པ་"
    },
    {
      "span": {
        "start": 46717,
        "end": 46724
      },
      "text": "བལྟ་བར་ ༼སྣར། པེ།༽ ལྟ་བར་"
    },
    {
      "span": {
        "start": 46766,
        "end": 46772
      },
      "text": "ལྔ་པོ་ ༼སྣར། པེ།༽ ལྔ་པོ་བསྟན་པ་འདིའམ་ས་ལྔ་པོ་"
    },
    {
      "span": {
        "start": 46838,
        "end": 46845
      },
      "text": "དམ་པའོ་ ༼སྣར། པེ།༽ དག་པ་"
    },
    {
      "span": {
        "start": 46938,
        "end": 46948
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ བསྒོམས་པའི་"
    },
    {
      "span": {
        "start": 47073,
        "end": 47078
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བ་དེ་"
    },
    {
      "span": {
        "start": 47116,
        "end": 47121
      },
      "text": "རྟེན་ ༼སྣར།༽ བརྟན་ ༼པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 47342,
        "end": 47345
      },
      "text": "དེ། ༼སྣར། པེ།༽ དོ། །"
    },
    {
      "span": {
        "start": 48039,
        "end": 48046
      },
      "text": "གཞུག་པ་ ༼སྣར།༽ བཞུགས་པ་ ༼པེ།༽ ཞུགས་པ་"
    },
    {
      "span": {
        "start": 48268,
        "end": 48280
      },
      "text": "དགའ་བར་བྱའོ། ༼སྣར། པེ།༽ དགའ་བའོ།"
    },
    {
      "span": {
        "start": 48563,
        "end": 48570
      },
      "text": "དག་གིས་ ༼སྣར། པེ།༽ དག་གི་"
    },
    {
      "span": {
        "start": 48722,
        "end": 48731
      },
      "text": "འཆལ་པ་དང་ ༼སྣར། པེ།༽ འཆལ་པ་"
    },
    {
      "span": {
        "start": 49042,
        "end": 49049
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ བསྟན་པའི་"
    },
    {
      "span": {
        "start": 49181,
        "end": 49183
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 49259,
        "end": 49274
      },
      "text": "བཅུ་གཉིས་པོ་དེ་ ༼སྣར། པེ།༽ བཅུ་གཉིས་པོ་"
    },
    {
      "span": {
        "start": 49299,
        "end": 49304
      },
      "text": "སྡེས་ ༼སྣར། པེ།༽ སྡེ་"
    },
    {
      "span": {
        "start": 49599,
        "end": 49609
      },
      "text": "བསླབས་པའི་ ༼སྣར། པེ།༽ བསླབ་པའི་"
    },
    {
      "span": {
        "start": 49898,
        "end": 49905
      },
      "text": "འདུན་པ་ ༼སྣར། པེ།༽ བདུན་པ་"
    },
    {
      "span": {
        "start": 49905,
        "end": 49910
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 50004,
        "end": 50009
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 50366,
        "end": 50370
      },
      "text": "ཆོག་ ༼སྣར།༽ མཆོག་"
    },
    {
      "span": {
        "start": 50468,
        "end": 50477
      },
      "text": "འཕེན་པའི་ ༼སྣར། པེ།༽ འཕན་པའི་"
    },
    {
      "span": {
        "start": 50993,
        "end": 50996
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 51183,
        "end": 51193
      },
      "text": "སྒྲུབ་པའི་ ༼སྣར།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 51571,
        "end": 51586
      },
      "text": "ཚུལ་ཁྲིམས་ཀྱིས་ ༼སྣར། པེ།༽ ཚུལ་ཁྲིམས་ཀྱི་"
    },
    {
      "span": {
        "start": 51738,
        "end": 51742
      },
      "text": "ཚིག་ ༼སྣར། པེ།༽ ཚིག་གི་"
    },
    {
      "span": {
        "start": 51836,
        "end": 51838
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་རབ་ཏུ་དབྱེ་བས་"
    },
    {
      "span": {
        "start": 52063,
        "end": 52065
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 52130,
        "end": 52138
      },
      "text": "དུས་ཀྱི་ ༼སྣར། པེ།༽ དུས་ཀྱིས་"
    },
    {
      "span": {
        "start": 52968,
        "end": 52975
      },
      "text": "ཡིན་ནོ། ༼སྣར། པེ།༽ ཡིན།"
