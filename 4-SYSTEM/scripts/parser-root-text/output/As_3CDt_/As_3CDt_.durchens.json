        "end": 62213
      },
      "text": "བརྟན་པའི་ ༼སྣར། པེ།༽ བསྟན་པའི་"
    },
    {
      "span": {
        "start": 62240,
        "end": 62248
      },
      "text": "གཅིག་པུ་ ༼སྣར། པེ།༽ གཅིག་ཏུ་"
    },
    {
      "span": {
        "start": 62383,
        "end": 62390
      },
      "text": "བསམས་པ་ ༼སྣར། པེ།༽ བསམ་པ་"
    },
    {
      "span": {
        "start": 62393,
        "end": 62402
      },
      "text": "བསྒོམས་པ་ ༼སྣར། པེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 62423,
        "end": 62428
      },
      "text": "བརྟན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 62494,
        "end": 62498
      },
      "text": "མཉམ་ ༼སྣར། པེ།༽ ཉམ་"
    },
    {
      "span": {
        "start": 62700,
        "end": 62712
      },
      "text": "ཤེས་རབ་ཀྱིས་ ༼སྣར། པེ།༽ ཤེས་རབ་ཀྱི་"
    },
    {
      "span": {
        "start": 62845,
        "end": 62853
      },
      "text": "སྐྱེད་པ་ ༼སྣར། པེ།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 62956,
        "end": 62963
      },
      "text": "དབང་པོ་ ༼སྣར། པེ།༽ དབང་"
    },
    {
      "span": {
        "start": 63618,
        "end": 63623
      },
      "text": "འདིར་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 64223,
        "end": 64231
      },
      "text": "གདམས་ངག་ ༼སྣར། པེ།༽ གདམ་ངག་"
    },
    {
      "span": {
        "start": 64303,
        "end": 64324
      },
      "text": "དྲན་པ་ལ་སོགས་པ་དྲན་པ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 64437,
        "end": 64445
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 65322,
        "end": 65330
      },
      "text": "སྟོན་པར་ ༼སྣར། པེ།༽ སྟོན་པ་"
    },
    {
      "span": {
        "start": 65334,
        "end": 65337
      },
      "text": "པར་ ༼སྣར།༽ པ་"
    },
    {
      "span": {
        "start": 65449,
        "end": 65456
      },
      "text": "འདྲ་བར་ ༼སྣར། པེ།༽ འདྲ་བ་"
    },
    {
      "span": {
        "start": 65840,
        "end": 65845
      },
      "text": "ཐུགས་ ༼སྣར། པེ།༽ ཐུགས་སུ་"
    },
    {
      "span": {
        "start": 66358,
        "end": 66363
      },
      "text": "རིགས་ ༼སྣར།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 66700,
        "end": 66705
      },
      "text": "བཟུང་ ༼སྣར།༽ གཟུང་"
    },
    {
      "span": {
        "start": 66762,
        "end": 66769
      },
      "text": "ཚིག་དང་ ༼སྣར། པེ།༽ ཚིག་"
    },
    {
      "span": {
        "start": 66796,
        "end": 66804
      },
      "text": "བརྟག་པར་ ༼སྣར། པེ།༽ རྟག་པར་"
    },
    {
      "span": {
        "start": 67142,
        "end": 67148
      },
      "text": "འདོགས་ ༼སྣར། པེ།༽ འདོགས་པའི་"
    },
    {
      "span": {
        "start": 67647,
        "end": 67651
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་ལ་"
    },
    {
      "span": {
        "start": 67889,
        "end": 67895
      },
      "text": "རེག་པ་ ༼སྣར། པེ།༽ གནས་པ་"
    },
    {
      "span": {
        "start": 67951,
        "end": 67956
      },
      "text": "ཀྱིས་ ༼སྣར། པེ།༽ ཀྱིས་ཏེ་"
    },
    {
      "span": {
        "start": 68262,
        "end": 68275
      },
      "text": "གཉིས་ཀྱིས་ཏེ་ ༼སྣར། པེ།༽ གཉིས་ཀྱིས་"
    },
    {
      "span": {
        "start": 68415,
        "end": 68426
      },
      "text": "གསུངས་པ་ནི་ ༼པེ།༽ གསུངས་པ་"
    },
    {
      "span": {
        "start": 68429,
        "end": 68438
      },
      "text": "ལྟར་མདོར་ ༼སྣར། པེ།༽ ལྟར་"
    },
    {
      "span": {
        "start": 68593,
        "end": 68600
      },
      "text": "ཉེས་པར་ ༼སྣར། པེ།༽ ཉེས་པ་"
    },
    {
      "span": {
        "start": 68646,
        "end": 68652
      },
      "text": "སྤང་བ་ ༼སྣར། པེ།༽ སྤོང་བ་"
    },
    {
      "span": {
        "start": 68750,
        "end": 68758
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 68922,
        "end": 68925
      },
      "text": "དེ་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 69220,
        "end": 69236
      },
      "text": "གཞན་དག་གིས་དེའི་ ༼སྣར། པེ།༽ གཞན་དག་གིས་"
    },
    {
      "span": {
        "start": 69297,
        "end": 69303
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 69605,
        "end": 69612
      },
      "text": "རྙོག་པ་ ༼སྣར། པེ།༽ རྙོག་"
    },
    {
      "span": {
        "start": 69894,
        "end": 69896
      },
      "text": "པ། ༼སྣར། པེ།༽ པ། བནྡེ་ཅོག་རོ་ཀླུའི་རྒྱལ་མཚན་གྱིས་བསྒྱུར་"
    }
  ]
}