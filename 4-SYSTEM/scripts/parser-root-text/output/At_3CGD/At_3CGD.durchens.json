{
  "durchens": [
    {
      "span": {
        "start": 42,
        "end": 51
      },
      "text": "ཛ་སྟོ་ཏྲ། ༼སྣར། པེ།༽ ཛ་སྟོཏྟྲ།"
    },
    {
      "span": {
        "start": 116,
        "end": 124
      },
      "text": "རྒྱལ་པོ་ ༼སྣར། པེ།༽ རྒྱལ་པོ་འཕགས་པ་"
    },
    {
      "span": {
        "start": 543,
        "end": 554
      },
      "text": "ཐུགས་རྗེའི་ ༼སྣར། པེ།༽ ཐུགས་རྗེས་"
    },
    {
      "span": {
        "start": 574,
        "end": 583
      },
      "text": "སྐུ་མཆོག་ ༼སྣར། པེ།༽ སྐུ་མདོག་"
    },
    {
      "span": {
        "start": 880,
        "end": 886
      },
      "text": "སྡིགས་ ༼སྣར། པེ།༽ བསྡིགས་"
    },
    {
      "span": {
        "start": 1246,
        "end": 1251
      },
      "text": "མགོན་ ༼སྣར། པེ།༽ འགོད་"
    },
    {
      "span": {
        "start": 1739,
        "end": 1744
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 1837,
        "end": 1842
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    }
  ]
}