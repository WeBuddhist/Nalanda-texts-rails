{
  "durchens": [
    {
      "span": {
        "start": 333,
        "end": 338
      },
      "text": "སེམས་ ༼སྣར།༽ བཞག་"
    },
    {
      "span": {
        "start": 678,
        "end": 681
      },
      "text": "ཞུ་ ༼སྣར། པེ།༽ བཞུད་"
    },
    {
      "span": {
        "start": 1088,
        "end": 1094
      },
      "text": "སླུ་བ་ ༼སྣར། པེ།༽ བསླུ་བ་"
    },
    {
      "span": {
        "start": 1295,
        "end": 1302
      },
      "text": "སྤངས་ལ། ༼སྣར། པེ།༽ སྤངས་པ།"
    },
    {
      "span": {
        "start": 1855,
        "end": 1860
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ གསུང་"
    }
  ]
}