{
  "durchens": [
    {
      "span": {
        "start": 198,
        "end": 203
      },
      "text": "སྩོལ་ ༼སྣར། པེ།༽ རྩོལ་"
    },
    {
      "span": {
        "start": 578,
        "end": 587
      },
      "text": "ཆེན་པོའི་ ༼སྣར། པེ།༽ ཆེན་པོ་པའི་"
    },
    {
      "span": {
        "start": 639,
        "end": 647
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར། པེ།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 1192,
        "end": 1199
      },
      "text": "ལམ་གྱི་ ༼སྣར། པེ།༽ ལམ་པའི་"
    },
    {
      "span": {
        "start": 1232,
        "end": 1239
      },
      "text": "རི་མོར་ ༼སྣར། པེ།༽ རི་མོ་"
    },
    {
      "span": {
        "start": 1259,
        "end": 1266
      },
      "text": "བཏོད་པ་ ༼སྣར། པེ།༽ གཏོད་པ་"
    },
    {
      "span": {
        "start": 1781,
        "end": 1792
      },
      "text": "རང་བཞིན་ནི་ ༼སྣར། པེ།༽ རང་བཞིན་"
    },
    {
      "span": {
        "start": 1872,
        "end": 1875
      },
      "text": "ཚད་ ༼སྣར།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 1878,
        "end": 1881
      },
      "text": "ཁས་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 1918,
        "end": 1922
      },
      "text": "རིག་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 1927,
        "end": 1933
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ སྐྱེས་"
    },
    {
      "span": {
        "start": 2101,
        "end": 2105
      },
      "text": "ཚིག་ ༼པེ།༽ ཚིགས་"
    },
    {
      "span": {
        "start": 2471,
        "end": 2475
      },
      "text": "མོང་ ༼སྣར།༽ མོངས་"
    },
    {
      "span": {
        "start": 2570,
        "end": 2578
      },
      "text": "འདི་སྐད་ ༼སྣར། པེ།༽ ཇི་སྐད་"
    },
    {
      "span": {
        "start": 2974,
        "end": 2980
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 3227,
        "end": 3239
      },
      "text": "ཤེས་རབ་ཀྱིས་ ༼སྣར། པེ།༽ ཤེས་རབ་ཀྱི་"
    },
    {
      "span": {
        "start": 3326,
        "end": 3332
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 3691,
        "end": 3696
      },
      "text": "བསྟང་ ༼སྣར། པེ།༽ སྟོང་"
    },
    {
      "span": {
        "start": 3857,
        "end": 3869
      },
      "text": "མཐོ་རིས་ཀྱི་ ༼སྣར། པེ།༽ མཐོ་རིས་ཀྱིས་"
    },
    {
      "span": {
        "start": 3886,
        "end": 3893
      },
      "text": "ལམ་གྱི་ ༼སྣར། པེ།༽ ལམ་གྱིས་"
    },
    {
      "span": {
        "start": 3981,
        "end": 3990
      },
      "text": "སྦྱོར་བར་ ༼སྣར། པེ།༽ སྦྱོར་བ་"
    }
  ]
}