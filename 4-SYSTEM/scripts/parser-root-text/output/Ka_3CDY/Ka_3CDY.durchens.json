{
  "durchens": [
    {
      "span": {
        "start": 20,
        "end": 22
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་གུས་པར་"
    },
    {
      "span": {
        "start": 50,
        "end": 62
      },
      "text": "སེམས་བསྐྱེད་ ༼སྣར། པེ།༽ སེམས་སྐྱེས་"
    },
    {
      "span": {
        "start": 107,
        "end": 111
      },
      "text": "བདག་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 134,
        "end": 138
      },
      "text": "བདག་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 338,
        "end": 347
      },
      "text": "སྙིང་རྗེ་ ༼སྣར། པེ།༽ སྙིང་བརྩེ་"
    },
    {
      "span": {
        "start": 396,
        "end": 401
      },
      "text": "བྱིན་ ༼སྣར།༽ སྦྱིན་"
    },
    {
      "span": {
        "start": 487,
        "end": 493
      },
      "text": "བཟློག་ ༼སྣར། པེ།༽ བཟློགས་"
    },
    {
      "span": {
        "start": 635,
        "end": 643
      },
      "text": "བཀུར་བར་ ༼སྣར། པེ།༽ ཁུར་བར་"
    },
    {
      "span": {
        "start": 681,
        "end": 688
      },
      "text": "ཤིན་ཏུ་ ༼སྣར།༽ ཤིན་དུ་"
    },
    {
      "span": {
        "start": 692,
        "end": 697
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 754,
        "end": 759
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 889,
        "end": 892
      },
      "text": "དེ་ ༼སྣར།༽ བདེ་"
    },
    {
      "span": {
        "start": 971,
        "end": 977
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པའི་"
    },
    {
      "span": {
        "start": 1031,
        "end": 1037
      },
      "text": "བསྲུང་ ༼སྣར། པེ།༽ བསྲུངས་"
    },
    {
      "span": {
        "start": 1288,
        "end": 1291
      },
      "text": "དེ་ ༼སྣར། པེ།༽ བདེ་"
    },
    {
      "span": {
        "start": 1293,
        "end": 1300
      },
      "text": "དགོད་བ་ ༼སྣར། པེ།༽ འགོད་བ་"
    },
    {
      "span": {
        "start": 1395,
        "end": 1398
      },
      "text": "མུ་ ༼སྣར།༽ ཅུ་"
    }
  ]
}