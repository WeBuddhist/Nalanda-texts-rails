{
  "durchens": [
    {
      "span": {
        "start": 265,
        "end": 274
      },
      "text": "འཕྲོས་པས་ ༼སྣར། པེ།༽ འཕྲོས་པར་"
    },
    {
      "span": {
        "start": 409,
        "end": 418
      },
      "text": "མཆོད་པའོ། ༼སྣར། པེ།༽ མཆོད་པ་དང་།"
    },
    {
      "span": {
        "start": 1057,
        "end": 1063
      },
      "text": "སྦྱངས་ ༼སྣར།༽ སྤངས་"
    },
    {
      "span": {
        "start": 1176,
        "end": 1184
      },
      "text": "གཙིགས་པ་ ༼སྣར།༽ གཙིགས་"
    },
    {
      "span": {
        "start": 1307,
        "end": 1314
      },
      "text": "གཡོན་ན་ ༼སྣར། པེ།༽ གཡོན་"
    },
    {
      "span": {
        "start": 1375,
        "end": 1388
      },
      "text": "གཟི་བརྗིད་དང་ ༼སྣར། པེ།༽ གཟི་བརྗིད་"
    },
    {
      "span": {
        "start": 1392,
        "end": 1394
      },
      "text": "པ། ༼སྣར། པེ།༽ པ་དང་།"
    },
    {
      "span": {
        "start": 1472,
        "end": 1474
      },
      "text": "ག་ ༼སྣར། པེ།༽ གའི་"
    },
    {
      "span": {
        "start": 1484,
        "end": 1489
      },
      "text": "བརླབ་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 1689,
        "end": 1695
      },
      "text": "བསྐུལ་ ༼སྣར། པེ།༽ སྐུལ་"
    },
    {
      "span": {
        "start": 2407,
        "end": 2421
      },
      "text": "མཆོད་པ་བྱས་ཏེ། ༼སྣར། པེ།༽ མཆོད་པ་སྟེ།"
    },
    {
      "span": {
        "start": 2534,
        "end": 2539
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 2579,
        "end": 2593
      },
      "text": "མཁའ་འགྲོ་མ་ལྔ་ ༼སྣར།༽ མཁའ་འགྲོ་མ་"
    },
    {
      "span": {
        "start": 2685,
        "end": 2691
      },
      "text": "གསང་བ་ ༼སྣར།༽ གསང་"
    },
    {
      "span": {
        "start": 2779,
        "end": 2788
      },
      "text": "སྔགས་ཀྱི་ ༼སྣར། པེ།༽ སྔགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 3231,
        "end": 3236
      },
      "text": "སོ། ། ༼སྣར།༽ ། །འགྲོ་ཀུན་སངས་རྒྱས་ཐོབ་པར་ཤོག །འགྲོ་ལ་ཕན་གྱུར་ཅིག །བཀྲ་ཤིས། ། ༼པེ།༽ ། །འགྲོ་ཀུན་སངས་རྒྱས་ཐོབ་པར་ཤོག །།འགྲོ་ལ་ཕན་གྱུར་ཅིག །།དགེའོ། །བཀྲ་ཤིས།། །།"
    }
  ]
}