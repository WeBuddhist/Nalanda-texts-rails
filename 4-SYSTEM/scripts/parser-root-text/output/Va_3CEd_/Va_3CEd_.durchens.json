{
  "durchens": [
    {
      "span": {
        "start": 153,
        "end": 160
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ བརྟེན་པ་"
    },
    {
      "span": {
        "start": 299,
        "end": 304
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ སྲུངས་"
    },
    {
      "span": {
        "start": 349,
        "end": 354
      },
      "text": "བྱའི། ༼སྣར། པེ།༽ འདྲའི།"
    },
    {
      "span": {
        "start": 372,
        "end": 376
      },
      "text": "རེག་ ༼སྣར། པེ།༽ རིག་"
    },
    {
      "span": {
        "start": 396,
        "end": 403
      },
      "text": "བསད་སར་ ༼སྣར། པེ།༽ གསད་པར་"
    },
    {
      "span": {
        "start": 437,
        "end": 444
      },
      "text": "མེ་ཆེན་ ༼སྣར། པེ།༽ མི་ཆེན་"
    },
    {
      "span": {
        "start": 571,
        "end": 575
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ ཡི། །རོ་མྱག་པ།"
    },
    {
      "span": {
        "start": 577,
        "end": 586
      },
      "text": "རོ་མྱང་བ་ ༼སྣར།༽ རོ་མྱང་ཡིས་"
    },
    {
      "span": {
        "start": 686,
        "end": 692
      },
      "text": "བུམ་པ་ ༼སྣར། པེ།༽ བུང་བ་"
    },
    {
      "span": {
        "start": 696,
        "end": 700
      },
      "text": "ཡིས་ ༼སྣར། པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 849,
        "end": 854
      },
      "text": "རླག ། ༼སྣར། པེ།༽ བརླག། །"
    },
    {
      "span": {
        "start": 914,
        "end": 917
      },
      "text": "དག་ ༼སྣར། པེ།༽ དག་ནི་རེ་རེ་ཡིས། །སྐྱེས་བུ་དག་"
    },
    {
      "span": {
        "start": 988,
        "end": 994
      },
      "text": "བདེ་བ་ ༼སྣར།༽ བདེ་"
    },
    {
      "span": {
        "start": 998,
        "end": 1001
      },
      "text": "ཇི་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 1152,
        "end": 1157
      },
      "text": "ཙཱ་བ་ ༼སྣར། པེ།༽ ཙཱ་བ་དགེ་སློང་"
    },
    {
      "span": {
        "start": 1165,
        "end": 1184
      },
      "text": "བཟང་པོས་བསྒྱུར་ཅིང་ ༼སྣར། པེ།༽ བཟང་པོས་"
    }
  ]
}