{
  "durchens": [
    {
      "span": {
        "start": 995,
        "end": 999
      },
      "text": "བཟང་ ༼སྣར། པེ།༽ བཟངས་"
    },
    {
      "span": {
        "start": 1137,
        "end": 1144
      },
      "text": "པུས་མོ་ ༼སྣར། པེ།༽ པུས་མོའི་"
    },
    {
      "span": {
        "start": 1418,
        "end": 1427
      },
      "text": "རྒྱུ་མཚན་ ༼སྣར།༽ རྒྱུན་ཆིན་"
    },
    {
      "span": {
        "start": 1458,
        "end": 1465
      },
      "text": "ལྡོག་པ་ ༼པེ།༽ ལྟོག་པ་"
    },
    {
      "span": {
        "start": 1511,
        "end": 1514
      },
      "text": "བྱ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 1680,
        "end": 1689
      },
      "text": "སེམས་ཀྱི་ ༼སྣར། པེ།༽ སེམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 1957,
        "end": 1964
      },
      "text": "མཆིས་ན། ༼སྣར། པེ།༽ མཆིས་ནས།"
    },
    {
      "span": {
        "start": 2137,
        "end": 2144
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 2672,
        "end": 2676
      },
      "text": "རིས་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 2811,
        "end": 2816
      },
      "text": "ལེགས་ ༼སྣར། པེ།༽ ལེའུར་"
    },
    {
      "span": {
        "start": 4376,
        "end": 4379
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 4678,
        "end": 4688
      },
      "text": "འགྱུར་གྱི་ ༼སྣར། པེ།༽ འགྱུར་གྱིས་"
    },
    {
      "span": {
        "start": 4854,
        "end": 4861
      },
      "text": "བསྒོམས་ ༼སྣར། པེ།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 4872,
        "end": 4878
      },
      "text": "ལོ་ནི་ ༼ཅོ། སྡེ།༽ ལོ་ན་"
    },
    {
      "span": {
        "start": 5002,
        "end": 5014
      },
      "text": "གང་རུང་གཅིག་ ༼སྣར། པེ།༽ གང་རུང་ཅིག་"
    },
    {
      "span": {
        "start": 5603,
        "end": 5612
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 5629,
        "end": 5636
      },
      "text": "བསྒོམས་ ༼སྣར། པེ།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 5731,
        "end": 5741
      },
      "text": "བསྒོམས་པས་ ༼སྣར། པེ།༽ བསྒོམ་པས་"
    },
    {
      "span": {
        "start": 6635,
        "end": 6640
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 6698,
        "end": 6707
      },
      "text": "རྟོག་པའི་ ༼སྣར། པེ།༽ རྟོགས་པའི་"
    },
    {
      "span": {
        "start": 6866,
        "end": 6871
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 6875,
        "end": 6884
      },
      "text": "ཏིང་འཛིན་ ༼སྣར། པེ།༽ ཏིང་ངེ་འཛིན་"
    },
    {
      "span": {
        "start": 7024,
        "end": 7029
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 7618,
        "end": 7624
      },
      "text": "བསྐུར་ ༼སྣར། པེ།༽ བཀུར་"
    },
    {
      "span": {
        "start": 7671,
        "end": 7677
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 7950,
        "end": 7954
      },
      "text": "བླང་ ༼སྣར། པེ།༽ བླངས་"
    },
    {
      "span": {
        "start": 8222,
        "end": 8227
      },
      "text": "སྲེག་ ༼སྣར། པེ།༽ བསྲེག་"
    },
    {
      "span": {
        "start": 8334,
        "end": 8343
      },
      "text": "དཔལ་གྱིས། ༼སྣར། པེ།༽ དཔལ་གྱི།"
    }
  ]
}