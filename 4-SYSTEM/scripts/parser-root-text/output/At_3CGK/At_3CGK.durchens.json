{
  "durchens": [
    {
      "span": {
        "start": 305,
        "end": 312
      },
      "text": "བསམས་ལ། ༼སྣར།༽ བསམས་"
    },
    {
      "span": {
        "start": 970,
        "end": 977
      },
      "text": "གཡོན་པ་ ༼སྣར། པེ།༽ གཡོན་པས་"
    },
    {
      "span": {
        "start": 1227,
        "end": 1230
      },
      "text": "གི་ ༼སྣར། པེ།༽ གི་སྙིང་"
    },
    {
      "span": {
        "start": 1367,
        "end": 1369
      },
      "text": "པ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 1489,
        "end": 1517
      },
      "text": "ཙམ་གྱིས་ལྷ་མོའི་ང་རྒྱལ་གྱིས་ ༼སྣར། པེ།༽ ཙམ་གྱིས་"
    }
  ]
}