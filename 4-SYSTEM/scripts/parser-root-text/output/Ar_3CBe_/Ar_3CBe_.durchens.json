{
  "durchens": [
    {
      "span": {
        "start": 76,
        "end": 85
      },
      "text": "ཐབས་ཀྱིས་ ༼སྣར། པེ།༽ ཐབས་ཀྱི་"
    },
    {
      "span": {
        "start": 224,
        "end": 232
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 252,
        "end": 257
      },
      "text": "བཏུད་ ༼སྣར། པེ།༽ བདུད་"
    },
    {
      "span": {
        "start": 278,
        "end": 282
      },
      "text": "ཞིང་ ༼སྣར། པེ།༽ མོང་"
    },
    {
      "span": {
        "start": 440,
        "end": 445
      },
      "text": "བཞག ། ༼སྣར། པེ།༽ གཞག །"
    },
    {
      "span": {
        "start": 459,
        "end": 467
      },
      "text": "ཁྲུས་བྱ་ ༼སྣར། པེ།༽ ཁྲུས་པ་"
    },
    {
      "span": {
        "start": 487,
        "end": 491
      },
      "text": "ལྷར་ ༼སྣར། པེ།༽ ལྟར་"
    },
    {
      "span": {
        "start": 512,
        "end": 517
      },
      "text": "བརྟག་ ༼སྣར། པེ།༽ རྟགས་"
    },
    {
      "span": {
        "start": 522,
        "end": 527
      },
      "text": "སྦྱང་ ༼སྣར། པེ།༽ སྟང་"
    },
    {
      "span": {
        "start": 647,
        "end": 653
      },
      "text": "གཞུག ། ༼སྣར། པེ།༽ བཞུག །"
    },
    {
      "span": {
        "start": 662,
        "end": 668
      },
      "text": "བསྟིམ་ ༼སྣར། པེ།༽ བསྟིམས་"
    },
    {
      "span": {
        "start": 747,
        "end": 752
      },
      "text": "གྱུར། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 780,
        "end": 790
      },
      "text": "གཡོན་གྱིས་ ༼སྣར། པེ།༽ གཡོན་གྱི་"
    },
    {
      "span": {
        "start": 854,
        "end": 859
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 1010,
        "end": 1016
      },
      "text": "བསྐོར་ ༼པེ།༽ སྐོར་"
    },
    {
      "span": {
        "start": 1217,
        "end": 1221
      },
      "text": "ཕྱར་ ༼ཅོ།༽ ཕྱེར་"
    },
    {
      "span": {
        "start": 1235,
        "end": 1243
      },
      "text": "དྲང་པོར་ ༼སྣར། པེ།༽ དང་པོར་"
    },
    {
      "span": {
        "start": 1296,
        "end": 1303
      },
      "text": "གཉིས་ཀ་ ༼སྣར། པེ།༽ གཉིས་པ་"
    },
    {
      "span": {
        "start": 1362,
        "end": 1375
      },
      "text": "ལུགས་བཞིན་ཏེ། ༼སྣར། པེ།༽ ལུགས་བཞིན་ནོ།"
    },
    {
      "span": {
        "start": 1390,
        "end": 1397
      },
      "text": "བཏིང་པ་ ༼སྣར། པེ།༽ གཏིང་པ་"
    },
    {
      "span": {
        "start": 1413,
        "end": 1421
      },
      "text": "གསོར་སོ་ ༼སྣར། པེ།༽ གསོར་མོ་"
    },
    {
      "span": {
        "start": 1735,
        "end": 1743
      },
      "text": "བརྟན་པར་ ༼སྣར། པེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 1758,
        "end": 1766
      },
      "text": "བཟུང་བས་ ༼སྣར། པེ།༽ གཟུང་བས་"
    },
    {
      "span": {
        "start": 1789,
        "end": 1800
      },
      "text": "གྲུབ་སྦྱོར་ ༼སྣར། པེ།༽ འགྲུབ་སྦྱོར་"
    },
    {
      "span": {
        "start": 1920,
        "end": 1928
      },
      "text": "རྟེན་པར་ ༼སྣར། པེ།༽ བསྟེན་པར་"
    },
    {
      "span": {
        "start": 2060,
        "end": 2066
      },
      "text": "འགྲུབ་ ༼ཅོ།༽ གྲུབ་"
    },
    {
      "span": {
        "start": 2115,
        "end": 2123
      },
      "text": "སྤྲོས་པ་ ༼སྣར། པེ།༽ སྤོས་པ་"
    },
    {
      "span": {
        "start": 2244,
        "end": 2252
      },
      "text": "ཀར་འཛིན་ ༼སྣར། པེ།༽ དཀར་འཛིན་"
    },
    {
      "span": {
        "start": 2271,
        "end": 2278
      },
      "text": "བཟུང་བ་ ༼སྣར། པེ།༽ གཟུང་བ་"
    },
    {
      "span": {
        "start": 2298,
        "end": 2335
      },
      "text": "གཡས་བརྟན་པ་ནི་ཐབས་ཡིན་ཏེ། །གཡོན་བརྟན་ ༼སྣར།༽ གཡས་བསྟན་ ༼པེ།༽ གཡས་བསྟན་པ་ནི་ཐབས་ཡིན་ཏེ། །གཡོན་བརྟན་"
    },
    {
      "span": {
        "start": 2358,
        "end": 2365
      },
      "text": "བརྟན་པ་ ༼སྣར། པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 2417,
        "end": 2425
      },
      "text": "བརྟན་ནས་ ༼སྣར། པེ།༽ བསྟན་པས་"
    },
    {
      "span": {
        "start": 2604,
        "end": 2608
      },
      "text": "ཤོད། ༼སྣར། པེ།༽ ཤེས།"
    },
    {
      "span": {
        "start": 2861,
        "end": 2868
      },
      "text": "གྱེན་ལ་ ༼སྣར། པེ།༽ གྱེན་དུ་"
    },
    {
      "span": {
        "start": 3175,
        "end": 3182
      },
      "text": "དྲག་པོ་ ༼སྣར། པེ།༽ དྲག་པ་"
    },
    {
      "span": {
        "start": 3442,
        "end": 3446
      },
      "text": "པའི་ ༼སྣར། པེ།༽ གདེང་པོའི་"
    },
    {
      "span": {
        "start": 3529,
        "end": 3534
      },
      "text": "བསྟན་ ༼སྣར། པེ།༽ བསྟབ་"
    },
    {
      "span": {
        "start": 3754,
        "end": 3763
      },
      "text": "ཐབས་ཀྱིས་ ༼སྣར། པེ།༽ ཐབས་ཀྱི་"
    }
  ]
}