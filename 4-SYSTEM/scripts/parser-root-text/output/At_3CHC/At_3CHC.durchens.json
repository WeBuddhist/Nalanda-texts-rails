{
  "durchens": [
    {
      "span": {
        "start": 382,
        "end": 388
      },
      "text": "དང་པོ་ ༼སྣར། པེ།༽ དང་པོར་"
    },
    {
      "span": {
        "start": 798,
        "end": 803
      },
      "text": "གྱིས་ ༼སྣར། པེ།༽ གྱི་"
    },
    {
      "span": {
        "start": 1032,
        "end": 1040
      },
      "text": "བྱང་ཆུབ་ ༼སྣར། པེ།༽ བྱང་ཆུབ་ཀྱི་"
    },
    {
      "span": {
        "start": 1211,
        "end": 1219
      },
      "text": "བྱང་ཆུབ་ ༼སྣར།༽ བྱང་ཆུབ་ཀྱི་"
    },
    {
      "span": {
        "start": 1392,
        "end": 1400
      },
      "text": "བྱང་ཆུབ་ ༼སྣར། པེ།༽ བྱང་ཆུབ་ཀྱི་"
    },
    {
      "span": {
        "start": 1676,
        "end": 1685
      },
      "text": "ཡིད་ཀྱིས་ ༼སྣར། པེ།༽ ཡིད་ཀྱི་"
    },
    {
      "span": {
        "start": 1737,
        "end": 1739
      },
      "text": "པ་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 1805,
        "end": 1813
      },
      "text": "ཙོག་པུར་ ༼སྣར། པེ།༽ ཙོག་པོར་"
    },
    {
      "span": {
        "start": 1839,
        "end": 1847
      },
      "text": "སྦྱར་བས་ ༼སྣར། པེ།༽ སྦྱར་ནས་"
    },
    {
      "span": {
        "start": 2469,
        "end": 2474
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 2485,
        "end": 2493
      },
      "text": "བྱང་ཆུབ་ ༼སྣར། པེ།༽ བྱང་ཆུབ་ཀྱི་"
    },
    {
      "span": {
        "start": 2597,
        "end": 2604
      },
      "text": "བརྒལ་བ་ ༼སྣར། པེ།༽ རྒལ་བ་"
    },
    {
      "span": {
        "start": 2757,
        "end": 2764
      },
      "text": "བགྱིའོ་ ༼སྣར། པེ།༽ བྱའོ་"
    },
    {
      "span": {
        "start": 2860,
        "end": 2863
      },
      "text": "ནི། ༼སྣར། པེ།༽ འདི།"
    },
    {
      "span": {
        "start": 3064,
        "end": 3072
      },
      "text": "གོ་རིམས་ ༼སྣར། པེ།༽ གོ་རིམ་"
    },
    {
      "span": {
        "start": 3116,
        "end": 3126
      },
      "text": "གང་ཟག་གིས་ ༼སྣར། པེ།༽ གང་ཟག་གི་"
    },
    {
      "span": {
        "start": 4792,
        "end": 4799
      },
      "text": "སྡོམ་པ་ ༼སྣར། པེ།༽ སྡོམ་པར་"
    },
    {
      "span": {
        "start": 5015,
        "end": 5022
      },
      "text": "བརྒལ་བ་ ༼སྣར། པེ།༽ རྒལ་བ་"
    },
    {
      "span": {
        "start": 5272,
        "end": 5280
      },
      "text": "དང་འགྲན་ ༼སྣར། པེ།༽ ཡང་འདྲེན་"
    },
    {
      "span": {
        "start": 5317,
        "end": 5320
      },
      "text": "ལན་ ༼སྣར། པེ།༽ ལེན་"
    },
    {
      "span": {
        "start": 5404,
        "end": 5411
      },
      "text": "རས་རིས་ ༼སྣར། པེ།༽ རས་བྲིས་"
    },
    {
      "span": {
        "start": 5570,
        "end": 5576
      },
      "text": "བསམ་ལ། ༼སྣར།༽ བསམས་པས ༼པེ།༽ བསམས་ལ།"
    },
    {
      "span": {
        "start": 6057,
        "end": 6061
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 6425,
        "end": 6433
      },
      "text": "རིང་པོར་ ༼སྣར། པེ།༽ རིང་པོ་"
    },
    {
      "span": {
        "start": 7494,
        "end": 7503
      },
      "text": "བསླབ་པའི་ ༼པེ།༽ བསླབ་པ་"
    },
    {
      "span": {
        "start": 7572,
        "end": 7581
      },
      "text": "བསླབས་པར་ ༼སྣར། པེ།༽ བསླབ་པར་"
    },
    {
      "span": {
        "start": 7612,
        "end": 7621
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་དཔའི་"
    },
    {
      "span": {
        "start": 7641,
        "end": 7649
      },
      "text": "འགྱུར་བ་ ༼པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 7835,
        "end": 7840
      },
      "text": "སྡུད་ ༼པེ།༽ སྡུས་"
    },
    {
      "span": {
        "start": 10015,
        "end": 10024
      },
      "text": "སེམས་པའི་ ༼སྣར། པེ།༽ སེམས་དཔའི་"
    },
    {
      "span": {
        "start": 10029,
        "end": 10031
      },
      "text": "པ་ ༼སྣར། པེ།༽ པ་ལ་"
    },
    {
      "span": {
        "start": 10248,
        "end": 10257
      },
      "text": "སེམས་དཔས་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 10379,
        "end": 10388
      },
      "text": "སེམས་དཔས་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 10898,
        "end": 10907
      },
      "text": "ལགས་སོ། ། ༼སྣར། པེ།༽ ལགས།། །།"
    },
    {
      "span": {
        "start": 10911,
        "end": 10916
      },
      "text": "ཀྱིས་ ༼སྣར། པེ།༽ ཀྱི་"
    },
    {
      "span": {
        "start": 10985,
        "end": 10992
      },
      "text": "ཕབ། ༼སྣར། པེ།༽ ཕབ་པའོ།། །།"
    }
  ]
}