{
  "durchens": [
    {
      "span": {
        "start": 68,
        "end": 74
      },
      "text": "སྒྲུབ་ ༼པེ།༽ སྒྲུབས།"
    },
    {
      "span": {
        "start": 154,
        "end": 156
      },
      "text": "བསྣམས་ ༼པེ༽ རྣམས།"
    },
    {
      "span": {
        "start": 388,
        "end": 400
      },
      "text": "སྒྲུབ་པ་བཅས་ ༼པེ།༽ བསྒྲུབ་པ་བརྩམས། ༼སྣར།༽ སྒྲུབ་པ་བརྩམས།"
    },
    {
      "span": {
        "start": 442,
        "end": 454
      },
      "text": "ལ་གཞག །ཁ་ཤར། ༼པེ། སྣར།༽ ལ་"
    },
    {
      "span": {
        "start": 497,
        "end": 505
      },
      "text": "རྫས་ཀྱི། ༼པེ། སྣར།༽ རྫས་ཀྱིས།"
    },
    {
      "span": {
        "start": 519,
        "end": 530
      },
      "text": "གུ་གུལ་གྱི། ༼པེ། སྣར།༽ གུ་གུལ་ཀྱིས།"
    },
    {
      "span": {
        "start": 602,
        "end": 606
      },
      "text": "ཏྲི་ཤཱུ་ལ། ༼པེ། སྣར།༽ སཱ་མུ་ས་ཤ་ལ་ཏྲི་ཤུ།"
    },
    {
      "span": {
        "start": 634,
        "end": 656
      },
      "text": "ཏྲཱུཾ་ནིརྒ་ཏ་ཡ་ནིརྒ་ཏ་ ༼པེ། སྣར།༽ཏྲུཾ་ནརྒྷ་ད་ཡ་ནརྒྷ་ད།"
    },
    {
      "span": {
        "start": 904,
        "end": 908
      },
      "text": "ཏ་ཏ། ༼པེ། སྣར།༽ དད།"
    },
    {
      "span": {
        "start": 984,
        "end": 989
      },
      "text": "ཧི་ཧ། ༼པེ། སྣར།༽ ཧ།"
    },
    {
      "span": {
        "start": 1050,
        "end": 1055
      },
      "text": "སོ། ། ༼པེ། སྣར།༽ རྡོ་རྗེ།"
    },
    {
      "span": {
        "start": 1097,
        "end": 1104
      },
      "text": "བསྒྲུབ། ༼པེ། སྣར།༽ སྒྲུབ།"
    }
  ]
}