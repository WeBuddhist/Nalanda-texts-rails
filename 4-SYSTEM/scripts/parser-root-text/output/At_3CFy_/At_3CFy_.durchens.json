{
  "durchens": [
    {
      "span": {
        "start": 157,
        "end": 162
      },
      "text": "ཞི་བ་ ༼སྣར།༽ བཞི་པ་"
    },
    {
      "span": {
        "start": 237,
        "end": 246
      },
      "text": "ཐུགས་རྗེ་ ༼སྣར། པེ།༽ ཐུགས་རྗེས་"
    },
    {
      "span": {
        "start": 466,
        "end": 480
      },
      "text": "མརྒད་ལྗང་གུའི་ ༼སྣར། པེ།༽ མར་ཀཊ་ལྗང་ཁུའི་"
    },
    {
      "span": {
        "start": 489,
        "end": 491
      },
      "text": "བ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 987,
        "end": 992
      },
      "text": "ལྷེན་ ༼སྣར། པེ།༽ ལྷེང་"
    },
    {
      "span": {
        "start": 1027,
        "end": 1032
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 1131,
        "end": 1139
      },
      "text": "སྤྱི་བོ་ ༼སྣར། པེ།༽ སྤྱི་བོར་"
    },
    {
      "span": {
        "start": 1284,
        "end": 1292
      },
      "text": "བ་སྤུའི་ ༼སྣར། པེ།༽ བ་སྤུ་"
    },
    {
      "span": {
        "start": 1611,
        "end": 1620
      },
      "text": "གྱིས་ཐིམ་ ༼སྣར། པེ།༽ གྱི་ཐིག་"
    }
  ]
}