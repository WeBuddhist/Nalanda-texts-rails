{
  "durchens": [
    {
      "span": {
        "start": 318,
        "end": 322
      },
      "text": "འགའ་ ༼སྣར། པེ།༽ འགའ་འང་"
    },
    {
      "span": {
        "start": 451,
        "end": 457
      },
      "text": "སོ་སོ་ ༼སྣར། པེ།༽ སོ་སོའི་"
    },
    {
      "span": {
        "start": 543,
        "end": 549
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པས་"
    },
    {
      "span": {
        "start": 682,
        "end": 690
      },
      "text": "སྐྱེས་པ་ ༼སྣར། པེ།༽ སྐྱེད་པ་"
    },
    {
      "span": {
        "start": 749,
        "end": 756
      },
      "text": "ཡོད་པས་ ༼སྣར། པེ།༽ ཡོད་པར་"
    },
    {
      "span": {
        "start": 781,
        "end": 800
      },
      "text": "དང་མཚུངས་མེད་པ་ཡང་། ༼སྣར། པེ།༽ མཚུངས་མེད་པའང་།"
    },
    {
      "span": {
        "start": 809,
        "end": 819
      },
      "text": "ལ་ཡང་རྒྱུ་ ༼སྣར། པེ།༽ ལའང་རྒྱུན་"
    },
    {
      "span": {
        "start": 1045,
        "end": 1050
      },
      "text": "འབྲས་ ༼པེ།༽ བྲལ་"
    },
    {
      "span": {
        "start": 1117,
        "end": 1121
      },
      "text": "རྟག་ ༼སྣར།༽ བརྟག་"
    },
    {
      "span": {
        "start": 1273,
        "end": 1283
      },
      "text": "མ་རིག་མིན་ ༼སྣར། པེ།༽ མ་རིག་མི་"
    },
    {
      "span": {
        "start": 1288,
        "end": 1291
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 1433,
        "end": 1441
      },
      "text": "དེ་གཉིས་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 1732,
        "end": 1749
      },
      "text": "བདེ་སྡུག་དང་དེའི་ ༼སྣར། པེ།༽ བདེ་སྡུག་དེ་ཡི་"
    },
    {
      "span": {
        "start": 1778,
        "end": 1786
      },
      "text": "བརྟེན་ན། ༼སྣར། པེ།༽ བརྟེན་ནས།"
    },
    {
      "span": {
        "start": 1809,
        "end": 1815
      },
      "text": "འདིའང་ ༼སྣར།༽ འདི་"
    },
    {
      "span": {
        "start": 2062,
        "end": 2068
      },
      "text": "མེད་ལ་ ༼ཅོ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 2116,
        "end": 2121
      },
      "text": "དེ་ན་ ༼སྣར། པེ།༽ དེས་ན་"
    },
    {
      "span": {
        "start": 2305,
        "end": 2309
      },
      "text": "མེད། ༼སྣར། པེ།༽ མིན།"
    },
    {
      "span": {
        "start": 2509,
        "end": 2511
      },
      "text": "ན། ༼སྣར། པེ།༽ མེད།"
    },
    {
      "span": {
        "start": 2625,
        "end": 2636
      },
      "text": "རྒྱུན་གྱིས་ ༼སྣར། པེ།༽ རྒྱུན་གྱི་"
    },
    {
      "span": {
        "start": 2680,
        "end": 2685
      },
      "text": "འགག ། ༼སྣར། པེ།༽ འགའ། །"
    },
    {
      "span": {
        "start": 2982,
        "end": 2986
      },
      "text": "འགག་ ༼སྣར། པེ།༽ འགགས་"
    },
    {
      "span": {
        "start": 2989,
        "end": 2995
      },
      "text": "མྱ་ངན་ ༼སྣར། པེ།༽ མྱང་འདས་"
    },
    {
      "span": {
        "start": 3085,
        "end": 3093
      },
      "text": "འགོག་པར་ ༼སྣར། པེ།༽ འགོག་པ་"
    },
    {
      "span": {
        "start": 3370,
        "end": 3374
      },
      "text": "བལྟ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 3706,
        "end": 3715
      },
      "text": "གནས་པ་ཡང་ ༼སྣར། པེ།༽ གནས་པ་ལའང་"
    },
    {
      "span": {
        "start": 3839,
        "end": 3844
      },
      "text": "མཚམས་ ༼སྣར། པེ།༽ མཚན་"
    },
    {
      "span": {
        "start": 4127,
        "end": 4133
      },
      "text": "སྐྱེས་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 4537,
        "end": 4545
      },
      "text": "སྤྱོད་པ་ ༼སྣར། པེ།༽ སྤྱོད་པོ་"
    },
    {
      "span": {
        "start": 4592,
        "end": 4602
      },
      "text": "ཡང་དག་པའི། ༼སྣར། པེ།༽ ཡང་དག་པར།"
    },
    {
      "span": {
        "start": 4633,
        "end": 4639
      },
      "text": "ལས་ནི་ ༼སྣར། པེ།༽ ལས་མི་"
    },
    {
      "span": {
        "start": 4903,
        "end": 4914
      },
      "text": "། །གང་ཅིའང་ ༼སྣར། པེ།༽ ། །ཅི་ཡང་"
    },
    {
      "span": {
        "start": 5012,
        "end": 5017
      },
      "text": "སྟོང་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 5169,
        "end": 5175
      },
      "text": "ཅེས་པ་ ༼སྣར། པེ།༽ ཅེས་པ་དང་"
    },
    {
      "span": {
        "start": 5183,
        "end": 5191
      },
      "text": "ཅེས་ཡོད། ༼སྣར། པེ།༽ ཅེས།"
    },
    {
      "span": {
        "start": 5260,
        "end": 5269
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 5269,
        "end": 5274
      },
      "text": "སླ་མ་ ༼སྣར། པེ།༽ བླ་མ་"
    },
    {
      "span": {
        "start": 5349,
        "end": 5354
      },
      "text": "བྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 5553,
        "end": 5559
      },
      "text": "ལས་ཤེ་ ༼སྣར། པེ།༽ ལས་ཞེན་"
    },
    {
      "span": {
        "start": 5561,
        "end": 5566
      },
      "text": "རྟགས་ ༼སྣར། པེ།༽ རྟག་"
    },
    {
      "span": {
        "start": 5611,
        "end": 5616
      },
      "text": "རྟགས་ ༼སྣར། པེ།༽ རྟག་"
    },
    {
      "span": {
        "start": 5668,
        "end": 5674
      },
      "text": "རང་གི་ ༼སྣར། པེ།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 5775,
        "end": 5785
      },
      "text": "སྐྱེས་པའི་ ༼སྣར། པེ།༽ སྐྱེས་པ་"
    },
    {
      "span": {
        "start": 5827,
        "end": 5850
      },
      "text": "དང་མ་འོངས་གཟུགས་ཀྱི་ནི། ༼སྣར། པེ།༽ མ་འོངས་པ་གཟུགས་ཀྱང་།"
    },
    {
      "span": {
        "start": 5852,
        "end": 5859
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 6130,
        "end": 6133
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 6261,
        "end": 6269
      },
      "text": "གཞན་བདག་ ༼སྣར། པེ།༽ གཞན་དག་"
    },
    {
      "span": {
        "start": 6321,
        "end": 6326
      },
      "text": "མཆེད་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 6426,
        "end": 6431
      },
      "text": "སྟོན་ ༼སྣར། པེ།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 6448,
        "end": 6453
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 6517,
        "end": 6524
      },
      "text": "དེ་བདག་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 6528,
        "end": 6533
      },
      "text": "ཀྱིས་ ༼སྣར། པེ།༽ ཀྱི་"
    },
    {
      "span": {
        "start": 6702,
        "end": 6711
      },
      "text": "བརྟེན་ནས། ༼སྣར།༽ བརྟན་ན ༼པེ།༽ བརྟེན་ན།"
    },
    {
      "span": {
        "start": 7251,
        "end": 7260
      },
      "text": "རྟོགས་པས་ ༼སྣར། པེ།༽ རྟོགས་པའི་"
    },
    {
      "span": {
        "start": 7612,
        "end": 7621
      },
      "text": "རྟོགས་ནས། ༼སྣར། པེ།༽ རྟོགས་ན།"
    },
    {
      "span": {
        "start": 7821,
        "end": 7827
      },
      "text": "མཚུངས། ༼སྣར། པེ།༽ མཚུངས། །རང་བཞིན་གྱིས་ནི་འགའ་ཡང་མེད། །འདི་ལ་དངོས་པོ་མེད་པའང་མེད། རྒྱུ་དང་རྐྱེན་ལས་སྐྱེས་པ་ཡི། །དངོས་དང་དངོས་མེད་སྟོང་པ་ཡིན།"
    },
    {
      "span": {
        "start": 8054,
        "end": 8065
      },
      "text": "བརྟེན་བརྟག་ ༼སྣར། པེ།༽ བདེན་བརྟགས་"
    },
    {
      "span": {
        "start": 8133,
        "end": 8139
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 8353,
        "end": 8357
      },
      "text": "ཆོས་ ༼སྣར། པེ།༽ ཚོལ་"
    },
    {
      "span": {
        "start": 8400,
        "end": 8406
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 8418,
        "end": 8425
      },
      "text": "བརྟན་པ་ ༼སྣར། པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 8480,
        "end": 8485
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིག་"
    },
    {
      "span": {
        "start": 8583,
        "end": 8595
      },
      "text": "བདུན་ཅུ་པའི་ ༼སྣར། པེ།༽ བདུན་ཅུ་པ་"
    },
    {
      "span": {
        "start": 8677,
        "end": 8679
      },
      "text": "བ་ ༼སྣར། པེ།༽ ལོ་ཙཱ་"
    },
    {
      "span": {
        "start": 8697,
        "end": 8706
      },
      "text": "སྙན་དར་མ་ ༼སྣར། པེ།༽ གཉན་དྷརྨ་"
    }
  ]
}