{
  "durchens": [
    {
      "span": {
        "start": 78,
        "end": 89
      },
      "text": "འཕགས་པ་འཇམ་ ༼སྣར། པེ།༽ འཇམ་"
    },
    {
      "span": {
        "start": 229,
        "end": 234
      },
      "text": "འདུད། ༼སྣར། པེ།༽ ལོ།"
    },
    {
      "span": {
        "start": 534,
        "end": 538
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 737,
        "end": 742
      },
      "text": "བཏོད་ ༼སྣར། པེ།༽ གཏོད་"
    },
    {
      "span": {
        "start": 1015,
        "end": 1019
      },
      "text": "མཐར་ ༼སྣར། པེ།༽ མཐའ་"
    },
    {
      "span": {
        "start": 1319,
        "end": 1325
      },
      "text": "མེད་ན་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 1335,
        "end": 1337
      },
      "text": "ན། ༼སྣར། པེ།༽ ནའང་།"
    },
    {
      "span": {
        "start": 1407,
        "end": 1416
      },
      "text": "འབྲས་བུར་ ༼སྣར། པེ།༽ འབྲས་བུ་"
    },
    {
      "span": {
        "start": 1463,
        "end": 1469
      },
      "text": "དེ་ནི་ ༼པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 1789,
        "end": 1798
      },
      "text": "སངས་རྒྱས་ ༼སྣར། པེ།༽ སྙིང་པོ་"
    },
    {
      "span": {
        "start": 1938,
        "end": 1947
      },
      "text": "སྒྲུབ་པར་ ༼སྣར། པེ།༽ བསྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 2102,
        "end": 2112
      },
      "text": "དང་ཁུག་རྣ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 2115,
        "end": 2117
      },
      "text": "བ་ ༼སྣར། པེ།༽ བ་ཁུག་རྣ་"
    },
    {
      "span": {
        "start": 2179,
        "end": 2184
      },
      "text": "གྱུར། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 2296,
        "end": 2301
      },
      "text": "གྱུར། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 2480,
        "end": 2496
      },
      "text": "ཉོན་མོངས་བསྲེག ། ༼སྣར། པེ།༽ དྲི་མ་སྲེག །"
    },
    {
      "span": {
        "start": 2643,
        "end": 2649
      },
      "text": "དཀྱིལ་ ༼སྣར། པེ།༽ ནང་"
    },
    {
      "span": {
        "start": 2651,
        "end": 2659
      },
      "text": "ཡོད་པའི་ ༼སྣར། པེ།༽ གནས་པའི་"
    },
    {
      "span": {
        "start": 2789,
        "end": 2799
      },
      "text": "སྐྱེས་པའང་ ༼སྣར། པེ།༽ སྐྱེས་པ་"
    },
    {
      "span": {
        "start": 2930,
        "end": 2936
      },
      "text": "ལྡོངས་ ༼སྣར། པེ།༽ གདུངས་"
    },
    {
      "span": {
        "start": 2961,
        "end": 2973
      },
      "text": "སྐྱེས་པ་ཞེས་ ༼སྣར། པེ།༽ སྐྱེས་པ་ཤེས་"
    },
    {
      "span": {
        "start": 3479,
        "end": 3486
      },
      "text": "མགོ་ཡི་ ༼སྣར། པེ།༽ མགོ་བོའི་"
    },
    {
      "span": {
        "start": 3491,
        "end": 3499
      },
      "text": "བརྟགས་པ་ ༼སྣར། པེ།༽ བཏགས་པ་"
    },
    {
      "span": {
        "start": 3549,
        "end": 3557
      },
      "text": "བརྟགས་པ་ ༼སྣར། པེ།༽ བཏགས་པ་"
    },
    {
      "span": {
        "start": 3616,
        "end": 3622
      },
      "text": "དམིགས་ ༼སྣར། པེ།༽ ཡོད་"
    },
    {
      "span": {
        "start": 3710,
        "end": 3712
      },
      "text": "པ་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 3764,
        "end": 3770
      },
      "text": "ཡིན་ན། ༼སྣར། པེ།༽ ཡིན་ནོ།"
    },
    {
      "span": {
        "start": 3772,
        "end": 3779
      },
      "text": "བྱིས་པ་ ༼སྣར། པེ།༽ བྱིས་པས་"
    },
    {
      "span": {
        "start": 3786,
        "end": 3794
      },
      "text": "རྟོག་པར་ ༼སྣར། པེ།༽ རྟོགས་པར་"
    },
    {
      "span": {
        "start": 3810,
        "end": 3814
      },
      "text": "གླང་ ༼སྣར། པེ།༽ ལང་"
    },
    {
      "span": {
        "start": 3963,
        "end": 3970
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 4079,
        "end": 4084
      },
      "text": "པའང་། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 4121,
        "end": 4128
      },
      "text": "སོ་གའི་ ༼སྣར། པེ།༽ སོས་ཀའི་"
    },
    {
      "span": {
        "start": 4140,
        "end": 4146
      },
      "text": "དྲོའོ་ ༼སྣར།༽ དྲོ་བོ་ ༼པེ།༽ དྲོ་བོས་"
    },
    {
      "span": {
        "start": 4247,
        "end": 4250
      },
      "text": "ནི། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 4622,
        "end": 4627
      },
      "text": "དཔེས། ༼སྣར། པེ།༽ དཔེ།"
    },
    {
      "span": {
        "start": 4764,
        "end": 4774
      },
      "text": "ངོ་བོ་ཡིན། ༼སྣར། པེ།༽ ངོ་བོ་ཡིས།"
    },
    {
      "span": {
        "start": 4855,
        "end": 4861
      },
      "text": "དང་། ། ༼སྣར། པེ།༽ དག །"
    },
    {
      "span": {
        "start": 5132,
        "end": 5138
      },
      "text": "ཤེས་ན་ ༼སྣར། པེ།༽ ཤེས་ནས་"
    },
    {
      "span": {
        "start": 5292,
        "end": 5298
      },
      "text": "མཐོང་། ༼སྣར། པེ།༽ མཐོ།"
    },
    {
      "span": {
        "start": 5445,
        "end": 5452
      },
      "text": "འགགས་པ་ ༼སྣར། པེ།༽ འགགས་པས་"
    },
    {
      "span": {
        "start": 5533,
        "end": 5535
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 5584,
        "end": 5590
      },
      "text": "ཤེས་ན་ ༼སྣར། པེ།༽ ཤེས་ནས་"
    },
    {
      "span": {
        "start": 5622,
        "end": 5627
      },
      "text": "ཉེ་བ་ ༼སྣར། པེ།༽ ཉེ་བའང་"
    },
    {
      "span": {
        "start": 5642,
        "end": 5648
      },
      "text": "འོང་བ་ ༼སྣར། པེ།༽ འོང་བའང་"
    },
    {
      "span": {
        "start": 5775,
        "end": 5784
      },
      "text": "བརྟགས་པས་ ༼སྣར། པེ།༽ རྟག་པར་"
    },
    {
      "span": {
        "start": 5871,
        "end": 5876
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 5992,
        "end": 5997
      },
      "text": "སྐམས་ ༼སྣར། པེ།༽ བསྐམས་"
    },
    {
      "span": {
        "start": 6068,
        "end": 6074
      },
      "text": "བརྟགས། ༼སྣར། པེ།༽ བཏགས།"
    },
    {
      "span": {
        "start": 6076,
        "end": 6083
      },
      "text": "དམན་དང་ ༼སྣར། པེ།༽ དམན་པ་"
    },
    {
      "span": {
        "start": 6330,
        "end": 6335
      },
      "text": "སྐུས། ༼སྣར། པེ།༽ སྐུ།"
    },
    {
      "span": {
        "start": 6357,
        "end": 6365
      },
      "text": "ནས་ཀྱང་། ༼སྣར། པེ།༽ ནས་ནི།"
    },
    {
      "span": {
        "start": 6669,
        "end": 6680
      },
      "text": "ཡོངས་མཁྱེན་ ༼སྣར། པེ།༽ ཀུན་མཁྱེན་"
    },
    {
      "span": {
        "start": 6788,
        "end": 6792
      },
      "text": "ཁམས་ ༼སྣར། པེ།༽ མཁས་"
    },
    {
      "span": {
        "start": 6871,
        "end": 6880
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 6895,
        "end": 6903
      },
      "text": "རྒྱུ་གང་ ༼སྣར། པེ།༽ རྒྱུ་ཡང་"
    },
    {
      "span": {
        "start": 6920,
        "end": 6926
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 7145,
        "end": 7147
      },
      "text": "ན་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 7161,
        "end": 7166
      },
      "text": "ངང་པ་ ༼སྣར། པེ།༽ ངང་པས་"
    },
    {
      "span": {
        "start": 7383,
        "end": 7389
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བཏགས་"
    },
    {
      "span": {
        "start": 7412,
        "end": 7419
      },
      "text": "མཐོང་ན། ༼སྣར། པེ།༽ མཐོང་ནས།"
    },
    {
      "span": {
        "start": 7530,
        "end": 7536
      },
      "text": "བརྟགས། ༼སྣར། པེ།༽ བཏགས།"
    },
    {
      "span": {
        "start": 7671,
        "end": 7679
      },
      "text": "འདིས་ནི་ ༼སྣར། པེ།༽ འདི་ཡིས་"
    },
    {
      "span": {
        "start": 7771,
        "end": 7779
      },
      "text": "བསྟེན་པ་ ༼སྣར། པེ།༽ བརྟན་པ་"
    },
    {
      "span": {
        "start": 7881,
        "end": 7888
      },
      "text": "ངེས་ནས་ ༼སྣར། པེ།༽ ངེས་གནས་"
    },
    {
      "span": {
        "start": 7922,
        "end": 7928
      },
      "text": "བཞིའོ། ༼སྣར། པེ།༽ བཞི་པོ།"
    },
    {
      "span": {
        "start": 7965,
        "end": 7971
      },
      "text": "ངན་པར་ ༼སྣར། པེ།༽ ངན་པ་"
    },
    {
      "span": {
        "start": 8086,
        "end": 8090
      },
      "text": "དེས། ༼པེ།༽ དེ།"
    },
    {
      "span": {
        "start": 8421,
        "end": 8429
      },
      "text": "སྲུང་བར་ ༼སྣར། པེ།༽ བསྲུང་བར་"
    },
    {
      "span": {
        "start": 8468,
        "end": 8473
      },
      "text": "ལའང་། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 8498,
        "end": 8501
      },
      "text": "བར་ ༼སྣར། པེ།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 8539,
        "end": 8546
      },
      "text": "ཅུང་ཟད་ ༼སྣར། པེ།༽ ཅུང་ཞིག་"
    },
    {
      "span": {
        "start": 8615,
        "end": 8621
      },
      "text": "མཐོང་། ༼སྣར། པེ།༽ སྣང་།"
    },
    {
      "span": {
        "start": 8726,
        "end": 8734
      },
      "text": "འཕེལ་བར་ ༼སྣར། པེ།༽ འཕེལ་རྒྱས་པར་"
    },
    {
      "span": {
        "start": 8922,
        "end": 8928
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 8945,
        "end": 8953
      },
      "text": "ལྡོག་པར་ ༼སྣར། པེ།༽ ལྡོག་པ་"
    },
    {
      "span": {
        "start": 9143,
        "end": 9150
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་པས་"
    },
    {
      "span": {
        "start": 9599,
        "end": 9604
      },
      "text": "ཟད་པ་ ༼སྣར། པེ།༽ ཟབ་པ་"
    },
    {
      "span": {
        "start": 9621,
        "end": 9627
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 9647,
        "end": 9654
      },
      "text": "བཀོད་པ་ ༼སྣར། པེ།༽ བཀོད་པས་"
    },
    {
      "span": {
        "start": 9713,
        "end": 9717
      },
      "text": "རྒལ་ ༼སྣར། པེ།༽ བརྒལ་"
    },
    {
      "span": {
        "start": 9833,
        "end": 9840
      },
      "text": "གྱུར་པ། ༼སྣར། པེ།༽ གྱུར་པས།"
    },
    {
      "span": {
        "start": 9864,
        "end": 9873
      },
      "text": "གཡོས་པའོ། ༼སྣར། པེ།༽ གཡོ་བའོ།"
    },
    {
      "span": {
        "start": 10153,
        "end": 10165
      },
      "text": "ཡོངས་འཛིན་པ། ༼སྣར། པེ།༽ ཡོངས་འཛིན་པས།"
    },
    {
      "span": {
        "start": 10576,
        "end": 10579
      },
      "text": "ནས། ༼སྣར། པེ།༽ ནས་པདྨ་ཆེན་པོའི་རང་བཞིན་གྱིས།"
    },
    {
      "span": {
        "start": 10841,
        "end": 10848
      },
      "text": "ཡིས་གང་ ༼སྣར། པེ།༽ ཡིས་ཡང་"
    },
    {
      "span": {
        "start": 10927,
        "end": 10936
      },
      "text": "སྤྱད་པའི་ ༼སྣར། པེ།༽ སྤྱོད་པའི་"
    },
    {
      "span": {
        "start": 10936,
        "end": 10939
      },
      "text": "ལམ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 11097,
        "end": 11104
      },
      "text": "ཐུ་བོར་ ༼སྣར། པེ།༽ ཐུ་བོ་"
    },
    {
      "span": {
        "start": 11287,
        "end": 11290
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 11548,
        "end": 11551
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 11579,
        "end": 11591
      },
      "text": "སེམས་དབང་པོ། ༼སྣར། པེ།༽ སེམས་དཔའོ།"
    },
    {
      "span": {
        "start": 11705,
        "end": 11711
      },
      "text": "དེ་ལས་ ༼སྣར། པེ།༽ དེ་བས་"
    },
    {
      "span": {
        "start": 11723,
        "end": 11726
      },
      "text": "རབ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 11768,
        "end": 11775
      },
      "text": "ཆེན་པོ་ ༼སྣར། པེ།༽ འཕགས་པ་"
    },
    {
      "span": {
        "start": 11848,
        "end": 11853
      },
      "text": "ཙཱ་བ་ ༼སྣར། པེ།༽ ཙཱ་བ་དགེ་སློང་"
    }
  ]
}