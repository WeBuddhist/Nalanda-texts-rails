{
  "durchens": [
    {
      "span": {
        "start": 519,
        "end": 528
      },
      "text": "འཆོལ་པའི་ ༼སྣར། པེ།༽ ཆོལ་པའི་"
    },
    {
      "span": {
        "start": 625,
        "end": 632
      },
      "text": "བཅས་པས་ ༼སྣར། པེ།༽ བཅས་པའི་"
    },
    {
      "span": {
        "start": 731,
        "end": 737
      },
      "text": "དྲང་བ་ ༼སྣར། པེ།༽ དྲངས་པ་"
    },
    {
      "span": {
        "start": 992,
        "end": 1000
      },
      "text": "ལས་ཀྱིས་ ༼སྣར། པེ།༽ ལས་ཀྱི་"
    },
    {
      "span": {
        "start": 1246,
        "end": 1250
      },
      "text": "ཀ་ས་ ༼སྣར། པེ།༽ ག་ས་"
    },
    {
      "span": {
        "start": 1291,
        "end": 1299
      },
      "text": "གཅད་པའི་ ༼སྣར། པེ།༽ བཅད་པའི་"
    },
    {
      "span": {
        "start": 1588,
        "end": 1597
      },
      "text": "མ་རིག་པས་ ༼སྣར། པེ།༽ མ་རིག་པར་"
    },
    {
      "span": {
        "start": 1636,
        "end": 1638
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 1907,
        "end": 1928
      },
      "text": "འཁོར་བ་འཁོར་བར་འཁྱམས། ༼སྣར། པེ།༽ འཁོར་བར་འཁྱམསཔ་ཡི།"
    },
    {
      "span": {
        "start": 1942,
        "end": 1947
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 2159,
        "end": 2173
      },
      "text": "ཀྱིས་བསྐལ་པའི་ ༼སྣར། པེ།༽ ཀྱི་སྐལ་བའི་"
    },
    {
      "span": {
        "start": 2402,
        "end": 2408
      },
      "text": "དྲང་བ་ ༼སྣར། པེ།༽ དྲངས་པ་"
    },
    {
      "span": {
        "start": 3284,
        "end": 3296
      },
      "text": "རྣམས་དག་པའི་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 4097,
        "end": 4106
      },
      "text": "སྲེག་པའི་ ༼སྣར། པེ།༽ བསྲེག་པའི་"
    },
    {
      "span": {
        "start": 4115,
        "end": 4121
      },
      "text": "སྦྱངས་ ༼སྣར། པེ།༽ སྦྱོངས་"
    }
  ]
}