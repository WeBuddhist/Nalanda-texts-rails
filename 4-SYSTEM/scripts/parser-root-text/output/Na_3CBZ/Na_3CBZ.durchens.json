{
  "durchens": [
    {
      "span": {
        "start": 341,
        "end": 346
      },
      "text": "སྡོམ་ ༼སྣར། པེ།༽ སྡོམས་"
    },
    {
      "span": {
        "start": 806,
        "end": 809
      },
      "text": "ཅི་ ༼སྣར།༽ ཅི་ཀུ་རུ་ཏེ་ ༼པེ།༽ ཅི་ཀུ་རུ་ཏ་"
    },
    {
      "span": {
        "start": 841,
        "end": 848
      },
      "text": "གྲུབ་པ་ ༼སྣར། པེ།༽ གྲུབ་"
    },
    {
      "span": {
        "start": 2382,
        "end": 2386
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ ནཱབྷྱེ། །"
    },
    {
      "span": {
        "start": 2827,
        "end": 2832
      },
      "text": "དཔེར་ ༼སྣར།༽ དཔེ་"
    },
    {
      "span": {
        "start": 3132,
        "end": 3143
      },
      "text": "དེ་བཞིན་དུ་ ༼སྣར། པེ།༽ དེ་བཞིན་རཱནྐ་"
    },
    {
      "span": {
        "start": 3381,
        "end": 3386
      },
      "text": "བ་ཏི། ༼སྣར།༽ བ་འབྲལ་"
    },
    {
      "span": {
        "start": 3678,
        "end": 3687
      },
      "text": "མེད་དོ། ། ༼སྣར། པེ།༽ མེད་མིཥྜ་"
    },
    {
      "span": {
        "start": 4273,
        "end": 4277
      },
      "text": "སྱུ་ ༼སྣར། པེ།༽ སྱཱ་"
    },
    {
      "span": {
        "start": 4670,
        "end": 4674
      },
      "text": "གཉི་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 4895,
        "end": 4901
      },
      "text": "མི་ཏི། ༼སྣར། པེ།༽ མི།། །།"
    }
  ]
}