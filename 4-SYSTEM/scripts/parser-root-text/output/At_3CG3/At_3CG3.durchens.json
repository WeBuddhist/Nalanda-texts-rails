{
  "durchens": [
    {
      "span": {
        "start": 66,
        "end": 71
      },
      "text": "འཛིན་ ༼སྣར། པེ།༽ འཛིན་གྱི་"
    },
    {
      "span": {
        "start": 118,
        "end": 126
      },
      "text": "དང་པོའི་ ༼སྣར། པེ།༽ དང་པོ་"
    },
    {
      "span": {
        "start": 232,
        "end": 234
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 387,
        "end": 393
      },
      "text": "བསྐུར་ ༼སྣར། པེ།༽ སྐུར་"
    },
    {
      "span": {
        "start": 456,
        "end": 464
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 819,
        "end": 824
      },
      "text": "གཡེང་ ༼སྣར། པེ།༽ གཡེངས་"
    },
    {
      "span": {
        "start": 1019,
        "end": 1024
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 1216,
        "end": 1219
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ནི་གང་"
    },
    {
      "span": {
        "start": 1222,
        "end": 1227
      },
      "text": "བ་ཡི། ༼སྣར། པེ།༽ བའི།"
    },
    {
      "span": {
        "start": 1430,
        "end": 1439
      },
      "text": "ཏིང་འཛིན་ ༼སྣར།༽ ཏིང་ངེ་འཛིན་"
    },
    {
      "span": {
        "start": 1439,
        "end": 1448
      },
      "text": "ཚོགས་ཀྱི་ ༼སྣར། པེ།༽ ཚོགས་"
    }
  ]
}