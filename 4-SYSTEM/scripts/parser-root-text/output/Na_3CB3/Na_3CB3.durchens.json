{
  "durchens": [
    {
      "span": {
        "start": 27,
        "end": 29
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནཱ་"
    },
    {
      "span": {
        "start": 47,
        "end": 57
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ སྒོམ་པའི་"
    },
    {
      "span": {
        "start": 596,
        "end": 603
      },
      "text": "རྟོག་པ་ ༼སྣར།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 1022,
        "end": 1033
      },
      "text": "མཐོང་བ་ཡིན། ༼སྣར། པེ།༽ མཐོང་བ་ཡིས།"
    },
    {
      "span": {
        "start": 1463,
        "end": 1470
      },
      "text": "རིག་པས་ ༼སྣར། པེ།༽ རིགས་པས་"
    },
    {
      "span": {
        "start": 1519,
        "end": 1526
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 1939,
        "end": 1943
      },
      "text": "ངེས་ ༼སྣར། པེ།༽ ངོས་"
    },
    {
      "span": {
        "start": 2196,
        "end": 2204
      },
      "text": "བྱིས་པས་ ༼སྣར། པེ།༽ བྲིས་པས་"
    },
    {
      "span": {
        "start": 2212,
        "end": 2219
      },
      "text": "འབྲི་བ་ ༼སྣར། པེ།༽ འདྲི་བ་"
    },
    {
      "span": {
        "start": 2327,
        "end": 2338
      },
      "text": "སྟོབས་ཀྱིས་ ༼སྣར། པེ།༽ སྟོབས་ཀྱི་"
    },
    {
      "span": {
        "start": 2375,
        "end": 2385
      },
      "text": "བྱུང་སེམས་ ༼སྣར། པེ།༽ དང་སེམས་"
    },
    {
      "span": {
        "start": 2385,
        "end": 2388
      },
      "text": "དང་ ༼སྣར། པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 2626,
        "end": 2633
      },
      "text": "བཏགས་པ་ ༼སྣར། པེ།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 2732,
        "end": 2737
      },
      "text": "བཏགས། ༼སྣར། པེ།༽ བརྟགས།"
    },
    {
      "span": {
        "start": 2920,
        "end": 2928
      },
      "text": "རིགས་པས་ ༼སྣར། པེ།༽ རིག་པས་"
    },
    {
      "span": {
        "start": 3251,
        "end": 3283
      },
      "text": "རྟོག་པ་རྣམ་རྟོག་པ། །རྣམ་པར་རྟོག་ ༼པེ།༽ རྟོག་"
    },
    {
      "span": {
        "start": 3503,
        "end": 3509
      },
      "text": "རྒྱུད་ ༼སྣར། པེ།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 3923,
        "end": 3930
      },
      "text": "བལྟ་བར་ ༼སྣར། པེ།༽ ལྟ་བར་"
    },
    {
      "span": {
        "start": 4045,
        "end": 4049
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 5757,
        "end": 5763
      },
      "text": "རྒྱུན་ ༼སྣར། པེ།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 6233,
        "end": 6244
      },
      "text": "མཐོང་བ་ཡིན། ༼སྣར། པེ།༽ མཐོང་བ་ཡིས།"
    },
    {
      "span": {
        "start": 6294,
        "end": 6300
      },
      "text": "རྟོག ། ༼སྣར། པེ།༽ རྟོགས། །"
    },
    {
      "span": {
        "start": 6345,
        "end": 6349
      },
      "text": "རྟག་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 6593,
        "end": 6598
      },
      "text": "བརྟག་ ༼སྣར། པེ།༽ རྟགས་"
    },
    {
      "span": {
        "start": 6625,
        "end": 6632
      },
      "text": "འཕགས་པ་ ༼པེ།༽ འཕགས་"
    },
    {
      "span": {
        "start": 6663,
        "end": 6673
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ སྒོམ་པའི་"
    },
    {
      "span": {
        "start": 6673,
        "end": 6679
      },
      "text": "རིམ་པ་ ༼པེ།༽ རིག་པ་"
    }
  ]
}