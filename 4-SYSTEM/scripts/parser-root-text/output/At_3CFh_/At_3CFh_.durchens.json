{
  "durchens": [
    {
      "span": {
        "start": 605,
        "end": 613
      },
      "text": "མེད་པའི་ ༼སྣར། པེ།༽ མེད་པས་"
    },
    {
      "span": {
        "start": 1075,
        "end": 1084
      },
      "text": "ངོ་བོ་ཡང་ ༼སྣར། པེ།༽ ངོ་བོ་ཡོངས་"
    },
    {
      "span": {
        "start": 1468,
        "end": 1477
      },
      "text": "བརྟག་པའི་ ༼སྣར། པེ།༽ བརྟགས་པའི་"
    },
    {
      "span": {
        "start": 1746,
        "end": 1753
      },
      "text": "དེ་གཞན་ ༼སྣར། པེ།༽ དེ་བཞིན་"
    },
    {
      "span": {
        "start": 1948,
        "end": 1954
      },
      "text": "རྒྱུག་ ༼སྣར། པེ།༽ བརྒྱུག་"
    },
    {
      "span": {
        "start": 2067,
        "end": 2073
      },
      "text": "རྒྱུག་ ༼སྣར། པེ།༽ བརྒྱུག་"
    },
    {
      "span": {
        "start": 2149,
        "end": 2156
      },
      "text": "རྒྱུག ། ༼སྣར། པེ།༽ བརྒྱུག །"
    },
    {
      "span": {
        "start": 2296,
        "end": 2303
      },
      "text": "རོལ་པས་ ༼སྣར། པེ།༽ རོལ་པ་"
    },
    {
      "span": {
        "start": 2406,
        "end": 2414
      },
      "text": "ཡིད་ཀྱི་ ༼སྣར། པེ།༽ ཡིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 2648,
        "end": 2658
      },
      "text": "བརྟན་གྱིས་ ༼སྣར། པེ།༽ བརྟན་གྱི་"
    },
    {
      "span": {
        "start": 2741,
        "end": 2746
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 2861,
        "end": 2867
      },
      "text": "རྟོག ། ༼སྣར། པེ།༽ རྟོགས། །"
    },
    {
      "span": {
        "start": 2927,
        "end": 2934
      },
      "text": "བུང་བས་ ༼སྣར། པེ།༽ བུང་བ་"
    },
    {
      "span": {
        "start": 3047,
        "end": 3054
      },
      "text": "བུང་བས་ ༼སྣར། པེ།༽ བུང་བ་"
    },
    {
      "span": {
        "start": 3086,
        "end": 3093
      },
      "text": "ལྟ་བའི་ ༼སྣར། པེ།༽ བལྟ་བའི་"
    },
    {
      "span": {
        "start": 3144,
        "end": 3149
      },
      "text": "འཇིག་ ༼སྣར། པེ།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 3810,
        "end": 3818
      },
      "text": "འགྱུར་པ་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 4015,
        "end": 4025
      },
      "text": "མྱ་ངན་འདས་ ༼སྣར། པེ།༽ མྱ་ངན་"
    },
    {
      "span": {
        "start": 4261,
        "end": 4265
      },
      "text": "སྙེ་ ༼སྣར། པེ།༽ གཉེ་"
    }
  ]
}