{
  "durchens": [
    {
      "span": {
        "start": 55,
        "end": 58
      },
      "text": "ཀ ། ༼སྣར། པེ།༽ ཀཱ། །"
    },
    {
      "span": {
        "start": 112,
        "end": 114
      },
      "text": "བ། ༼སྣར། པེ།༽ བ་དཀོན་མཆོག་གསུམ་ལ་ཕྱག་འཚལ་ལོ། །"
    },
    {
      "span": {
        "start": 132,
        "end": 139
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ གྱུར་པ་ལ་ཕྱག་འཚལ་ལོ། །སློབ་དཔོན་འཕགས་པ་ཀླུ་སྒྲུབ་"
    },
    {
      "span": {
        "start": 149,
        "end": 154
      },
      "text": "ལོ། ། ༼སྣར། པེ།༽ །།"
    },
    {
      "span": {
        "start": 484,
        "end": 488
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 496,
        "end": 501
      },
      "text": "རྒྱུ་ ༼པེ།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 714,
        "end": 718
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ མེད།"
    },
    {
      "span": {
        "start": 1067,
        "end": 1075
      },
      "text": "འགྲུབ་པ། ༼སྣར། པེ།༽ འགྲུབ་པས།"
    },
    {
      "span": {
        "start": 1109,
        "end": 1115
      },
      "text": "དེ་ལྟ་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 1169,
        "end": 1174
      },
      "text": "ཁོ་ན་ ༼སྣར། པེ།༽ ཁོ་ནར་"
    },
    {
      "span": {
        "start": 1472,
        "end": 1478
      },
      "text": "སོ་སོ་ ༼སྣར། པེ།༽ སོ་སོར་"
    },
    {
      "span": {
        "start": 1578,
        "end": 1595
      },
      "text": "དེ་ནི་མེད་པར་ཡང་། ༼སྣར། པེ།༽ འབྲས་བུ་དེ་མེད་ཀྱང་།"
    },
    {
      "span": {
        "start": 1691,
        "end": 1701
      },
      "text": "རྐྱེན་གྱི་ ༼སྣར།༽ རྐྱེན་གྱིས་"
    },
    {
      "span": {
        "start": 2113,
        "end": 2119
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་ཕྱིར་"
    },
    {
      "span": {
        "start": 2164,
        "end": 2171
      },
      "text": "བགོམ་ལ་ ༼སྣར། པེ།༽ བགོམ་པ་"
    },
    {
      "span": {
        "start": 2464,
        "end": 2472
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 2568,
        "end": 2576
      },
      "text": "འགྲོ་པོ་ ༼སྣར། པེ།༽ འགྲོ་བ་"
    },
    {
      "span": {
        "start": 2636,
        "end": 2641
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 3079,
        "end": 3084
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 3117,
        "end": 3124
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 3241,
        "end": 3248
      },
      "text": "རྩོམ་པ་ ༼སྣར། པེ།༽ བརྩོམ་པ་"
    },
    {
      "span": {
        "start": 3720,
        "end": 3728
      },
      "text": "བགོམ་ལམ་ ༼སྣར། པེ།༽ བགོམ་ལས་"
    },
    {
      "span": {
        "start": 3983,
        "end": 3988
      },
      "text": "གྱུར་ ༼པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 4053,
        "end": 4061
      },
      "text": "འགྲོ་དང་ ༼སྣར།༽ འགྲོ་བར་"
    },
    {
      "span": {
        "start": 4086,
        "end": 4095
      },
      "text": "རྣམ་བརྟག་ ༼སྣར། པེ།༽ རྣམས་བརྟགས་"
    },
    {
      "span": {
        "start": 4240,
        "end": 4248
      },
      "text": "དེ་གཉིས་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 4391,
        "end": 4397
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 4494,
        "end": 4502
      },
      "text": "འགྲོ་པོ་ ༼སྣར།༽ འགྲོ་བ་"
    },
    {
      "span": {
        "start": 4708,
        "end": 4715
      },
      "text": "བྱ་བའང་ ༼པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 4801,
        "end": 4808
      },
      "text": "སྣོམ་པ་ ༼སྣར།༽ སྣམ་པ་"
    },
    {
      "span": {
        "start": 4808,
        "end": 4812
      },
      "text": "དང་། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 4814,
        "end": 4822
      },
      "text": "མྱོང་བར་ ༼སྣར། པེ།༽ མྱང་བར་"
    },
    {
      "span": {
        "start": 4889,
        "end": 4892
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 4926,
        "end": 4931
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 4955,
        "end": 4959
      },
      "text": "བདག་ ༼སྣར། པེ།༽ ལྟར་"
    },
    {
      "span": {
        "start": 4964,
        "end": 4969
      },
      "text": "ལྟ་བ། ༼སྣར། པེ།༽ ལྟ་བར།"
    },
    {
      "span": {
        "start": 4971,
        "end": 4977
      },
      "text": "དེ་དག་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 4977,
        "end": 4981
      },
      "text": "གཞན་ ༼སྣར། པེ།༽ གཞན་དག་"
    },
    {
      "span": {
        "start": 5030,
        "end": 5035
      },
      "text": "དཔེས་ ༼སྣར།༽ དཔས་"
    },
    {
      "span": {
        "start": 5063,
        "end": 5071
      },
      "text": "བསྒོམ་པ་ ༼སྣར། པེ།༽ བགོམ་པ་"
    },
    {
      "span": {
        "start": 5083,
        "end": 5086
      },
      "text": "ལྟ་ ༼སྣར། པེ།༽ ལྟར་"
    },
    {
      "span": {
        "start": 5265,
        "end": 5276
      },
      "text": "ལྟ་བ་པོའང་། ༼སྣར། པེ།༽ ལྟ་པོ་ཡང་།"
    },
    {
      "span": {
        "start": 5370,
        "end": 5374
      },
      "text": "བལྟ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 5398,
        "end": 5402
      },
      "text": "ཡོད། ༼སྣར། པེ།༽ ཡོདཇི་ལྟར་བ་དང་མ་དག་པ། །བརྟེན་ནས་བུ་ནི་འབྱུང་བཤད་པ། །དེ་བཞིན་མིག་དང་གཟུགས་བརྟེན་ནས། །རྣམ་པར་ཤེས་པ་འབྱུང་བར་བཤད།"
    },
    {
      "span": {
        "start": 5404,
        "end": 5408
      },
      "text": "བལྟ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 5411,
        "end": 5416
      },
      "text": "ལྟ་བ་ ༼སྣར། པེ།༽ བལྟ་བ་"
    },
    {
      "span": {
        "start": 5438,
        "end": 5444
      },
      "text": "ཤེས་པ་ ༼སྣར། པེ།༽ ཤེས་"
    },
    {
      "span": {
        "start": 5446,
        "end": 5451
      },
      "text": "སོགས་ ༼སྣར། པེ།༽ སོགས་པ་"
    },
    {
      "span": {
        "start": 5457,
        "end": 5461
      },
      "text": "ཡོད་ ༼སྣར།༽ ཡང་"
    },
    {
      "span": {
        "start": 5511,
        "end": 5517
      },
      "text": "ལྟ་བས་ ༼སྣར།༽ སྣ་བས་"
    },
    {
      "span": {
        "start": 5536,
        "end": 5544
      },
      "text": "མྱོང་བར་ ༼སྣར། པེ།༽ མྱང་བར་"
    },
    {
      "span": {
        "start": 5860,
        "end": 5865
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 6236,
        "end": 6240
      },
      "text": "འགའ་ ༼སྣར།༽ འགལ་"
    },
    {
      "span": {
        "start": 6456,
        "end": 6465
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 6503,
        "end": 6510
      },
      "text": "བྱས་ཏེ། ༼སྣར། པེ།༽ བྱས་ཚེ།"
    },
    {
      "span": {
        "start": 6541,
        "end": 6548
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 6593,
        "end": 6599
      },
      "text": "འགྱུར། ༼སྣར།༽ འགྱུར་རོ།"
    },
    {
      "span": {
        "start": 6662,
        "end": 6669
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 6844,
        "end": 6847
      },
      "text": "སྔ་ ༼སྣར། པེ།༽ སྔར་"
    },
    {
      "span": {
        "start": 7287,
        "end": 7299
      },
      "text": "མ་གཏོགས་པའི། ༼སྣར། པེ།༽ མ་གཏོགས་པ།"
    },
    {
      "span": {
        "start": 7547,
        "end": 7553
      },
      "text": "མཚུངས། ༼སྣར།༽ མཚུང་།"
    },
    {
      "span": {
        "start": 7614,
        "end": 7617
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 7764,
        "end": 7770
      },
      "text": "བརྟེན་ ༼ཅོ། སྡེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 7840,
        "end": 7845
      },
      "text": "ནའང་། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 7950,
        "end": 7954
      },
      "text": "དག ། ༼པེ།༽ དང་། །"
    },
    {
      "span": {
        "start": 8018,
        "end": 8025
      },
      "text": "ལྟོས་པ་ ༼སྣར། པེ།༽ བལྟོས་པ་"
    },
    {
      "span": {
        "start": 8061,
        "end": 8068
      },
      "text": "མེད་དེ། ༼སྣར། པེ།༽ མིན་ཏེ།"
    },
    {
      "span": {
        "start": 8183,
        "end": 8189
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 8192,
        "end": 8195
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེར་"
    },
    {
      "span": {
        "start": 8340,
        "end": 8342
      },
      "text": "ན་ ༼སྣར།༽ ནི་"
    },
    {
      "span": {
        "start": 8408,
        "end": 8413
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 8539,
        "end": 8548
      },
      "text": "གྲུབ་པའི་ ༼སྣར། པེ།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 8613,
        "end": 8621
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ དངོས་པོར་"
    },
    {
      "span": {
        "start": 8934,
        "end": 8941
      },
      "text": "ཅི་སྟེ་ ༼སྣར། པེ།༽ ཇི་སྟེ་"
    },
    {
      "span": {
        "start": 8991,
        "end": 8996
      },
      "text": "སྐྱེ་ ༼པེ།༽ སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 8998,
        "end": 9008
      },
      "text": "སོགས་གསུམ་ ༼སྣར།༽ སོགས་སུ་ ༼པེ།༽ སོགས་"
    },
    {
      "span": {
        "start": 9175,
        "end": 9189
      },
      "text": "ཐུག་མེད་འགྱུར། ༼སྣར། པེ།༽ ཐུག་པ་མེད།"
    },
    {
      "span": {
        "start": 9235,
        "end": 9243
      },
      "text": "རྩ་བ་ཡི། ༼སྣར། པེ།༽ རྩ་བ་ཡིས།"
    },
    {
      "span": {
        "start": 9499,
        "end": 9505
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 9652,
        "end": 9661
      },
      "text": "སྐྱེད་པར་ ༼སྣར། པེ།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 9682,
        "end": 9688
      },
      "text": "མར་མེ་ ༼སྣར། པེ།༽ མར་མེས་"
    },
    {
      "span": {
        "start": 9773,
        "end": 9784
      },
      "text": "བྱེད་ཡིན་ན། ༼སྣར། པེ།༽ བྱེད་པ་ཡིན།"
    },
    {
      "span": {
        "start": 9804,
        "end": 9806
      },
      "text": "ན། ༼སྣར།༽ ནི།"
    },
    {
      "span": {
        "start": 10078,
        "end": 10084
      },
      "text": "གནས་པ་ ༼སྣར། པེ།༽ འདུག་པ་"
    },
    {
      "span": {
        "start": 10088,
        "end": 10092
      },
      "text": "སེལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 10263,
        "end": 10269
      },
      "text": "སྐྱེད། ༼སྣར། པེ།༽ བསྐྱེད།"
    },
    {
      "span": {
        "start": 10380,
        "end": 10386
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 10390,
        "end": 10393
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 10512,
        "end": 10518
      },
      "text": "བརྟེན་ ༼ཅོ། སྡེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 10566,
        "end": 10574
      },
      "text": "འབྱུང་བ་ ༼སྣར།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 10853,
        "end": 10886
      },
      "text": "། །གང་ཞིག་གིས་ནི་སྐྱེད་པར་བྱེད། ། ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 10913,
        "end": 10922
      },
      "text": "དེ་སྐྱེད་ ༼སྣར། པེ།༽ དེས་བསྐྱེད་"
    },
    {
      "span": {
        "start": 11035,
        "end": 11042
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 11502,
        "end": 11513
      },
      "text": "འཆི་མེད་པར། ༼སྣར། པེ།༽ འཆི་མེད་པའི།"
    },
    {
      "span": {
        "start": 11538,
        "end": 11542
      },
      "text": "ཡོད། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 11661,
        "end": 11668
      },
      "text": "འགག་པར་ ༼སྣར། པེ།༽ བགགས་པར་"
    },
    {
      "span": {
        "start": 11880,
        "end": 11887
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 12286,
        "end": 12290
      },
      "text": "གཅད་ ༼སྣར།༽ བཅད་"
    },
    {
      "span": {
        "start": 12312,
        "end": 12318
      },
      "text": "འགག་པ་ ༼སྣར། པེ།༽ འགག་པར་"
    },
    {
      "span": {
        "start": 12402,
        "end": 12410
      },
      "text": "སྐྱེད་པ་ ༼སྣར། པེ།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 12500,
        "end": 12503
      },
      "text": "པས། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 12526,
        "end": 12532
      },
      "text": "འགྲུབ། ༼སྣར། པེ།༽ གྲུབ།"
    },
    {
      "span": {
        "start": 12959,
        "end": 12966
      },
      "text": "གྱུར་པ། ༼སྣར། པེ།༽ གྱུར་པས།"
    },
    {
      "span": {
        "start": 13298,
        "end": 13308
      },
      "text": "འགྱུར་བའི་ ༼སྣར། པེ།༽ གྱུར་པའི་"
    },
    {
      "span": {
        "start": 13325,
        "end": 13328
      },
      "text": "དག་ ༼སྣར།༽ དང་"
    },
    {
      "span": {
        "start": 13392,
        "end": 13399
      },
      "text": "གྱུར་པ། ༼སྣར། པེ།༽ གྱུར་པས།"
    },
    {
      "span": {
        "start": 13419,
        "end": 13427
      },
      "text": "བྱེད་དེ། ༼སྣར། པེ།༽ བྱེད་དོ།"
    },
    {
      "span": {
        "start": 13620,
        "end": 13626
      },
      "text": "བཅས་པ་ ༼སྣར། པེ།༽ བཅས་པས་"
    },
    {
      "span": {
        "start": 13820,
        "end": 13824
      },
      "text": "པོར་ ༼སྣར།༽ པོར་མ་"
    },
    {
      "span": {
        "start": 13874,
        "end": 13878
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིར་"
    },
    {
      "span": {
        "start": 13902,
        "end": 13910
      },
      "text": "བསྟན་པས་ ༼སྣར། པེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 13922,
        "end": 13929
      },
      "text": "བྱེད་པ་ ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 13932,
        "end": 13935
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལས་ལ་"
    },
    {
      "span": {
        "start": 14003,
        "end": 14005
      },
      "text": "པ། ༼སྣར། པེ།༽ པར།"
    },
    {
      "span": {
        "start": 14007,
        "end": 14017
      },
      "text": "འགྲུབ་པའི་ ༼སྣར། པེ།༽ གྲུབ་པའི་"
    },
    {
      "span": {
        "start": 14072,
        "end": 14084
      },
      "text": "བྱེད་པོ་བསལ་ ༼སྣར། པེ།༽ བྱེད་པོས་གསལ་"
    },
    {
      "span": {
        "start": 14094,
        "end": 14101
      },
      "text": "བྱེད་པ་ ༼སྣར།༽ བྱེད་པོ་"
    },
    {
      "span": {
        "start": 14127,
        "end": 14133
      },
      "text": "ལྷག་མ་ ༼སྣར། པེ།༽ ལྷག་མའང་"
    },
    {
      "span": {
        "start": 14446,
        "end": 14454
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར། པེ།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 14628,
        "end": 14635
      },
      "text": "གསལ་བར་ ༼སྣར། པེ།༽ བསལ་བར་"
    },
    {
      "span": {
        "start": 14656,
        "end": 14663
      },
      "text": "གསལ་བར་ ༼སྣར། པེ།༽ བསལ་བར་"
    },
    {
      "span": {
        "start": 14886,
        "end": 14895
      },
      "text": "རེ་རེ་ཡི། ༼སྣར།༽ རེ་རེ་ཡིས།"
    },
    {
      "span": {
        "start": 14953,
        "end": 14962
      },
      "text": "ཚོར་པོའང་ ༼སྣར། པེ།༽ ཚོར་པོ་"
    },
    {
      "span": {
        "start": 14969,
        "end": 14971
      },
      "text": "ན། ༼པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 15202,
        "end": 15210
      },
      "text": "དེ་ལའང་། ༼ཅོ།༽ དེ་ཡང་ ༼སྡེ།༽ ལང་།"
    },
    {
      "span": {
        "start": 15786,
        "end": 15792
      },
      "text": "འབར་བ་ ༼སྣར། པེ།༽ འབར་བ་ཉིད་"
    },
    {
      "span": {
        "start": 15796,
        "end": 15801
      },
      "text": "ན་ནི། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 15911,
        "end": 15918
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 15969,
        "end": 15977
      },
      "text": "སྲེག་པར་ ༼སྣར།༽ སྲེད་པར་"
    },
    {
      "span": {
        "start": 16143,
        "end": 16150
      },
      "text": "ཕྲད་དུ་ ༼སྣར། པེ།༽ ཕྲད་པར་"
    },
    {
      "span": {
        "start": 16210,
        "end": 16215
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 16332,
        "end": 16336
      },
      "text": "མེད་ ༼སྣར། པེ།༽ མེ་"
    },
    {
      "span": {
        "start": 16353,
        "end": 16365
      },
      "text": "དང་པོར་གྲུབ་ ༼སྣར།༽ དང་པོ་གྲུབ་ ༼པེ།༽ དང་པོ་དྲུག་"
    },
    {
      "span": {
        "start": 16409,
        "end": 16416
      },
      "text": "གྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 16464,
        "end": 16474
      },
      "text": "མེད་པར་ནི་ ༼སྣར། པེ།༽ མེད་པར་ཡང་"
    },
    {
      "span": {
        "start": 16510,
        "end": 16516
      },
      "text": "འགྲུབ། ༼སྣར། པེ།༽ གྲུབ།"
    },
    {
      "span": {
        "start": 16612,
        "end": 16617
      },
      "text": "གྲུབ་ ༼སྣར། པེ།༽ འགྲུབ་"
    },
    {
      "span": {
        "start": 16902,
        "end": 16910
      },
      "text": "བགོམ་པས་ ༼སྣར།༽ བསྒོམས་པས་ ༼པེ།༽ བསྒོམ་པས་"
    },
    {
      "span": {
        "start": 16953,
        "end": 16955
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལའང་"
    },
    {
      "span": {
        "start": 17050,
        "end": 17058
      },
      "text": "ལེན་པའི་ ༼སྣར། པེ།༽ བླང་བའི་"
    },
    {
      "span": {
        "start": 17152,
        "end": 17159
      },
      "text": "དེ་བཅས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 17159,
        "end": 17163
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ ཉིད་ཅེས་"
    },
    {
      "span": {
        "start": 17297,
        "end": 17302
      },
      "text": "མངོན་ ༼སྣར། པེ།༽ སྔོན་"
    },
    {
      "span": {
        "start": 17361,
        "end": 17372
      },
      "text": "མཐའ་མེད་དེ། ༼སྣར། པེ།༽ ཐ་མ་མ་མེད།"
    },
    {
      "span": {
        "start": 17405,
        "end": 17417
      },
      "text": "ཐོག་མེད་མཐའ་ ༼སྣར། པེ།༽ ཐོག་མ་ཐ་"
    },
    {
      "span": {
        "start": 17421,
        "end": 17424
      },
      "text": "པར། ༼སྣར། པེ།༽ པ།"
    },
    {
      "span": {
        "start": 17532,
        "end": 17536
      },
      "text": "ཕྱི་ ༼སྣར། པེ།༽ འཕྱི་"
    },
    {
      "span": {
        "start": 17619,
        "end": 17625
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 17635,
        "end": 17640
      },
      "text": "སྔ་བ་ ༼ཅོ།༽ སྔ་མ་"
    },
    {
      "span": {
        "start": 17819,
        "end": 17821
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 17967,
        "end": 17971
      },
      "text": "ཀྱི། ༼སྣར། པེ།༽ དེ།"
    },
    {
      "span": {
        "start": 18255,
        "end": 18262
      },
      "text": "གཉི་གས་ ༼སྣར། པེ།༽ གཉིས་ཀས་"
    },
    {
      "span": {
        "start": 18282,
        "end": 18291
      },
      "text": "འབྱུང་བར་ ༼སྣར། པེ།༽ བྱུང་བར་"
    },
    {
      "span": {
        "start": 18399,
        "end": 18406
      },
      "text": "འདི་དག་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 18474,
        "end": 18477
      },
      "text": "དེ་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 18480,
        "end": 18484
      },
      "text": "འདི་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 18635,
        "end": 18638
      },
      "text": "ནི། ༼སྣར། པེ།༽ དེ།"
    },
    {
      "span": {
        "start": 18753,
        "end": 18756
      },
      "text": "དེ། ༼སྣར། པེ།༽ དེས།"
    },
    {
      "span": {
        "start": 18866,
        "end": 18870
      },
      "text": "གཞན། ༼སྣར།༽ བཞན།"
    },
    {
      "span": {
        "start": 19146,
        "end": 19151
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 19281,
        "end": 19288
      },
      "text": "ཡིན་པར་ ༼སྣར། པེ།༽ ཡིན་པ་"
    },
    {
      "span": {
        "start": 19315,
        "end": 19318
      },
      "text": "དག་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 19463,
        "end": 19469
      },
      "text": "སླུ་བ་ ༼སྣར། པེ།༽ བསླུ་བ་"
    },
    {
      "span": {
        "start": 19508,
        "end": 19516
      },
      "text": "སླུ་བའི་ ༼སྣར། པེ།༽ བསླུ་བའི་"
    },
    {
      "span": {
        "start": 19553,
        "end": 19557
      },
      "text": "སླུ་ ༼སྣར། པེ།༽ བསླུ་"
    },
    {
      "span": {
        "start": 19592,
        "end": 19596
      },
      "text": "སླུ། ༼སྣར། པེ།༽ བསླུ།"
    },
    {
      "span": {
        "start": 19851,
        "end": 19879
      },
      "text": "གཞན་དུ་འགྱུར་བར་ཇི་ལྟར་རུང་། ༼སྣར། པེ།༽ ཇི་ལྟ་བུར་ན་གཞན་དུ་འགྱུར།"
    },
    {
      "span": {
        "start": 20005,
        "end": 20011
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 20123,
        "end": 20130
      },
      "text": "སྟོང་པ་ ༼སྣར། པེ།༽ སྟོང་པའང་"
    },
    {
      "span": {
        "start": 20179,
        "end": 20186
      },
      "text": "སྟོང་པ་ ༼སྣར། པེ།༽ སྟོང་པའང་"
    },
    {
      "span": {
        "start": 20583,
        "end": 20597
      },
      "text": "གསུམ་ཉིད་ཀྱིས། ༼སྣར། པེ།༽ གསུམ་གྱིས་སོ།"
    },
    {
      "span": {
        "start": 21101,
        "end": 21108
      },
      "text": "གཞན་ནམ་ ༼སྣར།༽ གཞན་མ་"
    },
    {
      "span": {
        "start": 21155,
        "end": 21158
      },
      "text": "དང་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 21162,
        "end": 21165
      },
      "text": "ཡང་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 21315,
        "end": 21324
      },
      "text": "འབྱུང་བར་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 21684,
        "end": 21687
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ནི་གཞན་"
    },
    {
      "span": {
        "start": 21687,
        "end": 21695
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ དངོས་"
    },
    {
      "span": {
        "start": 21991,
        "end": 21995
      },
      "text": "ཀ་ཏ་ ༼སྣར། པེ།༽ ཀཱ་ཏྱཱ་"
    },
    {
      "span": {
        "start": 22036,
        "end": 22045
      },
      "text": "གཉིས་ཀའང་ ༼སྣར། པེ།༽ གཉིས་ཀ་"
    },
    {
      "span": {
        "start": 22049,
        "end": 22055
      },
      "text": "པ་མཛད། ༼སྣར། པེ།༽ པར་གསུངས།"
    },
    {
      "span": {
        "start": 22226,
        "end": 22232
      },
      "text": "ཡོད་པ་ ༼སྣར། པེ།༽ ཡོད་པ་མ་"
    },
    {
      "span": {
        "start": 22232,
        "end": 22238
      },
      "text": "ཡིན་ན་ ༼པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 22273,
        "end": 22277
      },
      "text": "ཡོད་ ༼སྣར།༽ ཡིད་"
    },
    {
      "span": {
        "start": 22420,
        "end": 22425
      },
      "text": "རྟག ། ༼སྣར། པེ།༽ བརྟག །"
    },
    {
      "span": {
        "start": 23292,
        "end": 23300
      },
      "text": "བགོམ་པས་ ༼སྣར།༽ བསྒོམས་པས་ ༼པེ།༽ བསྒོམ་པས་"
    },
    {
      "span": {
        "start": 23888,
        "end": 23895
      },
      "text": "དེ་བདག་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 24034,
        "end": 24041
      },
      "text": "ངག་གིར་ ༼སྣར། པེ།༽ ངག་གི་"
    },
    {
      "span": {
        "start": 24053,
        "end": 24060
      },
      "text": "བསྐྱོད་ ༼སྣར། པེ།༽ སྤྱོད་"
    },
    {
      "span": {
        "start": 24159,
        "end": 24164
      },
      "text": "འདོར། ༼སྣར། པེ།༽ འདོད།"
    },
    {
      "span": {
        "start": 24229,
        "end": 24236
      },
      "text": "སེམས་པ་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 24379,
        "end": 24388
      },
      "text": "སྐྱེད་པར་ ༼སྣར། པེ།༽ བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 24578,
        "end": 24588
      },
      "text": "འབྲས་བུའི་ ༼སྣར། པེ།༽ འབྲས་བུ་"
    },
    {
      "span": {
        "start": 24777,
        "end": 24786
      },
      "text": "རྒྱུན་ལས་ ༼སྣར། པེ།༽ རྒྱུ་ལས་"
    },
    {
      "span": {
        "start": 24988,
        "end": 24995
      },
      "text": "བརྟག་པ་ ༼སྣར། པེ།༽ རྟག་པ་"
    },
    {
      "span": {
        "start": 24999,
        "end": 25005
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 25048,
        "end": 25055
      },
      "text": "བརྟག་པ་ ༼སྣར། པེ།༽ རྟག་པ་"
    },
    {
      "span": {
        "start": 25198,
        "end": 25208
      },
      "text": "། །ཇི་ལྟར་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 25212,
        "end": 25216
      },
      "text": "རྒྱ་ ༼སྣར། པེ།༽ རྒྱ་ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 25333,
        "end": 25342
      },
      "text": "བསྒོམ་པས་ ༼སྣར། པེ།༽ བགོམ་པས་"
    },
    {
      "span": {
        "start": 25402,
        "end": 25411
      },
      "text": "སྐྱེད་པར་ ༼སྣར། པེ།༽ བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 25425,
        "end": 25433
      },
      "text": "སྤོང་བས་ ༼སྣར། པེ།༽ སྤོང་བ་"
    },
    {
      "span": {
        "start": 25448,
        "end": 25454
      },
      "text": "འཕོ་བ་ ༼སྣར། པེ།༽ འཕོས་པ་"
    },
    {
      "span": {
        "start": 25616,
        "end": 25624
      },
      "text": "གཅིག་པོ་ ༼སྣར། པེ།༽ གཅིག་པུ་"
    },
    {
      "span": {
        "start": 25674,
        "end": 25682
      },
      "text": "ཀུན་གྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 25919,
        "end": 25924
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 26167,
        "end": 26173
      },
      "text": "རྟག་ལ་ ༼སྣར། པེ།༽ རྟག་པར་"
    },
    {
      "span": {
        "start": 26192,
        "end": 26199
      },
      "text": "ཅི་སྟེ་ ༼སྣར། པེ།༽ ཇི་སྟེ་"
    },
    {
      "span": {
        "start": 26753,
        "end": 26765
      },
      "text": "བསྒྲིབས་པའི་ ༼སྣར། པེ།༽ སྒྲིབ་པའི་"
    },
    {
      "span": {
        "start": 26788,
        "end": 26794
      },
      "text": "དེ་མི་ ༼སྣར། པེ།༽ དེ་ནི་"
    },
    {
      "span": {
        "start": 26839,
        "end": 26845
      },
      "text": "དེ་ཡང་ ༼སྣར། པེ།༽ དེ་དང་"
    },
    {
      "span": {
        "start": 26940,
        "end": 26943
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 26995,
        "end": 27001
      },
      "text": "སྐྱེས་ ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 27019,
        "end": 27026
      },
      "text": "ཅི་སྟེ་ ༼སྣར། པེ།༽ ཇི་སྟེ་"
    },
    {
      "span": {
        "start": 27153,
        "end": 27155
      },
      "text": "ན། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 27416,
        "end": 27419
      },
      "text": "ལས་ ༼སྣར།༽ ལས་དང་འབྲས་བུ་"
    },
    {
      "span": {
        "start": 27691,
        "end": 27694
      },
      "text": "ངར་ ༼སྣར།༽ ང་"
    },
    {
      "span": {
        "start": 28031,
        "end": 28036
      },
      "text": "བཏགས་ ༼སྣར། པེ།༽ བརྟགས་"
    },
    {
      "span": {
        "start": 28385,
        "end": 28393
      },
      "text": "སྤྲོས་པ་ ༼ཅོ། སྡེ།༽ སྤོས་པ་"
    },
    {
      "span": {
        "start": 28405,
        "end": 28411
      },
      "text": "སྤྲོས་ ༼ཅོ། སྡེ།༽ སྤོས་"
    },
    {
      "span": {
        "start": 28437,
        "end": 28441
      },
      "text": "མེད། ༼སྣར། པེ།༽ མིན།"
    },
    {
      "span": {
        "start": 28483,
        "end": 28492
      },
      "text": "གང་འབྱུང་ ༼སྣར། པེ།༽ གང་བྱུང་"
    },
    {
      "span": {
        "start": 28538,
        "end": 28547
      },
      "text": "ཡིན་ཕྱིར། ༼སྣར། པེ།༽ ཡིན་པ།"
    },
    {
      "span": {
        "start": 28628,
        "end": 28638
      },
      "text": "གྱུར་པ་དེ། ༼སྣར། པེ།༽ གྱུར་པ་སྟེ།"
    },
    {
      "span": {
        "start": 28738,
        "end": 28751
      },
      "text": "ཟད་གྱུར་ཀྱང་། ༼སྣར། པེ།༽ ཟད་པ་ན།"
    },
    {
      "span": {
        "start": 28781,
        "end": 28788
      },
      "text": "སྟོན་པ་ ༼སྣར།༽ བརྟན་པ་ ༼པེ།༽ བརྟེན་པ་"
    },
    {
      "span": {
        "start": 28808,
        "end": 28819
      },
      "text": "བདག་དང་ཆོས་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 29376,
        "end": 29381
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 29828,
        "end": 29835
      },
      "text": "ཚོགས་ལ་ ༼སྣར། པེ།༽ ཚོགས་པ་"
    },
    {
      "span": {
        "start": 30190,
        "end": 30194
      },
      "text": "འགག་ ༼སྣར། པེ།༽ འགགས་"
    },
    {
      "span": {
        "start": 30320,
        "end": 30329
      },
      "text": "སྐྱེད་པར་ ༼སྣར། པེ།༽ བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 30329,
        "end": 30334
      },
      "text": "བྱེད་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 30667,
        "end": 30673
      },
      "text": "སྐྱེད། ༼སྣར། པེ།༽ སྐྱེ།"
    },
    {
      "span": {
        "start": 30735,
        "end": 30738
      },
      "text": "ཅི་ ༼སྣར། པེ།༽ སྐྱེ། ཇི་"
    },
    {
      "span": {
        "start": 30779,
        "end": 30788
      },
      "text": "སྐྱེད་པར་ ༼སྣར། པེ།༽ བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 30866,
        "end": 30868
      },
      "text": "པ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 30925,
        "end": 30933
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 31033,
        "end": 31041
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 31142,
        "end": 31150
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 31224,
        "end": 31230
      },
      "text": "སྐྱེད། ༼སྣར། པེ།༽ བསྐྱེད།"
    },
    {
      "span": {
        "start": 31280,
        "end": 31286
      },
      "text": "སྐྱེད། ༼སྣར། པེ།༽ བསྐྱེད།"
    },
    {
      "span": {
        "start": 31357,
        "end": 31366
      },
      "text": "འབྲས་བུས་ ༼སྣར། པེ།༽ འབྲས་བུ་"
    },
    {
      "span": {
        "start": 31796,
        "end": 31812
      },
      "text": "སྐྱེད་བྱེད་གཅིག་ ༼སྣར། པེ།༽ སྐྱེད་བྱེད་ཅིག་"
    },
    {
      "span": {
        "start": 31927,
        "end": 31936
      },
      "text": "སྐྱེད་པར་ ༼སྣར། པེ།༽ བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 31936,
        "end": 31941
      },
      "text": "བྱེད། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 32157,
        "end": 32164
      },
      "text": "དེ་ཡིན་ ༼སྣར། པེ།༽ དེ་ཡིས་"
    },
    {
      "span": {
        "start": 32169,
        "end": 32177
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 32188,
        "end": 32194
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 32681,
        "end": 32690
      },
      "text": "དུས་གཅིག་ ༼སྣར། པེ།༽ དུས་ཅིག་"
    },
    {
      "span": {
        "start": 32895,
        "end": 32904
      },
      "text": "དུས་གཅིག་ ༼སྣར། པེ།༽ ལྷན་ཅིག་"
    },
    {
      "span": {
        "start": 33037,
        "end": 33039
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 33056,
        "end": 33070
      },
      "text": "། །མ་ཟད་པ་ལའང་ ༼སྣར། པེ།༽ མ་ཟད་པའང་"
    },
    {
      "span": {
        "start": 33105,
        "end": 33119
      },
      "text": "། །མ་ཟད་པ་ལའང་ ༼སྣར། པེ།༽ མ་ཟད་པའང་"
    },
    {
      "span": {
        "start": 33299,
        "end": 33303
      },
      "text": "ལའང་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 33374,
        "end": 33381
      },
      "text": "ཉིད་དུ་ ༼སྣར། པེ།༽ ཉིད་ནི་"
    },
    {
      "span": {
        "start": 33804,
        "end": 33811
      },
      "text": "བླངས་ན། ༼སྣར། པེ།༽ བླངས་ནས།"
    },
    {
      "span": {
        "start": 33826,
        "end": 33832
      },
      "text": "ལྟ་བར་ ༼སྣར། པེ།༽ ལྟ་བ་"
    },
    {
      "span": {
        "start": 33982,
        "end": 33986
      },
      "text": "གི ། ༼སྣར། པེ།༽ གིས། །"
    },
    {
      "span": {
        "start": 34016,
        "end": 34032
      },
      "text": "འབྲས་བུ་རྒྱུ་ཡི་ ༼སྣར། པེ།༽ གལ་ཏེ་འབྲས་རྒྱུ་"
    },
    {
      "span": {
        "start": 34047,
        "end": 34053
      },
      "text": "རྒྱུན་ ༼སྣར། པེ།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 34067,
        "end": 34073
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 34362,
        "end": 34366
      },
      "text": "འགག་ ༼སྣར། པེ།༽ འགགས་"
    },
    {
      "span": {
        "start": 34439,
        "end": 34449
      },
      "text": "བཞིན་པ་ཡང་ ༼སྣར། པེ།༽ བཞིན་པ་དང་"
    },
    {
      "span": {
        "start": 34470,
        "end": 34474
      },
      "text": "འགག་ ༼སྣར། པེ།༽ འགགས་"
    },
    {
      "span": {
        "start": 34504,
        "end": 34507
      },
      "text": "ཡང་ ༼སྣར། པེ།༽ ཡང་མི་"
    },
    {
      "span": {
        "start": 34507,
        "end": 34516
      },
      "text": "རིགས་མིན་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 34551,
        "end": 34558
      },
      "text": "སྐྱེ་བ་ ༼སྣར། པེ།༽ སྐྱེ་བའམ་"
    },
    {
      "span": {
        "start": 34612,
        "end": 34618
      },
      "text": "རྒྱུན་ ༼སྣར། པེ།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 34700,
        "end": 34707
      },
      "text": "འཇིག་པ་ ༼སྣར། པེ།༽ འཇིག་"
    },
    {
      "span": {
        "start": 34796,
        "end": 34803
      },
      "text": "མེད་དེ་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 34803,
        "end": 34807
      },
      "text": "དེར་ ༼སྣར། པེ།༽ དེར་དེ་"
    },
    {
      "span": {
        "start": 35009,
        "end": 35016
      },
      "text": "དེ་བདག་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 35179,
        "end": 35185
      },
      "text": "གཏོགས་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 35193,
        "end": 35202
      },
      "text": "གཤེགས་དེ་ ༼སྣར། པེ།༽ གཤེགས་པ་"
    },
    {
      "span": {
        "start": 35275,
        "end": 35280
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 35395,
        "end": 35401
      },
      "text": "མིན་ན། ༼སྣར། པེ།༽ མིན་པ།"
    },
    {
      "span": {
        "start": 35462,
        "end": 35469
      },
      "text": "ལེན་པར་ ༼སྣར། པེ།༽ ལེན་པ་"
    },
    {
      "span": {
        "start": 35484,
        "end": 35490
      },
      "text": "ཉེ་བར་ ༼སྣར།༽ ཉེ་བ་"
    },
    {
      "span": {
        "start": 35496,
        "end": 35505
      },
      "text": "མེད་པ་ཡི། ༼སྣར། པེ།༽ མེད་པ་ཡིས།"
    },
    {
      "span": {
        "start": 35656,
        "end": 35662
      },
      "text": "བླང་བ་ ༼སྣར། པེ།༽ བླངས་པ་"
    },
    {
      "span": {
        "start": 35826,
        "end": 35833
      },
      "text": "སྟོང་པ། ༼སྣར། པེ།༽ སྟོང་པར།"
    },
    {
      "span": {
        "start": 35845,
        "end": 35847
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 35872,
        "end": 35880
      },
      "text": "ཞེས་ཀྱང་ ༼སྣར། པེ།༽ ཞེས་ནི་"
    },
    {
      "span": {
        "start": 36125,
        "end": 36130
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 36337,
        "end": 36343
      },
      "text": "མེད་ལ་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 37012,
        "end": 37016
      },
      "text": "འགའ་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 37332,
        "end": 37335
      },
      "text": "དག་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 37447,
        "end": 37454
      },
      "text": "དག་འབའ་ ༼སྣར།༽ དང་འབའ་ ༼པེ།༽ དང་འགའ་"
    },
    {
      "span": {
        "start": 37689,
        "end": 37694
      },
      "text": "ལ་མི་ ༼སྣར། པེ།༽ ལ་མ་"
    },
    {
      "span": {
        "start": 37744,
        "end": 37750
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 37794,
        "end": 37802
      },
      "text": "སྡུག་མི་ ༼སྣར། པེ།༽ སྡུག་མ་"
    },
    {
      "span": {
        "start": 37930,
        "end": 37937
      },
      "text": "ཡོད་པར་ ༼སྣར། པེ།༽ འབྱུང་བར་"
    },
    {
      "span": {
        "start": 38041,
        "end": 38047
      },
      "text": "ལོག་པ་ ༼སྣར། པེ།༽ ལོག་མ་"
    },
    {
      "span": {
        "start": 38262,
        "end": 38270
      },
      "text": "ལོག་པའམ་ ༼སྣར། པེ།༽ ལོག་པའང་"
    },
    {
      "span": {
        "start": 38349,
        "end": 38354
      },
      "text": "ཅི་མ་ ༼སྣར། པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 38354,
        "end": 38358
      },
      "text": "ལོག་ ༼སྣར། པེ།༽ ལོག་མ་"
    },
    {
      "span": {
        "start": 38408,
        "end": 38416
      },
      "text": "སྲིད་དེ། ༼སྣར། པེ།༽ སྲིད་དོ།"
    },
    {
      "span": {
        "start": 38430,
        "end": 38440
      },
      "text": "ཏུ་མ་གྱུར་ ༼སྣར། པེ།༽ ཏུ་འགྱུར་བཞིན་"
    },
    {
      "span": {
        "start": 38462,
        "end": 38470
      },
      "text": "སྲིད་དེ། ༼སྣར། པེ།༽ སྲིད་དོ།"
    },
    {
      "span": {
        "start": 38497,
        "end": 38499
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལའང་།"
    },
    {
      "span": {
        "start": 38519,
        "end": 38527
      },
      "text": "སྲིད་དེ། ༼སྣར། པེ།༽ སྲིད་དོ།"
    },
    {
      "span": {
        "start": 38715,
        "end": 38724
      },
      "text": "སྐྱེ་སྟེ། ༼སྣར། པེ།༽ བསྐྱེད་དེ།"
    },
    {
      "span": {
        "start": 39048,
        "end": 39055
      },
      "text": "འགག་པར་ ༼སྣར། པེ།༽ འགགས་པར་"
    },
    {
      "span": {
        "start": 39077,
        "end": 39082
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 39145,
        "end": 39151
      },
      "text": "གང་དག་ ༼སྣར། པེ།༽ གང་དག་ལ་ལའི་ཉོན་མོངས་པ།།གང་དག་"
    },
    {
      "span": {
        "start": 39557,
        "end": 39564
      },
      "text": "སྤོང་བ་ ༼སྣར། པེ།༽ སྤང་བ་"
    },
    {
      "span": {
        "start": 39570,
        "end": 39575
      },
      "text": "སྒོམ་ ༼སྣར། པེ།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 39996,
        "end": 39998
      },
      "text": "པ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 40280,
        "end": 40288
      },
      "text": "དོན་གྱི་ ༼སྣར། པེ།༽ དོན་གྱིས་"
    },
    {
      "span": {
        "start": 40312,
        "end": 40324
      },
      "text": "དེ་གཉིས་ཀྱི། ༼སྣར། པེ།༽ དེ་ཉིད་ཀྱིས།"
    },
    {
      "span": {
        "start": 40388,
        "end": 40399
      },
      "text": "དེ་ཉིད་རྣམ་ ༼སྣར། པེ།༽ དེ་དག་རྣམས་"
    },
    {
      "span": {
        "start": 40527,
        "end": 40531
      },
      "text": "བལྟ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 40562,
        "end": 40568
      },
      "text": "འགྱུར། ༼སྣར། པེ།༽ བྱེད།"
    },
    {
      "span": {
        "start": 40585,
        "end": 40590
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 40600,
        "end": 40604
      },
      "text": "རིག་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 40616,
        "end": 40626
      },
      "text": "བསྒྲུབས་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 40829,
        "end": 40831
      },
      "text": "པ། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 40936,
        "end": 40947
      },
      "text": "ཐམས་ཅད་རུང་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 40947,
        "end": 40950
      },
      "text": "མི་ ༼སྣར། པེ།༽ མི་རུང་"
    },
    {
      "span": {
        "start": 40963,
        "end": 40969
      },
      "text": "ནི་རང་ ༼སྣར། པེ།༽ ཉིད་རང་"
    },
    {
      "span": {
        "start": 41116,
        "end": 41119
      },
      "text": "ལྟ་ ༼སྣར། པེ།༽ བལྟ་"
    },
    {
      "span": {
        "start": 41178,
        "end": 41183
      },
      "text": "ལྟའོ། ༼སྣར། པེ།༽ བལྟའོ།"
    },
    {
      "span": {
        "start": 41307,
        "end": 41322
      },
      "text": "བར་འབྱུང་བ་གང་། ༼སྣར། པེ།༽ འབྱུང་གང་ཡིན་པ།"
    },
    {
      "span": {
        "start": 41413,
        "end": 41418
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 41727,
        "end": 41729
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 41883,
        "end": 41885
      },
      "text": "ན། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 41911,
        "end": 41924
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་ཉིད་"
    },
    {
      "span": {
        "start": 41943,
        "end": 41950
      },
      "text": "འགོག་ལ་ ༼སྣར། པེ།༽ འགོག་པ་"
    },
    {
      "span": {
        "start": 41994,
        "end": 42001
      },
      "text": "སྒོམ་པ་ ༼སྣར། པེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 42022,
        "end": 42029
      },
      "text": "ཅི་སྟེ་ ༼སྣར། པེ།༽ ཇི་སྟེ་"
    },
    {
      "span": {
        "start": 42132,
        "end": 42139
      },
      "text": "ལམ་གྱི་ ༼སྣར། པེ།༽ ལམ་གྱིས་"
    },
    {
      "span": {
        "start": 42168,
        "end": 42175
      },
      "text": "ཐོབ་པར་ ༼སྣར། པེ།༽ འཐོབ་པར་"
    },
    {
      "span": {
        "start": 42243,
        "end": 42249
      },
      "text": "དེ་ནི་ ༼སྣར།༽ ད་ནི་"
    },
    {
      "span": {
        "start": 42317,
        "end": 42325
      },
      "text": "ཉིད་ཀྱི། ༼སྣར། པེ།༽ ཉིད་ཀྱིས།"
    },
    {
      "span": {
        "start": 42485,
        "end": 42495
      },
      "text": "གང་ཡིན་དེ། ༼སྣར། པེ།༽ གང་ཡིན་ཏེ།"
    },
    {
      "span": {
        "start": 42504,
        "end": 42512
      },
      "text": "འཐོབ་པར་ ༼སྣར། པེ།༽ ཐོབ་པར་"
    },
    {
      "span": {
        "start": 42758,
        "end": 42768
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 42817,
        "end": 42827
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 42966,
        "end": 42971
      },
      "text": "བརྩལ་ ༼སྣར། པེ།༽ བཙལ་"
    },
    {
      "span": {
        "start": 43041,
        "end": 43050
      },
      "text": "འགྱུར་ཏེ། ༼སྣར། པེ།༽ འགྱུར་རོ།"
    },
    {
      "span": {
        "start": 43291,
        "end": 43294
      },
      "text": "ལས་ ༼སྣར། པེ།༽ རྒྱུས་"
    },
    {
      "span": {
        "start": 43424,
        "end": 43426
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལའང་"
    },
    {
      "span": {
        "start": 43508,
        "end": 43514
      },
      "text": "མེད་པ་ ༼པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 43734,
        "end": 43738
      },
      "text": "མཐར་ ༼སྣར། པེ།༽ ཐར་"
    },
    {
      "span": {
        "start": 43826,
        "end": 43829
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 44040,
        "end": 44047
      },
      "text": "འགགས་པ་ ༼སྣར། པེ།༽ འགག་པ་"
    },
    {
      "span": {
        "start": 44151,
        "end": 44158
      },
      "text": "འགགས་པ་ ༼སྣར། པེ།༽ འགག་པ་"
    },
    {
      "span": {
        "start": 44217,
        "end": 44222
      },
      "text": "ཆད་པ་ ༼པེ།༽ ཆག་པ་"
    },
    {
      "span": {
        "start": 44284,
        "end": 44290
      },
      "text": "བརྗོད། ༼སྣར། པེ།༽ འདོད།"
    },
    {
      "span": {
        "start": 44535,
        "end": 44552
      },
      "text": "མྱང་འདས་དེ་བརྟེན་ ༼སྣར།༽ མྱ་ངན་འདས་བརྟན་ ༼པེ།༽ མྱ་ངན་འདས་བརྟེན་"
    },
    {
      "span": {
        "start": 44566,
        "end": 44572
      },
      "text": "བརྟེན་ ༼ཅོ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 44670,
        "end": 44672
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 45013,
        "end": 45020
      },
      "text": "འདས་པར་ ༼སྣར། པེ།༽ འདས་པ་"
    },
    {
      "span": {
        "start": 45136,
        "end": 45142
      },
      "text": "ཐལ་བར་ ༼སྣར། པེ།༽ ཐར་བར་"
    },
    {
      "span": {
        "start": 45292,
        "end": 45295
      },
      "text": "ནི། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 45534,
        "end": 45542
      },
      "text": "གང་སྟོན་ ༼སྣར། པེ།༽ གང་སྟོང་"
    },
    {
      "span": {
        "start": 45586,
        "end": 45594
      },
      "text": "གྲུབ་པར་ ༼སྣར། པེ།༽ འགྲུབ་པར་"
    },
    {
      "span": {
        "start": 45753,
        "end": 45758
      },
      "text": "མངོན་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 45996,
        "end": 46002
      },
      "text": "འདས་པ་ ༼སྣར། པེ།༽ འདས་པའང་"
    },
    {
      "span": {
        "start": 46379,
        "end": 46388
      },
      "text": "ཅི་ཡིན། ། ༼སྣར། པེ།༽ ཅི་ཞིག །"
    },
    {
      "span": {
        "start": 46446,
        "end": 46452
      },
      "text": "མིན་པ་ ༼སྣར། པེ།༽ མིན་པའང་"
    },
    {
      "span": {
        "start": 46576,
        "end": 46585
      },
      "text": "མྱ་ངན་ལས་ ༼སྣར། པེ།༽ མྱ་ངན་"
    },
    {
      "span": {
        "start": 46647,
        "end": 46655
      },
      "text": "བསྒྲིབས་ ༼སྣར། པེ།༽ སྒྲིབས་"
    },
    {
      "span": {
        "start": 46743,
        "end": 46751
      },
      "text": "འགྲོ་བར་ ༼སྣར། པེ།༽ འགྲོ་བ་"
    },
    {
      "span": {
        "start": 46838,
        "end": 46845
      },
      "text": "གྱུར་ན། ༼སྣར། པེ།༽ གྱུར་ནས།"
    },
    {
      "span": {
        "start": 46959,
        "end": 46965
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 47118,
        "end": 47122
      },
      "text": "མིག་ ༼པེ།༽ མིང་"
    },
    {
      "span": {
        "start": 47500,
        "end": 47514
      },
      "text": "སྐྱེ་བར་འགྱུར། ༼སྣར། པེ།༽ སྐྱེ་བ་འབྱུང་།"
    },
    {
      "span": {
        "start": 47662,
        "end": 47670
      },
      "text": "འབའ་ཞིག་ ༼པེ།༽ འགའ་ཞིག་"
    },
    {
      "span": {
        "start": 47670,
        "end": 47672
      },
      "text": "པ་ ༼སྣར། པེ།༽ པོ་"
    },
    {
      "span": {
        "start": 47781,
        "end": 47789
      },
      "text": "མཁས་མིན་ ༼སྣར། པེ།༽ མཁས་པས་"
    },
    {
      "span": {
        "start": 47966,
        "end": 47971
      },
      "text": "མངོན་ ༼སྣར། པེ།༽ སྔོན་"
    },
    {
      "span": {
        "start": 48000,
        "end": 48008
      },
      "text": "འབའ་ཞིག་ ༼པེ།༽ འགའ་ཞིག་"
    },
    {
      "span": {
        "start": 48008,
        "end": 48010
      },
      "text": "པ། ༼སྣར།༽ གོ ༼པེ།༽ པོ།"
    },
    {
      "span": {
        "start": 48193,
        "end": 48198
      },
      "text": "མངོན་ ༼སྣར། པེ།༽ སྔོན་"
    },
    {
      "span": {
        "start": 48237,
        "end": 48249
      },
      "text": "འབྱུང་འགྱུར་ ༼སྣར། པེ།༽ འབྱུང་གྱུར་"
    },
    {
      "span": {
        "start": 48498,
        "end": 48507
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 48511,
        "end": 48514
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 48674,
        "end": 48681
      },
      "text": "འཇིག་པ་ ༼སྣར། པེ།༽ འཇིག་མ་"
    },
    {
      "span": {
        "start": 48699,
        "end": 48709
      },
      "text": "ཇི་ལྟ་བུར། ༼སྣར། པེ།༽ ཉིད་དུ་ལྟ།"
    },
    {
      "span": {
        "start": 48798,
        "end": 48800
      },
      "text": "ན་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 49140,
        "end": 49144
      },
      "text": "དེར་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 49177,
        "end": 49182
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 49292,
        "end": 49298
      },
      "text": "འབྱུང་ ༼སྣར། པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 49364,
        "end": 49379
      },
      "text": "འབྱུང་བའམ་རྒྱུ་ ༼སྣར།༽ འབྱུང་བའང་རྒྱུ་ ༼པེ།༽ འབྱུང་བའང་རྒྱུན་"
    },
    {
      "span": {
        "start": 50014,
        "end": 50023
      },
      "text": "འགྱུར་བར་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 50053,
        "end": 50056
      },
      "text": "གར། ༼སྣར། པེ།༽ གང་།"
    },
    {
      "span": {
        "start": 50737,
        "end": 50739
      },
      "text": "ལ། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 50763,
        "end": 50769
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 50783,
        "end": 50791
      },
      "text": "མཐའ་ཡོད་ ༼པེ།༽ མཐའ་མེད་"
    },
    {
      "span": {
        "start": 50795,
        "end": 50799
      },
      "text": "མེད་ ༼པེ།༽ ཡོད་"
    },
    {
      "span": {
        "start": 51158,
        "end": 51167
      },
      "text": "འགྱུར་བར་ ༼སྣར།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 51342,
        "end": 51346
      },
      "text": "གིས་ ༼སྣར། པེ།༽ གི་"
    },
    {
      "span": {
        "start": 51351,
        "end": 51356
      },
      "text": "བརྩེ་ ༼སྣར། པེ།༽ རྩེར་"
    },
    {
      "span": {
        "start": 51360,
        "end": 51365
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 51443,
        "end": 51448
      },
      "text": "ལོ། ། ༼སྣར། པེ།༽ ། །ལྟ་བ་བརྟག་པ་ཞེས་བྱ་བ་སྟེ་རབ་ཏུ་བྱེད་པ་ཉི་ཤུ་བདུན་པའོ། །།།"
    },
    {
      "span": {
        "start": 51526,
        "end": 51530
      },
      "text": "གཞག་ ༼སྣར། པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 52007,
        "end": 52014
      },
      "text": "མཁན་པོ་ ༼སྣར། པེ།༽ མཁན་པོ་ཐེག་པ་"
    }
  ]
}