{
  "durchens": [
    {
      "span": {
        "start": 228,
        "end": 230
      },
      "text": "བ་ ༼པེ།༽ བའི་"
    },
    {
      "span": {
        "start": 409,
        "end": 418
      },
      "text": "འདོད་པ་ལ་ ༼པེ།༽ འདོད་པ་"
    },
    {
      "span": {
        "start": 800,
        "end": 808
      },
      "text": "བསྒྲུབས་ ༼པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 1394,
        "end": 1400
      },
      "text": "བསྐུལ་ ༼པེ།༽ བསྐུལ་སེམས་ཅན་གྱི་དོན་ལ་"
    },
    {
      "span": {
        "start": 1531,
        "end": 1535
      },
      "text": "བཛྲ་ ༼པེ།༽ བཛྲ་ལྷ་མོ་"
    },
    {
      "span": {
        "start": 1655,
        "end": 1665
      },
      "text": "སྒོ་ནས་ལས་ ༼པེ།༽ སྒོ་ནས་"
    },
    {
      "span": {
        "start": 2881,
        "end": 2884
      },
      "text": "ཏྲ་ ༼པེ།༽ དྲ་"
    },
    {
      "span": {
        "start": 3445,
        "end": 3452
      },
      "text": "སོ་སོར་ ༼པེ།༽ སོ་སོ་"
    },
    {
      "span": {
        "start": 3612,
        "end": 3619
      },
      "text": "ལ་སོགས་ ༼སྣར།༽ ལ་སོགས་པ་ ༼པེ།༽ ལ་སོགས་པ་པ་"
    },
    {
      "span": {
        "start": 4282,
        "end": 4291
      },
      "text": "རྟོག་༧པས་ ༼སྣར།༽ རྟོག་པས་ ༼པེ།༽ རྟོགས་པས་"
    },
    {
      "span": {
        "start": 4780,
        "end": 4789
      },
      "text": "བསྒྲིབ་པ་ ༼པེ།༽ བསྒྲིབས་པ་"
    },
    {
      "span": {
        "start": 6077,
        "end": 6083
      },
      "text": "བསྣམས་ ༼པེ།༽ སྣམས་"
    },
    {
      "span": {
        "start": 7426,
        "end": 7428
      },
      "text": "ན་ ༼སྣར།༽ ཥིན་ ༼པེ།༽ ཤིན་"
    },
    {
      "span": {
        "start": 7490,
        "end": 7501
      },
      "text": "ལ་སོགས་པའི་ ༼པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 7556,
        "end": 7564
      },
      "text": "ལས་སོགས་ ༼པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 8391,
        "end": 8399
      },
      "text": "བསྒོམ་པ་ ༼པེ།༽ བསྒོམས་པ་"
    },
    {
      "span": {
        "start": 9765,
        "end": 9774
      },
      "text": "རྫོགས་སོ། ༼པེ།༽ རྫོགས།"
    }
  ]
}