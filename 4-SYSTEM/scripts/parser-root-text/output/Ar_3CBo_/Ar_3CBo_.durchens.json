{
  "durchens": [
    {
      "span": {
        "start": 321,
        "end": 330
      },
      "text": "བརྟེན་པར་ ༼སྣར། པེ།༽ བསྟེན་པར་"
    },
    {
      "span": {
        "start": 560,
        "end": 562
      },
      "text": "པ། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 708,
        "end": 715
      },
      "text": "རང་གིས་ ༼སྣར། པེ།༽ རང་གི་"
    },
    {
      "span": {
        "start": 1399,
        "end": 1407
      },
      "text": "མཚན་མ་ལ་ ༼སྣར། པེ།༽ མཚན་མ་"
    },
    {
      "span": {
        "start": 1407,
        "end": 1412
      },
      "text": "སོགས་ ༼སྣར། པེ།༽ སོགས་དེ་"
    },
    {
      "span": {
        "start": 1428,
        "end": 1431
      },
      "text": "ལྟ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 2251,
        "end": 2261
      },
      "text": "རྡུལ་གྱིས་ ༼སྣར། པེ།༽ རྡུལ་གྱི་"
    },
    {
      "span": {
        "start": 2267,
        "end": 2270
      },
      "text": "ཡི། ༼སྣར། པེ།༽ ཡིས།"
    },
    {
      "span": {
        "start": 2537,
        "end": 2545
      },
      "text": "དུབ་པའི་ ༼སྣར། པེ།༽ དུ་བའི་"
    },
    {
      "span": {
        "start": 2685,
        "end": 2691
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 3056,
        "end": 3065
      },
      "text": "རླབས་པའི་ ༼སྣར། པེ།༽ བརླབས་པའི་"
    },
    {
      "span": {
        "start": 3297,
        "end": 3305
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར། པེ།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 3661,
        "end": 3665
      },
      "text": "བལྟ། ༼སྣར། པེ།༽ ལྟ།"
    },
    {
      "span": {
        "start": 3875,
        "end": 3884
      },
      "text": "རྟོག་པའི་ ༼སྣར། པེ།༽ རྟོགས་པའི་"
    },
    {
      "span": {
        "start": 3890,
        "end": 3894
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 4361,
        "end": 4370
      },
      "text": "རྟོག་པའི་ ༼སྣར། པེ།༽ རྟོགས་པའི་"
    },
    {
      "span": {
        "start": 4715,
        "end": 4724
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 4978,
        "end": 4982
      },
      "text": "གསལ་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 5131,
        "end": 5143
      },
      "text": "མཚན་ཉིད་བདག་ ༼སྣར། པེ།༽ མཚན་"
    },
    {
      "span": {
        "start": 5328,
        "end": 5332
      },
      "text": "དོན་ ༼སྣར། པེ།༽ སྔོན་"
    },
    {
      "span": {
        "start": 5688,
        "end": 5705
      },
      "text": "གྱུར་པའི་དགའ་བའི་ ༼སྣར། པེ།༽ གྱུར་པའི་"
    },
    {
      "span": {
        "start": 5922,
        "end": 5932
      },
      "text": "རོལ་པ་ཡིས། ༼སྣར། པེ།༽ རོལ་པ་ཡི།"
    },
    {
      "span": {
        "start": 6643,
        "end": 6655
      },
      "text": "རང་བཞིན་གྱི་ ༼སྣར། པེ།༽ རང་བཞིན་གྱིས་"
    },
    {
      "span": {
        "start": 6875,
        "end": 6881
      },
      "text": "ཡང་དག་ ༼སྣར། པེ།༽ ཡང་དག་དག་"
    },
    {
      "span": {
        "start": 7074,
        "end": 7080
      },
      "text": "རབ་ཏུ་ ༼སྣར། པེ།༽ གང་དུ་"
    },
    {
      "span": {
        "start": 7437,
        "end": 7447
      },
      "text": "རྟོགས་པའི་ ༼སྣར། པེ།༽ རྟོག་པའི་"
    },
    {
      "span": {
        "start": 7460,
        "end": 7465
      },
      "text": "བགྲང་ ༼སྣར། པེ།༽ འགྲང་"
    },
    {
      "span": {
        "start": 8334,
        "end": 8338
      },
      "text": "ཡུལ་ ༼སྣར། པེ།༽ ཡུམ་"
    },
    {
      "span": {
        "start": 8653,
        "end": 8660
      },
      "text": "རང་གིས་ ༼སྣར། པེ།༽ རང་གི་"
    },
    {
      "span": {
        "start": 9443,
        "end": 9448
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 10017,
        "end": 10020
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 10426,
        "end": 10432
      },
      "text": "རྗེའི་ ༼སྣར། པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 10664,
        "end": 10674
      },
      "text": "རྣལ་འབྱོར་ ༼སྣར། པེ།༽ རྣལ་འབྱོར་དེ་"
    },
    {
      "span": {
        "start": 10677,
        "end": 10679
      },
      "text": "ན་ ༼སྣར། པེ།༽ ན་ཉིད་"
    },
    {
      "span": {
        "start": 10711,
        "end": 10717
      },
      "text": "བརྒྱད་ ༼སྣར། པེ།༽ བརྒྱ་"
    },
    {
      "span": {
        "start": 10827,
        "end": 10836
      },
      "text": "སྒོམ་པའང་ ༼སྣར། པེ།༽ བསྒོམ་པའང་"
    },
    {
      "span": {
        "start": 11116,
        "end": 11124
      },
      "text": "ཡིད་ཅེས་ ༼སྣར། པེ།༽ ཡིད་རྩེས་"
    },
    {
      "span": {
        "start": 11357,
        "end": 11362
      },
      "text": "ལའང་། ༼སྣར། པེ།༽ ལའང་། །ཚིག་གི་ཕན་པ་ཇི་ལྟ་བར།"
    },
    {
      "span": {
        "start": 12228,
        "end": 12233
      },
      "text": "སྲེག་ ༼སྣར། པེ།༽ བསྲེག་"
    },
    {
      "span": {
        "start": 12697,
        "end": 12706
      },
      "text": "། །གེ་སར་ ༼སྣར། པེ།༽ ། །གསེར་"
    },
    {
      "span": {
        "start": 12958,
        "end": 12965
      },
      "text": "རང་རིག་ ༼སྣར། པེ།༽ རང་གི་"
    },
    {
      "span": {
        "start": 13072,
        "end": 13076
      },
      "text": "རོལ་ ༼སྣར། པེ།༽ རོ་ལ་"
    },
    {
      "span": {
        "start": 13329,
        "end": 13335
      },
      "text": "བའོ། ། ༼པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 13350,
        "end": 13358
      },
      "text": "སྙིང་པོ་ ༼སྣར། པེ།༽ སྙིང་པོར་"
    },
    {
      "span": {
        "start": 13378,
        "end": 13381
      },
      "text": "ལས། ༼སྣར།༽ ལ།"
    },
    {
      "span": {
        "start": 13473,
        "end": 13477
      },
      "text": "བསལ་ ༼སྣར། པེ།༽ གསལ་"
    },
    {
      "span": {
        "start": 13961,
        "end": 13967
      },
      "text": "སྤྲོས། ༼སྣར། པེ།༽ སྨྲོས།"
    },
    {
      "span": {
        "start": 14012,
        "end": 14020
      },
      "text": "རྟོག་པས་ ༼སྣར། པེ།༽ རྟོགས་པས་"
    },
    {
      "span": {
        "start": 14020,
        "end": 14027
      },
      "text": "གཟུང་བ་ ༼སྣར། པེ།༽ བཟུང་བ་"
    }
  ]
}