{
  "durchens": [
    {
      "span": {
        "start": 75,
        "end": 81
      },
      "text": "དོག་པ་ ༼སྣར། པེ།༽ དོགས་པ་"
    },
    {
      "span": {
        "start": 199,
        "end": 203
      },
      "text": "ཐུར་ ༼སྣར། པེ།༽ ཕྲུལ་"
    },
    {
      "span": {
        "start": 472,
        "end": 476
      },
      "text": "གླུ། ༼སྣར། པེ།༽ ཀྲུང་།"
    },
    {
      "span": {
        "start": 501,
        "end": 503
      },
      "text": "ཛ། ༼སྣར། པེ།༽ མཛའ།"
    },
    {
      "span": {
        "start": 655,
        "end": 668
      },
      "text": "ནེའུ་སིང་པོས་ ༼སྣར།༽ ནེའུ་སིང་སྤོས་"
    },
    {
      "span": {
        "start": 1320,
        "end": 1327
      },
      "text": "ཕུང་བར་ ༼སྣར། པེ།༽ འཕུང་བར་"
    },
    {
      "span": {
        "start": 1448,
        "end": 1458
      },
      "text": "སྟོབས་ཀྱི་ ༼སྣར། པེ།༽ སྟོབས་ཀྱིས་"
    },
    {
      "span": {
        "start": 1509,
        "end": 1514
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ སྲུངས་"
    },
    {
      "span": {
        "start": 1723,
        "end": 1728
      },
      "text": "སྒོར་ ༼སྣར། པེ།༽ སྒོའི་"
    },
    {
      "span": {
        "start": 1848,
        "end": 1859
      },
      "text": "རྒྱལ་པོ་ནས་ ༼སྣར། པེ།༽ རྒྱལ་པོ་ནི་"
    },
    {
      "span": {
        "start": 2097,
        "end": 2102
      },
      "text": "འཇིག་ ༼སྣར། པེ།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 2152,
        "end": 2158
      },
      "text": "དོག་པ་ ༼སྣར། པེ།༽ དོགས་པ་"
    },
    {
      "span": {
        "start": 2231,
        "end": 2240
      },
      "text": "མེད་ཀྱིས་ ༼སྣར། པེ།༽ མེད་ཀྱི་"
    },
    {
      "span": {
        "start": 2400,
        "end": 2404
      },
      "text": "མིག་ ༼སྣར། པེ།༽ རྨིག་"
    },
    {
      "span": {
        "start": 2504,
        "end": 2511
      },
      "text": "སྐོམ་པ་ ༼སྣར། པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 2556,
        "end": 2562
      },
      "text": "བསྒོམ་ ༼སྣར། པེ།༽ སྒོམ་"
    },
    {
      "span": {
        "start": 2749,
        "end": 2756
      },
      "text": "ཡང་བདག་ ༼སྣར། པེ།༽ ཡང་དག་"
    },
    {
      "span": {
        "start": 3547,
        "end": 3553
      },
      "text": "སྦྱིན་ ༼སྣར། པེ།༽ སྦྱིན་གྱི་"
    },
    {
      "span": {
        "start": 3607,
        "end": 3614
      },
      "text": "སྲོག་པ་ ༼སྣར།༽ རློག་པ་ ༼པེ།༽ རྙོག་པ་"
    },
    {
      "span": {
        "start": 3619,
        "end": 3626
      },
      "text": "སྨན་ཡང་ ༼སྣར། པེ།༽ སྨན་ཡ་"
    },
    {
      "span": {
        "start": 3816,
        "end": 3823
      },
      "text": "ཕུང་བར་ ༼སྣར། པེ།༽ འཕུང་བར་"
    },
    {
      "span": {
        "start": 3975,
        "end": 3982
      },
      "text": "ཕུང་བར་ ༼སྣར། པེ།༽ འཕུང་བར་"
    },
    {
      "span": {
        "start": 4128,
        "end": 4137
      },
      "text": "མུ་ས་ར་ག་ ༼སྣར། པེ།༽ མུ་རིག་"
    },
    {
      "span": {
        "start": 4382,
        "end": 4392
      },
      "text": "རུལ་པ་ཅིག་ ༼སྣར། པེ།༽ རུལ་པ་གཅིག་"
    },
    {
      "span": {
        "start": 4465,
        "end": 4470
      },
      "text": "སྤྲད་ ༼སྣར། པེ།༽ ཕྲད་"
    },
    {
      "span": {
        "start": 4788,
        "end": 4796
      },
      "text": "གྱུར་པས་ ༼སྣར། པེ།༽ འགྱུར་བས་"
    },
    {
      "span": {
        "start": 4865,
        "end": 4871
      },
      "text": "ཐུར་མ་ ༼སྣར། པེ།༽ ཐུར་མང་"
    },
    {
      "span": {
        "start": 4875,
        "end": 4878
      },
      "text": "པར་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 5198,
        "end": 5203
      },
      "text": "ཀོའུ་ ༼སྣར།༽ ཀཽ་ ༼པེ།༽ ཀོ་"
    },
    {
      "span": {
        "start": 5269,
        "end": 5279
      },
      "text": "བླུགས་པའི་ ༼སྣར།༽ བླུག་པའི་"
    },
    {
      "span": {
        "start": 5311,
        "end": 5315
      },
      "text": "བཅད་ ༼སྣར། པེ།༽ གཅད་"
    },
    {
      "span": {
        "start": 5364,
        "end": 5370
      },
      "text": "ཝ་ཅིག་ ༼སྣར། པེ།༽ ཝ་གཅིག་"
    },
    {
      "span": {
        "start": 5670,
        "end": 5679
      },
      "text": "བརྗོད་པས་ ༼སྣར། པེ།༽ བརྗོད་པ་"
    },
    {
      "span": {
        "start": 5687,
        "end": 5692
      },
      "text": "འཁོར་ ༼སྣར། པེ།༽ འཁོར་བར་"
    },
    {
      "span": {
        "start": 5855,
        "end": 5862
      },
      "text": "ཚད་མའི་ ༼སྣར། པེ།༽ ཚད་པའི་"
    },
    {
      "span": {
        "start": 5882,
        "end": 5890
      },
      "text": "དམན་པའི་ ༼སྣར། པེ།༽ སྨན་པའི་"
    },
    {
      "span": {
        "start": 5915,
        "end": 5923
      },
      "text": "ལྤགས་པས་ ༼སྣར། པེ།༽ པགས་པས་"
    },
    {
      "span": {
        "start": 5950,
        "end": 5957
      },
      "text": "ཕུང་བར་ ༼སྣར། པེ།༽ འཕུང་བར་"
    },
    {
      "span": {
        "start": 5993,
        "end": 5998
      },
      "text": "གཏོང་ ༼སྣར། པེ།༽ སྟོང་"
    },
    {
      "span": {
        "start": 6003,
        "end": 6012
      },
      "text": "བཏུབ་པའོ། ༼སྣར། པེ།༽ བཏུབ་པོ།"
    },
    {
      "span": {
        "start": 6028,
        "end": 6036
      },
      "text": "གཅན་གཟན་ ༼སྣར། པེ།༽ གཅན་ཟན་"
    },
    {
      "span": {
        "start": 6071,
        "end": 6078
      },
      "text": "བཏང་བས་ ༼སྣར། པེ།༽ སྟོན་པས་"
    },
    {
      "span": {
        "start": 6105,
        "end": 6112
      },
      "text": "བཏང་བས་ ༼སྣར། པེ།༽ སྟོན་པས་"
    },
    {
      "span": {
        "start": 6379,
        "end": 6389
      },
      "text": "བསྒྲུབས་པ་ ༼སྣར། པེ།༽ སྒྲུབས་པ་"
    },
    {
      "span": {
        "start": 6754,
        "end": 6759
      },
      "text": "ཁྱོད་ ༼སྣར། པེ།༽ སེམས་"
    },
    {
      "span": {
        "start": 6882,
        "end": 6889
      },
      "text": "སྐུར་པ་ ༼སྣར། པེ།༽ སྐུལ་བ་"
    },
    {
      "span": {
        "start": 6950,
        "end": 6959
      },
      "text": "། །དེ་ནས་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 6988,
        "end": 6997
      },
      "text": "དེ་ནས་ཡང་ ༼སྣར།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 7124,
        "end": 7131
      },
      "text": "སྐུར་པ་ ༼སྣར། པེ།༽ བསྐུར་པ་"
    },
    {
      "span": {
        "start": 7261,
        "end": 7268
      },
      "text": "འཛིན་ན་ ༼སྣར། པེ།༽ འཛིན་"
    },
    {
      "span": {
        "start": 7338,
        "end": 7343
      },
      "text": "ཅིག ། ༼སྣར། པེ།༽ ཅིགདེ། །"
    },
    {
      "span": {
        "start": 7362,
        "end": 7369
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 7533,
        "end": 7539
      },
      "text": "བརྗོད་ ༼སྣར།༽ རྗོད་"
    },
    {
      "span": {
        "start": 7717,
        "end": 7721
      },
      "text": "པའོ། ༼སྣར། པེ།༽ ༩།"
    },
    {
      "span": {
        "start": 8151,
        "end": 8160
      },
      "text": "འགྱུར་རོ་ ༼སྣར། པེ།༽ གྱུར་ཏོ་"
    },
    {
      "span": {
        "start": 8369,
        "end": 8398
      },
      "text": "འབྲས་བུ་འདོད་པའི་དཀའ་ཐུབ་དག ། ༼སྣར། པེ།༽ བྱ་དཀའ་བྱས་པས་འབྲས་འདོད་པ། །"
    },
    {
      "span": {
        "start": 8406,
        "end": 8409
      },
      "text": "དག་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 8466,
        "end": 8473
      },
      "text": "བྱས་པས་ ༼སྣར། པེ།༽ བྱས་པ་"
    },
    {
      "span": {
        "start": 8480,
        "end": 8488
      },
      "text": "འཛིན་པར་ ༼སྣར། པེ།༽ འཛིན་པ་དང་བར་"
    },
    {
      "span": {
        "start": 8979,
        "end": 8987
      },
      "text": "ལུང་གིས་ ༼སྣར། པེ།༽ ལུང་གི་"
    },
    {
      "span": {
        "start": 8991,
        "end": 8999
      },
      "text": "པར་ཁ་ལོ་ ༼སྣར། པེ།༽ པར་བློ་"
    },
    {
      "span": {
        "start": 9251,
        "end": 9263
      },
      "text": "བཅུ་གཅིག། །། ༼སྣར། པེ།༽ བཅུ་གཅིགགཅིག་༡༡། །།"
    },
    {
      "span": {
        "start": 9271,
        "end": 9274
      },
      "text": "བི་ ༼སྣར། པེ།༽ བྷི་"
    },
    {
      "span": {
        "start": 9411,
        "end": 9419
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟགས་པ་"
    },
    {
      "span": {
        "start": 9548,
        "end": 9555
      },
      "text": "སྟོང་པ་ ༼སྣར། པེ།༽ སྟོང་"
    },
    {
      "span": {
        "start": 9570,
        "end": 9579
      },
      "text": "རྟོགས་ནས་ ༼སྣར། པེ།༽ རྟོགས་ན་"
    },
    {
      "span": {
        "start": 9676,
        "end": 9682
      },
      "text": "གསང་བ་ ༼སྣར། པེ།༽ གསང་བའི་"
    },
    {
      "span": {
        "start": 9775,
        "end": 9782
      },
      "text": "བྱིས་པ་ ༼སྣར།༽ བྱས་པ་"
    },
    {
      "span": {
        "start": 9782,
        "end": 9790
      },
      "text": "བཙས་ཐོག་ ༼སྣར།༽ ནས་ཙས་མ་ཐོགས་ ༼པེ།༽ བཙས་མ་ཐོག་"
    },
    {
      "span": {
        "start": 9900,
        "end": 9906
      },
      "text": "ཡོང་བ་ ༼སྣར། པེ།༽ ཡོངས་པ་"
    },
    {
      "span": {
        "start": 9984,
        "end": 9996
      },
      "text": "བཀྲེས་པ་སོས་ ༼སྣར། པེ།༽ བཀྲེས་པ་གསོས་"
    },
    {
      "span": {
        "start": 10006,
        "end": 10012
      },
      "text": "མ་རིག་ ༼སྣར། པེ།༽ མི་རིགས་"
    },
    {
      "span": {
        "start": 10204,
        "end": 10210
      },
      "text": "བརླབས་ ༼སྣར། པེ།༽ བརླབ་"
    },
    {
      "span": {
        "start": 10223,
        "end": 10230
      },
      "text": "ཕུང་བར་ ༼སྣར། པེ།༽ འཕུང་བར་"
    },
    {
      "span": {
        "start": 10323,
        "end": 10332
      },
      "text": "བྱ་བ་སྟེ་ ༼སྣར། པེ།༽ བྱ་བས་ཏེ་"
    },
    {
      "span": {
        "start": 10380,
        "end": 10387
      },
      "text": "མོ་ཞེས་ ༼སྣར། པེ།༽ མོ་"
    },
    {
      "span": {
        "start": 10507,
        "end": 10516
      },
      "text": "སྲིན་པོས་ ༼སྣར། པེ།༽ སྲིན་པོའི་"
    },
    {
      "span": {
        "start": 11101,
        "end": 11110
      },
      "text": "ཀུན་གྱིས་ ༼སྣར། པེ།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 11187,
        "end": 11194
      },
      "text": "ལྟོས་པ་ ༼སྣར། པེ།༽ བལྟོས་པ་"
    },
    {
      "span": {
        "start": 11302,
        "end": 11311
      },
      "text": "ཐམས་ཅད་ལ་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 11343,
        "end": 11353
      },
      "text": "གནོད་བྱིན་ ༼སྣར། པེ།༽ གནོད་སྦྱིན་"
    },
    {
      "span": {
        "start": 11470,
        "end": 11472
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནཱ་"
    },
    {
      "span": {
        "start": 11543,
        "end": 11549
      },
      "text": "བློའི་ ༼སྣར། པེ།༽ བློ་ཡིས་"
    },
    {
      "span": {
        "start": 11635,
        "end": 11642
      },
      "text": "སླུ་བར་ ༼སྣར། པེ།༽ བསླུ་བར་"
    },
    {
      "span": {
        "start": 11909,
        "end": 11923
      },
      "text": "བླང་སྟེ་ཨུནྱན་ ༼སྣར། པེ།༽ སླངས་ཏེ། ཨུ་རྒྱན་"
    },
    {
      "span": {
        "start": 12026,
        "end": 12032
      },
      "text": "གཡེངས་ ༼སྣར། པེ།༽ ཡེངས་"
    },
    {
      "span": {
        "start": 12275,
        "end": 12283
      },
      "text": "བརྗོད་པ་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 12459,
        "end": 12468
      },
      "text": "བསྒོམས་པ་ ༼སྣར། པེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 12599,
        "end": 12607
      },
      "text": "བཅོམ་མོ། ༼སྣར། པེ།༽ བཅོམས་སོ།"
    },
    {
      "span": {
        "start": 12693,
        "end": 12695
      },
      "text": "པ་ ༼སྣར། པེ།༽ པ་ལ་"
    },
    {
      "span": {
        "start": 13019,
        "end": 13026
      },
      "text": "ཕུང་བར་ ༼སྣར། པེ།༽ འཕུང་བར་"
    },
    {
      "span": {
        "start": 13124,
        "end": 13128
      },
      "text": "ཐོང་ ༼སྣར། པེ།༽ མཐོང་"
    },
    {
      "span": {
        "start": 13139,
        "end": 13145
      },
      "text": "སྒོམས། ༼སྣར། པེ།༽ བསྒོམས།"
    },
    {
      "span": {
        "start": 13269,
        "end": 13281
      },
      "text": "སངས་རྒྱས་སུ་ ༼སྣར། པེ།༽ སངས་རྒྱས་"
    },
    {
      "span": {
        "start": 13385,
        "end": 13391
      },
      "text": "རྐྱེན་ ༼སྣར། པེ།༽ སྐྱོན་"
    },
    {
      "span": {
        "start": 13565,
        "end": 13567
      },
      "text": "བ་ ༼སྣར། པེ།༽ བ། དེའི་འགྲེལ་པ་"
    },
    {
      "span": {
        "start": 13689,
        "end": 13691
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནཱ་"
    }
  ]
}