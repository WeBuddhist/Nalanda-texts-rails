{
  "durchens": [
    {
      "span": {
        "start": 275,
        "end": 285
      },
      "text": "སྒྲོལ་མའི་ ༼པེ།༽ སྒྲོལ་མི་"
    },
    {
      "span": {
        "start": 444,
        "end": 450
      },
      "text": "གདུང་། ༼སྣར། པེ།༽ གདུངས།"
    },
    {
      "span": {
        "start": 565,
        "end": 571
      },
      "text": "བསྟོད། ༼སྣར། པེ།༽ ལོ།"
    },
    {
      "span": {
        "start": 610,
        "end": 620
      },
      "text": "མཁའ་འགྲོར་ ༼སྣར། པེ།༽ མཁའ་འགྲོ་"
    },
    {
      "span": {
        "start": 634,
        "end": 671
      },
      "text": "། །འགྲོ་བའི་སྒྲིབ་གཉིས་སྦྱོང་མཛད་པ། ། ༼སྣར། པེ།༽ ། །"
    }
  ]
}