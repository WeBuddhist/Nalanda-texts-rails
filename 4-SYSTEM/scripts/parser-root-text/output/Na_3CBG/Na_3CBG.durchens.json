{
  "durchens": [
    {
      "span": {
        "start": 112,
        "end": 119
      },
      "text": "འཚལ་ལོ། ༼སྣར།༽ འཚལ།"
    },
    {
      "span": {
        "start": 355,
        "end": 364
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 449,
        "end": 456
      },
      "text": "འཇིག་པ་ ༼སྣར། པེ།༽ འཇིགས་པ་"
    },
    {
      "span": {
        "start": 575,
        "end": 579
      },
      "text": "མིན། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 636,
        "end": 642
      },
      "text": "འཁྱམས། ༼ཅོ།༽ འབྱམས ༼སྣར། པེ།༽ འཁྱམ།"
    },
    {
      "span": {
        "start": 701,
        "end": 708
      },
      "text": "འབྱུང་། ༼སྣར། པེ།༽ བྱུང་།"
    },
    {
      "span": {
        "start": 957,
        "end": 962
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 1009,
        "end": 1015
      },
      "text": "རིག་པ་ ༼སྣར། པེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 2220,
        "end": 2222
      },
      "text": "ཐ་ ༼སྣར། པེ།༽ ཐཱ་"
    }
  ]
}