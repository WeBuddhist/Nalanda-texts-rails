{
  "durchens": [
    {
      "span": {
        "start": 65,
        "end": 77
      },
      "text": "དུག་སེལ་བའི་ ༼སྣར། པེ།༽ དུག་སེལ་མའི་"
    },
    {
      "span": {
        "start": 218,
        "end": 228
      },
      "text": "པའི་རིག་མ་ ༼སྣར། པེ།༽ བྱའི་རིམ་པ་"
    },
    {
      "span": {
        "start": 314,
        "end": 319
      },
      "text": "སྤྱན་ ༼སྣར། པེ།༽ ཕྱག་"
    },
    {
      "span": {
        "start": 405,
        "end": 413
      },
      "text": "སྐེ་རགས་ ༼སྣར། པེ།༽ སྐ་རགས་"
    },
    {
      "span": {
        "start": 601,
        "end": 604
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 904,
        "end": 920
      },
      "text": "བརྒྱན་པར་བསྒོམས། ༼སྣར། པེ།༽ བརྒྱན་པ་བསྒོམ།"
    },
    {
      "span": {
        "start": 935,
        "end": 949
      },
      "text": "སྐུ་གསུམ་གྱིས། ༼སྣར། པེ།༽ སྐུ་གསུམ་གྱི།"
    },
    {
      "span": {
        "start": 1011,
        "end": 1018
      },
      "text": "རིང་པོ་ ༼སྣར། པེ།༽ རིང་པོར་"
    },
    {
      "span": {
        "start": 1146,
        "end": 1150
      },
      "text": "སྟེ། ༼སྣར། པེ།༽ སྟེ། སྔགས་"
    },
    {
      "span": {
        "start": 1173,
        "end": 1175
      },
      "text": "ཤ་ ༼སྣར། པེ།༽ མཿཤ་ར་"
    }
  ]
}