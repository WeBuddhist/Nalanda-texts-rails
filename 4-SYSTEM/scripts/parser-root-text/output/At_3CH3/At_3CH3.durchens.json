{
  "durchens": [
    {
      "span": {
        "start": 92,
        "end": 102
      },
      "text": "དང་པོ་པའི་ ༼སྣར། པེ།༽ དང་པོའི་"
    },
    {
      "span": {
        "start": 280,
        "end": 293
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 514,
        "end": 519
      },
      "text": "བཤེས་ ༼སྣར། པེ།༽ གཤེས་"
    },
    {
      "span": {
        "start": 529,
        "end": 541
      },
      "text": "ཅིག་ལ་ཐེག་པ་ ༼སྣར།༽ ཅིག་པུ་ཐེག་ ༼པེ།༽ ཅིག་པུ་ཐེག་པ་"
    },
    {
      "span": {
        "start": 598,
        "end": 606
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 611,
        "end": 615
      },
      "text": "ཅིག་ ༼སྣར། པེ།༽ གཅིག་"
    },
    {
      "span": {
        "start": 1048,
        "end": 1056
      },
      "text": "འདུ་ཤེས་ ༼སྣར། པེ།༽ འདུ་ཤེས་པ་"
    },
    {
      "span": {
        "start": 1106,
        "end": 1115
      },
      "text": "ཚོགས་ཀྱི་ ༼པེ།༽ ཚོགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 1258,
        "end": 1265
      },
      "text": "བསྡམ་པ་ ༼སྣར། པེ།༽ བསྡམས་པ་"
    },
    {
      "span": {
        "start": 1295,
        "end": 1304
      },
      "text": "འཇིགས་པར་ ༼སྣར། པེ།༽ འཇིག་པར་"
    },
    {
      "span": {
        "start": 1534,
        "end": 1546
      },
      "text": "བྱེ་བྲག་གིས་ ༼སྣར། པེ།༽ བྱེ་བྲག་གི་"
    },
    {
      "span": {
        "start": 1832,
        "end": 1842
      },
      "text": "ཐམས་ཅད་དང་ ༼སྣར།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 1910,
        "end": 1923
      },
      "text": "གྲངས་མེད་ཅིང་ ༼སྣར། པེ།༽ གྲངས་"
    },
    {
      "span": {
        "start": 2320,
        "end": 2326
      },
      "text": "བསྐོར་ ༼སྣར། པེ།༽ སྐོར་"
    },
    {
      "span": {
        "start": 2933,
        "end": 2937
      },
      "text": "མཆི། ༼སྣར། པེ།༽ མཆིའོ།"
    },
    {
      "span": {
        "start": 2939,
        "end": 2947
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 3122,
        "end": 3125
      },
      "text": "ལམ་ ༼སྣར། པེ།༽ ལམ་དེ་"
    },
    {
      "span": {
        "start": 3580,
        "end": 3591
      },
      "text": "སྟོབས་ཀྱིས་ ༼སྣར། པེ།༽ སྟོབས་ཀྱི་"
    },
    {
      "span": {
        "start": 3621,
        "end": 3628
      },
      "text": "ཨེ་མའོ་ ༼སྣར། པེ།༽ ཨེ་མ་"
    },
    {
      "span": {
        "start": 3713,
        "end": 3722
      },
      "text": "ཡིད་ཀྱིས་ ༼སྣར། པེ།༽ ཡིད་ཀྱི་"
    },
    {
      "span": {
        "start": 3767,
        "end": 3774
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 3837,
        "end": 3844
      },
      "text": "ཟས་ཀྱི་ ༼པེ།༽ ཟས་ཀྱིས་"
    },
    {
      "span": {
        "start": 3987,
        "end": 3992
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 4141,
        "end": 4148
      },
      "text": "ལྟོ་ཡི་ ༼སྣར། པེ།༽ ལྟོ་བའི་"
    },
    {
      "span": {
        "start": 4191,
        "end": 4222
      },
      "text": "། །རླུང་ལ་སོགས་པའི་གནས་སུ་ནི། ། ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 4277,
        "end": 4284
      },
      "text": "བགོ་བར་ ༼སྣར། པེ།༽ བསྒོ་བར་"
    },
    {
      "span": {
        "start": 4355,
        "end": 4360
      },
      "text": "སྤྱད་ ༼སྣར། པེ།༽ སྤྱོད་"
    },
    {
      "span": {
        "start": 4419,
        "end": 4421
      },
      "text": "ཆ་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 4439,
        "end": 4443
      },
      "text": "རོག་ ༼སྣར། པེ།༽ རོགས་"
    },
    {
      "span": {
        "start": 4536,
        "end": 4540
      },
      "text": "གཞན་ ༼སྣར། པེ།༽ བཞན་"
    },
    {
      "span": {
        "start": 4791,
        "end": 4798
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ དེ་ལྟ་བུའི་"
    },
    {
      "span": {
        "start": 4953,
        "end": 4960
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 5152,
        "end": 5164
      },
      "text": "ཐུན་དྲུག་པོ་ ༼སྣར། པེ།༽ ཐུན་དྲུག་པོ་དེ་"
    },
    {
      "span": {
        "start": 5329,
        "end": 5339
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    }
  ]
}