{
  "durchens": [
    {
      "span": {
        "start": 32,
        "end": 38
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ སྐྱེད་པར་"
    },
    {
      "span": {
        "start": 53,
        "end": 59
      },
      "text": "སྐྱེད་ ༼ཅོ།༽ སྐྱེ་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 164,
        "end": 170
      },
      "text": "རང་གི་ ༼སྣར། པེ།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 238,
        "end": 242
      },
      "text": "གཡང་ ༼པེ།༽ གཡངས་"
    },
    {
      "span": {
        "start": 365,
        "end": 372
      },
      "text": "བདག་གི་ ༼པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 484,
        "end": 489
      },
      "text": "ལྷུང་ ༼སྡེ།༽ ལྟུང་"
    },
    {
      "span": {
        "start": 816,
        "end": 822
      },
      "text": "ཆུད་མ་ ༼སྣར།༽ ཆུད་མི་"
    },
    {
      "span": {
        "start": 876,
        "end": 883
      },
      "text": "སྡིག་ལ་ ༼སྣར།༽ སྡིག་"
    },
    {
      "span": {
        "start": 889,
        "end": 894
      },
      "text": "སྐྱེ། ༼སྣར། པེ།༽ སྐྱེད།"
    },
    {
      "span": {
        "start": 962,
        "end": 967
      },
      "text": "སྐྱེ། ༼སྣར། པེ།༽ སྐྱེད།"
    },
    {
      "span": {
        "start": 1146,
        "end": 1151
      },
      "text": "སོག ། ༼སྣར། པེ།༽ གསོག །"
    },
    {
      "span": {
        "start": 1391,
        "end": 1396
      },
      "text": "གདུང་ ༼སྣར། པེ།༽ གདུངས་"
    },
    {
      "span": {
        "start": 1531,
        "end": 1537
      },
      "text": "དུས་ན་ ༼སྣར། པེ།༽ དུས་ནས་"
    },
    {
      "span": {
        "start": 1551,
        "end": 1557
      },
      "text": "གཏོང་། ༼སྣར། པེ།༽ སྟོང་།"
    },
    {
      "span": {
        "start": 1727,
        "end": 1729
      },
      "text": "ཙ་ ༼སྣར། པེ།༽ ཨ་ཅི་"
    },
    {
      "span": {
        "start": 2212,
        "end": 2220
      },
      "text": "དགྲ་ཡིས་ ༼སྣར། པེ།༽ དགྲ་ཡི་"
    },
    {
      "span": {
        "start": 2237,
        "end": 2242
      },
      "text": "འབྲས་ ༼སྣར། པེ།༽ འབྲོས་"
    },
    {
      "span": {
        "start": 2247,
        "end": 2252
      },
      "text": "སྐྱེ། ༼སྣར། པེ།༽ བསྐྱེད།"
    },
    {
      "span": {
        "start": 2357,
        "end": 2363
      },
      "text": "རྩིག ། ༼སྣར། པེ།༽ བརྩིག །"
    },
    {
      "span": {
        "start": 2463,
        "end": 2470
      },
      "text": "ལོ་ཟླས་ ༼སྣར། པེ།༽ ལོ་ཟླ་"
    },
    {
      "span": {
        "start": 2570,
        "end": 2573
      },
      "text": "རྒ་ ༼སྣར། པེ།༽ རྒས་"
    },
    {
      "span": {
        "start": 2579,
        "end": 2585
      },
      "text": "རང་ཐག་ ༼སྣར། པེ།༽ རང་འཐག་"
    },
    {
      "span": {
        "start": 2797,
        "end": 2811
      },
      "text": "ཤིང་གའི་བྱེའུ་ ༼སྣར། པེ།༽ ཤིང་ཁའི་བྱེ་"
    },
    {
      "span": {
        "start": 2879,
        "end": 2885
      },
      "text": "ཁ་སོང་ ༼སྣར། པེ།༽ ཁ་སང་"
    },
    {
      "span": {
        "start": 2904,
        "end": 2915
      },
      "text": "འགྲོ་བར་ཆས་ ༼སྣར། པེ།༽ འགྲོ་"
    },
    {
      "span": {
        "start": 2918,
        "end": 2928
      },
      "text": "གཉེན་འདུན་ ༼སྣར། པེ།༽ གཉེན་འདུན་ཕ་མ་"
    },
    {
      "span": {
        "start": 3026,
        "end": 3031
      },
      "text": "གཏོར་ ༼སྣར། པེ།༽ སྟེང་"
    },
    {
      "span": {
        "start": 3034,
        "end": 3039
      },
      "text": "འོངས་ ༼སྣར། པེ།༽ ལོང་"
    },
    {
      "span": {
        "start": 3291,
        "end": 3303
      },
      "text": "བརྒྱགས་སྙོད། ༼སྣར། པེ།༽ རྒྱགས་བསྙོད།"
    },
    {
      "span": {
        "start": 3380,
        "end": 3388
      },
      "text": "ཀྱིས་མི་ ༼སྣར། པེ།༽ ཀྱིས་མ་"
    },
    {
      "span": {
        "start": 3437,
        "end": 3441
      },
      "text": "སླུ་ ༼སྣར། པེ།༽ བསླུ་"
    },
    {
      "span": {
        "start": 3638,
        "end": 3643
      },
      "text": "འཁྱམ། ༼སྣར།༽ འཁྱམས།"
    },
    {
      "span": {
        "start": 3939,
        "end": 3946
      },
      "text": "བསལ་བར་ ༼སྣར། པེ།༽ གསལ་བར་"
    },
    {
      "span": {
        "start": 3974,
        "end": 3981
      },
      "text": "བྲལ་བར་ ༼སྣར། པེ།༽ བྲལ་བ་"
    },
    {
      "span": {
        "start": 4407,
        "end": 4412
      },
      "text": "རྟེན། ༼སྣར། པེ།༽ སྟེན།"
    },
    {
      "span": {
        "start": 4623,
        "end": 4630
      },
      "text": "རྟག་ཏུ་ ༼སྣར། པེ།༽ རྟག་པར་"
    },
    {
      "span": {
        "start": 4713,
        "end": 4715
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 4731,
        "end": 4747
      },
      "text": "འཆད་པའི་ཆུ་བོའི་ ༼པེ།༽ འཆད་པའི་"
    },
    {
      "span": {
        "start": 4978,
        "end": 4985
      },
      "text": "ཕུང་བར་ ༼སྣར། པེ།༽ འཕུང་བར་"
    },
    {
      "span": {
        "start": 5159,
        "end": 5163
      },
      "text": "སུས་ ༼སྣར། པེ།༽ སུ་"
    },
    {
      "span": {
        "start": 5178,
        "end": 5183
      },
      "text": "སྔུན་ ༼སྣར།༽ སྔོན་"
    },
    {
      "span": {
        "start": 5185,
        "end": 5194
      },
      "text": "སྡོད་ཀྱི་ ༼སྣར། པེ།༽ སྡོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 5343,
        "end": 5348
      },
      "text": "རྟོད་ ༼སྣར། པེ།༽ བརྟོད་"
    },
    {
      "span": {
        "start": 5440,
        "end": 5445
      },
      "text": "བཀྱེ་ ༼པེ།༽ བརྐྱེ་"
    },
    {
      "span": {
        "start": 5456,
        "end": 5460
      },
      "text": "གསད། ༼སྣར། པེ།༽ བསད།"
    },
    {
      "span": {
        "start": 5478,
        "end": 5483
      },
      "text": "སྡོད་ ༼སྣར།༽ སྣོད་"
    },
    {
      "span": {
        "start": 5537,
        "end": 5547
      },
      "text": "ཁྱོད་ཀྱིས་ ༼པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 5637,
        "end": 5646
      },
      "text": "བགྱི་སྟེ། ༼སྣར། པེ།༽ བགྱིད་དེ།"
    },
    {
      "span": {
        "start": 5667,
        "end": 5672
      },
      "text": "བསྐལ་ ༼སྣར། པེ།༽ སྐལ་"
    },
    {
      "span": {
        "start": 5808,
        "end": 5816
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོགས་པར་"
    },
    {
      "span": {
        "start": 6120,
        "end": 6127
      },
      "text": "མཛངས་པ་ ༼སྣར། པེ།༽ འཛངས་པ་"
    },
    {
      "span": {
        "start": 6156,
        "end": 6164
      },
      "text": "མི་འཁྱག་ ༼སྣར།༽ མི་འཁྱམས་ ༼པེ།༽ འཁྱགས་"
    },
    {
      "span": {
        "start": 6706,
        "end": 6714
      },
      "text": "གཞོན་ཡང་ ༼སྣར། པེ།༽ བདེ་བ་"
    },
    {
      "span": {
        "start": 6946,
        "end": 6954
      },
      "text": "བཤད་ཀྱི་ ༼སྣར། པེ།༽ བཤད་ཀྱིས་"
    },
    {
      "span": {
        "start": 7017,
        "end": 7022
      },
      "text": "ཐོངས་ ༼སྣར། པེ།༽ ཐོགས་"
    },
    {
      "span": {
        "start": 7214,
        "end": 7223
      },
      "text": "བཏོང་བའི་ ༼ཅོ།༽ གཏོང་བའི་ ༼སྣར། པེ།༽ བཏང་བའི་"
    },
    {
      "span": {
        "start": 7345,
        "end": 7354
      },
      "text": "སྩལ་བགྱི་ ༼སྣར།༽ སྩལ་གྱི་ ༼པེ།༽ རྩལ་གྱི་"
    },
    {
      "span": {
        "start": 7462,
        "end": 7479
      },
      "text": "ཐོད་ཅིག་སྐྱེས་བུ་ ༼སྣར། པེ།༽ ཐོད་ཅིག་"
    },
    {
      "span": {
        "start": 7781,
        "end": 7790
      },
      "text": "གཅོད་རྐུ་ ༼སྣར། པེ།༽ བཅོད་བརྐུ་"
    },
    {
      "span": {
        "start": 8009,
        "end": 8016
      },
      "text": "འདུག་པ་ ༼སྣར། པེ།༽ གདུག་པ་"
    },
    {
      "span": {
        "start": 8016,
        "end": 8022
      },
      "text": "སྤོང་། ༼སྣར། པེ།༽ སྤོངས།"
    },
    {
      "span": {
        "start": 8108,
        "end": 8113
      },
      "text": "ཕོངས་ ༼སྣར། པེ།༽ འཕོངས་"
    },
    {
      "span": {
        "start": 8170,
        "end": 8174
      },
      "text": "ཆེས། ༼སྣར། པེ།༽ ཆེ།"
    },
    {
      "span": {
        "start": 8263,
        "end": 8268
      },
      "text": "ཐར་པ་ ༼སྣར།༽ མཐར་པ་"
    },
    {
      "span": {
        "start": 8268,
        "end": 8276
      },
      "text": "མངོན་ཞེ་ ༼སྣར། པེ།༽ མངོན་ཞེན་"
    },
    {
      "span": {
        "start": 8375,
        "end": 8384
      },
      "text": "གླགས་མེད་ ༼སྣར། པེ།༽ བདག་མེད་"
    },
    {
      "span": {
        "start": 8408,
        "end": 8416
      },
      "text": "ཆུ་ཁྱུད་ ༼སྣར། པེ།༽ ཆུ་ཆུན་"
    },
    {
      "span": {
        "start": 8540,
        "end": 8552
      },
      "text": "དབྱར་ཁའི་ཤེ་ ༼སྣར། པེ།༽ དབྱར་ཁའི་ཤེས་"
    },
    {
      "span": {
        "start": 8621,
        "end": 8625
      },
      "text": "བཙལ་ ༼སྣར། པེ།༽ བརྩལ་"
    },
    {
      "span": {
        "start": 9038,
        "end": 9045
      },
      "text": "སྤང་ལས་ ༼སྣར།༽ སྤངས་ལ་ ༼པེ།༽ སྤང་ལ་"
    },
    {
      "span": {
        "start": 9224,
        "end": 9231
      },
      "text": "འོང་ནས་ ༼སྣར། པེ།༽ འོང་ན་"
    },
    {
      "span": {
        "start": 9254,
        "end": 9259
      },
      "text": "མཚེས་ ༼སྣར། པེ།༽ ཚེ་"
    },
    {
      "span": {
        "start": 9288,
        "end": 9297
      },
      "text": "འཚོགས་པར་ ༼སྣར། པེ།༽ འཚོག་སེར་"
    },
    {
      "span": {
        "start": 9304,
        "end": 9311
      },
      "text": "སྐྱུགས་ ༼སྣར། པེ།༽ སྐྱུག་"
    },
    {
      "span": {
        "start": 9395,
        "end": 9401
      },
      "text": "སྐྱུར། ༼སྣར། པེ།༽ སྐུར།"
    },
    {
      "span": {
        "start": 9430,
        "end": 9435
      },
      "text": "སྨྲས། ༼སྣར། པེ།༽ སྨྲ།"
    },
    {
      "span": {
        "start": 9744,
        "end": 9752
      },
      "text": "དུ་མ་ཡི། ༼སྣར།༽ དུ་མ་ཡིས།"
    },
    {
      "span": {
        "start": 9791,
        "end": 9797
      },
      "text": "དེ་ཡི་ ༼སྣར། པེ།༽ དེ་ཡིས་"
    },
    {
      "span": {
        "start": 9801,
        "end": 9805
      },
      "text": "པའི་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 10213,
        "end": 10217
      },
      "text": "ཉམས་ ༼སྣར། པེ།༽ ཉམ་"
    },
    {
      "span": {
        "start": 10388,
        "end": 10394
      },
      "text": "ཉེ་བས་ ༼སྣར། པེ།༽ ཉེ་བ་"
    },
    {
      "span": {
        "start": 10402,
        "end": 10407
      },
      "text": "ཁ་ནས་ ༼སྣར། པེ།༽ ཁ་ན་"
    },
    {
      "span": {
        "start": 10512,
        "end": 10519
      },
      "text": "ལགས་ཏེ་ ༼སྣར། པེ།༽ ལ་སྟེ་"
    },
    {
      "span": {
        "start": 10635,
        "end": 10641
      },
      "text": "འབྱེད། ༼པེ།༽ བྱེད།"
    },
    {
      "span": {
        "start": 10739,
        "end": 10746
      },
      "text": "བྲལ་ནས་ ༼སྣར། པེ།༽ བྲལ་ན་"
    },
    {
      "span": {
        "start": 11043,
        "end": 11048
      },
      "text": "ཚུགས་ ༼སྣར།༽ གཙུགས་"
    },
    {
      "span": {
        "start": 11150,
        "end": 11156
      },
      "text": "བྱས་ན་ ༼སྣར། པེ།༽ བྱས་པ་"
    },
    {
      "span": {
        "start": 11245,
        "end": 11251
      },
      "text": "བརྩོན་ ༼སྣར། པེ།༽ བཙོན་"
    },
    {
      "span": {
        "start": 11434,
        "end": 11441
      },
      "text": "གྲང་ངོ་ ༼སྣར། པེ།༽ གྲང་དྲོ་"
    },
    {
      "span": {
        "start": 11461,
        "end": 11469
      },
      "text": "སྐྱེད་པ་ ༼སྣར། པེ།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 11483,
        "end": 11488
      },
      "text": "སྟེན་ ༼སྣར། པེ།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 11505,
        "end": 11513
      },
      "text": "སྐོམ་པར་ ༼སྣར། པེ།༽ སྐམ་པར་"
    },
    {
      "span": {
        "start": 11542,
        "end": 11553
      },
      "text": "སྐྱུགས་བྲོ་ ༼སྣར།༽ སྐྲུག་པོ་"
    },
    {
      "span": {
        "start": 11557,
        "end": 11563
      },
      "text": "སྣ་ཡི་ ༼སྣར། པེ།༽ སྣ་ཡིས་"
    },
    {
      "span": {
        "start": 11728,
        "end": 11733
      },
      "text": "བཙོང་ ༼སྣར། པེ།༽ བརྩོང་"
    },
    {
      "span": {
        "start": 11816,
        "end": 11826
      },
      "text": "རྣམས་སྨིན་ ༼སྣར།༽ རྣམ་སྨིན་པར་ ༼པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 12178,
        "end": 12183
      },
      "text": "རྒྱང་ ༼སྣར། པེ།༽ བརྒྱངས་"
    },
    {
      "span": {
        "start": 12257,
        "end": 12262
      },
      "text": "འགུལ་ ༼སྣར།༽ མགུལ་"
    },
    {
      "span": {
        "start": 12295,
        "end": 12301
      },
      "text": "བྱ་ཕྲ་ ༼སྣར། པེ།༽ བྱ་ཁྲ་"
    },
    {
      "span": {
        "start": 12431,
        "end": 12436
      },
      "text": "མཐིལ་ ༼སྣར། པེ།༽ ཐིལ་"
    },
    {
      "span": {
        "start": 12442,
        "end": 12451
      },
      "text": "སྤུ་གྲིས་ ༼སྣར། པེ།༽ པུ་གྲི་"
    },
    {
      "span": {
        "start": 12515,
        "end": 12522
      },
      "text": "རང་གིས་ ༼སྣར། པེ།༽ རང་གི་"
    },
    {
      "span": {
        "start": 12525,
        "end": 12532
      },
      "text": "བསྲེགས་ ༼སྣར།༽ བསྲེག་ས་ ༼པེ།༽ བསྲེག་"
    },
    {
      "span": {
        "start": 12547,
        "end": 12551
      },
      "text": "ལེན། ༼སྣར། པེ།༽ ལན།"
    },
    {
      "span": {
        "start": 12553,
        "end": 12561
      },
      "text": "འཆོངས་པ་ ༼སྣར། པེ།༽ མཆོང་བ་"
    },
    {
      "span": {
        "start": 12610,
        "end": 12614
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 12678,
        "end": 12694
      },
      "text": "ལགས་པས་མཁྱེན་པར་ ༼སྣར། པེ།༽ ལགས་མཁྱེན་"
    },
    {
      "span": {
        "start": 12819,
        "end": 12828
      },
      "text": "སྐྱེ་པའི་ ༼སྣར། པེ།༽ སྐྱེ་བོའི་"
    },
    {
      "span": {
        "start": 12849,
        "end": 12855
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 12949,
        "end": 12955
      },
      "text": "སྐྱེས་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 12969,
        "end": 12972
      },
      "text": "སོ། ༼པེ།༽ སསོ་མངྒཱ་ལཾ།"
    }
  ]
}