{
  "durchens": [
    {
      "span": {
        "start": 403,
        "end": 413
      },
      "text": "ཧཱུཾ་ཧཱུཾ་ ༼པེ། སྣར།༽ ཧུཾ་ཧུཾ།"
    },
    {
      "span": {
        "start": 421,
        "end": 443
      },
      "text": "གྲྀཧྣ་གྲྀཧྣ་ཧཱུཾ་ཧཱུཾ་ ༼པེ། སྣར།༽ གྲིཧྞ་གྲྀཧྞ་ཧུཾ་ཧུཾ།"
    },
    {
      "span": {
        "start": 461,
        "end": 481
      },
      "text": "གྲྀཧྞ་པ་ཡ་ཧཱུཾ་ཧཱུཾ་ ༼པེ། སྣར།༽ གྲིཧྞཱ་པ་ཡ་གྲིཧྞཱ་པ་ཡ་ཧུཾ་ཧུཾ།"
    },
    {
      "span": {
        "start": 512,
        "end": 533
      },
      "text": "བིདྱཱ་རཱ་ཛ་ཧཱུཾ་ཧཱུཾ་ ༼པེ། སྣར།༽ བིདྱ་རཱ་ཛ་ཧུཾ་ཧུཾ།"
    },
    {
      "span": {
        "start": 609,
        "end": 615
      },
      "text": "བསྒོམ་ ༼པེ། སྣར།༽ བསྒོམ།"
    },
    {
      "span": {
        "start": 729,
        "end": 739
      },
      "text": "སེམས་ཀྱིས་ ༼པེ། སྣར།༽ སེམས་ཀྱི།"
    },
    {
      "span": {
        "start": 1304,
        "end": 1312
      },
      "text": "ཨཱཏྨ་ཀོ྅་ ༼པེ། སྣར།༽ ཨཏྨ་ཀོ་ཧཾ།"
    },
    {
      "span": {
        "start": 1785,
        "end": 1792
      },
      "text": "བརྩེགས་ ༼པེ། སྣར།༽ རྩེག"
    },
    {
      "span": {
        "start": 1887,
        "end": 1891
      },
      "text": "ཕྱག་བཞི་ ༼པེ། སྣར།༽ ཞལ་ཕྱག་བཞི།"
    },
    {
      "span": {
        "start": 3164,
        "end": 3173
      },
      "text": "རྣམས་ཀྱི་ ༼པེ། སྣར།༽ རྣམས་ཀྱིས།"
    },
    {
      "span": {
        "start": 3496,
        "end": 3503
      },
      "text": "ལ་ལ་ནཱ་ ༼པེ། སྣར།༽ ལ་ལ་མཱ།"
    },
    {
      "span": {
        "start": 3787,
        "end": 3791
      },
      "text": "གཞག་ ༼པེ། སྣར།༽ བཞག"
    },
    {
      "span": {
        "start": 3864,
        "end": 3872
      },
      "text": "བདག་གིས་ ༼པེ། སྣར།༽ བདག་གི །"
    },
    {
      "span": {
        "start": 3927,
        "end": 3932
      },
      "text": "ལྔ་ལ་ ༼པེ། སྣར།༽ ལྔ་ལ།"
    },
    {
      "span": {
        "start": 3997,
        "end": 4002
      },
      "text": "ཞུགས་ ༼པེ། སྣར།༽ བཞུགས།"
    },
    {
      "span": {
        "start": 4253,
        "end": 4259
      },
      "text": "ཙ་ནཱི་ ༼པེ། སྣར།༽ ཙ་ནི།"
    },
    {
      "span": {
        "start": 4278,
        "end": 4291
      },
      "text": "པདྨ་ནརྟེ་ཤྭ་ར། ༼པེ། སྣར།༽ ཧུ་པདྨ་ཤྭ་རི།"
    },
    {
      "span": {
        "start": 4375,
        "end": 4381
      },
      "text": "ཡོཾ་ཡ་ ༼པེ། སྣར།༽ ལཱ།"
    },
    {
      "span": {
        "start": 4387,
        "end": 4393
      },
      "text": "ཧྲཱིཾ་ ༼པེ། སྣར།༽ ཧྲཱི།"
    },
    {
      "span": {
        "start": 4416,
        "end": 4424
      },
      "text": "སནྟྲཱ་ས་ ༼པེ། སྣར།༽ ཧྲཾ་ཧྲཱིཾ་ཊར་སཱི།"
    },
    {
      "span": {
        "start": 4505,
        "end": 4520
      },
      "text": "ན་ཡེ་ཧཱུྃ་ཧཱུྃ་ ༼པེ། སྣར།༽ ནཱི་ཡེ་ཧུཾ་ཧཱུཾ།"
    },
    {
      "span": {
        "start": 4575,
        "end": 4585
      },
      "text": "ཧཱུྃ་ཧཱུྃ་ ༼པེ། སྣར།༽ ཧུཾ་ཧཱུཾ།"
    },
    {
      "span": {
        "start": 4612,
        "end": 4617
      },
      "text": "ཧཱུྃ་ཧཱུྃ་ ༼པེ། སྣར།༽ ཧུཾ་ཧཱུཾ།"
    },
    {
      "span": {
        "start": 4636,
        "end": 4646
      },
      "text": "ཧཱུྃ་ཧཱུྃ་ ༼པེ། སྣར།༽ ཧུཾ་ཧཱུཾ།"
    },
    {
      "span": {
        "start": 4693,
        "end": 4701
      },
      "text": "ཞལ་གཅིག་ ༼པེ། སྣར།༽ ཞལ་ཅིག"
    },
    {
      "span": {
        "start": 4831,
        "end": 4852
      },
      "text": "ས་མ་ཡ་སྟཱཾ་དྲྀ་ཤྱ་ཧོཿ ༼པེ། སྣར།༽ ནི་ས་མ་ཡ་སྟཾ། དྲྀ་ཤྱ་ཧོ།"
    },
    {
      "span": {
        "start": 4938,
        "end": 4949
      },
      "text": "རཱཀྵ་ས་བྷུ་ ༼པེ། སྣར།༽ རཀྵ་ས་བྷུ།"
    },
    {
      "span": {
        "start": 4970,
        "end": 4973
      },
      "text": "ཨུཾ་མཱ་ར། ༼པེ། སྣར།༽ ཙོནྨཱ།"
    },
    {
      "span": {
        "start": 5020,
        "end": 5027
      },
      "text": "གྲྀཧྣཾ་ ༼པེ། སྣར།༽ གྲིཧྞཱ།"
    },
    {
      "span": {
        "start": 5107,
        "end": 5113
      },
      "text": "ཛི་གྷ་ ༼པེ། སྣར།༽ ཛི་གྲ།"
    },
    {
      "span": {
        "start": 5116,
        "end": 5118
      },
      "text": "མ་ ༼པེ། སྣར།༽ མཱ།"
    },
    {
      "span": {
        "start": 5137,
        "end": 5142
      },
      "text": "ཀཱརྟ་ ༼པེ། སྣར།༽ ཀར་ཏ།"
    },
    {
      "span": {
        "start": 5210,
        "end": 5214
      },
      "text": "གཏང་ ༼པེ། སྣར།༽ བཏང་།"
    },
    {
      "span": {
        "start": 5272,
        "end": 5278
      },
      "text": "འབྱུང་ ༼པེ། སྣར།༽ བྱུང་།"
    },
    {
      "span": {
        "start": 5343,
        "end": 5347
      },
      "text": "འདི་ནི་ ༼པེ། སྣར།༽ འདིར་ནི།"
    },
    {
      "span": {
        "start": 5423,
        "end": 5431
      },
      "text": "མཆོག་གི་ ༼པེ། སྣར།༽ མཆོག་གིས།"
    },
    {
      "span": {
        "start": 5466,
        "end": 5472
      },
      "text": "བསྲུང་ ༼པེ། སྣར།༽ སྲུང་།"
    },
    {
      "span": {
        "start": 5539,
        "end": 5544
      },
      "text": "འཐུང་ ༼པེ། སྣར།༽ མཐུང་།"
    },
    {
      "span": {
        "start": 5710,
        "end": 5713
      },
      "text": "བྱས་ ༼པེ། སྣར།༽ བྱ།"
    }
  ]
}