{
  "durchens": [
    {
      "span": {
        "start": 108,
        "end": 114
      },
      "text": "སྒྲུབ་ ༼སྣར།༽ སྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 174,
        "end": 181
      },
      "text": "དང་པོར་ ༼པེ།༽ དང་པོ་"
    },
    {
      "span": {
        "start": 304,
        "end": 317
      },
      "text": "བདེ་བར་སྐྱིལ་ ༼པེ།༽ བདེ་བརདཀྱིལ་"
    },
    {
      "span": {
        "start": 320,
        "end": 325
      },
      "text": "ཀྲུང་ ༼པེ།༽ དཀྲུང་"
    },
    {
      "span": {
        "start": 589,
        "end": 596
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 652,
        "end": 661
      },
      "text": "འཕྲོས་པས་ ༼སྣར། པེ།༽ འཕྲོ་བས་"
    },
    {
      "span": {
        "start": 982,
        "end": 992
      },
      "text": "ཚོགས་ཀྱིས་ ༼པེ།༽ ཚོགས་ཀྱི་"
    },
    {
      "span": {
        "start": 1197,
        "end": 1206
      },
      "text": "ཡིད་ཀྱིས་ ༼སྣར། པེ།༽ ཡིད་ཀྱི་"
    },
    {
      "span": {
        "start": 1469,
        "end": 1472
      },
      "text": "ལས་ ༼པེ།༽ ལས་ལས་"
    },
    {
      "span": {
        "start": 1808,
        "end": 1812
      },
      "text": "དྱེ་ ༼སྣར།༽ དྱཻ་ ༼པེ།༽ ཏྱེ་"
    },
    {
      "span": {
        "start": 1839,
        "end": 1842
      },
      "text": "པས། ༼པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 1920,
        "end": 1937
      },
      "text": "ལྡན་པའི་མཆོད་པའི་ ༼པེ།༽ ལྡན་པའི་"
    },
    {
      "span": {
        "start": 2000,
        "end": 2004
      },
      "text": "སརྦ་ ༼པེ།༽ བཛྲ་"
    },
    {
      "span": {
        "start": 2181,
        "end": 2191
      },
      "text": "སྒྱུར་བའི་ ༼པེ།༽ བསྒྱུར་བའི་"
    },
    {
      "span": {
        "start": 2287,
        "end": 2298
      },
      "text": "བསོད་ནམས་ལ་ ༼སྣར། པེ།༽ བསོད་ནམས་ཀྱི་"
    },
    {
      "span": {
        "start": 2473,
        "end": 2480
      },
      "text": "བསྒོམས་ ༼སྣར།༽ སྒོམས་"
    },
    {
      "span": {
        "start": 2644,
        "end": 2654
      },
      "text": "སྨིག་རྒྱུ་ ༼པེ།༽ མིག་སྒྱུ་"
    },
    {
      "span": {
        "start": 2932,
        "end": 2941
      },
      "text": "བསྒོམས་པ་ ༼པེ།༽ བསྒོམས་"
    },
    {
      "span": {
        "start": 2953,
        "end": 2959
      },
      "text": "སུ་ཡང་ ༼པེ།༽ སུ་"
    },
    {
      "span": {
        "start": 3086,
        "end": 3088
      },
      "text": "ལ་ ༼སྣར།༽ ལར་"
    },
    {
      "span": {
        "start": 3296,
        "end": 3306
      },
      "text": "ཀྱིས་མཆོག་ ༼སྣར།༽ ཀྱིས་མཆོད་ ༼པེ།༽ ཀྱི་མཆོད་"
    },
    {
      "span": {
        "start": 3317,
        "end": 3324
      },
      "text": "དག་གིས། ༼པེ།༽ དག་གི།"
    },
    {
      "span": {
        "start": 3508,
        "end": 3514
      },
      "text": "ལུས་པ་ ༼པེ།༽ ལུས་པར་"
    },
    {
      "span": {
        "start": 3610,
        "end": 3623
      },
      "text": "གཏམས་པར་བསམས་ ༼སྣར།༽ གཏིབས་པར་བསམ་ ༼པེ།༽ གཏིབས་པ་བསམས་"
    },
    {
      "span": {
        "start": 3872,
        "end": 3882
      },
      "text": "བཞིས་སྤྱན་ ༼སྣར། པེ།༽ བཞིས་"
    },
    {
      "span": {
        "start": 3927,
        "end": 3940
      },
      "text": "། གཞུག་པ་དང་། ༼སྣར།༽ །"
    },
    {
      "span": {
        "start": 3994,
        "end": 3997
      },
      "text": "རི་ ༼པེ།༽ ར་"
    },
    {
      "span": {
        "start": 4172,
        "end": 4180
      },
      "text": "མཉེས་པར་ ༼པེ།༽ གཉེར་བར་"
    },
    {
      "span": {
        "start": 4232,
        "end": 4237
      },
      "text": "སྩོལ་ ༼སྣར། པེ།༽ གསོལ་"
    },
    {
      "span": {
        "start": 4278,
        "end": 4286
      },
      "text": "ནམ་མཁའི་ ༼སྣར།༽ ནམ་མཁའ་"
    },
    {
      "span": {
        "start": 4294,
        "end": 4298
      },
      "text": "དེང་ ༼སྣར།༽ དང་"
    },
    {
      "span": {
        "start": 4302,
        "end": 4307
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 4359,
        "end": 4361
      },
      "text": "ཙ་ ༼ཅོ།༽ ཙཱ་"
    },
    {
      "span": {
        "start": 4398,
        "end": 4404
      },
      "text": "ཏཱ་རས་ ༼སྣར། པེ།༽ ཏཱ་ར་"
    },
    {
      "span": {
        "start": 4629,
        "end": 4637
      },
      "text": "བསྐུར་བ་ ༼སྣར།༽ བསྐུར་"
    },
    {
      "span": {
        "start": 4699,
        "end": 4708
      },
      "text": "བསྐྱོད་པ་ ༼པེ།༽ སྐྱོད་པ་"
    },
    {
      "span": {
        "start": 4738,
        "end": 4748
      },
      "text": "བྱིན་གྱིས་ ༼པེ།༽ བྱིན་གྱི་"
    },
    {
      "span": {
        "start": 4773,
        "end": 4779
      },
      "text": "ཡི་གེ་ ༼སྣར།༽ ཡེ་ཤེག་"
    },
    {
      "span": {
        "start": 4954,
        "end": 4959
      },
      "text": "བསྡུ་ ༼པེ།༽ སྡུ་"
    },
    {
      "span": {
        "start": 5034,
        "end": 5044
      },
      "text": "བསྒོམས་པས་ ༼སྣར།༽ སྒོམ་པས་ ༼པེ།༽ བསྒོམ་པས་"
    },
    {
      "span": {
        "start": 5089,
        "end": 5095
      },
      "text": "འོས་བ་ ༼སྣར། པེ།༽ འདོད་བ་"
    },
    {
      "span": {
        "start": 5250,
        "end": 5256
      },
      "text": "བསྔོས་ ༼པེ།༽ སྔོས་"
    },
    {
      "span": {
        "start": 5298,
        "end": 5307
      },
      "text": "གཤེགས་སུ་ ༼སྣར།༽ གཤེགས་"
    },
    {
      "span": {
        "start": 5338,
        "end": 5348
      },
      "text": "ཁྱོད་ཀྱིས་ ༼པེ།༽ ཁྱེད་ཀྱི་"
    },
    {
      "span": {
        "start": 5356,
        "end": 5360
      },
      "text": "དོན་ ༼སྣར།༽ དོན་དུ་"
    },
    {
      "span": {
        "start": 5443,
        "end": 5452
      },
      "text": "འབྱོན་པར་ ༼པེ།༽ བྱོན་པར་"
    },
    {
      "span": {
        "start": 5584,
        "end": 5592
      },
      "text": "སཏྭ་ཏྭེ་ ༼པེ།༽ སཏྭ་ཏེ་"
    },
    {
      "span": {
        "start": 5637,
        "end": 5639
      },
      "text": "བ། ༼པེ།༽ བྷཱ།"
    },
    {
      "span": {
        "start": 5903,
        "end": 5906
      },
      "text": "ཡང་ ༼པེ།༽ ། །"
    },
    {
      "span": {
        "start": 6065,
        "end": 6076
      },
      "text": "ཞེས་བྱ་བའི་ ༼སྣར།༽ ཞེས་པའི་"
    },
    {
      "span": {
        "start": 6086,
        "end": 6096
      },
      "text": "སློན་དཔོན་ ༼སྣར། པེ།༽ སློབ་དཔོན་"
    },
    {
      "span": {
        "start": 6173,
        "end": 6176
      },
      "text": "ཀར་ ༼པེ།༽ ཀ་རི་"
    }
  ]
}