{
  "durchens": [
    {
      "span": {
        "start": 82,
        "end": 93
      },
      "text": "ལ་སོགས་པའི་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 281,
        "end": 300
      },
      "text": "ལྔ་ལ་སོགས་པས་བལྟམས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་བསྟིམས་"
    },
    {
      "span": {
        "start": 460,
        "end": 468
      },
      "text": "མཆོད་པར་ ༼སྣར། པེ།༽ མཆོད་པ་"
    },
    {
      "span": {
        "start": 823,
        "end": 832
      },
      "text": "ལ་དགོད། ། ༼སྣར། པེ།༽ ལ་དགོངས་"
    },
    {
      "span": {
        "start": 861,
        "end": 865
      },
      "text": "ཚིག་ ༼སྣར།༽ ཚིགས་"
    },
    {
      "span": {
        "start": 1049,
        "end": 1057
      },
      "text": "ཆོས་ཉིད་ ༼སྣར། པེ།༽ ཆོས་"
    },
    {
      "span": {
        "start": 1345,
        "end": 1350
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུངས་"
    },
    {
      "span": {
        "start": 1381,
        "end": 1388
      },
      "text": "རྩོད་པ་ ༼སྣར། པེ།༽ རྩོད་པ་དང་"
    },
    {
      "span": {
        "start": 1529,
        "end": 1538
      },
      "text": "ཚིགས་བཅད་ ༼སྣར། པེ།༽ ཚིག་བཤད་"
    },
    {
      "span": {
        "start": 2250,
        "end": 2256
      },
      "text": "སྙེགས་ ༼སྣར། པེ།༽ སྙེག་"
    },
    {
      "span": {
        "start": 2563,
        "end": 2570
      },
      "text": "མི་བཟད་ ༼སྣར། པེ།༽ མི་ཟད་"
    },
    {
      "span": {
        "start": 2640,
        "end": 2648
      },
      "text": "རིགས་པར་ ༼སྣར། པེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 2703,
        "end": 2714
      },
      "text": "བདུད་རྩིའི་ ༼སྣར། པེ།༽ བདུད་རྩི་"
    }
  ]
}