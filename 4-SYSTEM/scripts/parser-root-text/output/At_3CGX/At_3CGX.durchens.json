{
  "durchens": [
    {
      "span": {
        "start": 192,
        "end": 199
      },
      "text": "ཡན་ཆོད་ ༼པེ།༽ ཡན་ཆད་དོ། །"
    },
    {
      "span": {
        "start": 598,
        "end": 602
      },
      "text": "སྦས་ ༼པེ།༽ སྦེད།"
    },
    {
      "span": {
        "start": 626,
        "end": 633
      },
      "text": "དབང་དུ་ ༼པེ།༽ དབང་པོ།"
    },
    {
      "span": {
        "start": 1111,
        "end": 1115
      },
      "text": "གསང་ ༼པེ།༽ གསུང་།"
    },
    {
      "span": {
        "start": 1140,
        "end": 1147
      },
      "text": "འཁོར་ལ་ ༼པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 1462,
        "end": 1465
      },
      "text": "གང་ ༼པེ།༽ མགར།"
    },
    {
      "span": {
        "start": 1649,
        "end": 1653
      },
      "text": "དབང་ ༼པེ།༽ དབང་།"
    },
    {
      "span": {
        "start": 2317,
        "end": 2326
      },
      "text": "བསྟེན་ནས་ ༼པེ།༽ རྟེན་པ།"
    },
    {
      "span": {
        "start": 2448,
        "end": 2453
      },
      "text": "ཎ་བས་ ༼པེ།༽ ནད་པས།"
    },
    {
      "span": {
        "start": 2946,
        "end": 2949
      },
      "text": "ཛྙ་ ༼པེ།༽ ཛྙཱ།"
    },
    {
      "span": {
        "start": 2973,
        "end": 2981
      },
      "text": "རྫོགས་སོ། ། ༼པེ།༽སྟོ། (འདིའི་འོག་ཏུ་རྫོགས་སོ་ཞེས་པ་རྣམས་ ༼པེ༽ ལ་རྫོགས་སྟོ་ཞེས་འཁོད་ཡོད་མེད་ཅི་རིགས་སྣང་ཡང་བསྡུར་མཆན་དུ་བཀོད་མེད།"
    }
  ]
}