{
  "durchens": [
    {
      "span": {
        "start": 79,
        "end": 89
      },
      "text": "སྤྲིང་ཡིག་ ༼སྣར། པེ།༽ ཕྲིན་ཡིག་"
    },
    {
      "span": {
        "start": 537,
        "end": 547
      },
      "text": "སྤངས་ཤིང་། ༼སྣར། པེ།༽ སྤང་ཞིང་།"
    },
    {
      "span": {
        "start": 875,
        "end": 882
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 1190,
        "end": 1196
      },
      "text": "བྱས་ལ་ ༼སྣར། པེ།༽ བྱས་པ་"
    },
    {
      "span": {
        "start": 1286,
        "end": 1291
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 1343,
        "end": 1348
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 1898,
        "end": 1906
      },
      "text": "སྟེན་པར་ ༼སྣར། པེ།༽ བརྟེན་པར་"
    },
    {
      "span": {
        "start": 1946,
        "end": 1955
      },
      "text": "ཆོས་ཀྱིས་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 2148,
        "end": 2154
      },
      "text": "བྱས་ལ་ ༼སྣར། པེ།༽ བྱས་པ་"
    },
    {
      "span": {
        "start": 2253,
        "end": 2257
      },
      "text": "སྡང་ ༼སྣར།༽ སྤང་"
    },
    {
      "span": {
        "start": 2263,
        "end": 2269
      },
      "text": "དགེའི་ ༼སྣར། པེ།༽ བདེའི་"
    },
    {
      "span": {
        "start": 2271,
        "end": 2281
      },
      "text": "སྤངས་ཤིང་། ༼སྣར། པེ།༽ སྤང་ཞིང་།"
    },
    {
      "span": {
        "start": 2720,
        "end": 2723
      },
      "text": "སུ་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 2948,
        "end": 2953
      },
      "text": "མཛོད། ༼སྣར། པེ།༽ མཛད།"
    },
    {
      "span": {
        "start": 2965,
        "end": 2970
      },
      "text": "སྡོང་ ༼སྣར། པེ།༽ ལྡང་"
    },
    {
      "span": {
        "start": 3300,
        "end": 3305
      },
      "text": "སྙོམ་ ༼སྣར། པེ།༽ སྙོམས་"
    },
    {
      "span": {
        "start": 3565,
        "end": 3569
      },
      "text": "གཏང་ ༼སྣར། པེ།༽ གཏོང་"
    },
    {
      "span": {
        "start": 3771,
        "end": 3774
      },
      "text": "བྱ། ༼སྣར། པེ།༽ མཛོད།"
    },
    {
      "span": {
        "start": 3870,
        "end": 3878
      },
      "text": "བསྡམ་པར་ ༼སྣར། པེ།༽ བསྡམས་པར་"
    },
    {
      "span": {
        "start": 4597,
        "end": 4609
      },
      "text": "གཞོན་ནུ་སྐད་ ༼སྣར། པེ།༽ གཞོན་ནུ་"
    },
    {
      "span": {
        "start": 4613,
        "end": 4627
      },
      "text": "སྒྲོགས་ཞེས་ཏེ། ༼སྣར། པེ།༽ སྒྲོག་ཅེས།"
    },
    {
      "span": {
        "start": 4643,
        "end": 4656
      },
      "text": "སྐད་མི་སྙན་པ་ ༼སྣར། པེ།༽ སྐད་སྙན་"
    },
    {
      "span": {
        "start": 4677,
        "end": 4692
      },
      "text": "མང་པོས་ལེགས་པར་ ༼སྣར། པེ།༽ མང་པོས་"
    },
    {
      "span": {
        "start": 4730,
        "end": 4734
      },
      "text": "བཅད་ ༼སྣར། པེ།༽ གཅད་"
    },
    {
      "span": {
        "start": 4780,
        "end": 4783
      },
      "text": "དེ་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 4806,
        "end": 4812
      },
      "text": "རྟོགས་ ༼སྣར། པེ།༽ རྟོག་"
    },
    {
      "span": {
        "start": 4835,
        "end": 4839
      },
      "text": "ལའང་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 4884,
        "end": 4891
      },
      "text": "གཙང་མར་ ༼སྣར། པེ།༽ གཙང་བར་"
    },
    {
      "span": {
        "start": 4975,
        "end": 4985
      },
      "text": "སྤྲིང་ཡིག་ ༼སྣར། པེ།༽ ཕྲིན་ཡིག་"
    },
    {
      "span": {
        "start": 5050,
        "end": 5055
      },
      "text": "ནིརྱ་ ༼སྣར། པེ།༽ ནིཪྻ་"
    },
    {
      "span": {
        "start": 5061,
        "end": 5070
      },
      "text": "བརྫོངས་པ་ ༼སྣར། པེ།༽ བརྫངས་པ་"
    }
  ]
}