{
  "durchens": [
    {
      "span": {
        "start": 21,
        "end": 23
      },
      "text": "ཨ་ ༼སྣར། པེ།༽ ཨི་"
    },
    {
      "span": {
        "start": 251,
        "end": 254
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 549,
        "end": 552
      },
      "text": "རབ་ ༼སྣར། པེ།༽ རང་"
    },
    {
      "span": {
        "start": 1001,
        "end": 1009
      },
      "text": "ཉིད་ཀྱི། ༼སྣར། པེ།༽ ཉིད་ཀྱིས།"
    },
    {
      "span": {
        "start": 1168,
        "end": 1177
      },
      "text": "སྔགས་ཀྱི་ ༼སྣར། པེ།༽ སྔགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 1539,
        "end": 1547
      },
      "text": "གསུམ་པོ་ ༼སྣར།༽ གསུམ་པ་"
    },
    {
      "span": {
        "start": 1612,
        "end": 1617
      },
      "text": "རྙེད་ ༼སྣར། པེ།༽ བརྙེད་"
    },
    {
      "span": {
        "start": 1867,
        "end": 1880
      },
      "text": "རིམ་གྱིས་ཐུན་ ༼སྣར། པེ།༽ རིག་གིས་མཐུན་"
    },
    {
      "span": {
        "start": 1967,
        "end": 1978
      },
      "text": "བསམ་གཏན་ནོ། ༼སྡེ།༽ བསམ་གཏན་ནི།"
    },
    {
      "span": {
        "start": 2050,
        "end": 2059
      },
      "text": "བརླབ་པའི་ ༼སྣར། པེ།༽ བརླབས་པའི་"
    },
    {
      "span": {
        "start": 2143,
        "end": 2146
      },
      "text": "གར་ ༼སྣར། པེ།༽ ཀར་"
    },
    {
      "span": {
        "start": 2510,
        "end": 2519
      },
      "text": "རིམ་གྱིས་ ༼སྣར། པེ།༽ རིམ་གྱི་"
    },
    {
      "span": {
        "start": 2658,
        "end": 2667
      },
      "text": "ཐིག་ལེའང་ ༼སྣར། པེ།༽ ཐོག་ལ་"
    },
    {
      "span": {
        "start": 2692,
        "end": 2695
      },
      "text": "རང་ ༼སྣར། པེ།༽ རླུང་"
    },
    {
      "span": {
        "start": 2949,
        "end": 2953
      },
      "text": "བཅག་ ༼སྣར། པེ།༽ བཅགས་"
    },
    {
      "span": {
        "start": 3005,
        "end": 3013
      },
      "text": "དམིགས་ལ། ༼སྣར། པེ།༽ དམིགས་པ།"
    },
    {
      "span": {
        "start": 3075,
        "end": 3084
      },
      "text": "ལྟོས་པའི་ ༼སྣར། པེ།༽ བལྟོས་པའི་"
    },
    {
      "span": {
        "start": 3405,
        "end": 3411
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 3632,
        "end": 3641
      },
      "text": "ཚུལ་གྱིས་ ༼སྣར། པེ།༽ ཚུལ་གྱི་"
    },
    {
      "span": {
        "start": 3976,
        "end": 3984
      },
      "text": "སྐྱེས་པ། ༼སྣར། པེ།༽ སྐྱེས་པས།"
    },
    {
      "span": {
        "start": 4449,
        "end": 4453
      },
      "text": "འདི་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 4798,
        "end": 4807
      },
      "text": "རིམ་གྱིས་ ༼སྣར། པེ།༽ རིམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 5039,
        "end": 5046
      },
      "text": "ཐམས་ཅད་ ༼སྣར། པེ།༽ ཐག་བཅད་"
    },
    {
      "span": {
        "start": 5358,
        "end": 5365
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རིགས་པས་"
    },
    {
      "span": {
        "start": 5544,
        "end": 5550
      },
      "text": "ཡན་ནི། ༼སྣར། པེ།༽ ཡན་གྱིས།"
    },
    {
      "span": {
        "start": 5569,
        "end": 5579
      },
      "text": "ལྡན་པ་ཡིས། ༼སྣར། པེ།༽ ལྡན་པ་ཡི།"
    },
    {
      "span": {
        "start": 5589,
        "end": 5593
      },
      "text": "གཞན་ ༼སྣར། པེ།༽ གཞོན་"
    },
    {
      "span": {
        "start": 5606,
        "end": 5611
      },
      "text": "རླག ། ༼སྣར། པེ།༽ བརླག །"
    },
    {
      "span": {
        "start": 5660,
        "end": 5665
      },
      "text": "དཀོར་ ༼སྣར། པེ།༽ སྐོར་"
    },
    {
      "span": {
        "start": 5718,
        "end": 5724
      },
      "text": "དང་མི་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 5728,
        "end": 5732
      },
      "text": "པའི། ༼སྣར། པེ།༽ པ་ཡི།"
    },
    {
      "span": {
        "start": 6121,
        "end": 6126
      },
      "text": "འདུལ་ ༼སྣར། པེ།༽ མུར་"
    },
    {
      "span": {
        "start": 6138,
        "end": 6143
      },
      "text": "རྩོད་ ༼སྣར། པེ།༽ བརྩད་"
    },
    {
      "span": {
        "start": 6401,
        "end": 6408
      },
      "text": "བྱས་ཏེ། ༼སྣར། པེ།༽ བྱས་བྱེད།"
    },
    {
      "span": {
        "start": 6551,
        "end": 6555
      },
      "text": "གི ། ༼སྣར། པེ།༽ གིས། །"
    },
    {
      "span": {
        "start": 7030,
        "end": 7035
      },
      "text": "བཀུར་ ༼སྣར། པེ།༽ བསྐུར་"
    },
    {
      "span": {
        "start": 7108,
        "end": 7113
      },
      "text": "ལ་མི་ ༼སྣར། པེ།༽ ལ་མ་"
    },
    {
      "span": {
        "start": 7390,
        "end": 7398
      },
      "text": "ཀུན་གྱི་ ༼སྣར། པེ།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 7407,
        "end": 7414
      },
      "text": "བདེན་པ་ ༼པེ།༽ བདེན་པར་"
    },
    {
      "span": {
        "start": 7589,
        "end": 7593
      },
      "text": "བརྨ་ ༼སྣར། པེ།༽ བརྨཱ་"
    },
    {
      "span": {
        "start": 7631,
        "end": 7641
      },
      "text": "བསྒྱུར་ནས་ ༼སྣར། པེ།༽ བསྒྱུར་ཅིང་"
    }
  ]
}