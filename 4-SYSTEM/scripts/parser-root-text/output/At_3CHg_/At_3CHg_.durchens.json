{
  "durchens": [
    {
      "span": {
        "start": 86,
        "end": 96
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 181,
        "end": 188
      },
      "text": "སོང་བས། ༼སྣར།༽ སོང་བ།"
    },
    {
      "span": {
        "start": 259,
        "end": 264
      },
      "text": "ལས་ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 277,
        "end": 285
      },
      "text": "དྲལ་ཤུལ་ ༼སྣར། པེ།༽ དྲག་ཤུལ་"
    },
    {
      "span": {
        "start": 392,
        "end": 401
      },
      "text": "གྲོ་བཞིན་ ༼སྣར། པེ།༽ གྲོ་ཞུན་"
    },
    {
      "span": {
        "start": 421,
        "end": 429
      },
      "text": "མོན་གྲེ་ ༼སྣར།༽ མན་དྲེ་ ༼པེ།༽ མོན་དྲེ་"
    },
    {
      "span": {
        "start": 448,
        "end": 454
      },
      "text": "ནབ་སོ་ ༼སྣར། པེ།༽ ནབས་སོ་"
    },
    {
      "span": {
        "start": 507,
        "end": 512
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ ཞུན་"
    },
    {
      "span": {
        "start": 609,
        "end": 623
      },
      "text": "འདོད་པས་མགོ་ལ། ༼སྣར། པེ།༽ འདོད་པས།"
    },
    {
      "span": {
        "start": 783,
        "end": 795
      },
      "text": "ན་ཁྲུམས་སྨད་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 839,
        "end": 845
      },
      "text": "ཕམ་པར་ ༼སྣར། པེ།༽ འཕམ་པར་"
    },
    {
      "span": {
        "start": 852,
        "end": 856
      },
      "text": "དབོ་ ༼སྣར། པེ།༽ སྦོ་"
    },
    {
      "span": {
        "start": 913,
        "end": 915
      },
      "text": "ན་ ༼སྣར། པེ།༽ འཕམ་"
    },
    {
      "span": {
        "start": 1027,
        "end": 1035
      },
      "text": "བྱེད་པར་ ༼སྣར།༽ བྱེད་པས་"
    },
    {
      "span": {
        "start": 1054,
        "end": 1064
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 1172,
        "end": 1180
      },
      "text": "གཏོང་བར་ ༼སྣར། པེ།༽ བཏང་བར་"
    },
    {
      "span": {
        "start": 1575,
        "end": 1582
      },
      "text": "གཏོང་བ་ ༼སྣར། པེ།༽ བཏང་བ་"
    },
    {
      "span": {
        "start": 1673,
        "end": 1680
      },
      "text": "སྦུད་པ་ ༼སྣར།༽ སྡུད་པ་ ༼པེ།༽ བདུད་པ་"
    },
    {
      "span": {
        "start": 1685,
        "end": 1692
      },
      "text": "འདུན་མ་ ༼སྣར། པེ།༽ མདུན་མ་"
    },
    {
      "span": {
        "start": 1718,
        "end": 1721
      },
      "text": "ནབ་ ༼སྣར། པེ།༽ ནམ་"
    },
    {
      "span": {
        "start": 1753,
        "end": 1761
      },
      "text": "མཁར་ལེན་ ༼སྣར། པེ།༽ མཁར་ལན་"
    },
    {
      "span": {
        "start": 1774,
        "end": 1783
      },
      "text": "འཁོར་བའི་ ༼སྣར། པེ།༽ མཁོ་བའི་"
    },
    {
      "span": {
        "start": 1960,
        "end": 1967
      },
      "text": "ཐེ་ཚོམ་ ༼སྣར། པེ།༽ ཐེ་ཙོམ་"
    },
    {
      "span": {
        "start": 2187,
        "end": 2191
      },
      "text": "གཙོ་ ༼པེ།༽ གཙོ་བོ་"
    }
  ]
}