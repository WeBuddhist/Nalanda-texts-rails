{
  "durchens": [
    {
      "span": {
        "start": 77,
        "end": 95
      },
      "text": "རྗེ་བཙུན་མ་འཕགས་མ་ ༼སྣར། པེ།༽ རྗེ་བཙུན་མ་"
    },
    {
      "span": {
        "start": 355,
        "end": 366
      },
      "text": "ཡུན་རིང་དུ། ༼སྣར། པེ།༽ ཡུན་རིངས་སུ།"
    },
    {
      "span": {
        "start": 380,
        "end": 391
      },
      "text": "འཁོར་བ་ཡིས། ༼སྣར། པེ།༽ འཁོར་བ་ཡི།"
    },
    {
      "span": {
        "start": 969,
        "end": 974
      },
      "text": "བསྡུ་ ༼སྣར།༽ བསྡུས་"
    },
    {
      "span": {
        "start": 979,
        "end": 987
      },
      "text": "བཞི་ཡིས་ ༼སྣར། པེ།༽ བཞི་ཡི་"
    },
    {
      "span": {
        "start": 1022,
        "end": 1026
      },
      "text": "ལྡན་ ༼སྣར།༽ བཅན་ ༼པེ།༽ ཅན་"
    },
    {
      "span": {
        "start": 1213,
        "end": 1217
      },
      "text": "འདང་ ༼སྣར། པེ།༽ དངས་"
    },
    {
      "span": {
        "start": 1229,
        "end": 1239
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 1315,
        "end": 1322
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 1327,
        "end": 1331
      },
      "text": "ཀྱི་ ༼སྣར།༽ ཀྱིས་"
    },
    {
      "span": {
        "start": 1335,
        "end": 1340
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 1435,
        "end": 1454
      },
      "text": "རྗེ་བཙུན་མ་སྒྲོལ་མ་ ༼སྣར།༽ རྗེ་བཙུན་མ་"
    }
  ]
}