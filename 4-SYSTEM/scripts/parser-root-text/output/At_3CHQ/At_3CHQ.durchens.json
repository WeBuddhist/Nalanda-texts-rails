{
  "durchens": [
    {
      "span": {
        "start": 196,
        "end": 203
      },
      "text": "བསགས་པ་ ༼སྣར།༽ བསག་པ་"
    },
    {
      "span": {
        "start": 808,
        "end": 810
      },
      "text": "པ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 850,
        "end": 856
      },
      "text": "བདུགས་ ༼སྣར། པེ།༽ གདུགས་"
    },
    {
      "span": {
        "start": 1307,
        "end": 1311
      },
      "text": "ཏྲས་ ༼སྣར། པེ།༽ དྲས་"
    },
    {
      "span": {
        "start": 1333,
        "end": 1337
      },
      "text": "མགོ་ ༼སྣར། པེ།༽ མགོས་"
    },
    {
      "span": {
        "start": 1381,
        "end": 1388
      },
      "text": "འདུད་པ་ ༼སྣར། པེ།༽ མདུད་པ་"
    },
    {
      "span": {
        "start": 1421,
        "end": 1434
      },
      "text": "ཧཱ་ཞེས་བརྗོད་ ༼སྣར། པེ།༽ ཧཱ་ཞེས་"
    },
    {
      "span": {
        "start": 1529,
        "end": 1535
      },
      "text": "བརྫེས་ ༼སྣར། པེ།༽ རྫེས་"
    },
    {
      "span": {
        "start": 1556,
        "end": 1559
      },
      "text": "ལྟ་ ༼སྣར། པེ།༽ བལྟ་"
    },
    {
      "span": {
        "start": 1713,
        "end": 1726
      },
      "text": "ཧཱ་ཞེས་བརྗོད་ ༼སྣར། པེ།༽ ཧཱ་ཞེས་"
    },
    {
      "span": {
        "start": 1798,
        "end": 1804
      },
      "text": "བརྫེས་ ༼སྣར། པེ།༽ རྫེས་"
    },
    {
      "span": {
        "start": 2008,
        "end": 2014
      },
      "text": "འཁྱིལ་ ༼སྣར། པེ།༽ མཁྱིལ་"
    },
    {
      "span": {
        "start": 2039,
        "end": 2045
      },
      "text": "འཁྱིལ་ ༼སྣར། པེ།༽ མཁྱིལ་"
    },
    {
      "span": {
        "start": 2087,
        "end": 2092
      },
      "text": "སྟེང་ ༼སྣར།༽ སྟེངས་"
    },
    {
      "span": {
        "start": 2540,
        "end": 2545
      },
      "text": "གཅིག་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 2815,
        "end": 2822
      },
      "text": "གཡོན་པ་ ༼སྣར། པེ།༽ གཡོན་"
    },
    {
      "span": {
        "start": 3078,
        "end": 3083
      },
      "text": "མདུང་ ༼སྣར།༽ མདུངས་"
    },
    {
      "span": {
        "start": 3533,
        "end": 3538
      },
      "text": "གཞུག་ ༼སྣར།༽ བཞུག་ ༼པེ།༽ བཞུག་ས་"
    },
    {
      "span": {
        "start": 3565,
        "end": 3569
      },
      "text": "སཏྭ་ ༼སྣར། པེ།༽ སདྡྷོ་"
    },
    {
      "span": {
        "start": 3647,
        "end": 3653
      },
      "text": "བཀྲོལ་ ༼སྣར།༽ དཀྲོལ་"
    },
    {
      "span": {
        "start": 3759,
        "end": 3764
      },
      "text": "བཏོན་ ༼སྣར། པེ།༽ སྟོན་"
    }
  ]
}