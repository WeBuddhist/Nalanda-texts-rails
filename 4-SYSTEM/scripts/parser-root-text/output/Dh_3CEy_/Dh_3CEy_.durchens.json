{
  "durchens": [
    {
      "span": {
        "start": 38,
        "end": 42
      },
      "text": "སྟོ་ ༼སྣར། པེ།༽ སྟོ་ཏྲ་"
    },
    {
      "span": {
        "start": 200,
        "end": 204
      },
      "text": "དགར་ ༼སྣར། པེ།༽ དཀར་"
    },
    {
      "span": {
        "start": 379,
        "end": 384
      },
      "text": "མཉེས་ ༼སྣར། པེ།༽ མཉེན་"
    },
    {
      "span": {
        "start": 428,
        "end": 438
      },
      "text": "ཞི་བའི་ལམ་ ༼སྣར། པེ།༽ ཞི་བའི་ལོ་"
    },
    {
      "span": {
        "start": 850,
        "end": 854
      },
      "text": "ཆེན་ ༼སྣར། པེ།༽ ཆེ་"
    },
    {
      "span": {
        "start": 1190,
        "end": 1194
      },
      "text": "སྐམ་ ༼སྣར། པེ།༽ སྐམས་"
    },
    {
      "span": {
        "start": 1279,
        "end": 1285
      },
      "text": "ཁ་བྱེ་ ༼སྣར། པེ།༽ ཁ་ཕྱེ་"
    },
    {
      "span": {
        "start": 2355,
        "end": 2369
      },
      "text": "སློབ་དཔོན་ཆེན་ ༼པེ།༽ སློབ་དཔོན་"
    }
  ]
}