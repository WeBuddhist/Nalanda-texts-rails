{
  "durchens": [
    {
      "span": {
        "start": 51,
        "end": 55
      },
      "text": "ནཱ་མ། ༼པེ། སྣར།༽ ན་ནཱ་མཿ།"
    },
    {
      "span": {
        "start": 500,
        "end": 503
      },
      "text": "ལྷ་ ༼པེ། སྣར།༽ ལྷར།"
    },
    {
      "span": {
        "start": 883,
        "end": 890
      },
      "text": "གྱུར་ཏེ་ ༼སྣར།༽ གྱུར་ཏོ། །"
    },
    {
      "span": {
        "start": 1157,
        "end": 1160
      },
      "text": "བྱས་ ༼པེ། སྣར།༽ བྱ།"
    },
    {
      "span": {
        "start": 1212,
        "end": 1217
      },
      "text": "བརྒྱན་ ༼པེ།༽ རྒྱན།"
    },
    {
      "span": {
        "start": 1261,
        "end": 1266
      },
      "text": "དྲངས་ ༼པེ། སྣར།༽ དྲང་།"
    },
    {
      "span": {
        "start": 1293,
        "end": 1297
      },
      "text": "ཧོཿས་ ༼པེ། སྣར།༽ ཧོཿ།"
    },
    {
      "span": {
        "start": 1498,
        "end": 1502
      },
      "text": "བསྔོ། ༼པེ། སྣར།༽ བསྔོས།"
    },
    {
      "span": {
        "start": 1523,
        "end": 1527
      },
      "text": "བསལ་ ༼པེ། སྣར།༽ གསལ།"
    },
    {
      "span": {
        "start": 1650,
        "end": 1652
      },
      "text": "ཀ ༼པེ། སྣར།༽ བྷྱ་ཀཱ།"
    },
    {
      "span": {
        "start": 1666,
        "end": 1672
      },
      "text": "ལོ་ཙཱ་ ༼པེ། སྣར།༽ ལོ་ཙ།"
    },
    {
      "span": {
        "start": 1694,
        "end": 1703
      },
      "text": "བསྟན་འགྱུར་དཔེ་བསྡུར་མ། རྒྱུད། ༼ལ༽ དེབ་ཨང་ ༡༤ པ། ཤོག་གྲངས་ ༡༦༣༠ ནས་ ༡༦༣༡ བར་བཞུགས་མོད། མཛད་བྱང་དུ་མཛད་པ་པོའི་མཚན་གསལ་མེད། འོན་ཀྱང་མགོན་པོའི་རྒྱུད་རྒྱ་གཞུང་འགྱུར་སྔ་ཕྱི་དང་བོད་ཀྱི་ལོ་ཙཱ་བ་དང་བླ་མ་གོང་མ་རྣམས་ཀྱི་མན་ངག་གཏོར་སོགས་སྣ་ཚོགས་བཞུགས་པའི་མཚན་བྱང་། མགོན་པོའི་རྒྱུད་སྐོར། པོད། ༼༢༽ དབུ་མེད་བྲིས་མ། ཤོག་གྲངས་ ༨༣༧ ནས་ ༨༤༥ བར་བཞུགས་པའི་དཔེ་ཐུང་ཤོག་བུ་གསུམ་ཅན་ནང་། མགོན་པོ་བྱ་རོག་ཅན་གྱི་ནང་སྒྲུབ་ཅེས་བྱ་བ་བཞུགས་སོ། །ཞེས་དང་། མཇུག་བྱང་ལས། སློབ་དཔོན་ཆེན་པོ་ཨཱརྱ་དེ་ཝས་མཛད་པ་ཞེས་གསལ་བར་བྱུང་ལ། རྒྱ་གར་སྐད་སོགས་ཡིག་འབྲུ་རེ་ཟུང་ལ་ཁྱད་པར་ཅུང་ཟད་ཙམ་རེ་མཆིས་སོ།།"
    }
  ]
}