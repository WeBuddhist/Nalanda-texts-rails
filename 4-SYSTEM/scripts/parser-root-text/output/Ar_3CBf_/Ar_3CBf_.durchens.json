{
  "durchens": [
    {
      "span": {
        "start": 51,
        "end": 55
      },
      "text": "ནཱ་མ། ༼པེ། སྣར།༽ ན་ནཱ་མཿ།"
    },
    {
      "span": {
        "start": 500,
        "end": 503
      },
      "text": "ལྷ་ ༼པེ། སྣར།༽ ལྷར།"
    },
    {
      "span": {
        "start": 883,
        "end": 890
      },
      "text": "གྱུར་ཏེ་ ༼སྣར།༽ གྱུར་ཏོ། །"
    },
    {
      "span": {
        "start": 1157,
        "end": 1160
      },
      "text": "བྱས་ ༼པེ། སྣར།༽ བྱ།"
    },
    {
      "span": {
        "start": 1212,
        "end": 1217
      },
      "text": "བརྒྱན་ ༼པེ།༽ རྒྱན།"
    },
    {
      "span": {
        "start": 1261,
        "end": 1266
      },
      "text": "དྲངས་ ༼པེ། སྣར།༽ དྲང་།"
    },
    {
      "span": {
        "start": 1293,
        "end": 1297
      },
      "text": "ཧོཿས་ ༼པེ། སྣར།༽ ཧོཿ།"
    },
    {
      "span": {
        "start": 1498,
        "end": 1502
      },
      "text": "བསྔོ། ༼པེ། སྣར།༽ བསྔོས།"
    },
    {
      "span": {
        "start": 1523,
        "end": 1527
      },
      "text": "བསལ་ ༼པེ། སྣར།༽ གསལ།"
    },
    {
      "span": {
        "start": 1650,
        "end": 1652
      },
      "text": "ཀ ༼པེ། སྣར།༽ བྷྱ་ཀཱ།"
    },
    {
      "span": {
        "start": 1666,
        "end": 1672
      },
      "text": "ལོ་ཙཱ་ ༼པེ། སྣར།༽ ལོ་ཙ།"
    }
  ]
}