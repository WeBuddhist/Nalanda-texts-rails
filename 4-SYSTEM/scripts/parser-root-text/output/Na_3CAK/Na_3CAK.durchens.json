{
  "durchens": [
    {
      "span": {
        "start": 218,
        "end": 221
      },
      "text": "ལི་ ༼སྣར། པེ།༽ ལཱི་"
    },
    {
      "span": {
        "start": 414,
        "end": 460
      },
      "text": "། །དེའི་ལུས་ལ་ཡང་དུག་གིས་འགོ་བར་མི་འགྱུར་རོ། ། ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 477,
        "end": 493
      },
      "text": "དགེ་སློང་དག་གིས་ ༼སྣར། པེ།༽ དགེ་སློང་"
    },
    {
      "span": {
        "start": 517,
        "end": 523
      },
      "text": "འཚོའི་ ༼སྣར།༽ ཚོའི་"
    },
    {
      "span": {
        "start": 624,
        "end": 629
      },
      "text": "བཟུང་ ༼སྣར།༽ གཟུང་"
    },
    {
      "span": {
        "start": 652,
        "end": 656
      },
      "text": "འགས་ ༼སྣར།༽ གགས་"
    },
    {
      "span": {
        "start": 659,
        "end": 668
      },
      "text": "འགྱུར་ཏེ། ༼སྣར།༽ འགྱུར་རོ།"
    },
    {
      "span": {
        "start": 782,
        "end": 793
      },
      "text": "རིས་བསྒྱུར་ ༼སྣར།༽ རི་སྒྱུར་"
    }
  ]
}