{
  "durchens": [
    {
      "span": {
        "start": 331,
        "end": 339
      },
      "text": "ཁྱམས་དར་ ༼སྣར། པེ།༽ ཁྱམས་"
    },
    {
      "span": {
        "start": 549,
        "end": 558
      },
      "text": "བརྩམས་ཏེ། ༼སྣར། པེ།༽ བརྩམས་པ་སྟེ།"
    },
    {
      "span": {
        "start": 1163,
        "end": 1171
      },
      "text": "འབྱོར་པ་ ༼སྣར། པེ།༽ འབྱོར་"
    },
    {
      "span": {
        "start": 1186,
        "end": 1193
      },
      "text": "གཟའ་དང་ ༼སྣར། པེ།༽ གཟའ་"
    },
    {
      "span": {
        "start": 1365,
        "end": 1384
      },
      "text": "བརྩམས་ཏེ་སྨིན་དྲུག་ ༼སྣར། པེ།༽ བརྩམས་ཏེ་"
    },
    {
      "span": {
        "start": 1403,
        "end": 1411
      },
      "text": "སྟོང་དང་ ༼སྣར། པེ།༽ སྟོང་"
    },
    {
      "span": {
        "start": 1421,
        "end": 1425
      },
      "text": "གཡས་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 1475,
        "end": 1482
      },
      "text": "དཀར་པོ་ ༼སྣར། པེ།༽ དཀར་"
    },
    {
      "span": {
        "start": 1502,
        "end": 1517
      },
      "text": "དེ་བཞིན་དུ་གཞན་ ༼སྣར། པེ།༽ དེའི་འོག་སྐུ་མདོག་"
    },
    {
      "span": {
        "start": 1621,
        "end": 1625
      },
      "text": "དཀར་ ༼སྣར། པེ།༽ དཀར་བ་"
    },
    {
      "span": {
        "start": 1655,
        "end": 1661
      },
      "text": "ནབ་སོ་ ༼སྣར། པེ།༽ ནབས་སོ་"
    },
    {
      "span": {
        "start": 1666,
        "end": 1673
      },
      "text": "དཀར་པོ་ ༼སྣར། པེ།༽ དཀར་སེར་"
    },
    {
      "span": {
        "start": 1679,
        "end": 1688
      },
      "text": "ཕུབ་བ་ལང་ ༼སྣར། པེ།༽ ཕུབ་ཁྱུང་"
    },
    {
      "span": {
        "start": 1697,
        "end": 1721
      },
      "text": "རྒྱལ་མདོག་དཀར་སེར་ཕྱག་ན་ ༼སྣར། པེ།༽ རྒྱལ་"
    },
    {
      "span": {
        "start": 1742,
        "end": 1754
      },
      "text": "སྐག་སྔོན་པོ་ ༼སྣར། པེ།༽ སྐག་"
    },
    {
      "span": {
        "start": 1808,
        "end": 1817
      },
      "text": "མདོག་སེར་ ༼སྣར། པེ།༽ མགོ་སེར་"
    },
    {
      "span": {
        "start": 1943,
        "end": 1947
      },
      "text": "ཕྱག་ ༼སྣར། པེ།༽ ཕྱག་རྣམས་"
    },
    {
      "span": {
        "start": 1953,
        "end": 1960
      },
      "text": "གླང་པོ་ ༼སྣར། པེ།༽ གླང་"
    },
    {
      "span": {
        "start": 1969,
        "end": 1978
      },
      "text": "དབོ་མདོག་ ༼སྣར། པེ།༽ སྐུ་མདོག་"
    },
    {
      "span": {
        "start": 2161,
        "end": 2169
      },
      "text": "གྱི་གདན་ ༼སྣར། པེ།༽ གྱི་བ་དན་"
    },
    {
      "span": {
        "start": 2221,
        "end": 2229
      },
      "text": "སྦྲུལ་ལ་ ༼སྣར། པེ།༽ སྦྲུལ་"
    },
    {
      "span": {
        "start": 2284,
        "end": 2289
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམས་ན་"
    },
    {
      "span": {
        "start": 2371,
        "end": 2378
      },
      "text": "སྣྲུབས་ ༼སྣར། པེ།༽ ཁྲུམས་"
    },
    {
      "span": {
        "start": 2850,
        "end": 2852
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 2914,
        "end": 2918
      },
      "text": "ཕྱག་ ༼སྣར། པེ།༽ ཕྱག་རྣམས་"
    },
    {
      "span": {
        "start": 3154,
        "end": 3162
      },
      "text": "སྔོན་པོ་ ༼སྣར། པེ།༽ སྔོན་མོ་"
    },
    {
      "span": {
        "start": 3357,
        "end": 3359
      },
      "text": "ཏ་ ༼སྣར། པེ།༽ རྟ་"
    },
    {
      "span": {
        "start": 3491,
        "end": 3494
      },
      "text": "ཝུ་ ༼སྣར། པེ།༽ འུ་"
    },
    {
      "span": {
        "start": 3786,
        "end": 3792
      },
      "text": "བསྟིམ་ ༼སྣར། པེ།༽ བསྟིམས་"
    },
    {
      "span": {
        "start": 3950,
        "end": 3956
      },
      "text": "གསར་པ་ ༼སྣར། པེ།༽ སར་པ་"
    },
    {
      "span": {
        "start": 3972,
        "end": 3977
      },
      "text": "བཏོན་ ༼སྣར། པེ།༽ སྟོན་"
    }
  ]
}