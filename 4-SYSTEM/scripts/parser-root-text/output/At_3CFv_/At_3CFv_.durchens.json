{
  "durchens": [
    {
      "span": {
        "start": 124,
        "end": 131
      },
      "text": "རྟོག་པ་ ༼པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 456,
        "end": 464
      },
      "text": "འོད་ཀྱི་ ༼སྣར། པེ།༽ འོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 492,
        "end": 503
      },
      "text": "ཕྲེང་བ་ཡིས། ༼སྣར། པེ།༽ ཕྲེང་བ་ཡི།"
    },
    {
      "span": {
        "start": 613,
        "end": 617
      },
      "text": "ཡིས། ༼སྣར། པེ།༽ ཡི།"
    },
    {
      "span": {
        "start": 1112,
        "end": 1118
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 1335,
        "end": 1341
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 1382,
        "end": 1391
      },
      "text": "སེམས་པའི། ༼སྣར། པེ།༽ སེམས་དཔའི།"
    },
    {
      "span": {
        "start": 1486,
        "end": 1496
      },
      "text": "མྱང་སྟོབས་ ༼སྣར། པེ།༽ མྱོང་སྟོབས་"
    },
    {
      "span": {
        "start": 1831,
        "end": 1837
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 1906,
        "end": 1913
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 2066,
        "end": 2072
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    }
  ]
}