{
  "durchens": [
    {
      "span": {
        "start": 63,
        "end": 70
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 70,
        "end": 81
      },
      "text": "སྟེ་བསྒྲུབ་ ༼སྣར།༽ སྟེ་ཐོག་བསྒྲུབ་ ༼པེ།༽ སྟེ་ཐོག་སྒྲུབ་"
    },
    {
      "span": {
        "start": 252,
        "end": 258
      },
      "text": "འཁྲུག་ ༼སྣར།༽ ཁྲུག་"
    },
    {
      "span": {
        "start": 437,
        "end": 442
      },
      "text": "རེ་ལ་ ༼སྣར། པེ།༽ ལ་ལ་"
    },
    {
      "span": {
        "start": 743,
        "end": 748
      },
      "text": "སྔོན་ ༼སྣར། པེ།༽ སྔོ་"
    },
    {
      "span": {
        "start": 919,
        "end": 924
      },
      "text": "ཏྲིག་ ༼སྣར། པེ།༽ ཏྲི་"
    },
    {
      "span": {
        "start": 1033,
        "end": 1044
      },
      "text": "དེ་ཉིད་ཀྱི་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 1154,
        "end": 1161
      },
      "text": "མི་འཆད་ ༼སྣར། པེ།༽ མ་ཆད་"
    },
    {
      "span": {
        "start": 1206,
        "end": 1214
      },
      "text": "ཐོན་པའི་ ༼སྣར། པེ།༽ འཐོན་པའི་"
    },
    {
      "span": {
        "start": 1257,
        "end": 1264
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    }
  ]
}