{
  "durchens": [
    {
      "span": {
        "start": 86,
        "end": 89
      },
      "text": "ཙི་ ༼སྣར། པེ།༽ ཙཱི་"
    },
    {
      "span": {
        "start": 657,
        "end": 667
      },
      "text": "ཕྱུངས་ཤིག་ ༼སྣར། པེ།༽ ཕྱུང་ཞིག་"
    },
    {
      "span": {
        "start": 687,
        "end": 695
      },
      "text": "རྒྱས་པར་ ༼སྣར། པེ།༽ རྒྱས་པས་"
    },
    {
      "span": {
        "start": 778,
        "end": 781
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 846,
        "end": 854
      },
      "text": "ཁ་སྦྱོར་ ༼སྣར། པེ།༽ ཁ་སྦྱར་"
    },
    {
      "span": {
        "start": 937,
        "end": 943
      },
      "text": "བསྟོད་ ༼སྣར།༽ བརྗོད་སྟོད་"
    },
    {
      "span": {
        "start": 1053,
        "end": 1060
      },
      "text": "ལེགས་པ་ ༼སྣར། པེ།༽ ལེགས་པར་"
    }
  ]
}