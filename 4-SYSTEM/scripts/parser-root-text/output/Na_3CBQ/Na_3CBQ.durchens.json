{
  "durchens": [
    {
      "span": {
        "start": 44,
        "end": 46
      },
      "text": "ཤ་ ༼སྣར།༽ ཤཱ་"
    },
    {
      "span": {
        "start": 73,
        "end": 83
      },
      "text": "བསྟན་བཅོས་ ༼སྣར། པེ།༽ བསྟན་ཆོས་"
    },
    {
      "span": {
        "start": 187,
        "end": 195
      },
      "text": "ཀུན་གྱི་ ༼སྣར། པེ།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 216,
        "end": 223
      },
      "text": "ཁྱབ་པས་ ༼སྣར། པེ།༽ ཁྱབ་པར་"
    },
    {
      "span": {
        "start": 244,
        "end": 251
      },
      "text": "དཔལ་དུ་ ༼སྣར།༽ དཔལ་གྱི་ ༼པེ།༽ དཔལ་གྱིས་"
    },
    {
      "span": {
        "start": 353,
        "end": 368
      },
      "text": "སྒྲོན་མེ་རབ་ཏུ་ ༼སྣར། པེ།༽ སྒྲོན་མ་ལྟ་བུ་"
    },
    {
      "span": {
        "start": 395,
        "end": 398
      },
      "text": "པས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 402,
        "end": 405
      },
      "text": "ངག་ ༼སྣར། པེ།༽ སྔགས་"
    },
    {
      "span": {
        "start": 535,
        "end": 539
      },
      "text": "བདག་ ༼སྣར།༽ དུ་དག་"
    },
    {
      "span": {
        "start": 727,
        "end": 731
      },
      "text": "སུས་ ༼སྣར། པེ།༽ སུ་"
    },
    {
      "span": {
        "start": 741,
        "end": 743
      },
      "text": "མ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 774,
        "end": 781
      },
      "text": "ཕུང་བར་ ༼སྣར། པེ།༽ འཕུང་བར་"
    },
    {
      "span": {
        "start": 885,
        "end": 892
      },
      "text": "ཀ་ལན་ད་ ༼སྣར།༽ ཀ་ལན་ ༼པེ།༽ ཀ་ལནྟ་"
    },
    {
      "span": {
        "start": 902,
        "end": 912
      },
      "text": "བཤིག་བ་ཡི་ ༼སྣར།༽ བཤིག་བ་མི་"
    },
    {
      "span": {
        "start": 1084,
        "end": 1088
      },
      "text": "སྨྲ། ༼སྣར། པེ།༽ སྨྲས།"
    },
    {
      "span": {
        "start": 1108,
        "end": 1112
      },
      "text": "སྨྲ་ ༼སྣར། པེ།༽ སྨྲས་"
    },
    {
      "span": {
        "start": 1133,
        "end": 1143
      },
      "text": "བསྙོན་ཚིག་ ༼སྣར། པེ།༽ བསྟན་བཅོས་"
    },
    {
      "span": {
        "start": 1157,
        "end": 1170
      },
      "text": "མེད་པའི་རྫུན་ ༼སྣར། པེ།༽ མེད་པའི་"
    },
    {
      "span": {
        "start": 1170,
        "end": 1174
      },
      "text": "ཚིག་ ༼སྣར། པེ།༽ ཚིག་རྩུབ་"
    },
    {
      "span": {
        "start": 1197,
        "end": 1202
      },
      "text": "བྱའོ། ༼སྣར། པེ།༽ བྱ་སྟེ།"
    },
    {
      "span": {
        "start": 1397,
        "end": 1406
      },
      "text": "སྤྱོད་པར་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 1411,
        "end": 1415
      },
      "text": "ཡིས། ༼སྣར། པེ།༽ མིན།"
    },
    {
      "span": {
        "start": 1446,
        "end": 1452
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ དེ་ཡིས་"
    },
    {
      "span": {
        "start": 1483,
        "end": 1487
      },
      "text": "ཡའི་ ༼སྣར། པེ།༽ ཡ་"
    },
    {
      "span": {
        "start": 1506,
        "end": 1511
      },
      "text": "བཤེས་ ༼སྣར། པེ།༽ ཤེས་"
    },
    {
      "span": {
        "start": 1525,
        "end": 1529
      },
      "text": "སྙན། ༼སྡེ། ཅོ། པེ།༽ མཉན།"
    },
    {
      "span": {
        "start": 1535,
        "end": 1543
      },
      "text": "བཤེས་ངན་ ༼སྣར།༽ ཤེས་ཉན་ ༼པེ།༽ ཤེས་ངན་"
    },
    {
      "span": {
        "start": 1571,
        "end": 1574
      },
      "text": "པར་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 1620,
        "end": 1628
      },
      "text": "གཡོན་ཅན་ ༼སྣར། པེ།༽ གཡོ་ཅན་"
    },
    {
      "span": {
        "start": 1642,
        "end": 1645
      },
      "text": "ཉན། ༼སྡེ། ཅོ། པེ།༽ མཉན།"
    },
    {
      "span": {
        "start": 1706,
        "end": 1713
      },
      "text": "ལྷ་མིན་ ༼སྣར། པེ།༽ སྤྱང་ཀི་"
    },
    {
      "span": {
        "start": 1728,
        "end": 1733
      },
      "text": "ལྟོས། ༼སྣར།༽ བལྟོས།"
    },
    {
      "span": {
        "start": 1788,
        "end": 1790
      },
      "text": "པ། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 1871,
        "end": 1876
      },
      "text": "ཞིང་། ༼སྣར། པེ།༽ བཞིན།"
    },
    {
      "span": {
        "start": 1878,
        "end": 1885
      },
      "text": "དགའ་བས་ ༼སྣར། པེ།༽ དགའ་བ་"
    },
    {
      "span": {
        "start": 1910,
        "end": 1918
      },
      "text": "སྡིག་ཅན་ ༼སྣར། པེ།༽ སྡིག་ངན་"
    },
    {
      "span": {
        "start": 1953,
        "end": 1961
      },
      "text": "སྲིན་མོ་ ༼སྣར།༽ སྲིན་པོ་"
    },
    {
      "span": {
        "start": 2112,
        "end": 2118
      },
      "text": "བསྡོས་ ༼སྣར།༽ སྡོས་"
    },
    {
      "span": {
        "start": 2267,
        "end": 2276
      },
      "text": "ནི་པད་མོ་ ༼པེ།༽ ནི་པདྨ་"
    },
    {
      "span": {
        "start": 2337,
        "end": 2344
      },
      "text": "ནས་གསོ། ༼སྣར།༽ ནས་པ་ནི་རྒུན་ནས་གསོས ༼པེ།༽ པས་ནི་རྒུན་ནས་གསོས།"
    },
    {
      "span": {
        "start": 2385,
        "end": 2393
      },
      "text": "འཕྲལ་དུ་ ༼སྣར། པེ།༽ འབྲས་བུ་"
    },
    {
      "span": {
        "start": 2538,
        "end": 2542
      },
      "text": "བཅས་ ༼སྣར། པེ།༽ ཡོད་"
    },
    {
      "span": {
        "start": 2758,
        "end": 2768
      },
      "text": "མེད་པ་ཡིས། ༼སྣར། པེ།༽ མེད་པ་ཡི།"
    },
    {
      "span": {
        "start": 2794,
        "end": 2802
      },
      "text": "ཀུན་གྱི་ ༼སྣར།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 2841,
        "end": 2848
      },
      "text": "བསླང་བ་ ༼སྣར། པེ།༽ བསླངས་བ་"
    },
    {
      "span": {
        "start": 2894,
        "end": 2898
      },
      "text": "རྩྭ་ ༼སྣར། པེ།༽ རྩ་"
    },
    {
      "span": {
        "start": 2931,
        "end": 2938
      },
      "text": "འབར་བར་ ༼སྣར། པེ།༽ སྤར་བར་"
    },
    {
      "span": {
        "start": 2967,
        "end": 2970
      },
      "text": "བྱ། ༼སྣར།༽ བགྱིས ༼པེ།༽ གྱིས།"
    },
    {
      "span": {
        "start": 2998,
        "end": 3006
      },
      "text": "གཞན་གྱི་ ༼སྣར།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 3156,
        "end": 3165
      },
      "text": "ཞིམ་པ་མང་ ༼སྣར། པེ།༽ ཞིམ་"
    },
    {
      "span": {
        "start": 3168,
        "end": 3199
      },
      "text": "བསྟེན་བྱས་ཀྱང་། །དེས་ནི་ངེས་པར་ ༼སྣར། པེ།༽ མང་པོས་ཕན་བཏགས་ཀྱང་། །ཕན་མེད་"
    },
    {
      "span": {
        "start": 3213,
        "end": 3219
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 3274,
        "end": 3281
      },
      "text": "རྣམ་པར་ ༼སྣར། པེ།༽ གཡོ་ཞིང་"
    },
    {
      "span": {
        "start": 3311,
        "end": 3315
      },
      "text": "རྟག་ ༼སྣར།༽ བརྟག་"
    },
    {
      "span": {
        "start": 3372,
        "end": 3381
      },
      "text": "ཚོན་གྱིས་ ༼སྣར།༽ ཚོས་ཀྱིས་ ༼པེ།༽ ཚོས་ཀྱི་"
    },
    {
      "span": {
        "start": 3416,
        "end": 3422
      },
      "text": "མཁས་པ་ ༼སྣར། པེ།༽ མཁས་པས་"
    },
    {
      "span": {
        "start": 3571,
        "end": 3583
      },
      "text": "འཇིག་རྟེན་ས་ ༼སྣར། པེ།༽ འཇིག་རྟེན་པ་"
    },
    {
      "span": {
        "start": 3628,
        "end": 3632
      },
      "text": "གཟོ་ ༼སྣར། པེ།༽ བཟོ་"
    },
    {
      "span": {
        "start": 3714,
        "end": 3718
      },
      "text": "གཟོ་ ༼སྣར། པེ།༽ བཟོ་"
    },
    {
      "span": {
        "start": 3743,
        "end": 3748
      },
      "text": "གསོན་ ༼སྣར། པེ།༽ བཟོན་"
    },
    {
      "span": {
        "start": 3760,
        "end": 3766
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 4086,
        "end": 4096
      },
      "text": "འོངས་གྱུར་ ༼སྣར། པེ།༽ འོང་འགྱུར་"
    },
    {
      "span": {
        "start": 4135,
        "end": 4142
      },
      "text": "རྒན་པོ་ ༼སྣར། པེ།༽ རྒན་དང་"
    },
    {
      "span": {
        "start": 4171,
        "end": 4176
      },
      "text": "སྟོར་ ༼སྣར། པེ།༽ དོར་"
    },
    {
      "span": {
        "start": 4286,
        "end": 4291
      },
      "text": "སྤངས་ ༼སྣར། པེ།༽ དཔགས་"
    },
    {
      "span": {
        "start": 4296,
        "end": 4304
      },
      "text": "གཞན་གྱི་ ༼པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 4338,
        "end": 4345
      },
      "text": "ལྡོག་པ་ ༼སྣར། པེ།༽ ཟློས་པ་"
    },
    {
      "span": {
        "start": 4456,
        "end": 4461
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 4543,
        "end": 4553
      },
      "text": "གཞན་བགྱིས་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 4606,
        "end": 4611
      },
      "text": "བརྙས་ ༼སྣར། པེ།༽ སྔང་"
    },
    {
      "span": {
        "start": 4677,
        "end": 4684
      },
      "text": "དཀོན། ། ༼སྣར། པེ།༽ སྐོན །"
    },
    {
      "span": {
        "start": 4725,
        "end": 4733
      },
      "text": "སེམས་ནི་ ༼སྣར། པེ།༽ སེམས་ཅན་"
    },
    {
      "span": {
        "start": 4757,
        "end": 4762
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ བཞིན་མུ་ཅོར་"
    },
    {
      "span": {
        "start": 4775,
        "end": 4788
      },
      "text": "འདུག་པར་བྱ། ། ༼སྣར། པེ།༽ འདུག །"
    },
    {
      "span": {
        "start": 4832,
        "end": 4838
      },
      "text": "ཕྱོགས་ ༼སྣར། པེ།༽ སྟོབས་"
    },
    {
      "span": {
        "start": 4842,
        "end": 4848
      },
      "text": "སྟོབས་ ༼སྣར། པེ།༽ ཕྱོགས་"
    },
    {
      "span": {
        "start": 4856,
        "end": 4866
      },
      "text": "གྱུར་ཅིང་། ༼སྣར། པེ།༽ གྱུར་ཞིང་།"
    },
    {
      "span": {
        "start": 4957,
        "end": 4972
      },
      "text": "ཁེངས་པས་ཤིན་ཏུ་ ༼སྣར། པེ།༽ ཁེངས་པས་"
    },
    {
      "span": {
        "start": 4974,
        "end": 4979
      },
      "text": "རྒྱལ་ ༼སྣར། པེ།༽ རྒྱལ་ཤིན་ཏུ་"
    },
    {
      "span": {
        "start": 5000,
        "end": 5003
      },
      "text": "ཁྭ་ ༼སྣར། པེ།༽ ཁ་"
    },
    {
      "span": {
        "start": 5045,
        "end": 5050
      },
      "text": "བརྐམ་ ༼སྣར།༽ སྐམས་ ༼པེ།༽ སྐམ་"
    },
    {
      "span": {
        "start": 5053,
        "end": 5062
      },
      "text": "ཁྲེལ་མེད་ ༼སྣར། པེ།༽ ཁྲིམས་མེད་"
    },
    {
      "span": {
        "start": 5099,
        "end": 5104
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ བཞིན་ཤིན་ཏུ་"
    },
    {
      "span": {
        "start": 5245,
        "end": 5253
      },
      "text": "བཞིན་ནོ། ༼སྣར། པེ།༽ དང་འདྲ།"
    },
    {
      "span": {
        "start": 5301,
        "end": 5308
      },
      "text": "ཞེན་པས། ༼སྣར། པེ།༽ ཞེན་པ།"
    },
    {
      "span": {
        "start": 5384,
        "end": 5390
      },
      "text": "གཟོའི་ ༼སྣར། པེ།༽ བཟོའི་"
    },
    {
      "span": {
        "start": 5466,
        "end": 5474
      },
      "text": "གཅན་གཟན་ ༼སྣར།༽ གཅན་ཟན་"
    },
    {
      "span": {
        "start": 5482,
        "end": 5489
      },
      "text": "བཅུག་པ་ ༼སྣར། པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 5496,
        "end": 5508
      },
      "text": "དྲེགས་པ་ལོག་ ༼སྣར། པེ།༽ དྲེགས་པའི་ལོངས་"
    },
    {
      "span": {
        "start": 5542,
        "end": 5547
      },
      "text": "བསམས་ ༼སྣར།༽ བསམ་"
    },
    {
      "span": {
        "start": 5573,
        "end": 5575
      },
      "text": "བ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 5605,
        "end": 5617
      },
      "text": "རྨོངས་པ་ལོང་ ༼ཅོ།༽ རྨོངས་པ་ཡོང་བ་ ༼སྣར།༽ རྨོངས་པའི་ལོག་པ་ ༼པེ།༽ རྨོངས་པའི་ལག་པ་"
    },
    {
      "span": {
        "start": 5911,
        "end": 5918
      },
      "text": "ཕུང་བར་ ༼སྣར། པེ།༽ འཕུང་བར་"
    },
    {
      "span": {
        "start": 5918,
        "end": 5926
      },
      "text": "འགྱུར་བ་ ༼སྣར།༽ འགྱུར་བར་"
    },
    {
      "span": {
        "start": 6087,
        "end": 6094
      },
      "text": "བྱེད་ལ། ༼སྣར། པེ།༽ བྱེད་པ།"
    },
    {
      "span": {
        "start": 6183,
        "end": 6189
      },
      "text": "ཕྱི་མ་ ༼པེ།༽ ཕྱི་མར་"
    },
    {
      "span": {
        "start": 6211,
        "end": 6219
      },
      "text": "བར་དོའི་ ༼སྣར།༽ བར་དོར་ ༼པེ།༽ བར་དོ་"
    },
    {
      "span": {
        "start": 6224,
        "end": 6227
      },
      "text": "པར་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 6293,
        "end": 6298
      },
      "text": "འཕྱེ། ༼སྣར། པེ།༽ ཕྱེ།"
    },
    {
      "span": {
        "start": 6300,
        "end": 6308
      },
      "text": "རང་འདོད་ ༼སྣར། པེ།༽ རང་དབང་"
    },
    {
      "span": {
        "start": 6349,
        "end": 6355
      },
      "text": "འཁྲིད། ༼སྣར། པེ།༽ ཁྲིད།"
    },
    {
      "span": {
        "start": 6377,
        "end": 6381
      },
      "text": "སླུ་ ༼སྣར། པེ།༽ བསླུ་"
    },
    {
      "span": {
        "start": 6385,
        "end": 6392
      },
      "text": "ཁོ་བོས་ ༼སྣར། པེ།༽ ཁོ་མོ་"
    },
    {
      "span": {
        "start": 6397,
        "end": 6400
      },
      "text": "གི་ ༼སྣར། པེ།༽ བའི་"
    },
    {
      "span": {
        "start": 6453,
        "end": 6466
      },
      "text": "སྐྱེ་བོ་རྣམས། ༼སྣར། པེ།༽ སྐྱེས་རྣམས་ཀྱིས།"
    },
    {
      "span": {
        "start": 6589,
        "end": 6601
      },
      "text": "འཁྲུལ་པ་སྟེ། ༼སྣར། པེ།༽ འཁྲུལ་པ་དེ།"
    },
    {
      "span": {
        "start": 6766,
        "end": 6800
      },
      "text": "ཉེས་པ་དང་། །མ་ལུས་པ་ནི་བསྡམ་པར་བྱ། ༼སྣར། པེ།༽ ཉེས་པ་སྤང་།"
    },
    {
      "span": {
        "start": 6818,
        "end": 6828
      },
      "text": "ཉེས་པ་ཡང་། ༼སྣར། པེ།༽ ཉེས་པ་སྤང་།"
    },
    {
      "span": {
        "start": 6895,
        "end": 6901
      },
      "text": "གྲང་བ་ ༼སྣར། པེ།༽ དྲང་བ་"
    },
    {
      "span": {
        "start": 6901,
        "end": 6904
      },
      "text": "ཡི། ༼སྣར།༽ ཡིན།"
    },
    {
      "span": {
        "start": 6913,
        "end": 6923
      },
      "text": "ཉི་མ་གཅིག་ ༼སྣར། པེ།༽ ཉི་མ་ཅིག་"
    },
    {
      "span": {
        "start": 6971,
        "end": 6974
      },
      "text": "དག་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 7031,
        "end": 7035
      },
      "text": "བལྟ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 7059,
        "end": 7063
      },
      "text": "རྣམ་ ༼པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 7157,
        "end": 7164
      },
      "text": "གཅད་པར་ ༼སྣར། པེ།༽ བཅད་པར་"
    },
    {
      "span": {
        "start": 7197,
        "end": 7204
      },
      "text": "ཕྱི་མར་ ༼སྣར། པེ།༽ ཕྱི་ནས་"
    },
    {
      "span": {
        "start": 7295,
        "end": 7304
      },
      "text": "ཀྱིས་རྡོ་ ༼སྣར། པེ།༽ ཀྱི་བརྡོ་"
    },
    {
      "span": {
        "start": 7384,
        "end": 7393
      },
      "text": "། །ལོ་ཡི་ ༼སྣར། པེ།༽ ། །ལེ་ལོའི་"
    },
    {
      "span": {
        "start": 7468,
        "end": 7480
      },
      "text": "རིགས་དང་བྲན་ ༼སྣར། པེ།༽ རིགས་ངན་གཤན་"
    },
    {
      "span": {
        "start": 7535,
        "end": 7543
      },
      "text": "བཙུན་པར་ ༼སྣར། པེ།༽ བཙུན་མོར་"
    },
    {
      "span": {
        "start": 7601,
        "end": 7603
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལྟས་"
    },
    {
      "span": {
        "start": 7606,
        "end": 7611
      },
      "text": "སྲུང་ ༼པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 7630,
        "end": 7635
      },
      "text": "བཤུང་ ༼པེ།༽ གཤུང་"
    },
    {
      "span": {
        "start": 7646,
        "end": 7649
      },
      "text": "བི་ ༼སྣར། པེ།༽ བྷི་"
    },
    {
      "span": {
        "start": 7680,
        "end": 7685
      },
      "text": "འདོམ་ ༼སྣར། པེ།༽ མདོམ་"
    },
    {
      "span": {
        "start": 7765,
        "end": 7772
      },
      "text": "ལྟུང་བ་ ༼སྣར། པེ།༽ ལྷུང་བ་"
    },
    {
      "span": {
        "start": 7779,
        "end": 7785
      },
      "text": "སྲུང་། ༼སྣར། པེ།༽ རུང་།"
    },
    {
      "span": {
        "start": 7797,
        "end": 7804
      },
      "text": "ཙམ་གྱི་ ༼སྣར། པེ།༽ ཙམ་གྱིས་"
    },
    {
      "span": {
        "start": 7863,
        "end": 7868
      },
      "text": "གས་པ་ ༼སྣར། པེ།༽ འགས་པ་"
    },
    {
      "span": {
        "start": 7909,
        "end": 7913
      },
      "text": "འགའ་ ༼སྣར། པེ།༽ དགའ་"
    },
    {
      "span": {
        "start": 7962,
        "end": 7973
      },
      "text": "གྱི་བསྐལ་པ་ ༼སྣར། པེ།༽ གྱི་སྐལ་"
    },
    {
      "span": {
        "start": 7985,
        "end": 7993
      },
      "text": "ཟས་སྐོམ་ ༼སྣར། པེ།༽ ཟས་གོས་"
    },
    {
      "span": {
        "start": 7996,
        "end": 8001
      },
      "text": "མྱོང་ ༼ཅོ། སྡེ།༽ བརྒྱོང་"
    },
    {
      "span": {
        "start": 8105,
        "end": 8112
      },
      "text": "འབྲལ་བ་ ༼སྣར།༽ འབྲེལ་པ་"
    },
    {
      "span": {
        "start": 8130,
        "end": 8134
      },
      "text": "འབུ་ ༼སྣར། པེ།༽ དྲེའུ་"
    },
    {
      "span": {
        "start": 8138,
        "end": 8143
      },
      "text": "སྲིན་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 8218,
        "end": 8223
      },
      "text": "རྟེན་ ༼པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 8228,
        "end": 8234
      },
      "text": "ཕུང་བ་ ༼སྣར། པེ།༽ འཕུང་བ་"
    },
    {
      "span": {
        "start": 8234,
        "end": 8241
      },
      "text": "བསྒྲུབ། ༼སྣར། པེ།༽ སྒྲུབ།"
    },
    {
      "span": {
        "start": 8253,
        "end": 8264
      },
      "text": "པ་མཛངས་པའི་ ༼སྣར།༽ མ་འཛངས་མའི་ ༼པེ།༽ མ་འཛངས་པའི་"
    },
    {
      "span": {
        "start": 8388,
        "end": 8395
      },
      "text": "སྐྱོ་བ་ ༼སྣར། པེ།༽ སྐྱོ་བོ་"
    },
    {
      "span": {
        "start": 8521,
        "end": 8526
      },
      "text": "གཡེང་ ༼སྣར། པེ།༽ གཡེངས་"
    },
    {
      "span": {
        "start": 8560,
        "end": 8564
      },
      "text": "ཚུལ། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 8703,
        "end": 8707
      },
      "text": "སླུ་ ༼སྣར། པེ།༽ བསླུ་"
    },
    {
      "span": {
        "start": 8766,
        "end": 8771
      },
      "text": "ལྟའི་ ༼སྣར། པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 8775,
        "end": 8780
      },
      "text": "དང་མ་ ༼སྣར། པེ།༽ དང་མི་"
    },
    {
      "span": {
        "start": 8784,
        "end": 8786
      },
      "text": "ལ། ༼སྣར། པེ།༽ པ།"
    },
    {
      "span": {
        "start": 8837,
        "end": 8843
      },
      "text": "སླུའི་ ༼སྣར། པེ།༽ བསླུའི་"
    },
    {
      "span": {
        "start": 8863,
        "end": 8871
      },
      "text": "འདི་ཡིན་ ༼སྣར། པེ།༽ འདི་བཞིན་"
    },
    {
      "span": {
        "start": 8952,
        "end": 8958
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 8968,
        "end": 8970
      },
      "text": "ར་ ༼སྣར། པེ།༽ རི་"
    },
    {
      "span": {
        "start": 9206,
        "end": 9210
      },
      "text": "སྨྲ། ༼སྣར།༽ སྨྲས།"
    },
    {
      "span": {
        "start": 9220,
        "end": 9225
      },
      "text": "ཅ་ཅོ་ ༼སྣར། པེ།༽ ཅལ་ཅོལ་"
    },
    {
      "span": {
        "start": 9300,
        "end": 9315
      },
      "text": "སྦྱིན་པ་གཏང་བར་ ༼ཅོ།༽ སྦྱིན་པ་བཏང་བར་ ༼སྣར། པེ།༽ ལ་ཡངས་པར་"
    },
    {
      "span": {
        "start": 9329,
        "end": 9334
      },
      "text": "མེ་ལ་ ༼སྣར།༽ མི་ལ་ ༼པེ།༽ ལི་"
    },
    {
      "span": {
        "start": 9414,
        "end": 9421
      },
      "text": "བྱས་ནས་ ༼སྣར། པེ།༽ བྱས་ན་"
    },
    {
      "span": {
        "start": 9447,
        "end": 9454
      },
      "text": "ཐོབ་པར་ ༼སྣར། པེ།༽ འཐོབ་པར་"
    },
    {
      "span": {
        "start": 9461,
        "end": 9466
      },
      "text": "ད་ནི་ ༼སྣར། པེ།༽ ད་ལྟ་"
    },
    {
      "span": {
        "start": 9514,
        "end": 9521
      },
      "text": "ད་ནི་མ་ ༼སྣར། པེ།༽ ད་ནི་མན་"
    },
    {
      "span": {
        "start": 9554,
        "end": 9564
      },
      "text": "ངན་པའི་མི། ༼སྣར། པེ།༽ མང་བ་ཡི།"
    },
    {
      "span": {
        "start": 9643,
        "end": 9653
      },
      "text": "མེད་པ་ཡིས། ༼སྣར། པེ།༽ མེད་པ་ཡི།"
    },
    {
      "span": {
        "start": 9664,
        "end": 9672
      },
      "text": "བོར་ཞིང་ ༼སྣར། པེ།༽ བོར་ཤིང་"
    },
    {
      "span": {
        "start": 9695,
        "end": 9704
      },
      "text": "ཕ་རོལ་མི་ ༼སྣར། པེ།༽ ཕ་རོལ་མ་"
    },
    {
      "span": {
        "start": 9732,
        "end": 9737
      },
      "text": "བསྙལ་ ༼སྣར། པེ།༽ བརྙལ་"
    },
    {
      "span": {
        "start": 9758,
        "end": 9762
      },
      "text": "དཀའ་ ༼སྣར། པེ།༽ ཀ་"
    },
    {
      "span": {
        "start": 9933,
        "end": 9943
      },
      "text": "ཐུབ་པ་ཡིས། ༼སྣར། པེ།༽ ཐུབ་པ་ཡི།"
    },
    {
      "span": {
        "start": 9954,
        "end": 9962
      },
      "text": "ཚོང་དུས་ ༼སྣར།༽ ཚོང་འདུས་"
    },
    {
      "span": {
        "start": 10073,
        "end": 10080
      },
      "text": "གྲུ་བོ་ ༼སྣར། པེ།༽ གྲུབ་པོ་"
    },
    {
      "span": {
        "start": 10161,
        "end": 10164
      },
      "text": "གང་ ༼སྣར། པེ།༽ གངས་"
    },
    {
      "span": {
        "start": 10449,
        "end": 10454
      },
      "text": "སྟེན་ ༼སྣར། པེ།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 10469,
        "end": 10479
      },
      "text": "བསྟེན་ཞིང་ ༼སྣར། པེ།༽ བསྟེན་ཅིང་"
    },
    {
      "span": {
        "start": 10489,
        "end": 10494
      },
      "text": "སྤང་། ༼སྣར། པེ།༽ སྤངས།"
    },
    {
      "span": {
        "start": 10579,
        "end": 10586
      },
      "text": "བརྙས་ང་ ༼སྣར།༽ བརྙས་པ་"
    },
    {
      "span": {
        "start": 10633,
        "end": 10639
      },
      "text": "མ་རུང་ ༼སྣར། པེ།༽ མ་རུངས་"
    },
    {
      "span": {
        "start": 10682,
        "end": 10689
      },
      "text": "མི་བཟད་ ༼སྣར། པེ།༽ མི་ཟད་"
    },
    {
      "span": {
        "start": 10711,
        "end": 10718
      },
      "text": "ཅན་གྱི་ ༼སྣར། པེ།༽ ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 10762,
        "end": 10770
      },
      "text": "དེ་ལྟའི་ ༼སྣར། པེ།༽ དེ་ལྟ་བུ་ཡི་"
    },
    {
      "span": {
        "start": 10839,
        "end": 10850
      },
      "text": "ཕྱིན་ནས་སུ། ༼སྣར། པེ།༽ ཕྱིན་བ་ནི།"
    },
    {
      "span": {
        "start": 10852,
        "end": 10859
      },
      "text": "དེར་ཡང་ ༼སྣར། པེ།༽ དེ་ཡང་"
    },
    {
      "span": {
        "start": 10859,
        "end": 10867
      },
      "text": "ནགས་འདབ་ ༼སྣར། པེ།༽ ནགས་འདབས་"
    },
    {
      "span": {
        "start": 10885,
        "end": 10892
      },
      "text": "བསྙུངས་ ༼སྣར། པེ།༽ སྐྱུངས་"
    },
    {
      "span": {
        "start": 10986,
        "end": 10993
      },
      "text": "འཇོག་པ་ ༼སྣར། པེ།༽ འཇོག་པ་དེ་"
    },
    {
      "span": {
        "start": 10993,
        "end": 10999
      },
      "text": "ཉིད་ལ་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 11004,
        "end": 11012
      },
      "text": "ཅུང་ཞིག་ ༼སྣར། པེ།༽ ཅུང་ཟད་"
    },
    {
      "span": {
        "start": 11032,
        "end": 11044
      },
      "text": "ནི་འདི་རྣམས་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 11087,
        "end": 11091
      },
      "text": "ཡུན་ ༼སྣར། པེ།༽ བསྟན་ཆོས་ཡུལ་"
    },
    {
      "span": {
        "start": 11115,
        "end": 11125
      },
      "text": "བསྟན་བཅོས་ ༼སྣར། པེ།༽ བསྟན་ཆོས་ཀྱི་སྙན་དངགས་"
    },
    {
      "span": {
        "start": 11159,
        "end": 11169
      },
      "text": "སློབ་དཔོན་ ༼སྣར། པེ།༽ སློབ་དཔོན་འཕགས་པ་"
    }
  ]
}