{
  "durchens": [
    {
      "span": {
        "start": 45,
        "end": 47
      },
      "text": "ཀ་ ༼སྣར། པེ།༽ ཀཱ་"
    },
    {
      "span": {
        "start": 170,
        "end": 181
      },
      "text": "རྒྱ་མཚོ་ཡི། ༼སྣར།༽ རྒྱ་མཚོ་ཡིས།"
    },
    {
      "span": {
        "start": 240,
        "end": 248
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 274,
        "end": 283
      },
      "text": "གཞན་གྱིས་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 404,
        "end": 410
      },
      "text": "རྟག་པ་ ༼སྣར། པེ།༽ རྟགས་པ་"
    },
    {
      "span": {
        "start": 713,
        "end": 721
      },
      "text": "བརྟེན་པ་ ༼སྣར། པེ།༽ རྟེན་པ་"
    },
    {
      "span": {
        "start": 735,
        "end": 743
      },
      "text": "འབྲས་བུ་ ༼སྣར། པེ།༽ འབྲས་"
    },
    {
      "span": {
        "start": 856,
        "end": 870
      },
      "text": "། །ལྷ་སྦྱིན་བ་ ༼སྣར། པེ།༽ ། །ལྷས་བྱིན་"
    },
    {
      "span": {
        "start": 1638,
        "end": 1647
      },
      "text": "བརྟགས་ནས། ༼སྣར། པེ།༽ བརྟགས་ན།"
    },
    {
      "span": {
        "start": 1758,
        "end": 1765
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 1862,
        "end": 1873
      },
      "text": "ཇི་ལྟར་བལྟ་ ༼སྣར།༽ ཇི་ལྟར་ལྟ་ལྟ་ ༼པེ།༽ ལྟར་"
    },
    {
      "span": {
        "start": 1893,
        "end": 1900
      },
      "text": "ཅི་ཞིག་ ༼སྣར། པེ།༽ ཇི་ཞིག་"
    },
    {
      "span": {
        "start": 1907,
        "end": 1915
      },
      "text": "སྲིད་པར་ ༼སྣར། པེ།༽ སྲིད་"
    },
    {
      "span": {
        "start": 2021,
        "end": 2026
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 2123,
        "end": 2130
      },
      "text": "འཇིག་པ་ ༼སྣར། པེ།༽ འཇིགས་པ་"
    },
    {
      "span": {
        "start": 2613,
        "end": 2616
      },
      "text": "དེ་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 2789,
        "end": 2793
      },
      "text": "མགལ་ ༼སྣར། པེ།༽ འགལ་"
    },
    {
      "span": {
        "start": 2909,
        "end": 2917
      },
      "text": "ལ་གསལ་ཆ་ ༼སྣར། པེ།༽ ལ་བསལ་"
    },
    {
      "span": {
        "start": 2985,
        "end": 2992
      },
      "text": "མཐོང་ན་ ༼སྣར། པེ།༽ མཐོང་ནས་"
    }
  ]
}