{
  "durchens": [
    {
      "span": {
        "start": 32,
        "end": 34
      },
      "text": "ཧ་ ༼སྣར། པེ།༽ ཧཱ་"
    },
    {
      "span": {
        "start": 273,
        "end": 283
      },
      "text": "བསྒྲུབ་བོ་ ༼སྣར། པེ།༽ སྒྲུབ་བོ་"
    },
    {
      "span": {
        "start": 397,
        "end": 400
      },
      "text": "ཡི། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 652,
        "end": 658
      },
      "text": "བསྲུང་ ༼སྣར།༽ བསྲུངས་ ༼པེ།༽ སྲུངས་"
    },
    {
      "span": {
        "start": 1490,
        "end": 1501
      },
      "text": "འཐུངས་པ་ཡི། ༼སྣར། པེ།༽ འཐུངས་པ་ཡིས།"
    },
    {
      "span": {
        "start": 1553,
        "end": 1559
      },
      "text": "རྒྱུད་ ༼སྣར། པེ།༽ བརྒྱུད་"
    },
    {
      "span": {
        "start": 1739,
        "end": 1747
      },
      "text": "བསྐོར་བ་ ༼སྣར། པེ།༽ སྐོར་བ་"
    },
    {
      "span": {
        "start": 2509,
        "end": 2515
      },
      "text": "རང་གི་ ༼སྣར། པེ།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 2587,
        "end": 2590
      },
      "text": "བི་ ༼སྣར། པེ།༽ བའི་"
    },
    {
      "span": {
        "start": 2793,
        "end": 2805
      },
      "text": "ཞུས་པའོ།། །། ༼སྣར།༽ ཞུས་བཀྲིས་ ༼པེ།༽ ཞུས་པའོ།། །།མངྒ་ལཾ་"
    }
  ]
}