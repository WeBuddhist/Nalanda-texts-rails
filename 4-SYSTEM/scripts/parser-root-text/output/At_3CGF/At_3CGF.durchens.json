{
  "durchens": [
    {
      "span": {
        "start": 110,
        "end": 116
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབས་"
    },
    {
      "span": {
        "start": 128,
        "end": 138
      },
      "text": "གཤེགས་པའི་ ༼སྣར། པེ།༽ གཤེགས་པ་"
    },
    {
      "span": {
        "start": 758,
        "end": 767
      },
      "text": "དེ་ནས་ལས་ ༼སྣར། པེ།༽ དེ་ནས་ལམ་"
    },
    {
      "span": {
        "start": 1128,
        "end": 1134
      },
      "text": "སྦྱིན་ ༼སྣར། པེ།༽ བྱིན་"
    },
    {
      "span": {
        "start": 1296,
        "end": 1303
      },
      "text": "ནམ་མཁར་ ༼སྣར། པེ།༽ ནམ་མཁའ་"
    },
    {
      "span": {
        "start": 1360,
        "end": 1368
      },
      "text": "ལེགས་པར་ ༼སྣར། པེ།༽ ལེགས་པ་"
    },
    {
      "span": {
        "start": 1595,
        "end": 1603
      },
      "text": "སྨོན་ལམ་ ༼སྣར། པེ།༽ སྤྱོད་ལམ་"
    }
  ]
}