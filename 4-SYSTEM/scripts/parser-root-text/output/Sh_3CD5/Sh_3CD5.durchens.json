{
  "durchens": [
    {
      "span": {
        "start": 238,
        "end": 249
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱིས་"
    },
    {
      "span": {
        "start": 254,
        "end": 263
      },
      "text": "གྱི་རླབས་ ༼སྣར།༽ གྱིས་བརླབས་པ་ ༼པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 888,
        "end": 894
      },
      "text": "འབྱུང་ ༼སྣར།༽ བྱུང་"
    },
    {
      "span": {
        "start": 903,
        "end": 910
      },
      "text": "ཐམས་ཅད་ ༼སྣར། པེ།༽ ཐམས་ཅད་ལས་"
    },
    {
      "span": {
        "start": 1096,
        "end": 1105
      },
      "text": "གསུམ་གྱི་ ༼སྣར། པེ།༽ གསུམ་གྱིས་"
    },
    {
      "span": {
        "start": 1162,
        "end": 1171
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 1375,
        "end": 1381
      },
      "text": "བཙུགས་ ༼སྣར། པེ།༽ གཙུགས་"
    },
    {
      "span": {
        "start": 1440,
        "end": 1454
      },
      "text": "འཇིག་རྟེན་གྱི་ ༼སྣར། པེ།༽ འཇིག་རྟེན་གྱིས་"
    },
    {
      "span": {
        "start": 1545,
        "end": 1550
      },
      "text": "ཡོངས་ ༼སྣར། པེ།༽ ཡོངས་སུ་"
    },
    {
      "span": {
        "start": 1761,
        "end": 1765
      },
      "text": "ཐ་མ་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 1823,
        "end": 1836
      },
      "text": "སྣ་ཚོགས་ཀྱིས་ ༼སྣར། པེ།༽ སྣ་ཚོགས་ཀྱི་"
    },
    {
      "span": {
        "start": 1850,
        "end": 1863
      },
      "text": "སྣ་ཚོགས་ཀྱིས་ ༼སྣར། པེ།༽ སྣ་ཚོགས་ཀྱི་"
    },
    {
      "span": {
        "start": 2034,
        "end": 2043
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 2107,
        "end": 2112
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 2134,
        "end": 2143
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 2208,
        "end": 2214
      },
      "text": "བསྐྱབ་ ༼སྣར། པེ།༽ སྐྱོབས་"
    },
    {
      "span": {
        "start": 2245,
        "end": 2250
      },
      "text": "གཉེན་ ༼སྣར། པེ།༽ མཉེན་"
    },
    {
      "span": {
        "start": 2370,
        "end": 2378
      },
      "text": "བརླབ་པར་ ༼སྣར། པེ།༽ བརླབས་པར་"
    },
    {
      "span": {
        "start": 2484,
        "end": 2493
      },
      "text": "མྱ་ངན་ལས་ ༼སྣར། པེ།༽ མྱ་ངན་"
    },
    {
      "span": {
        "start": 2514,
        "end": 2528
      },
      "text": "འཇིག་རྟེན་གྱི་ ༼སྣར། པེ།༽ འཇིག་རྟེན་གྱིས་"
    },
    {
      "span": {
        "start": 2704,
        "end": 2709
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 2798,
        "end": 2804
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 2838,
        "end": 2844
      },
      "text": "བསྐྱབ་ ༼པེ།༽ བསྐྱོབ་"
    },
    {
      "span": {
        "start": 3290,
        "end": 3300
      },
      "text": "བྱིན་གྱིས་ ༼སྣར། པེ།༽ བྱིན་གྱི་"
    },
    {
      "span": {
        "start": 3403,
        "end": 3413
      },
      "text": "བསྐྱབ་པའི་ ༼སྣར། པེ།༽ སྐྱོབ་པའི་"
    },
    {
      "span": {
        "start": 3565,
        "end": 3573
      },
      "text": "བརླབ་པར་ ༼སྣར། པེ།༽ བརླབས་པར་"
    },
    {
      "span": {
        "start": 3664,
        "end": 3670
      },
      "text": "མདོངས་ ༼སྣར། པེ།༽ འཕགས་པ་གདོང་"
    },
    {
      "span": {
        "start": 3808,
        "end": 3813
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 3853,
        "end": 3865
      },
      "text": "རྣམ་ཐོས་ཀྱི་ ༼སྣར། པེ།༽ རྣམ་ཐོས་ཀྱིས་"
    },
    {
      "span": {
        "start": 4131,
        "end": 4139
      },
      "text": "གཤེགས་པ་ ༼སྣར། པེ།༽ གཤེགས་པ་གདན་འཛོམས་པ་ཆེན་པོའི་སྤྱན་སྔར་དེ་བཞིན་གཤེགས་པ་"
    },
    {
      "span": {
        "start": 5145,
        "end": 5153
      },
      "text": "དྲང་སྟེ། ༼སྣར། པེ།༽ དྲངས་ཏེ།"
    },
    {
      "span": {
        "start": 5585,
        "end": 5595
      },
      "text": "བདུན་གྱིས་ ༼སྣར། པེ།༽ བདུན་བགྱིས་"
    },
    {
      "span": {
        "start": 5757,
        "end": 5764
      },
      "text": "འཚལ་ལོ་ ༼སྣར།༽ འཚལ་"
    },
    {
      "span": {
        "start": 6049,
        "end": 6054
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 6426,
        "end": 6434
      },
      "text": "དབྱངས་ལ་ ༼སྣར། པེ།༽ དབྱངས་"
    },
    {
      "span": {
        "start": 7432,
        "end": 7439
      },
      "text": "འཚལ་ལོ་ ༼སྣར།༽ འཚལ་"
    },
    {
      "span": {
        "start": 7698,
        "end": 7705
      },
      "text": "ཚོགས་པ་ ༼སྣར། པེ།༽ ཚོགས་པ་དེ་"
    },
    {
      "span": {
        "start": 7986,
        "end": 7996
      },
      "text": "འཁོར་བ་ནས་ ༼སྣར། པེ།༽ འཁོར་བ་ན་"
    },
    {
      "span": {
        "start": 8356,
        "end": 8364
      },
      "text": "སྒྲོན་མ་ ༼སྣར། པེ།༽ སྒྲོན་མེ་"
    },
    {
      "span": {
        "start": 8412,
        "end": 8419
      },
      "text": "ཐམས་ཅད་ ༼སྣར། པེ།༽ ཐམས་ཅད་ལ་"
    },
    {
      "span": {
        "start": 8811,
        "end": 8816
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 8968,
        "end": 8973
      },
      "text": "སྨོན་ ༼སྣར། པེ།༽ སྔོན་"
    },
    {
      "span": {
        "start": 9272,
        "end": 9281
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 10538,
        "end": 10543
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ བདུན་"
    },
    {
      "span": {
        "start": 10726,
        "end": 10731
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ བདུན་"
    },
    {
      "span": {
        "start": 10792,
        "end": 10797
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 11259,
        "end": 11265
      },
      "text": "རོལ་པ་ ༼སྣར། པེ།༽ རོལ་པས་"
    },
    {
      "span": {
        "start": 12015,
        "end": 12026
      },
      "text": "ཆེན་པོ་དཔལ་ ༼སྣར། པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 12366,
        "end": 12369
      },
      "text": "དང་ ༼སྣར།༽ དང་དང་"
    },
    {
      "span": {
        "start": 13633,
        "end": 13637
      },
      "text": "འདས་ ༼སྣར། པེ།༽ འདས་དེ་བཞིན་གཤེགས་པ་"
    },
    {
      "span": {
        "start": 13684,
        "end": 13692
      },
      "text": "སྒྲིབ་པ་ ༼སྣར།༽ སྒྲིབས་པ་"
    },
    {
      "span": {
        "start": 14699,
        "end": 14704
      },
      "text": "དངོས་ ༼སྣར། པེ།༽ རྔོ་"
    },
    {
      "span": {
        "start": 14895,
        "end": 14901
      },
      "text": "སྩལ་པ་ ༼སྣར། པེ།༽ སྩལ་པ་ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 14925,
        "end": 14937
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 15058,
        "end": 15065
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 15554,
        "end": 15559
      },
      "text": "བཟངས་ ༼སྣར།༽ བཟང་"
    },
    {
      "span": {
        "start": 15662,
        "end": 15669
      },
      "text": "བསྒྲགས་ ༼སྣར།༽ སྒྲགས་"
    },
    {
      "span": {
        "start": 16064,
        "end": 16067
      },
      "text": "རང་ ༼སྣར། པེ།༽ རང་བ་"
    },
    {
      "span": {
        "start": 16178,
        "end": 16187
      },
      "text": "གྱི་རླབས་ ༼སྣར།༽ གྱིས་བརླབས་ ༼པེ།༽ གྱིས་བརླབ་"
    },
    {
      "span": {
        "start": 16286,
        "end": 16293
      },
      "text": "ཐམས་ཅད་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཞུ་"
    },
    {
      "span": {
        "start": 17021,
        "end": 17075
      },
      "text": "རིང་དུ་གནས་ཤིང་སྒོ་ཐམས་ཅད་ནས་དར་ཞིང་རྒྱས་པར་གྱུར་ཅིག ་ ༼སྣར། པེ།༽ རིང་དུ་"
    },
    {
      "span": {
        "start": 17254,
        "end": 17259
      },
      "text": "བགྱི། ༼སྣར།༽ བགྱི་བ།"
    },
    {
      "span": {
        "start": 17456,
        "end": 17461
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 17640,
        "end": 17647
      },
      "text": "རོལ་པས་ ༼སྣར། པེ།༽ རོལ་པ་"
    },
    {
      "span": {
        "start": 17807,
        "end": 17819
      },
      "text": "བརྗོད་པ་དང་། ༼སྣར། པེ།༽ བརྗོད་དེ་"
    },
    {
      "span": {
        "start": 18019,
        "end": 18026
      },
      "text": "མཆིས་པ་ ༼སྣར། པེ།༽ མཆི་བ་"
    },
    {
      "span": {
        "start": 18159,
        "end": 18165
      },
      "text": "ཕྱེ་བ་ ༼སྣར། པེ།༽ ཕྱེད་པ་"
    }
  ]
}