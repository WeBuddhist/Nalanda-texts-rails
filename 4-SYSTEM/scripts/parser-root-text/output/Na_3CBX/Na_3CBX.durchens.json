{
  "durchens": [
    {
      "span": {
        "start": 305,
        "end": 314
      },
      "text": "རྒྱས་པའི་ ༼སྣར། པེ།༽ རྒྱས་པ་"
    },
    {
      "span": {
        "start": 442,
        "end": 447
      },
      "text": "འཕེལ་ ༼སྣར། པེ།༽ སྤེལ་"
    },
    {
      "span": {
        "start": 569,
        "end": 591
      },
      "text": "དུ་མཆོག་སྦྱིན་རྒྱས་པར་ ༼སྣར།༽ དུ་མཆོག་ཅིང་རྒྱས་ ༼པེ།༽ དུ་མཆོག་ཅིང་རྒྱས་པར་"
    },
    {
      "span": {
        "start": 760,
        "end": 767
      },
      "text": "ལྟ་བུར་ ༼སྣར།༽ ལྟ་བུའི་"
    },
    {
      "span": {
        "start": 1082,
        "end": 1088
      },
      "text": "བལྟམས་ ༼སྣར།༽ བསྟམས་"
    },
    {
      "span": {
        "start": 1206,
        "end": 1216
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 1357,
        "end": 1371
      },
      "text": "དྲན་པར་བྱེད། ། ༼སྣར། པེ།༽ དྲན་པར་ཤོག །"
    },
    {
      "span": {
        "start": 1570,
        "end": 1578
      },
      "text": "མཛེས་པས་ ༼སྣར། པེ།༽ མཛེས་པར་"
    },
    {
      "span": {
        "start": 1657,
        "end": 1663
      },
      "text": "དཀའ་བ་ ༼སྣར། པེ།༽ དགའ་བ་"
    },
    {
      "span": {
        "start": 2565,
        "end": 2568
      },
      "text": "དང་ ༼སྣར།༽ གང་"
    },
    {
      "span": {
        "start": 2642,
        "end": 2648
      },
      "text": "འཇིགས་ ༼སྣར། པེ།༽ འཇིག་"
    },
    {
      "span": {
        "start": 2760,
        "end": 2764
      },
      "text": "དག ། ༼སྣར། པེ།༽ དང་། །"
    },
    {
      "span": {
        "start": 2933,
        "end": 2943
      },
      "text": "གིས་བརྒྱན་ ༼སྣར། པེ།༽ གི་རྒྱན་"
    },
    {
      "span": {
        "start": 3064,
        "end": 3069
      },
      "text": "ཉེ་བ་ ༼སྣར། པེ།༽ ཉེ་བར་"
    },
    {
      "span": {
        "start": 3113,
        "end": 3126
      },
      "text": "ཀུན་དགའ་བོ། ། ༼སྣར།༽ ཀུན་དགའོ།། །།"
    },
    {
      "span": {
        "start": 3264,
        "end": 3274
      },
      "text": "སེལ་སྤྲུལ་ ༼སྣར།༽ སྤེལ་སྤྲུལ་"
    },
    {
      "span": {
        "start": 3293,
        "end": 3299
      },
      "text": "འཇིགས་ ༼སྣར། པེ།༽ འཇིག་"
    },
    {
      "span": {
        "start": 3323,
        "end": 3328
      },
      "text": "སྤེལ་ ༼སྣར།༽ སེལ་"
    },
    {
      "span": {
        "start": 3428,
        "end": 3430
      },
      "text": "པ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 3707,
        "end": 3715
      },
      "text": "སྒྲོལ་བ་ ༼སྣར།༽ སྒྲོན་པ་ ༼པེ།༽ སྒྲོན་མ་"
    },
    {
      "span": {
        "start": 3762,
        "end": 3771
      },
      "text": "གཏོང་བའི་ ༼སྣར། པེ།༽ སྟོང་པའི་"
    },
    {
      "span": {
        "start": 3926,
        "end": 3933
      },
      "text": "བྱིན་བ་ ༼སྣར།༽ ཕྱིན་བ་"
    },
    {
      "span": {
        "start": 3990,
        "end": 3993
      },
      "text": "ནི། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 4066,
        "end": 4071
      },
      "text": "འཕུར་ ༼སྣར། པེ།༽ ཕུར་"
    },
    {
      "span": {
        "start": 4323,
        "end": 4331
      },
      "text": "ལྡན་པའི་ ༼སྣར། པེ།༽ ལྡན་པ་"
    },
    {
      "span": {
        "start": 4414,
        "end": 4420
      },
      "text": "བུང་བ་ ༼སྣར། པེ།༽ བུང་"
    },
    {
      "span": {
        "start": 4493,
        "end": 4496
      },
      "text": "ཡི་ ༼སྣར། པེ།༽ ཡིད་"
    },
    {
      "span": {
        "start": 4514,
        "end": 4519
      },
      "text": "རྣམས། ༼སྣར། པེ།༽ བསྣམས།"
    },
    {
      "span": {
        "start": 4575,
        "end": 4588
      },
      "text": "མཛད་པ་ཟླ་འོད་ ༼སྣར།༽ མཛད་པ་"
    },
    {
      "span": {
        "start": 4758,
        "end": 4771
      },
      "text": "བསྣམས་རལ་གྲི་ ༼སྣར། པེ།༽ བསྣམས་"
    },
    {
      "span": {
        "start": 4787,
        "end": 4794
      },
      "text": "བསྐྱོད་ ༼སྣར།༽ བསྐྱོ་"
    },
    {
      "span": {
        "start": 4798,
        "end": 4802
      },
      "text": "རྗེ་ ༼པེ།༽ རྗེའི་རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 4821,
        "end": 4829
      },
      "text": "སྐྱོབ་པ་ ༼སྣར། པེ།༽ བསྐྱོབ་པ་"
    },
    {
      "span": {
        "start": 5118,
        "end": 5125
      },
      "text": "སྡུད་པ་ ༼སྣར། པེ།༽ བདུད་པ་"
    },
    {
      "span": {
        "start": 5223,
        "end": 5230
      },
      "text": "མི་ཡིས་ ༼སྣར། པེ།༽ མི་ཡིད་"
    },
    {
      "span": {
        "start": 5288,
        "end": 5291
      },
      "text": "ནི་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 5306,
        "end": 5315
      },
      "text": "གུས་བཞིན་ ༼སྣར། པེ།༽ གུས་ཤིང་"
    },
    {
      "span": {
        "start": 5425,
        "end": 5431
      },
      "text": "འཇོམས་ ༼སྣར།༽ འཇོམ་"
    },
    {
      "span": {
        "start": 5519,
        "end": 5525
      },
      "text": "རྫོགས། ༼སྣར། པེ།༽ རྫོགས་སྷོ།"
    },
    {
      "span": {
        "start": 5599,
        "end": 5606
      },
      "text": "བསྒྱུར་ ༼སྣར། པེ།༽ སྒྱུར་"
    },
    {
      "span": {
        "start": 5623,
        "end": 5630
      },
      "text": "ཕབ་བའོ། ༼སྣར། པེ།༽ ཕབ་པ།"
    }
  ]
}