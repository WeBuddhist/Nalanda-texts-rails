{
  "durchens": [
    {
      "span": {
        "start": 111,
        "end": 113
      },
      "text": "ལ་ ༼པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 132,
        "end": 140
      },
      "text": "སྙིང་གར་ ༼སྣར།༽ སྙིང་ཁར་ ༼པེ།༽ ཀར་"
    },
    {
      "span": {
        "start": 250,
        "end": 260
      },
      "text": "བྱུང་བ་ཡི། ༼པེ།༽ བྱུང་བ་ཡིས།"
    },
    {
      "span": {
        "start": 332,
        "end": 338
      },
      "text": "བསྒོམ་ ༼པེ།༽ སྒོམ་"
    },
    {
      "span": {
        "start": 386,
        "end": 389
      },
      "text": "པད་ ༼སྣར། པེ།༽ པདྨ་"
    },
    {
      "span": {
        "start": 393,
        "end": 401
      },
      "text": "བརྒྱད་པ་ ༼སྣར། པེ།༽ བརྒྱད་"
    },
    {
      "span": {
        "start": 550,
        "end": 557
      },
      "text": "གཡས་མི་ ༼པེ།༽ གཡས་མ་"
    },
    {
      "span": {
        "start": 609,
        "end": 612
      },
      "text": "བར་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 811,
        "end": 814
      },
      "text": "ནི་ ༼པེ།༽ ནཱི་"
    },
    {
      "span": {
        "start": 871,
        "end": 878
      },
      "text": "སྙིང་ག་ ༼སྣར།༽ སྙིང་ཁ་"
    },
    {
      "span": {
        "start": 895,
        "end": 900
      },
      "text": "རིམས་ ༼སྣར།༽ རིམ་"
    },
    {
      "span": {
        "start": 921,
        "end": 929
      },
      "text": "སྙིང་གར་ ༼སྣར།༽ སྙིང་ཁར་"
    },
    {
      "span": {
        "start": 1008,
        "end": 1011
      },
      "text": "གུ་ ༼སྣར།༽ ཁུ་"
    },
    {
      "span": {
        "start": 1169,
        "end": 1177
      },
      "text": "སྙིང་གར་ ༼སྣར།༽ སྙིང་ཁར་"
    },
    {
      "span": {
        "start": 1201,
        "end": 1209
      },
      "text": "སྔོན་ནོ། ༼སྣར།༽ སྔོན་ནི།"
    },
    {
      "span": {
        "start": 1668,
        "end": 1671
      },
      "text": "ལྷ་ ༼པེ།༽ ལྷས་"
    },
    {
      "span": {
        "start": 1845,
        "end": 1859
      },
      "text": "བསྒྲུབ་བྱ་སྟེ། ༼སྣར།༽ བསྒྲུབ་ཡིས།"
    },
    {
      "span": {
        "start": 2093,
        "end": 2098
      },
      "text": "ཞན་པ་ ༼སྣར།༽ གཞན་པ་"
    },
    {
      "span": {
        "start": 2168,
        "end": 2178
      },
      "text": "བསྟན་པ་དེ། ༼སྣར།༽ བསྟན་པ་སྟེ།"
    },
    {
      "span": {
        "start": 2188,
        "end": 2191
      },
      "text": "སྔ་ ༼སྣར།༽ ལྔ་"
    },
    {
      "span": {
        "start": 2220,
        "end": 2225
      },
      "text": "སྐོར་ ༼པེ།༽ བསྐོར་"
    }
  ]
}