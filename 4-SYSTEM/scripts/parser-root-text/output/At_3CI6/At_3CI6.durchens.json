{
  "durchens": [
    {
      "span": {
        "start": 161,
        "end": 180
      },
      "text": "སྔོན་པོ་ལ་སོགས་པ་ས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 192,
        "end": 197
      },
      "text": "མངོན་ ༼སྣར། པེ།༽ སྔོན་"
    },
    {
      "span": {
        "start": 668,
        "end": 677
      },
      "text": "སོགས་པའི་ ༼སྣར།༽ སོག་པའི་"
    },
    {
      "span": {
        "start": 1413,
        "end": 1419
      },
      "text": "འདྲ་བ་ ༼སྣར། པེ།༽ འདྲ་བར་"
    },
    {
      "span": {
        "start": 1631,
        "end": 1638
      },
      "text": "བསྐྱེད་ ༼སྣར།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 1667,
        "end": 1685
      },
      "text": "ཞེས་བརྗོད་པས་བ་སུ་ ༼སྣར། པེ།༽ བརྗོད་པས་བ་"
    },
    {
      "span": {
        "start": 2075,
        "end": 2083
      },
      "text": "ཁྲི་ཕྲག་ ༼སྣར། པེ།༽ ཁྲི་ཕྲག་རེ་རེ་"
    },
    {
      "span": {
        "start": 2140,
        "end": 2149
      },
      "text": "སྨྱུང་བར་ ༼སྣར། པེ།༽ བསྙུང་བར་"
    },
    {
      "span": {
        "start": 2257,
        "end": 2263
      },
      "text": "དབོག ། ༼སྣར། པེ།༽ འབོག །"
    }
  ]
}