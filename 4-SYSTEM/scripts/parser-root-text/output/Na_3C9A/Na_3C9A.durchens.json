{
  "durchens": [
    {
      "span": {
        "start": 79,
        "end": 88
      },
      "text": "ཕྱིན་མའི་ ༼སྣར། པེ།༽ ཕྱིན་པའི་"
    },
    {
      "span": {
        "start": 131,
        "end": 138
      },
      "text": "ཕྱིན་མ་ ༼སྣར། པེ།༽ ཕྱིན་པ་"
    },
    {
      "span": {
        "start": 672,
        "end": 676
      },
      "text": "དང་། ༼སྣར། པེ།༽ གང་།"
    },
    {
      "span": {
        "start": 1503,
        "end": 1512
      },
      "text": "ཡུམ་གཅིག་ ༼སྣར། པེ།༽ ཡུམ་ཅིག་"
    },
    {
      "span": {
        "start": 2275,
        "end": 2282
      },
      "text": "ཐོགས། ། ༼སྣར། པེ།༽ ཐོག །"
    },
    {
      "span": {
        "start": 2505,
        "end": 2513
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    }
  ]
}