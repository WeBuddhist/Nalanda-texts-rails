{
  "durchens": [
    {
      "span": {
        "start": 384,
        "end": 390
      },
      "text": "སྐལ་བ་ ༼སྣར།༽ བསྐལ་པ་"
    },
    {
      "span": {
        "start": 580,
        "end": 586
      },
      "text": "སྐལ་བ་ ༼སྣར།༽ བསྐལ་པ་"
    },
    {
      "span": {
        "start": 653,
        "end": 656
      },
      "text": "པར་ ༼སྣར། པེ།༽ སར་"
    },
    {
      "span": {
        "start": 747,
        "end": 751
      },
      "text": "ཉམས་ ༼སྣར།༽ ཉམ་པ་"
    },
    {
      "span": {
        "start": 956,
        "end": 968
      },
      "text": "མདོངས་འབྲོག་ ༼སྣར། པེ།༽ མདངས་ཕྲོགས་"
    },
    {
      "span": {
        "start": 1323,
        "end": 1333
      },
      "text": "སྨྱུག་མའི་ ༼སྣར། པེ།༽ སྨྱུག་མ་"
    },
    {
      "span": {
        "start": 1373,
        "end": 1380
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 1704,
        "end": 1712
      },
      "text": "གསོད་སར་ ༼ཅོ།༽ གསོད་པ་ ༼སྡེ།༽ གསོད་པར་"
    },
    {
      "span": {
        "start": 1935,
        "end": 1942
      },
      "text": "ཁྲོ་བོ་ ༼སྣར། པེ།༽ ཁྲོ་བ་"
    },
    {
      "span": {
        "start": 2127,
        "end": 2133
      },
      "text": "རྐུ་བ་ ༼སྣར། པེ།༽ བརྐུ་བ་"
    },
    {
      "span": {
        "start": 2215,
        "end": 2219
      },
      "text": "དྲི་ ༼སྣར། པེ།༽ འདྲི་"
    },
    {
      "span": {
        "start": 2221,
        "end": 2228
      },
      "text": "བཙོན་པ་ ༼སྣར། པེ།༽ བརྩོན་པ་"
    }
  ]
}