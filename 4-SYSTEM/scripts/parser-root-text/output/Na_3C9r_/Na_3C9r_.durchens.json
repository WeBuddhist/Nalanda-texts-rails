{
  "durchens": [
    {
      "span": {
        "start": 690,
        "end": 696
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 754,
        "end": 761
      },
      "text": "ཕྱེ་བས་ ༼སྣར། པེ།༽ ཕྱེ་བའི་"
    },
    {
      "span": {
        "start": 808,
        "end": 811
      },
      "text": "ཡི་ ༼སྣར། པེ།༽ ཡེ་"
    },
    {
      "span": {
        "start": 982,
        "end": 990
      },
      "text": "བརྟན་པར་ ༼སྡེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 1277,
        "end": 1286
      },
      "text": "འདས་ཀྱིས་ ༼སྣར། པེ།༽ འདས་ཀྱི་"
    },
    {
      "span": {
        "start": 1390,
        "end": 1399
      },
      "text": "བྱེད་པ་ལ་ ༼སྣར།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 1770,
        "end": 1775
      },
      "text": "མཐུན་ ༼སྣར། པེ།༽ མཐུན་པའི་"
    },
    {
      "span": {
        "start": 1926,
        "end": 1930
      },
      "text": "གཞན་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 2016,
        "end": 2020
      },
      "text": "གཞན་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 2082,
        "end": 2085
      },
      "text": "རང་ ༼སྣར། པེ།༽ རང་གི་"
    },
    {
      "span": {
        "start": 2437,
        "end": 2443
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 2930,
        "end": 2941
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱིས་"
    },
    {
      "span": {
        "start": 3180,
        "end": 3186
      },
      "text": "བསྲུབ་ ༼པེ།༽ སྲུབ་"
    },
    {
      "span": {
        "start": 3230,
        "end": 3234
      },
      "text": "བྱང་ ༼སྣར། པེ།༽ བྱང་ཆུབ་ཀྱི་"
    },
    {
      "span": {
        "start": 3309,
        "end": 3314
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 3667,
        "end": 3675
      },
      "text": "ཆོས་ཀྱི་ ༼སྣར།༽ ཆོས་ཀྱིས་"
    },
    {
      "span": {
        "start": 3826,
        "end": 3837
      },
      "text": "རྒྱུན་གྱིས་ ༼སྣར། པེ།༽ རྒྱུན་གྱི་"
    },
    {
      "span": {
        "start": 3861,
        "end": 3873
      },
      "text": "རང་བཞིན་གྱི་ ༼པེ།༽ རང་བཞིན་གྱིས་"
    },
    {
      "span": {
        "start": 3883,
        "end": 3897
      },
      "text": "ལྷན་ཅིག་སྐྱེས་ ༼སྣར། པེ།༽ ལྷན་ཅིག་"
    },
    {
      "span": {
        "start": 4063,
        "end": 4072
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 4116,
        "end": 4120
      },
      "text": "རྩྭ་ ༼སྣར། པེ།༽ རྩ་"
    },
    {
      "span": {
        "start": 4308,
        "end": 4314
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 4389,
        "end": 4398
      },
      "text": "ཐབས་ཀྱིས་ ༼སྣར། པེ།༽ ཐབས་ཀྱི་"
    },
    {
      "span": {
        "start": 4779,
        "end": 4786
      },
      "text": "རྣམ་པར་ ༼པེ།༽ རྣམ་པར་རྣམ་པར་"
    },
    {
      "span": {
        "start": 4903,
        "end": 4907
      },
      "text": "འཕང་ ༼པེ།༽ འཕངས་"
    },
    {
      "span": {
        "start": 5006,
        "end": 5013
      },
      "text": "ཆེན་པོ་ ༼སྣར། པེ།༽ ཆེན་པོའི་"
    },
    {
      "span": {
        "start": 5218,
        "end": 5225
      },
      "text": "ཤེས་བྱ་ ༼སྣར། པེ།༽ ཤེས་བྱ་བ་"
    },
    {
      "span": {
        "start": 5545,
        "end": 5554
      },
      "text": "རྟོགས་པས་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 6751,
        "end": 6756
      },
      "text": "འདིས་ ༼སྣར། པེ།༽ འདིར་"
    },
    {
      "span": {
        "start": 6815,
        "end": 6825
      },
      "text": "དེ་སྐད་དུ། ༼སྣར། པེ།༽ དེ་སྐད་ཡང་།"
    },
    {
      "span": {
        "start": 6852,
        "end": 6859
      },
      "text": "མེད་དེ་ ༼སྣར། པེ།༽ མེད་ཅིང་"
    },
    {
      "span": {
        "start": 7082,
        "end": 7092
      },
      "text": "གསུངས་པའོ། ༼སྣར། པེ།༽ གསུངས་སོ།"
    },
    {
      "span": {
        "start": 7121,
        "end": 7129
      },
      "text": "གཅིག་གི་ ༼པེ།༽ གཅིག་གིས་"
    },
    {
      "span": {
        "start": 7260,
        "end": 7271
      },
      "text": "དབང་གིས་ནི། ༼སྣར། པེ།༽ དབང་གིས།"
    },
    {
      "span": {
        "start": 7317,
        "end": 7328
      },
      "text": "བརྗོད་དོ། ། ༼སྣར། པེ།༽ བརྗོད།། །།"
    },
    {
      "span": {
        "start": 7364,
        "end": 7372
      },
      "text": "འབྲས་བུ་ ༼སྣར། པེ།༽ འབྲས་བུར་"
    },
    {
      "span": {
        "start": 7394,
        "end": 7400
      },
      "text": "པའོ། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 7575,
        "end": 7581
      },
      "text": "པའོ། ། ༼སྣར།༽ ། །བཀྲ་ཤིས་པར་གྱུར་ཅིག་"
    }
  ]
}