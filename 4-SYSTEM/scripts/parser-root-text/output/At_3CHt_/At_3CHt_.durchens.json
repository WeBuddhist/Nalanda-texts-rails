{
  "durchens": [
    {
      "span": {
        "start": 464,
        "end": 470
      },
      "text": "བྱུགས་ ༼པེ།༽ བྱུག་"
    },
    {
      "span": {
        "start": 626,
        "end": 633
      },
      "text": "ཕྱི་ནང་ ༼སྣར། པེ།༽ ཕྱི་ནས་"
    },
    {
      "span": {
        "start": 957,
        "end": 966
      },
      "text": "། །ཐོད་པ་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 983,
        "end": 990
      },
      "text": "འཛིན། ། ༼སྣར། པེ།༽ འཛིན་པའི་ཕྱག །"
    },
    {
      "span": {
        "start": 1043,
        "end": 1046
      },
      "text": "ལྔ། ༼སྣར། པེ།༽ ལྔས།"
    },
    {
      "span": {
        "start": 1052,
        "end": 1057
      },
      "text": "རྒྱན་ ༼སྣར། པེ།༽ བརྒྱན་"
    },
    {
      "span": {
        "start": 1773,
        "end": 1782
      },
      "text": "ངལ་བ་གསོ་ ༼སྣར། པེ།༽ ངལ་བ་སོ་"
    },
    {
      "span": {
        "start": 1877,
        "end": 1885
      },
      "text": "གོ་རིམས་ ༼སྣར། པེ།༽ གོ་རིམ་"
    },
    {
      "span": {
        "start": 1981,
        "end": 1986
      },
      "text": "འཆིང་ ༼སྣར། པེ།༽ ཆིངས་"
    }
  ]
}