{
  "durchens": [
    {
      "span": {
        "start": 21,
        "end": 28
      },
      "text": "ནིར་བི་ ༼པེ།༽ ནིརྦ་"
    },
    {
      "span": {
        "start": 857,
        "end": 862
      },
      "text": "སྤངས། ༼སྣར། པེ།༽ སྤང་།"
    },
    {
      "span": {
        "start": 1106,
        "end": 1114
      },
      "text": "བརྟན་པར་ ༼སྣར། པེ།༽ བདེན་པར་"
    },
    {
      "span": {
        "start": 1202,
        "end": 1207
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ བུ་"
    },
    {
      "span": {
        "start": 1251,
        "end": 1256
      },
      "text": "གཟོད་ ༼སྣར། པེ།༽ བཟོད་"
    },
    {
      "span": {
        "start": 1533,
        "end": 1547
      },
      "text": "འདུ་བྱེད་ཀྱིས། ༼སྣར། པེ།༽ འདུ་བྱེད་ཀྱི།"
    },
    {
      "span": {
        "start": 1656,
        "end": 1664
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་པོ་"
    }
  ]
}