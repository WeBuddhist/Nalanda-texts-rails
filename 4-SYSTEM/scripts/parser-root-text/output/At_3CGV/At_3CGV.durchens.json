{
  "durchens": [
    {
      "span": {
        "start": 421,
        "end": 427
      },
      "text": "བཞུགས། ༼པེ།༽ བཞུགས་པ།"
    },
    {
      "span": {
        "start": 822,
        "end": 826
      },
      "text": "འཕང་ ༼པེ།༽ འཕངས་"
    },
    {
      "span": {
        "start": 947,
        "end": 954
      },
      "text": "བསྐྱེད་ ༼པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 2774,
        "end": 2810
      },
      "text": "བཞི་བྱམས་པ་སྙིང་རྗེ་དགའ་བ་བཏང་སྙོམས་ ༼པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 6928,
        "end": 6932
      },
      "text": "སྦུ་ ༼པེ།༽ སྦུམ་"
    },
    {
      "span": {
        "start": 6994,
        "end": 7001
      },
      "text": "འཇུག་མ་ ༼པེ།༽ མཇུག་མ་"
    },
    {
      "span": {
        "start": 7154,
        "end": 7163
      },
      "text": "བསྐོར་བར་ ༼པེ།༽ བསྐོར་བ་"
    },
    {
      "span": {
        "start": 7980,
        "end": 7983
      },
      "text": "པས། ༼པེ།༽ བསམ།"
    },
    {
      "span": {
        "start": 9452,
        "end": 9476
      },
      "text": "གྲུ་གསུམ་སོར་ཉེར་གཅིག་པ་ ༼པེ།༽ གྲུ་གསུམ་"
    },
    {
      "span": {
        "start": 10224,
        "end": 10234
      },
      "text": "རྣམས་མེའི་ ༼པེ།༽ རྣམས་མའི་"
    },
    {
      "span": {
        "start": 10827,
        "end": 10835
      },
      "text": "འོད་ཀྱི་ ༼པེ།༽ འོད་"
    },
    {
      "span": {
        "start": 11156,
        "end": 11164
      },
      "text": "རྡོ་རྗེ་ ༼པེ།༽ རྡོ་རྗེར་"
    },
    {
      "span": {
        "start": 11188,
        "end": 11195
      },
      "text": "བརྟན་པ་ ༼པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 11622,
        "end": 11627
      },
      "text": "བསམས་ ༼པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 12296,
        "end": 12305
      },
      "text": "མཚམས་ཐམས་ ༼པེ།༽ མཚམས་"
    },
    {
      "span": {
        "start": 12679,
        "end": 12684
      },
      "text": "གདགས་ ༼པེ།༽ གགས་"
    },
    {
      "span": {
        "start": 12696,
        "end": 12702
      },
      "text": "བྱས་ལ་ ༼པེ།༽ བྱས་པ་"
    }
  ]
}