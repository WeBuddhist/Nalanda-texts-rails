{
  "durchens": [
    {
      "span": {
        "start": 84,
        "end": 91
      },
      "text": "གནས་པར་ ༼སྣར། པེ།༽ གནས་པ་"
    },
    {
      "span": {
        "start": 467,
        "end": 474
      },
      "text": "བཏོད་པ་ ༼སྣར། པེ།༽ བསྟོད་པ་"
    },
    {
      "span": {
        "start": 762,
        "end": 765
      },
      "text": "པར་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 963,
        "end": 970
      },
      "text": "དབྱེ་བ་ ༼སྣར། པེ།༽ སྤྲུ་བ་"
    },
    {
      "span": {
        "start": 1031,
        "end": 1036
      },
      "text": "རྒྱན་ ༼སྣར། པེ།༽ བརྒྱན་"
    },
    {
      "span": {
        "start": 1042,
        "end": 1047
      },
      "text": "གདགས། ༼སྣར། པེ།༽ གདབ།"
    },
    {
      "span": {
        "start": 1119,
        "end": 1124
      },
      "text": "གཞུག་ ༼སྣར། པེ།༽ བཞུག་"
    },
    {
      "span": {
        "start": 1318,
        "end": 1325
      },
      "text": "གཞུག་པ་ ༼སྣར། པེ།༽ བཞུགས་པ་"
    },
    {
      "span": {
        "start": 1370,
        "end": 1376
      },
      "text": "བཞར་བ་ ༼སྣར། པེ།༽ གཞར་བ་"
    },
    {
      "span": {
        "start": 1652,
        "end": 1657
      },
      "text": "རྒྱན་ ༼སྣར།༽ བརྒྱན་"
    },
    {
      "span": {
        "start": 1750,
        "end": 1754
      },
      "text": "འོད་ ༼སྣར། པེ།༽ འོད་ཉིད་"
    },
    {
      "span": {
        "start": 1810,
        "end": 1815
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 1875,
        "end": 1884
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 1921,
        "end": 1924
      },
      "text": "ལས་ ༼སྣར།༽ ། །ལས་ ༼པེ།༽ ། ཧྲི་ལས་"
    },
    {
      "span": {
        "start": 2036,
        "end": 2044
      },
      "text": "བརྟན་པར་ ༼སྣར། པེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 2601,
        "end": 2603
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ཆེ་"
    },
    {
      "span": {
        "start": 2684,
        "end": 2693
      },
      "text": "གཅིག་གིས་ ༼སྣར། པེ།༽ གཅིག་གི་"
    },
    {
      "span": {
        "start": 2713,
        "end": 2718
      },
      "text": "ཀླག ། ༼སྣར། པེ།༽ བཀླག །"
    },
    {
      "span": {
        "start": 3070,
        "end": 3079
      },
      "text": "སྨྱུང་བར་ ༼སྣར། པེ།༽ བསྙུང་བར་"
    },
    {
      "span": {
        "start": 3352,
        "end": 3364
      },
      "text": "ཡོན་བདག་གིས་ ༼སྣར། པེ།༽ ཡོན་བདག་གི་"
    },
    {
      "span": {
        "start": 3432,
        "end": 3436
      },
      "text": "ཅིག་ ༼སྣར། པེ།༽ གཅིག་"
    },
    {
      "span": {
        "start": 3491,
        "end": 3496
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 3592,
        "end": 3604
      },
      "text": "ཕྱོགས་སྐྱོང་ ༼སྣར། པེ།༽ ཕྱོགས་"
    },
    {
      "span": {
        "start": 3770,
        "end": 3775
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 3907,
        "end": 3913
      },
      "text": "དམན་མ་ ༼སྣར། པེ།༽ སྨན་པ་"
    },
    {
      "span": {
        "start": 4105,
        "end": 4112
      },
      "text": "གཏང་བར་ ༼སྣར། པེ།༽ བཏང་བར་"
    }
  ]
}