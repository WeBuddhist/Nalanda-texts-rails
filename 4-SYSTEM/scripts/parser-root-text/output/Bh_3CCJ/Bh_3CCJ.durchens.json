{
  "durchens": [
    {
      "span": {
        "start": 188,
        "end": 197
      },
      "text": "སྟོངས་པར། ༼སྣར། པེ།༽ སྟོང་བར།"
    },
    {
      "span": {
        "start": 255,
        "end": 261
      },
      "text": "བཞུགས་ ༼སྣར། པེ།༽ ཞུགས་"
    },
    {
      "span": {
        "start": 630,
        "end": 637
      },
      "text": "རིགས་པ་ ༼སྣར།༽ རིགས་"
    },
    {
      "span": {
        "start": 646,
        "end": 653
      },
      "text": "དོན་དམ་ ༼སྣར།༽ དོན་"
    },
    {
      "span": {
        "start": 1156,
        "end": 1165
      },
      "text": "ལོག་པ་ཡི་ ༼སྣར། པེ།༽ ལོག་པ་ཡིས་"
    },
    {
      "span": {
        "start": 1403,
        "end": 1408
      },
      "text": "འཐོབ། ༼སྣར། པེ།༽ ཐོབ།"
    },
    {
      "span": {
        "start": 1488,
        "end": 1492
      },
      "text": "དགེ་བ་བདག་གིས་བསགས་པ་ཡི། ། ༼སྣར། པེ།༽ དགེ་"
    },
    {
      "span": {
        "start": 1535,
        "end": 1545
      },
      "text": "གྱུར་ཅིག ་ ༼སྣར། པེ།༽ གྱུར་ཅིག།། །།"
    },
    {
      "span": {
        "start": 1549,
        "end": 1551
      },
      "text": "མ་ ༼སྣར། པེ།༽ མའི་"
    },
    {
      "span": {
        "start": 1582,
        "end": 1587
      },
      "text": "བྱེད་ ༼སྣར། པེ།༽ འབྱེད་"
    }
  ]
}