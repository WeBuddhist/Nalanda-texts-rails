{
  "durchens": [
    {
      "span": {
        "start": 1675,
        "end": 1682
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ དེ་ལྟས་"
    },
    {
      "span": {
        "start": 1724,
        "end": 1733
      },
      "text": "མོད་ཀྱིས། ༼སྣར། པེ།༽ མོད་ཀྱི།"
    },
    {
      "span": {
        "start": 2372,
        "end": 2379
      },
      "text": "བདེ་ནས་ ༼སྣར། པེ།༽ བདེ་གནས་"
    },
    {
      "span": {
        "start": 2632,
        "end": 2640
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 2783,
        "end": 2789
      },
      "text": "འདྲིས་ ༼སྣར། པེ།༽ དྲིན་"
    },
    {
      "span": {
        "start": 3015,
        "end": 3024
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 3935,
        "end": 3942
      },
      "text": "གཟིར་བ་ ༼པེ།༽ གཟེར་བ་"
    },
    {
      "span": {
        "start": 3965,
        "end": 3974
      },
      "text": "ཐུགས་ཀྱི་ ༼སྣར། པེ།༽ ཐུགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 4040,
        "end": 4048
      },
      "text": "གཟིར་བར་ ༼པེ།༽ གཟེར་བར་"
    },
    {
      "span": {
        "start": 4244,
        "end": 4250
      },
      "text": "སོས་པ་ ༼སྣར། པེ།༽ བསོས་པ་"
    },
    {
      "span": {
        "start": 5789,
        "end": 5791
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 5794,
        "end": 5807
      },
      "text": "ལེགས་བཤད་ཉིད། ༼སྣར། པེ།༽ ལེགས་བཤད་པ།"
    },
    {
      "span": {
        "start": 6107,
        "end": 6113
      },
      "text": "མཇལ་བ་ ༼སྣར།༽ འཇལ་བ་"
    },
    {
      "span": {
        "start": 6365,
        "end": 6372
      },
      "text": "འགྲོགས་ ༼སྣར། པེ།༽ གྲགས་"
    },
    {
      "span": {
        "start": 6612,
        "end": 6619
      },
      "text": "ཁྱད་པར་ ༼སྣར། པེ།༽ ཁྱབ་པར་"
    },
    {
      "span": {
        "start": 6749,
        "end": 6756
      },
      "text": "བཀའ་བས་ ༼སྣར། པེ།༽ དཀའ་བས་"
    },
    {
      "span": {
        "start": 6947,
        "end": 6955
      },
      "text": "ཁྱོད་ནི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 7034,
        "end": 7043
      },
      "text": "སྙིང་རྗེ་ ༼སྣར། པེ།༽ སྙིང་རྗེས་"
    },
    {
      "span": {
        "start": 7142,
        "end": 7152
      },
      "text": "མཆེད་གྱུར་ ༼སྣར།༽ མཆོད་ ༼པེ།༽ མཆོག་གྱུར་"
    },
    {
      "span": {
        "start": 7168,
        "end": 7177
      },
      "text": "ཀྱི་ལོངས་ ༼སྣར། པེ།༽ ཀྱིས་ལེགས་"
    },
    {
      "span": {
        "start": 7337,
        "end": 7341
      },
      "text": "ཉམས་ ༼སྣར། པེ།༽ ཉམ་"
    },
    {
      "span": {
        "start": 7895,
        "end": 7902
      },
      "text": "བསྒྲུབ། ༼སྣར།༽ བསྒྲུབས ༼པེ།༽ བསྒུབས།"
    },
    {
      "span": {
        "start": 8022,
        "end": 8026
      },
      "text": "ཡིས་ ༼སྣར། པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 8255,
        "end": 8261
      },
      "text": "བགྱིད་ ༼སྣར།༽ བགྱིས་"
    },
    {
      "span": {
        "start": 8465,
        "end": 8475
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 8673,
        "end": 8680
      },
      "text": "མཇལ་བར་ ༼སྣར། པེ།༽ འཇལ་བར་"
    },
    {
      "span": {
        "start": 8695,
        "end": 8703
      },
      "text": "ཀུན་གྱི་ ༼སྣར། པེ།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 8717,
        "end": 8727
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 8739,
        "end": 8743
      },
      "text": "བསམ་ ༼སྣར། པེ།༽ བསམས་"
    },
    {
      "span": {
        "start": 9474,
        "end": 9479
      },
      "text": "འཁོར། ༼སྣར། པེ།༽ ཁོར།"
    },
    {
      "span": {
        "start": 9706,
        "end": 9711
      },
      "text": "ལྡོན་ ༼སྣར། པེ།༽ ལྡོམ་"
    },
    {
      "span": {
        "start": 9872,
        "end": 9881
      },
      "text": "བརྗོད་པར་ ༼སྣར།༽ རྗོད་པར་"
    },
    {
      "span": {
        "start": 9881,
        "end": 9889
      },
      "text": "བགྱིས་པ་ ༼སྣར། པེ།༽ བགྱིད་པ་"
    },
    {
      "span": {
        "start": 10238,
        "end": 10245
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 10395,
        "end": 10399
      },
      "text": "བྲན་ ༼སྣར། པེ།༽ ནན་"
    },
    {
      "span": {
        "start": 10805,
        "end": 10813
      },
      "text": "སྐྱེ་བོ་ ༼པེ།༽ སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 11253,
        "end": 11259
      },
      "text": "དགའ་བ་ ༼སྣར། པེ།༽ དཀའ་བ་"
    },
    {
      "span": {
        "start": 11606,
        "end": 11614
      },
      "text": "འགྱུར་ན། ༼སྣར། པེ།༽ འགྱུར་བ།"
    },
    {
      "span": {
        "start": 12052,
        "end": 12057
      },
      "text": "ཁྱོད་ ༼སྣར།༽ ཁྱེད་"
    },
    {
      "span": {
        "start": 12176,
        "end": 12183
      },
      "text": "ལུས་པས། ༼སྣར།༽ བའི ༼པེ།༽ ལུས་པའི།"
    },
    {
      "span": {
        "start": 13196,
        "end": 13202
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 13393,
        "end": 13399
      },
      "text": "གཞན་ལ་ ༼སྣར། པེ།༽ གཞན་པ་"
    },
    {
      "span": {
        "start": 13619,
        "end": 13627
      },
      "text": "བརྟེན་པ་ ༼སྣར། པེ།༽ རྟེན་པ་"
    },
    {
      "span": {
        "start": 14123,
        "end": 14132
      },
      "text": "ཡུན་རིངས་ ༼སྣར། པེ།༽ ཡུན་རིང་"
    },
    {
      "span": {
        "start": 14695,
        "end": 14697
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 14802,
        "end": 14805
      },
      "text": "ཞི་ ༼སྣར། པེ།༽ ཞིང་"
    },
    {
      "span": {
        "start": 15358,
        "end": 15360
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 15521,
        "end": 15530
      },
      "text": "ཐུགས་རྗེ་ ༼སྣར། པེ།༽ ཐུགས་རྗེས་"
    },
    {
      "span": {
        "start": 15931,
        "end": 15935
      },
      "text": "རྩི་ ༼སྣར།༽ བརྩི་"
    },
    {
      "span": {
        "start": 17394,
        "end": 17400
      },
      "text": "རྣ་བར་ ༼སྣར། པེ།༽ རྣམ་པར་"
    },
    {
      "span": {
        "start": 17464,
        "end": 17472
      },
      "text": "རྒྱ་མཚོ་ ༼སྣར། པེ།༽ རྒྱ་མཚོར་"
    },
    {
      "span": {
        "start": 17517,
        "end": 17526
      },
      "text": "སྙན་པ་ཡི། ༼སྣར། པེ།༽ སྙན་པ་ཡིས།"
    },
    {
      "span": {
        "start": 17917,
        "end": 17920
      },
      "text": "གང་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 18195,
        "end": 18199
      },
      "text": "སླུ་ ༼སྣར། པེ།༽ བསླུ་"
    },
    {
      "span": {
        "start": 18712,
        "end": 18721
      },
      "text": "བགྱིད་ལས། ༼སྣར། པེ།༽ བགྱིད་པས།"
    },
    {
      "span": {
        "start": 18800,
        "end": 18806
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 19381,
        "end": 19384
      },
      "text": "དེ་ ༼སྣར།༽ ད་"
    },
    {
      "span": {
        "start": 19425,
        "end": 19429
      },
      "text": "སླུ་ ༼སྣར། པེ།༽ བསླུ་"
    },
    {
      "span": {
        "start": 19561,
        "end": 19569
      },
      "text": "སླད་དུས་ ༼སྣར། པེ།༽ སླད་དུ་"
    },
    {
      "span": {
        "start": 19719,
        "end": 19728
      },
      "text": "བསྟོད་པར་ ༼སྣར། པེ།༽ བསྟོད་པ་"
    },
    {
      "span": {
        "start": 20056,
        "end": 20063
      },
      "text": "དཀའ་བས་ ༼པེ།༽ དགའ་བས་"
    },
    {
      "span": {
        "start": 20417,
        "end": 20420
      },
      "text": "གང་ ༼སྣར། པེ།༽ གར་"
    },
    {
      "span": {
        "start": 20692,
        "end": 20698
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 21052,
        "end": 21059
      },
      "text": "དཔའ་བོ་ ༼སྣར།༽ དཔའོ་"
    },
    {
      "span": {
        "start": 21156,
        "end": 21162
      },
      "text": "དབུགས་ ༼པེ།༽ དབུག་"
    },
    {
      "span": {
        "start": 21348,
        "end": 21355
      },
      "text": "ཟློག་པ་ ༼སྣར།༽ ཟློགས་པ་ ༼པེ།༽ བཟློགས་པ་"
    },
    {
      "span": {
        "start": 21725,
        "end": 21729
      },
      "text": "གཞག་ ༼སྣར། པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 21870,
        "end": 21873
      },
      "text": "སྔ་ ༼སྣར། པེ།༽ ལྔ་"
    },
    {
      "span": {
        "start": 23066,
        "end": 23075
      },
      "text": "བསྟེན་པས་ ༼སྣར། པེ།༽ བསྟན་པས་"
    },
    {
      "span": {
        "start": 23432,
        "end": 23434
      },
      "text": "བ་ ༼སྣར། པེ།༽ བྷ་"
    },
    {
      "span": {
        "start": 23436,
        "end": 23439
      },
      "text": "དྭ་ ༼སྣར། པེ།༽ དྷྭ་"
    },
    {
      "span": {
        "start": 24214,
        "end": 24220
      },
      "text": "མཚར་བ་ ༼སྣར། པེ།༽ མཚར་མ་"
    },
    {
      "span": {
        "start": 24517,
        "end": 24527
      },
      "text": "ཀུན་འགྲུབ་ ༼སྣར། པེ།༽ ཀུན་གྲུབ་"
    },
    {
      "span": {
        "start": 24557,
        "end": 24562
      },
      "text": "རྟེན་ ༼པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 24837,
        "end": 24842
      },
      "text": "སྐུལ། ༼སྣར།༽ བསྐུལ།"
    },
    {
      "span": {
        "start": 24918,
        "end": 24923
      },
      "text": "བཞེན་ ༼པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 25066,
        "end": 25072
      },
      "text": "སྦྱོར། ༼སྣར། པེ།༽ སྦྱར།"
    },
    {
      "span": {
        "start": 25134,
        "end": 25146
      },
      "text": "ཁ་ལོས་སྒྱུར་ ༼སྣར།༽ ཁ་ལོ་བསྒྱུར་ ༼པེ།༽ ཁ་ལོ་རྒྱུར་"
    },
    {
      "span": {
        "start": 26344,
        "end": 26350
      },
      "text": "ལམ་ནས་ ༼སྣར། པེ།༽ ལམ་ལ་"
    },
    {
      "span": {
        "start": 26365,
        "end": 26374
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 26740,
        "end": 26744
      },
      "text": "སྨན་ ༼སྣར། པེ།༽ དམན་"
    },
    {
      "span": {
        "start": 26767,
        "end": 26776
      },
      "text": "ཀྱི་ལྟོས་ ༼སྣར། པེ།༽ ཀྱིས་བལྟོས་"
    },
    {
      "span": {
        "start": 26864,
        "end": 26869
      },
      "text": "སྲེད་ ༼པེ།༽ སྲིད་"
    },
    {
      "span": {
        "start": 27040,
        "end": 27048
      },
      "text": "དུ་གཅིག་ ༼སྣར། པེ།༽ དུ་ཅིག་"
    },
    {
      "span": {
        "start": 27051,
        "end": 27057
      },
      "text": "གཅིག ། ༼སྣར། པེ།༽ ཅིག །"
    },
    {
      "span": {
        "start": 27160,
        "end": 27169
      },
      "text": "རྣམས་ཀྱི། ༼སྣར། པེ།༽ རྣམས་ཀྱིས།"
    },
    {
      "span": {
        "start": 27263,
        "end": 27271
      },
      "text": "ལས་ལམ་ལ་ ༼སྣར། པེ།༽ ལས་ལམ་"
    },
    {
      "span": {
        "start": 27772,
        "end": 27782
      },
      "text": "ངོ་མཚར་ཏོ། ༼སྣར། པེ།༽ ངོ་མཚར་རོ།"
    },
    {
      "span": {
        "start": 27822,
        "end": 27830
      },
      "text": "སྨྱུང་བ་ ༼སྣར། པེ།༽ བསྨྱུང་བ་"
    },
    {
      "span": {
        "start": 27850,
        "end": 27854
      },
      "text": "ཚུལ་ ༼སྣར། པེ།༽ ཤུལ་"
    },
    {
      "span": {
        "start": 28237,
        "end": 28244
      },
      "text": "སྡོམ་པ་ ༼སྣར། པེ།༽ བསྡམ་པ་"
    },
    {
      "span": {
        "start": 28388,
        "end": 28399
      },
      "text": "དགོངས་པའང་། ༼པེ།༽ དགོངས་པའོ།"
    },
    {
      "span": {
        "start": 28515,
        "end": 28520
      },
      "text": "སྐུལ་ ༼སྣར། པེ།༽ བསྐུལ་"
    },
    {
      "span": {
        "start": 28749,
        "end": 28758
      },
      "text": "དེ་ལྟ་བུ། ༼སྣར། པེ།༽ དེ་ལྟ་བུར།"
    },
    {
      "span": {
        "start": 28906,
        "end": 28915
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 29269,
        "end": 29274
      },
      "text": "གྱུར། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 29405,
        "end": 29413
      },
      "text": "བརྗོད་པ་ ༼སྣར། པེ།༽ བཟོད་པ་"
    },
    {
      "span": {
        "start": 29635,
        "end": 29646
      },
      "text": "གོམས་པ་ཡིས། ༼སྣར། པེ།༽ གོམས་པ་ཡི།"
    },
    {
      "span": {
        "start": 29993,
        "end": 30001
      },
      "text": "བགྱིད་པ་ ༼སྣར། པེ།༽ བགྱིས་པ་"
    },
    {
      "span": {
        "start": 30045,
        "end": 30052
      },
      "text": "དེས་པར་ ༼སྣར། པེ།༽ ངེས་པར་"
    },
    {
      "span": {
        "start": 30284,
        "end": 30287
      },
      "text": "ཞི་ ༼སྣར།༽ ཞིབ་"
    },
    {
      "span": {
        "start": 30450,
        "end": 30459
      },
      "text": "ཆོས་ཀྱིས་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 30509,
        "end": 30518
      },
      "text": "གཏིང་བའི་ ༼སྣར། པེ།༽ བཏིང་བའི་"
    },
    {
      "span": {
        "start": 30804,
        "end": 30809
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ རྒྱུན་"
    },
    {
      "span": {
        "start": 31076,
        "end": 31081
      },
      "text": "འགུག་ ༼སྣར། པེ།༽ འགུགས་"
    },
    {
      "span": {
        "start": 31092,
        "end": 31100
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 31780,
        "end": 31791
      },
      "text": "གཞན་དོན་དུ་ ༼སྣར། པེ།༽ གཞན་དོན་ཀུན་"
    },
    {
      "span": {
        "start": 31857,
        "end": 31864
      },
      "text": "ལེགས་པ་ ༼པེ།༽ ལགས་པ་"
    },
    {
      "span": {
        "start": 31868,
        "end": 31875
      },
      "text": "ཐོགས་མ་ ༼སྣར། པེ།༽ ཐོག་མ་"
    },
    {
      "span": {
        "start": 31955,
        "end": 31959
      },
      "text": "མིག་ ༼སྣར། པེ།༽ ཚིག་"
    },
    {
      "span": {
        "start": 32225,
        "end": 32229
      },
      "text": "སྨད་ ༼སྣར། པེ།༽ སྣོད་"
    },
    {
      "span": {
        "start": 32313,
        "end": 32316
      },
      "text": "ཉམ་ ༼པེ།༽ ཉམས་"
    },
    {
      "span": {
        "start": 32469,
        "end": 32472
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 33020,
        "end": 33023
      },
      "text": "ཙེ་ ༼སྣར། པེ།༽ ཆེ་"
    },
    {
      "span": {
        "start": 33241,
        "end": 33250
      },
      "text": "བདུད་ཀྱི་ ༼སྣར། པེ།༽ བདུད་ཀྱིས་"
    },
    {
      "span": {
        "start": 33341,
        "end": 33350
      },
      "text": "གཞན་གྱིས་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 33669,
        "end": 33681
      },
      "text": "འདི་དག་ཀྱང་། ༼སྣར། པེ།༽ འདི་དག་དང་།"
    },
    {
      "span": {
        "start": 33723,
        "end": 33732
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 33737,
        "end": 33740
      },
      "text": "ལྷ་ ༼སྣར། པེ།༽ ལྷས་"
    },
    {
      "span": {
        "start": 33762,
        "end": 33767
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ རྩོལ།"
    },
    {
      "span": {
        "start": 33769,
        "end": 33778
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 34356,
        "end": 34362
      },
      "text": "དེ་ཀོ་ ༼སྣར། པེ།༽ ད་ཀོ་"
    },
    {
      "span": {
        "start": 34741,
        "end": 34748
      },
      "text": "ལྟོས་པ་ ༼སྣར། པེ།༽ བལྟོས་པ་"
    },
    {
      "span": {
        "start": 35037,
        "end": 35044
      },
      "text": "མཛད་དེ། ༼སྣར། པེ།༽ མཛད་དོ།"
    },
    {
      "span": {
        "start": 35435,
        "end": 35438
      },
      "text": "བས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 36589,
        "end": 36594
      },
      "text": "རྗོད་ ༼སྣར། པེ།༽ བརྗོད་"
    },
    {
      "span": {
        "start": 36793,
        "end": 36801
      },
      "text": "འཚུབ་མས་ ༼སྣར། པེ།༽ ཚུབ་མས་"
    },
    {
      "span": {
        "start": 37018,
        "end": 37023
      },
      "text": "མ་ཏི་ ༼སྣར། པེ།༽ མི་ཏྲ་"
    }
  ]
}