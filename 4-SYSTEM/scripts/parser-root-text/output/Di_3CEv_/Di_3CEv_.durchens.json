{
  "durchens": [
    {
      "span": {
        "start": 1227,
        "end": 1239
      },
      "text": "མེད་པ་ལ་མེད་ ༼སྣར།༽ མེད་"
    },
    {
      "span": {
        "start": 3745,
        "end": 3747
      },
      "text": "ཀ་ ༼སྣར།༽ བཀ་"
    },
    {
      "span": {
        "start": 4162,
        "end": 4168
      },
      "text": "ཁྱད་པ་ ༼སྣར།༽ ཁྱབ་པ་"
    },
    {
      "span": {
        "start": 4191,
        "end": 4201
      },
      "text": "ཕྱོགས་ཅིག་ ༼སྣར།༽ ཕྱོགས་གཅིག་"
    },
    {
      "span": {
        "start": 6413,
        "end": 6423
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 7973,
        "end": 7980
      },
      "text": "བྱེད་པ་ ༼སྣར།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 8056,
        "end": 8062
      },
      "text": "ལོག་པ་ ༼སྣར།༽ ལྡོག་པ་"
    },
    {
      "span": {
        "start": 9918,
        "end": 9920
      },
      "text": "མ་ ༼སྣར།༽ མ་པས་"
    },
    {
      "span": {
        "start": 10192,
        "end": 10199
      },
      "text": "རྟོག་པ་ ༼སྣར།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 10474,
        "end": 10480
      },
      "text": "ཅེས་པ་ ༼སྣར།༽ ཅེས་པ་འདི་"
    },
    {
      "span": {
        "start": 10882,
        "end": 10893
      },
      "text": "རྗེས་དཔག་པ་ ༼སྣར།༽ རྗེས་དཔག་"
    }
  ]
}