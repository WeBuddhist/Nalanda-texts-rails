{
  "durchens": [
    {
      "span": {
        "start": 451,
        "end": 456
      },
      "text": "བྱིང་ ༼སྣར། པེ།༽ བྱིངས་"
    },
    {
      "span": {
        "start": 519,
        "end": 524
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ སྦྱང་བ་"
    },
    {
      "span": {
        "start": 979,
        "end": 984
      },
      "text": "བཏོད་ ༼སྣར། པེ།༽ གཏོང་"
    },
    {
      "span": {
        "start": 2386,
        "end": 2394
      },
      "text": "བརྟག་པར་ ༼སྣར། པེ།༽ བརྟན་པར་"
    },
    {
      "span": {
        "start": 2399,
        "end": 2405
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 2612,
        "end": 2618
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 2968,
        "end": 2974
      },
      "text": "དབུ་མ་ ༼སྣར། པེ།༽ དབུ་བ་"
    },
    {
      "span": {
        "start": 3198,
        "end": 3202
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 3347,
        "end": 3351
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 3466,
        "end": 3471
      },
      "text": "རྟགས་ ༼སྣར། པེ།༽ གཏགས་"
    },
    {
      "span": {
        "start": 3902,
        "end": 3907
      },
      "text": "དབྱེ་ ༼སྣར། པེ།༽ དབྱེན་"
    },
    {
      "span": {
        "start": 4214,
        "end": 4223
      },
      "text": "བཟོད་པའང་ ༼སྣར། པེ།༽ བཟོད་པར་འང་"
    },
    {
      "span": {
        "start": 4357,
        "end": 4364
      },
      "text": "ལོག་པར་ ༼སྣར། པེ།༽ ལོག་པ་"
    },
    {
      "span": {
        "start": 4866,
        "end": 4874
      },
      "text": "རིག་པའི་ ༼སྣར། པེ།༽ རིགས་པའི་"
    },
    {
      "span": {
        "start": 4885,
        "end": 4889
      },
      "text": "འཇུ་ ༼སྣར། པེ།༽ འཛུགས་"
    },
    {
      "span": {
        "start": 5532,
        "end": 5540
      },
      "text": "གོ་རིམས་ ༼སྣར། པེ།༽ གོ་རིམ་"
    },
    {
      "span": {
        "start": 5615,
        "end": 5627
      },
      "text": "བརྟགས་པ་ཡིས། ༼སྣར། པེ།༽ བརྟགས་པ་ཡི།"
    },
    {
      "span": {
        "start": 6545,
        "end": 6552
      },
      "text": "འདབ་ཆུ་ ༼སྣར། པེ།༽ འབབ་ཆུ་"
    },
    {
      "span": {
        "start": 6569,
        "end": 6578
      },
      "text": "ཡང་དག་གི། ༼སྣར། པེ།༽ ཡང་དག་གིས།"
    },
    {
      "span": {
        "start": 6845,
        "end": 6852
      },
      "text": "བློ་ཡི་ ༼སྣར། པེ།༽ བློ་ཡིས་"
    },
    {
      "span": {
        "start": 6907,
        "end": 6913
      },
      "text": "དཀའ་བ་ ༼སྣར། པེ།༽ དཀའ་བས་"
    },
    {
      "span": {
        "start": 7457,
        "end": 7466
      },
      "text": "སེམས་ཀྱི་ ༼སྣར། པེ།༽ སེམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 7658,
        "end": 7667
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 7768,
        "end": 7773
      },
      "text": "ལྔའམ་ ༼སྣར། པེ།༽ ལྔའང་"
    },
    {
      "span": {
        "start": 8036,
        "end": 8047
      },
      "text": "གདོན་རྟོགས་ ༼སྣར། པེ།༽ མངོན་རྟོགས་"
    },
    {
      "span": {
        "start": 8696,
        "end": 8709
      },
      "text": "ཉམས་མྱོངས་པས། ༼སྣར། པེ།༽ ཉམས་མྱོང་བས།"
    },
    {
      "span": {
        "start": 8953,
        "end": 8963
      },
      "text": "འོད་སྲུངས་ ༼སྣར། པེ།༽ འོད་སྲུང་"
    },
    {
      "span": {
        "start": 8983,
        "end": 8993
      },
      "text": "འོད་སྲུངས་ ༼སྣར། པེ།༽ འོད་སྲུང་"
    },
    {
      "span": {
        "start": 9159,
        "end": 9166
      },
      "text": "སྲུང་བ་ ༼སྣར། པེ།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 9503,
        "end": 9512
      },
      "text": "ཆགས་གསུམ་ ༼སྣར། པེ།༽ ཆ་གསུམ་"
    },
    {
      "span": {
        "start": 9631,
        "end": 9639
      },
      "text": "འདས་ཀྱི། ༼སྣར། པེ།༽ འདས་ཀྱིས།"
    },
    {
      "span": {
        "start": 9774,
        "end": 9785
      },
      "text": "ལ་སོགས་ཀྱི། ༼སྣར། པེ།༽ ལ་སོགས་ཀྱིས།"
    },
    {
      "span": {
        "start": 10322,
        "end": 10329
      },
      "text": "བྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 10468,
        "end": 10482
      },
      "text": "ཉེས་དམིགས་ཀྱི་ ༼སྣར། པེ།༽ ཉེས་དམིགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 10595,
        "end": 10599
      },
      "text": "ལྡང་ ༼སྣར། པེ།༽ ལྔ་"
    },
    {
      "span": {
        "start": 10602,
        "end": 10606
      },
      "text": "བཞི་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 10681,
        "end": 10686
      },
      "text": "རྫུས་ ༼སྣར། པེ།༽ བརྫུས་"
    },
    {
      "span": {
        "start": 10910,
        "end": 10917
      },
      "text": "ནི་ཡིད་ ༼སྣར། པེ།༽ ནི་ཡང་"
    },
    {
      "span": {
        "start": 10920,
        "end": 10924
      },
      "text": "ཡིད་ ༼སྣར། པེ།༽ ཡང་"
    },
    {
      "span": {
        "start": 11328,
        "end": 11335
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་དུ་"
    },
    {
      "span": {
        "start": 12242,
        "end": 12251
      },
      "text": "རྡུལ་གྱི་ ༼སྣར། པེ།༽ རྡུལ་གྱིས་"
    },
    {
      "span": {
        "start": 12311,
        "end": 12317
      },
      "text": "གསལ་བ་ ༼སྣར། པེ།༽ གཡེལ་བ་"
    },
    {
      "span": {
        "start": 12320,
        "end": 12348
      },
      "text": "།ལེན་འགའ་ཡང་ནི་སྣང་གྱུར་པ། ། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 12518,
        "end": 12537
      },
      "text": "ལས་ང་རྒྱལ་རྣམ་གསུམ་ ༼སྣར། པེ།༽ ལ་སངས་རྒྱས་རྣམས་སུ་"
    },
    {
      "span": {
        "start": 12690,
        "end": 12694
      },
      "text": "རིག་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 12730,
        "end": 12735
      },
      "text": "རལ་པ་ ༼སྣར། པེ།༽ རལ་པ་འང་"
    },
    {
      "span": {
        "start": 13108,
        "end": 13112
      },
      "text": "དགའ་ ༼སྣར། པེ།༽ རྒ་"
    },
    {
      "span": {
        "start": 13325,
        "end": 13331
      },
      "text": "བརྗོད་ ༼སྣར། པེ།༽ རྗོད་"
    },
    {
      "span": {
        "start": 13347,
        "end": 13356
      },
      "text": "རྒྱུ་ལྟར་ ༼སྣར། པེ།༽ རྒྱུ་སྐར་"
    },
    {
      "span": {
        "start": 13360,
        "end": 13362
      },
      "text": "བ་ ༼སྣར། པེ།༽ བའི་"
    },
    {
      "span": {
        "start": 13782,
        "end": 13784
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 14297,
        "end": 14302
      },
      "text": "བརྒྱ་ ༼སྣར། པེ།༽ བརྒྱད་"
    },
    {
      "span": {
        "start": 14681,
        "end": 14685
      },
      "text": "བདག་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 14732,
        "end": 14739
      },
      "text": "དེས་ནི་ ༼སྣར། པེ།༽ དེས་ན་"
    },
    {
      "span": {
        "start": 14796,
        "end": 14800
      },
      "text": "བདག་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 14938,
        "end": 14943
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ གྱུར་པས་ན། །དེས་ན་དབང་དུ་གྱུར་"
    },
    {
      "span": {
        "start": 15154,
        "end": 15161
      },
      "text": "དག་ཉིད་ ༼པེ།༽ བདག་ཉིད་ ༼སྣར།༽ བདག་ཉིད་ཐར་"
    },
    {
      "span": {
        "start": 15191,
        "end": 15199
      },
      "text": "གྱུར་པས། ༼སྣར། པེ།༽ འགྱུར་བས།"
    },
    {
      "span": {
        "start": 15267,
        "end": 15273
      },
      "text": "དེ་ཡི་ ༼སྣར། པེ།༽ དེ་ཡིས་"
    },
    {
      "span": {
        "start": 15316,
        "end": 15319
      },
      "text": "དག་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 15370,
        "end": 15384
      },
      "text": "ཐོབ། །སྐྱེས་པ་ ༼སྣར། པེ།༽ འཐོབ། སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 15410,
        "end": 15417
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 15985,
        "end": 15993
      },
      "text": "ལྟོས་པར་ ༼སྣར། པེ།༽ བལྟོས་པར་"
    },
    {
      "span": {
        "start": 16015,
        "end": 16024
      },
      "text": "དུས་ཀྱིས་ ༼སྣར། པེ།༽ དུས་ཀྱི་"
    },
    {
      "span": {
        "start": 16216,
        "end": 16225
      },
      "text": "དུས་ཀྱིས་ ༼སྣར། པེ།༽ དུས་ཀྱི་"
    },
    {
      "span": {
        "start": 16234,
        "end": 16240
      },
      "text": "སད་པར་ ༼སྣར། པེ།༽ གསད་པར་"
    },
    {
      "span": {
        "start": 16273,
        "end": 16280
      },
      "text": "སྲུང་བ་ ༼སྣར། པེ།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 16280,
        "end": 16291
      },
      "text": "སུམ་བརྩེགས་ ༼སྣར། པེ།༽ གསུམ་རྩེག་"
    },
    {
      "span": {
        "start": 16353,
        "end": 16360
      },
      "text": "གང་ཞིག་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 16408,
        "end": 16416
      },
      "text": "དུས་ཀྱི་ ༼སྣར། པེ།༽ དུས་ཀྱིས་"
    },
    {
      "span": {
        "start": 16532,
        "end": 16568
      },
      "text": "ཉིད་དང་། །དམ་པ་མིན་པའི་བརྩེ་མེད་ཉིད། ༼སྣར། པེ།༽ ཉིད་ང་།"
    },
    {
      "span": {
        "start": 16740,
        "end": 16745
      },
      "text": "ཟླ་བ་ ༼སྣར། པེ།༽ ཟླ་"
    },
    {
      "span": {
        "start": 16905,
        "end": 16910
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 16927,
        "end": 16937
      },
      "text": "རྣམས་ཀྱིས་ ༼པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 17235,
        "end": 17241
      },
      "text": "ད་ལྟར་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 17421,
        "end": 17426
      },
      "text": "གེགས་ ༼སྣར། པེ།༽ བགེགས་"
    },
    {
      "span": {
        "start": 17576,
        "end": 17586
      },
      "text": "སྙིང་རྗེར་ ༼སྣར། པེ།༽ སྙིང་རྗེ་"
    }
