{
  "durchens": [
    {
      "span": {
        "start": 486,
        "end": 494
      },
      "text": "འོད་ཉིད་ ༼སྣར། པེ།༽ འོད་"
    },
    {
      "span": {
        "start": 565,
        "end": 571
      },
      "text": "ངོ་བོ་ ༼སྣར། པེ།༽ ངོ་བོར་"
    },
    {
      "span": {
        "start": 626,
        "end": 635
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 770,
        "end": 773
      },
      "text": "རི་ ༼སྣར། པེ།༽ རཱི་"
    },
    {
      "span": {
        "start": 809,
        "end": 815
      },
      "text": "མ་རྒད་ ༼སྣར། པེ།༽ མ་མར་ཀཏ་"
    },
    {
      "span": {
        "start": 1014,
        "end": 1020
      },
      "text": "དཔྱངས། ༼སྣར། པེ།༽ སྦྱངས།"
    },
    {
      "span": {
        "start": 1029,
        "end": 1034
      },
      "text": "མརྒད་ ༼སྣར། པེ།༽ མར་ཀཏ་"
    },
    {
      "span": {
        "start": 1599,
        "end": 1603
      },
      "text": "འདི། ༼སྣར། པེ།༽ ཉིད།"
    },
    {
      "span": {
        "start": 1700,
        "end": 1710
      },
      "text": "མྱང་བར་བྱ། ༼སྣར། པེ།༽ མྱང་བ་དང་།"
    },
    {
      "span": {
        "start": 1831,
        "end": 1843
      },
      "text": "རྒྱལ་མཚན་ཅན་ ༼སྣར། པེ།༽ རྒྱལ་མཚན་"
    },
    {
      "span": {
        "start": 2056,
        "end": 2064
      },
      "text": "རྡོ་རྗེ་ ༼སྣར། པེ།༽ རྡོ་རྗེ་ལས་"
    }
  ]
}