{
  "durchens": [
    {
      "span": {
        "start": 363,
        "end": 373
      },
      "text": "རི་བོ་དུར་ ༼སྣར། པེ།༽ རི་བོ་"
    },
    {
      "span": {
        "start": 542,
        "end": 559
      },
      "text": "ཆོ་ག་རྫོགས་པ་དང་། ༼སྣར། པེ།༽ ཆོ་ག་འགྲེང་བ།"
    },
    {
      "span": {
        "start": 593,
        "end": 599
      },
      "text": "རབ་ཏུ་ ༼སྣར། པེ།༽ རབ་བཙིགས་"
    },
    {
      "span": {
        "start": 688,
        "end": 696
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ འཛག་པོ་"
    },
    {
      "span": {
        "start": 750,
        "end": 752
      },
      "text": "ལ། ༼པེ།༽ ལྟར་།"
    },
    {
      "span": {
        "start": 795,
        "end": 803
      },
      "text": "འོད་ཟེར་ ༼སྣར། པེ།༽ འོད་"
    },
    {
      "span": {
        "start": 926,
        "end": 933
      },
      "text": "མིང་ཅན་ ༼སྣར། པེ།༽ མིང་ལྔས་"
    },
    {
      "span": {
        "start": 1058,
        "end": 1065
      },
      "text": "གང་བའི་ ༼སྣར། པེ།༽ ཤ་བའི་"
    },
    {
      "span": {
        "start": 1085,
        "end": 1087
      },
      "text": "ཁ་ ༼སྣར། པེ།༽ རཱ་"
    },
    {
      "span": {
        "start": 1103,
        "end": 1110
      },
      "text": "སྟག་གི་ ༼སྣར།༽ སྟག་མུཀྲ་ ༼པེ།༽ སྟག་མུཀྚ་"
    },
    {
      "span": {
        "start": 1114,
        "end": 1117
      },
      "text": "པས་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 1134,
        "end": 1138
      },
      "text": "དབུ་ ༼སྣར། པེ།༽ མཱ་"
    },
    {
      "span": {
        "start": 1162,
        "end": 1167
      },
      "text": "སྤྱན་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 1172,
        "end": 1202
      },
      "text": "མཆེ་གཙིགས་འཇིགས་པར་བྱེད། །ཐོད་ ༼སྣར། པེ།༽ མཆེ་དི་ཏྭྃ་པྲི་ཏ་"
    },
    {
      "span": {
        "start": 1204,
        "end": 1218
      },
      "text": "རིན་ཆེན་སྦྲུལ་ ༼སྣར། པེ།༽ པི་ད་ཧ་"
    },
    {
      "span": {
        "start": 1265,
        "end": 1280
      },
      "text": "འདུག་སྟངས་ཀྱིས་ ༼སྣར། པེ།༽ མཱཥྚྃ་ཁ་སྟངས་"
    },
    {
      "span": {
        "start": 1287,
        "end": 1299
      },
      "text": "། །དེ་ནས་རང་ ༼སྣར། པེ།༽ ། རཱ་མ་རཱང་"
    },
    {
      "span": {
        "start": 1371,
        "end": 1381
      },
      "text": "། །མཆོད་ལ་ ༼སྣར། པེ།༽ ། མ་རཱ་"
    },
    {
      "span": {
        "start": 1437,
        "end": 1440
      },
      "text": "མཉེས་པར་བྱ། ། ༼སྣར། པེ།༽ མཉེས་པར་སརྦ་བྷུ་"
    },
    {
      "span": {
        "start": 1453,
        "end": 1455
      },
      "text": "ག་ ༼སྣར། པེ།༽ ཙོ་"
    },
    {
      "span": {
        "start": 1622,
        "end": 1629
      },
      "text": "ཅི་ནུས་ ༼སྣར། པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 1646,
        "end": 1651
      },
      "text": "བཟླས་ ༼སྣར། པེ།༽ བསྐུལ་"
    },
    {
      "span": {
        "start": 2078,
        "end": 2085
      },
      "text": "ཐོབ་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 2132,
        "end": 2138
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ བས་"
    }
  ]
}