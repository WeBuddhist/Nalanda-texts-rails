{
  "durchens": [
    {
      "span": {
        "start": 286,
        "end": 292
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 315,
        "end": 319
      },
      "text": "ཆོས་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 414,
        "end": 419
      },
      "text": "ཕྱིས་ ༼པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 810,
        "end": 819
      },
      "text": "ལེགས་པའི་ ༼སྣར། པེ།༽ ལེགས་པས་"
    },
    {
      "span": {
        "start": 946,
        "end": 953
      },
      "text": "གསོད་པ་ ༼སྣར།༽ བསོད་པ་"
    },
    {
      "span": {
        "start": 1263,
        "end": 1270
      },
      "text": "ཡིན་ནོ། ༼པེ།༽ ཡིན་ན།"
    },
    {
      "span": {
        "start": 1673,
        "end": 1679
      },
      "text": "རྐུ་བ་ ༼སྣར། པེ།༽ བརྐུ་བ་"
    },
    {
      "span": {
        "start": 1780,
        "end": 1785
      },
      "text": "འབྱེ། ༼སྣར།༽ འབྱེད།"
    },
    {
      "span": {
        "start": 1937,
        "end": 1946
      },
      "text": "འཐུངས་པས་ ༼སྣར། པེ།༽ འཐུང་བས་"
    },
    {
      "span": {
        "start": 1974,
        "end": 1978
      },
      "text": "བཏང་ ༼སྣར།༽ གཏང་"
    },
    {
      "span": {
        "start": 2147,
        "end": 2151
      },
      "text": "འདི། ༼སྣར། པེ།༽ ཉིད།"
    },
    {
      "span": {
        "start": 2153,
        "end": 2161
      },
      "text": "ཀུན་གྱི་ ༼སྣར། པེ།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 2465,
        "end": 2474
      },
      "text": "བདེ་འགྲོ་ ༼སྣར། པེ།༽ བདེ་འགྲོར་"
    },
    {
      "span": {
        "start": 2796,
        "end": 2803
      },
      "text": "དེ་ལྟར་ ༼སྣར།༽ ད་ལྟར་"
    },
    {
      "span": {
        "start": 2925,
        "end": 2931
      },
      "text": "དང་མི་ ༼སྣར།༽ དང་མིག་"
    },
    {
      "span": {
        "start": 3196,
        "end": 3204
      },
      "text": "བདག་གིར་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 3574,
        "end": 3578
      },
      "text": "མོད་ ༼སྣར།༽ མོས་"
    },
    {
      "span": {
        "start": 3611,
        "end": 3614
      },
      "text": "ཟད་ ༼སྣར།༽ བཟད་"
    },
    {
      "span": {
        "start": 3743,
        "end": 3747
      },
      "text": "དགའ་ ༼སྡེ།༽ འགའ་"
    },
    {
      "span": {
        "start": 3926,
        "end": 3931
      },
      "text": "འཐོབ་ ༼སྣར། པེ།༽ ཐོབ་"
    },
    {
      "span": {
        "start": 3939,
        "end": 3944
      },
      "text": "ཀྱིས། ༼སྣར། པེ།༽ ཀྱི།"
    },
    {
      "span": {
        "start": 3998,
        "end": 4005
      },
      "text": "ཡོད་པར། ༼སྣར། པེ།༽ ཡོད་པ།"
    },
    {
      "span": {
        "start": 4163,
        "end": 4174
      },
      "text": "ཕན་ཚུན་གྱི། ༼པེ།༽ ཕན་ཚུན་གྱིས།"
    },
    {
      "span": {
        "start": 4597,
        "end": 4600
      },
      "text": "ནི་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 4648,
        "end": 4651
      },
      "text": "ཐར་ ༼སྣར། པེ།༽ མཐར་"
    },
    {
      "span": {
        "start": 4688,
        "end": 4693
      },
      "text": "འདྲར་ ༼སྣར།༽ འདྲ་"
    },
    {
      "span": {
        "start": 5131,
        "end": 5138
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 5355,
        "end": 5360
      },
      "text": "བཏགས་ ༼སྣར། པེ།༽ གཏགས་"
    },
    {
      "span": {
        "start": 5486,
        "end": 5491
      },
      "text": "སྐྱེ་ ༼སྣར། པེ།༽ སྐྱེས་"
    },
    {
      "span": {
        "start": 5603,
        "end": 5611
      },
      "text": "འོད་ཀྱང་ ༼སྡེ།༽ འོན་ཀྱང་"
    },
    {
      "span": {
        "start": 5715,
        "end": 5723
      },
      "text": "བླངས་ནས། ༼སྣར། པེ།༽ བླངས་པས།"
    },
    {
      "span": {
        "start": 5843,
        "end": 5852
      },
      "text": "མི་བརྟེན་ ༼སྣར། པེ།༽ མེད་རྟེན་"
    },
    {
      "span": {
        "start": 5953,
        "end": 5963
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 6053,
        "end": 6063
      },
      "text": "རྣམས་ཀྱིས། ༼སྣར། པེ།༽ རྣམས་ཀྱི།"
    },
    {
      "span": {
        "start": 6515,
        "end": 6521
      },
      "text": "བརྟེན་ ༼སྣར།༽ བདེན་ ༼པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 6606,
        "end": 6612
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 6770,
        "end": 6778
      },
      "text": "མེད་ཉིད་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 6783,
        "end": 6789
      },
      "text": "དམ་མི་ ༼སྣར། པེ།༽ དམ་ནི་"
    },
    {
      "span": {
        "start": 7089,
        "end": 7096
      },
      "text": "ཞིག་ནས་ ༼སྣར། པེ།༽ ཞིག་གནས་"
    },
    {
      "span": {
        "start": 7426,
        "end": 7432
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 7548,
        "end": 7558
      },
      "text": "ཟད་པས་སྐད་ ༼སྣར། པེ།༽ ཟད་པས་པ་ད་"
    },
    {
      "span": {
        "start": 7684,
        "end": 7689
      },
      "text": "ཞིག ་ ༼སྣར། པེ།༽ ཞིག ་བརྟན་ཕྱིར་སྐད་ཅིག་མིན་ན་ཡང་། །རྙིང་པ་དགའ་ལྟ་ག་ལ་ཞིག་"
    },
    {
      "span": {
        "start": 8262,
        "end": 8270
      },
      "text": "ཟབ་མོའི་ ༼སྣར། པེ།༽ ཟབ་པའི་"
    },
    {
      "span": {
        "start": 8536,
        "end": 8540
      },
      "text": "གནས་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 8585,
        "end": 8589
      },
      "text": "མཁས་ ༼སྣར།༽ མཁས་པ་"
    },
    {
      "span": {
        "start": 8597,
        "end": 8604
      },
      "text": "ཕུང་བར་ ༼སྣར། པེ།༽ འཕུང་བར་"
    },
    {
      "span": {
        "start": 8794,
        "end": 8800
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 9295,
        "end": 9302
      },
      "text": "གསུམ་ས་ ༼སྣར།༽ གསུམ་པ་"
    },
    {
      "span": {
        "start": 9562,
        "end": 9568
      },
      "text": "མེད་ན། ༼སྣར། པེ།༽ དེ་མིན།"
    },
    {
      "span": {
        "start": 9951,
        "end": 9972
      },
      "text": "སོ་སོ་རང་གི་ཡོད་ཅེ་ན། ༼སྣར། པེ།༽ གལ་ཏེ་སོ་སོར་རང་མེད་ཀྱི།"
    },
    {
      "span": {
        "start": 9994,
        "end": 10001
      },
      "text": "རྣམས། ། ༼སྣར། པེ།༽ ། །སོ་སོ་རང་གི་ཡོད་ཅེ་ན་"
    },
    {
      "span": {
        "start": 10069,
        "end": 10073
      },
      "text": "མེད་ ༼སྣར། པེ།༽ ཡོད་"
    },
    {
      "span": {
        "start": 10129,
        "end": 10136
      },
      "text": "ཆེར་འང་ ༼སྣར། པེ།༽ ཆེར་"
    },
    {
      "span": {
        "start": 10576,
        "end": 10585
      },
      "text": "རླུང་གིས་ ༼སྣར། པེ།༽ རླུང་གི་"
    },
    {
      "span": {
        "start": 10589,
        "end": 10593
      },
      "text": "ཐོད་ ༼སྣར། པེ།༽ ཐོས་"
    },
    {
      "span": {
        "start": 10939,
        "end": 10945
      },
      "text": "ནས་ཞི། ༼སྣར།༽ ནས་ཞིང་།"
    },
    {
      "span": {
        "start": 11042,
        "end": 11044
      },
      "text": "ག་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 11093,
        "end": 11099
      },
      "text": "ཡང་ནི་ ༼སྣར། པེ།༽ ཡང་ན་"
    },
    {
      "span": {
        "start": 11919,
        "end": 11924
      },
      "text": "བཞེས། ༼སྣར།༽ གཞེས།"
    },
    {
      "span": {
        "start": 12136,
        "end": 12142
      },
      "text": "བྱེ་བ་ ༼སྣར། པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 12687,
        "end": 12695
      },
      "text": "ཟད་པས་ན། ༼སྣར། པེ།༽ ཟད་པས་ནས།"
    },
    {
      "span": {
        "start": 12730,
        "end": 12739
      },
      "text": "སྒྱུ་མའི་ ༼སྣར། པེ།༽ སྒྱུ་འདྲའི་"
    },
    {
      "span": {
        "start": 12797,
        "end": 12805
      },
      "text": "ཟད་པས་ན། ༼སྣར། པེ།༽ ཟད་པས་ནས།"
    },
    {
      "span": {
        "start": 12873,
        "end": 12875
      },
      "text": "པ་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 12948,
        "end": 12962
      },
      "text": "སངས་རྒྱས་ཀྱིས་ ༼སྣར། པེ།༽ སངས་རྒྱས་ཀྱི་"
    },
    {
      "span": {
        "start": 13154,
        "end": 13160
      },
      "text": "གནས་པ་ ༼སྣར། པེ།༽ སྣང་བ་"
    },
    {
      "span": {
        "start": 13229,
        "end": 13232
      },
      "text": "གོ་ ༼སྣར། པེ།༽ ཀོ་"
    },
    {
      "span": {
        "start": 13417,
        "end": 13426
      },
      "text": "མཁས་རྣམས་ ༼སྣར། པེ།༽ མཁས་པ་"
    },
    {
      "span": {
        "start": 13578,
        "end": 13589
      },
      "text": "མནར་མེད་པར་ ༼སྣར། པེ།༽ མནར་མེད་པ་"
    },
    {
      "span": {
        "start": 13714,
        "end": 13718
      },
      "text": "ལྟར། ༼སྣར།༽ ལྟ།"
    },
    {
      "span": {
        "start": 13742,
        "end": 13746
      },
      "text": "དེས། ༼སྣར། པེ།༽ དེ།"
    },
    {
      "span": {
        "start": 14070,
        "end": 14072
      },
      "text": "པ། ༼སྣར།༽ ལ།"
    },
    {
      "span": {
        "start": 14321,
        "end": 14324
      },
      "text": "ཀར་ ༼སྣར།༽ གར་"
    },
    {
      "span": {
        "start": 14425,
        "end": 14434
      },
      "text": "ཆོས་ཀྱིས་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 14880,
        "end": 14890
      },
      "text": "གནོད་པ་བྱ་ ༼སྣར།༽ གནོད་པར་བྱས་ ༼པེ།༽ གནོད་པ་བྱས་"
    },
    {
      "span": {
        "start": 15024,
        "end": 15033
      },
      "text": "དོན་གཅིག་ ༼སྣར། པེ།༽ དོན་ཅིག་"
    },
    {
      "span": {
        "start": 15053,
        "end": 15063
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 15138,
        "end": 15147
      },
      "text": "གཅིག་ཡིད་ ༼སྣར།༽ ཅིག་ཡིད་ ༼པེ།༽ ཅིག་ཡིས་"
    },
    {
      "span": {
        "start": 15151,
        "end": 15156
      },
      "text": "བརྟན་ ༼སྣར། པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 15224,
        "end": 15230
      },
      "text": "སླུ་བ་ ༼པེ།༽ བསླུ་བ་"
    },
    {
      "span": {
        "start": 15230,
        "end": 15234
      },
      "text": "མེད་ ༼སྣར། པེ།༽ མི་"
    },
    {
      "span": {
        "start": 15252,
        "end": 15260
      },
      "text": "སེམས་པས་ ༼སྣར། པེ།༽ སེམས་དཔས་"
    },
    {
      "span": {
        "start": 15320,
        "end": 15327
      },
      "text": "ནི་ཅིག་ ༼པེ།༽ ནི་གཅིག་"
    },
    {
      "span": {
        "start": 15781,
        "end": 15790
      },
      "text": "བསྟོད་པར་ ༼སྣར།༽ སྟོད་པར་"
    },
    {
      "span": {
        "start": 15790,
        "end": 15796
      },
      "text": "འགྱུར། ༼སྣར། པེ།༽ གྱུར།"
    },
    {
      "span": {
        "start": 16190,
        "end": 16196
      },
      "text": "དེ་ནས་ ༼སྣར། པེ།༽ དེང་ནས་"
    },
    {
      "span": {
        "start": 16418,
        "end": 16429
      },
      "text": "གལ་ཏེ་གཅིག་ ༼སྣར། པེ།༽ གལ་ཏེ་ཅིག་"
    },
    {
      "span": {
        "start": 16431,
        "end": 16440
      },
      "text": "ཡིད་རྟོན་ ༼སྣར། པེ།༽ ཡིད་བརྟན་"
    },
    {
      "span": {
        "start": 16474,
        "end": 16481
      },
      "text": "ཆང་གིས་ ༼སྣར། པེ།༽ ཆང་གི་"
    },
    {
      "span": {
        "start": 16491,
        "end": 16496
      },
      "text": "བརྙས་ ༼སྣར། པེ།༽ བསྙད་"
    },
    {
      "span": {
        "start": 16603,
        "end": 16609
      },
      "text": "དང་མི་ ༼སྣར།༽ དང་མིང་"
    },
    {
      "span": {
        "start": 16658,
        "end": 16664
      },
      "text": "ཀྱལ་བ་ ༼སྣར། པེ།༽ བཀྱལ་བ་"
    },
    {
      "span": {
        "start": 17029,
        "end": 17036
      },
      "text": "ཆགས་པར་ ༼སྣར།༽ ཆགས་པ་"
    },
    {
      "span": {
        "start": 17113,
        "end": 17125
      },
      "text": "རྨོངས་པ་ཡིས། ༼པེ།༽ རྨོངས་པ་ཡིད།"
    },
    {
      "span": {
        "start": 17283,
        "end": 17287
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 17304,
        "end": 17313
      },
      "text": "རབ་ཆགས་པ་ ༼སྣར།༽ རབ་ཆགས་པར་"
    },
    {
      "span": {
        "start": 17338,
        "end": 17342
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 17423,
        "end": 17429
      },
      "text": "དོད་པ་ ༼སྣར། པེ།༽ འདོད་པ་"
    },
    {
      "span": {
        "start": 17483,
        "end": 17491
      },
      "text": "བརྟགས། ། ༼སྣར། པེ།༽ བརྟག །"
    },
    {
      "span": {
        "start": 17616,
        "end": 17628
      },
      "text": "འདྲེས་པ་ཡིས། ༼སྡེ།༽ འདྲེས་པ་ཡི།"
    },
    {
      "span": {
        "start": 17816,
        "end": 17822
      },
      "text": "ཉལ་བར་ ༼ཅོ།༽ ཉལ་བ་"
    },
    {
      "span": {
        "start": 18276,
        "end": 18290
      },
      "text": "མི་གཙང་གང་བའི་ ༼སྣར། པེ།༽ མི་གཙངབ་ཡི་"
    },
    {
      "span": {
        "start": 18783,
        "end": 18789
      },
      "text": "རྟོགས་ ༼སྣར། པེ།༽ རྟོག་"
    },
    {
      "span": {
        "start": 19009,
        "end": 19014
      },
      "text": "རྩོད་ ༼སྣར། པེ།༽ བརྩོད་"
    },
    {
      "span": {
        "start": 19179,
        "end": 19185
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ རྟགས་"
    },
    {
      "span": {
        "start": 19240,
        "end": 19248
      },
      "text": "བསྲབས་པ་ ༼སྣར། པེ།༽ སྲབས་པ་"
    },
    {
      "span": {
        "start": 19467,
        "end": 19473
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 19573,
        "end": 19579
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 19634,
        "end": 19642
      },
      "text": "མིན་སྤང་ ༼སྣར། པེ།༽ མིན་ཡང་"
    },
    {
      "span": {
        "start": 19794,
        "end": 19804
      },
      "text": "ཕྱོགས་མཐས་ ༼སྣར། པེ།༽ ཕྱོགས་མཐའ་"
    },
    {
      "span": {
        "start": 19873,
        "end": 19887
      },
      "text": "སྐྱེས་ཆེན་གྱི། ༼སྣར། པེ།༽ སྐྱེས་ཆེན་གྱིས།"
    },
    {
      "span": {
        "start": 20027,
        "end": 20032
      },
      "text": "བཀུར་ ༼སྣར།༽ བསྐུར་"
    },
    {
      "span": {
        "start": 20249,
        "end": 20258
      },
      "text": "དོན་གཅིག་ ༼སྣར། པེ།༽ དོན་ཅིག་"
    },
    {
      "span": {
        "start": 20407,
        "end": 20414
      },
      "text": "ཞིང་། ། ༼སྣར། པེ།༽ ། །ཕྱག་དང་ཞབས་དང་ཐལ་གོང་དང་། །ལྟོག་པའི་ཕྱོགས་རྣམས་མཐོ་བའི་ཕྱིར།།"
    },
    {
      "span": {
        "start": 20452,
        "end": 20458
      },
      "text": "གསད་པ་ ༼སྣར། པེ།༽ བསད་པ་"
    },
    {
      "span": {
        "start": 20641,
        "end": 20643
      },
      "text": "བ་ ༼པེ།༽ བས་"
    },
    {
      "span": {
        "start": 20734,
        "end": 20736
      },
      "text": "ན་ ༼སྣར།༽ ཎ་ ༼པེ།༽ ཎེ་"
    },
    {
      "span": {
        "start": 20901,
        "end": 20907
      },
      "text": "འགྱུར། ༼སྣར།༽ གྱུར།"
    },
    {
      "span": {
        "start": 20971,
        "end": 20977
      },
      "text": "མདོམས་ ༼སྣར། པེ།༽ འདོམས་"
    },
    {
      "span": {
        "start": 21022,
        "end": 21033
      },
      "text": "ཁང་བཟང་གདང་ ༼ཅོ།༽ བཟངས་གཏིང་ ༼སྡེ།༽ ཁང་བཟང་གདིང་"
    },
    {
      "span": {
        "start": 21065,
        "end": 21071
      },
      "text": "འབྱིན་ ༼སྣར། པེ།༽ བྱིན་"
    },
    {
      "span": {
        "start": 21084,
        "end": 21088
      },
      "text": "བཙོ་ ༼སྣར། པེ།༽ གཙོ་"
    },
    {
      "span": {
        "start": 21172,
        "end": 21179
      },
      "text": "བླ་མའི་ ༼སྣར། པེ།༽ བླ་མས་"
    },
    {
      "span": {
        "start": 21296,
        "end": 21301
      },
      "text": "མཐུན་ ༼སྣར། པེ།༽ མཐུས་"
    },
    {
      "span": {
        "start": 21348,
        "end": 21357
      },
      "text": "སེང་གེའི་ ༼སྣར། པེ།༽ སེང་གེ་"
    },
    {
      "span": {
        "start": 21539,
        "end": 21548
      },
      "text": "ལེགས་གནས་ ༼སྣར། པེ།༽ ལེགས་ནས་"
    },
    {
      "span": {
        "start": 21600,
        "end": 21607
      },
      "text": "བདེན་པ་ ༼སྣར།༽ བདེན་པས་"
    },
    {
      "span": {
        "start": 21676,
        "end": 21685
      },
      "text": "ཚངས་པ་ཡི་ ༼སྣར། པེ།༽ ཚངས་པ་ཡིས་"
    },
    {
      "span": {
        "start": 21722,
        "end": 21728
      },
      "text": "འཆད་པ་ ༼སྣར། པེ།༽ ཆད་པ་"
    },
    {
      "span": {
        "start": 21805,
        "end": 21812
      },
      "text": "དགའ་བར་ ༼སྣར། པེ།༽ དཀའ་བར་"
    },
    {
      "span": {
        "start": 21856,
        "end": 21864
      },
      "text": "རིགས་པར་ ༼སྣར། པེ།༽ རིག་པར་"
    },
    {
      "span": {
        "start": 22239,
        "end": 22249
      },
      "text": "ཆེན་པོ་ཡི། ༼སྣར། པེ།༽ ཆེན་པོ་ཡིས།"
    },
    {
      "span": {
        "start": 23088,
        "end": 23090
      },
      "text": "བ། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 23737,
        "end": 23742
      },
      "text": "མཛོད་ ༼སྣར།༽ འཛོད་"
    },
    {
      "span": {
        "start": 23840,
        "end": 23846
      },
      "text": "སྐྱོབ་ ༼སྣར།༽ སྐྱོབས་"
    },
    {
      "span": {
        "start": 23946,
        "end": 23954
      },
      "text": "མངའ་བའི་ ༼སྣར། པེ།༽ མངའ་བ་"
    },
    {
      "span": {
        "start": 23962,
        "end": 23967
      },
      "text": "དུང་། ༼སྣར།༽ གདུང་།"
    },
    {
      "span": {
        "start": 24051,
        "end": 24058
      },
      "text": "ཀུན་དུ། ༼སྣར། པེ།༽ ཀུན་ན།"
    },
    {
      "span": {
        "start": 24189,
        "end": 24195
      },
      "text": "དེ་ཚེ་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 24216,
        "end": 24223
      },
      "text": "ཇི་ལྟར་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 24280,
        "end": 24286
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 24292,
        "end": 24294
      },
      "text": "ན། ༼པེ།༽ ནས།"
    },
    {
      "span": {
        "start": 24666,
        "end": 24677
      },
      "text": "བསྒྲུབ་པའི་ ༼སྣར།༽ བསྒྲུབས་པའི་"
    },
    {
      "span": {
        "start": 24697,
        "end": 24703
      },
      "text": "སྒྱིད་ ༼སྣར། པེ།༽ བགྱིད་"
    },
    {
      "span": {
        "start": 24703,
        "end": 24707
      },
      "text": "ལུག་ ༼པེ།༽ ལུག་ས་"
    },
    {
      "span": {
        "start": 24911,
        "end": 24918
      },
      "text": "བྱས་ཏེ། ༼སྣར། པེ།༽ བྱ་སྟེ།"
    },
    {
      "span": {
        "start": 25210,
        "end": 25217
      },
      "text": "དཔག་ཏུ་ ༼སྣར། པེ།༽ དཔག་"
    },
    {
      "span": {
        "start": 25225,
        "end": 25228
      },
      "text": "དུ། ༼སྣར། པེ།༽ དུ་ནི།"
    },
    {
      "span": {
        "start": 25373,
        "end": 25384
      },
      "text": "ཅི་ཡི་ཕྱིར་ ༼སྣར།༽ ཇི་ལྟ་བུར་ ༼པེ།༽ ཇི་ལྟར་བུར་"
    },
    {
      "span": {
        "start": 26156,
        "end": 26162
      },
      "text": "སྒྱིད་ ༼སྣར། པེ།༽ བགྱིད་"
    },
    {
      "span": {
        "start": 26165,
        "end": 26170
      },
      "text": "ལུག ། ༼པེ།༽ ས། །"
    },
    {
      "span": {
        "start": 26474,
        "end": 26484
      },
      "text": "འཛིན་པ་ནི། ༼སྣར། པེ།༽ འཛིན་པ་ཡིས།"
    },
    {
      "span": {
        "start": 26518,
        "end": 26530
      },
      "text": "འཛིན་པ་སྤངས་ ༼སྣར། པེ།༽ འཛིན་པ་ཡང་"
    },
    {
      "span": {
        "start": 26639,
        "end": 26646
      },
      "text": "གནས་མལ་ ༼སྣར། པེ།༽ གནས་ལམ་"
    },
    {
      "span": {
        "start": 26697,
        "end": 26700
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 26786,
        "end": 26790
      },
      "text": "ཀྱང་ ༼སྣར། པེ།༽ ལ་རིན་པོ་ཆེ། །ཀུན་གྱིས་བརྒྱན་པ་"
    },
    {
      "span": {
        "start": 26799,
        "end": 26804
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 26891,
        "end": 26900
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 27097,
        "end": 27105
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 27138,
        "end": 27147
      },
      "text": "བསྟེན་པར་ ༼སྣར། པེ།༽ རྟེན་པར་"
    },
    {
      "span": {
        "start": 27278,
        "end": 27282
      },
      "text": "གཞན་ ༼སྣར།༽ བཞན་"
    },
    {
      "span": {
        "start": 27371,
        "end": 27373
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 27562,
        "end": 27568
      },
      "text": "སྩལ་བ་ ༼སྣར། པེ།༽ བརྩལ་བ་"
    },
    {
      "span": {
        "start": 27589,
        "end": 27594
      },
      "text": "སྤེལ་ ༼སྣར། པེ།༽ སྤལ་"
    },
    {
      "span": {
        "start": 27598,
        "end": 27605
      },
      "text": "སླད་དུ་ ༼སྣར། པེ།༽ ཐབས་སུ་"
    },
    {
      "span": {
        "start": 27691,
        "end": 27695
      },
      "text": "དག ། ༼སྣར། པེ།༽ །ཞི་"
    },
    {
      "span": {
        "start": 27695,
        "end": 27702
      },
      "text": "ཞིང་གི་ ༼སྣར། པེ།༽ ཞིང་"
    },
    {
      "span": {
        "start": 27716,
        "end": 27721
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 27723,
        "end": 27729
      },
      "text": "འགྲོན་ ༼སྣར། པེ།༽ འདྲོན་"
    },
    {
      "span": {
        "start": 27827,
        "end": 27832
      },
      "text": "གསོལ། ༼སྡེ།༽ སྩོལ།"
    },
    {
      "span": {
        "start": 27879,
        "end": 27887
      },
      "text": "འདུན་ཁང་ ༼སྣར། པེ།༽ མདུན་ཁང་"
    },
    {
      "span": {
        "start": 27941,
        "end": 27946
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 27953,
        "end": 27962
      },
      "text": "མགོན་མེད་ ༼སྣར།༽ མགོན་མེད་པ་"
    },
    {
      "span": {
        "start": 28054,
        "end": 28060
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 28506,
        "end": 28511
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 28618,
        "end": 28623
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 28659,
        "end": 28662
      },
      "text": "ཆུ་ ༼སྣར།༽ ཆུབ་"
    },
    {
      "span": {
        "start": 28731,
        "end": 28736
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 28780,
        "end": 28783
      },
      "text": "དང་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 28850,
        "end": 28857
      },
      "text": "གཙེས་པ་ ༼སྣར། པེ།༽ བཙེས་པ་"
    },
    {
      "span": {
        "start": 28993,
        "end": 29001
      },
      "text": "ཟས་ཀྱིས་ ༼སྣར། པེ།༽ ཟས་ཀྱི་"
    },
    {
      "span": {
        "start": 29009,
        "end": 29014
      },
      "text": "ཟུང་། ༼སྣར། པེ།༽ བཟུང་།"
    },
    {
      "span": {
        "start": 29016,
        "end": 29024
      },
      "text": "ནན་གྱིས་ ༼སྣར། པེ།༽ ནན་གྱི་"
    },
    {
      "span": {
        "start": 29044,
        "end": 29047
      },
      "text": "ཤས་ ༼ཅོ།༽ ཤེས་"
    },
    {
      "span": {
        "start": 29092,
        "end": 29098
      },
      "text": "བསྐྱབ་ ༼སྣར། པེ།༽ སྐྱབས་"
    },
    {
      "span": {
        "start": 29203,
        "end": 29211
      },
      "text": "གཞན་གྱི། ༼སྣར། པེ།༽ གཞན་གྱིས།"
    },
    {
      "span": {
        "start": 29298,
        "end": 29303
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 29806,
        "end": 29812
      },
      "text": "སྩལ་ན། ༼སྣར། པེ།༽ བསལ་ནས།"
    },
    {
      "span": {
        "start": 30215,
        "end": 30221
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 30341,
        "end": 30347
      },
      "text": "བཅད་ལ་ ༼སྣར། པེ།༽ བཅད་པ་"
    },
    {
      "span": {
        "start": 30354,
        "end": 30356
      },
      "text": "པ། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 30677,
        "end": 30686
      },
      "text": "བཟུང་རྣམ་ ༼སྣར། པེ།༽ གཟུང་རྣམ་"
    },
    {
      "span": {
        "start": 30877,
        "end": 30882
      },
      "text": "གནོད་ ༼སྣར། པེ།༽ གནས་"
    },
    {
      "span": {
        "start": 30937,
        "end": 30941
      },
      "text": "གཞན་ ༼སྣར།༽ བཞན་"
    },
    {
      "span": {
        "start": 31001,
        "end": 31008
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་ཞིག་"
    },
    {
      "span": {
        "start": 31071,
        "end": 31078
      },
      "text": "ནུས་པས་ ༼སྣར། པེ།༽ ནུས་པ་"
    },
    {
      "span": {
        "start": 31267,
        "end": 31282
      },
      "text": "སྡུག་བསྔལ་གཅིག་ ༼སྣར། པེ།༽ སྡུག་བསྔལ་ཅིག་"
    },
    {
      "span": {
        "start": 31491,
        "end": 31497
      },
      "text": "ན་ཡང་། ༼སྣར། པེ།༽ ནའང་དེ།"
    },
    {
      "span": {
        "start": 31531,
        "end": 31534
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 31956,
        "end": 31961
      },
      "text": "ཅིག ། ༼སྣར། པེ།༽ གཅིག །"
    },
    {
      "span": {
        "start": 31974,
        "end": 31980
      },
      "text": "འཆི་བ་ ༼སྣར། པེ།༽ འཆི་བའི་"
    },
    {
      "span": {
        "start": 32111,
        "end": 32119
      },
      "text": "ལྟོག་མོ་ ༼སྣར། པེ།༽ རྟོག་མོད་"
    },
    {
      "span": {
        "start": 32125,
        "end": 32134
      },
      "text": "ཆོས་ཀྱིས་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 32197,
        "end": 32210
      },
      "text": "སྐྱོན་མེད་པས། ༼སྣར། པེ།༽ སྐྱོན་མེད་པར།"
    },
    {
      "span": {
        "start": 32244,
        "end": 32248
      },
      "text": "སྲི་ ༼སྣར། པེ།༽ སྲིད་"
    },
    {
      "span": {
        "start": 32372,
        "end": 32381
      },
      "text": "རྩེ་གཅིག་ ༼སྣར། པེ།༽ རྩེ་ཅིག་"
    },
    {
      "span": {
        "start": 32387,
        "end": 32391
      },
      "text": "དེས། ༼སྣར། པེ།༽ སྟེ།"
    },
    {
      "span": {
        "start": 32461,
        "end": 32471
      },
      "text": "ཆོས་བསྟེན་ ༼སྣར། པེ།༽ མཆོད་རྟེན་"
    },
    {
      "span": {
        "start": 32504,
        "end": 32508
      },
      "text": "དག ། ༼ཅོ།༽ དང་། །"
    },
    {
      "span": {
        "start": 32550,
        "end": 32561
      },
      "text": "ཐང་ཅིག་གི ། ༼སྣར། པེ།༽ ཐང་གཅིག་གིས། །"
    },
    {
      "span": {
        "start": 32573,
        "end": 32575
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 32675,
        "end": 32685
      },
      "text": "མཚོན་གྱིས་ ༼སྣར། པེ།༽ མཚོན་གྱི་"
    },
    {
      "span": {
        "start": 32700,
        "end": 32706
      },
      "text": "འབད་པ་ ༼སྣར། པེ།༽ འབབ་པ་"
    },
    {
      "span": {
        "start": 32876,
        "end": 32882
      },
      "text": "བྱས་ན། ༼སྣར། པེ།༽ བྱས་ནས།"
    },
    {
      "span": {
        "start": 32974,
        "end": 32985
      },
      "text": "ཁྲིམས་ཀྱིས་ ༼སྣར། པེ།༽ ཁྲིམས་ཀྱི་"
    },
    {
      "span": {
        "start": 33286,
        "end": 33294
      },
      "text": "འཐོབ་པར་ ༼སྣར། པེ།༽ ཐོབ་པར་"
    },
    {
      "span": {
        "start": 33546,
        "end": 33556
      },
      "text": "མཆོག་རྟེན་ ༼སྣར། པེ།༽ མཆོད་རྟེན་"
    },
    {
      "span": {
        "start": 33615,
        "end": 33626
      },
      "text": "བྱིན་པ་ཡིས། ༼སྣར། པེ།༽ བྱིན་པ་ཡི།"
    },
    {
      "span": {
        "start": 33910,
        "end": 33913
      },
      "text": "ཉམ་ ༼སྣར།༽ ཉམས་"
    },
    {
      "span": {
        "start": 33936,
        "end": 33944
      },
      "text": "བཞོན་པས་ ༼སྣར། པེ།༽ གཞོན་པས་"
    },
    {
      "span": {
        "start": 34205,
        "end": 34213
      },
      "text": "འཐོབ་པར་ ༼སྣར།༽ འཐོག་པར་"
    },
    {
      "span": {
        "start": 34526,
        "end": 34530
      },
      "text": "རྟག་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 34805,
        "end": 34809
      },
      "text": "དགའ་ ༼སྣར། པེ།༽ དཀའ་"
    },
    {
      "span": {
        "start": 34913,
        "end": 34921
      },
      "text": "ཡང་བརྩེ་ ༼སྣར། པེ།༽ ཡང་རྩེ་"
    },
    {
      "span": {
        "start": 35332,
        "end": 35339
      },
      "text": "སློང་ལ་ ༼སྣར། པེ།༽ སློང་བ་"
    },
    {
      "span": {
        "start": 35374,
        "end": 35381
      },
      "text": "གྱུར་ན་ ༼སྣར། པེ།༽ གྱུར་ནས་"
    },
    {
      "span": {
        "start": 35401,
        "end": 35405
      },
      "text": "གཟོ་ ༼ཅོ།༽ བཟོ་ ༼སྣར། པེ།༽ བཟོད་"
    },
    {
      "span": {
        "start": 35466,
        "end": 35469
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 35488,
        "end": 35498
      },
      "text": "ལམ་བརྒྱགས་ ༼སྣར། པེ།༽ ལམ་རྒྱགས་"
    },
    {
      "span": {
        "start": 35528,
        "end": 35532
      },
      "text": "དྲན་ ༼སྣར། པེ།༽ བརྔན་"
    },
    {
      "span": {
        "start": 35555,
        "end": 35564
      },
      "text": "འགྱུར་ཏེ། ༼སྣར།༽ འགྱུར་ཁྱེདར་ཁྱེད ༼པེ།༽ ཁྱེ།"
    },
    {
      "span": {
        "start": 35990,
        "end": 35997
      },
      "text": "སྤྲོ་བ་ ༼སྣར། པེ།༽ སྤྲོ་བར་"
    },
    {
      "span": {
        "start": 36003,
        "end": 36008
      },
      "text": "བྱེད་ ༼ཅོ།༽ གྱེད་"
    },
    {
      "span": {
        "start": 36144,
        "end": 36151
      },
      "text": "འདོར་བ་ ༼སྣར། པེ།༽ མདོར་བ་"
    },
    {
      "span": {
        "start": 36325,
        "end": 36333
      },
      "text": "མ་སྦྱིན་ ༼སྣར། པེ།༽ མི་བྱིན་"
    },
    {
      "span": {
        "start": 36502,
        "end": 36510
      },
      "text": "རྣལ་གནས་ ༼སྣར། པེ།༽ རྣལ་ནས་"
    },
    {
      "span": {
        "start": 36530,
        "end": 36539
      },
      "text": "ཀུན་གྱིས་ ༼སྣར། པེ།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 36543,
        "end": 36547
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 36562,
        "end": 36572
      },
      "text": "རྐྱེན་གྱི་ ༼སྣར། པེ།༽ རྐྱེན་གྱིས་"
    },
    {
      "span": {
        "start": 36697,
        "end": 36700
      },
      "text": "སྔ་ ༼སྣར། པེ།༽ སྔར་"
    },
    {
      "span": {
        "start": 36713,
        "end": 36722
      },
      "text": "སྐྱོང་བར་ ༼སྣར། པེ།༽ བསྐྱང་བར་"
    },
    {
      "span": {
        "start": 37033,
        "end": 37041
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 37137,
        "end": 37141
      },
      "text": "གཟན་ ༼སྣར། པེ།༽ ཟན་"
    },
    {
      "span": {
        "start": 37238,
        "end": 37242
      },
      "text": "སྡང་ ༼སྣར། པེ།༽ བསྔར་"
    },
    {
      "span": {
        "start": 37291,
        "end": 37299
      },
      "text": "བློན་པོ་ ༼སྣར། པེ།༽ བློན་པོས་"
    },
    {
      "span": {
        "start": 37412,
        "end": 37417
      },
      "text": "སྐོས། ༼སྣར། པེ།༽ བསྐོས།"
    },
    {
      "span": {
        "start": 37440,
        "end": 37444
      },
      "text": "གཟོ། ༼སྣར། པེ།༽ བཟོ།"
    },
    {
      "span": {
        "start": 37648,
        "end": 37657
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 37826,
        "end": 37836
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 38009,
        "end": 38015
      },
      "text": "བརྡེག་ ༼སྣར།༽ བསྡེག་ ༼པེ།༽ བསྡེག་ས་"
    },
    {
      "span": {
        "start": 38038,
        "end": 38051
      },
      "text": "ཀྱིས་མི་བགྱི་ ༼སྣར།༽ ཀྱི་མིག་གྱི་ ༼པེ།༽ ཀྱི་མི་བགྱི་"
    },
    {
      "span": {
        "start": 38104,
        "end": 38112
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 38133,
        "end": 38143
      },
      "text": "བྱེད་པ་ཡི། ༼པེ།༽ བྱེད་པ་ཡིས།"
    },
    {
      "span": {
        "start": 38180,
        "end": 38190
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 38226,
        "end": 38232
      },
      "text": "སྐྱེད། ༼སྣར།༽ བསྐྱེད།"
    },
    {
      "span": {
        "start": 38306,
        "end": 38313
      },
      "text": "དེ་བདག་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 38413,
        "end": 38419
      },
      "text": "ལྷག་མ་ ༼སྣར། པེ།༽ ལྷག་པ་"
    },
    {
      "span": {
        "start": 38424,
        "end": 38428
      },
      "text": "ཀྱང་ ༼སྣར།༽ བྱང་"
    },
    {
      "span": {
        "start": 38489,
        "end": 38493
      },
      "text": "གཏང་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 38766,
        "end": 38770
      },
      "text": "གཅད་ ༼སྣར། པེ།༽ བཅད་"
    },
    {
      "span": {
        "start": 38869,
        "end": 38873
      },
      "text": "གསད་ ༼སྣར། པེ།༽ བསད་"
    },
    {
      "span": {
        "start": 38909,
        "end": 38915
      },
      "text": "དག་ཏུ་ ༼སྣར། པེ།༽ གང་དུ་"
    },
    {
      "span": {
        "start": 39213,
        "end": 39225
      },
      "text": "གྱུར་ཅིང་། ། ༼སྣར།༽ གྱུར་ཅིག །"
    },
    {
      "span": {
        "start": 39270,
        "end": 39279
      },
      "text": "བསྟེན་པར་ ༼སྣར། པེ།༽ བརྟེན་པར་"
    },
    {
      "span": {
        "start": 39410,
        "end": 39415
      },
      "text": "དཔྱད་ ༼སྣར། པེ།༽ སྤྱད་"
    },
    {
      "span": {
        "start": 39441,
        "end": 39446
      },
      "text": "འགོད་ ༼སྣར། པེ།༽ འདོད་"
    },
    {
      "span": {
        "start": 39579,
        "end": 39588
      },
      "text": "ཆོས་ཀྱིས་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 40039,
        "end": 40046
      },
      "text": "བཅོས་མ་ ༼སྣར། པེ།༽ བཅོས་པ་"
    },
    {
      "span": {
        "start": 40154,
        "end": 40159
      },
      "text": "བཅོས་ ༼སྣར།༽ བཅོམ་"
    },
    {
      "span": {
        "start": 40384,
        "end": 40389
      },
      "text": "གྲག ། ༼སྣར། པེ།༽ གྲགས། །"
    },
    {
      "span": {
        "start": 40733,
        "end": 40735
      },
      "text": "ན། ༼སྣར།༽ ནི།"
    },
    {
      "span": {
        "start": 41037,
        "end": 41045
      },
      "text": "དེ་གཉིས་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 41134,
        "end": 41144
      },
      "text": "འཇིག་བྱེད་ ༼སྣར། པེ།༽ འཛིན་བྱེད་"
    },
    {
      "span": {
        "start": 41178,
        "end": 41186
      },
      "text": "དེ་ལྟའི་ ༼སྣར། པེ།༽ ད་ལྟའི་"
    },
    {
      "span": {
        "start": 41368,
        "end": 41372
      },
      "text": "མེར་ ༼སྣར།༽ མེད་ ༼པེ།༽ མེ་"
    },
    {
      "span": {
        "start": 41753,
        "end": 41761
      },
      "text": "འབྱུང་བ་ ༼པེ།༽ བྱུང་བ་"
    },
    {
      "span": {
        "start": 41912,
        "end": 41919
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 42386,
        "end": 42421
      },
      "text": "སྐྱོན་དག་མི་ཤེས་པའམ། །ཡོན་ཏན་སྐྱོན་ ༼སྣར། པེ།༽ སྐྱོན་"
    },
    {
      "span": {
        "start": 42482,
        "end": 42487
      },
      "text": "གྲངས། ༼སྡེ། ཅོ།༽ གྲང་།"
    },
    {
      "span": {
        "start": 42692,
        "end": 42701
      },
      "text": "བསྲེག་པར་ ༼སྣར། པེ།༽ བསྲེགས་པར་"
    },
    {
      "span": {
        "start": 42774,
        "end": 42780
      },
      "text": "བསྲེག་ ༼སྣར། པེ།༽ བསྲེགས་"
    },
    {
      "span": {
        "start": 42821,
        "end": 42829
      },
      "text": "དུག་གིས་ ༼སྣར། པེ།༽ དུག་གི་"
    },
    {
      "span": {
        "start": 42836,
        "end": 42840
      },
      "text": "བསལ་ ༼སྣར། པེ།༽ གསལ་"
    },
    {
      "span": {
        "start": 42907,
        "end": 42914
      },
      "text": "བསལ་བར་ ༼སྣར། པེ།༽ གསལ་བར་"
    },
    {
      "span": {
        "start": 42914,
        "end": 42919
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 42941,
        "end": 42949
      },
      "text": "སྔོན་དུ་ ༼སྣར།༽ སྔོན་བུ་"
    },
    {
      "span": {
        "start": 43015,
        "end": 43024
      },
      "text": "ཡིད་ཀྱིས། ༼སྣར། པེ།༽ ཡིད་ཀྱང་།"
    },
    {
      "span": {
        "start": 43054,
        "end": 43060
      },
      "text": "བདེའང་ ༼སྣར། པེ།༽ བདེ་བའང་"
    },
    {
      "span": {
        "start": 43181,
        "end": 43185
      },
      "text": "བཏང་ ༼སྣར། པེ།༽ གཏང་"
    },
    {
      "span": {
        "start": 43227,
        "end": 43239
      },
      "text": "བདེ་ཆེན་ཡངས་ ༼སྣར། པེ།༽ བདེ་ཆེན་ཡང་"
    },
    {
      "span": {
        "start": 43497,
        "end": 43503
      },
      "text": "ཐེག་པ་ ༼པེ།༽ ཐེགས་པ་"
    },
    {
      "span": {
        "start": 43550,
        "end": 43556
      },
      "text": "དང་། ། ༼ཅོ།༽ དག །"
    },
    {
      "span": {
        "start": 43803,
        "end": 43806
      },
      "text": "དེ་ ༼སྣར།༽ ད་"
    },
    {
      "span": {
        "start": 43820,
        "end": 43826
      },
      "text": "ལ་ཉེས་ ༼སྣར།༽ ལས་ཉེས་"
    },
    {
      "span": {
        "start": 43896,
        "end": 43908
      },
      "text": "བདག་ཉིད་ཀྱི། ༼སྣར། པེ།༽ བདག་ཉིད་ཀྱིས།"
    },
    {
      "span": {
        "start": 43995,
        "end": 44000
      },
      "text": "མདོར་ ༼སྣར། པེ།༽ མདོར་ན་"
    },
    {
      "span": {
        "start": 44014,
        "end": 44025
      },
      "text": "དེ་དག་ནི། ། ༼སྣར། པེ།༽ དེ་དག །"
    },
    {
      "span": {
        "start": 44309,
        "end": 44318
      },
      "text": "བཟོད་ཀྱི། ༼པེ།༽ བཟོད་ཀྱིས།"
    },
    {
      "span": {
        "start": 44327,
        "end": 44329
      },
      "text": "ཤ་ ༼སྣར། པེ།༽ ཤཱ་"
    },
    {
      "span": {
        "start": 44331,
        "end": 44334
      },
      "text": "དྭ་ ༼སྣར། པེ།༽ དྭཱ་"
    },
    {
      "span": {
        "start": 44589,
        "end": 44594
      },
      "text": "བལྟས་ ༼སྣར། པེ།༽ ལྷས་"
    },
    {
      "span": {
        "start": 44695,
        "end": 44698
      },
      "text": "བླ་ ༼སྣར། པེ།༽ སླ་"
    },
    {
      "span": {
        "start": 45635,
        "end": 45642
      },
      "text": "འཕྲིགས་ ༼སྣར། པེ།༽ འཁྲིག་"
    },
    {
      "span": {
        "start": 45696,
        "end": 45704
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 46033,
        "end": 46038
      },
      "text": "བསྟན་ ༼སྣར། པེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 46070,
        "end": 46075
      },
      "text": "སྲུན་ ༼སྣར། པེ།༽ བསྲུན་"
    },
    {
      "span": {
        "start": 46141,
        "end": 46151
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 46327,
        "end": 46331
      },
      "text": "གཏན་ ༼སྣར། པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 46475,
        "end": 46484
      },
      "text": "འཁྲུགས་པ་ ༼སྣར། པེ།༽ འཁྲུག་པ་"
    },
    {
      "span": {
        "start": 46584,
        "end": 46590
      },
      "text": "སླུ་བ་ ༼སྣར། པེ།༽ བསླུ་བ་"
    },
    {
      "span": {
        "start": 46781,
        "end": 46786
      },
      "text": "བསླད་ ༼སྣར། པེ།༽ སླད་"
    },
    {
      "span": {
        "start": 46886,
        "end": 46894
      },
      "text": "ཕྱེ་སྟེ་ ༼སྣར། པེ།༽ ཕྱེ་དེ་"
    },
    {
      "span": {
        "start": 47048,
        "end": 47058
      },
      "text": "གང་ཡིན་དེ། ༼སྣར། པེ།༽ གང་ཡིན་ཏེ།"
    },
    {
      "span": {
        "start": 47448,
        "end": 47455
      },
      "text": "ཉིད་དོ་ ༼སྣར། པེ།༽ ཉིད་དུ་"
    },
    {
      "span": {
        "start": 47547,
        "end": 47552
      },
      "text": "འཆོས་ ༼སྣར། པེ།༽ ཆོས་"
    },
    {
      "span": {
        "start": 47585,
        "end": 47590
      },
      "text": "སྡོམ་ ༼སྣར།༽ སྡོམས་"
    },
    {
      "span": {
        "start": 47631,
        "end": 47636
      },
      "text": "ཕྱིར། ༼སྣར། པེ།༽ ཆོས།"
    },
    {
      "span": {
        "start": 47696,
        "end": 47704
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 47716,
        "end": 47725
      },
      "text": "བྱེད་པའོ། ༼སྣར། པེ།༽ བྱེད་པ།"
    },
    {
      "span": {
        "start": 47727,
        "end": 47736
      },
      "text": "ཐོབ་ཀྱིས་ ༼སྣར། པེ།༽ ཐོབ་ཀྱི་"
    },
    {
      "span": {
        "start": 47802,
        "end": 47806
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 48199,
        "end": 48207
      },
      "text": "སྐྱེ་བོ་ ༼སྣར། པེ།༽ སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 48210,
        "end": 48216
      },
      "text": "པ་ཡིན་ ༼སྣར། པེ།༽ པར་ཡོད་"
    },
    {
      "span": {
        "start": 48276,
        "end": 48281
      },
      "text": "བྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 48961,
        "end": 48969
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 48995,
        "end": 49004
      },
      "text": "དོགས་པའོ། ༼སྣར། པེ།༽ དགོངས་པ།"
    },
    {
      "span": {
        "start": 49011,
        "end": 49019
      },
      "text": "རྣམ་རིག་ ༼སྣར། པེ།༽ རྣམས་རིགས་"
    },
    {
      "span": {
        "start": 49026,
        "end": 49031
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟག་"
    },
    {
      "span": {
        "start": 49205,
        "end": 49214
      },
      "text": "དང་མི་ཕན་ ༼སྣར། པེ།༽ དང་མི་"
    },
    {
      "span": {
        "start": 49263,
        "end": 49273
      },
      "text": "རྙོགས་པའི་ ༼སྣར། པེ།༽ བསྙོགས་པའི་"
    },
    {
      "span": {
        "start": 49286,
        "end": 49292
      },
      "text": "སྙམ་པ་ ༼སྣར། པེ།༽ སྙོམས་པ་"
    },
    {
      "span": {
        "start": 49398,
        "end": 49401
      },
      "text": "ཟས་ ༼སྣར། པེ།༽ ཟད་"
    },
    {
      "span": {
        "start": 49415,
        "end": 49420
      },
      "text": "དྲགས་ ༼སྣར། པེ།༽ གྲགས་"
    },
    {
      "span": {
        "start": 49500,
        "end": 49505
      },
      "text": "བསྟན། ༼སྣར། པེ།༽ བརྟན།"
    },
    {
      "span": {
        "start": 49530,
        "end": 49532
      },
      "text": "པ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 49571,
        "end": 49577
      },
      "text": "དག་དང་ ༼སྣར།༽ བདག་དྲང་ ༼པེ།༽ བདག་དང་"
    },
    {
      "span": {
        "start": 49644,
        "end": 49649
      },
      "text": "དོགས་ ༼སྣར། པེ།༽ དོག་"
    },
    {
      "span": {
        "start": 49657,
        "end": 49666
      },
      "text": "དོགས་པའི་ ༼ཅོ།༽ དགས་པའི་"
    },
    {
      "span": {
        "start": 49912,
        "end": 49916
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 49977,
        "end": 49985
      },
      "text": "ཅན་གྱིས་ ༼སྣར། པེ།༽ ཅན་གྱི་"
    },
    {
      "span": {
        "start": 50020,
        "end": 50022
      },
      "text": "བ། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 50046,
        "end": 50052
      },
      "text": "བསྟེན། ༼སྣར། པེ།༽ བརྟེན།"
    },
    {
      "span": {
        "start": 50067,
        "end": 50079
      },
      "text": "སེམས་དཔའ་ཡི། ༼སྣར། པེ།༽ སེམས་དཔའ་ཡིས།"
    },
    {
      "span": {
        "start": 50093,
        "end": 50098
      },
      "text": "བསྟན་ ༼སྣར། པེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 50357,
        "end": 50363
      },
      "text": "བརྩེས་ ༼སྣར། པེ།༽ བརྩེ་"
    },
    {
      "span": {
        "start": 50433,
        "end": 50444
      },
      "text": "ཁྲིམས་ཀྱིས་ ༼སྣར། པེ།༽ ཁྲིམས་ཀྱི་"
    },
    {
      "span": {
        "start": 50547,
        "end": 50555
      },
      "text": "བདུན་པོ་ ༼སྣར།༽ བདུག་པ་"
    },
    {
      "span": {
        "start": 50577,
        "end": 50580
      },
      "text": "ཅར་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 51687,
        "end": 51699
      },
      "text": "འཐབ་བྲལ་གནས་ ༼སྣར། པེ།༽ འཐབ་བྲལ་ནས་"
    },
    {
      "span": {
        "start": 51715,
        "end": 51720
      },
      "text": "འཇིག་ ༼སྣར། པེ།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 51800,
        "end": 51809
      },
      "text": "ཀུན་གྱིས་ ༼སྣར། པེ།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 51816,
        "end": 51825
      },
      "text": "ཐུབ་དཀའི་ ༼པེ།༽ ཐུབ་དཀའ་"
    },
    {
      "span": {
        "start": 51832,
        "end": 51841
      },
      "text": "འཕགས་པའི་ ༼པེ།༽ འཕགས་པ་"
    },
    {
      "span": {
        "start": 51955,
        "end": 51961
      },
      "text": "སྟེགས་ ༼སྣར།༽ རྟེབས་"
    },
    {
      "span": {
        "start": 51993,
        "end": 51997
      },
      "text": "གནས་ ༼སྣར།༽ གན་"
    },
    {
      "span": {
        "start": 52013,
        "end": 52020
      },
      "text": "དྲུག་ལ་ ༼སྣར། པེ།༽ དྲུག་པ་"
    },
    {
      "span": {
        "start": 52025,
        "end": 52035
      },
      "text": "ཕྱོགས་ཤེས་ ༼སྣར། པེ།༽ ཕྱོགས་ཞེས་"
    },
    {
      "span": {
        "start": 52093,
        "end": 52100
      },
      "text": "གོམས་པ་ ༼སྣར། པེ།༽ གོམ་པ་"
    },
    {
      "span": {
        "start": 52106,
        "end": 52113
      },
      "text": "འགོག་པ་ ༼ཅོ།༽ འགོགས་པ་"
    },
    {
      "span": {
        "start": 52437,
        "end": 52452
      },
      "text": "མངོན་རྟོགས་ཤེས་ ༼སྣར། པེ།༽ མངོན་རྟོགས་ཞེས་"
    },
    {
      "span": {
        "start": 52713,
        "end": 52715
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 52792,
        "end": 52798
      },
      "text": "སོ་སོ་ ༼སྣར། པེ།༽ སོ་སོར་"
    },
    {
      "span": {
        "start": 53332,
        "end": 53338
      },
      "text": "ལྡན་པ་ ༼སྣར། པེ།༽ ལྟ་བ་"
    },
    {
      "span": {
        "start": 55025,
        "end": 55032
      },
      "text": "འཆད་པར་ ༼སྣར། པེ།༽ ཆད་པར་"
    },
    {
      "span": {
        "start": 55322,
        "end": 55334
      },
      "text": "སྐྱེ་བོ་ཀུན། ༼སྣར། པེ།༽ སྐྱོ་བ་རྣམས།"
    },
    {
      "span": {
        "start": 55463,
        "end": 55469
      },
      "text": "རྣལ་མ་ ༼སྣར། པེ།༽ སྣལ་མ་"
    },
    {
      "span": {
        "start": 55469,
        "end": 55473
      },
      "text": "དང་། ༼སྣར། པེ།༽ རྣམས།"
    },
    {
      "span": {
        "start": 55631,
        "end": 55633
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 55794,
        "end": 55803
      },
      "text": "སངས་རྒྱས་ ༼སྣར། པེ།༽ སེམས་ཅན་"
    },
    {
      "span": {
        "start": 55871,
        "end": 55875
      },
      "text": "ཕངས། ༼སྣར། པེ།༽ འཕངས།"
    },
    {
      "span": {
        "start": 56349,
        "end": 56359
      },
      "text": "གང་ཡིན་དེ། ༼སྣར། པེ།༽ གང་ཡིན་ཏེ།"
    },
    {
      "span": {
        "start": 56542,
        "end": 56548
      },
      "text": "བསྟེན། ༼སྣར། པེ།༽ བརྟེན།"
    },
    {
      "span": {
        "start": 56565,
        "end": 56572
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབས་"
    },
    {
      "span": {
        "start": 56572,
        "end": 56603
      },
      "text": "པ་དང་། །སྒྲུབ་པ་བཞིན་དུ་ཤེས་རབ་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 56630,
        "end": 56636
      },
      "text": "བསྟེན། ༼སྣར། པེ།༽ བརྟེན།"
    },
    {
      "span": {
        "start": 56737,
        "end": 56742
      },
      "text": "གསོན། ༼སྣར། པེ།༽ སོན།"
    },
    {
      "span": {
        "start": 56771,
        "end": 56779
      },
      "text": "སྤོབས་ལ་ ༼སྣར། པེ།༽ སྤོབས་པ་"
    },
    {
      "span": {
        "start": 56999,
        "end": 57005
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 57009,
        "end": 57019
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 57025,
        "end": 57029
      },
      "text": "གྱི་ ༼སྣར། པེ།༽ གྱིས་"
    },
    {
      "span": {
        "start": 57073,
        "end": 57083
      },
      "text": "གྲུབ་པ་ཡི་ ༼སྣར། པེ།༽ གྲུབ་པ་ཡིས་"
    },
    {
      "span": {
        "start": 57178,
        "end": 57183
      },
      "text": "གསོད་ ༼སྣར། པེ།༽ བསོད་"
    },
    {
      "span": {
        "start": 57369,
        "end": 57371
      },
      "text": "ཉ་ ༼སྣར། པེ།༽ ཉི་"
    },
    {
      "span": {
        "start": 57435,
        "end": 57440
      },
      "text": "བརྟན་ ༼སྣར།༽ བསྟན་"
    },
    {
      "span": {
        "start": 57487,
        "end": 57498
      },
      "text": "གྱིས་བརྒྱན་ ༼སྣར། པེ།༽ གྱི་རྒྱན་"
    },
    {
      "span": {
        "start": 57610,
        "end": 57617
      },
      "text": "བས་ཀྱི། ༼སྣར། པེ།༽ བས་ཀྱིས།"
    },
    {
      "span": {
        "start": 57727,
        "end": 57732
      },
      "text": "བགྱི་ ༼སྣར། པེ།༽ བགྱིའི་"
    },
    {
      "span": {
        "start": 57829,
        "end": 57837
      },
      "text": "བཟོད་དང་ ༼སྣར། པེ།༽ བཟོད་"
    },
    {
      "span": {
        "start": 57958,
        "end": 57963
      },
      "text": "བཟུང་ ༼སྣར།༽ གཟུང་"
    },
    {
      "span": {
        "start": 57975,
        "end": 57983
      },
      "text": "དོན་ཆོས་ ༼སྣར། པེ།༽ དམ་ཆོས་"
    },
    {
      "span": {
        "start": 58089,
        "end": 58094
      },
      "text": "ལེའུ་ ༼སྣར། པེ།༽ ལེའུ་བསྟན་པ་"
    },
    {
      "span": {
        "start": 58326,
        "end": 58335
      },
      "text": "སླད་ཀྱིས་ ༼སྣར། པེ།༽ སླད་ཀྱི་"
    },
    {
      "span": {
        "start": 58441,
        "end": 58447
      },
      "text": "པའོ། ། ༼སྣར། པེ།༽ ། །འདིས་ཀྱང་འཁོར་བ་སྡུག་བསྔལ་གྱི་རྒྱ་མཚོ་སྐམ་ནུས་པར་གྱུར་ཅིག་"
    }
  ]
}