{
  "durchens": [
    {
      "span": {
        "start": 55,
        "end": 66
      },
      "text": "བསྒྲུབ་སྟེ་ ༼སྣར། པེ།༽ བསྒྲུབས་ཏེ་"
    },
    {
      "span": {
        "start": 438,
        "end": 445
      },
      "text": "བསྒྱུར་ ༼སྣར། པེ།༽ སྒྱུར་"
    },
    {
      "span": {
        "start": 489,
        "end": 497
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 507,
        "end": 512
      },
      "text": "འགུལ་ ༼སྣར། པེ།༽ མགུལ་"
    },
    {
      "span": {
        "start": 561,
        "end": 570
      },
      "text": "བརྒྱལ་བར་ ༼སྣར། པེ།༽ རྒྱལ་བར་"
    },
    {
      "span": {
        "start": 610,
        "end": 616
      },
      "text": "ཧེ་ཏུ་ ༼སྣར། པེ།༽ ཧེ་དུ་"
    },
    {
      "span": {
        "start": 740,
        "end": 748
      },
      "text": "གཅན་གཟན་ ༼སྣར། པེ།༽ གཅན་ཟན་"
    },
    {
      "span": {
        "start": 763,
        "end": 775
      },
      "text": "ཚོགས་བསྒྲུབ་ ༼སྣར། པེ།༽ ཚོགས་སྒྲུབ་"
    },
    {
      "span": {
        "start": 804,
        "end": 817
      },
      "text": "དབང་པོ་ལྔ་ལས་ ༼སྣར། པེ།༽ དབང་པོ་ལ་"
    },
    {
      "span": {
        "start": 860,
        "end": 872
      },
      "text": "གྱིས་བསྒྱུར་ ༼སྣར། པེ།༽ གྱི་སྒྱུར་"
    },
    {
      "span": {
        "start": 1001,
        "end": 1007
      },
      "text": "བཅིངས་ ༼སྣར། པེ།༽ བཅིང་"
    },
    {
      "span": {
        "start": 1063,
        "end": 1068
      },
      "text": "གཏིག་ ༼སྣར། པེ།༽ ཏིག་"
    },
    {
      "span": {
        "start": 1097,
        "end": 1100
      },
      "text": "ཤོ་ ༼སྣར། པེ།༽ ཤོད་"
    },
    {
      "span": {
        "start": 1155,
        "end": 1160
      },
      "text": "འགུལ་ ༼སྣར། པེ།༽ མགུལ་"
    },
    {
      "span": {
        "start": 1174,
        "end": 1179
      },
      "text": "གྲིས་ ༼སྣར། པེ།༽ གྲི་"
    },
    {
      "span": {
        "start": 1188,
        "end": 1194
      },
      "text": "གཏུབས་ ༼སྣར། པེ།༽ བཏུབས་"
    },
    {
      "span": {
        "start": 1259,
        "end": 1264
      },
      "text": "སྐྲག་ ༼སྣར། པེ།༽ བཀྲག་"
    },
    {
      "span": {
        "start": 1470,
        "end": 1487
      },
      "text": "མགོ་མཇུག་བརྒྱན་པ་ ༼སྣར། པེ།༽ མགོ་འཇུག་བརྒྱན་"
    },
    {
      "span": {
        "start": 1584,
        "end": 1592
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 1697,
        "end": 1708
      },
      "text": "སྟེ་མ་རུངས་ ༼སྣར། པེ།༽ དེ་མཚུངས་"
    },
    {
      "span": {
        "start": 1737,
        "end": 1740
      },
      "text": "ཚན་ ༼སྣར། པེ།༽ མཚན་"
    },
    {
      "span": {
        "start": 1743,
        "end": 1753
      },
      "text": "སྒྲུབ་སྟེ། ༼སྣར། པེ།༽ བསྒྲུབས་ཏེ།"
    },
    {
      "span": {
        "start": 1796,
        "end": 1807
      },
      "text": "བསྒྲུབ་པའི་ ༼སྣར། པེ།༽ སྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 1889,
        "end": 1895
      },
      "text": "ཕྱེ་མ་ ༼སྣར། པེ།༽ ཕྱེ་"
    },
    {
      "span": {
        "start": 2009,
        "end": 2014
      },
      "text": "བསྲི་ ༼སྣར། པེ།༽ སྤྲི་"
    },
    {
      "span": {
        "start": 2200,
        "end": 2206
      },
      "text": "ཐོན་པ་ ༼སྣར། པེ།༽ འཐོན་པ་"
    },
    {
      "span": {
        "start": 2209,
        "end": 2215
      },
      "text": "བསྟུན་ ༼སྣར། པེ།༽ བཏུད་"
    },
    {
      "span": {
        "start": 2317,
        "end": 2323
      },
      "text": "འགལ་བ་ ༼སྣར། པེ།༽ མགལ་བ་"
    }
  ]
}