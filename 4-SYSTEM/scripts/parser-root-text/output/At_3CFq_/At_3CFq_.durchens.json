      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ ཏོག་"
    },
    {
      "span": {
        "start": 235,
        "end": 239
      },
      "text": "ཚུལ། ༼སྣར། པེ།༽ ཆུ།"
    },
    {
      "span": {
        "start": 323,
        "end": 329
      },
      "text": "གསང་བ། ༼སྣར། པེ།༽ གསང་བ་ཡིས།"
    },
    {
      "span": {
        "start": 524,
        "end": 527
      },
      "text": "ཀྲ་ ༼པེ།༽ ཀྱ་"
    },
    {
      "span": {
        "start": 573,
        "end": 575
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལ་ཕབ་པ་རྫོགས་སོ།"
    }
  ]
}