{
  "durchens": [
    {
      "span": {
        "start": 275,
        "end": 284
      },
      "text": "མེད་སྲེད་ ༼སྣར། པེ།༽ མེས་བསྲེགས་"
    },
    {
      "span": {
        "start": 773,
        "end": 787
      },
      "text": "ལས་ལྷག་མ་རྣམས་ ༼སྣར། པེ།༽ ལས་གཞན་པ་"
    },
    {
      "span": {
        "start": 803,
        "end": 812
      },
      "text": "བསྡོམ་པར་ ༼སྣར། པེ།༽ བསྡམ་པར་"
    },
    {
      "span": {
        "start": 829,
        "end": 836
      },
      "text": "སྤྱད་པ་ ༼པེ།༽ སྤྱད་པ་པ་"
    },
    {
      "span": {
        "start": 874,
        "end": 884
      },
      "text": "དེ་དག་གིས་ ༼སྣར། པེ།༽ དེ་དག་གི་"
    },
    {
      "span": {
        "start": 1219,
        "end": 1224
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 1307,
        "end": 1311
      },
      "text": "འདི་ ༼སྣར།༽ འདིས་"
    },
    {
      "span": {
        "start": 1342,
        "end": 1348
      },
      "text": "མཆིའོ་ ༼པེ།༽ འཆིའོ་"
    },
    {
      "span": {
        "start": 1436,
        "end": 1445
      },
      "text": "དགེ་འདུན་ ༼སྣར། པེ།༽ དགེ་འདུན་རྣམས་"
    },
    {
      "span": {
        "start": 1469,
        "end": 1477
      },
      "text": "རྒལ་བའི་ ༼སྣར། པེ།༽ བརྒལ་བའི་"
    },
    {
      "span": {
        "start": 1735,
        "end": 1737
      },
      "text": "པ་ ༼སྣར། པེ།༽ ཤིང་འཆི་བ་"
    },
    {
      "span": {
        "start": 1771,
        "end": 1775
      },
      "text": "བདག་ ༼སྣར།༽ དག་"
    },
    {
      "span": {
        "start": 1783,
        "end": 1788
      },
      "text": "བཅོམ་ ༼སྣར། པེ།༽ ཏུ་བཅོམས་"
    },
    {
      "span": {
        "start": 1830,
        "end": 1835
      },
      "text": "བཙོན་ ༼པེ།༽ གཙོན་"
    },
    {
      "span": {
        "start": 2318,
        "end": 2327
      },
      "text": "བཏབ་པོ། ། ༼སྣར། པེ།༽ བཏབ་། །དེས་ན་"
    },
    {
      "span": {
        "start": 2335,
        "end": 2339
      },
      "text": "གྱི་ ༼སྣར། པེ།༽ གྱིས་"
    },
    {
      "span": {
        "start": 2432,
        "end": 2441
      },
      "text": "ནོ་ཞེས་པ་ ༼སྣར། པེ།༽ ནོ་ཞེས་"
    },
    {
      "span": {
        "start": 2463,
        "end": 2471
      },
      "text": "དེ་བཞིན་ ༼སྣར། པེ།༽ དེ་བཞིན་གཤེགས་པ་ནི་ཆོས་རྣམས་ཀྱི་དེ་བཞིན་"
    },
    {
      "span": {
        "start": 2475,
        "end": 2484
      },
      "text": "རྟོག་པའམ་ ༼སྣར། པེ།༽ རྟོགས་པའམ་"
    },
    {
      "span": {
        "start": 2488,
        "end": 2496
      },
      "text": "ངེས་པའོ། ༼སྣར། པེ།༽ སོང་བའོ།"
    },
    {
      "span": {
        "start": 2978,
        "end": 2986
      },
      "text": "བྱུང་བས་ ༼པེ།༽ འབྱུང་བས་"
    },
    {
      "span": {
        "start": 3215,
        "end": 3223
      },
      "text": "མཚན་ཉིད་ ༼སྣར། པེ།༽ མཚན་གྱི་"
    },
    {
      "span": {
        "start": 3267,
        "end": 3274
      },
      "text": "བཤད་པར་ ༼སྣར། པེ།༽ བཤགས་པར་"
    },
    {
      "span": {
        "start": 3693,
        "end": 3700
      },
      "text": "མཐུན་པ་ ༼སྣར། པེ།༽ འཐུན་པ་"
    },
    {
      "span": {
        "start": 3936,
        "end": 3944
      },
      "text": "ཉི་མིའི་ ༼སྣར། པེ།༽ ཉི་མའི་"
    },
    {
      "span": {
        "start": 4013,
        "end": 4017
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ ཉེ་བར་གནས་"
    },
    {
      "span": {
        "start": 4057,
        "end": 4068
      },
      "text": "དེས་ན་དཀོན་ ༼སྣར། པེ།༽ དེ་ནས་ཀོན་"
    },
    {
      "span": {
        "start": 4152,
        "end": 4156
      },
      "text": "འཆར། ༼སྣར།༽ འཆང་།"
    },
    {
      "span": {
        "start": 4200,
        "end": 4206
      },
      "text": "སོ་སོ་ ༼སྣར། པེ།༽ སོ་སོར་"
    },
    {
      "span": {
        "start": 4257,
        "end": 4265
      },
      "text": "བསྟན་ཏོ། ༼སྣར། པེ།༽ བསྟན་ཏེ།"
    },
    {
      "span": {
        "start": 4632,
        "end": 4636
      },
      "text": "གཞན་ ༼སྣར། པེ།༽ གཞན་ལ་བྱེད་དུ་བཅུག་པ་ནི་"
    },
    {
      "span": {
        "start": 4713,
        "end": 4722
      },
      "text": "ལྕི་བ་ནི་ ༼སྣར།༽ ལྕི་བའི་"
    },
    {
      "span": {
        "start": 4911,
        "end": 4920
      },
      "text": "དགེ་འདུན་ ༼སྣར།༽ དགེ་འདུན་པ་"
    },
    {
      "span": {
        "start": 4927,
        "end": 4936
      },
      "text": "དབང་བ་དང་ ༼སྣར། པེ།༽ དབང་བ་"
    },
    {
      "span": {
        "start": 4950,
        "end": 4958
      },
      "text": "བདག་གིར་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 5038,
        "end": 5048
      },
      "text": "སྡུག་བསྔལ་ ༼སྣར།༽ བསྔལ་"
    },
    {
      "span": {
        "start": 5074,
        "end": 5079
      },
      "text": "སྦྱང་ ༼སྣར། པེ།༽ སྦྱང་བ་"
    },
    {
      "span": {
        "start": 5160,
        "end": 5172
      },
      "text": "ལས་ཞེས་བྱ་བ་ ༼སྣར།༽ ལས་ཞེས་པ་"
    },
    {
      "span": {
        "start": 5314,
        "end": 5317
      },
      "text": "ལས་ ༼སྣར།༽ ལ་"
    },
    {
      "span": {
        "start": 5340,
        "end": 5349
      },
      "text": "འགྱུར་བར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 5563,
        "end": 5570
      },
      "text": "སྨིན་པ་ ༼སྣར། པེ།༽ སྨིན་པར་"
    },
    {
      "span": {
        "start": 5599,
        "end": 5603
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 5784,
        "end": 5795
      },
      "text": "མི་དགེ་བའི་ ༼པེ།༽ མི་དགེ་བ་"
    },
    {
      "span": {
        "start": 5805,
        "end": 5812
      },
      "text": "འདུས་པ་ ༼སྣར། པེ།༽ མ་ལུས་པ་"
    },
    {
      "span": {
        "start": 6101,
        "end": 6103
      },
      "text": "པ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 6164,
        "end": 6168
      },
      "text": "གནས་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 6215,
        "end": 6222
      },
      "text": "འཛེམ་པ་ ༼སྣར། པེ།༽ འཛེམས་པ་"
    },
    {
      "span": {
        "start": 6282,
        "end": 6289
      },
      "text": "སོགས་པ་ ༼སྣར། པེ།༽ སོག་པ་"
    },
    {
      "span": {
        "start": 6791,
        "end": 6799
      },
      "text": "རང་བཞིན་ ༼སྣར། པེ།༽ རང་བཞིན་དུ་"
    },
    {
      "span": {
        "start": 7053,
        "end": 7062
      },
      "text": "དེ་དག་གི་ ༼སྣར།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 7132,
        "end": 7139
      },
      "text": "གྲག་གོ། ༼པེ།༽ གྲགས་སོ།"
    },
    {
      "span": {
        "start": 7350,
        "end": 7357
      },
      "text": "འོང་ངོ་ ༼སྣར།༽ འོང་"
    },
    {
      "span": {
        "start": 7837,
        "end": 7842
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 7853,
        "end": 7858
      },
      "text": "རྟོག་ ༼སྣར།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 8091,
        "end": 8094
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 8661,
        "end": 8667
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 8690,
        "end": 8698
      },
      "text": "རྒལ་བའི་ ༼སྣར། པེ།༽ བརྒལ་བའི་"
    },
    {
      "span": {
        "start": 8906,
        "end": 8911
      },
      "text": "མདུན་ ༼པེ།༽ བདུན་"
    },
    {
      "span": {
        "start": 8939,
        "end": 8945
      },
      "text": "གདབ་པ་ ༼པེ།༽ བདབ་པ་"
    },
    {
      "span": {
        "start": 9006,
        "end": 9013
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 9696,
        "end": 9698
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་ཟས་"
    },
    {
      "span": {
        "start": 9755,
        "end": 9764
      },
      "text": "གྱུར་པའོ། ༼སྣར། པེ།༽ འགྱུར་བའོ།"
    },
    {
      "span": {
        "start": 9788,
        "end": 9794
      },
      "text": "དགེ་བ་ ༼སྣར། པེ།༽ དགེ་བ་ཐེག་པ་"
    },
    {
      "span": {
        "start": 10085,
        "end": 10094
      },
      "text": "སྦྱོར་བས་ ༼སྣར། པེ།༽ སྦྱིན་པས་"
    },
    {
      "span": {
        "start": 10891,
        "end": 10896
      },
      "text": "གྱུར་ ༼སྣར།༽ གྱུར་པས་གཙོ་བོར་གཞག་ ༼པེ།༽ གྱུར་པས་གཙོ་བོར་བཞག་"
    },
    {
      "span": {
        "start": 10917,
        "end": 10924
      },
      "text": "འགོག་པ་ ༼སྣར། པེ།༽ འདོགས་པ་"
    },
    {
      "span": {
        "start": 11156,
        "end": 11165
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 11236,
        "end": 11242
      },
      "text": "ལྟ་བུ་ ༼སྣར། པེ།༽ ལྟ་བུས་"
    },
    {
      "span": {
        "start": 11272,
        "end": 11279
      },
      "text": "གོམས་པ་ ༼སྣར། པེ།༽ གོམ་པ་"
    },
    {
      "span": {
        "start": 11279,
        "end": 11286
      },
      "text": "ཕུལ་དུ་ ༼སྣར། པེ།༽ ཕུལ་"
    },
    {
      "span": {
        "start": 11310,
        "end": 11313
      },
      "text": "དེ། ༼སྣར། པེ།༽ བཅད་དོ།"
    },
    {
      "span": {
        "start": 11787,
        "end": 11795
      },
      "text": "བསྒོམ་པ་ ༼སྣར།༽ བསྒོམས་པ་"
    },
    {
      "span": {
        "start": 12007,
        "end": 12019
      },
      "text": "བྱུང་བ་རྣམས་ ༼སྣར། པེ།༽ བྱུང་བའི་རྣམ་པས་"
    },
    {
      "span": {
        "start": 12215,
        "end": 12222
      },
      "text": "ཁྱད་པར་ ༼སྣར། པེ།༽ ཁྱད་"
    },
    {
      "span": {
        "start": 12471,
        "end": 12477
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 12528,
        "end": 12535
      },
      "text": "སྔོ་བར་ ༼སྣར། པེ།༽ བསྔོ་བར་"
    },
    {
      "span": {
        "start": 13451,
        "end": 13458
      },
      "text": "ཐོབ་པར་ ༼སྣར། པེ།༽ འཐོབ་པར་"
    },
    {
      "span": {
        "start": 13614,
        "end": 13630
      },
      "text": "སངས་རྒྱས་ཐམས་ཅད་ ༼སྣར། པེ།༽ སངས་རྒྱས་"
    },
    {
      "span": {
        "start": 13677,
        "end": 13685
      },
      "text": "མཆོག་ཏུ་ ༼སྣར། པེ།༽ མཆོག་ཐོབ་པར་"
    },
    {
      "span": {
        "start": 14105,
        "end": 14112
      },
      "text": "མེད་པར་ ༼སྣར།༽ མིང་པར་"
    },
    {
      "span": {
        "start": 14222,
        "end": 14231
      },
      "text": "འདེབས་སོ། ༼སྣར། པེ།༽ འདེབས་པའོ།"
    },
    {
      "span": {
        "start": 14247,
        "end": 14249
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 14717,
        "end": 14727
      },
      "text": "འདེབས་པའི་ ༼སྣར། པེ།༽ གདབ་པའི་"
    },
    {
      "span": {
        "start": 14805,
        "end": 14812
      },
      "text": "གཟུང་བ་ ༼སྣར། པེ།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 15189,
        "end": 15193
      },
      "text": "ཞེས་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 15577,
        "end": 15587
      },
      "text": "རྟོགས་པའི་ ༼སྣར། པེ།༽ རྟོག་པའི་"
    },
    {
      "span": {
        "start": 15700,
        "end": 15706
      },
      "text": "བརྫུན་ ༼སྣར། པེ།༽ རྫུན་"
    },
    {
      "span": {
        "start": 15800,
        "end": 15804
      },
      "text": "འབད་ ༼སྣར། པེ།༽ འདབ་"
    },
    {
      "span": {
        "start": 15817,
        "end": 15819
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལས།"
    },
    {
      "span": {
        "start": 15935,
        "end": 15956
      },
      "text": "མ་རིག་འཐིབས་པོར་བྱིང་ ༼སྣར། པེ།༽ མ་རིགཐིབས་པོ་དཔྱིས་"
    },
    {
      "span": {
        "start": 16004,
        "end": 16014
      },
      "text": "བཤད་པ་ཞེས་ ༼སྣར། པེ།༽ བཤད་པ་ཞེསཔ་"
    }
  ]
}