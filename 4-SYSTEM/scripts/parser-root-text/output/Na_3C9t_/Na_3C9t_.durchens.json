{
  "durchens": [
    {
      "span": {
        "start": 57,
        "end": 65
      },
      "text": "སྦྱོང་བ་ ༼སྣར། པེ།༽ སྦྱོང་"
    },
    {
      "span": {
        "start": 544,
        "end": 550
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 704,
        "end": 707
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 875,
        "end": 883
      },
      "text": "མེད་ཅིང་ ༼སྣར། པེ།༽ མེད་དེ་"
    },
    {
      "span": {
        "start": 1688,
        "end": 1695
      },
      "text": "བཏགས་པ་ ༼སྣར། པེ།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 2350,
        "end": 2357
      },
      "text": "ཕབ་པའོ། ༼སྣར། པེ།༽ ཕཕབ་པའོ་དགེའོ།"
    }
  ]
}