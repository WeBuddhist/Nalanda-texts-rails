{
  "durchens": [
    {
      "span": {
        "start": 21,
        "end": 26
      },
      "text": "མ་ཧོ་ ༼སྣར། པེ།༽ མར་"
    },
    {
      "span": {
        "start": 179,
        "end": 184
      },
      "text": "གྲུར་ ༼སྣར། པེ།༽ གྲུ་"
    },
    {
      "span": {
        "start": 331,
        "end": 337
      },
      "text": "བསྲེག་ ༼སྣར། པེ།༽ སྲེག་"
    },
    {
      "span": {
        "start": 380,
        "end": 388
      },
      "text": "འབྲས་བུ་ ༼སྣར། པེ།༽ འབྲས་བུ་ལ་"
    },
    {
      "span": {
        "start": 388,
        "end": 396
      },
      "text": "སོགས་པས་ ༼སྣར། པེ།༽ སོགས་"
    },
    {
      "span": {
        "start": 684,
        "end": 689
      },
      "text": "བརླབ་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 750,
        "end": 755
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 1084,
        "end": 1092
      },
      "text": "བྱུགས་པ་ ༼སྣར། པེ།༽ བྱུག་པ་"
    },
    {
      "span": {
        "start": 1471,
        "end": 1478
      },
      "text": "ཞུ་གནས་ ༼སྣར། པེ།༽ ཞུགས་ནས་"
    },
    {
      "span": {
        "start": 1561,
        "end": 1571
      },
      "text": "ཡིས་བརྒྱན་ ༼སྣར། པེ།༽ ཡི་རྒྱན་"
    },
    {
      "span": {
        "start": 1667,
        "end": 1672
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 1672,
        "end": 1680
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 1749,
        "end": 1754
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 2006,
        "end": 2011
      },
      "text": "བྱ། ། ༼སྣར། པེ།༽ ཕྱག །"
    },
    {
      "span": {
        "start": 2090,
        "end": 2096
      },
      "text": "དྲང་བ། ༼སྣར། པེ།༽ དྲངས་པ།"
    },
    {
      "span": {
        "start": 2474,
        "end": 2485
      },
      "text": "མར་མེའི་འོ། ༼སྣར། པེ།༽ མར་མེའི་མེའོ།"
    },
    {
      "span": {
        "start": 2504,
        "end": 2508
      },
      "text": "ཏྱེ་ ༼སྣར།༽ དྱ་ ༼པེ།༽ ཏྱ་"
    },
    {
      "span": {
        "start": 2675,
        "end": 2683
      },
      "text": "ཞོའི་འོ། ༼སྣར། པེ།༽ ཞོའི་ཞི་བའིའོ།"
    },
    {
      "span": {
        "start": 2738,
        "end": 2741
      },
      "text": "རི་ ༼སྣར། པེ།༽ རེ་"
    },
    {
      "span": {
        "start": 2849,
        "end": 2855
      },
      "text": "བཛྲ་ལ་ ༼སྣར། པེ།༽ བཛྲ་མ་"
    },
    {
      "span": {
        "start": 2869,
        "end": 2878
      },
      "text": "ལ་ཤའི་འོ། ༼སྣར། པེ།༽ ལ་ཀྵའིའོ།"
    },
    {
      "span": {
        "start": 3489,
        "end": 3498
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་པར་"
    },
    {
      "span": {
        "start": 3682,
        "end": 3688
      },
      "text": "ཐལ་བར་ ༼སྣར། པེ།༽ ཐར་པར་"
    },
    {
      "span": {
        "start": 4004,
        "end": 4013
      },
      "text": "བསྲེགས་པ་ ༼སྣར། པེ།༽ བསྲེག་པ་"
    },
    {
      "span": {
        "start": 4556,
        "end": 4573
      },
      "text": "ཝརྨ་དང་། བོད་ཀྱི་ ༼སྣར། པེ།༽ ཝརྨྨཱ་ལས་"
    }
  ]
}