{
  "durchens": [
    {
      "span": {
        "start": 337,
        "end": 344
      },
      "text": "ལོ་ཏོག་ ༼སྣར།༽ ལོ་ཐོག་ ༼པེ།༽ ལོ་ཐོག་ཕུན་ཚོགས་"
    },
    {
      "span": {
        "start": 2540,
        "end": 2543
      },
      "text": "དེ། ༼པེ།༽ དེས།"
    },
    {
      "span": {
        "start": 16760,
        "end": 16767
      },
      "text": "ཇི་ལྟར་ ༼སྣར།༽ ཇི་ལྟ་ལྟ་བ་ ༼པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 25732,
        "end": 25736
      },
      "text": "ཁྱད་ ༼པེ།༽ ཁྱབ་"
    },
    {
      "span": {
        "start": 25899,
        "end": 25904
      },
      "text": "ཕྱིར། ༼པེ།༽ ཕྱི།"
    },
    {
      "span": {
        "start": 34184,
        "end": 34189
      },
      "text": "བཅོལ་ ༼སྣར།༽ གཙོལ་"
    },
    {
      "span": {
        "start": 36895,
        "end": 36906
      },
      "text": "ཐམས་ཅད་ཀྱི། ༼སྣར།༽ ཐམས་ཅད་ཀྱིས།"
    }
  ]
}