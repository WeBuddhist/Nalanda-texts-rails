{
  "durchens": [
    {
      "span": {
        "start": 242,
        "end": 251
      },
      "text": "བརྟན་པའི་ ༼སྣར།༽ བསྟན་པའི་"
    },
    {
      "span": {
        "start": 932,
        "end": 942
      },
      "text": "རྐྱོང་ཡང་། ༼སྣར། པེ།༽ ཏུ་སྐྱོང་།"
    },
    {
      "span": {
        "start": 1299,
        "end": 1304
      },
      "text": "གྱུར། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 1932,
        "end": 1935
      },
      "text": "དེ་ ༼སྣར། པེ།༽ ཚེ་"
    }
  ]
}