{
  "durchens": [
    {
      "span": {
        "start": 73,
        "end": 81
      },
      "text": "དྲལ་བའི་ ༼སྣར། པེ།༽ བྲལ་བའི་"
    },
    {
      "span": {
        "start": 86,
        "end": 96
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 205,
        "end": 214
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 218,
        "end": 227
      },
      "text": "བཞིན་གྱི་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 231,
        "end": 235
      },
      "text": "བུར་ ༼སྣར། པེ།༽ བུ་"
    },
    {
      "span": {
        "start": 344,
        "end": 353
      },
      "text": "བཤིགས་ཏེ། ༼སྣར། པེ།༽ བཤིག་སྟེ།"
    },
    {
      "span": {
        "start": 364,
        "end": 368
      },
      "text": "དངས་ ༼སྣར། པེ།༽ དེངས་"
    },
    {
      "span": {
        "start": 471,
        "end": 477
      },
      "text": "བཟློག་ ༼སྣར། པེ།༽ ཟློག་"
    },
    {
      "span": {
        "start": 484,
        "end": 489
      },
      "text": "ཟློས་ ༼སྣར། པེ།༽ བཟློས་"
    },
    {
      "span": {
        "start": 560,
        "end": 563
      },
      "text": "མེ་ ༼སྣར། པེ།༽ མེའི་"
    },
    {
      "span": {
        "start": 678,
        "end": 686
      },
      "text": "དྲལ་བའི་ ༼སྣར། པེ།༽ བྲལ་བའི་"
    }
  ]
}