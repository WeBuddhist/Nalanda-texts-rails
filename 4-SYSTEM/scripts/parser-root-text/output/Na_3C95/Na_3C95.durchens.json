{
  "durchens": [
    {
      "span": {
        "start": 142,
        "end": 156
      },
      "text": "སེམས་ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ སེམས་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 337,
        "end": 342
      },
      "text": "སེམས་ ༼སྣར། པེ།༽ རིམ་"
    },
    {
      "span": {
        "start": 457,
        "end": 465
      },
      "text": "ཀུན་གྱི་ ༼སྣར། པེ།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 607,
        "end": 613
      },
      "text": "བསྡོས་ ༼སྣར། པེ།༽ སྒོ་"
    },
    {
      "span": {
        "start": 739,
        "end": 747
      },
      "text": "རྡོ་རྗེ་ ༼སྣར། པེ།༽ རྡོ་རྗེའི་"
    },
    {
      "span": {
        "start": 844,
        "end": 851
      },
      "text": "བདེ་བར་ ༼སྣར། པེ།༽ ཁེད་པར་"
    },
    {
      "span": {
        "start": 903,
        "end": 906
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 988,
        "end": 993
      },
      "text": "སོ། ། ༼པེ།༽ སསོ་མངྒ་ལཾ།"
    }
  ]
}