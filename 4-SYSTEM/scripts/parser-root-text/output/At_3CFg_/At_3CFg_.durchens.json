{
  "durchens": [
    {
      "span": {
        "start": 158,
        "end": 165
      },
      "text": "བྱས་ནས་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 225,
        "end": 233
      },
      "text": "བརྒྱད་པ་ ༼སྣར། པེ།༽ བརྒྱད་"
    },
    {
      "span": {
        "start": 789,
        "end": 794
      },
      "text": "ཡོངས་ ༼པེ།༽ སྭཱ་"
    },
    {
      "span": {
        "start": 804,
        "end": 811
      },
      "text": "ལས་རྡོ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 877,
        "end": 882
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ གསུམ་ཀྱི་"
    },
    {
      "span": {
        "start": 996,
        "end": 1003
      },
      "text": "གཅིག་པ་ ༼སྣར།༽ གཅིག་པ་པ་"
    },
    {
      "span": {
        "start": 1024,
        "end": 1033
      },
      "text": "ཐོད་པ་དང་ ༼སྣར། པེ།༽ ཐོད་པ་"
    },
    {
      "span": {
        "start": 1211,
        "end": 1216
      },
      "text": "འཕྱང་ ༼སྣར། པེ།༽ རྒྱན་ང་"
    },
    {
      "span": {
        "start": 1294,
        "end": 1302
      },
      "text": "ཧཱུཾ་གི་ ༼སྣར། པེ།༽ ཧཱུཾ་སིང་"
    },
    {
      "span": {
        "start": 1618,
        "end": 1620
      },
      "text": "བ་ ༼སྣར། པེ།༽ སྐ་"
    },
    {
      "span": {
        "start": 1640,
        "end": 1654
      },
      "text": "འདི་ལྟར་དམིགས་ ༼སྣར། པེ།༽ འདི་ལྟར་བ་"
    },
    {
      "span": {
        "start": 2042,
        "end": 2052
      },
      "text": "ནམ་མཁའ་ལྟ་ ༼སྣར། པེ།༽ ཧཱུཾ་ལ་ཧཱུཾ་"
    }
  ]
}