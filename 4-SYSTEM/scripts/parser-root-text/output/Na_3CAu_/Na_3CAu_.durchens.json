{
  "durchens": [
    {
      "span": {
        "start": 487,
        "end": 498
      },
      "text": "རང་བཞིན་ནོ། ༼སྣར། པེ།༽ རང་བཞིན་ནི།"
    },
    {
      "span": {
        "start": 1166,
        "end": 1171
      },
      "text": "གྱིས་ ༼སྣར། པེ།༽ གྱི་"
    },
    {
      "span": {
        "start": 1330,
        "end": 1339
      },
      "text": "རྟོག་པའི་ ༼སྣར། པེ།༽ རྟོགས་པའི་"
    },
    {
      "span": {
        "start": 1369,
        "end": 1375
      },
      "text": "དབྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 1475,
        "end": 1480
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 2010,
        "end": 2016
      },
      "text": "སྣང་མ་ ༼སྣར། པེ།༽ སྣང་བ་"
    },
    {
      "span": {
        "start": 2207,
        "end": 2214
      },
      "text": "ཙམ་སྟེ། ༼སྣར། པེ།༽ ཙམ་ཏེ།"
    },
    {
      "span": {
        "start": 2485,
        "end": 2495
      },
      "text": "བསྒྲིབས་པ་ ༼སྣར། པེ།༽ བསྒྲིབས་པས་"
    },
    {
      "span": {
        "start": 2602,
        "end": 2608
      },
      "text": "ཞོན་པ། ༼སྣར།༽ ཞོན་པར།"
    },
    {
      "span": {
        "start": 2890,
        "end": 2905
      },
      "text": "བསྒྱུར་བའོ།། །། ༼སྣར། པེ།༽ བསྒྱུར། །།"
    }
  ]
}