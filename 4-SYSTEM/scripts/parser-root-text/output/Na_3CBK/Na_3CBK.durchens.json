{
  "durchens": [
    {
      "span": {
        "start": 237,
        "end": 243
      },
      "text": "ད་སྒལ་ ༼སྣར། པེ།༽ ད་རྒན་"
    },
    {
      "span": {
        "start": 603,
        "end": 613
      },
      "text": "སྦྱོར་བའི་ ༼སྣར། པེ།༽ འབྱོར་བའི་"
    },
    {
      "span": {
        "start": 633,
        "end": 637
      },
      "text": "གཏང་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 698,
        "end": 700
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 847,
        "end": 851
      },
      "text": "ཕུལ་ ༼སྣར། པེ།༽ འཕུལ་"
    },
    {
      "span": {
        "start": 916,
        "end": 922
      },
      "text": "གྲུགས་ ༼སྣར། པེ།༽ གྲུམས་"
    },
    {
      "span": {
        "start": 1243,
        "end": 1247
      },
      "text": "དང་། ༼སྣར། པེ།༽ དང་། གྲང་ནད་དང་"
    },
    {
      "span": {
        "start": 1446,
        "end": 1454
      },
      "text": "མདོངས་པ་ ༼སྣར། པེ།༽ ལྡོངས་པ་"
    },
    {
      "span": {
        "start": 1534,
        "end": 1549
      },
      "text": "དང་། རྣ་ནད་དང་། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 1739,
        "end": 1745
      },
      "text": "བསྐོལ་ ༼སྣར། པེ།༽ བསྒྲལ་"
    },
    {
      "span": {
        "start": 1761,
        "end": 1768
      },
      "text": "བཙགས་ལ་ ༼སྣར།༽ བཙགས་པ་"
    },
    {
      "span": {
        "start": 1850,
        "end": 1853
      },
      "text": "ཀར་ ༼སྣར། པེ།༽ གར་"
    },
    {
      "span": {
        "start": 1868,
        "end": 1874
      },
      "text": "འཚལ་མ་ ༼སྣར། པེ།༽ འཚལ་"
    },
    {
      "span": {
        "start": 1943,
        "end": 1951
      },
      "text": "མདོངས་པ་ ༼སྣར། པེ།༽ ལྡོངས་པ་"
    },
    {
      "span": {
        "start": 2060,
        "end": 2065
      },
      "text": "བ་མར་ ༼སྣར།༽ བུ་ ༼པེ།༽ བར་མར་"
    },
    {
      "span": {
        "start": 2194,
        "end": 2197
      },
      "text": "ཁར་ ༼སྣར། པེ།༽ གར་"
    },
    {
      "span": {
        "start": 2425,
        "end": 2432
      },
      "text": "ལྡན་པས། ༼སྣར། པེ།༽ ལྡན་པ།"
    },
    {
      "span": {
        "start": 2440,
        "end": 2445
      },
      "text": "ཆག་ལ་ ༼སྣར།༽ ཆགས་པས་ ༼པེ།༽ ཆག་པས་"
    },
    {
      "span": {
        "start": 2513,
        "end": 2520
      },
      "text": "ཨ་བ་ཚབ་ ༼སྣར།༽ ཨ་བ་"
    },
    {
      "span": {
        "start": 2540,
        "end": 2549
      },
      "text": "ཉེའུ་ཤིང་ ༼སྣར། པེ།༽ ཉེ་ཤིང་"
    },
    {
      "span": {
        "start": 2560,
        "end": 2564
      },
      "text": "དུག་ ༼སྣར། པེ།༽ དྲུག་"
    },
    {
      "span": {
        "start": 2816,
        "end": 2820
      },
      "text": "བཞི་ ༼སྣར།༽ བཞིན་"
    },
    {
      "span": {
        "start": 2828,
        "end": 2831
      },
      "text": "ཟན་ ༼སྣར།༽ ཟས་"
    },
    {
      "span": {
        "start": 2870,
        "end": 2873
      },
      "text": "ཟས་ ༼སྣར། པེ།༽ གསུམ་"
    },
    {
      "span": {
        "start": 2876,
        "end": 2879
      },
      "text": "ཟན། ༼སྣར། པེ།༽ བཟའ།"
    },
    {
      "span": {
        "start": 2951,
        "end": 2955
      },
      "text": "ཚོར་ ༼སྣར།༽ མཚོར་"
    },
    {
      "span": {
        "start": 3155,
        "end": 3161
      },
      "text": "བསྐོལ་ ༼སྣར། པེ།༽ སྐོལ་"
    },
    {
      "span": {
        "start": 3410,
        "end": 3416
      },
      "text": "རུས་པ་ ༼སྣར། པེ།༽ རུལ་པ་"
    },
    {
      "span": {
        "start": 3427,
        "end": 3432
      },
      "text": "སྐོམ་ ༼སྣར། པེ།༽ སྐེམ་"
    },
    {
      "span": {
        "start": 3570,
        "end": 3576
      },
      "text": "རུས་པ་ ༼སྣར།༽ སུ་པ་"
    },
    {
      "span": {
        "start": 3624,
        "end": 3633
      },
      "text": "ཉེའུ་ཤིང་ ༼སྣར། པེ།༽ ཉེ་ཤིང་"
    },
    {
      "span": {
        "start": 3680,
        "end": 3688
      },
      "text": "དེ་བཞིན། ༼སྣར།༽ དེ་བཞིན་ཏེ།"
    },
    {
      "span": {
        "start": 3732,
        "end": 3740
      },
      "text": "སྦྱར་བར་ ༼སྣར། པེ།༽ སྦྱང་བར་"
    },
    {
      "span": {
        "start": 3761,
        "end": 3765
      },
      "text": "སྤང་ ༼སྣར། པེ།༽ སྤངས་"
    }
  ]
}