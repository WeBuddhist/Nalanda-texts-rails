{
  "durchens": [
    {
      "span": {
        "start": 652,
        "end": 664
      },
      "text": "བདེ་བར་འཇུག་ ༼པེ།༽ བདེ་བར་"
    },
    {
      "span": {
        "start": 855,
        "end": 860
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 891,
        "end": 896
      },
      "text": "འབྲལ་ ༼སྣར། པེ།༽ འབྲས་"
    },
    {
      "span": {
        "start": 1023,
        "end": 1026
      },
      "text": "ཐོ་ ༼སྣར། པེ།༽ མཐོ་"
    },
    {
      "span": {
        "start": 1125,
        "end": 1131
      },
      "text": "བཟློག་ ༼སྣར།༽ ཟློག་"
    },
    {
      "span": {
        "start": 1133,
        "end": 1139
      },
      "text": "རིག་པ་ ༼སྣར། པེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 1171,
        "end": 1176
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ སྟེན་"
    },
    {
      "span": {
        "start": 1373,
        "end": 1378
      },
      "text": "བཞིར། ༼སྣར། པེ།༽ བཞི།"
    },
    {
      "span": {
        "start": 1380,
        "end": 1387
      },
      "text": "རིག་པར་ ༼སྣར། པེ།༽ རིགས་པར་"
    },
    {
      "span": {
        "start": 1945,
        "end": 1948
      },
      "text": "དང་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 2477,
        "end": 2479
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལས།"
    },
    {
      "span": {
        "start": 2549,
        "end": 2551
      },
      "text": "པ་ ༼སྣར། པེ།༽ པས་"
    },
    {
      "span": {
        "start": 2684,
        "end": 2687
      },
      "text": "པས་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 2793,
        "end": 2802
      },
      "text": "འདུལ་བའི་ ༼སྣར། པེ།༽ འདུལ་བ་"
    },
    {
      "span": {
        "start": 2979,
        "end": 2992
      },
      "text": "འདུ་ཤེས་ཀྱིས། ༼སྣར། པེ།༽ འདུ་ཤེས་ཀྱི།"
    },
    {
      "span": {
        "start": 3632,
        "end": 3638
      },
      "text": "གང་ཟག་ ༼སྣར། པེ།༽ གང་ཟག་དེ་"
    },
    {
      "span": {
        "start": 3638,
        "end": 3646
      },
      "text": "རྣམས་དང་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 3877,
        "end": 3891
      },
      "text": "དགེ་འདུན་གྱིས་ ༼སྣར། པེ།༽ དགེ་འདུན་གྱི་"
    },
    {
      "span": {
        "start": 3894,
        "end": 3901
      },
      "text": "མ་བསྒོ་ ༼སྣར།༽ མ་སྒོ་"
    },
    {
      "span": {
        "start": 3981,
        "end": 3986
      },
      "text": "བཅུག་ ༼སྣར། པེ།༽ བཅུགས་"
    },
    {
      "span": {
        "start": 4468,
        "end": 4476
      },
      "text": "མཐུན་པས་ ༼སྣར། པེ།༽ མཐུན་པར་"
    },
    {
      "span": {
        "start": 4832,
        "end": 4839
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 4872,
        "end": 4878
      },
      "text": "སྤང་བ་ ༼སྣར། པེ།༽ སྤོང་བ་"
    },
    {
      "span": {
        "start": 5088,
        "end": 5095
      },
      "text": "རྩོམ་པ་ ༼སྣར། པེ།༽ རྩོན་པ་"
    },
    {
      "span": {
        "start": 5287,
        "end": 5295
      },
      "text": "རློམས་པ་ ༼སྣར། པེ།༽ རློམ་པ་"
    },
    {
      "span": {
        "start": 5548,
        "end": 5553
      },
      "text": "འཕེན་ ༼སྣར། པེ།༽ ཕན་"
    },
    {
      "span": {
        "start": 5809,
        "end": 5817
      },
      "text": "སྒོམ་པར་ ༼སྣར། པེ།༽ བསྒོམ་པར་"
    },
    {
      "span": {
        "start": 5949,
        "end": 5952
      },
      "text": "ཞི་ ༼སྣར།༽ བཞི་"
    },
    {
      "span": {
        "start": 5977,
        "end": 5983
      },
      "text": "སྤང་བ་ ༼སྣར། པེ།༽ སྤོང་བ་"
    },
    {
      "span": {
        "start": 6088,
        "end": 6092
      },
      "text": "མཉམ་ ༼སྣར། པེ།༽ སྙམ་"
    },
    {
      "span": {
        "start": 6183,
        "end": 6191
      },
      "text": "སྒྲུབ་པ་ ༼སྣར།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 6420,
        "end": 6424
      },
      "text": "དང་། ༼སྣར། པེ།༽ ཡི།"
    },
    {
      "span": {
        "start": 6443,
        "end": 6447
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྟགས་"
    },
    {
      "span": {
        "start": 6512,
        "end": 6518
      },
      "text": "གདུགས་ ༼སྣར། པེ།༽ གདུག་"
    },
    {
      "span": {
        "start": 6580,
        "end": 6588
      },
      "text": "འཇུག་པར་ ༼སྣར། པེ།༽ འཇུག་པ་"
    },
    {
      "span": {
        "start": 6610,
        "end": 6615
      },
      "text": "འཛེམ་ ༼སྣར། པེ།༽ མཛེམས་"
    },
    {
      "span": {
        "start": 6727,
        "end": 6733
      },
      "text": "བསྲུང་ ༼སྣར། པེ།༽ སྲུང་"
    },
    {
      "span": {
        "start": 7006,
        "end": 7015
      },
      "text": "གཞན་གྱིས་ ༼སྣར།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 7120,
        "end": 7125
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ རྟོན་"
    },
    {
      "span": {
        "start": 7252,
        "end": 7260
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ དང་པོ་"
    },
    {
      "span": {
        "start": 7421,
        "end": 7429
      },
      "text": "ལྷག་བཅས་ ༼སྣར།༽ ལྷག་ཆད་"
    },
    {
      "span": {
        "start": 8248,
        "end": 8260
      },
      "text": "ང་རྒྱལ་གྱིས་ ༼སྣར།༽ ང་རྒྱལ་གྱི་"
    },
    {
      "span": {
        "start": 8340,
        "end": 8345
      },
      "text": "རྒུད་ ༼སྣར། པེ།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 8574,
        "end": 8581
      },
      "text": "བྱ་སྟེ། ༼སྣར། པེ།༽ བྱས་ཏེ།"
    },
    {
      "span": {
        "start": 9132,
        "end": 9162
      },
      "text": "དགེ་འདུན་བདེ་བར་གནས་པར་བྱ་བའི་ ༼སྣར། པེ།༽ བདེ་བར་གནས་པའི་"
    },
    {
      "span": {
        "start": 9203,
        "end": 9211
      },
      "text": "གཅད་པའི་ ༼སྣར། པེ།༽ བཅད་པའི་"
    },
    {
      "span": {
        "start": 9510,
        "end": 9516
      },
      "text": "བཤད་པ་ ༼སྣར། པེ།༽ བཤད་པ་ལ་"
    },
    {
      "span": {
        "start": 10006,
        "end": 10008
      },
      "text": "པ་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 10451,
        "end": 10459
      },
      "text": "གཅད་པའི་ ༼སྣར། པེ།༽ བཅད་པའི་"
    },
    {
      "span": {
        "start": 10872,
        "end": 10875
      },
      "text": "བར་ ༼སྣར།༽ བར་དག་"
    },
    {
      "span": {
        "start": 10989,
        "end": 10995
      },
      "text": "བ་དང་། ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 11009,
        "end": 11015
      },
      "text": "བ་དང་། ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 11197,
        "end": 11201
      },
      "text": "སྟེ། ༼སྣར། པེ།༽ སྟེ། དེ་དག་ནི་ལྟུང་བ་ཐམས་ཅད་བསྡུས་པ་ཡིན་ནོ། །"
    },
    {
      "span": {
        "start": 11303,
        "end": 11311
      },
      "text": "སྦོམ་པོ་ ༼སྣར།༽ སྦོམས་པོ་"
    },
    {
      "span": {
        "start": 11493,
        "end": 11518
      },
      "text": "བསླང་བ་དེ་དག་ནི་བསླང་བའི་ ༼སྣར། པེ།༽ བསླང་བ་ནི་"
    },
    {
      "span": {
        "start": 11684,
        "end": 11689
      },
      "text": "བསླང་ ༼སྣར། པེ།༽ སླང་"
    },
    {
      "span": {
        "start": 11725,
        "end": 11729
      },
      "text": "གཞག་ ༼སྣར། པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 11826,
        "end": 11831
      },
      "text": "བྱའོ། ༼སྣར། པེ།༽ བྱ་སྟེ།"
    },
    {
      "span": {
        "start": 12070,
        "end": 12084
      },
      "text": "གཞན་ལ་ཐོ་འཚམས་ ༼སྣར། པེ།༽ གཞན་མཐོ་མཚམ་"
    },
    {
      "span": {
        "start": 12417,
        "end": 12443
      },
      "text": "བྱ་བ་ལ་བསྙེན་བཀུར་མི་བྱེད་ ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 12720,
        "end": 12728
      },
      "text": "ཚུལ་གྱི་ ༼སྣར། པེ།༽ ཚུལ་གྱིས་"
    },
    {
      "span": {
        "start": 13514,
        "end": 13522
      },
      "text": "བརླབས་པ་ ༼སྣར། པེ།༽ བརླབ་པ་"
    },
    {
      "span": {
        "start": 13527,
        "end": 13533
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བཏགས་"
    },
    {
      "span": {
        "start": 13594,
        "end": 13604
      },
      "text": "ཐམས་ཅད་དུ་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 13616,
        "end": 13623
      },
      "text": "བརྟག་པ་ ༼སྣར། པེ།༽ རྟག་པ་"
    },
    {
      "span": {
        "start": 13780,
        "end": 13791
      },
      "text": "དགེ་སློང་ལ་ ༼སྣར། པེ།༽ དགེ་སློང་མ་"
    },
    {
      "span": {
        "start": 13895,
        "end": 13901
      },
      "text": "བསྐོས་ ༼སྣར། པེ།༽ སྐོས་"
    },
    {
      "span": {
        "start": 14235,
        "end": 14242
      },
      "text": "ཟས་ཟོས་ ༼སྣར། པེ།༽ ཟས་"
    },
    {
      "span": {
        "start": 14336,
        "end": 14342
      },
      "text": "ནི་མི་ ༼སྣར། པེ།༽ ནི་མ་"
    },
    {
      "span": {
        "start": 14471,
        "end": 14477
      },
      "text": "སྒྱུར་ ༼སྣར། པེ།༽ བསྒྱུར་"
    },
    {
      "span": {
        "start": 14589,
        "end": 14598
      },
      "text": "གྱུར་པའི་ ༼སྣར། པེ།༽ འགྱུར་བའི་"
    },
    {
      "span": {
        "start": 15008,
        "end": 15016
      },
      "text": "ཐོ་འཚམས་ ༼སྣར། པེ།༽ མཐོ་འཚམ་"
    },
    {
      "span": {
        "start": 15110,
        "end": 15116
      },
      "text": "ལྕི་བ་ ༼སྣར། པེ།༽ ལྕི་བར་"
    },
    {
      "span": {
        "start": 15151,
        "end": 15158
      },
      "text": "འཛེག་པ་ ༼སྣར།༽ འཛེགས་པ་"
    },
    {
      "span": {
        "start": 15347,
        "end": 15355
      },
      "text": "སྨྲ་ཤིག་ ༼སྣར། པེ།༽ སྨྲ་ཞིག་"
    },
    {
      "span": {
        "start": 15871,
        "end": 15879
      },
      "text": "བྱེད་པས་ ༼སྣར། པེ།༽ བྱེད་པར་"
    },
    {
      "span": {
        "start": 15951,
        "end": 15958
      },
      "text": "ལ་སོགས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 16643,
        "end": 16649
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 16660,
        "end": 16673
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 16784,
        "end": 16788
      },
      "text": "ཀུན་ ༼སྣར། པེ།༽ ཀུན་ནས་"
    },
    {
      "span": {
        "start": 16984,
        "end": 16990
      },
      "text": "བཅད་པ་ ༼སྣར། པེ།༽ བཅས་པ་"
    },
    {
      "span": {
        "start": 17030,
        "end": 17036
      },
      "text": "བཅད་པ་ ༼སྣར། པེ།༽ བཅས་པ་"
    },
    {
      "span": {
        "start": 17212,
        "end": 17225
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 18459,
        "end": 18469
      },
      "text": "བག་མེད་པར་ ༼སྣར། པེ།༽ བག་མེད་པས་"
    },
    {
      "span": {
        "start": 18601,
        "end": 18614
      },
      "text": "ལྟུང་བ་འབྱུང་ ༼སྣར། པེ།༽ ལྟུང་"
    },
    {
      "span": {
        "start": 18933,
        "end": 18942
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 19365,
        "end": 19375
      },
      "text": "གཉིས་ཀྱིས་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 19640,
        "end": 19648
      },
      "text": "ཕམ་པ་ནི་ ༼སྣར།༽ ཕམ་པའི་"
    },
    {
      "span": {
        "start": 19755,
        "end": 19758
      },
      "text": "ཕམ་ ༼སྣར།༽ དག་"
    },
    {
      "span": {
        "start": 20501,
        "end": 20507
      },
      "text": "བསམ་པ་ ༼སྣར།༽ བསམས་པ་"
    },
    {
      "span": {
        "start": 20770,
        "end": 20774
      },
      "text": "ཡིན་ ༼སྣར། པེ།༽ ཡིན་པ་"
    },
    {
      "span": {
        "start": 21033,
        "end": 21036
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 21529,
        "end": 21537
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 21844,
        "end": 21852
      },
      "text": "སྐབས་སུ་ ༼སྣར། པེ།༽ སྐབས་"
    },
    {
      "span": {
        "start": 21924,
        "end": 21933
      },
      "text": "པའི་ཕྱིར་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 22456,
        "end": 22468
      },
      "text": "དེ་ཉིད་ཀྱིས་ ༼སྣར།༽ དེ་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 22568,
        "end": 22581
      },
      "text": "ཁོ་ནས་ལྟུང་བ་ ༼སྣར། པེ།༽ ཁོ་ནས་"
    },
    {
      "span": {
        "start": 22646,
        "end": 22649
      },
      "text": "ཟས་ ༼སྣར།༽ ཟད་"
    },
    {
      "span": {
        "start": 23488,
        "end": 23495
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 23554,
        "end": 23558
      },
      "text": "བསལ་ ༼སྣར། པེ།༽ གསལ་"
    },
    {
      "span": {
        "start": 23629,
        "end": 23638
      },
      "text": "སྐྱེད་པར་ ༼སྣར། པེ།༽ སྐྱེས་པར་"
    },
    {
      "span": {
        "start": 23886,
        "end": 23895
      },
      "text": "སྐྱེད་པར་ ༼སྣར། པེ།༽ སྐྱེས་པར་"
    },
    {
      "span": {
        "start": 24136,
        "end": 24145
      },
      "text": "སྐྱེད་པར་ ༼སྣར། པེ།༽ སྐྱེས་པར་"
    },
    {
      "span": {
        "start": 24298,
        "end": 24301
      },
      "text": "སྔ་ ༼སྣར།༽ ལྔ་"
    },
    {
      "span": {
        "start": 24851,
        "end": 24867
      },
      "text": "འགྱོད་པ་སྐྱེས་པ་ ༼སྣར། པེ།༽ འགྱོད་པ་"
    },
    {
      "span": {
        "start": 25712,
        "end": 25720
      },
      "text": "བྱེད་དོ། ༼སྣར། པེ།༽ བྱེད་དེ།"
    },
    {
      "span": {
        "start": 26089,
        "end": 26096
      },
      "text": "དབེན་པ་ ༼སྣར། པེ།༽ དབེན་"
    },
    {
      "span": {
        "start": 26209,
        "end": 26218
      },
      "text": "ལྐུགས་པར་ ༼སྣར། པེ།༽ ལྐུག་པར་"
    },
    {
      "span": {
        "start": 26502,
        "end": 26508
      },
      "text": "སྙོམས་ ༼སྣར། པེ།༽ ཉམས་"
    },
    {
      "span": {
        "start": 26816,
        "end": 26830
      },
      "text": "དགེ་སློང་མ་སྔ་ ༼སྣར། པེ།༽ དགེ་སློང་"
    },
    {
      "span": {
        "start": 26879,
        "end": 26886
      },
      "text": "ཅན་གྱི་ ༼སྣར། པེ།༽ ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 26923,
        "end": 26929
      },
      "text": "འཚོ་བ་ ༼སྣར། པེ།༽ འཚོལ་བ་"
    },
    {
      "span": {
        "start": 27046,
        "end": 27050
      },
      "text": "པའམ། ༼སྣར། པེ།༽ པའོ། །"
    },
    {
      "span": {
        "start": 27299,
        "end": 27311
      },
      "text": "ཉིད་འདོད་པས་ ༼སྣར།༽ ཉིད་འདི་"
    },
    {
      "span": {
        "start": 27394,
        "end": 27402
      },
      "text": "བྱེད་དོ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 27630,
        "end": 27634
      },
      "text": "སྔར་ ༼སྣར། པེ།༽ སྔར་མ་"
    },
    {
      "span": {
        "start": 27778,
        "end": 27784
      },
      "text": "འཚོའི་ ༼སྣར། པེ།༽ འཚོ་བའི་"
    },
    {
      "span": {
        "start": 27803,
        "end": 27809
      },
      "text": "འཚོ་བ་ ༼སྣར། པེ།༽ འཚོལ་བ་"
    },
    {
      "span": {
        "start": 27890,
        "end": 27896
      },
      "text": "གནས་པ་ ༼སྣར། པེ།༽ གནས་"
    },
    {
      "span": {
        "start": 28293,
        "end": 28302
      },
      "text": "ཁང་ངམ་ཁང་ ༼སྣར། པེ།༽ ཁང་ངམ་"
    },
    {
      "span": {
        "start": 28666,
        "end": 28674
      },
      "text": "བརྟེན་པ་ ༼སྣར། པེ།༽ རྟེན་པ་"
    },
    {
      "span": {
        "start": 28821,
        "end": 28831
      },
      "text": "བདག་ལ་བདག་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 28835,
        "end": 28847
      },
      "text": "སྡུག་བསྔལ་བ་ ༼སྣར། པེ།༽ སྡུག་བསྔལ་"
    },
    {
      "span": {
        "start": 29325,
        "end": 29331
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 29424,
        "end": 29433
      },
      "text": "གང་ཡིན་པ་ ༼སྣར། པེ།༽ གང་བ་"
    },
    {
      "span": {
        "start": 29438,
        "end": 29444
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 29456,
        "end": 29465
      },
      "text": "འཁྲུག་པར་ ༼སྣར། པེ།༽ འཁྲུགས་པར་"
    },
    {
      "span": {
        "start": 29478,
        "end": 29493
      },
      "text": "འཇིག་རྟེན་གྱིས་ ༼སྣར། པེ།༽ འཇིག་རྟེན་གྱི་"
    },
    {
      "span": {
        "start": 29602,
        "end": 29615
      },
      "text": "རུང་བ་ཡིན་པས་ ༼སྣར། པེ།༽ རུང་བས་"
    },
    {
      "span": {
        "start": 29712,
        "end": 29720
      },
      "text": "བཟློག་པ་ ༼སྣར། པེ།༽ ཟློག་པ་"
    },
    {
      "span": {
        "start": 30092,
        "end": 30098
      },
      "text": "བཞིའི་ ༼སྣར། པེ།༽ བཞི་པོ་"
    },
    {
      "span": {
        "start": 30352,
        "end": 30359
      },
      "text": "བླངས་པ་ ༼སྣར། པེ།༽ བླང་བ་"
    },
    {
      "span": {
        "start": 30450,
        "end": 30458
      },
      "text": "བཅད་པའི་ ༼སྣར། པེ།༽ གཅད་པའི་"
    },
    {
      "span": {
        "start": 31112,
        "end": 31119
      },
      "text": "ལས་ཀྱི་ ༼སྣར། པེ།༽ ལས་ཀྱིས་"
    },
    {
      "span": {
        "start": 31179,
        "end": 31187
      },
      "text": "བྱ་བ་ནི་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 31791,
        "end": 31799
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ བྱུང་བ་"
    },
    {
      "span": {
        "start": 31809,
        "end": 31818
      },
      "text": "དགེ་སློང་ ༼སྣར། པེ།༽ དགེ་འདུན་"
    },
    {
      "span": {
        "start": 32941,
        "end": 32946
      },
      "text": "འདུལ་ ༼སྣར། པེ།༽ འདུ་"
    },
    {
      "span": {
        "start": 33108,
        "end": 33113
      },
      "text": "དག་ལ་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 33243,
        "end": 33246
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 34217,
        "end": 34233
      },
      "text": "འཕྲལ་གྱི་བྱ་བའི་ ༼སྣར། པེ།༽ འཕྲལ་གྱི་"
    },
    {
      "span": {
        "start": 34916,
        "end": 34925
      },
      "text": "ཞུགས་ཤིང་ ༼སྣར།༽ ཞུགས་པར་"
    },
    {
      "span": {
        "start": 35039,
        "end": 35043
      },
      "text": "འདི་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 35120,
        "end": 35128
      },
      "text": "བརྒྱད་པ་ ༼སྣར། པེ།༽ རྒྱས་པ་"
    },
    {
      "span": {
        "start": 35487,
        "end": 35495
      },
      "text": "ཡོད་པའི་ ༼སྣར། པེ།༽ ཡོད་པ་"
    },
    {
      "span": {
        "start": 35503,
        "end": 35512
      },
      "text": "འཇིག་པའི་ ༼སྣར། པེ།༽ འཛིན་པའི་"
    },
    {
      "span": {
        "start": 35678,
        "end": 35687
      },
      "text": "འཛིན་པའི་ ༼སྣར། པེ།༽ འཛིན་པས་"
    },
    {
      "span": {
        "start": 35747,
        "end": 35752
      },
      "text": "རྟགས་ ༼སྣར། པེ།༽ བཏགས་"
    },
    {
      "span": {
        "start": 35898,
        "end": 35905
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 35998,
        "end": 36007
      },
      "text": "འདས་ཀྱིས་ ༼སྣར། པེ།༽ འདས་ཀྱི་"
    },
    {
      "span": {
        "start": 36023,
        "end": 36032
      },
      "text": "སྒོ་བསྡམ་ ༼སྣར།༽ བསྒོ་བསྡམས་ ༼པེ།༽ སྒོ་བསྡམས་"
    },
    {
      "span": {
        "start": 36132,
        "end": 36138
      },
      "text": "དེ་ལྟ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 36146,
        "end": 36155
      },
      "text": "ཡིད་ཀྱིས་ ༼སྣར།༽ ཡིད་ཀྱི་"
    },
    {
      "span": {
        "start": 36209,
        "end": 36216
      },
      "text": "རིག་པར་ ༼སྣར།༽ རིགས་པར་"
    },
    {
      "span": {
        "start": 36398,
        "end": 36406
      },
      "text": "དཔྱད་པར་ ༼སྣར། པེ།༽ སྤྱད་པར་"
    },
    {
      "span": {
        "start": 36945,
        "end": 36961
      },
      "text": "བཅོས་པ་ཡིན་ནོ། ། ༼སྣར། པེ།༽ བཅོས་པ་"
    },
    {
      "span": {
        "start": 37624,
        "end": 37630
      },
      "text": "གནང་བ་ ༼སྣར། པེ།༽ གང་བ་"
    },
    {
      "span": {
        "start": 37666,
        "end": 37672
      },
      "text": "གང་དག་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 37699,
        "end": 37706
      },
      "text": "ཉེས་པར་ ༼སྣར། པེ།༽ ཉེ་བར་"
    },
    {
      "span": {
        "start": 38056,
        "end": 38064
      },
      "text": "བཞིན་དུ་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 38299,
        "end": 38307
      },
      "text": "བཞིན་དུ་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 38678,
        "end": 38685
      },
      "text": "ཇི་ལྟར་ ༼སྣར། པེ།༽ ཇི་ལྟ་བ་"
    },
    {
      "span": {
        "start": 38752,
        "end": 38757
      },
      "text": "ཁོ་ན་ ༼སྣར། པེ།༽ ཁོ་ནས་"
    },
    {
      "span": {
        "start": 38958,
        "end": 38963
      },
      "text": "གྱུར་ ༼པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 39324,
        "end": 39343
      },
      "text": "བྱུང་བ་ལ་སྤྱོད་པའི་ ༼སྣར། པེ།༽ བྱུང་བའི་"
    },
    {
      "span": {
        "start": 39733,
        "end": 39742
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 39780,
        "end": 39786
      },
      "text": "ཤེས་པ་ ༼སྣར། པེ།༽ ཤེས་"
    },
    {
      "span": {
        "start": 39789,
        "end": 39813
      },
      "text": "ཆོས་གོས་ལ་སོགས་པ་རྙེད་པ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 39859,
        "end": 39867
      },
      "text": "ཕེབས་པར་ ༼སྣར།༽ ཕེབས་པ་"
    },
    {
      "span": {
        "start": 40125,
        "end": 40134
      },
      "text": "འཕེན་པའི་ ༼སྣར། པེ།༽ ཕན་པའི་"
    },
    {
      "span": {
        "start": 40288,
        "end": 40295
      },
      "text": "བཅད་པར་ ༼པེ།༽ གཅད་པར་"
    },
    {
      "span": {
        "start": 40516,
        "end": 40525
      },
      "text": "འཕེན་པའི་ ༼སྣར། པེ།༽ ཕན་པའི་"
    },
    {
      "span": {
        "start": 40996,
        "end": 40999
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ནི་འདི་ལྟར་"
    },
    {
      "span": {
        "start": 41455,
        "end": 41463
      },
      "text": "འདའ་བའི་ ༼སྣར། པེ།༽ འདས་པའི་"
    },
    {
      "span": {
        "start": 41485,
        "end": 41491
      },
      "text": "བསྒོམ་ ༼སྣར། པེ།༽ སྒོམ་"
    },
    {
      "span": {
        "start": 41551,
        "end": 41564
      },
      "text": "ཆུང་བ་ཡིན་པར་ ༼སྣར། པེ།༽ ཆུང་བར་"
    },
    {
      "span": {
        "start": 41709,
        "end": 41718
      },
      "text": "དགེ་སློང་ ༼སྣར།༽ དགེ་སློང་གི་"
    },
    {
      "span": {
        "start": 42006,
        "end": 42012
      },
      "text": "ཡིན་པ་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 42058,
        "end": 42066
      },
      "text": "འདས་པའི་ ༼སྣར། པེ།༽ འདའ་བའི་"
    },
    {
      "span": {
        "start": 42206,
        "end": 42214
      },
      "text": "བསླངས་པ་ ༼སྣར། པེ།༽ བསླང་བ་"
    },
    {
      "span": {
        "start": 42235,
        "end": 42243
      },
      "text": "མདོ་སྡེ་ ༼སྣར། པེ།༽ འདུལ་བ་"
    },
    {
      "span": {
        "start": 42246,
        "end": 42253
      },
      "text": "འདུལ་བ་ ༼སྣར། པེ།༽ མདོ་སྡེ་"
    },
    {
      "span": {
        "start": 42357,
        "end": 42364
      },
      "text": "འདྲི་བ་ ༼སྣར།༽ འདྲི་བར་ ༼པེ།༽ ཟླ་བར་"
    },
    {
      "span": {
        "start": 42412,
        "end": 42418
      },
      "text": "ལས་སོ་ ༼སྣར། པེ།༽ ལ་སོ་"
    },
    {
      "span": {
        "start": 42635,
        "end": 42641
      },
      "text": "སུ་ནི་ ༼སྣར། པེ།༽ སུ་"
    },
    {
      "span": {
        "start": 42669,
        "end": 42678
      },
      "text": "སྨད་དག་ལ་ ༼སྣར། པེ།༽ སྨད་དང་"
    },
    {
      "span": {
        "start": 43320,
        "end": 43329
      },
      "text": "བསྲུངས་པ་ ༼སྣར། པེ།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 44015,
        "end": 44017
      },
      "text": "པ་ ༼སྣར། པེ།༽ པས་"
    },
    {
      "span": {
        "start": 44097,
        "end": 44101
      },
      "text": "ཆོས་ ༼སྣར། པེ།༽ ཆོས་ཉིད་"
    },
    {
      "span": {
        "start": 44333,
        "end": 44340
      },
      "text": "དང་པོས་ ༼སྣར། པེ།༽ དང་པོ་"
    },
    {
      "span": {
        "start": 44375,
        "end": 44383
      },
      "text": "བཞི་པའོ། ༼སྣར། པེ།༽ བཞིའོ།"
    },
    {
      "span": {
        "start": 44449,
        "end": 44458
      },
      "text": "བདེ་བ་དང་ ༼སྣར། པེ།༽ བདེ་བ་"
    },
    {
      "span": {
        "start": 44646,
        "end": 44656
      },
      "text": "བསྒྲུབས་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 44723,
        "end": 44729
      },
      "text": "གང་དག་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 44942,
        "end": 44948
      },
      "text": "འགྲངས་ ༼སྣར། པེ།༽ འདྲངས་"
    },
    {
      "span": {
        "start": 44951,
        "end": 44955
      },
      "text": "གྱི་ ༼སྣར། པེ།༽ གྱིས་"
    },
    {
      "span": {
        "start": 44976,
        "end": 44984
      },
      "text": "བྱེད་དོ། ༼སྣར། པེ།༽ བྱེད་དེ།"
    },
    {
      "span": {
        "start": 45020,
        "end": 45025
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 45367,
        "end": 45374
      },
      "text": "ཉིད་དུ་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 45499,
        "end": 45507
      },
      "text": "སྐྱེས་པ་ ༼སྣར།༽ སྐྱེད་པ་"
    },
    {
      "span": {
        "start": 45712,
        "end": 45714
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 45750,
        "end": 45752
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 45767,
        "end": 45775
      },
      "text": "འཁྲུག་པ་ ༼སྣར། པེ།༽ འཁྲུགས་པ་"
    },
    {
      "span": {
        "start": 45791,
        "end": 45799
      },
      "text": "འཁྲུག་པ་ ༼སྣར།༽ འཁྲུགས་པ་"
    },
    {
      "span": {
        "start": 45988,
        "end": 45996
      },
      "text": "གདམས་ངག་ ༼སྣར། པེ།༽ གདམ་ངག་"
    },
    {
      "span": {
        "start": 46067,
        "end": 46083
      },
      "text": "བརྩམས་ཏེ་རྣམ་པར་ ༼སྣར། པེ།༽ བརྩམས་ཏེ་"
    },
    {
      "span": {
        "start": 46205,
        "end": 46210
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 46730,
        "end": 46738
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོགས་པར་བྱ་བ་"
    },
    {
      "span": {
        "start": 46958,
        "end": 46965
      },
      "text": "བྱ་སྟེ། ༼སྣར། པེ།༽ བྱས་ཏེ།"
    },
    {
      "span": {
        "start": 47163,
        "end": 47167
      },
      "text": "བལྟ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 47432,
        "end": 47437
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བར་"
    },
    {
      "span": {
        "start": 47694,
        "end": 47701
      },
      "text": "གདུག་པ་ ༼སྣར། པེ།༽ འདུག་པ་"
    },
    {
      "span": {
        "start": 47749,
        "end": 47758
      },
      "text": "བར་ཆད་དམ་ ༼སྣར།༽ བར་ཆད་དང་"
    },
    {
      "span": {
        "start": 47867,
        "end": 47880
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 47897,
        "end": 47907
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ སྒོམ་པའི་"
    },
    {
      "span": {
        "start": 48004,
        "end": 48010
      },
      "text": "བྱས་པ་ ༼སྣར། པེ།༽ བྱས་པ་ལ་"
    },
    {
      "span": {
        "start": 48068,
        "end": 48074
      },
      "text": "བྱས་ན་ ༼སྣར། པེ།༽ བྱས་ནས་"
    },
    {
      "span": {
        "start": 48088,
        "end": 48127
      },
      "text": "འགྱོད་པའི་སེམས་དྲག་པོ་འཐོབ་ཅིང་འགྱོད་པ་ ༼སྣར། པེ།༽ འགྱོད་པ་"
    },
    {
      "span": {
        "start": 48157,
        "end": 48159
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 48192,
        "end": 48198
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 48320,
        "end": 48328
      },
      "text": "བྱེ་བྲག་ ༼སྣར། པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 49254,
        "end": 49264
      },
      "text": "འགྲུབ་པའི་ ༼སྣར། པེ།༽ སྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 49332,
        "end": 49339
      },
      "text": "རྣམས་ལ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 50221,
        "end": 50231
      },
      "text": "སྤྱོད་པ་ལ་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 50546,
        "end": 50552
      },
      "text": "ཞི་བར་ ༼སྣར། པེ།༽ ཞི་བར་མི་"
    },
    {
      "span": {
        "start": 50651,
        "end": 50660
      },
      "text": "བརྗེད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 50699,
        "end": 50705
      },
      "text": "བརྗེད་ ༼སྣར། པེ།༽ རྗེད་"
    },
    {
      "span": {
        "start": 50753,
        "end": 50755
      },
      "text": "ན་ ༼སྣར། པེ།༽ ན་དེ་"
    },
    {
      "span": {
        "start": 50827,
        "end": 50834
      },
      "text": "མི་བདེ་ ༼སྣར། པེ།༽ མི་དགེ་"
    },
    {
      "span": {
        "start": 51080,
        "end": 51088
      },
      "text": "དེ་ལྟ་ན་ ༼སྣར། པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 51426,
        "end": 51436
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 51507,
        "end": 51514
      },
      "text": "འདུལ་བ་ ༼སྣར།༽ འདུལ་བ་ལ་"
    },
    {
      "span": {
        "start": 51539,
        "end": 51556
      },
      "text": "བྱེད་དྲན་པར་བྱེད་ ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 51700,
        "end": 51708
      },
      "text": "སྨོས་པར་ ༼སྣར། པེ།༽ མོས་པར་"
    },
    {
      "span": {
        "start": 51838,
        "end": 51841
      },
      "text": "དེ་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 51860,
        "end": 51873
      },
      "text": "དགེ་སློང་གིས་ ༼སྣར། པེ།༽ དགེ་སློང་གི་"
    },
    {
      "span": {
        "start": 52018,
        "end": 52020
      },
      "text": "ན་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 52179,
        "end": 52189
      },
      "text": "གླེངས་པའི་ ༼སྣར། པེ།༽ གླེང་བའི་"
    },
    {
      "span": {
        "start": 52303,
        "end": 52311
      },
      "text": "བརྩལ་བར་ ༼སྣར། པེ།༽ བརྩད་པར་"
    },
    {
      "span": {
        "start": 52341,
        "end": 52351
      },
      "text": "གདབ་པར་ཡང་ ༼སྣར། པེ།༽ གདབ་པར་"
    },
    {
      "span": {
        "start": 52373,
        "end": 52383
      },
      "text": "རྩོད་པ་དེ་ ༼སྣར། པེ།༽ རྩོད་པ་"
    },
    {
      "span": {
        "start": 52406,
        "end": 52410
      },
      "text": "གནས་ ༼སྣར།༽ ། །"
    },
    {
      "span": {
        "start": 52428,
        "end": 52437
      },
      "text": "དགེ་སློང་ ༼སྣར།༽ དགེ་སློང་མང་པོ་"
    },
    {
      "span": {
        "start": 52452,
        "end": 52457
      },
      "text": "ལྟུང་ ༼སྣར།༽ ལྟུང་བ་ལྟུང་"
    },
    {
      "span": {
        "start": 52570,
        "end": 52580
      },
      "text": "གནས་གཞན་ལ་ ༼སྣར། པེ།༽ གནས་"
    },
    {
      "span": {
        "start": 52699,
        "end": 52707
      },
      "text": "བསྟན་པར་ ༼སྣར། པེ།༽ བསྟེན་པར་"
    },
    {
      "span": {
        "start": 52853,
        "end": 52872
      },
      "text": "གཞན་དག་གིས་གླེང་གི་ ༼སྣར། པེ།༽ གཞན་དག་གིསགླེངས་ཀྱི་"
    },
    {
      "span": {
        "start": 53037,
        "end": 53043
      },
      "text": "བཅད་པ་ ༼སྣར། པེ།༽ གཅད་པ་"
    },
    {
      "span": {
        "start": 53202,
        "end": 53204
      },
      "text": "ལ། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 53586,
        "end": 53594
      },
      "text": "རྣམ་བཞི་ ༼སྣར། པེ།༽ རྣམ་པ་གཞི་"
    },
    {
      "span": {
        "start": 53752,
        "end": 53761
      },
      "text": "བསམས་པའི་ ༼སྣར། པེ།༽ བསམ་པའི་"
    },
    {
      "span": {
        "start": 53811,
        "end": 53817
      },
      "text": "དག་པས་ ༼སྣར། པེ།༽ དག་པ་"
    },
    {
      "span": {
        "start": 53823,
        "end": 53826
      },
      "text": "པས་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 54561,
        "end": 54568
      },
      "text": "མཐའ་ཡས་ ༼སྣར། པེ།༽ མཐས་"
    },
    {
      "span": {
        "start": 54711,
        "end": 54716
      },
      "text": "བྱེད་ ༼སྣར། པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 55059,
        "end": 55063
      },
      "text": "ཀྱང་ ༼སྣར། པེ།༽ ཀྱང་མ་ཡིན་ངག་གིས་ཀྱང་"
    },
    {
      "span": {
        "start": 55401,
        "end": 55407
      },
      "text": "ཇི་ལྟ་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 55471,
        "end": 55473
      },
      "text": "པ་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 55491,
        "end": 55501
      },
      "text": "རྟོག་པ་དག་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 55501,
        "end": 55503
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་མི་དགེ་བའི་"
    },
    {
      "span": {
        "start": 55560,
        "end": 55574
      },
      "text": "དངོས་པོ་རྣམ་པ་ ༼སྣར། པེ།༽ དངོས་པོ་རྣམས་"
    },
    {
      "span": {
        "start": 55733,
        "end": 55739
      },
      "text": "གང་ལས་ ༼སྣར། པེ།༽ གང་ལ་"
    },
    {
      "span": {
        "start": 56037,
        "end": 56042
      },
      "text": "བྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 56115,
        "end": 56124
      },
      "text": "མེད་པ་ནི་ ༼སྣར། པེ།༽ མེད་པ་མི་"
    },
    {
      "span": {
        "start": 56308,
        "end": 56315
      },
      "text": "བསམས་པ་ ༼སྣར།༽ བསམ་པ་"
    },
    {
      "span": {
        "start": 56334,
        "end": 56342
      },
      "text": "ཉེས་བྱས་ ༼སྣར། པེ།༽ ཉེས་བྱས་ཕྱི་"
    },
    {
      "span": {
        "start": 56380,
        "end": 56387
      },
      "text": "བསམས་པ་ ༼སྣར།༽ བསམ་པ་"
    },
    {
      "span": {
        "start": 56431,
        "end": 56440
      },
      "text": "འདས་ཀྱིས་ ༼སྣར།༽ འདས་ཀྱི་"
    },
    {
      "span": {
        "start": 56531,
        "end": 56536
      },
      "text": "ཕྱིར་ ༼སྣར། པེ།༽ སྤྱིར་"
    },
    {
      "span": {
        "start": 56648,
        "end": 56657
      },
      "text": "ཡིན་པ་དེ་ ༼སྣར། པེ།༽ ཡིན་པ་"
    },
    {
      "span": {
        "start": 56946,
        "end": 56954
      },
      "text": "དབྱེ་བས་ ༼སྣར། པེ།༽ དབྱེ་བ་"
    },
    {
      "span": {
        "start": 57079,
        "end": 57084
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིས་"
    },
    {
      "span": {
        "start": 57676,
        "end": 57685
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 57768,
        "end": 57771
      },
      "text": "ལས་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 57878,
        "end": 57884
      },
      "text": "སྨས་པ་ ༼སྣར། པེ།༽ སྨྲས་པ་"
    },
    {
      "span": {
        "start": 58164,
        "end": 58170
      },
      "text": "འོས་པ་ ༼སྣར།༽ འོས་པ་མ་"
    },
    {
      "span": {
        "start": 58205,
        "end": 58213
      },
      "text": "བརྟགས་ན་ ༼སྣར། པེ།༽ བརྟགས་ནས་"
    },
    {
      "span": {
        "start": 58255,
        "end": 58261
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 58372,
        "end": 58382
      },
      "text": "མདོར་བསྡུ་ ༼སྣར། པེ།༽ མདོར་བསྡུས་"
    },
    {
      "span": {
        "start": 58468,
        "end": 58477
      },
      "text": "བསླང་བའི་ ༼སྣར། པེ།༽ བསླངས་པའི་"
    },
    {
      "span": {
        "start": 58937,
        "end": 58952
      },
      "text": "འགྱུར་བའི་ཕྱིར་ ༼སྣར། པེ།༽ འགྱུར་བའི་"
    },
    {
      "span": {
        "start": 59323,
        "end": 59327
      },
      "text": "བླང་ ༼སྣར། པེ།༽ བསླང་"
    },
    {
      "span": {
        "start": 59526,
        "end": 59537
      },
      "text": "དེ་དུས་དུས་ ༼སྣར། པེ།༽ དེ་དུས་"
    },
    {
      "span": {
        "start": 59687,
        "end": 59698
      },
      "text": "འགྱུར་བ་དེ་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 59881,
        "end": 59888
      },
      "text": "བླངས་པ་ ༼སྣར། པེ།༽ བླང་བ་"
    },
    {
      "span": {
        "start": 59911,
        "end": 59923
      },
      "text": "བྱ་བའི་ཕྱིར་ ༼སྣར། པེ།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 60430,
        "end": 60440
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 60963,
        "end": 60971
      },
      "text": "གོམས་པར་ ༼སྣར། པེ།༽ གོམས་པ་"
    },
    {
      "span": {
        "start": 61356,
        "end": 61359
      },
      "text": "ལྟ་ ༼སྣར། པེ།༽ བལྟ་"
    },
    {
      "span": {
        "start": 61485,
        "end": 61492
      },
      "text": "འཚེག་པ་ ༼སྣར། པེ།༽ འཆག་པ་"
    },
    {
      "span": {
        "start": 61529,
        "end": 61538
      },
      "text": "འཚེག་པའི་ ༼སྣར། པེ།༽ འཆག་པའི་"
    },
    {
      "span": {
        "start": 61605,
        "end": 61615
      },
      "text": "གསུམ་གྱིས་ ༼སྣར།༽ གསུམ་གྱི་"
    },
    {
      "span": {
        "start": 62088,
        "end": 62104
      },
      "text": "རྒྱས་པས་བྱིས་པས་ ༼སྣར། པེ།༽ རྒྱས་པས་"
    },
    {
      "span": {
        "start": 62256,
        "end": 62263
      },
      "text": "བསླབ་པ་ ༼པེ།༽ སླབ་པ་"
    },
    {
      "span": {
        "start": 62564,
        "end": 62566
      },
      "text": "ས་ ༼སྣར། པེ།༽ སར་"
    },
    {
      "span": {
        "start": 63110,
        "end": 63132
      },
      "text": "བརྟེན་ནས་འཇིག་རྟེན་དང་ ༼སྣར། པེ།༽ བརྟེན་ནས་"
    },
    {
      "span": {
        "start": 63167,
        "end": 63176
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་ལ་"
    },
    {
      "span": {
        "start": 63297,
        "end": 63306
      },
      "text": "སྤངས་པའི་ ༼སྣར། པེ།༽ སྤང་བའི་"
    },
    {
      "span": {
        "start": 63478,
        "end": 63487
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 63661,
        "end": 63668
      },
      "text": "འདོད་པ་ ༼སྣར། པེ།༽ འདོད་པས་"
    },
    {
      "span": {
        "start": 63981,
        "end": 63991
      },
      "text": "གཞན་དག་གི་ ༼སྣར།༽ གཞན་དག་ནི་"
    },
    {
      "span": {
        "start": 64215,
        "end": 64226
      },
      "text": "སྒྱུ་བག་ཏུ་ ༼སྣར། པེ།༽ སྒྱུ་བག་"
    },
    {
      "span": {
        "start": 64465,
        "end": 64471
      },
      "text": "དྲང་བ་ ༼སྣར། པེ།༽ དྲང་པོ་"
    },
    {
      "span": {
        "start": 64491,
        "end": 64496
      },
      "text": "ལ་ཅི་ ༼སྣར།༽ ལ་མི་"
    },
    {
      "span": {
        "start": 64531,
        "end": 64539
      },
      "text": "བདག་གིར་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 64553,
        "end": 64555
      },
      "text": "བ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 64707,
        "end": 64713
      },
      "text": "ཆོས་ལ་ ༼སྣར། པེ།༽ ཆོས་"
    },
    {
      "span": {
        "start": 64848,
        "end": 64858
      },
      "text": "བྱེད་པ་ཡང་ ༼སྣར། པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 64881,
        "end": 64893
      },
      "text": "ལྟུང་བ་བྱུང་ ༼སྣར། པེ།༽ ལྟུང་བ་"
    },
    {
      "span": {
        "start": 64936,
        "end": 64941
      },
      "text": "དྲིས་ ༼སྣར། པེ།༽ དྲིས་པ་"
    },
    {
      "span": {
        "start": 65073,
        "end": 65081
      },
      "text": "རིགས་པར་ ༼སྣར།༽ རིག་པར་"
    },
    {
      "span": {
        "start": 65161,
        "end": 65176
      },
      "text": "འགྱུར་བ་ཡིན་པར་ ༼སྣར། པེ།༽ འགྱུར་བར་"
    },
    {
      "span": {
        "start": 65217,
        "end": 65227
      },
      "text": "བརྩོན་པའི་ ༼སྣར། པེ།༽ བརྩོན་པ་"
    },
    {
      "span": {
        "start": 65570,
        "end": 65589
