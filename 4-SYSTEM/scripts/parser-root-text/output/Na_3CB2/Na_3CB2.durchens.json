{
  "durchens": [
    {
      "span": {
        "start": 298,
        "end": 307
      },
      "text": "འཇུག་པའི་ ༼སྣར།༽ འཇུག་པར་"
    },
    {
      "span": {
        "start": 322,
        "end": 331
      },
      "text": "བརྟག་པའི་ ༼སྣར། པེ།༽ བརྟགས་པའི་"
    },
    {
      "span": {
        "start": 379,
        "end": 384
      },
      "text": "བརྟག་ ༼སྣར། པེ།༽ རྟག་"
    },
    {
      "span": {
        "start": 643,
        "end": 648
      },
      "text": "བརྟག་ ༼སྣར། པེ།༽ རྟག་"
    },
    {
      "span": {
        "start": 748,
        "end": 752
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 772,
        "end": 783
      },
      "text": "འཇུག་པ་ཤེས་ ༼སྣར། པེ།༽ འཇུག་པ་ཞེས་"
    },
    {
      "span": {
        "start": 1320,
        "end": 1327
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 1365,
        "end": 1398
      },
      "text": "མཚན་ཉིད་འདོད། །འཁྲུལ་པའི་དངོས་པོ་ ༼སྣར། པེ།༽ མཚན་པོས་"
    },
    {
      "span": {
        "start": 1450,
        "end": 1457
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ན་"
    },
    {
      "span": {
        "start": 1720,
        "end": 1729
      },
      "text": "བདག་གཉིས་ ༼སྣར། པེ།༽ བདག་ཉིད་"
    },
    {
      "span": {
        "start": 1959,
        "end": 1968
      },
      "text": "གཅིག་གིས་ ༼སྣར། པེ།༽ གཅིག་གི་"
    },
    {
      "span": {
        "start": 1972,
        "end": 1977
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 2650,
        "end": 2659
      },
      "text": "དབྱེ་བའི་ ༼སྣར། པེ།༽ རང་བཞིན་"
    },
    {
      "span": {
        "start": 2775,
        "end": 2778
      },
      "text": "ཆད་ ༼སྣར།༽ ཆ་"
    },
    {
      "span": {
        "start": 2803,
        "end": 2810
      },
      "text": "འདོད་མ་ ༼སྣར། པེ།༽ འདོད་པ་"
    },
    {
      "span": {
        "start": 3183,
        "end": 3188
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 3409,
        "end": 3417
      },
      "text": "སྒྱུ་མས་ ༼སྣར།༽ རྒྱུ་མས་"
    },
    {
      "span": {
        "start": 3448,
        "end": 3461
      },
      "text": "བདག་ཉིད་ཀྱིས་ ༼སྣར།༽ བདག་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 3541,
        "end": 3549
      },
      "text": "པར་བཞིན་ ༼སྣར། པེ།༽ རང་བཞིན་"
    },
    {
      "span": {
        "start": 3635,
        "end": 3642
      },
      "text": "རྩ་བའི་ ༼སྣར། པེ།༽ རྩ་བ་"
    },
    {
      "span": {
        "start": 3682,
        "end": 3688
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 3877,
        "end": 3887
      },
      "text": "རྟོགས་པའི་ ༼སྣར། པེ།༽ རྟོག་པའི་"
    },
    {
      "span": {
        "start": 4094,
        "end": 4101
      },
      "text": "གཉིས་ཀ་ ༼སྣར། པེ།༽ གཉི་ག་"
    },
    {
      "span": {
        "start": 4120,
        "end": 4129
      },
      "text": "གཉིས་ཀྱི་ ༼སྣར། པེ།༽ གཉིས་ཀྱིས་"
    }
  ]
}