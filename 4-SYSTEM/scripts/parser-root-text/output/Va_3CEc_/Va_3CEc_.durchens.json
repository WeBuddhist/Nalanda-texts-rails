{
  "durchens": [
    {
      "span": {
        "start": 182,
        "end": 185
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 199,
        "end": 208
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་དཔས་"
    },
    {
      "span": {
        "start": 270,
        "end": 307
      },
      "text": "འགྱུར་དང་། །ཇི་ལྟར་གཞན་ཕན་བྱེད་འགྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 378,
        "end": 385
      },
      "text": "གཏང་བར་ ༼སྣར། པེ།༽ བཏང་བར་"
    },
    {
      "span": {
        "start": 527,
        "end": 533
      },
      "text": "དང་། ། ༼སྣར། པེ།༽ ། །རང་"
    },
    {
      "span": {
        "start": 550,
        "end": 559
      },
      "text": "ཆེ་ལ་བསམ། ༼སྣར། པེ།༽ ཆེ་བསམས།"
    },
    {
      "span": {
        "start": 705,
        "end": 712
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 954,
        "end": 964
      },
      "text": "མཆོག་མཆོད་ ༼སྣར། པེ།༽ ཆོག་ཤེས་"
    },
    {
      "span": {
        "start": 992,
        "end": 997
      },
      "text": "མྱོང་ ༼པེ།༽ སྨྱོང་"
    },
    {
      "span": {
        "start": 1110,
        "end": 1120
      },
      "text": "ཐོབ་པ་ཡིས། ༼སྣར། པེ།༽ ཐོབ་པ་ཡི།"
    },
    {
      "span": {
        "start": 1130,
        "end": 1143
      },
      "text": "གནས་སྐབས་ཐོབ་ ༼སྣར། པེ།༽ གནས་སྐབས་"
    },
    {
      "span": {
        "start": 1143,
        "end": 1146
      },
      "text": "གང་ ༼སྣར། པེ།༽ གང་ཐོབ་"
    },
    {
      "span": {
        "start": 1261,
        "end": 1267
      },
      "text": "བསྟབས། ༼སྣར། པེ།༽ བསྟབ།"
    },
    {
      "span": {
        "start": 1329,
        "end": 1333
      },
      "text": "གཞག་ ༼སྣར། པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 1380,
        "end": 1387
      },
      "text": "ཉི་ལྟར་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 1427,
        "end": 1431
      },
      "text": "བྱས། ༼སྣར། པེ།༽ བྱ།"
    },
    {
      "span": {
        "start": 1631,
        "end": 1636
      },
      "text": "གཤེག་ ༼སྣར། པེ།༽ གཤེགས་"
    },
    {
      "span": {
        "start": 1666,
        "end": 1673
      },
      "text": "བཏགས་པ་ ༼སྣར། པེ།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 1757,
        "end": 1761
      },
      "text": "འདྲ་ ༼སྣར། པེ།༽ འདྲར་"
    },
    {
      "span": {
        "start": 1936,
        "end": 1945
      },
      "text": "མཐོན་པོར་ ༼སྣར། པེ།༽ མཐོན་པོ་"
    },
    {
      "span": {
        "start": 2015,
        "end": 2020
      },
      "text": "སྐོམ་ ༼སྣར། པེ།༽ བསྐོམ་"
    },
    {
      "span": {
        "start": 2027,
        "end": 2030
      },
      "text": "པས། ༼སྣར། པེ།༽ པའི།"
    },
    {
      "span": {
        "start": 2068,
        "end": 2076
      },
      "text": "སྐྱུག་པ་ ༼སྣར། པེ།༽ སྐྱུགས་པ་"
    },
    {
      "span": {
        "start": 2076,
        "end": 2084
      },
      "text": "ཟ་བ་དང་། ༼སྣར། པེ།༽ ཟ་བ་སྟེ།"
    },
    {
      "span": {
        "start": 2180,
        "end": 2187
      },
      "text": "གཟིར་བ་ ༼སྣར། པེ།༽ གཟིར་བས་"
    },
    {
      "span": {
        "start": 2192,
        "end": 2194
      },
      "text": "བ་ ༼སྣར། པེ།༽ བར་"
    },
    {
      "span": {
        "start": 2231,
        "end": 2233
      },
      "text": "པ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 2570,
        "end": 2586
      },
      "text": "བསྲེགས་འགྱུར་ལས། ༼སྣར། པེ།༽ སྲེགས་གྱུར་པས།"
    },
    {
      "span": {
        "start": 2673,
        "end": 2679
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 2697,
        "end": 2702
      },
      "text": "གཡེང་ ༼སྣར། པེ།༽ གཡེངས་"
    },
    {
      "span": {
        "start": 2768,
        "end": 2778
      },
      "text": "ཁྱབ་པ་ཡིས། ༼སྣར། པེ།༽ ཁྱབ་པ་ཡི།"
    },
    {
      "span": {
        "start": 2874,
        "end": 2877
      },
      "text": "ལྷ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 3068,
        "end": 3073
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 3080,
        "end": 3085
      },
      "text": "བྱའི་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 3404,
        "end": 3411
      },
      "text": "རིང་མོ་ ༼སྣར། པེ།༽ རིང་མོར་"
    },
    {
      "span": {
        "start": 3631,
        "end": 3643
      },
      "text": "ཆོས་ཅན་གྱིས། ༼སྣར། པེ།༽ ཆོས་ཅན་གྱི།"
    },
    {
      "span": {
        "start": 3657,
        "end": 3659
      },
      "text": "ན་ ༼ཅོ།༽ ནི་"
    },
    {
      "span": {
        "start": 3697,
        "end": 3702
      },
      "text": "བས་ན། ༼སྣར། པེ།༽ བས་ནས།"
    },
    {
      "span": {
        "start": 4007,
        "end": 4010
      },
      "text": "བླ་ ༼སྣར།༽ བླ་ན་"
    },
    {
      "span": {
        "start": 4265,
        "end": 4267
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 4291,
        "end": 4298
      },
      "text": "གོམས་པ་ ༼སྣར། པེ།༽ བསྒོམས་པ་"
    },
    {
      "span": {
        "start": 4518,
        "end": 4521
      },
      "text": "ལག་ ༼སྣར།༽ ལག་ང་"
    },
    {
      "span": {
        "start": 4695,
        "end": 4703
      },
      "text": "སྨྲ་བའམ། ༼སྣར། པེ།༽ སྨྲ་འམ།"
    }
  ]
}