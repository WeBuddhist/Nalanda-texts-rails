{
  "durchens": [
    {
      "span": {
        "start": 274,
        "end": 279
      },
      "text": "གསུང་ ༼སྣར། པེ།༽ གསུངས་"
    },
    {
      "span": {
        "start": 753,
        "end": 758
      },
      "text": "བརྩམ། ༼སྣར།༽ བཙམ།"
    },
    {
      "span": {
        "start": 796,
        "end": 803
      },
      "text": "གཟའ་དེ་ ༼སྣར། པེ།༽ གཟའ་སྟེ་"
    },
    {
      "span": {
        "start": 1039,
        "end": 1043
      },
      "text": "བཟང་ ༼སྣར། པེ།༽ བཟངས་"
    },
    {
      "span": {
        "start": 1084,
        "end": 1097
      },
      "text": "ཆུ་སྟོད་ཀྱིས་ ༼སྣར། པེ།༽ ཆུ་སྟོད་ཀྱི་"
    },
    {
      "span": {
        "start": 1164,
        "end": 1172
      },
      "text": "བརྟན་པར་ ༼སྣར། པེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 1275,
        "end": 1282
      },
      "text": "དར་གུད་ ༼སྣར། པེ།༽ དར་རྒུད་"
    },
    {
      "span": {
        "start": 1698,
        "end": 1703
      },
      "text": "བརྩི་ ༼སྣར། པེ།༽ རྩི་"
    },
    {
      "span": {
        "start": 1864,
        "end": 1875
      },
      "text": "ལ་སོགས་ཀྱི། ༼སྣར། པེ།༽ ལ་སོགས་ཀྱིས།"
    },
    {
      "span": {
        "start": 2066,
        "end": 2071
      },
      "text": "འབུར་ ༼སྣར།༽ འཁུར་"
    },
    {
      "span": {
        "start": 2145,
        "end": 2153
      },
      "text": "ཚད་ཀྱིས་ ༼པེ།༽ ཚད་ཀྱི་"
    },
    {
      "span": {
        "start": 2397,
        "end": 2402
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 2540,
        "end": 2545
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 2865,
        "end": 2873
      },
      "text": "ཕྲིན་ལས་ ༼སྣར། པེ།༽ འཕྲིན་ལས་"
    },
    {
      "span": {
        "start": 2910,
        "end": 2917
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 2963,
        "end": 2966
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 3071,
        "end": 3079
      },
      "text": "མཆོད་པར་ ༼ཅོ།༽ མཆོད་པ་"
    },
    {
      "span": {
        "start": 3116,
        "end": 3124
      },
      "text": "རིག་པའི་ ༼སྣར། པེ།༽ རིམ་པའི་"
    },
    {
      "span": {
        "start": 3153,
        "end": 3162
      },
      "text": "ཀུན་གྱིས་ ༼སྣར། པེ།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 3589,
        "end": 3597
      },
      "text": "ཆགས་པ་ལ། ༼ཅོ།༽ ཆགས་པ་དང་ ༼པེ།༽ ཆགས་ལ།"
    },
    {
      "span": {
        "start": 3612,
        "end": 3620
      },
      "text": "བསྟེན་མ་ ༼སྣར། པེ།༽ བསྟན་མ་"
    },
    {
      "span": {
        "start": 3877,
        "end": 3881
      },
      "text": "བཞག་ ༼སྣར། པེ།༽ གཞག་"
    },
    {
      "span": {
        "start": 4136,
        "end": 4150
      },
      "text": "སྐྱེ་བོ་ཡིས། ། ༼སྣར། པེ།༽ སྐྱེ་བོ་ཡི་"
    },
    {
      "span": {
        "start": 4396,
        "end": 4399
      },
      "text": "ལས་ ༼སྣར། པེ།༽ པས་"
    },
    {
      "span": {
        "start": 4596,
        "end": 4601
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 4718,
        "end": 4724
      },
      "text": "ཚད་ཙམ་ ༼སྣར། པེ།༽ ཆ་ཙམ་"
    },
    {
      "span": {
        "start": 4879,
        "end": 4883
      },
      "text": "འོང་ ༼སྣར། པེ།༽ འོངས་"
    },
    {
      "span": {
        "start": 5221,
        "end": 5231
      },
      "text": "། །ངན་པའི་ ༼སྣར། པེ།༽ ། །བའི་"
    },
    {
      "span": {
        "start": 5335,
        "end": 5338
      },
      "text": "ཚང་ ༼སྣར། པེ།༽ ཆང་"
    },
    {
      "span": {
        "start": 5390,
        "end": 5395
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ སྟེན་"
    },
    {
      "span": {
        "start": 5405,
        "end": 5410
      },
      "text": "བ་ཡི་ ༼སྣར། པེ།༽ བ་ཡིས་"
    },
    {
      "span": {
        "start": 5515,
        "end": 5521
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 5541,
        "end": 5550
      },
      "text": "སྲུང་བའི་ ༼སྣར།༽ བསུང་བའི་ ༼པེ།༽ བསྲུངས་པའི་"
    },
    {
      "span": {
        "start": 5754,
        "end": 5758
      },
      "text": "རེག་ ༼སྣར། པེ།༽ རེགས་"
    },
    {
      "span": {
        "start": 5964,
        "end": 5969
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 6033,
        "end": 6039
      },
      "text": "གཡོགས་ ༼སྣར། པེ།༽ གཡོག་"
    },
    {
      "span": {
        "start": 6073,
        "end": 6076
      },
      "text": "སྟ་ ༼སྣར། པེ།༽ ཏ་"
    },
    {
      "span": {
        "start": 6265,
        "end": 6269
      },
      "text": "གནད། ༼སྣར། པེ།༽ གནང་།"
    },
    {
      "span": {
        "start": 6285,
        "end": 6290
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 6298,
        "end": 6302
      },
      "text": "གནད། ༼སྣར། པེ།༽ གནང་།"
    },
    {
      "span": {
        "start": 6432,
        "end": 6437
      },
      "text": "རེངས་ ༼ཅོ།༽ རིངས་ ༼སྣར། པེ།༽ རེང་"
    },
    {
      "span": {
        "start": 6506,
        "end": 6510
      },
      "text": "དྲི་ ༼སྡེ།༽ དྲིལ་"
    },
    {
      "span": {
        "start": 6794,
        "end": 6798
      },
      "text": "མེས་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 6815,
        "end": 6819
      },
      "text": "གཡམ་ ༼སྣར། པེ།༽ གཡེམ་"
    },
    {
      "span": {
        "start": 7102,
        "end": 7106
      },
      "text": "སྤུ་ ༼སྣར། པེ།༽ སྤྲུ་"
    },
    {
      "span": {
        "start": 7203,
        "end": 7209
      },
      "text": "བཞུགས་ ༼ཅོ།༽ གཞུགས་ ༼པེ།༽ ཞུགས་"
    },
    {
      "span": {
        "start": 7537,
        "end": 7541
      },
      "text": "སྙན་ ༼སྣར། པེ།༽ གཉན་"
    },
    {
      "span": {
        "start": 7627,
        "end": 7637
      },
      "text": "གྱིས་བརླབ་ ༼སྣར། པེ།༽ གྱི་བརླབས་"
    },
    {
      "span": {
        "start": 7815,
        "end": 7824
      },
      "text": "གླིང་བཞི་ ༼སྣར། པེ།༽ གླིང་བཞིའི་"
    },
    {
      "span": {
        "start": 7856,
        "end": 7871
      },
      "text": "རྟེན་འབྲེལ་གྱི། ༼སྣར། པེ།༽ རྟེན་འབྲེལ་གྱིས།"
    },
    {
      "span": {
        "start": 8063,
        "end": 8069
      },
      "text": "བསྲངས་ ༼སྣར། པེ།༽ བསྲང་"
    },
    {
      "span": {
        "start": 8129,
        "end": 8134
      },
      "text": "བརླབ། ༼སྣར། པེ།༽ བརླབས།"
    },
    {
      "span": {
        "start": 8254,
        "end": 8259
      },
      "text": "བརླབ། ༼སྣར། པེ།༽ བརླབས།"
    },
    {
      "span": {
        "start": 8425,
        "end": 8430
      },
      "text": "བརླབ། ༼སྣར། པེ།༽ བརླབས།"
    },
    {
      "span": {
        "start": 8461,
        "end": 8466
      },
      "text": "ཁྱེར་ ༼སྣར། པེ།༽ བསྒྱེར་"
    },
    {
      "span": {
        "start": 8544,
        "end": 8549
      },
      "text": "བརླབ། ༼སྣར། པེ།༽ བསླབ།"
    },
    {
      "span": {
        "start": 8669,
        "end": 8676
      },
      "text": "ཆར་ཁབས་ ༼སྣར། པེ།༽ ཆར་ཁེབས་"
    },
    {
      "span": {
        "start": 8782,
        "end": 8786
      },
      "text": "སྐས་ ༼སྣར། པེ།༽ སྐད་"
    },
    {
      "span": {
        "start": 8872,
        "end": 8878
      },
      "text": "ཡིན། ། ༼སྣར། པེ།༽ ། །གདན་ཐོ་དབུལ་བ་རྒྱས་པ་ཡིན། །"
    },
    {
      "span": {
        "start": 8998,
        "end": 9002
      },
      "text": "གཞར། ༼སྣར། པེ།༽ བཞར།"
    },
    {
      "span": {
        "start": 9028,
        "end": 9030
      },
      "text": "ས་ ༼སྣར། པེ།༽ མང་"
    },
    {
      "span": {
        "start": 9050,
        "end": 9055
      },
      "text": "འཐོག་ ༼སྣར། པེ།༽ ཐོག་"
    },
    {
      "span": {
        "start": 9078,
        "end": 9087
      },
      "text": "སྙན་སྤབས་ ༼སྣར།༽ སྙམ་སྦབས་ ༼པེ།༽ སྙན་སྦབས་"
    },
    {
      "span": {
        "start": 9151,
        "end": 9156
      },
      "text": "གསིལ། ༼སྣར། པེ།༽ སིལ།"
    },
    {
      "span": {
        "start": 9185,
        "end": 9194
      },
      "text": "ཁྲོ་བོའི་ ༼སྣར། པེ།༽ ཁྲོ་བོ་"
    },
    {
      "span": {
        "start": 9203,
        "end": 9206
      },
      "text": "དང་ ༼སྡེ།༽ དར་"
    },
    {
      "span": {
        "start": 9289,
        "end": 9303
      },
      "text": "བཀོད་དབུལ་བསམ་ ༼སྣར།༽ འགོད་འབུལ་བསམས་ ༼པེ།༽ དཀོད་འབུལ་བསམས་"
    },
    {
      "span": {
        "start": 9419,
        "end": 9424
      },
      "text": "འབྲུ་ ༼སྣར།༽ འགྲུ་"
    },
    {
      "span": {
        "start": 9475,
        "end": 9491
      },
      "text": "གླེགས་ཤིང་གླེགས་ ༼སྣར། པེ།༽ གླེགས་"
    },
    {
      "span": {
        "start": 9510,
        "end": 9515
      },
      "text": "ཁེབས་ ༼སྣར། པེ།༽ ཁབ་"
    },
    {
      "span": {
        "start": 9621,
        "end": 9624
      },
      "text": "ཡི་ ༼སྣར། པེ།༽ ཡིད་"
    },
    {
      "span": {
        "start": 9758,
        "end": 9763
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 9816,
        "end": 9821
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 9835,
        "end": 9844
      },
      "text": "ཐུགས་ཀྱི་ ༼སྣར། པེ།༽ ཐུགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 9954,
        "end": 9962
      },
      "text": "ཆོས་ཀྱི་ ༼སྣར། པེ།༽ ཆོས་ཀྱིས་"
    },
    {
      "span": {
        "start": 10224,
        "end": 10229
      },
      "text": "བཀླག་ ༼སྣར། པེ།༽ ཀླག་"
    },
    {
      "span": {
        "start": 10297,
        "end": 10302
      },
      "text": "བཅིང་ ༼སྣར། པེ།༽ བཅིངས་"
    },
    {
      "span": {
        "start": 10403,
        "end": 10412
      },
      "text": "སྐྱོན་མང་ ༼སྣར།༽ སྐྱོན་མེད་"
    },
    {
      "span": {
        "start": 10480,
        "end": 10485
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 10704,
        "end": 10709
      },
      "text": "མདུན་ ༼སྣར། པེ།༽ བདུན་"
    },
    {
      "span": {
        "start": 10724,
        "end": 10731
      },
      "text": "དྲི་ཡི་ ༼སྣར། པེ།༽ དྲི་ཡིས་"
    },
    {
      "span": {
        "start": 10781,
        "end": 10790
      },
      "text": "ལ་དབུལ་བ་ ༼སྣར། པེ།༽ ལ་འབུལ་"
    },
    {
      "span": {
        "start": 10803,
        "end": 10809
      },
      "text": "གཟེངས་ ༼ཅོ།༽ གཟེང་ ༼པེ།༽ གཟང་"
    },
    {
      "span": {
        "start": 10960,
        "end": 10964
      },
      "text": "རྣམ་ ༼པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 10976,
        "end": 10980
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 11030,
        "end": 11037
      },
      "text": "བཟོ་བོ་ ༼སྣར། པེ།༽ གཟོ་བོ་"
    },
    {
      "span": {
        "start": 11314,
        "end": 11319
      },
      "text": "དབུལ། ༼སྣར། པེ།༽ འབུལ།"
    },
    {
      "span": {
        "start": 11383,
        "end": 11387
      },
      "text": "གཏད་ ༼པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 11594,
        "end": 11603
      },
      "text": "སྔགས་ཀྱི་ ༼སྣར། པེ།༽ སྔགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 12063,
        "end": 12072
      },
      "text": "རྣམས་ཀྱི། ༼སྣར། པེ།༽ རྣམས་ཀྱིས།"
    },
    {
      "span": {
        "start": 12520,
        "end": 12525
      },
      "text": "བསྡུ། ༼སྣར། པེ།༽ སྡུ།"
    },
    {
      "span": {
        "start": 13048,
        "end": 13054
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 13154,
        "end": 13159
      },
      "text": "དྲངས་ ༼སྣར། པེ།༽ དྲང་"
    },
    {
      "span": {
        "start": 13185,
        "end": 13190
      },
      "text": "བརླབ་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 13280,
        "end": 13284
      },
      "text": "བུམ་ ༼སྣར། པེ།༽ འབུམ་"
    },
    {
      "span": {
        "start": 13309,
        "end": 13313
      },
      "text": "བདག་ ༼པེ།༽ གདབ་"
    },
    {
      "span": {
        "start": 13424,
        "end": 13433
      },
      "text": "རྡོ་རྗེས་ ༼སྣར།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 13641,
        "end": 13658
      },
      "text": "དམར་དང་པོ་ཏི་ཅོད། ༼སྣར།༽ དང་པོ་ཏི་ཅོང་ ༼པེ།༽ དང་པོ་བོ་ཏི་ཅོང་།"
    },
    {
      "span": {
        "start": 13719,
        "end": 13727
      },
      "text": "རྡོ་རྗེ་ ༼སྣར།༽ རྡོ་"
    },
    {
      "span": {
        "start": 13731,
        "end": 13736
      },
      "text": "ཕྲེང་ ༼སྣར། པེ།༽ འཕྲེང་"
    },
    {
      "span": {
        "start": 13755,
        "end": 13759
      },
      "text": "རྗེ་ ༼སྣར། པེ།༽ རྗེ་ལས་"
    },
    {
      "span": {
        "start": 13769,
        "end": 13776
      },
      "text": "བསྐྱེད། ༼སྣར། པེ།༽ སྐྱེད།"
    },
    {
      "span": {
        "start": 13913,
        "end": 13917
      },
      "text": "ལའང་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 14049,
        "end": 14054
      },
      "text": "སྲོག་ ༼སྣར།༽ སྲོགས་"
    },
    {
      "span": {
        "start": 14083,
        "end": 14088
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 14301,
        "end": 14304
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 14513,
        "end": 14520
      },
      "text": "བྱས་ཏེ། ༼སྣར།༽ བྱ་སྟེ།"
    },
    {
      "span": {
        "start": 14595,
        "end": 14603
      },
      "text": "འདྲ་བའི་ ༼སྣར།༽ དྲ་བའི་"
    },
    {
      "span": {
        "start": 14841,
        "end": 14846
      },
      "text": "བྲིས། ༼སྣར། པེ།༽ བྲི།"
    },
    {
      "span": {
        "start": 14863,
        "end": 14868
      },
      "text": "བཟོད་ ༼སྣར། པེ།༽ གཟོད་"
    },
    {
      "span": {
        "start": 14894,
        "end": 14898
      },
      "text": "ཅུང་ ༼སྣར།༽ བཅུ་ ༼པེ།༽ བཅུང་"
    },
    {
      "span": {
        "start": 15078,
        "end": 15088
      },
      "text": "གེས་བི་ཀྲ་ ༼སྣར། པེ།༽ གིས་བྲི་ག་"
    },
    {
      "span": {
        "start": 15088,
        "end": 15090
      },
      "text": "མ་ ༼སྣར། པེ།༽ མ་ལ་"
    }
  ]
}