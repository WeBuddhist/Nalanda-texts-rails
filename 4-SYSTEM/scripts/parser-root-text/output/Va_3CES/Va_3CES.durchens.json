{
  "durchens": [
    {
      "span": {
        "start": 318,
        "end": 331
      },
      "text": "རིག་བྱེད་དང་། ༼སྣར། པེ།༽ རིག་བྱེད་པ།"
    },
    {
      "span": {
        "start": 688,
        "end": 691
      },
      "text": "བྱ། ༼སྣར། པེ།༽ བྱ་ཞིང་དེས་བྱས་པ་བྱས་པའི་ལས་ཞེས་བྱ་བ་དབྱིབས།"
    },
    {
      "span": {
        "start": 753,
        "end": 756
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 784,
        "end": 790
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 990,
        "end": 1000
      },
      "text": "དགོས་ཤེ་ན། ༼སྣར། པེ།༽ དགོས་ཞེས་"
    },
    {
      "span": {
        "start": 1009,
        "end": 1013
      },
      "text": "མཆུ་ ༼སྣར། པེ།༽ ཆུ་"
    },
    {
      "span": {
        "start": 1546,
        "end": 1556
      },
      "text": "རླབས་ཀྱིས་ ༼སྣར། པེ།༽ རླབས་ཀྱི་"
    },
    {
      "span": {
        "start": 1659,
        "end": 1661
      },
      "text": "པ་ ༼སྣར།༽ པའི་"
    },
    {
      "span": {
        "start": 1919,
        "end": 1925
      },
      "text": "ཡིན་ན། ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 1947,
        "end": 1959
      },
      "text": "བྱེ་བྲག་ཞིག་ ༼སྣར། པེ།༽ བྱེ་བྲག་ཅིག་"
    },
    {
      "span": {
        "start": 1973,
        "end": 1975
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 2283,
        "end": 2285
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 2519,
        "end": 2527
      },
      "text": "བསྩགས་པ་ ༼སྣར། པེ།༽ བསགས་པ་"
    },
    {
      "span": {
        "start": 2591,
        "end": 2598
      },
      "text": "ཟན་པའི་ ༼སྣར།༽ ཟིན་པའི་"
    },
    {
      "span": {
        "start": 2613,
        "end": 2620
      },
      "text": "ཅན་གྱི་ ༼སྣར།༽ ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 2727,
        "end": 2729
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་ནི་"
    },
    {
      "span": {
        "start": 3354,
        "end": 3361
      },
      "text": "ཁྱད་པར་ ༼སྣར། པེ།༽ ཁྱད་པར་ན་"
    },
    {
      "span": {
        "start": 3610,
        "end": 3620
      },
      "text": "དབྱིབས་དག་ ༼པེ།༽ དབྱིབས་དམ་"
    },
    {
      "span": {
        "start": 3780,
        "end": 3787
      },
      "text": "གཉི་གར་ ༼སྣར། པེ།༽ གཉིས་ཀར་"
    },
    {
      "span": {
        "start": 3898,
        "end": 3905
      },
      "text": "གསལ་བས་ ༼སྣར། པེ།༽ གསལ་བར་"
    },
    {
      "span": {
        "start": 4135,
        "end": 4138
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 5378,
        "end": 5381
      },
      "text": "མེ་ ༼པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 5472,
        "end": 5479
      },
      "text": "པ་གཟུང་ ༼སྣར། པེ།༽ པའི་ཟུང་"
    },
    {
      "span": {
        "start": 5773,
        "end": 5781
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 6677,
        "end": 6684
      },
      "text": "དེ་གཞན་ ༼སྣར། པེ།༽ དེ་བཞིན་"
    },
    {
      "span": {
        "start": 6735,
        "end": 6740
      },
      "text": "བཟུང་ ༼པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 7136,
        "end": 7142
      },
      "text": "སྣང་བ་ ༼སྣར། པེ།༽ སྣང་"
    },
    {
      "span": {
        "start": 7161,
        "end": 7169
      },
      "text": "ཅི་ཞེ་ན། ༼སྣར། པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 7569,
        "end": 7573
      },
      "text": "ཤེས། ༼སྣར། པེ།༽ ཞེས།"
    },
    {
      "span": {
        "start": 8179,
        "end": 8190
      },
      "text": "ཁྱད་པར་རིག་ ༼སྣར། པེ།༽ ཁྱད་པར་གྱི་"
    },
    {
      "span": {
        "start": 8421,
        "end": 8428
      },
      "text": "རིག་པར་ ༼སྣར། པེ།༽ རིག་"
    },
    {
      "span": {
        "start": 8565,
        "end": 8575
      },
      "text": "ཁྱད་པར་ལས་ ༼སྣར། པེ།༽ ཁྱད་པར་"
    },
    {
      "span": {
        "start": 8581,
        "end": 8583
      },
      "text": "པ་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 8806,
        "end": 8814
      },
      "text": "འགྲོ་བར་ ༼སྣར། པེ།༽ འགྲོ་བ་"
    },
    {
      "span": {
        "start": 9340,
        "end": 9347
      },
      "text": "ལུས་ནི་ ༼སྣར། པེ།༽ ལུས་ཀྱིས་"
    },
    {
      "span": {
        "start": 9549,
        "end": 9560
      },
      "text": "འདོད་པ་འདི་ ༼སྣར།༽ འདོད་པ་"
    },
    {
      "span": {
        "start": 9853,
        "end": 9864
      },
      "text": "ཁ་དོག་ལྟ་བ་ ༼སྣར།༽ ཁ་དོག་ལྟར་ ༼པེ།༽ ཁ་དོག་ལྟ་"
    },
    {
      "span": {
        "start": 9965,
        "end": 9972
      },
      "text": "བྱེད་ལ་ ༼སྣར། པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 10054,
        "end": 10062
      },
      "text": "དུ་ཡང་མ་ ༼སྣར། པེ།༽ དུ་ཡང་"
    },
    {
      "span": {
        "start": 10134,
        "end": 10139
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 10345,
        "end": 10353
      },
      "text": "དེ་བས་ན་ ༼སྣར། པེ།༽ དེ་ལྟ་བས་ན་"
    },
    {
      "span": {
        "start": 10845,
        "end": 10853
      },
      "text": "བཟུང་བས་ ༼པེ།༽ གཟུང་བས་"
    },
    {
      "span": {
        "start": 11107,
        "end": 11119
      },
      "text": "སྐད་ཅིག་མའི་ ༼སྣར། པེ།༽ སྐད་ཅིག་པའི་"
    },
    {
      "span": {
        "start": 11125,
        "end": 11131
      },
      "text": "དང་མི་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 11301,
        "end": 11303
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 11428,
        "end": 11434
      },
      "text": "འོང་བ་ ༼སྣར།༽ འོང་བར་"
    },
    {
      "span": {
        "start": 11594,
        "end": 11602
      },
      "text": "བྱ་བ་ནི་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 11816,
        "end": 11828
      },
      "text": "མི་འགྱུར་ཏེ་ ༼པེ།༽ མི་འབྱུང་"
    },
    {
      "span": {
        "start": 11977,
        "end": 11983
      },
      "text": "ལྟ་སུ་ ༼སྣར། པེ།༽ ལྟ་བུ་"
    },
    {
      "span": {
        "start": 12743,
        "end": 12749
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 12908,
        "end": 12915
      },
      "text": "ཇི་ལྟར་ ༼སྣར། པེ།༽ ཇི་ལྟ་"
    },
    {
      "span": {
        "start": 12938,
        "end": 12944
      },
      "text": "ས་བོན་ ༼སྣར། པེ།༽ ས་བོན་རྙེད་"
    },
    {
      "span": {
        "start": 13231,
        "end": 13238
      },
      "text": "རྣམ་པར་ ༼སྣར།༽ རྣམ་པ་བར་"
    },
    {
      "span": {
        "start": 13355,
        "end": 13359
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ ཉིད་དེ་"
    },
    {
      "span": {
        "start": 13492,
        "end": 13505
      },
      "text": "ན་རེ་བསྩགས་པ་ ༼སྣར། པེ།༽ ན་རེ་བརྩེགས་"
    },
    {
      "span": {
        "start": 13547,
        "end": 13553
      },
      "text": "ཟེར་བ་ ༼སྣར།༽ ཟེར་"
    },
    {
      "span": {
        "start": 13568,
        "end": 13570
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 13677,
        "end": 13683
      },
      "text": "སྐྱེད་ ༼པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 13896,
        "end": 13900
      },
      "text": "དོན་ ༼སྣར། པེ།༽ དོན་གཞན་"
    },
    {
      "span": {
        "start": 14075,
        "end": 14079
      },
      "text": "པའི་ ༼སྣར། པེ།༽ པའི་འཇུག་པའི་"
    },
    {
      "span": {
        "start": 14093,
        "end": 14100
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 14217,
        "end": 14225
      },
      "text": "འགགས་པས་ ༼སྣར། པེ།༽ འགག་པས་"
    },
    {
      "span": {
        "start": 14357,
        "end": 14365
      },
      "text": "སྐྱེད་པ་ ༼སྣར། པེ།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 14597,
        "end": 14607
      },
      "text": "ཤ་དམར་པོར་ ༼སྣར། པེ།༽ ཤ་དམར་པོས་"
    },
    {
      "span": {
        "start": 14727,
        "end": 14732
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 14941,
        "end": 14945
      },
      "text": "ནུབ་ ༼སྣར། པེ།༽ ནུས་"
    },
    {
      "span": {
        "start": 15249,
        "end": 15258
      },
      "text": "སྙོམས་པར་ ༼སྣར།༽ སྙོམས་པའི་"
    },
    {
      "span": {
        "start": 15499,
        "end": 15505
      },
      "text": "མང་པོ་ ༼སྣར། པེ།༽ དབང་པོ་"
    },
    {
      "span": {
        "start": 15613,
        "end": 15618
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ གནས་"
    },
    {
      "span": {
        "start": 15787,
        "end": 15789
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 15811,
        "end": 15813
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 15946,
        "end": 15955
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 16016,
        "end": 16019
      },
      "text": "དང་ ༼སྣར།༽ དང་དང་"
    },
    {
      "span": {
        "start": 16423,
        "end": 16432
      },
      "text": "གནས་སྐབས་ ༼སྣར།༽ གནས་"
    },
    {
      "span": {
        "start": 16464,
        "end": 16469
      },
      "text": "བཤེས་ ༼སྣར། པེ།༽ གཤེས་"
    },
    {
      "span": {
        "start": 16493,
        "end": 16499
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 16965,
        "end": 16971
      },
      "text": "བརྟེན་ ༼སྣར།༽ རྟེན་"
    },
    {
      "span": {
        "start": 17014,
        "end": 17027
      },
      "text": "འདུལ་བའི་རིག་ ༼སྣར། པེ།༽ འདུས་པའི་རེག་"
    },
    {
      "span": {
        "start": 17182,
        "end": 17193
      },
      "text": "ཡང་དག་འདུས་ ༼པེ།༽ ཡང་དག་"
    },
    {
      "span": {
        "start": 17230,
        "end": 17236
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 17284,
        "end": 17292
      },
      "text": "འདུ་ཤེས་ ༼པེ།༽ འདུ་ཤེས་པ་"
    },
    {
      "span": {
        "start": 17519,
        "end": 17532
      },
      "text": "འདས་ཀྱིས་མདོ་ ༼སྣར། པེ།༽ འདས་ཀྱིས་"
    },
    {
      "span": {
        "start": 17781,
        "end": 17787
      },
      "text": "ཡིན་ན་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 17976,
        "end": 17984
      },
      "text": "ཡིད་ཀྱི་ ༼ཅོ།༽ ཡིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 17997,
        "end": 18005
      },
      "text": "འབའ་ཞིག་ ༼སྣར།༽ འབའ་ཤིག་"
    },
    {
      "span": {
        "start": 18700,
        "end": 18716
      },
      "text": "། ཉོན་མོངས་པ་ཡང་ ༼སྣར། པེ།༽ ཉོན་མོངས་པ་"
    },
    {
      "span": {
        "start": 19242,
        "end": 19250
      },
      "text": "སྐྱེས་པ་ ༼སྣར། པེ།༽ སྐྱེས་པ་ཞིག་"
    },
    {
      "span": {
        "start": 19257,
        "end": 19266
      },
      "text": "ཇི་ལྟར་ན་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 20063,
        "end": 20068
      },
      "text": "འཐོབ་ ༼སྣར།༽ ཐོབ་"
    },
    {
      "span": {
        "start": 20335,
        "end": 20342
      },
      "text": "ཡོད་དེ། ༼སྣར། པེ།༽ ཡོད་"
    },
    {
      "span": {
        "start": 20415,
        "end": 20422
      },
      "text": "ཡིན་པས་ ༼སྣར། པེ།༽ ཡིན་པར་"
    },
    {
      "span": {
        "start": 20612,
        "end": 20620
      },
      "text": "ཚོར་བའི་ ༼སྣར། པེ།༽ ཚོར་བ་"
    },
    {
      "span": {
        "start": 20801,
        "end": 20808
      },
      "text": "ལགས་ཏེ། ༼སྣར། པེ།༽ ལགས་"
    },
    {
      "span": {
        "start": 20946,
        "end": 20955
      },
      "text": "སྙོམས་པར་ ༼པེ།༽ སྙོམས་པའི་"
    },
    {
      "span": {
        "start": 20967,
        "end": 20970
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 21164,
        "end": 21168
      },
      "text": "ཡིན། ༼སྣར།༽ ཡིན་ནོ། །"
    },
    {
      "span": {
        "start": 21358,
        "end": 21364
      },
      "text": "དེ་དེ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 21578,
        "end": 21585
      },
      "text": "བཅས་པར་ ༼སྣར། པེ།༽ བཅས་པས་"
    },
    {
      "span": {
        "start": 21921,
        "end": 21932
      },
      "text": "རྒྱུན་གྱིས་ ༼སྣར། པེ།༽ རྒྱུན་གྱི་"
    },
    {
      "span": {
        "start": 22350,
        "end": 22359
      },
      "text": "གཉིས་པ་མ་ ༼སྣར།༽ གཉིས་པ་"
    },
    {
      "span": {
        "start": 22709,
        "end": 22718
      },
      "text": "རྙེད་པའི་ ༼སྣར། པེ།༽ སྙེད་པས་"
    },
    {
      "span": {
        "start": 22722,
        "end": 22724
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ཀྱི་"
    },
    {
      "span": {
        "start": 22841,
        "end": 22847
      },
      "text": "ཁོང་ན་ ༼སྣར། པེ།༽ ཁོ་ན་"
    },
    {
      "span": {
        "start": 22989,
        "end": 22997
      },
      "text": "རིགས་པར་ ༼སྣར། པེ།༽ རིག་པར་"
    },
    {
      "span": {
        "start": 22997,
        "end": 23004
      },
      "text": "སྒོ་བར་ ༼སྣར། པེ།༽ བསྒོ་བར་"
    },
    {
      "span": {
        "start": 23049,
        "end": 23055
      },
      "text": "ཇི་ལྟ་ ༼སྣར།༽ ཇི་ལྟ་ལ་"
    },
    {
      "span": {
        "start": 23170,
        "end": 23193
      },
      "text": "། གནས་བརྟན་རྟ་སྐད་ཀྱིས། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 23297,
        "end": 23305
      },
      "text": "བརྟས་པར་ ༼སྣར། པེ།༽ རྟས་པར་"
    },
    {
      "span": {
        "start": 23814,
        "end": 23824
      },
      "text": "ཀུན་གཞིའི་ ༼སྣར། པེ།༽ ཀུན་གཞི་"
    },
    {
      "span": {
        "start": 24029,
        "end": 24037
      },
      "text": "འཆི་བའི་ ༼སྣར། པེ།༽ འཚོ་བའི་"
    },
    {
      "span": {
        "start": 25482,
        "end": 25493
      },
      "text": "རྣམ་པར་ཤེས་ ༼སྣར། པེ།༽ སེམས་"
    },
    {
      "span": {
        "start": 25596,
        "end": 25604
      },
      "text": "ཤེས་པའི་ ༼སྣར། པེ།༽ ཤེས་པ་གང་ཞེ་ན། རྣམ་པར་ཤེས་པའི་"
    },
    {
      "span": {
        "start": 25641,
        "end": 25645
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདི་ཇི་"
    },
    {
      "span": {
        "start": 25705,
        "end": 25713
      },
      "text": "འདུ་ཤེས་ ༼སྣར། པེ།༽ འདུ་བྱེད་"
    },
    {
      "span": {
        "start": 25914,
        "end": 25919
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 26298,
        "end": 26308
      },
      "text": "ས་བོན་གྱི་ ༼སྣར། པེ།༽ ས་བོན་གྱིས་"
    },
    {
      "span": {
        "start": 26329,
        "end": 26336
      },
      "text": "དཔོག་པ་ ༼སྣར། པེ།༽ དཔག་པ་"
    },
    {
      "span": {
        "start": 26469,
        "end": 26474
      },
      "text": "འདིས་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 26502,
        "end": 26510
      },
      "text": "ཤེས་པའི་ ༼སྣར། པེ།༽ ཤེས་པ་རྣམ་པར་ཤེས་པའི་"
    },
    {
      "span": {
        "start": 26622,
        "end": 26629
      },
      "text": "སྣང་ངོ་ ༼སྣར། པེ།༽ སྣང་"
    },
    {
      "span": {
        "start": 26670,
        "end": 26675
      },
      "text": "ལྡངས་ ༼སྣར། པེ།༽ ལྷངས་"
    },
    {
      "span": {
        "start": 26777,
        "end": 26783
      },
      "text": "རྒྱུད་ ༼སྣར། པེ།༽ རྒྱུན་"
    },
    {
      "span": {
        "start": 27012,
        "end": 27020
      },
      "text": "ལྟ་བུའོ་ ༼སྣར། པེ།༽ ལྟ་བུ་"
    },
    {
      "span": {
        "start": 27191,
        "end": 27199
      },
      "text": "བསྒོ་བར་ ༼སྣར། པེ།༽ སྒོ་བར་"
    },
    {
      "span": {
        "start": 27332,
        "end": 27341
      },
      "text": "ས་བོན་ཅན་ ༼སྣར། པེ།༽ ས་བོན་"
    },
    {
      "span": {
        "start": 27570,
        "end": 27578
      },
      "text": "། །འོ་ན་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 27588,
        "end": 27595
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 27725,
        "end": 27732
      },
      "text": "འཇུག་པ་ ༼སྣར། པེ།༽ འདུག་པ་"
    },
    {
      "span": {
        "start": 27774,
        "end": 27784
      },
      "text": "ཁྱད་པར་ཅི་ ༼པེ།༽ ཁྱད་པར་"
    },
    {
      "span": {
        "start": 27880,
        "end": 27896
      },
      "text": "བག་ཆགས་བསྒོ་བའང་ ༼སྣར། པེ།༽ བག་བསྒོའང་"
    },
    {
      "span": {
        "start": 28354,
        "end": 28357
      },
      "text": "གང་ ༼སྣར། པེ།༽ གང་གང་"
    },
    {
      "span": {
        "start": 28430,
        "end": 28438
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 28486,
        "end": 28495
      },
      "text": "ཕྱེད་པའི་ ༼སྣར། པེ།༽ བྱེད་པའི་"
    },
    {
      "span": {
        "start": 28506,
        "end": 28515
      },
      "text": "ལྟོས་པའི་ ༼སྣར། པེ།༽ བལྟོས་པའི་"
    },
    {
      "span": {
        "start": 28614,
        "end": 28617
      },
      "text": "རག་ ༼པེ།༽ གག་"
    },
    {
      "span": {
        "start": 28635,
        "end": 28644
      },
      "text": "སྐྱེས་ནས་ ༼སྣར།༽ སྐྱེས་"
    },
    {
      "span": {
        "start": 28744,
        "end": 28753
      },
      "text": "དེ་ལྟར་ན་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 28807,
        "end": 28814
      },
      "text": "གནོད་པ་ ༼སྣར། པེ།༽ གནོད་པར་"
    },
    {
      "span": {
        "start": 29030,
        "end": 29037
      },
      "text": "ཅན་གྱི་ ༼སྣར། པེ།༽ ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 29219,
        "end": 29230
      },
      "text": "བསྟན་པར་མི་ ༼པེ།༽ བསྟན་པར་ནི་"
    },
    {
      "span": {
        "start": 29516,
        "end": 29521
      },
      "text": "བྱའི། ༼སྣར། པེ།༽ བྱ་བ།"
    },
    {
      "span": {
        "start": 29655,
        "end": 29668
      },
      "text": "བསྡུས་པ་བསྟན་ ༼སྣར།༽ བསྡུས་པའི་བསྟན་ ༼པེ།༽ བསྡུས་པའི་སྟན་"
    },
    {
      "span": {
        "start": 29991,
        "end": 30001
      },
      "text": "ཁྱད་པར་ཅན་ ༼སྣར། པེ།༽ ཁྱད་པར་ཡིན་"
    },
    {
      "span": {
        "start": 30113,
        "end": 30118
      },
      "text": "པ་ནི་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 30208,
        "end": 30212
      },
      "text": "ལྷར་ ༼སྣར། པེ།༽ ལྟར་"
    },
    {
      "span": {
        "start": 30214,
        "end": 30219
      },
      "text": "ལྟའི་ ༼སྣར། པེ།༽ ལྷའི་"
    },
    {
      "span": {
        "start": 30315,
        "end": 30323
      },
      "text": "ལུས་ཀྱི་ ༼སྣར། པེ།༽ ལུས་ཀྱིས་"
    },
    {
      "span": {
        "start": 30458,
        "end": 30466
      },
      "text": "བསྒྲུབས་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 30470,
        "end": 30474
      },
      "text": "ལུས་ ༼སྣར། པེ།༽ ཡུལ་"
    },
    {
      "span": {
        "start": 30671,
        "end": 30679
      },
      "text": "འདོད་པས་ ༼སྣར། པེ།༽ འདོད་པར་"
    },
    {
      "span": {
        "start": 30852,
        "end": 30860
      },
      "text": "ལུས་ཀྱི་ ༼སྣར།༽ ལུས་ཀྱིས་"
    },
    {
      "span": {
        "start": 31167,
        "end": 31173
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 31386,
        "end": 31389
      },
      "text": "དེ། ༼སྣར། པེ།༽ དོ། །"
    },
    {
      "span": {
        "start": 31617,
        "end": 31622
      },
      "text": "བསགས་ ༼སྣར། པེ།༽ བསགས་ནས་བྱས་ཤིང་བསགས་"
    },
    {
      "span": {
        "start": 31642,
        "end": 31649
      },
      "text": "མདོ་ཇི་ ༼སྣར། པེ།༽ མདོའི་"
    },
    {
      "span": {
        "start": 31884,
        "end": 31892
      },
      "text": "བསམ་པའི་ ༼སྣར། པེ།༽ བསམས་པའི་"
    },
    {
      "span": {
        "start": 32037,
        "end": 32043
      },
      "text": "ངག་གི་ ༼སྣར། པེ།༽ ངག་ནི་"
    },
    {
      "span": {
        "start": 32178,
        "end": 32186
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 32344,
        "end": 32352
      },
      "text": "བྱས་པའི་ ༼སྣར།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 32427,
        "end": 32434
      },
