{
  "durchens": [
    {
      "span": {
        "start": 312,
        "end": 321
      },
      "text": "སྔོན་གྱི་ ༼པེ།༽ སྔོན་གྱིས་"
    },
    {
      "span": {
        "start": 911,
        "end": 916
      },
      "text": "གདོད་ ༼པེ།༽ བདོད་"
    },
    {
      "span": {
        "start": 2113,
        "end": 2118
      },
      "text": "སྟོད། ༼པེ།༽ བསྟོད།"
    },
    {
      "span": {
        "start": 2697,
        "end": 2701
      },
      "text": "ཀྱེ། ༼པེ།༽ སྐྱེ།"
    },
    {
      "span": {
        "start": 2901,
        "end": 2905
      },
      "text": "འཛད་ ༼པེ།༽ མཛད་"
    },
    {
      "span": {
        "start": 2982,
        "end": 2986
      },
      "text": "གཞི་ ༼པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 2994,
        "end": 2998
      },
      "text": "མཐུ་ ༼པེ།༽ མཐུའ་"
    },
    {
      "span": {
        "start": 3137,
        "end": 3141
      },
      "text": "ཏདྱ་ ༼པེ།༽ ཊི་བྷྱོ། ཏད་ཡ་"
    },
    {
      "span": {
        "start": 4522,
        "end": 4530
      },
      "text": "དྲིལ་ཏེ་ ༼པེ།༽ དྲིལ་སྟེ་"
    },
    {
      "span": {
        "start": 5182,
        "end": 5187
      },
      "text": "འགྲམ་ ༼པེ།༽ འགྲས་"
    },
    {
      "span": {
        "start": 5678,
        "end": 5686
      },
      "text": "བཏོར་བར་ ༼པེ།༽ གཏོར་བར་"
    },
    {
      "span": {
        "start": 5800,
        "end": 5806
      },
      "text": "མགྲིན་ ༼པེ།༽ འགྲིན་"
    },
    {
      "span": {
        "start": 6250,
        "end": 6256
      },
      "text": "སྤྲུས་ ༼པེ།༽ སྤྲུལ་"
    },
    {
      "span": {
        "start": 6270,
        "end": 6275
      },
      "text": "གདེང་ ༼པེ།༽ བདེངས་"
    },
    {
      "span": {
        "start": 6905,
        "end": 6910
      },
      "text": "རྒྱུ་ ༼པེ།༽ ཀྱུ་"
    },
    {
      "span": {
        "start": 7161,
        "end": 7168
      },
      "text": "དམ་ཚོག་ ༼པེ།༽ དམ་ཚིག་"
    },
    {
      "span": {
        "start": 7412,
        "end": 7418
      },
      "text": "མགྲིན་ ༼པེ།༽ འགྲིན་"
    },
    {
      "span": {
        "start": 7894,
        "end": 7902
      },
      "text": "རྟོར་བར་ ༼པེ།༽ གཏོར་བར་"
    }
  ]
}