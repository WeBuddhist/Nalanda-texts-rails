{
  "durchens": [
    {
      "span": {
        "start": 26,
        "end": 28
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནཱ་"
    },
    {
      "span": {
        "start": 46,
        "end": 56
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ སྒོམ་པའི་"
    },
    {
      "span": {
        "start": 107,
        "end": 114
      },
      "text": "ཆེན་པོ་ ༼སྣར། པེ།༽ ཆེན་པོའི་"
    },
    {
      "span": {
        "start": 124,
        "end": 132
      },
      "text": "ཚུལ་གྱི་ ༼སྣར། པེ།༽ ཚུལ་གྱིས་"
    },
    {
      "span": {
        "start": 152,
        "end": 163
      },
      "text": "ཀྱིས་བསྒོམ་ ༼སྣར། པེ།༽ ཀྱི་སྒོམ་"
    },
    {
      "span": {
        "start": 241,
        "end": 249
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 972,
        "end": 979
      },
      "text": "རིང་པོ་ ༼སྣར། པེ།༽ རིང་མོ་"
    },
    {
      "span": {
        "start": 1072,
        "end": 1079
      },
      "text": "སྤྱད་པ་ ༼སྣར། པེ།༽ དཔྱད་པ་"
    },
    {
      "span": {
        "start": 1377,
        "end": 1385
      },
      "text": "བསྟན་པར་ ༼སྡེ།༽ བསྟེན་པར་"
    },
    {
      "span": {
        "start": 1525,
        "end": 1533
      },
      "text": "བཀའ་ཉིད་ ༼སྡེ།༽ བདག་ཉིད་"
    },
    {
      "span": {
        "start": 2041,
        "end": 2053
      },
      "text": "བསྒྲུབས་པའི་ ༼སྣར། པེ།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 2163,
        "end": 2169
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 2219,
        "end": 2225
      },
      "text": "ལག་ཏུ་ ༼སྣར། པེ།༽ ལག་མཐིལ་དུ་"
    },
    {
      "span": {
        "start": 2410,
        "end": 2414
      },
      "text": "དཔས་ ༼སྣར། པེ།༽ དཔལ་"
    },
    {
      "span": {
        "start": 2473,
        "end": 2482
      },
      "text": "སེམས་དཔས་ ༼སྣར།༽ སེམས་ ༼པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 2497,
        "end": 2502
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 2521,
        "end": 2529
      },
      "text": "བགྱིས་ན་ ༼སྣར། པེ།༽ བགྱིས་ནས་"
    },
    {
      "span": {
        "start": 2975,
        "end": 2983
      },
      "text": "སྤོང་བས་ ༼སྣར། པེ།༽ སོང་བས་"
    },
    {
      "span": {
        "start": 2996,
        "end": 3005
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 3050,
        "end": 3057
      },
      "text": "ཆེན་པོ་ ༼སྣར། པེ།༽ ཆེན་པོའི་"
    },
    {
      "span": {
        "start": 3171,
        "end": 3181
      },
      "text": "བསྒོམས་པས་ ༼སྣར། པེ།༽ བསྒོམ་པས་"
    },
    {
      "span": {
        "start": 3344,
        "end": 3353
      },
      "text": "འཁོར་བ་ན་ ༼སྣར། པེ།༽ འཁོར་བ་ནས་"
    },
    {
      "span": {
        "start": 3507,
        "end": 3515
      },
      "text": "གྱུར་པས་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 3753,
        "end": 3766
      },
      "text": "བྱམས་པའི་ཆུས་ ༼སྣར། པེ།༽ བྱམས་པའི་"
    },
    {
      "span": {
        "start": 3771,
        "end": 3775
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱིས་"
    },
    {
      "span": {
        "start": 3988,
        "end": 3995
      },
      "text": "ཐམས་ཅད་ ༼སྣར། པེ།༽ རྣམས་ལ་"
    },
    {
      "span": {
        "start": 4046,
        "end": 4055
      },
      "text": "གསུམ་པའི་ ༼སྣར། པེ།༽ གསུམ་"
    },
    {
      "span": {
        "start": 4238,
        "end": 4247
      },
      "text": "ཡིན་པ་དེ་ ༼སྣར། པེ།༽ ཡིན་པ་"
    },
    {
      "span": {
        "start": 4464,
        "end": 4475
      },
      "text": "སེམས་བསྐམས་ ༼སྣར། པེ།༽ མེས་སྐམས་"
    },
    {
      "span": {
        "start": 4695,
        "end": 4703
      },
      "text": "ཕོངས་ནས་ ༼སྣར། པེ།༽ ཕོངས་པས་"
    },
    {
      "span": {
        "start": 4726,
        "end": 4740
      },
      "text": "གནོད་པ་བྱེད་པ་ ༼སྣར། པེ།༽ གནོད་པ་"
    },
    {
      "span": {
        "start": 4904,
        "end": 4907
      },
      "text": "པས་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 5006,
        "end": 5009
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 5075,
        "end": 5085
      },
      "text": "སྡུག་བསྔལ་ ༼སྣར། པེ།༽ སྡུག་བསྔལ་བ་"
    },
    {
      "span": {
        "start": 5189,
        "end": 5195
      },
      "text": "གང་དག་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 5800,
        "end": 5803
      },
      "text": "དེ་ ༼སྡེ།༽ དེས་"
    },
    {
      "span": {
        "start": 5815,
        "end": 5817
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་ཀྱང་"
    },
    {
      "span": {
        "start": 5874,
        "end": 5877
      },
      "text": "དུ་ ༼སྣར། པེ།༽ དུ་ཡང་རུང་སྟེ་དུས་ཐམས་ཅད་དུ་"
    },
    {
      "span": {
        "start": 5998,
        "end": 6006
      },
      "text": "མཐོང་བས་ ༼སྣར། པེ།༽ མཐོང་བར་"
    },
    {
      "span": {
        "start": 6042,
        "end": 6051
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 6374,
        "end": 6387
      },
      "text": "བདག་ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ བདག་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 6394,
        "end": 6399
      },
      "text": "སྡུག་ ༼སྣར། པེ།༽ སྡུག་པ་སྡུག་"
    },
    {
      "span": {
        "start": 6510,
        "end": 6532
      },
      "text": "ཚེ་རྫོགས་པ་ཞེས་བྱ་སྟེ། ༼སྣར། པེ།༽ ཚེ་"
    },
    {
      "span": {
        "start": 6599,
        "end": 6607
      },
      "text": "ཕྱོགས་ལ་ ༼སྣར། པེ།༽ ཕྱོགས་"
    },
    {
      "span": {
        "start": 6828,
        "end": 6835
      },
      "text": "རྩ་བའི་ ༼སྣར། པེ།༽ རྩ་བ་"
    },
    {
      "span": {
        "start": 7111,
        "end": 7119
      },
      "text": "བྱང་ཆུབ་ ༼སྣར། པེ།༽ བྱང་ཆུབ་ཏུ་"
    },
    {
      "span": {
        "start": 7124,
        "end": 7135
      },
      "text": "པའི་རྣམ་པས་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 7257,
        "end": 7265
      },
      "text": "ལས་སེམས་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 7289,
        "end": 7302
      },
      "text": "ཀུན་རྫོབ་པའི་ ༼སྣར། པེ།༽ ཀུན་རྫོབ་ཀྱི་"
    },
    {
      "span": {
        "start": 7319,
        "end": 7326
      },
      "text": "བསྐྱེད་ ༼པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 7558,
        "end": 7566
      },
      "text": "གཡོ་བའོ། ༼སྣར། པེ།༽ གཡོས་པའོ།"
    },
    {
      "span": {
        "start": 7571,
        "end": 7579
      },
      "text": "འགྲུབ་པ་ ༼སྣར། པེ།༽ གྲུབ་པ་"
    },
    {
      "span": {
        "start": 7647,
        "end": 7653
      },
      "text": "བྱས་པ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 7789,
        "end": 7798
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 7985,
        "end": 7997
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 8185,
        "end": 8194
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 8372,
        "end": 8392
      },
      "text": "སྒྲིབ་པ་མི་སྤོང་གི ། ༼སྣར།༽ སྒྲིབ་པ་རྣམས་མི་སྤོངས་ཀྱི། ། ༼པེ།༽ སྒྲིབ་པ་མ་རྣམས་སྤོངས་ཀྱི། །"
    },
    {
      "span": {
        "start": 8430,
        "end": 8436
      },
      "text": "ཟད་དེ། ༼སྣར། པེ།༽ ཟད།"
    },
    {
      "span": {
        "start": 8454,
        "end": 8461
      },
      "text": "བྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 8720,
        "end": 8725
      },
      "text": "འཛིན་ ༼སྣར། པེ།༽ འཛིན་གྱི་"
    },
    {
      "span": {
        "start": 8756,
        "end": 8764
      },
      "text": "སྒོམ་པར་ ༼སྣར།༽ བསྒོམ་པར་"
    },
    {
      "span": {
        "start": 8785,
        "end": 8789
      },
      "text": "རྟག་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 8868,
        "end": 8870
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 9219,
        "end": 9230
      },
      "text": "ང་རྒྱལ་གྱི་ ༼སྣར། པེ།༽ ང་རྒྱལ་"
    },
    {
      "span": {
        "start": 9413,
        "end": 9421
      },
      "text": "དྲུག་གི་ ༼སྣར། པེ།༽ དྲུག་ཏུ་"
    },
    {
      "span": {
        "start": 9691,
        "end": 9699
      },
      "text": "འདོད་པས་ ༼སྣར། པེ།༽ འདོད་པ་"
    },
    {
      "span": {
        "start": 9868,
        "end": 9876
      },
      "text": "སྒོམ་པར་ ༼ཅོ།༽ བསྒོམ་པར་"
    },
    {
      "span": {
        "start": 9917,
        "end": 9922
      },
      "text": "འཐོབ། ༼པེ།༽ ཐོབ།"
    },
    {
      "span": {
        "start": 10080,
        "end": 10089
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་དཔའི་ཐེག་པ་པ་"
    },
    {
      "span": {
        "start": 10264,
        "end": 10290
      },
      "text": "འབྱུང་བ་གང་ཅི་ཡང་རུང་། དེ་ ༼སྣར། པེ།༽ གང་ཅི་ཡང་རུངསྟེ་"
    },
    {
      "span": {
        "start": 10309,
        "end": 10319
      },
      "text": "གཡེངས་པའི་ ༼སྣར། པེ།༽ ཡེངས་པའི་"
    },
    {
      "span": {
        "start": 10319,
        "end": 10328
      },
      "text": "སེམས་ཀྱི་ ༼སྡེ།༽ སེམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 10348,
        "end": 10355
      },
      "text": "བསམས་པ་ ༼སྣར། པེ།༽ བསམ་པ་"
    },
    {
      "span": {
        "start": 10474,
        "end": 10482
      },
      "text": "གཡེང་བར་ ༼སྣར། པེ།༽ གཡེངས་པར་"
    },
    {
      "span": {
        "start": 10488,
        "end": 10492
      },
      "text": "གྱི། ༼སྣར། པེ།༽ གྱིས།"
    },
    {
      "span": {
        "start": 10529,
        "end": 10537
      },
      "text": "བརྟན་པར་ ༼སྣར། པེ།༽ གནས་པར་"
    },
    {
      "span": {
        "start": 10937,
        "end": 10940
      },
      "text": "རོ། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 11071,
        "end": 11080
      },
      "text": "རླུང་གིས་ ༼སྣར། པེ།༽ རླུང་གི་"
    },
    {
      "span": {
        "start": 11082,
        "end": 11091
      },
      "text": "བསྐྱོད་པ་ ༼པེ།༽ སྐྱོད་པ་"
    },
    {
      "span": {
        "start": 11120,
        "end": 11130
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 11440,
        "end": 11447
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 11906,
        "end": 11919
      },
      "text": "གནས་པའི་ཕྱིར་ ༼སྣར། པེ།༽ གནས་པའི་"
    },
    {
      "span": {
        "start": 11986,
        "end": 11997
      },
      "text": "ལྡན་པ་ལྟ་བ་ ༼སྣར། པེ།༽ ལྡན་པ་"
    },
    {
      "span": {
        "start": 12148,
        "end": 12157
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 12349,
        "end": 12355
      },
      "text": "སྤང་བ་ ༼སྣར། པེ།༽ སྤངས་བ་"
    },
    {
      "span": {
        "start": 12471,
        "end": 12481
      },
      "text": "སྤངས་པ་གང་ ༼སྣར། པེ།༽ སྤངས་པ་"
    },
    {
      "span": {
        "start": 12636,
        "end": 12644
      },
      "text": "སྐྱེན་པ་ ༼ཅོ།༽ སྐྱེན་པར་ ༼སྣར། པེ།༽ སྐྱེན་པས་"
    },
    {
      "span": {
        "start": 12653,
        "end": 12665
      },
      "text": "ཆོས་བཞིན་དུ་ ༼སྣར། པེ།༽ ཆོས་བཞིན་"
    },
    {
      "span": {
        "start": 12697,
        "end": 12702
      },
      "text": "ཕམ་པ་ ༼པེ།༽ ཕན་པ་"
    },
    {
      "span": {
        "start": 13011,
        "end": 13017
      },
      "text": "བསལ་བ་ ༼སྣར། པེ།༽ གསལ་བ་"
    },
    {
      "span": {
        "start": 13054,
        "end": 13059
      },
      "text": "ན་དེ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 13210,
        "end": 13217
      },
      "text": "རྟོག་པ་ ༼སྣར།༽ རྟག་པ་"
    },
    {
      "span": {
        "start": 13247,
        "end": 13258
      },
      "text": "འཁོར་བ་པའི་ ༼སྣར། པེ།༽ འཁོར་བའི་"
    },
    {
      "span": {
        "start": 13297,
        "end": 13303
      },
      "text": "དེ་དག་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 13370,
        "end": 13384
      },
      "text": "ཐམས་ཅད་དང་བདག་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 13471,
        "end": 13481
      },
      "text": "བསྒོམས་པས་ ༼པེ།༽ བསྒོམ་པས་"
    },
    {
      "span": {
        "start": 13533,
        "end": 13540
      },
      "text": "གང་ཞིག། ༼ཅོ། སྡེ།༽ གང་ཞེ་ན།"
    },
    {
      "span": {
        "start": 13640,
        "end": 13649
      },
      "text": "ཇི་ལྟ་བུ་ ༼ཅོ། སྡེ།༽ ཇི་ལྟ་བུ་ལ་"
    },
    {
      "span": {
        "start": 13844,
        "end": 13848
      },
      "text": "དྲང་ ༼ཅོ། སྡེ།༽ དྲང་བའི་"
    },
    {
      "span": {
        "start": 14039,
        "end": 14045
      },
      "text": "བསམ་པ་ ༼ཅོ། སྡེ།༽ བསམས་པ་"
    },
    {
      "span": {
        "start": 14091,
        "end": 14095
      },
      "text": "ཡིན་ ༼ཅོ། སྡེ།༽ ཡིན་ནོ་"
    },
    {
      "span": {
        "start": 14130,
        "end": 14137
      },
      "text": "བུས་སུ་ ༼ཅོ། སྡེ།༽ བུས་"
    },
    {
      "span": {
        "start": 14238,
        "end": 14244
      },
      "text": "འགྱུར་ ༼ཅོ། སྡེ།༽ འགྱུར་རོ་"
    },
    {
      "span": {
        "start": 14412,
        "end": 14419
      },
      "text": "སྒོམ་པ་ ༼ཅོ། སྡེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 14461,
        "end": 14473
      },
      "text": "ཐེ་ཚོམ་གྱིས་ ༼ཅོ། སྡེ།༽ ཐེ་ཚོམ་གྱི་"
    },
    {
      "span": {
        "start": 14489,
        "end": 14495
      },
      "text": "ཐེག་པ་ ༼ཅོ། སྡེ།༽ ཐག་པ་"
    },
    {
      "span": {
        "start": 14575,
        "end": 14600
      },
      "text": "། །རྣལ་འབྱོར་པས་སྒོམ་པའི་ ༼ཅོ། སྡེ།༽ རྣལ་འབྱོར་པས་ནི་"
    },
    {
      "span": {
        "start": 14619,
        "end": 14628
      },
      "text": "ཤ་ལ་སོགས་ ༼ཅོ། སྡེ།༽ ཤ་ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 14756,
        "end": 14763
      },
      "text": "སྒོམ་པ་ ༼ཅོ། སྡེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 14798,
        "end": 14807
      },
      "text": "སྒོམ་པའི་ ༼ཅོ། སྡེ།༽ བསྒོམ་པའི་"
    },
    {
      "span": {
        "start": 14922,
        "end": 14929
      },
      "text": "བདག་གི་ ༼ཅོ། སྡེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 15033,
        "end": 15040
      },
      "text": "ཅན་གྱི་ ༼ཅོ། སྡེ།༽ ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 15370,
        "end": 15376
      },
      "text": "འཇམ་པ་ ༼ཅོ། སྡེ།༽ འཇམ་པོ་"
    },
    {
      "span": {
        "start": 15429,
        "end": 15436
      },
      "text": "བུའོ། ། ༼ཅོ། སྡེ།༽ བུའམ།"
    },
    {
      "span": {
        "start": 15502,
        "end": 15506
      },
      "text": "ཟུམ་ ༼ཅོ། སྡེ།༽ གཟུམ་"
    },
    {
      "span": {
        "start": 15522,
        "end": 15527
      },
      "text": "བསྟད་ ༼ཅོ། སྡེ།༽ གཏད་"
    },
    {
      "span": {
        "start": 15548,
        "end": 15552
      },
      "text": "དགུ། ༼ཅོ། སྡེ།༽ སྒུ།"
    },
    {
      "span": {
        "start": 15771,
        "end": 15779
      },
      "text": "ཡས་སོའི་ ༼ཅོ། སྡེ།༽ ཡ་སོའི་"
    },
    {
      "span": {
        "start": 15787,
        "end": 15794
      },
      "text": "གཞག་གོ། ༼ཅོ། སྡེ།༽ གཞར་རོ།"
    },
    {
      "span": {
        "start": 15834,
        "end": 15840
      },
      "text": "སྔམ་པ་ ༼ཅོ། སྡེ།༽ རྔམས་པ་"
    },
    {
      "span": {
        "start": 15899,
        "end": 15906
      },
      "text": "དལ་བུས་ ༼ཅོ། སྡེ།༽ དལ་བུ་"
    },
    {
      "span": {
        "start": 15995,
        "end": 16001
      },
      "text": "ཐོག་མ་ ༼ཅོ། སྡེ།༽ ཐོག་མར་"
    },
    {
      "span": {
        "start": 16065,
        "end": 16071
      },
      "text": "ཞི་ནས་ ༼སྡེ།༽ ཞི་གནས་"
    },
    {
      "span": {
        "start": 16114,
        "end": 16116
      },
      "text": "པ་ ༼ཅོ། སྡེ།༽ ལ་"
    },
    {
      "span": {
        "start": 16605,
        "end": 16610
      },
      "text": "བསྙད་ ༼ཅོ།༽ བསྙེད་"
    },
    {
      "span": {
        "start": 16643,
        "end": 16647
      },
      "text": "དང་། ༼ཅོ། སྡེ།༽ དང་། ཚིགས་སུ་བཅད་པའི་སྡེ་དང་།"
    },
    {
      "span": {
        "start": 16679,
        "end": 16685
      },
      "text": "གཞིའི་ ༼ཅོ།༽ བཞིའི་"
    },
    {
      "span": {
        "start": 16805,
        "end": 16822
      },
      "text": "བྱུང་བའི་ཆོས་ཀྱི་ ༼སྣར། པེ།༽ བྱུང་བའི་"
    },
    {
      "span": {
        "start": 17143,
        "end": 17151
      },
      "text": "སེམས་དེ་ ༼སྣར། པེ།༽ སེམས་"
    },
    {
      "span": {
        "start": 17241,
        "end": 17268
      },
      "text": "ལུས་ཤིན་ཏུ་སྦྱངས་པ་དང་སེམས་ ༼སྣར། པེ།༽ ལུས་ནི་"
    },
    {
      "span": {
        "start": 17389,
        "end": 17392
      },
      "text": "དེ་ ༼སྡེ།༽ དེས་"
    },
    {
      "span": {
        "start": 17421,
        "end": 17428
      },
      "text": "ཤིན་ཏུ་ ༼སྣར། པེ།༽ ཡོངས་སུ་"
    },
    {
      "span": {
        "start": 17463,
        "end": 17472
      },
      "text": "སེམས་ཀྱི་ ༼སྣར། པེ།༽ སེམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 17501,
        "end": 17510
      },
      "text": "བསམས་པའི་ ༼སྣར། པེ།༽ བསམ་པའི་"
    },
    {
      "span": {
        "start": 17585,
        "end": 17590
      },
      "text": "བྱེད། ༼སྣར། པེ།༽ བྱེད་དོ། །"
    },
    {
      "span": {
        "start": 17641,
        "end": 17652
      },
      "text": "གཟུགས་བརྙན་ ༼སྣར། པེ།༽ གཟུགས་"
    },
    {
      "span": {
        "start": 17730,
        "end": 17737
      },
      "text": "རྟོག་པ་ ༼ཅོ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 17750,
        "end": 17758
      },
      "text": "དཔྱོད་པ་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 17818,
        "end": 17825
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 17878,
        "end": 17887
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་དཔའི་"
    },
    {
      "span": {
        "start": 17958,
        "end": 17968
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 17976,
        "end": 17983
      },
      "text": "ཐོག་མར་ ༼སྣར། པེ།༽ ཐོག་མ་"
    },
    {
      "span": {
        "start": 18029,
        "end": 18038
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 18112,
        "end": 18120
      },
      "text": "འབབ་པའོ་ ༼སྣར། པེ།༽ བབ་པའོ་"
    },
    {
      "span": {
        "start": 18223,
        "end": 18230
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 18438,
        "end": 18451
      },
      "text": "སྐུ་ལུས་ཀྱིས། ༼སྣར། པེ།༽ སྐུ་ལུས་ཀྱི།"
    },
    {
      "span": {
        "start": 18504,
        "end": 18511
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 18648,
        "end": 18662
      },
      "text": "རྒྱུན་དུ་སེམས་ ༼སྣར། པེ།༽ རྒྱུན་ཏུ་"
    },
    {
      "span": {
        "start": 18709,
        "end": 18717
      },
      "text": "དཔྱད་པར་ ༼སྣར། པེ།༽ སྤྱད་པར་"
    },
    {
      "span": {
        "start": 18947,
        "end": 18955
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ དངོས་པོས་"
    },
    {
      "span": {
        "start": 19063,
        "end": 19072
      },
      "text": "དེ་ཉིད་ལ་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 19077,
        "end": 19090
      },
      "text": "ཀྱིས་དམིགས་པ་ ༼སྣར། པེ།༽ ཀྱིས་"
    },
    {
      "span": {
        "start": 19197,
        "end": 19204
      },
      "text": "ལྟ་བུར་ ༼སྣར། པེ།༽ ལྟ་བུའི་"
    },
    {
      "span": {
        "start": 19346,
        "end": 19352
      },
      "text": "རྒྱུག་ ༼སྣར། པེ།༽ བརྒྱུག་"
    },
    {
      "span": {
        "start": 19434,
        "end": 19437
      },
      "text": "དུ་ ༼སྣར། པེ།༽ དུ་འཇུག་"
    },
    {
      "span": {
        "start": 19542,
        "end": 19546
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ ཡིད་"
    },
    {
      "span": {
        "start": 19588,
        "end": 19594
      },
      "text": "དྲན་པ་ ༼སྣར། པེ།༽ རྣམ་པ་"
    },
    {
      "span": {
        "start": 19616,
        "end": 19624
      },
      "text": "ཡིད་ཀྱི་ ༼སྣར། པེ།༽ ཡིད་ལ་"
    },
    {
      "span": {
        "start": 19709,
        "end": 19714
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 19729,
        "end": 19736
      },
      "text": "ལ་སེམས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 19810,
        "end": 19826
      },
      "text": "ཚེ་ཇི་སྲིད་འདོད་ ༼སྣར། པེ།༽ ཚེ་ནམ་སྡོད་"
    },
    {
      "span": {
        "start": 19945,
        "end": 19953
      },
      "text": "དམིགས་པ་ ༼སྣར། པེ།༽ དམིགས་པ་དེ་"
    },
    {
      "span": {
        "start": 19955,
        "end": 19963
      },
      "text": "སེམས་རང་ ༼སྣར། པེ།༽ སེམས་"
    },
    {
      "span": {
        "start": 20148,
        "end": 20167
      },
      "text": "མངོན་སུམ་མམ་བརྒྱུད་ ༼སྣར། པེ།༽ མངོན་སུམ་རྒྱུད་"
    },
    {
      "span": {
        "start": 20178,
        "end": 20190
      },
      "text": "མངོན་སུམ་དུ་ ༼སྣར། པེ།༽ མངོན་པར་"
    },
    {
      "span": {
        "start": 20295,
        "end": 20305
      },
      "text": "ཐམས་ཅད་དང་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 20330,
        "end": 20338
      },
      "text": "ཙམ་གྱིས་ ༼སྣར། པེ།༽ ཙམ་གྱི་"
    },
    {
      "span": {
        "start": 20407,
        "end": 20419
      },
      "text": "ཤེས་རབ་ཀྱིས་ ༼སྣར། པེ།༽ ཤེས་རབ་ཀྱི་"
    },
    {
      "span": {
        "start": 20575,
        "end": 20582
      },
      "text": "བདག་གི་ ༼སྡེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 20598,
        "end": 20610
      },
      "text": "ཤེས་རབ་ཀྱིས་ ༼སྣར། པེ།༽ ཤེས་རབ་ཀྱི་"
    },
    {
      "span": {
        "start": 20646,
        "end": 20657
      },
      "text": "ཙམ་གྱིས་ནི་ ༼སྣར། པེ།༽ ཙམ་གྱི་"
    },
    {
      "span": {
        "start": 20680,
        "end": 20691
      },
      "text": "སྙམ་དུ་བསམ་ ༼སྣར། པེ།༽ སྙམ་"
    },
    {
      "span": {
        "start": 20768,
        "end": 20777
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ གཉིས་ཀྱི་"
    },
    {
      "span": {
        "start": 20984,
        "end": 20991
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 21091,
        "end": 21097
      },
      "text": "དེ་ལྟ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 21648,
        "end": 21655
      },
      "text": "བྱའོ། ། ༼ཅོ།༽ །། །།"
    },
    {
      "span": {
        "start": 21655,
        "end": 21661
      },
      "text": "ཆོས་ལ་ ༼སྣར། པེ།༽ ཆོས་"
    },
    {
      "span": {
        "start": 21715,
        "end": 21725
      },
      "text": "མདོར་བསྡུ་ ༼སྣར། པེ།༽ མདོར་བསྡུས་"
    },
    {
      "span": {
        "start": 21817,
        "end": 21824
      },
      "text": "ཁམས་དང་ ༼སྣར། པེ།༽ ཁམས་"
    },
    {
      "span": {
        "start": 21894,
        "end": 21897
      },
      "text": "དེ། ༼སྣར། པེ།༽ དོ། །"
    },
    {
      "span": {
        "start": 21971,
        "end": 21977
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ རྟོག་"
    },
    {
      "span": {
        "start": 21996,
        "end": 22001
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 22060,
        "end": 22069
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་ནི་"
    },
    {
      "span": {
        "start": 22340,
        "end": 22344
      },
      "text": "འདི་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 22376,
        "end": 22383
      },
      "text": "དེས་དེ་ ༼སྣར། པེ།༽ དེ་དེ་"
    },
    {
      "span": {
        "start": 22426,
        "end": 22435
      },
      "text": "རྟོགས་ནས་ ༼སྣར།༽ རྟོགས་ན་"
    },
    {
      "span": {
        "start": 22618,
        "end": 22628
      },
      "text": "བརྫུན་པའི་ ༼སྣར། པེ།༽ རྫུན་པའི་"
    },
    {
      "span": {
        "start": 22679,
        "end": 22691
      },
      "text": "སྣ་ཚོགས་ཀྱི་ ༼སྣར། པེ།༽ སྣ་ཚོགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 23049,
        "end": 23065
      },
      "text": "སེམས་ཇི་ལྟ་བ་དེ་ ༼སྣར། པེ།༽ ཇི་ལྟ་བ་"
    },
    {
      "span": {
        "start": 23077,
        "end": 23088
      },
      "text": "ཐམས་ཅད་ཀྱང་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 23155,
        "end": 23167
      },
      "text": "ཤེས་རབ་ཀྱིས་ ༼སྣར། པེ།༽ ཤེས་རབ་ཀྱི་"
    },
    {
      "span": {
        "start": 23384,
        "end": 23390
      },
      "text": "ཚེ་ཡང་ ༼སྣར། པེ།༽ ཚེ་"
    },
    {
      "span": {
        "start": 23417,
        "end": 23423
      },
      "text": "ཚེ་ཡང་ ༼སྣར། པེ།༽ ཚེ་"
    },
    {
      "span": {
        "start": 23453,
        "end": 23458
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 23468,
        "end": 23473
      },
      "text": "བསྟན་ ༼སྡེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 23504,
        "end": 23509
      },
      "text": "བསྟན་ ༼སྡེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 23520,
        "end": 23525
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 23688,
        "end": 23693
      },
      "text": "གང་མ་ ༼སྣར། པེ།༽ གང་མི་"
    },
    {
      "span": {
        "start": 23818,
        "end": 23825
      },
      "text": "དེས་དེ་ ༼སྣར། པེ།༽ དེ་དེ་"
    },
    {
      "span": {
        "start": 24043,
        "end": 24055
      },
      "text": "དེ་ལྟར་སེམས་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 24190,
        "end": 24200
      },
      "text": "སེམས་ཀྱིས་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 24207,
        "end": 24219
      },
      "text": "བསྒྲུབས་པའི་ ༼སྣར། པེ།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 24302,
        "end": 24314
      },
      "text": "ཤེས་རབ་ཀྱིས་ ༼སྣར། པེ།༽ ཤེས་རབ་ཀྱི་"
    },
    {
      "span": {
        "start": 24520,
        "end": 24532
      },
      "text": "མེད་པའོ་ཞེས་ ༼སྣར། པེ།༽ མེད་པའོ་ཞེའམ་"
    },
    {
      "span": {
        "start": 24543,
        "end": 24551
      },
      "text": "བྱེད་དོ། ༼སྣར། པེ།༽ བྱེད་དམ།"
    },
    {
      "span": {
        "start": 24694,
        "end": 24699
      },
      "text": "དེའི་ ༼སྣར། པེ།༽ དེའི་ཕྱིར་"
    },
    {
      "span": {
        "start": 24763,
        "end": 24775
      },
      "text": "ཤེས་རབ་ཀྱིས་ ༼སྣར། པེ།༽ ཤེས་རབ་ཀྱི་"
    },
    {
      "span": {
        "start": 24787,
        "end": 24798
      },
      "text": "དེ་དངོས་པོ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 25119,
        "end": 25124
      },
      "text": "ལྡོག་ ༼སྣར། པེ།༽ རྟོག་"
    },
    {
      "span": {
        "start": 25138,
        "end": 25154
      },
      "text": "མེད་པ་ཉིད་རྟོགས་ ༼སྣར། པེ།༽ མེད་པ་རྟོག་"
    },
    {
      "span": {
        "start": 25288,
        "end": 25293
      },
      "text": "གཙུབ་ ༼སྣར། པེ།༽ གཙུགས་"
    },
    {
      "span": {
        "start": 25365,
        "end": 25372
      },
      "text": "སྩལ་ཏོ། ༼སྣར། པེ།༽ སྩལ་པ།"
    },
    {
      "span": {
        "start": 25408,
        "end": 25415
      },
      "text": "སྩལ་ཏོ། ༼སྣར། པེ།༽ སྩལ་ཏེ།"
    },
    {
      "span": {
        "start": 25532,
        "end": 25538
      },
      "text": "ཉིད་ལ་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 25718,
        "end": 25725
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 25790,
        "end": 25799
      },
      "text": "རྟོགས་པས་ ༼སྣར། པེ།༽ རྟོག་པས་"
    },
    {
      "span": {
        "start": 25849,
        "end": 25854
      },
      "text": "འདིས་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 25865,
        "end": 25872
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 25872,
        "end": 25880
      },
      "text": "སྔོན་དུ་ ༼སྣར། པེ།༽ མངོན་དུ་"
    },
    {
      "span": {
        "start": 25880,
        "end": 25887
      },
      "text": "གཏོང་བ་ ༼སྣར། པེ།༽ སྟོང་པ་"
    },
    {
      "span": {
        "start": 25917,
        "end": 25925
      },
      "text": "བསྟན་ཏོ། ༼སྣར། པེ།༽ བསྟན་ཏེ།"
    },
    {
      "span": {
        "start": 25994,
        "end": 26010
      },
      "text": "མི་དཔྱོད་པར་རྣམ་ ༼སྣར། པེ།༽ མི་སྤྱོད་"
    },
    {
      "span": {
        "start": 26078,
        "end": 26081
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་དེ་"
    },
    {
      "span": {
        "start": 26081,
        "end": 26088
      },
      "text": "ལྟར་དེ་ ༼སྣར། པེ།༽ ལྟར་"
    },
    {
      "span": {
        "start": 26161,
        "end": 26167
      },
      "text": "བརྟགས་ ༼པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 26248,
        "end": 26261
      },
      "text": "དང་འཇིག་རྟེན་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 26294,
        "end": 26302
      },
      "text": "བྱེད་དེ། ༼སྣར། པེ།༽ བྱེད།"
    },
    {
      "span": {
        "start": 26631,
        "end": 26641
      },
      "text": "བདག་མེད་པ་ ༼སྣར། པེ།༽ བདག་མེད་པའི་"
    },
    {
      "span": {
        "start": 26641,
        "end": 26648
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 26678,
        "end": 26693
      },
      "text": "པར་བྱ་བ་བལྟ་བར་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 26790,
        "end": 26797
      },
      "text": "ངང་གིས་ ༼སྣར། པེ།༽ ངང་གི་"
    },
    {
      "span": {
        "start": 26823,
        "end": 26830
      },
      "text": "མེད་པས་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 27018,
        "end": 27026
      },
      "text": "གཡེངས་པ་ ༼སྣར། པེ།༽ གཡེང་བ་"
    },
    {
      "span": {
        "start": 27065,
        "end": 27075
      },
      "text": "ལ་སོགས་པས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 27183,
        "end": 27190
      },
      "text": "དགའ་བར་ ༼སྣར། པེ།༽ དགའ་བ་"
    },
    {
      "span": {
        "start": 27212,
        "end": 27221
      },
      "text": "འཛིན་གྱི་ ༼སྣར། པེ།༽ འཛིན་གྱིས་"
    },
    {
      "span": {
        "start": 27285,
        "end": 27294
      },
      "text": "ལ་ཉེས་པར་ ༼སྣར། པེ།༽ ལ་ཉེས་པ་"
    },
    {
      "span": {
        "start": 27362,
        "end": 27366
      },
      "text": "ནོན་ ༼སྣར། པེ།༽ གནོན་"
    },
    {
      "span": {
        "start": 27407,
        "end": 27422
      },
      "text": "དོགས་པར་མཐོང་བ་ ༼སྣར། པེ།༽ དོགས་པ་"
    },
    {
      "span": {
        "start": 27707,
        "end": 27711
      },
      "text": "ཡིད་ ༼སྣར། པེ།༽ ཡིད་དུ་"
    },
    {
      "span": {
        "start": 27744,
        "end": 27748
      },
      "text": "བྱས་ ༼སྣར། པེ།༽ བྱས་པ་"
    },
    {
      "span": {
        "start": 27772,
        "end": 27784
      },
      "text": "དེ་ནས་ཡང་དེ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 27977,
        "end": 27982
      },
      "text": "གློད་ ༼སྣར། པེ།༽ གློ་"
    },
    {
      "span": {
        "start": 28032,
        "end": 28039
      },
      "text": "བརྩལ་བ་ ༼སྣར། པེ།༽ བཙལ་བ་"
    },
    {
      "span": {
        "start": 28112,
        "end": 28120
      },
      "text": "བརྩལ་བར་ ༼སྣར། པེ།༽ བཙལ་བར་"
    },
    {
      "span": {
        "start": 28122,
        "end": 28136
      },
      "text": "བྱས་ན་དེའི་ཚེ་ ༼སྣར། པེ།༽ བྱས་ནས་དེའི་"
    },
    {
      "span": {
        "start": 28232,
        "end": 28240
      },
      "text": "བརྩལ་བར་ ༼སྣར། པེ།༽ བཙལ་བར་"
    },
    {
      "span": {
        "start": 28261,
        "end": 28269
      },
      "text": "བརྩལ་བར་ ༼སྣར། པེ།༽ བཙལ་བར་"
    },
    {
      "span": {
        "start": 28297,
        "end": 28307
      },
      "text": "བསྒོམས་པས་ ༼སྣར། པེ།༽ བསྒོམ་པས་"
    },
    {
      "span": {
        "start": 28330,
        "end": 28337
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 28372,
        "end": 28378
      },
      "text": "བཞག་པ་ ༼སྣར། པེ།༽ བཞག་པ་དེ་"
    },
    {
      "span": {
        "start": 28500,
        "end": 28511
      },
      "text": "ཞི་གནས་ཀྱི་ ༼སྣར། པེ།༽ ཞི་གནས་"
    },
    {
      "span": {
        "start": 28569,
        "end": 28576
      },
      "text": "མཉམ་དུ་ ༼སྣར། པེ།༽ མཉམ་པར་"
    },
    {
      "span": {
        "start": 28602,
        "end": 28610
      },
      "text": "གནོད་པར་ ༼སྣར། པེ།༽ གནོད་པ་"
    },
    {
      "span": {
        "start": 28667,
        "end": 28682
      },
      "text": "ལུས་ལ་སོགས་པ་ལ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 28780,
        "end": 28788
      },
      "text": "མིག་ཡོར་ ༼སྣར། པེ།༽ མིག་གཡོར་"
    },
    {
      "span": {
        "start": 28910,
        "end": 28920
      },
      "text": "གྱུར་གྱིས། ༼སྣར། པེ།༽ འགྱུར་གྱི།"
    },
    {
      "span": {
        "start": 28970,
        "end": 28978
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 29023,
        "end": 29026
      },
      "text": "དང་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 29183,
        "end": 29193
      },
      "text": "ངལ་གསོ་བར་ ༼ཅོ།༽ ངལ་གསོལ་ ༼སྣར། པེ།༽ ངལ་བསོ་བར་"
    },
    {
      "span": {
        "start": 29233,
        "end": 29242
      },
      "text": "འབྲེལ་པར་ ༼སྣར། པེ།༽ འབྲེལ་པ་"
    },
    {
      "span": {
        "start": 29279,
        "end": 29285
      },
      "text": "པ་དང་། ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 29356,
        "end": 29361
      },
      "text": "འདིས་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 29364,
        "end": 29406
      },
      "text": "ཚོད་གཅིག་གམ། མེལ་ཚེ་ཐུན་ཕྱེད་དམ། ཐུན་གཅིག་ ༼སྣར། པེ།༽ ཚོད་ཅིག་"
    },
    {
      "span": {
        "start": 29477,
        "end": 29500
      },
      "text": "རབ་ཏུ་རྣམ་པར་འབྱེད་པའི་ ༼སྣར། པེ།༽ རབ་ཏུ་དབྱེ་བའི་"
    },
    {
      "span": {
        "start": 29590,
        "end": 29597
      },
      "text": "ཀྲུང་མ་ ༼སྣར། པེ།༽ ཀྲུང་མི་"
    },
    {
      "span": {
        "start": 29858,
        "end": 29863
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 30177,
        "end": 30180
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 30216,
        "end": 30228
      },
      "text": "སྙམ་དུ་བསམས་ ༼སྣར།༽ སྙམ་པ་སེམས་ ༼པེ།༽ སྙམ་བསམས་"
    },
    {
      "span": {
        "start": 30258,
        "end": 30267
      },
      "text": "བཤིག་སྟེ་ ༼སྣར། པེ།༽ བཤིག་ཏེ་"
    },
    {
      "span": {
        "start": 30433,
        "end": 30439
      },
      "text": "དེ་ནས་ ༼སྣར། པེ།༽ དེ་ན་"
    },
    {
      "span": {
        "start": 30490,
        "end": 30499
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 30591,
        "end": 30600
      },
      "text": "དེ་རྣམ་པ་ ༼སྣར། པེ།༽ དེ་རྣམས་"
    },
    {
      "span": {
        "start": 30646,
        "end": 30656
      },
      "text": "བསྒྲུབས་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 30811,
        "end": 30822
      },
      "text": "བསྒྲུབ་པའི་ ༼སྣར། པེ།༽ སྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 31149,
        "end": 31153
      },
      "text": "ཞིང་ ༼སྣར། པེ།༽ ཞི་"
    },
    {
      "span": {
        "start": 31289,
        "end": 31303
      },
      "text": "སངས་རྒྱས་རྣམས་ ༼སྣར། པེ།༽ སངས་རྒྱས་"
    },
    {
      "span": {
        "start": 31538,
        "end": 31560
      },
      "text": "ཡེ་ཤེས་དེ་ནི་ཐབས་ཀྱིས་ ༼སྣར། པེ།༽ ཡེ་ཤེས་ཀྱི་"
    },
    {
      "span": {
        "start": 31828,
        "end": 31838
      },
      "text": "བསྒྲུབས་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 31941,
        "end": 31950
      },
      "text": "ཕ་རོལ་ཏུ་ ༼སྣར།༽ ཕ་རོལ་"
    },
    {
      "span": {
        "start": 31972,
        "end": 31977
      },
      "text": "བྱའི། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 32000,
        "end": 32010
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 32017,
        "end": 32024
      },
      "text": "བྱ་ཞེས་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 32152,
        "end": 32156
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 32186,
        "end": 32193
      },
      "text": "བྱིན་པ་ ༼སྣར། པེ།༽ སྦྱིན་པ་"
    },
    {
      "span": {
        "start": 32272,
        "end": 32281
      },
      "text": "འདས་ཀྱིས་ ༼ཅོ།༽ འདས་ཀྱི་"
    },
    {
      "span": {
        "start": 32292,
        "end": 32301
      },
      "text": "བྱམས་པ་ང་ ༼སྣར། པེ།༽ བྱམས་པ་"
    },
    {
      "span": {
        "start": 32854,
        "end": 32871
      },
      "text": "དེ་དག་འདི་སྐད་དུ་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 32918,
        "end": 32926
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར། པེ།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 33075,
        "end": 33082
      },
      "text": "ཉན་ཐོས་ ༼སྣར། པེ།༽ ཉན་ཐོས་ཀྱི་"
    },
    {
      "span": {
        "start": 33126,
        "end": 33135
      },
      "text": "ཐབས་ཀྱིས་ ༼སྣར། པེ།༽ ཐབས་ཀྱི་"
    },
    {
      "span": {
        "start": 33143,
        "end": 33150
      },
      "text": "ནུས་པར་ ༼སྣར། པེ།༽ ནུས་པ་"
    },
    {
      "span": {
        "start": 33308,
        "end": 33334
      },
      "text": "ཤེས་རབ་ཐབས་མཁས་པས་ཡོངས་སུ་ ༼སྣར། པེ།༽ ཐབས་མཁས་པས་"
    },
    {
      "span": {
        "start": 33338,
        "end": 33343
      },
      "text": "པ་དེ་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 33524,
        "end": 33533
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 33552,
        "end": 33562
      },
      "text": "ལ་སོགས་པར་ ༼སྣར། པེ།༽ ལ་སོགས་པ་ལ་"
    },
    {
      "span": {
        "start": 33821,
        "end": 33831
      },
      "text": "ཀྱི་ལམ་ནི་ ༼སྣར། པེ།༽ ཀྱི་ལམ་"
    },
    {
      "span": {
        "start": 33838,
        "end": 33848
      },
      "text": "དང་ཐབས་དང་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 33864,
        "end": 33878
      },
      "text": "དེ་བས་ན་དེ་དག་ ༼སྣར། པེ།༽ དེས་ན་"
    },
    {
      "span": {
        "start": 34042,
        "end": 34056
      },
      "text": "སྟོབས་ཀྱིས་ནི་ ༼སྣར། པེ།༽ སྟོབས་ཀྱིས་"
    },
    {
      "span": {
        "start": 34083,
        "end": 34097
      },
      "text": "སྟོབས་ཀྱིས་ནི་ ༼སྣར། པེ།༽ སྟོབས་ཀྱིས་"
    },
    {
      "span": {
        "start": 34198,
        "end": 34208
      },
      "text": "མདོར་བསྡུ་ ༼སྣར། པེ།༽ མདོར་བསྡུས་"
    },
    {
      "span": {
        "start": 34355,
        "end": 34361
      },
      "text": "ཐབས་ལ་ ༼སྣར། པེ།༽ ཐབས་"
    },
    {
      "span": {
        "start": 34580,
        "end": 34728
      },
      "text": "སྲིད་པའི་འགྲོ་བར་འགྲོ་བ་ནི་ཐར་པའོ། །ཤེས་རབ་མེད་པར་སྲིད་པར་འགྲོ་བ་ཡོངས་སུ་འཛིན་པ་ནི་བྱང་ཆུབ་སེམས་དཔའི་འཆིང་བའོ། །ཤེས་རབ་ཀྱིས་སྲིད་པའི་འགྲོ་བར་འགྲོ་བ་ ༼སྣར། པེ།༽ སྲིད་པར་འགྲོ་བ་ཡོངས་སུ་འཛིན་པ་"
    },
    {
      "span": {
        "start": 34744,
        "end": 34751
      },
      "text": "ཀྱིས་མ་ ༼སྣར། པེ།༽ ཀྱིས་མི་"
    },
    {
      "span": {
        "start": 34816,
        "end": 34828
      },
      "text": "ཤེས་རབ་ཀྱིས་ ༼སྣར། པེ།༽ ཤེས་རབ་ཀྱི་"
    },
    {
      "span": {
        "start": 34953,
        "end": 34965
      },
      "text": "ཉན་ཐོས་ཀྱིས་ ༼སྣར། པེ།༽ ཉན་ཐོས་ཀྱི་"
    },
    {
      "span": {
        "start": 35165,
        "end": 35173
      },
      "text": "ལྷགས་པས་ ༼སྣར།༽ ལྷག་པས་"
    },
    {
      "span": {
        "start": 35179,
        "end": 35190
      },
      "text": "ལ་མེ་བསྟེན་ ༼སྣར། པེ།༽ མེ་ལ་བརྟེན་"
    },
    {
      "span": {
        "start": 35232,
        "end": 35238
      },
      "text": "ལྷག་པ་ ༼སྣར། པེ།༽ ལྷགས་པ་"
    },
    {
      "span": {
        "start": 35269,
        "end": 35281
      },
      "text": "ཤེས་རབ་ཀྱིས་ ༼སྣར། པེ།༽ ཤེས་རབ་ཀྱི་"
    },
    {
      "span": {
        "start": 35419,
        "end": 35423
      },
      "text": "ཞིག་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 35443,
        "end": 35451
      },
      "text": "གྱུར་ཏོ། ༼སྣར། པེ།༽ གྱུར་ཏེ།"
    },
    {
      "span": {
        "start": 35593,
        "end": 35601
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 35606,
        "end": 35616
      },
      "text": "སྙམ་དུ་མི་ ༼སྣར། པེ།༽ སྙམ་དུ་"
    },
    {
      "span": {
        "start": 35757,
        "end": 35766
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་དཔའི་"
    },
    {
      "span": {
        "start": 35991,
        "end": 36000
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་དཔའི་"
    },
    {
      "span": {
        "start": 36178,
        "end": 36188
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 36269,
        "end": 36282
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་"
    },
    {
      "span": {
        "start": 36524,
        "end": 36533
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 36622,
        "end": 36628
      },
      "text": "དེ་ལྟ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 36851,
        "end": 36860
      },
      "text": "འདས་པ་ཡང་ ༼སྣར། པེ།༽ འདས་པ་"
    },
    {
      "span": {
        "start": 36873,
        "end": 36878
      },
      "text": "འཐོབ་ ༼སྣར། པེ།༽ ཐོབ་"
    },
    {
      "span": {
        "start": 37225,
        "end": 37230
      },
      "text": "ངས་མ་ ༼སྣར། པེ།༽ ངས་"
    },
    {
      "span": {
        "start": 37255,
        "end": 37261
      },
      "text": "དེ་ལྟ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 37443,
        "end": 37451
      },
      "text": "བརྟེན་པ་ ༼སྣར། པེ།༽ བསྟེན་པ་"
    },
    {
      "span": {
        "start": 37511,
        "end": 37529
      },
      "text": "ཤེས་རབ་གང་ཡང་བྱུང་ ༼སྣར། པེ།༽ ཤེས་རབ་འབྱུང་"
    },
    {
      "span": {
        "start": 37545,
        "end": 37553
      },
      "text": "བརྟེན་པ་ ༼སྣར། པེ།༽ བསྟེན་པ་"
    },
    {
      "span": {
        "start": 37553,
        "end": 37561
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་བ་དེ་"
    },
    {
      "span": {
        "start": 37884,
        "end": 37892
      },
      "text": "བརྟེན་པ་ ༼སྣར། པེ།༽ བསྟེན་པ་"
    },
    {
      "span": {
        "start": 38039,
        "end": 38049
      },
      "text": "སེམས་ཅན་ལ་ ༼སྣར། པེ།༽ སེམས་ཅན་"
    },
    {
      "span": {
        "start": 38052,
        "end": 38057
      },
      "text": "བས་ན་ ༼སྣར། པེ།༽ བས་"
    },
    {
      "span": {
        "start": 38365,
        "end": 38373
      },
      "text": "ཐབས་ཀྱི་ ༼སྣར།༽ ཐབས་ཀྱིས་"
    },
    {
      "span": {
        "start": 38579,
        "end": 38586
      },
      "text": "བྱེད་པ་ ༼སྣར། པེ།༽ བྱེད་པར་"
    },
    {
      "span": {
        "start": 38738,
        "end": 38742
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 39063,
        "end": 39069
      },
      "text": "གནས་པ་ ༼པེ།༽ གནས་པ་ལ་གནས་པ་"
    },
    {
      "span": {
        "start": 39266,
        "end": 39287
      },
      "text": "སེམས་བསྐྱེད་པའི་ཕྱིར་ ༼སྣར། པེ།༽ སེམས་སྐྱེད་པ་"
    },
    {
      "span": {
        "start": 39639,
        "end": 39648
      },
      "text": "བྱས་པ་དེ་ ༼སྣར། པེ།༽ བྱས་པ་སྟེ་"
    },
    {
      "span": {
        "start": 39810,
        "end": 39814
      },
      "text": "རངས་ ༼སྣར། པེ།༽ རང་"
    },
    {
      "span": {
        "start": 39953,
        "end": 39960
      },
      "text": "བྱང་བར་ ༼སྣར། པེ།༽ འབྱང་བར་"
    },
    {
      "span": {
        "start": 40208,
        "end": 40219
      },
      "text": "སྟོབས་ཀྱིས་ ༼སྣར། པེ།༽ སྟོབས་ཀྱི་"
    },
    {
      "span": {
        "start": 40277,
        "end": 40286
      },
      "text": "འདས་རྣམས་ ༼སྣར། པེ།༽ འདས་"
    },
    {
      "span": {
        "start": 40505,
        "end": 40516
      },
      "text": "ཁྱིམ་དུ་ཡང་ ༼སྣར། པེ།༽ ཁྱིམ་དུ་"
    },
    {
      "span": {
        "start": 40694,
        "end": 40705
      },
      "text": "སྨིན་པར་ཡང་ ༼སྣར། པེ།༽ སྨིན་པར་"
    },
    {
      "span": {
        "start": 40802,
        "end": 40809
      },
      "text": "བྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 40924,
        "end": 40933
      },
      "text": "སེམས་ཀྱི་ ༼སྣར། པེ།༽ སེམས་འདི་"
    },
    {
      "span": {
        "start": 41009,
        "end": 41014
      },
      "text": "གཙུབ་ ༼སྣར། པེ།༽ གཙུབས་"
    },
    {
      "span": {
        "start": 41268,
        "end": 41271
      },
      "text": "མར་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 41283,
        "end": 41308
      },
      "text": "ཐམས་ཅད་བདག་མེད་པའི་ངོ་བོ་ ༼སྣར། པེ།༽ བདག་མེད་པའི་"
    },
    {
      "span": {
        "start": 41340,
        "end": 41348
      },
      "text": "ལམ་གྱིས་ ༼སྣར། པེ།༽ ལམ་གྱི་"
    },
    {
      "span": {
        "start": 41398,
        "end": 41404
      },
      "text": "དབྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 41631,
        "end": 41639
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 41785,
        "end": 41796
      },
      "text": "བསམ་གཏན་དེ་ ༼སྣར། པེ།༽ བསམ་གཏན་ཏེ་"
    },
    {
      "span": {
        "start": 41942,
        "end": 41950
      },
      "text": "དབང་གིས་ ༼སྣར། པེ།༽ དབང་གི་"
    },
    {
      "span": {
        "start": 42081,
        "end": 42084
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 42181,
        "end": 42191
      },
      "text": "བསྒོམས་པས་ ༼སྣར། པེ།༽ སྒོམ་པས་"
    },
    {
      "span": {
        "start": 42300,
        "end": 42325
      },
      "text": "གོང་མ་ཐོབ་པའི་ཕྱིར་ས་འོག་ ༼སྣར། པེ།༽ གོང་མ་ཐོ་བའི་ཕྱིར་གོང་"
    },
    {
      "span": {
        "start": 42607,
        "end": 42618
      },
      "text": "རིམ་གྱིས་ས་ ༼སྣར། པེ།༽ རིམ་གྱི་"
    },
    {
      "span": {
        "start": 43105,
        "end": 43118
      },
      "text": "ལུས་པ་རབ་ཀྱི་ ༼སྣར། པེ།༽ ལུས་པ་"
    },
    {
      "span": {
        "start": 43133,
        "end": 43138
      },
      "text": "གྱུར། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 43198,
        "end": 43210
      },
      "text": "ཁམས་ཀྱི་མཐས་ ༼སྣར། པེ།༽ ཁམས་མཐའ་"
    },
    {
      "span": {
        "start": 43219,
        "end": 43227
      },
      "text": "བཞུགས་པ་ ༼སྣར། པེ།༽ ཞུགས་པ་"
    },
    {
      "span": {
        "start": 43583,
        "end": 43588
      },
      "text": "སོགས་ ༼སྣར།༽ སྭོ་"
    },
    {
      "span": {
        "start": 43902,
        "end": 43909
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    }
  ]
}