{
  "durchens": [
    {
      "span": {
        "start": 27,
        "end": 31
      },
      "text": "ཀྲི་ ༼སྣར། པེ།༽ ཀྲྀ་"
    },
    {
      "span": {
        "start": 203,
        "end": 210
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེས་"
    },
    {
      "span": {
        "start": 369,
        "end": 375
      },
      "text": "འཚལ་བ་ ༼སྣར། པེ།༽ བཙལ་བ་"
    },
    {
      "span": {
        "start": 397,
        "end": 404
      },
      "text": "དབུལ་བ་ ༼སྣར། པེ།༽ འབུལ་བ་"
    },
    {
      "span": {
        "start": 523,
        "end": 531
      },
      "text": "བསྟོད་པ་ ༼སྣར། པེ།༽ སྟོད་པ་"
    },
    {
      "span": {
        "start": 1064,
        "end": 1072
      },
      "text": "གོ་རིམས་ ༼སྣར། པེ།༽ གོ་རིམ་"
    },
    {
      "span": {
        "start": 1260,
        "end": 1268
      },
      "text": "གོ་རིམས་ ༼སྣར། པེ།༽ གོ་རིམ་"
    },
    {
      "span": {
        "start": 1361,
        "end": 1368
      },
      "text": "དྲག་པོ་ ༼སྣར། པེ།༽ དྲག་པོས་"
    },
    {
      "span": {
        "start": 1377,
        "end": 1380
      },
      "text": "ཇི་ ༼སྣར། པེ།༽ ཇི་མི་"
    },
    {
      "span": {
        "start": 1449,
        "end": 1460
      },
      "text": "ཤེས་རབ་ཀྱི་ ༼སྣར།༽ ཤེས་རབ་ཀྱིས་"
    },
    {
      "span": {
        "start": 1532,
        "end": 1538
      },
      "text": "གཞག་པ་ ༼སྣར། པེ།༽ བཞག་པ་"
    },
    {
      "span": {
        "start": 1702,
        "end": 1713
      },
      "text": "གོ་རིམས་སོ། ༼སྣར། པེ།༽ གོ་རིམ་མོ།"
    },
    {
      "span": {
        "start": 1841,
        "end": 1849
      },
      "text": "གོ་རིམས་ ༼སྣར། པེ།༽ གོ་རིམ་"
    }
  ]
}