{
  "durchens": [
    {
      "span": {
        "start": 188,
        "end": 194
      },
      "text": "གཅད་པ་ ༼སྣར། པེ།༽ བཅད་པ་"
    },
    {
      "span": {
        "start": 331,
        "end": 336
      },
      "text": "གཤིས་ ༼སྣར། པེ།༽ བཤིས་"
    },
    {
      "span": {
        "start": 500,
        "end": 505
      },
      "text": "བསྟན། ༼སྣར། པེ།༽ བསྟནཏེ།"
    },
    {
      "span": {
        "start": 622,
        "end": 628
      },
      "text": "རྐྱེན་ ༼སྣར། པེ།༽ རྐང་"
    },
    {
      "span": {
        "start": 639,
        "end": 648
      },
      "text": "ངོས་གཟུང་ ༼སྣར། པེ།༽ ངོས་བཟུང་"
    },
    {
      "span": {
        "start": 676,
        "end": 681
      },
      "text": "མཆེད་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 740,
        "end": 745
      },
      "text": "སེམས་ ༼སྣར། པེ།༽ སེམས་ཅན་"
    },
    {
      "span": {
        "start": 791,
        "end": 798
      },
      "text": "ངག་སྒྲ་ ༼སྣར། པེ།༽ སྒྲ་"
    },
    {
      "span": {
        "start": 805,
        "end": 809
      },
      "text": "གྲག་ ༼སྣར། པེ།༽ གྲགས་"
    },
    {
      "span": {
        "start": 834,
        "end": 842
      },
      "text": "སྟེང་དུ་ ༼སྣར། པེ།༽ སྟེངས་སུ་"
    },
    {
      "span": {
        "start": 849,
        "end": 854
      },
      "text": "ལྟ་བ་ ༼སྣར། པེ།༽ བལྟ་བ་"
    },
    {
      "span": {
        "start": 999,
        "end": 1006
      },
      "text": "བྱུང་བ་ ༼སྣར། པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 1090,
        "end": 1099
      },
      "text": "ངོས་གཟུང་ ༼སྣར། པེ།༽ ངོས་བཟུང་"
    },
    {
      "span": {
        "start": 1235,
        "end": 1241
      },
      "text": "བཟླ་བ་ ༼སྣར། པེ།༽ ཟླ་བ་"
    },
    {
      "span": {
        "start": 1262,
        "end": 1267
      },
      "text": "གཤིས་ ༼སྣར། པེ།༽ བཤིག་"
    },
    {
      "span": {
        "start": 1297,
        "end": 1304
      },
      "text": "གཅད་པས་ ༼སྣར། པེ།༽ བཅད་པས་"
    },
    {
      "span": {
        "start": 1384,
        "end": 1398
      },
      "text": "འཁོར་ཕྲེང་བ་ལ་ ༼སྣར། པེ།༽ འཁོར་ལས་"
    },
    {
      "span": {
        "start": 1476,
        "end": 1482
      },
      "text": "ལ་བཟླ་ ༼སྣར། པེ།༽ བཟླ་"
    },
    {
      "span": {
        "start": 1551,
        "end": 1559
      },
      "text": "འཁོར་ཅན་ ༼སྣར། པེ།༽ འཁོར་རྐྱེན་"
    },
    {
      "span": {
        "start": 1575,
        "end": 1580
      },
      "text": "ཟློས་ ༼སྣར། པེ།༽ བཟློས་"
    },
    {
      "span": {
        "start": 1610,
        "end": 1627
      },
      "text": "ཕེབས་པའོ། །རང་གི་ ༼སྣར། པེ།༽ ཕེབས་པའོ། །།།རང་"
    },
    {
      "span": {
        "start": 1664,
        "end": 1668
      },
      "text": "ལུས་ ༼སྣར། པེ།༽ ལུས་ལ་"
    },
    {
      "span": {
        "start": 1819,
        "end": 1827
      },
      "text": "ཕྲད་པའི་ ༼སྣར། པེ།༽ ཕྲེང་བའི་"
    },
    {
      "span": {
        "start": 1904,
        "end": 1927
      },
      "text": "གནས་པར་བྱེད་པའི་ལུས་ངག་ ༼སྣར། པེ།༽ གནས་གང་"
    },
    {
      "span": {
        "start": 2209,
        "end": 2216
      },
      "text": "གྲགས་པ་ ༼སྣར། པེ།༽ གྲག་པ་"
    },
    {
      "span": {
        "start": 2333,
        "end": 2338
      },
      "text": "གཡོང་ ༼སྣར། པེ།༽ གཡོ་བ་"
    },
    {
      "span": {
        "start": 2433,
        "end": 2444
      },
      "text": "རང་བྱུང་གི་ ༼སྣར། པེ།༽ རང་བྱུང་"
    },
    {
      "span": {
        "start": 2566,
        "end": 2574
      },
      "text": "ཤར་བས་ན་ ༼སྣར། པེ།༽ ཤར་བས་"
    },
    {
      "span": {
        "start": 2587,
        "end": 2591
      },
      "text": "ཤེས་ ༼ཅོ། སྡེ།༽ ཤིས་"
    },
    {
      "span": {
        "start": 2596,
        "end": 2602
      },
      "text": "བའོ། ། ༼སྣར། པེ།༽ ། །།།"
    },
    {
      "span": {
        "start": 2799,
        "end": 2805
      },
      "text": "བའོ། ། ༼སྣར། པེ།༽ ། །།།"
    },
    {
      "span": {
        "start": 2984,
        "end": 2988
      },
      "text": "བཅས། ༼སྣར། པེ།༽ བཅསལ།"
    },
    {
      "span": {
        "start": 3137,
        "end": 3147
      },
      "text": "རྗེས་འཛིན་ ༼སྣར། པེ།༽ རྗེས་འཛིན་པ་"
    },
    {
      "span": {
        "start": 3836,
        "end": 3844
      },
      "text": "ཟབ་མོའི་ ༼སྣར། པེ།༽ ཟབ་མོའི་ཡིད་ཆོས་ཉིད་ཟབ་མོའི་"
    },
    {
      "span": {
        "start": 4432,
        "end": 4438
      },
      "text": "རིམ་པ་ ༼པེ།༽ རིམ་"
    },
    {
      "span": {
        "start": 4912,
        "end": 4920
      },
      "text": "ཡིད་ཀྱི་ ༼སྣར། པེ།༽ ཡིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 5173,
        "end": 5177
      },
      "text": "ཕྱེ་ ༼སྣར། པེ།༽ ཕྱེ་མ་"
    },
    {
      "span": {
        "start": 5179,
        "end": 5185
      },
      "text": "བསྒོམ་ ༼སྣར། པེ།༽ སྒོམ་"
    },
    {
      "span": {
        "start": 5311,
        "end": 5316
      },
      "text": "སྒོམ་ ༼སྣར། པེ།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 5711,
        "end": 5720
      },
      "text": "བསྐོར་བས། ༼སྣར། པེ།༽ བསྐོར་བ།"
    },
    {
      "span": {
        "start": 5988,
        "end": 5992
      },
      "text": "ཐོབ། ༼སྣར། པེ།༽ ཐོབལ།"
    },
    {
      "span": {
        "start": 6009,
        "end": 6016
      },
      "text": "ཐོབ་བོ། ༼སྣར། པེ།༽ ཐོབ་པའོ།"
    },
    {
      "span": {
        "start": 6343,
        "end": 6348
      },
      "text": "གཏང་། ༼སྣར། པེ།༽ བཏང་།"
    },
    {
      "span": {
        "start": 6442,
        "end": 6448
      },
      "text": "ཆུ་ཟླ་ ༼སྣར། པེ།༽ ཆུ་"
    }
  ]
}