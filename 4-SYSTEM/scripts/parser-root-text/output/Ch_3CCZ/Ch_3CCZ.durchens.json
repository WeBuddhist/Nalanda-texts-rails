{
  "durchens": [
    {
      "span": {
        "start": 912,
        "end": 920
      },
      "text": "དབང་གིས་ ༼སྣར། པེ།༽ དབང་གི་"
    },
    {
      "span": {
        "start": 1288,
        "end": 1292
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 1621,
        "end": 1628
      },
      "text": "ལྟོས་པ་ ༼སྣར། པེ།༽ བལྟོས་པ་"
    },
    {
      "span": {
        "start": 2087,
        "end": 2094
      },
      "text": "མེད་པས་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 2251,
        "end": 2259
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 2332,
        "end": 2341
      },
      "text": "སངས་ཐུགས་ ༼སྣར། པེ།༽ སངས་རྒྱས་"
    },
    {
      "span": {
        "start": 2675,
        "end": 2682
      },
      "text": "རྟོག་པ་ ༼སྡེ།༽ རྟོགས་པ་མི་"
    },
    {
      "span": {
        "start": 2686,
        "end": 2691
      },
      "text": "བ་ཡི། ༼སྣར། པེ།༽ བའི།"
    },
    {
      "span": {
        "start": 2717,
        "end": 2723
      },
      "text": "བྱུང་། ༼སྣར། པེ།༽ འབྱུང་།"
    },
    {
      "span": {
        "start": 2894,
        "end": 2906
      },
      "text": "བཞག་པར་གྱིས། ༼སྣར།༽ བཞག་པར་བགྱི།"
    },
    {
      "span": {
        "start": 3007,
        "end": 3013
      },
      "text": "བརྗོད་ ༼པེ།༽ རྗོད་"
    },
    {
      "span": {
        "start": 3234,
        "end": 3242
      },
      "text": "ཆོས་ཞེས་ ༼སྣར། པེ།༽ ཆོས་ཤེས་"
    },
    {
      "span": {
        "start": 4672,
        "end": 4676
      },
      "text": "འདི་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 5066,
        "end": 5069
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 5106,
        "end": 5114
      },
      "text": "ལས་ཀྱིས་ ༼སྣར། པེ།༽ ལས་ཀྱི་"
    },
    {
      "span": {
        "start": 5274,
        "end": 5282
      },
      "text": "འདས་ཐོབ་ ༼སྣར།༽ འདས་པའི་"
    },
    {
      "span": {
        "start": 5338,
        "end": 5345
      },
      "text": "སྐྱེ་བ་ ༼སྣར། པེ།༽ སྐྱེས་པ་"
    },
    {
      "span": {
        "start": 5424,
        "end": 5429
      },
      "text": "སྤོང་ ༼སྣར། པེ།༽ སྤང་"
    },
    {
      "span": {
        "start": 5562,
        "end": 5571
      },
      "text": "མཚན་གྱིས་ ༼སྣར། པེ།༽ མཚན་གྱི་"
    },
    {
      "span": {
        "start": 5596,
        "end": 5603
      },
      "text": "ལྡན་ཡང་ ༼སྣར། པེ།༽ ལྡན་པའང་"
    },
    {
      "span": {
        "start": 5831,
        "end": 5833
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལས།"
    },
    {
      "span": {
        "start": 6054,
        "end": 6062
      },
      "text": "སྔོན་དུ་ ༼སྣར། པེ།༽ མངོན་དུ་"
    },
    {
      "span": {
        "start": 6151,
        "end": 6159
      },
      "text": "འགྲོ་ཡི། ༼སྣར། པེ།༽ འགྲོ་ཡིས།"
    },
    {
      "span": {
        "start": 6910,
        "end": 6915
      },
      "text": "གྱུར། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 7101,
        "end": 7105
      },
      "text": "སྙམ་ ༼སྣར། པེ།༽ མཉམ་"
    }
  ]
}