{
  "durchens": [
    {
      "span": {
        "start": 1004,
        "end": 1009
      },
      "text": "སྐོད་ ༼སྣར། པེ།༽ སྐོངས་"
    },
    {
      "span": {
        "start": 1416,
        "end": 1433
      },
      "text": "ཏྲི་པི་ཏ་ཀ་མ་ལའི་ ༼སྣར། པེ།༽ ཏྲི་པིད་ཏྲ་མའི་"
    },
    {
      "span": {
        "start": 1599,
        "end": 1602
      },
      "text": "ཞལ་ ༼སྣར།༽ ཞལ་སྔ་"
    },
    {
      "span": {
        "start": 1609,
        "end": 1613
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིར་"
    },
    {
      "span": {
        "start": 1643,
        "end": 1657
      },
      "text": "བྱེད་པའི་ཆོ་ག་ ༼སྣར། པེ།༽ བྱེད་པའི་ཆོས་"
    },
    {
      "span": {
        "start": 1687,
        "end": 1697
      },
      "text": "འབྲས་བུའི་ ༼སྣར། པེ།༽ འབྲས་བུ་དག་གི་"
    },
    {
      "span": {
        "start": 2209,
        "end": 2215
      },
      "text": "ཕ་རོལ་ ༼སྣར། པེ།༽ ཕ་རོལ་ཏུ་"
    },
    {
      "span": {
        "start": 2420,
        "end": 2424
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱི་གནད་ཀྱི་"
    },
    {
      "span": {
        "start": 2467,
        "end": 2471
      },
      "text": "ཏོག་ ༼སྣར།༽ རྟོག་"
    },
    {
      "span": {
        "start": 2518,
        "end": 2530
      },
      "text": "དམ་ཚིག་རྣམས་ ༼སྣར། པེ།༽ དམ་ཚིག་"
    },
    {
      "span": {
        "start": 2668,
        "end": 2675
      },
      "text": "སྐོང་བ་ ༼སྣར། པེ།༽ སྐོངས་པ་"
    },
    {
      "span": {
        "start": 2695,
        "end": 2708
      },
      "text": "དང་བསྐང་བ་དང་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 2726,
        "end": 2734
      },
      "text": "བསྐངས་པ་ ༼སྣར། པེ།༽ བསྐང་བ་"
    },
    {
      "span": {
        "start": 3231,
        "end": 3242
      },
      "text": "སྦོམ་པོ་དང་ ༼སྣར། པེ།༽ སྦོམ་པོ་"
    },
    {
      "span": {
        "start": 4009,
        "end": 4012
      },
      "text": "ཅུ་ ༼སྣར། པེ།༽ བཅུ་"
    },
    {
      "span": {
        "start": 4183,
        "end": 4190
      },
      "text": "ཤིགས་པ་ ༼སྣར། པེ།༽ བཤིག་པ་"
    },
    {
      "span": {
        "start": 4206,
        "end": 4214
      },
      "text": "གཅན་གཟན་ ༼སྣར། པེ།༽ གཅན་ཟན་"
    },
    {
      "span": {
        "start": 4245,
        "end": 4255
      },
      "text": "རྒྱལ་མོའི་ ༼སྣར། པེ།༽ རྒྱལ་མོ་"
    },
    {
      "span": {
        "start": 4315,
        "end": 4321
      },
      "text": "བྲེགས་ ༼སྣར།༽ བྲབས་ ༼པེ།༽ ཕྲབས་"
    },
    {
      "span": {
        "start": 4404,
        "end": 4414
      },
      "text": "ཟེའུ་འབྲུ་ ༼སྣར། པེ།༽ ཟེ་འབྲུ་"
    },
    {
      "span": {
        "start": 4418,
        "end": 4422
      },
      "text": "བྱེ། ༼སྣར། པེ།༽ དབྱེ།"
    },
    {
      "span": {
        "start": 4452,
        "end": 4458
      },
      "text": "བརྟགས་ ༼སྣར།༽ རྟགས་"
    },
    {
      "span": {
        "start": 4535,
        "end": 4540
      },
      "text": "རྟགས་ ༼སྣར། པེ།༽ བརྟགས་"
    },
    {
      "span": {
        "start": 4666,
        "end": 4672
      },
      "text": "བླུགས་ ༼སྣར། པེ།༽ བླུག་"
    },
    {
      "span": {
        "start": 4769,
        "end": 4773
      },
      "text": "བཅག་ ༼སྣར། པེ།༽ གཅག་"
    },
    {
      "span": {
        "start": 4891,
        "end": 4899
      },
      "text": "བུད་ཤིང་ ༼སྣར། པེ།༽ བུར་ཤིང་"
    },
    {
      "span": {
        "start": 4924,
        "end": 4929
      },
      "text": "འཐོར་ ༼སྣར། པེ།༽ མཐོར་"
    },
    {
      "span": {
        "start": 4934,
        "end": 4942
      },
      "text": "དྲག་པོས་ ༼སྣར།༽ དྲག་པོ་"
    },
    {
      "span": {
        "start": 4985,
        "end": 4991
      },
      "text": "འོལ་ཀ་ ༼སྣར། པེ།༽ འོལ་ཀར་"
    },
    {
      "span": {
        "start": 5009,
        "end": 5017
      },
      "text": "རྒྱལ་པོ་ ༼སྣར། པེ།༽ རྒྱལ་པོས་"
    },
    {
      "span": {
        "start": 5107,
        "end": 5113
      },
      "text": "དབྲོག་ ༼སྣར། པེ།༽ དབོག་"
    },
    {
      "span": {
        "start": 5202,
        "end": 5208
      },
      "text": "ཀསྤུར། ༼སྣར། པེ།༽ ཀསྟུ་ར།"
    },
    {
      "span": {
        "start": 5215,
        "end": 5222
      },
      "text": "ཀབྤུ་ར། ༼པེ།༽ ཀབྤུ་རུ།"
    },
    {
      "span": {
        "start": 5538,
        "end": 5544
      },
      "text": "འཁྲིག་ ༼སྣར། པེ།༽ འཕྲིག་"
    },
    {
      "span": {
        "start": 5678,
        "end": 5685
      },
      "text": "དམ་ཚིག་ ༼སྣར། པེ།༽ དམ་ཚིག་གི་"
    },
    {
      "span": {
        "start": 5706,
        "end": 5715
      },
      "text": "བཅོས་དཀར་ ༼སྣར། པེ།༽ བཅོས་ཀར་"
    },
    {
      "span": {
        "start": 5930,
        "end": 5936
      },
      "text": "ཉམས་པ་ ༼སྣར། པེ།༽ ཉམས་"
    },
    {
      "span": {
        "start": 6006,
        "end": 6010
      },
      "text": "ཟླས་ ༼སྣར།༽ ཟླས་པ་ ༼པེ།༽ ཟློས་པ་"
    },
    {
      "span": {
        "start": 6134,
        "end": 6141
      },
      "text": "བརྙས་པ་ ༼སྣར། པེ།༽ བསྙས་པ་"
    },
    {
      "span": {
        "start": 6240,
        "end": 6247
      },
      "text": "འཁུས་པ་ ༼སྣར། པེ།༽ འཁུས་པས་"
    },
    {
      "span": {
        "start": 6320,
        "end": 6323
      },
      "text": "མན་ ༼སྣར། པེ།༽ ནན་"
    },
    {
      "span": {
        "start": 6340,
        "end": 6349
      },
      "text": "མཚང་འདྲུ་ ༼སྣར། པེ།༽ འཚང་འབྲུ་"
    },
    {
      "span": {
        "start": 6365,
        "end": 6372
      },
      "text": "འཁོན་པ་ ༼སྣར།༽ ཁོན་པ་ ༼པེ།༽ མཁོན་པ་"
    },
    {
      "span": {
        "start": 6770,
        "end": 6776
      },
      "text": "ཆགས་པ་ ༼སྣར། པེ།༽ ཆག་པ་"
    },
    {
      "span": {
        "start": 6806,
        "end": 6812
      },
      "text": "ཆགས་པ་ ༼སྣར། པེ།༽ ཆག་པ་"
    },
    {
      "span": {
        "start": 7164,
        "end": 7170
      },
      "text": "གཏད་པ་ ༼སྣར། པེ།༽ བཏད་པ་"
    },
    {
      "span": {
        "start": 7669,
        "end": 7675
      },
      "text": "གྲོགས་ ༼པེ།༽ གློགས་"
    },
    {
      "span": {
        "start": 7697,
        "end": 7701
      },
      "text": "ཟླས་ ༼སྣར། པེ།༽ བཟླས་"
    },
    {
      "span": {
        "start": 7797,
        "end": 7808
      },
      "text": "ལ་དུས་ཀྱིས་ ༼སྣར། པེ།༽ ལ་དུས་ཀྱི་"
    },
    {
      "span": {
        "start": 7858,
        "end": 7863
      },
      "text": "རྗེས་ ༼པེ།༽ རྗེས་སུ་"
    },
    {
      "span": {
        "start": 8355,
        "end": 8360
      },
      "text": "སྐོང་ ༼སྣར། པེ།༽ བསྐངས་"
    },
    {
      "span": {
        "start": 8403,
        "end": 8412
      },
      "text": "དམ་ཚིག་མ་ ༼སྣར། པེ།༽ དམ་ཚིག་"
    },
    {
      "span": {
        "start": 8550,
        "end": 8559
      },
      "text": "ལ་སོ་སོར་ ༼སྣར། པེ།༽ ལ་སོ་སོ་"
    },
    {
      "span": {
        "start": 8721,
        "end": 8729
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ གྲྭ་"
    },
    {
      "span": {
        "start": 8742,
        "end": 8749
      },
      "text": "བཟུང་བ་ ༼སྣར། པེ།༽ གཟུགས་པ་"
    },
    {
      "span": {
        "start": 8848,
        "end": 8854
      },
      "text": "ལྔ་དང་ ༼སྣར། པེ།༽ ལྔ་"
    },
    {
      "span": {
        "start": 8863,
        "end": 8868
      },
      "text": "གསུམ་ ༼སྣར།༽ སུམ་"
    },
    {
      "span": {
        "start": 9183,
        "end": 9190
      },
      "text": "ཇི་ལྟར་ ༼སྣར། པེ།༽ ཇི་སྐད་"
    },
    {
      "span": {
        "start": 9485,
        "end": 9492
      },
      "text": "དང་རྫས་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 9590,
        "end": 9598
      },
      "text": "བསླང་བར་ ༼སྣར། པེ།༽ སླུ་བར་"
    },
    {
      "span": {
        "start": 9688,
        "end": 9695
      },
      "text": "བཀླག་པ་ ༼སྣར། པེ།༽ ཀླག་པ་"
    },
    {
      "span": {
        "start": 9700,
        "end": 9706
      },
      "text": "ཁ་ཏོན་ ༼པེ།༽ ཁ་ཏོག་"
    },
    {
      "span": {
        "start": 10043,
        "end": 10052
      },
      "text": "བསྐང་ངོ་། ༼སྣར། པེ།༽ བསྐོངས་སོ།"
    },
    {
      "span": {
        "start": 10120,
        "end": 10129
      },
      "text": "བསྐང་སྟེ། ༼སྣར། པེ།༽ སྐོངས་ཏེ་"
    },
    {
      "span": {
        "start": 10139,
        "end": 10158
      },
      "text": "མདོ་ལ་སོགས་པ་ལ་བལྟ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་ལྟ་"
    },
    {
      "span": {
        "start": 10252,
        "end": 10258
      },
      "text": "ཁ་ཐོན་ ༼སྣར། པེ།༽ ཁ་ཏོན་"
    },
    {
      "span": {
        "start": 10360,
        "end": 10368
      },
      "text": "བལྟས་པས་ ༼སྣར། པེ།༽ ལྟས་པས་"
    },
    {
      "span": {
        "start": 10368,
        "end": 10385
      },
      "text": "བསྔོ་བགྲང་བྱ་བའོ། ༼སྣར། པེ།༽ བསྔོ་བགྲངབྱའོ།"
    },
    {
      "span": {
        "start": 10399,
        "end": 10407
      },
      "text": "བསྐངས་པ་ ༼སྣར། པེ།༽ སྐོངས་པ་"
    },
    {
      "span": {
        "start": 11122,
        "end": 11130
      },
      "text": "རྡོ་རྗེ་ ༼སྣར། པེ།༽ རྡོ་རྗེའི་"
    },
    {
      "span": {
        "start": 11274,
        "end": 11280
      },
      "text": "པ་དང་། ༼པེ།༽ པ་"
    },
    {
      "span": {
        "start": 11294,
        "end": 11300
      },
      "text": "ཐོད་པ་ ༼པེ།༽ ཐོས་པ་"
    },
    {
      "span": {
        "start": 11559,
        "end": 11567
      },
      "text": "བྲེགས་པ་ ༼སྣར། པེ།༽ འབག་པ་"
    },
    {
      "span": {
        "start": 11681,
        "end": 11690
      },
      "text": "ཆེན་པོའི་ ༼སྣར། པེ།༽ ཆེན་"
    },
    {
      "span": {
        "start": 11898,
        "end": 11903
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 12093,
        "end": 12100
      },
      "text": "ཚེ་འདི་ ༼སྣར། པེ།༽ ཚེ་"
    },
    {
      "span": {
        "start": 12218,
        "end": 12222
      },
      "text": "བཟི་ ༼སྣར། པེ།༽ གཟི་"
    },
    {
      "span": {
        "start": 12346,
        "end": 12352
      },
      "text": "ལུས་པ་ ༼སྣར།༽ ལུས་པ་མ་"
    },
    {
      "span": {
        "start": 12401,
        "end": 12408
      },
      "text": "ཐོབ་པར་ ༼སྣར། པེ།༽ འཐོབ་པར་"
    },
    {
      "span": {
        "start": 12487,
        "end": 12500
      },
      "text": "ཡིན་པར་འཆི་བ་ ༼སྣར། པེ།༽ ཡིན་པ་"
    },
    {
      "span": {
        "start": 12576,
        "end": 12584
      },
      "text": "རྡོ་རྗེ་ ༼སྣར། པེ།༽ རྡོ་རྗེའི་"
    },
    {
      "span": {
        "start": 12695,
        "end": 12702
      },
      "text": "བསམས་པ་ ༼སྣར། པེ།༽ བསམ་པ་"
    },
    {
      "span": {
        "start": 12727,
        "end": 12732
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 13147,
        "end": 13153
      },
      "text": "འཁྲིད་ ༼སྣར། པེ།༽ ཁྲིད་"
    },
    {
      "span": {
        "start": 13533,
        "end": 13539
      },
      "text": "བཞིའོ། ༼པེ།༽ གཞིའོ།"
    },
    {
      "span": {
        "start": 13649,
        "end": 13658
      },
      "text": "ལ་སོ་སོར་ ༼སྣར། པེ།༽ ལ་སོ་སོ་"
    },
    {
      "span": {
        "start": 13812,
        "end": 13815
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་དེ་"
    },
    {
      "span": {
        "start": 14008,
        "end": 14017
      },
      "text": "ལ་སོ་སོར་ ༼སྣར། པེ།༽ ལ་སོ་སོ་"
    },
    {
      "span": {
        "start": 14130,
        "end": 14137
      },
      "text": "སོ་སོར་ ༼པེ།༽ སོ་སོ་"
    },
    {
      "span": {
        "start": 14292,
        "end": 14299
      },
      "text": "སོ་སོར་ ༼སྣར། པེ།༽ སོ་སོ་"
    },
    {
      "span": {
        "start": 14544,
        "end": 14555
      },
      "text": "ཉུང་ཟད་ཅིག་ ༼སྣར། པེ།༽ ཉུང་ཟད་གཅིག་"
    },
    {
      "span": {
        "start": 14854,
        "end": 14864
      },
      "text": "གཅིག་པུའམ་ ༼སྣར།༽ གཅིག་པོའམ་"
    },
    {
      "span": {
        "start": 15559,
        "end": 15564
      },
      "text": "མནོས་ ༼སྣར། པེ།༽ གནོས་"
    },
    {
      "span": {
        "start": 15594,
        "end": 15606
      },
      "text": "བྱང་ཆུབ་ཀྱི་ ༼པེ།༽ བྱང་ཆུབ་ཀྱིས་"
    },
    {
      "span": {
        "start": 15802,
        "end": 15807
      },
      "text": "སྒོམ་ ༼སྣར། པེ།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 16050,
        "end": 16055
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 16313,
        "end": 16317
      },
      "text": "གསལ་ ༼སྣར། པེ།༽ གསོལ་"
    },
    {
      "span": {
        "start": 16451,
        "end": 16460
      },
      "text": "ཏིང་འཛིན་ ༼པེ།༽ ཏིང་ངེ་འཛིན་"
    },
    {
      "span": {
        "start": 16535,
        "end": 16538
      },
      "text": "ལྷ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 16589,
        "end": 16593
      },
      "text": "བཞི་ ༼པེ།༽ གཞི་"
    },
    {
      "span": {
        "start": 16623,
        "end": 16630
      },
      "text": "རྟག་པར་ ༼སྣར།༽ རྟོག་པར་ ༼པེ།༽ རྟོག་ས་"
    },
    {
      "span": {
        "start": 16715,
        "end": 16721
      },
      "text": "སྣང་བ་ ༼པེ།༽ རྣར་བ་"
    },
    {
      "span": {
        "start": 16963,
        "end": 16965
      },
      "text": "ཀ་ ༼སྣར། པེ།༽ ཀཱ་"
    }
  ]
}