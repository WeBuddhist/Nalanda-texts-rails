{
  "durchens": [
    {
      "span": {
        "start": 97,
        "end": 105
      },
      "text": "གཞོན་ནུ་ ༼སྣར། པེ།༽ གཞོན་ནུར་"
    },
    {
      "span": {
        "start": 147,
        "end": 158
      },
      "text": "བསྟན་པ་ཡིས། ༼པེ།༽ བསྟན་པ་ཡི།"
    },
    {
      "span": {
        "start": 246,
        "end": 253
      },
      "text": "ནམ་མཁའ་ ༼སྣར།༽ ནམ་མཁའི་"
    },
    {
      "span": {
        "start": 496,
        "end": 515
      },
      "text": "ཞི་བའི་དེ་ཉིད་སྟོན། ༼སྣར།༽ ཞི་བ་སྟེན་པར་མཛད ༼པེ།༽ ཞི་བ་སྟོན་པར་མཛད།"
    },
    {
      "span": {
        "start": 534,
        "end": 543
      },
      "text": "སོགས་ཀྱི། ༼སྣར།༽ སོགས་ཀྱིས།"
    },
    {
      "span": {
        "start": 595,
        "end": 605
      },
      "text": "བཀབ་པ་ཡིས། ༼སྣར།༽ བཀབ་པ་ཡི།"
    },
    {
      "span": {
        "start": 660,
        "end": 669
      },
      "text": "མཐུ་གྱུར་ ༼སྣར། པེ།༽ མཐུར་འགྱུར་"
    },
    {
      "span": {
        "start": 890,
        "end": 894
      },
      "text": "འདི། ༼སྣར།༽ འདིས།"
    },
    {
      "span": {
        "start": 918,
        "end": 922
      },
      "text": "མཆི། ༼སྣར།༽ འཆི།"
    },
    {
      "span": {
        "start": 965,
        "end": 972
      },
      "text": "བགྲང་བ་ ༼སྣར།༽ བགྲད་པ་"
    },
    {
      "span": {
        "start": 1315,
        "end": 1321
      },
      "text": "ལྷུང་། ༼སྣར། པེ།༽ ལྟུང་།"
    },
    {
      "span": {
        "start": 1363,
        "end": 1371
      },
      "text": "ཁོངས་སུ་ ༼པེ།༽ ཁོང་དུ་"
    },
    {
      "span": {
        "start": 1459,
        "end": 1467
      },
      "text": "ལྟ་མཉེས་ ༼སྣར། པེ།༽ ལྟར་མཉེན་"
    },
    {
      "span": {
        "start": 1494,
        "end": 1498
      },
      "text": "དཀའ་ ༼སྣར།༽ དགའ་"
    },
    {
      "span": {
        "start": 1716,
        "end": 1727
      },
      "text": "ཐེ་ཚོམ་གྱི། ༼སྣར། པེ།༽ ཐེ་ཚོམ་གྱིས།"
    },
    {
      "span": {
        "start": 2261,
        "end": 2272
      },
      "text": "འཕེལ་བ་ཡིས། ༼སྣར།༽ འཕེལ་བ་ཡི ༼པེ།༽ འཕེལ་བའི།"
    }
  ]
}