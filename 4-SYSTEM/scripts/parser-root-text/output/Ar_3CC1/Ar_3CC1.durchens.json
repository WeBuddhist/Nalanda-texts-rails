{
  "durchens": [
    {
      "span": {
        "start": 202,
        "end": 210
      },
      "text": "ཡོང་ངེས་ ༼སྣར། པེ།༽ ཡོད་དེས་"
    },
    {
      "span": {
        "start": 446,
        "end": 454
      },
      "text": "སེམས་དེ། ༼སྣར། པེ།༽ སེམས་ཏེ།"
    },
    {
      "span": {
        "start": 588,
        "end": 594
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 791,
        "end": 796
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 873,
        "end": 880
      },
      "text": "སེམས་ན་ ༼སྣར། པེ།༽ སེམས་ནས་"
    },
    {
      "span": {
        "start": 1018,
        "end": 1036
      },
      "text": "རྣམ་དཔྱོད་ལྡན་ཞེས་ ༼སྣར། པེ།༽ བྱམས་ལྡན་མཁས་པ་"
    },
    {
      "span": {
        "start": 1373,
        "end": 1378
      },
      "text": "སྣང་། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 1568,
        "end": 1576
      },
      "text": "རིགས་པར་ ༼སྣར། པེ།༽ རིག་པར་"
    },
    {
      "span": {
        "start": 1622,
        "end": 1629
      },
      "text": "རྣམ་པར་ ༼སྣར། པེ།༽ རྣམ་པ་"
    },
    {
      "span": {
        "start": 1676,
        "end": 1683
      },
      "text": "རྒས་པས་ ༼སྣར། པེ།༽ རྒ་བས་"
    },
    {
      "span": {
        "start": 1884,
        "end": 1889
      },
      "text": "འཚོང་ ༼སྣར། པེ།༽ ཚོང་"
    },
    {
      "span": {
        "start": 2057,
        "end": 2064
      },
      "text": "གཟིར་བ་ ༼སྣར། པེ།༽ གཟིར་བར་"
    },
    {
      "span": {
        "start": 2123,
        "end": 2132
      },
      "text": "ཕྱི་འཆོས་ ༼སྣར། པེ།༽ ཕྱི་ཆོས་"
    },
    {
      "span": {
        "start": 2187,
        "end": 2194
      },
      "text": "ལྟ་བུར། ༼སྣར། པེ།༽ ལྟ་བུ།"
    },
    {
      "span": {
        "start": 2289,
        "end": 2295
      },
      "text": "གང་གི་ ༼སྣར།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 2490,
        "end": 2496
      },
      "text": "བྲལ་བ་ ༼སྣར། པེ།༽ འབྲལ་བ་"
    },
    {
      "span": {
        "start": 2800,
        "end": 2804
      },
      "text": "གཏང་ ༼སྣར།༽ གཏད་"
    },
    {
      "span": {
        "start": 3095,
        "end": 3098
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་ཡང་"
    },
    {
      "span": {
        "start": 3098,
        "end": 3107
      },
      "text": "བསྲུང་བྱ། ༼སྣར། པེ།༽ བསྲུང་།"
    },
    {
      "span": {
        "start": 3680,
        "end": 3691
      },
      "text": "འགྱུར་བ་དེ། ༼སྣར། པེ།༽ གྱུར་ཏེ་དེས།"
    },
    {
      "span": {
        "start": 3838,
        "end": 3843
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བར་"
    },
    {
      "span": {
        "start": 3891,
        "end": 3895
      },
      "text": "ཐ་མ་ ༼སྣར། པེ།༽ ཐ་མལ་"
    },
    {
      "span": {
        "start": 4272,
        "end": 4280
      },
      "text": "དེ་སྙེད་ ༼སྣར།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 4347,
        "end": 4350
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 4372,
        "end": 4379
      },
      "text": "གྱུར་པ། ༼སྣར། པེ།༽ འགྱུར་བ།"
    },
    {
      "span": {
        "start": 4408,
        "end": 4411
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 4461,
        "end": 4464
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 4474,
        "end": 4482
      },
      "text": "མཐོང་གི་ ༼སྣར། པེ།༽ མཐོང་བ་"
    },
    {
      "span": {
        "start": 4652,
        "end": 4655
      },
      "text": "ཏུ་ ༼སྣར། པེ།༽ ཏུ་འང་"
    },
    {
      "span": {
        "start": 4688,
        "end": 4697
      },
      "text": "སོགས་ཀྱི། ༼སྣར། པེ།༽ སོགས་ཀྱིས།"
    },
    {
      "span": {
        "start": 4717,
        "end": 4722
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 4763,
        "end": 4766
      },
      "text": "ཏུ་ ༼སྣར། པེ།༽ ཏུ་འང་"
    },
    {
      "span": {
        "start": 5026,
        "end": 5031
      },
      "text": "འགའང་ ༼སྣར། པེ།༽ འགའ་"
    },
    {
      "span": {
        "start": 5033,
        "end": 5039
      },
      "text": "སྟེངས་ ༼སྣར། པེ།༽ སྟེང་"
    },
    {
      "span": {
        "start": 5088,
        "end": 5091
      },
      "text": "ཏུ་ ༼སྣར། པེ།༽ ཏུ་འང་"
    },
    {
      "span": {
        "start": 5212,
        "end": 5219
      },
      "text": "གཞོན་པ་ ༼སྣར། པེ།༽ བཞོན་པ་"
    },
    {
      "span": {
        "start": 5340,
        "end": 5342
      },
      "text": "ལ། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 5359,
        "end": 5363
      },
      "text": "དགར་ ༼སྣར། པེ།༽ དགའ་"
    },
    {
      "span": {
        "start": 5391,
        "end": 5403
      },
      "text": "ཕྱིར་བཅོས་པ། ༼སྣར། པེ།༽ ཕྱིར་འཆོས་དེ།"
    },
    {
      "span": {
        "start": 5433,
        "end": 5442
      },
      "text": "བརྩམས་པས་ ༼སྣར། པེ།༽ རྩོམ་པས་"
    },
    {
      "span": {
        "start": 5480,
        "end": 5484
      },
      "text": "པའང་ ༼སྣར། པེ།༽ ལའང་"
    },
    {
      "span": {
        "start": 6080,
        "end": 6084
      },
      "text": "ཡུལ་ ༼སྣར། པེ།༽ ལུས་"
    },
    {
      "span": {
        "start": 6172,
        "end": 6178
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 6208,
        "end": 6217
      },
      "text": "འཕེལ་བའང་ ༼སྣར། པེ།༽ འཕེལ་བ་"
    },
    {
      "span": {
        "start": 6360,
        "end": 6368
      },
      "text": "འགྱུར་བ། ༼སྣར། པེ།༽ གྱུར་པ།"
    },
    {
      "span": {
        "start": 6449,
        "end": 6452
      },
      "text": "ཅི་ ༼སྣར། པེ།༽ ཅིས་"
    },
    {
      "span": {
        "start": 6458,
        "end": 6463
      },
      "text": "ཁྱེད་ ༼སྣར། པེ།༽ ཁྱོད་"
    },
    {
      "span": {
        "start": 6485,
        "end": 6492
      },
      "text": "གང་དེར་ ༼སྡེ།༽ གང་དེ་"
    },
    {
      "span": {
        "start": 6512,
        "end": 6520
      },
      "text": "དེ་རྙེད་ ༼སྣར།༽ དེ་སྙེད་"
    },
    {
      "span": {
        "start": 6612,
        "end": 6620
      },
      "text": "མཐོང་ནས། ༼སྣར། པེ།༽ མཐོང་ན།"
    },
    {
      "span": {
        "start": 6743,
        "end": 6746
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 6781,
        "end": 6786
      },
      "text": "ཞིག ། ༼སྣར། པེ།༽ ཡིན། །"
    },
    {
      "span": {
        "start": 6798,
        "end": 6802
      },
      "text": "ཤེས་ ༼སྣར། པེ།༽ བཤེས་"
    },
    {
      "span": {
        "start": 6804,
        "end": 6811
      },
      "text": "གྱུར་ན། ༼སྣར། པེ།༽ གྱུར་པ།"
    },
    {
      "span": {
        "start": 6827,
        "end": 6831
      },
      "text": "ཁྱོ་ ༼སྣར། པེ།༽ ཁྱོད་"
    },
    {
      "span": {
        "start": 6833,
        "end": 6839
      },
      "text": "སྡུག ། ༼སྣར། པེ།༽ འདུག །"
    },
    {
      "span": {
        "start": 6928,
        "end": 6936
      },
      "text": "རྒན་པོར་ ༼སྣར། པེ།༽ རྒན་པོ་"
    },
    {
      "span": {
        "start": 7163,
        "end": 7165
      },
      "text": "ང་ ༼སྣར། པེ།༽ ངའི་"
    },
    {
      "span": {
        "start": 7309,
        "end": 7314
      },
      "text": "ནི་མ་ ༼སྣར། པེ།༽ ནི་མི་"
    },
    {
      "span": {
        "start": 7341,
        "end": 7353
      },
      "text": "སྦྱོར་ན་ཡང་། ༼སྣར། པེ།༽ སྦྱོར་བ་ནའང་།"
    },
    {
      "span": {
        "start": 7458,
        "end": 7472
      },
      "text": "འདོད་ཆགས་ཀྱིས། ༼སྣར། པེ།༽ འདོད་ཆགས་ཀྱི།"
    },
    {
      "span": {
        "start": 7474,
        "end": 7480
      },
      "text": "མདོངས་ ༼སྣར། པེ།༽ ལྡོངས་"
    },
    {
      "span": {
        "start": 7611,
        "end": 7620
      },
      "text": "གང་འབྱུང་ ༼སྣར། པེ།༽ གང་བྱུང་"
    },
    {
      "span": {
        "start": 7651,
        "end": 7656
      },
      "text": "སེམས་ ༼སྣར། པེ།༽ ཆགས་"
    },
    {
      "span": {
        "start": 7659,
        "end": 7667
      },
      "text": "ཀུན་གྱི་ ༼སྣར། པེ།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 7957,
        "end": 7962
      },
      "text": "ལ་མི་ ༼སྣར། པེ།༽ ལས་མི་"
    },
    {
      "span": {
        "start": 8052,
        "end": 8059
      },
      "text": "གྱུར་པ། ༼སྣར། པེ།༽ འགྱུར་བ།"
    },
    {
      "span": {
        "start": 8099,
        "end": 8106
      },
      "text": "སུ་ཞིག་ ༼སྣར། པེ།༽ གང་ཞིག་"
    },
    {
      "span": {
        "start": 8157,
        "end": 8164
      },
      "text": "གནས་པར། ༼སྣར། པེ།༽ གནས་པ།"
    },
    {
      "span": {
        "start": 8251,
        "end": 8256
      },
      "text": "ཕུགས་ ༼སྣར། པེ།༽ ཕྱུགས་"
    },
    {
      "span": {
        "start": 8260,
        "end": 8263
      },
      "text": "བར་ ༼སྣར། པེ།༽ མར་"
    },
    {
      "span": {
        "start": 8479,
        "end": 8482
      },
      "text": "དག་ ༼སྣར། པེ།༽ དགར་"
    },
    {
      "span": {
        "start": 8506,
        "end": 8511
      },
      "text": "འཆོས་ ༼སྣར། པེ།༽ འཆོ་"
    },
    {
      "span": {
        "start": 8527,
        "end": 8529
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 8652,
        "end": 8656
      },
      "text": "ནའང་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 8775,
        "end": 8796
      },
      "text": "། །བྱང་ཆུབ་སེམས་དཔའི་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 8835,
        "end": 8854
      },
      "text": "འཛིན་པ་ཕྱིན་ཅི་ལོག་ ༼སྣར། པེ།༽ འཛིན་པ་"
    },
    {
      "span": {
        "start": 8910,
        "end": 8917
      },
      "text": "བདག་གི་ ༼ཅོ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 9033,
        "end": 9038
      },
      "text": "སྟབས་ ༼སྣར། པེ།༽ བསྟབས་"
    },
    {
      "span": {
        "start": 9110,
        "end": 9112
      },
      "text": "ལ་ ༼ཅོ།༽ ན་"
    },
    {
      "span": {
        "start": 9160,
        "end": 9169
      },
      "text": "གཏོང་པོར་ ༼སྣར། པེ།༽ གཏོང་བར་"
    },
    {
      "span": {
        "start": 9256,
        "end": 9259
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 9611,
        "end": 9617
      },
      "text": "བསྐུལ་ ༼སྣར། པེ།༽ སྐུལ་"
    },
    {
      "span": {
        "start": 9639,
        "end": 9647
      },
      "text": "ས་སྟེངས་ ༼སྣར། པེ།༽ ས་སྟེང་"
    },
    {
      "span": {
        "start": 9751,
        "end": 9753
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 9756,
        "end": 9759
      },
      "text": "གླ་ ༼སྣར། པེ།༽ གླུ་"
    },
    {
      "span": {
        "start": 9958,
        "end": 9966
      },
      "text": "སྐྱེད་པ་ ༼སྣར། པེ།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 9982,
        "end": 9989
      },
      "text": "དུ་མེད་ ༼སྣར། པེ།༽ དུ་ཡོད་"
    },
    {
      "span": {
        "start": 10020,
        "end": 10030
      },
      "text": "རྣམས་ཀྱིས། ༼སྣར། པེ།༽ རྣམས་ཀྱི།"
    },
    {
      "span": {
        "start": 10041,
        "end": 10049
      },
      "text": "མིན་པའང་ ༼སྣར། པེ།༽ མིན་པ་"
    },
    {
      "span": {
        "start": 10070,
        "end": 10075
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 10268,
        "end": 10275
      },
      "text": "སྲིད་པ་ ༼སྣར། པེ།༽ སྲེད་པ་"
    },
    {
      "span": {
        "start": 10372,
        "end": 10378
      },
      "text": "མེད་ལ་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 10522,
        "end": 10532
      },
      "text": "རྣམས་ཀྱིས། ༼སྣར། པེ།༽ རྣམས་ཀྱི།"
    },
    {
      "span": {
        "start": 10547,
        "end": 10551
      },
      "text": "ལྟར་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 10586,
        "end": 10596
      },
      "text": "རྣམས་ཀྱིས། ༼སྣར། པེ།༽ རྣམས་ཀྱི།"
    },
    {
      "span": {
        "start": 10634,
        "end": 10644
      },
      "text": "བསྣུན་པའི་ ༼སྣར། པེ།༽ སྣུན་པའི་"
    },
    {
      "span": {
        "start": 10808,
        "end": 10815
      },
      "text": "གཏོང་བ། ༼སྣར། པེ།༽ གཏོང་བས།"
    },
    {
      "span": {
        "start": 10881,
        "end": 10885
      },
      "text": "འགའ་ ༼སྣར། པེ།༽ དགའ་"
    },
    {
      "span": {
        "start": 10910,
        "end": 10917
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 10925,
        "end": 10928
      },
      "text": "ནི། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 11165,
        "end": 11173
      },
      "text": "བརྗོད་པ་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 11274,
        "end": 11282
      },
      "text": "རིགས་ལས་ ༼ཅོ།༽ རིག་ལས་ ༼སྣར། པེ།༽ རིགས་ལ་"
    },
    {
      "span": {
        "start": 11355,
        "end": 11358
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 11532,
        "end": 11540
      },
      "text": "རྒྱལ་པོ་ ༼སྣར། པེ།༽ རྒྱལ་པོའི་"
    },
    {
      "span": {
        "start": 11562,
        "end": 11569
      },
      "text": "འགེད་པ་ ༼ཅོ། སྡེ།༽ འགེང་བ་"
    },
    {
      "span": {
        "start": 11884,
        "end": 11888
      },
      "text": "འགའ་ ༼སྣར། པེ།༽ དགའ་"
    },
    {
      "span": {
        "start": 11987,
        "end": 11991
      },
      "text": "སྒྲ། ༼སྣར། པེ།༽ སྨྲ།"
    },
    {
      "span": {
        "start": 12008,
        "end": 12014
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ སྐྱེ་"
    },
    {
      "span": {
        "start": 12042,
        "end": 12046
      },
      "text": "སྒྲ་ ༼སྣར། པེ།༽ སྨྲ་"
    },
    {
      "span": {
        "start": 12085,
        "end": 12091
      },
      "text": "ཐུབ་ལ་ ༼སྣར། པེ།༽ ཐུབ་པ་"
    },
    {
      "span": {
        "start": 12179,
        "end": 12182
      },
      "text": "བྱ་ ༼པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 12205,
        "end": 12213
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོགས་པར་"
    },
    {
      "span": {
        "start": 12251,
        "end": 12253
      },
      "text": "པ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 12339,
        "end": 12343
      },
      "text": "དགེ་ ༼སྣར། པེ།༽ དགེ་བ་"
    },
    {
      "span": {
        "start": 12353,
        "end": 12360
      },
      "text": "མི་དགེ་ ༼སྣར། པེ།༽ མི་དགེའང་"
    },
    {
      "span": {
        "start": 12461,
        "end": 12469
      },
      "text": "ས་སྟེངས་ ༼སྣར། པེ།༽ ས་སྟེང་"
    },
    {
      "span": {
        "start": 12617,
        "end": 12634
      },
      "text": "སེམས་བསྐྱེད་བཅུག་ ༼སྣར། པེ།༽ སེམས་ཅན་གཅིག་"
    },
    {
      "span": {
        "start": 12711,
        "end": 12715
      },
      "text": "སྲི་ ༼ཅོ། པེ།༽ སྲིད་"
    },
    {
      "span": {
        "start": 12731,
        "end": 12735
      },
      "text": "ངེས་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 12914,
        "end": 12921
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 12931,
        "end": 12936
      },
      "text": "དཔྱད་ ༼སྣར། པེ།༽ སྤྱད་"
    },
    {
      "span": {
        "start": 13037,
        "end": 13045
      },
      "text": "འགྱུར་བ། ༼སྣར། པེ།༽ གྱུར་པ།"
    },
    {
      "span": {
        "start": 13119,
        "end": 13127
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 13161,
        "end": 13165
      },
      "text": "རིག་ ༼ཅོ། སྣར།༽ རིགས་"
    },
    {
      "span": {
        "start": 13251,
        "end": 13257
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 13289,
        "end": 13294
      },
      "text": "དཔའི་ ༼སྣར། པེ།༽ དཔའ་"
    },
    {
      "span": {
        "start": 13384,
        "end": 13393
      },
      "text": "བསྐུལ་བས། ༼སྣར། པེ།༽ བསྐུལ་བར།"
    },
    {
      "span": {
        "start": 13431,
        "end": 13439
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 13653,
        "end": 13660
      },
      "text": "བསམ་དག་ ༼ཅོ། སྡེ།༽ བསམ་ཐག་"
    },
    {
      "span": {
        "start": 13729,
        "end": 13736
      },
      "text": "དམན་པར་ ༼ཅོ།༽ དམན་པ་"
    },
    {
      "span": {
        "start": 14105,
        "end": 14114
      },
      "text": "ཚོང་སོགས་ ༼ཅོ།༽ སྤོབས་ ༼སྡེ།༽ ཚོང་སྤོགས་"
    },
    {
      "span": {
        "start": 14374,
        "end": 14377
      },
      "text": "ལས་ ༼ཅོ།༽ ལ་"
    },
    {
      "span": {
        "start": 14634,
        "end": 14637
      },
      "text": "ཞན་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 14990,
        "end": 15004
      },
      "text": "གསོས་འདེབས་སོ། ༼སྣར། པེ།༽ གསོས་འདེབས་པའོ།"
    },
    {
      "span": {
        "start": 15008,
        "end": 15014
      },
      "text": "ཕྲད་པ་ ༼སྣར། པེ།༽ འཕྲད་པ་"
    },
    {
      "span": {
        "start": 15014,
        "end": 15017
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 15112,
        "end": 15120
      },
      "text": "རྟོགས། ། ༼སྣར། པེ།༽ རྟོག །"
    },
    {
      "span": {
        "start": 15322,
        "end": 15327
      },
      "text": "དེའི་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 15393,
        "end": 15405
      },
      "text": "འབྱུང་འགྱུར་ ༼སྣར། པེ།༽ འབྱུང་གྱུར་"
    },
    {
      "span": {
        "start": 15708,
        "end": 15713
      },
      "text": "བརྟན་ ༼སྣར། པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 15757,
        "end": 15764
      },
      "text": "དེ་ལྟར་ ༼སྣར།༽ ད་ལྟར་"
    },
    {
      "span": {
        "start": 15795,
        "end": 15799
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 16008,
        "end": 16015
      },
      "text": "འབད་པས་ ༼སྣར། པེ།༽ འབད་པ་"
    },
    {
      "span": {
        "start": 16038,
        "end": 16043
      },
      "text": "ཁོ་ན་ ༼ཅོ།༽ ཁོ་ནར་"
    },
    {
      "span": {
        "start": 16236,
        "end": 16243
      },
      "text": "སྤངས་པ་ ༼སྣར། པེ།༽ ཡངས་པ་"
    },
    {
      "span": {
        "start": 16270,
        "end": 16277
      },
      "text": "ཐད་གནས་ ༼སྣར། པེ།༽ ཐད་ནས་"
    },
    {
      "span": {
        "start": 16364,
        "end": 16366
      },
      "text": "པ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 16522,
        "end": 16528
      },
      "text": "འོང་བ། ༼སྣར། པེ།༽ འོང་བའང་།"
    },
    {
      "span": {
        "start": 16674,
        "end": 16681
      },
      "text": "སྙན་པར་ ༼ཅོ།༽ སྙན་པ་"
    },
    {
      "span": {
        "start": 16700,
        "end": 16705
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བར་"
    },
    {
      "span": {
        "start": 16766,
        "end": 16772
      },
      "text": "ཤེས་ན་ ༼སྣར། པེ།༽ ཤེས་ནས་"
    },
    {
      "span": {
        "start": 16891,
        "end": 16896
      },
      "text": "བྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 17441,
        "end": 17445
      },
      "text": "ཉིད་ ༼སྡེ།༽ ནི་"
    },
    {
      "span": {
        "start": 17623,
        "end": 17642
      },
      "text": "ཉོན་མོངས་པ་སྤང་བའི་ ༼ཅོ།༽ ཉོན་མོངས་པ་སྤངས་པའི་ ༼སྣར། པེ།༽ ཉོན་མོངས་སྤང་བའི་"
    },
    {
      "span": {
        "start": 17719,
        "end": 17728
      },
      "text": "ཀུན་ཏུའང་ ༼སྣར། པེ།༽ ཀུན་ཏུ་"
    },
    {
      "span": {
        "start": 17895,
        "end": 17905
      },
      "text": "ཀྱི་འདྲེན་ ༼སྡེ།༽ ཀྱིས་འགྲམ་"
    },
    {
      "span": {
        "start": 17936,
        "end": 17949
      },
      "text": "རང་འདོད་ཀྱིས། ༼སྣར། པེ།༽ རང་འདོད་ཀྱི།"
    },
    {
      "span": {
        "start": 17958,
        "end": 17962
      },
      "text": "གཞར་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 18014,
        "end": 18021
      },
      "text": "ལྡན་པར་ ༼སྣར། པེ།༽ ལྡན་པ་"
    },
    {
      "span": {
        "start": 18102,
        "end": 18109
      },
      "text": "ཇི་ལྟར་ ༼སྣར། པེ།༽ ཇི་ལྟ་"
    },
    {
      "span": {
        "start": 18233,
        "end": 18241
      },
      "text": "མཐར་མེད་ ༼སྣར། པེ།༽ མཐའ་མེད་"
    },
    {
      "span": {
        "start": 18271,
        "end": 18273
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 18324,
        "end": 18334
      },
      "text": "སོའི་སྐྱེ་ ༼སྣར། པེ།༽ སོ་སྐྱེ་"
    },
    {
      "span": {
        "start": 18374,
        "end": 18382
      },
      "text": "ས་སྟེངས་ ༼སྣར། པེ།༽ ས་སྟེང་"
    },
    {
      "span": {
        "start": 18446,
        "end": 18455
      },
      "text": "གསོད་གནས་ ༼སྣར།༽ བསོད་གནས་ ༼པེ།༽ བསོད་ནམས་"
    },
    {
      "span": {
        "start": 18625,
        "end": 18629
      },
      "text": "དག ། ༼སྣར། པེ།༽ ལས། །"
    },
    {
      "span": {
        "start": 18648,
        "end": 18653
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 18689,
        "end": 18696
      },
      "text": "ལྡན་པས་ ༼སྣར། པེ།༽ ལྡན་པ་"
    },
    {
      "span": {
        "start": 18726,
        "end": 18734
      },
      "text": "གཅིག་གི་ ༼སྣར། པེ།༽ གཅིག་གིས་"
    },
    {
      "span": {
        "start": 19103,
        "end": 19105
      },
      "text": "ད་ ༼སྣར། པེ།༽ ད་ལྟར་"
    },
    {
      "span": {
        "start": 19137,
        "end": 19140
      },
      "text": "ངལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 19186,
        "end": 19193
      },
      "text": "དམྱལ་བ་ ༼སྣར། པེ།༽ དམྱལ་"
    },
    {
      "span": {
        "start": 19196,
        "end": 19214
      },
      "text": "མཚུངས་འཇིགས་སྐྱེད་ ༼སྣར། པེ།༽ མཚུངས་པར་འཇིགས་སྐྱེ་"
    },
    {
      "span": {
        "start": 19266,
        "end": 19272
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 19520,
        "end": 19524
      },
      "text": "ལོག་ ༼སྣར། པེ།༽ ལོགས་"
    },
    {
      "span": {
        "start": 19665,
        "end": 19668
      },
      "text": "ཡེ་ ༼སྣར། པེ།༽ ཡོངས་"
    },
    {
      "span": {
        "start": 19864,
        "end": 19871
      },
      "text": "དགེ་བས་ ༼སྣར། པེ།༽ དགེ་བ་"
    },
    {
      "span": {
        "start": 19918,
        "end": 19924
      },
      "text": "བཏང་བ་ ༼སྣར། པེ།༽ བཏང་བས་"
    },
    {
      "span": {
        "start": 19928,
        "end": 19935
      },
      "text": "གྱུར་པ། ༼སྣར། པེ།༽ འགྱུར་བ།"
    },
    {
      "span": {
        "start": 19940,
        "end": 19951
      },
      "text": "གྲུབ་པ་ཡིས་ ༼སྣར། པེ།༽ གྲུབ་པ་ཡི་"
    },
    {
      "span": {
        "start": 20152,
        "end": 20159
      },
      "text": "གྱུར་ན། ༼སྣར། པེ།༽ གྱུར་ནས།"
    },
    {
      "span": {
        "start": 20195,
        "end": 20203
      },
      "text": "ལྟ་བུའི་ ༼སྣར། པེ།༽ ལྟ་བུ་"
    },
    {
      "span": {
        "start": 20234,
        "end": 20246
      },
      "text": "མཚུངས་འགྱུར། ༼སྣར། པེ།༽ མཚུངས་པ།"
    },
    {
      "span": {
        "start": 20254,
        "end": 20265
      },
      "text": "དགེ་བའང་མི་ ༼སྣར།༽ དགེ་བ་གང་ ༼པེ།༽ དགེ་བའང་"
    },
    {
      "span": {
        "start": 20315,
        "end": 20330
      },
      "text": "འཁྲུལ་འཁོར་གྱི། ༼ཅོ།༽ འཁྲུལ་འཁོར་གྱིས།"
    },
    {
      "span": {
        "start": 20479,
        "end": 20484
      },
      "text": "འདིར་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 20565,
        "end": 20574
      },
      "text": "འདོད་པའི་ ༼སྣར། པེ།༽ འདོད་པ་"
    },
    {
      "span": {
        "start": 20913,
        "end": 20916
      },
      "text": "དང་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 21185,
        "end": 21195
      },
      "text": "ཐུབ་པ་ཡིས། ༼ཅོ།༽ ཐུབ་པ་ཡི།"
    },
    {
      "span": {
        "start": 21311,
        "end": 21315
      },
      "text": "ཉིད་ ༼ཅོ། སྡེ།༽ མིན་"
    },
    {
      "span": {
        "start": 21396,
        "end": 21402
      },
      "text": "གང་ལས་ ༼ཅོ།༽ གང་ལ་"
    },
    {
      "span": {
        "start": 21417,
        "end": 21422
      },
      "text": "བྱུང་ ༼ཅོ། སྡེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 21721,
        "end": 21726
      },
      "text": "ཡོངས་ ༼ཅོ། སྡེ།༽ ཡོད་"
    },
    {
      "span": {
        "start": 21804,
        "end": 21808
      },
      "text": "བྲལ་ ༼ཅོ། སྡེ།༽ ཁྲལ་"
    },
    {
      "span": {
        "start": 21858,
        "end": 21863
      },
      "text": "འདིར་ ༼ཅོ། སྡེ།༽ འདི་"
    },
    {
      "span": {
        "start": 22207,
        "end": 22213
      },
      "text": "ཟློག ། ༼ཅོ། སྡེ།༽ བཟློག །"
    },
    {
      "span": {
        "start": 22226,
        "end": 22234
      },
      "text": "བཟློག་པ་ ༼སྣར། པེ།༽ ཟློག་པ་"
    },
    {
      "span": {
        "start": 22250,
        "end": 22252
      },
      "text": "བ་ ༼སྣར། པེ།༽ ཞི་"
    },
    {
      "span": {
        "start": 22375,
        "end": 22381
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 22424,
        "end": 22434
      },
      "text": "རྣམས་ཀྱིས། ༼སྣར། པེ།༽ རྣམས་ཀྱི།"
    },
    {
      "span": {
        "start": 22492,
        "end": 22502
      },
      "text": "སྨད་འགྱུར་ ༼སྣར། པེ།༽ སླད་གྱུར་"
    },
    {
      "span": {
        "start": 22582,
        "end": 22596
      },
      "text": "གནས་མིན་གནས་ལ་ ༼སྣར། པེ།༽ གནས་མ་ཡིན་པར་"
    },
    {
      "span": {
        "start": 22709,
        "end": 22719
      },
      "text": "མ་གཏོགས་པ། ༼སྣར། པེ།༽ མ་གཏོགས་པར།"
    },
    {
      "span": {
        "start": 22945,
        "end": 22952
      },
      "text": "མཁས་པས་ ༼སྣར། པེ།༽ མཁས་པ་"
    },
    {
      "span": {
        "start": 23086,
        "end": 23096
      },
      "text": "བསམས་བཞིན་ ༼སྣར། པེ།༽ བསམ་བཞིན་"
    },
    {
      "span": {
        "start": 23106,
        "end": 23109
      },
      "text": "ནི། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 23147,
        "end": 23151
      },
      "text": "མྱང་ ༼སྣར། པེ།༽ མྱ་ངན་"
    },
    {
      "span": {
        "start": 23159,
        "end": 23167
      },
      "text": "མིན་གྱི། ༼སྣར། པེ།༽ མིན།"
    },
    {
      "span": {
        "start": 23219,
        "end": 23223
      },
      "text": "ཐོས་ ༼སྣར། པེ།༽ ཐོབ་"
    },
    {
      "span": {
        "start": 23457,
        "end": 23477
      },
      "text": "སློབ་མ་ཡོངས་སུ་སྦྱང་ ༼སྣར། པེ།༽ སློབ་མ་སྦྱོང་"
    },
    {
      "span": {
        "start": 23691,
        "end": 23704
      },
      "text": "གང་ཞིག་ཏུའང་། ༼སྣར། པེ།༽ གང་ཞིག་དུ།"
    },
    {
      "span": {
        "start": 23900,
        "end": 23906
      },
      "text": "བྱས་ལ་ ༼སྣར། པེ།༽ བྱས་པ་"
    },
    {
      "span": {
        "start": 24007,
        "end": 24013
      },
      "text": "རྟོག ། ༼སྣར། པེ།༽ རྟོགས། །"
    },
    {
      "span": {
        "start": 24060,
        "end": 24068
      },
      "text": "མ་མཐོང་། ༼སྣར།༽ མི་ཐོང་ ༼པེ།༽ མི་མཐོང་།"
    },
    {
      "span": {
        "start": 24122,
        "end": 24125
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 24256,
        "end": 24262
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 24545,
        "end": 24553
      },
      "text": "དངོས་དེ་ ༼པེ།༽ དངོས་མེད་"
    },
    {
      "span": {
        "start": 24608,
        "end": 24615
      },
      "text": "ལོག་པར་ ༼སྣར། པེ།༽ ལྡོག་པར་"
    },
    {
      "span": {
        "start": 24844,
        "end": 24855
      },
      "text": "མི་རིགས་སོ། ༼སྣར། པེ།༽ ག་ལ་རིགས།"
    },
    {
      "span": {
        "start": 24862,
        "end": 24865
      },
      "text": "ཡི་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 24983,
        "end": 24990
      },
      "text": "གནས་གང་ ༼སྣར། པེ།༽ གནས་ཁང་"
    },
    {
      "span": {
        "start": 25002,
        "end": 25010
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིར་"
    },
    {
      "span": {
        "start": 25150,
        "end": 25156
      },
      "text": "ཡོད་ན། ༼སྣར། པེ།༽ ཡོད་པ།"
    },
    {
      "span": {
        "start": 25405,
        "end": 25417
      },
      "text": "འབྲས་བུ་ཡིས་ ༼སྣར། པེ།༽ འབྲས་བུ་ཡི་"
    },
    {
      "span": {
        "start": 25496,
        "end": 25506
      },
      "text": "ཡོད་མ་ཡིན། ༼སྣར། པེ།༽ རྒྱུ་ཡོད་པ།"
    },
    {
      "span": {
        "start": 25612,
        "end": 25618
      },
      "text": "གསུང་། ༼ཅོ། པེ།༽ གསུངས།"
    },
    {
      "span": {
        "start": 25926,
        "end": 25929
      },
      "text": "དང་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 25937,
        "end": 25943
      },
      "text": "ཐར་པར་ ༼སྣར། པེ།༽ ཐར་པ་"
    },
    {
      "span": {
        "start": 25947,
        "end": 25952
      },
      "text": "གཅིག་ ༼སྣར། པེ།༽ ཅིག་"
    },
    {
      "span": {
        "start": 26029,
        "end": 26036
      },
      "text": "ཡིན་ནོ། ༼པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 26070,
        "end": 26072
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 26356,
        "end": 26359
      },
      "text": "ནད་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 26531,
        "end": 26537
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 26592,
        "end": 26599
      },
      "text": "དེ་བདག་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 26812,
        "end": 26815
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 26963,
        "end": 26969
      },
      "text": "ཏུ་འང་ ༼སྣར། པེ།༽ ཏུ་ཏུ་"
    },
    {
      "span": {
        "start": 27106,
        "end": 27110
      },
      "text": "ལུས་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 27178,
        "end": 27185
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 27204,
        "end": 27212
      },
      "text": "མིན་ཞིང་ ༼སྣར། པེ།༽ མིན་ཞེས་"
    },
    {
      "span": {
        "start": 27305,
        "end": 27311
      },
      "text": "བདེ་བ་ ༼སྣར། པེ།༽ བདེ་"
    },
    {
      "span": {
        "start": 27318,
        "end": 27323
      },
      "text": "བཞིན། ༼སྣར། པེ།༽ བཞིན་ཏེ།"
    },
    {
      "span": {
        "start": 27421,
        "end": 27427
      },
      "text": "འབྱུང་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 27866,
        "end": 27869
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 28275,
        "end": 28280
      },
      "text": "ལ་ལར་ ༼སྣར། པེ།༽ ལ་ལར་སྐྱེ་བུ་"
    },
    {
      "span": {
        "start": 28285,
        "end": 28303
      },
      "text": "ཙམ་ཞིག་མཐོང་སྟེ། ། ༼སྣར། པེ།༽ ཙམ་ཞིག །"
    },
    {
      "span": {
        "start": 28365,
        "end": 28370
      },
      "text": "ཐར་པ་ ༼ཅོ།༽ ཐར་པར་"
    },
    {
      "span": {
        "start": 28407,
        "end": 28409
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 28412,
        "end": 28414
      },
      "text": "པ་ ༼ཅོ།༽ པར་"
    },
    {
      "span": {
        "start": 28515,
        "end": 28521
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 28551,
        "end": 28555
      },
      "text": "ཡོད་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 28582,
        "end": 28586
      },
      "text": "མེད། ༼སྣར། པེ།༽ ཉིད།"
    },
    {
      "span": {
        "start": 28629,
        "end": 28633
      },
      "text": "བྱར་ ༼སྣར།༽ བྱད་"
    },
    {
      "span": {
        "start": 28846,
        "end": 28861
      },
      "text": "རྣམ་པར་འཇིག་པར་ ༼སྣར། པེ།༽ འཇིགས་པ་སྣང་གྱུར་"
    },
    {
      "span": {
        "start": 29368,
        "end": 29375
      },
      "text": "ཅི་ལྟར་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 29592,
        "end": 29595
      },
      "text": "གང་ ༼སྣར། པེ།༽ ག་"
    },
    {
      "span": {
        "start": 29769,
        "end": 29774
      },
      "text": "སྐྱེ་ ༼སྣར། པེ།༽ སྐྱེས་"
    },
    {
      "span": {
        "start": 29861,
        "end": 29867
      },
      "text": "འདས་ལ་ ༼སྣར། པེ།༽ འདས་པ་"
    },
    {
      "span": {
        "start": 29931,
        "end": 29933
      },
      "text": "བ། ༼ཅོ།༽ བར།"
    },
    {
      "span": {
        "start": 30079,
        "end": 30082
      },
      "text": "ཕྱ་ ༼ཅོ། སྡེ།༽ ཕྱྭ་"
    },
    {
      "span": {
        "start": 30090,
        "end": 30100
      },
      "text": "རྣམས་ཀྱིས་ ༼ཅོ། སྡེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 30312,
        "end": 30319
      },
      "text": "གྱུར་པ། ༼ཅོ། སྡེ།༽ འགྱུར་བ།"
    },
    {
      "span": {
        "start": 30468,
        "end": 30471
      },
      "text": "ཇི་ ༼སྣར། པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 30580,
        "end": 30583
      },
      "text": "ཐལ་ ༼སྣར། པེ།༽ ཐར་"
    },
    {
      "span": {
        "start": 30620,
        "end": 30626
      },
      "text": "དེ་ལྟ་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 30963,
        "end": 30970
      },
      "text": "དང་པོར་ ༼སྣར། པེ།༽ དང་པོ་"
    },
    {
      "span": {
        "start": 30988,
        "end": 30997
      },
      "text": "རྙིངས་པར་ ༼སྣར། པེ།༽ སྙིང་པོར་"
    },
    {
      "span": {
        "start": 31359,
        "end": 31363
      },
      "text": "དེར། ༼སྣར། པེ།༽ དེས།"
    },
    {
      "span": {
        "start": 31517,
        "end": 31521
      },
      "text": "པའམ། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 31627,
        "end": 31634
      },
      "text": "ཕྱི་ནས་ ༼ཅོ།༽ ཕྱིས་ན་"
    },
    {
      "span": {
        "start": 31798,
        "end": 31808
      },
      "text": "སེམས་སྐྱེ་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 31839,
        "end": 31842
      },
      "text": "ཡི། ༼སྣར། པེ།༽ ཡིས།"
    },
    {
      "span": {
        "start": 32020,
        "end": 32027
      },
      "text": "སྨྲ་པོ་ ༼སྣར། པེ།༽ སྨྲ་པོར་"
    },
    {
      "span": {
        "start": 32034,
        "end": 32038
      },
      "text": "རྣམ་ ༼པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 32470,
        "end": 32477
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 32552,
        "end": 32556
      },
      "text": "དཀའ། ༼སྣར།༽ དགའ།"
    },
    {
      "span": {
        "start": 32564,
        "end": 32570
      },
      "text": "གཞན་ལ་ ༼སྣར། པེ།༽ གཞན་མ་"
    },
    {
      "span": {
        "start": 32616,
        "end": 32625
      },
      "text": "ཡུན་རིངས་ ༼ཅོ།༽ ཡུན་རིང་"
    },
    {
      "span": {
        "start": 32685,
        "end": 32689
      },
      "text": "དཀའ་ ༼སྣར།༽ འགའ་"
    },
    {
      "span": {
        "start": 32850,
        "end": 32859
      },
      "text": "བརྗོད་པར་ ༼སྣར། པེ།༽ བསྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 32864,
        "end": 32869
      },
      "text": "བྱིས་ ༼སྣར།༽ ཕྱིས་"
    },
    {
      "span": {
        "start": 32874,
        "end": 32880
      },
      "text": "ངེས་པ་ ༼ཅོ།༽ ངེས་པར་"
    },
    {
      "span": {
        "start": 32933,
        "end": 32943
      },
      "text": "མེད་པ་ཡིས། ༼ཅོ།༽ མེད་པ་ཡི།"
    },
    {
      "span": {
        "start": 32961,
        "end": 32970
      },
      "text": "འཇིགས་པར་ ༼ཅོ།༽ འཇིག་པར་"
    },
    {
      "span": {
        "start": 32993,
        "end": 33001
      },
      "text": "འབའ་ཞིག་ ༼སྣར། པེ།༽ འགའ་ཞིག་"
    },
    {
      "span": {
        "start": 33076,
        "end": 33082
      },
      "text": "པ་ག་ལ་ ༼སྣར། པེ།༽ སྨོས་ཅི་དགོས་"
    },
    {
      "span": {
        "start": 33237,
        "end": 33244
      },
      "text": "སྟོན་པ་ ༼པེ།༽ སྟོང་པ་"
    },
    {
      "span": {
        "start": 33275,
        "end": 33282
      },
      "text": "འགྲོ་ལ། ༼སྣར། པེ།༽ འགྲོ་བ།"
    },
    {
      "span": {
        "start": 33464,
        "end": 33472
      },
      "text": "འཇིགས་པ་ ༼སྣར། པེ།༽ འཇིག་པ་"
    },
    {
      "span": {
        "start": 33495,
        "end": 33501
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 33561,
        "end": 33571
      },
      "text": "རྣམས་ཀྱིས། ༼སྣར། པེ།༽ རྣམས་ཀྱི།"
    },
    {
      "span": {
        "start": 33610,
        "end": 33615
      },
      "text": "འདིས་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 33633,
        "end": 33642
      },
      "text": "སྲེག་སྟེ་ ༼སྣར། པེ།༽ བསྲེགས་ཏེ་"
    },
    {
      "span": {
        "start": 33645,
        "end": 33649
      },
      "text": "ཡིས་ ༼སྣར། པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 33742,
        "end": 33752
      },
      "text": "འཇིགས་པའི་ ༼སྣར། པེ།༽ འཇིག་པའི་"
    },
    {
      "span": {
        "start": 33839,
        "end": 33843
      },
      "text": "ག་ལ་ ༼སྣར། པེ།༽ གང་ལ་"
    },
    {
      "span": {
        "start": 34021,
        "end": 34034
      },
      "text": "པོ་རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་ཡང་"
    },
    {
      "span": {
        "start": 34226,
        "end": 34233
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 34245,
        "end": 34253
      },
      "text": "བྲམ་ཟེར་ ༼སྣར། པེ།༽ བྲམ་ཟེ་"
    },
    {
      "span": {
        "start": 34521,
        "end": 34527
      },
      "text": "འདས་པ་ ༼སྣར། པེ།༽ འདས་པར་"
    },
    {
      "span": {
        "start": 34667,
        "end": 34675
      },
      "text": "སྡུག་པར་ ༼སྣར། པེ།༽ སྡུག་བསྔལ་"
    },
    {
      "span": {
        "start": 34748,
        "end": 34756
      },
      "text": "ས་སྟེངས་ ༼སྣར། པེ།༽ ས་སྟེང་"
    },
    {
      "span": {
        "start": 35164,
        "end": 35174
      },
      "text": "མཐོང་བ་ཡི་ ༼སྡེ།༽ མཐོང་བ་ཡིས་"
    },
    {
      "span": {
        "start": 35196,
        "end": 35203
      },
      "text": "མིན་པར་ ༼ཅོ།༽ མིན་པ་"
    },
    {
      "span": {
        "start": 35420,
        "end": 35429
      },
      "text": "འགྲུབ་པར་ ༼སྣར།༽ འགྲུབ་པ་"
    },
    {
      "span": {
        "start": 35527,
        "end": 35529
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 35676,
        "end": 35680
      },
      "text": "བལྟ་ ༼ཅོ། སྡེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 35816,
        "end": 35821
      },
      "text": "བསྟན་ ༼ཅོ། སྡེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 35924,
        "end": 35927
      },
      "text": "བྱ་ ༼ཅོ། སྡེ།༽ བྱར་"
    },
    {
      "span": {
        "start": 35960,
        "end": 35964
      },
      "text": "འགར་ ༼ཅོ།༽ འགའ་"
    },
    {
      "span": {
        "start": 36038,
        "end": 36049
      },
      "text": "འབྱུང་གྱུར་ ༼སྣར། པེ།༽ འབྱུང་འགྱུར་"
    },
    {
      "span": {
        "start": 36070,
        "end": 36078
      },
      "text": "མཐོང་གི་ ༼སྣར། པེ།༽ མཐོང་གིས་"
    },
    {
      "span": {
        "start": 36176,
        "end": 36183
      },
      "text": "ལྟ་བའི་ ༼སྣར། པེ།༽ བལྟ་བའི་"
    },
    {
      "span": {
        "start": 36280,
        "end": 36285
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 36380,
        "end": 36391
      },
      "text": "གཟུགས་མཐོང་ ༼སྣར། པེ།༽ གཟུགས་མང་"
    },
    {
      "span": {
        "start": 36469,
        "end": 36478
      },
      "text": "བརྫུན་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 36579,
        "end": 36591
      },
      "text": "བསྒྲིབས་པའང་ ༼སྣར། པེ།༽ བསྒྲིབ་པའང་"
    },
    {
      "span": {
        "start": 36626,
        "end": 36633
      },
      "text": "དང་པོར་ ༼ཅོ།༽ དང་པོ་"
    },
    {
      "span": {
        "start": 36752,
        "end": 36755
      },
      "text": "ལྟ་ ༼སྣར། པེ།༽ བལྟ་"
    },
    {
      "span": {
        "start": 36805,
        "end": 36808
      },
      "text": "ཇི་ ༼སྣར། པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 36922,
        "end": 36928
      },
      "text": "སྐྱེད། ༼སྣར། པེ།༽ བསྐྱེད།"
    },
    {
      "span": {
        "start": 37155,
        "end": 37163
      },
      "text": "རྣམས་དང་ ༼སྣར། པེ།༽ རྣམས་ཀྱང་"
    },
    {
      "span": {
        "start": 37167,
        "end": 37177
      },
      "text": "སེམས་ཀྱིས། ༼སྣར། པེ།༽ སེམས་ཀྱི།"
    },
    {
      "span": {
        "start": 37500,
        "end": 37502
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 37504,
        "end": 37510
      },
      "text": "སྟེངས་ ༼སྣར། པེ།༽ སྟེང་"
    },
    {
      "span": {
        "start": 37521,
        "end": 37531
      },
      "text": "མིན་པ་འགའ་ ༼སྣར། པེ།༽ ཅན་མིན་ཅང་"
    },
    {
      "span": {
        "start": 38181,
        "end": 38189
      },
      "text": "གཅིག་པུ་ ༼སྣར། པེ།༽ གཅིག་ཏུ་"
    },
    {
      "span": {
        "start": 38431,
        "end": 38435
      },
      "text": "དེར་ ༼ཅོ།༽ དེ་"
    },
    {
      "span": {
        "start": 38656,
        "end": 38672
      },
      "text": "གཟུགས་སོགས་རྣམས་ ༼ཅོ།༽ གཟུགས་སོགས་རྣམ་ ༼སྣར། པེ།༽ གཟུགས་རྣམས་"
    },
    {
      "span": {
        "start": 38678,
        "end": 38680
      },
      "text": "བ། ༼སྣར། པེ།༽ བ་ནི།"
    },
    {
      "span": {
        "start": 38996,
        "end": 39003
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མ་གཏོགས་"
    },
    {
      "span": {
        "start": 39171,
        "end": 39176
      },
      "text": "གྲུབ་ ༼སྣར། པེ།༽ འགྲུབ་"
    },
    {
      "span": {
        "start": 39209,
        "end": 39215
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 39264,
        "end": 39270
      },
      "text": "སྐྱེད། ༼སྣར། པེ།༽ བསྐྱེད།"
    },
    {
      "span": {
        "start": 39674,
        "end": 39677
      },
      "text": "དེ་ ༼སྣར། པེ།༽ མེ་"
    },
    {
      "span": {
        "start": 39761,
        "end": 39763
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལའང་"
    },
    {
      "span": {
        "start": 39824,
        "end": 39829
      },
      "text": "བཏགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 39920,
        "end": 39922
      },
      "text": "ལ་ ༼ཅོ། སྡེ།༽ ན་"
    },
    {
      "span": {
        "start": 39941,
        "end": 39945
      },
      "text": "དེར་ ༼ཅོ།༽ དེ་"
    },
    {
      "span": {
        "start": 39950,
        "end": 39955
      },
      "text": "འདོད་ ༼ཅོ། སྡེ།༽ ཡོད་"
    },
    {
      "span": {
        "start": 40150,
        "end": 40154
      },
      "text": "བལྟ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 40186,
        "end": 40188
      },
      "text": "བ། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 40205,
        "end": 40209
      },
      "text": "བལྟ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 40213,
        "end": 40215
      },
      "text": "པ། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 40532,
        "end": 40539
      },
      "text": "མཐོང་ན་ ༼སྡེ།༽ མཐོང་ནས་"
    },
    {
      "span": {
        "start": 40727,
        "end": 40732
      },
      "text": "གདོད་ ༼སྣར། པེ།༽ འདོད་"
    },
    {
      "span": {
        "start": 40735,
        "end": 40740
      },
      "text": "སྐྱེ་ ༼སྣར། པེ།༽ སྐྱེས་"
    },
    {
      "span": {
        "start": 40840,
        "end": 40846
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ གྲུབ་"
    },
    {
      "span": {
        "start": 40866,
        "end": 40872
      },
      "text": "ཡོད་པ་ ༼སྣར། པེ།༽ ཡོད་པའང་"
    },
    {
      "span": {
        "start": 41290,
        "end": 41295
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ གཉིས་ཀ་"
    },
    {
      "span": {
        "start": 41298,
        "end": 41306
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 41463,
        "end": 41469
      },
      "text": "རྙིངས་ ༼སྣར། པེ།༽ ཪྙིང་"
    },
    {
      "span": {
        "start": 41685,
        "end": 41689
      },
      "text": "འགག་ ༼སྡེ།༽ འགགས་"
    },
    {
      "span": {
        "start": 41716,
        "end": 41719
      },
      "text": "ཇི་ ༼སྣར། པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 41813,
        "end": 41823
      },
      "text": "རིམས་ཀྱིས་ ༼སྣར། པེ།༽ རིམ་གྱིས་"
    },
    {
      "span": {
        "start": 41880,
        "end": 41882
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་བ་"
    },
    {
      "span": {
        "start": 41882,
        "end": 41889
      },
      "text": "སོགས་པ་ ༼སྣར། པེ།༽ སོགས་"
    },
    {
      "span": {
        "start": 41991,
        "end": 41994
      },
      "text": "ལས་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 41998,
        "end": 42002
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 42032,
        "end": 42035
      },
      "text": "གང་ ༼སྣར། པེ།༽ ག་"
    },
    {
      "span": {
        "start": 42352,
        "end": 42357
      },
      "text": "བྱེད་ ༼སྣར། པེ།༽ ཕྱེད་"
    },
    {
      "span": {
        "start": 42631,
        "end": 42639
      },
      "text": "བཞིན་པོ་ ༼སྣར། པེ།༽ བཞིན་པ་"
    },
    {
      "span": {
        "start": 42704,
        "end": 42712
      },
      "text": "འགགས་པས་ ༼སྣར། པེ།༽ འགགས་པ་"
    },
    {
      "span": {
        "start": 42933,
        "end": 42938
      },
      "text": "སྐྱེ་ ༼སྣར། པེ།༽ སྐྱེའོ་"
    },
    {
      "span": {
        "start": 42938,
        "end": 42953
      },
      "text": "ཞེས་བྱ་བར་གྲག ། ༼སྣར། པེ།༽ ཞེས་པར་གྲགས། །"
    },
    {
      "span": {
        "start": 43057,
        "end": 43062
      },
      "text": "གྱུར། ༼ཅོ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 43113,
        "end": 43122
      },
      "text": "སྐྱེས་ཏེ། ༼སྣར། པེ།༽ སྐྱེས་སྐྱེ།"
    },
    {
      "span": {
        "start": 43166,
        "end": 43173
      },
      "text": "ཡིན་པར་ ༼སྣར། པེ།༽ མིན་པར་"
    },
    {
      "span": {
        "start": 43478,
        "end": 43491
      },
      "text": "འདུས་བྱས་ཀྱི་ ༼སྣར། པེ།༽ འདུས་བྱས་"
    },
    {
      "span": {
        "start": 43491,
        "end": 43495
      },
      "text": "དོན་ ༼སྣར། པེ།༽ དོན་དམ་དུ་"
    },
    {
      "span": {
        "start": 43618,
        "end": 43630
      },
      "text": "ཐམས་ཅད་ཀྱིས། ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི།"
    },
    {
      "span": {
        "start": 43632,
        "end": 43636
      },
      "text": "འདི་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 43725,
        "end": 43730
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 43976,
        "end": 43982
      },
      "text": "གཅིག ། ༼སྣར། པེ།༽ ཅིག །"
    },
    {
      "span": {
        "start": 43982,
        "end": 43986
      },
      "text": "དགའ་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 44196,
        "end": 44206
      },
      "text": "གཞུང་ལུགས་ ༼སྣར། པེ།༽ གཞན་ལུགས་"
    },
    {
      "span": {
        "start": 44283,
        "end": 44291
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ བྱུང་བ་"
    },
    {
      "span": {
        "start": 44525,
        "end": 44532
      },
      "text": "ཅི་ལྟར་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 45203,
        "end": 45206
      },
      "text": "སླ་ ༼སྣར། པེ།༽ བླ་"
    },
    {
      "span": {
        "start": 45471,
        "end": 45479
      },
      "text": "ཅེས་མིང་ ༼སྣར། པེ།༽ ཅེས་མི་"
    },
    {
      "span": {
        "start": 45673,
        "end": 45679
      },
      "text": "འགྱུར་ ༼སྣར།༽ གྱུར་"
    },
    {
      "span": {
        "start": 46145,
        "end": 46153
      },
      "text": "རྟོག་པས་ ༼སྣར། པེ།༽ རྟོགས་པས་"
    },
    {
      "span": {
        "start": 46227,
        "end": 46230
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 46390,
        "end": 46396
      },
      "text": "གླན་ཀ་ ༼སྣར། པེ།༽ ཀླན་ཀ་"
    },
    {
      "span": {
        "start": 46405,
        "end": 46411
      },
      "text": "ནུས་མ་ ༼སྣར། པེ།༽ ནུས་པ་"
    },
    {
      "span": {
        "start": 46524,
        "end": 46566
      },
      "text": "།། །།སློབ་དཔོན་འཕགས་པ་ལྷའི་ཞལ་སྔ་ནས་མཛད་པ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 46595,
        "end": 46603
      },
      "text": "སྤྱོད་པ་ ༼སྣར། པེ།༽ སྤྱོད་པ་བསྟན་བཅོས་"
    },
    {
      "span": {
        "start": 46626,
        "end": 46632
      },
      "text": "བྱས་པ་ ༼སྣར། པེ།༽ བྱས་པ་ཞེས་བྱ་བ། སིངྒ་ལའི་གླིང་དུ་པདྨའི་སྦུབས་ལས་བརྫུས་ཏེ་འཁྲུངས་ཤིང་། རང་དང་གཞན་གྱི་གྲུབ་པའི་མཐའ་རྒྱ་མཚོའི་ཕ་རོལ་ཏུ་སོན་པ་ཡང་དག་པ་དང་། ཡང་དག་པ་མ་ཡིན་པའི་ལྟ་བ་རྣམ་པར་འབྱེད་པས་དབུ་མའི་ལམ་རབ་དུ་གསལ་བར་མཛད་པ། འཕགས་པ་ཀླུའི་ཞབས་ཀྱི་སྲས་སུ་གྱུར་པའི་སློབ་དཔོན་འཕགས་པ་ལྷའི་ཞལ་སྔ་ནས་ཀྱིས་མཛད་པ་"
    },
    {
      "span": {
        "start": 46803,
        "end": 46807
      },
      "text": "ཕབ། ༼སྣར། པེ།༽ ཕབ་པའོ།"
    }
  ]
}