          }
        },
        {
          "title": {
            "bo": "བཅུ་གཉིས་པ་ལྟ་བ་དགག་པ་བསྒོམ་པ་བསྟན་པ།"
          },
          "span": {
            "start": 31961,
            "end": 34888
          }
        },
        {
          "title": {
            "bo": "བཅུ་གསུམ་པ་དབང་པོ་དང་དོན་དགག་པ་བསྒོམ་པ་བསྟན་པ།"
          },
          "span": {
            "start": 34888,
