{
  "sections": [
    {
      "title": {
        "bo": "༄༅། །བསྟན་བཅོས་བཞི་བརྒྱ་པ་ཞེས་བྱ་བའི་ཚིག་ལེའུར་བྱས་པ་བཞུགས་སོ། །"
      },
      "span": {
        "start": 0,
        "end": 46810
      },
      "subsections": [
        {
          "title": {
            "bo": "ཀླད་ཀྱི་དོན།"
          },
          "span": {
            "start": 0,
            "end": 144
          }
        },
        {
          "title": {
            "bo": "དང་པོ་རྟག་པར་འཛིན་པ་སྤང་བའི་ཐབས་བསྟན་པ།"
          },
          "span": {
            "start": 144,
            "end": 3054
          }
        },
        {
          "title": {
            "bo": "གཉིས་པ་བདེ་བར་འཛིན་པ་སྤང་བའི་ཐབས་བསྟན་པ།"
          },
          "span": {
            "start": 3054,
            "end": 6006
          }
        },
        {
          "title": {
            "bo": "གསུམ་པ་གཙང་བར་འཛིན་པ་ཕྱིན་ཅི་ལོག་སྤང་བའི་ཐབས་བསྟན་པ།"
          },
          "span": {
            "start": 6006,
            "end": 8903
          }
        },
        {
          "title": {
            "bo": "བཞི་པ་བདག་ཏུ་འཛིན་པ་སྤང་བའི་ཐབས་བསྟན་པ།"
          },
          "span": {
            "start": 8903,
            "end": 11846
          }
        },
        {
          "title": {
            "bo": "ལྔ་པ་བྱང་ཆུབ་སེམས་དཔའི་སྤྱོད་པ་བསྟན་པ།"
          },
          "span": {
            "start": 11846,
            "end": 14773
          }
        },
        {
          "title": {
            "bo": "དྲུག་པ་ཉོན་མོངས་པ་སྤང་བའི་ཐབས་བསྟན་པ།"
          },
          "span": {
            "start": 14773,
            "end": 17683
          }
        },
        {
          "title": {
            "bo": "བདུན་པ་མི་ཉིད་ཀྱིས་འདོད་པའི་ལོངས་སྤྱོད་ལ་ཞེན་པ་སྤང་བའི་ཐབས་བསྟན་པ།"
          },
          "span": {
            "start": 17683,
            "end": 20642
          }
        },
        {
          "title": {
            "bo": "བརྒྱད་པ་སློབ་མ་ཡོངས་སུ་སྦྱང་བ།"
          },
          "span": {
            "start": 20642,
            "end": 23510
          }
        },
        {
          "title": {
            "bo": "དགུ་པ་དངོས་པོ་རྟག་པ་དགག་པ་བསྒོམ་པ་བསྟན་པ།"
          },
          "span": {
            "start": 23510,
            "end": 26350
          }
        },
        {
          "title": {
            "bo": "བཅུ་པ་བདག་དགག་པ་བསྒོམ་པ་བསྟན་པ།"
          },
          "span": {
            "start": 26350,
            "end": 29180
          }
        },
        {
          "title": {
            "bo": "བཅུ་གཅིག་པ་དུས་དགག་པ་བསྒོམ་པ་བསྟན་པ།"
          },
          "span": {
