{
  "durchens": [
    {
      "span": {
        "start": 416,
        "end": 430
      },
      "text": "ལྷག་པར་མོས་པར་ ༼སྣར། པེ།༽ ལྷག་པར་"
    },
    {
      "span": {
        "start": 498,
        "end": 507
      },
      "text": "བརྗོད་དོ། ༼སྣར། པེ།༽ བརྗོད་དེ།"
    },
    {
      "span": {
        "start": 583,
        "end": 591
      },
      "text": "གཉིས་སུ་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 698,
        "end": 706
      },
      "text": "ཕྱག་རྒྱ་ ༼སྣར། པེ།༽ ཕྱག་"
    },
    {
      "span": {
        "start": 740,
        "end": 745
      },
      "text": "དེའི་ ༼སྣར། པེ།༽ དེའི་འོག་ཏུ་དེའི་"
    },
    {
      "span": {
        "start": 948,
        "end": 963
      },
      "text": "སྔོན་དུ་འགྲོ་བ་ ༼སྣར། པེ།༽ སྔོན་དུ་"
    },
    {
      "span": {
        "start": 1177,
        "end": 1182
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 1588,
        "end": 1592
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱིས་"
    },
    {
      "span": {
        "start": 1919,
        "end": 1926
      },
      "text": "རང་གིས་ ༼སྣར། པེ།༽ རང་གི་"
    },
    {
      "span": {
        "start": 2560,
        "end": 2567
      },
      "text": "རང་གིས་ ༼སྣར། པེ།༽ རང་གི་"
    },
    {
      "span": {
        "start": 2726,
        "end": 2735
      },
      "text": "བཟངས་རིས་ ༼སྣར། པེ།༽ ཟངས་རིས་"
    },
    {
      "span": {
        "start": 2945,
        "end": 2954
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབས་པ་"
    },
    {
      "span": {
        "start": 3060,
        "end": 3070
      },
      "text": "འཇིག་རྟེན་ ༼སྣར། པེ།༽ འཇིག་རྟེན་སྐྱོང་བ་"
    },
    {
      "span": {
        "start": 3106,
        "end": 3115
      },
      "text": "བཟངས་རིས་ ༼སྣར། པེ།༽ ཟངས་རིས་"
    },
    {
      "span": {
        "start": 3383,
        "end": 3393
      },
      "text": "དེ་དག་གིས་ ༼སྣར། པེ།༽ དེ་དག་གི་"
    },
    {
      "span": {
        "start": 3868,
        "end": 3876
      },
      "text": "བརླབ་པར་ ༼སྣར། པེ།༽ བརླབས་པ་"
    },
    {
      "span": {
        "start": 4626,
        "end": 4640
      },
      "text": "ཀུན་བརྟགས་ཀྱི། ༼སྣར། པེ།༽ ཀུན་བརྟགས་ཀྱིས།"
    },
    {
      "span": {
        "start": 4934,
        "end": 4943
      },
      "text": "བརླབ་པའི་ ༼སྣར། པེ།༽ བརླབས་པའི་"
    },
    {
      "span": {
        "start": 5146,
        "end": 5152
      },
      "text": "བརླབས། ༼སྣར། པེ།༽ བརླབ།"
    }
  ]
}