{
  "durchens": [
    {
      "span": {
        "start": 292,
        "end": 294
      },
      "text": "ས་ ༼པེ།༽ ས་མོ་"
    },
    {
      "span": {
        "start": 347,
        "end": 350
      },
      "text": "ཐལ་ ༼པེ།༽ བཙའ་"
    },
    {
      "span": {
        "start": 480,
        "end": 486
      },
      "text": "སྟེངས་ ༼པེ།༽ སྟེང་"
    },
    {
      "span": {
        "start": 822,
        "end": 828
      },
      "text": "རླབ་པ་ ༼པེ།༽ རླབས་པ་"
    },
    {
      "span": {
        "start": 1373,
        "end": 1381
      },
      "text": "སྦྱངས་པ་ ༼པེ།༽ ཡམས་པ་"
    },
    {
      "span": {
        "start": 1557,
        "end": 1561
      },
      "text": "བསང་ ༼པེ།༽ བསད་"
    },
    {
      "span": {
        "start": 1876,
        "end": 1881
      },
      "text": "ལུགས་ ༼པེ།༽ ལུག་"
    },
    {
      "span": {
        "start": 1979,
        "end": 1985
      },
      "text": "ལགས་པ་ ༼པེ།༽ ལག་པ་"
    },
    {
      "span": {
        "start": 2102,
        "end": 2107
      },
      "text": "དྲངས་ ༼པེ།༽ དྲངས་པ་"
    },
    {
      "span": {
        "start": 2563,
        "end": 2569
      },
      "text": "བར་དུ་ ༼པེ།༽ བར་དུའོ། །"
    },
    {
      "span": {
        "start": 2933,
        "end": 2943
      },
      "text": "དང་བྱས་ནས་ ༼པེ།༽ དང་"
    },
    {
      "span": {
        "start": 3062,
        "end": 3146
      },
      "text": "ཕྲིན་ལས་ཀུན་ལ་སྙོམས་མཛད་པ། །ཐམས་ཅད་ཀུན་གྱི་བདག་པོ་སྟེ། །མཉམ་སྙོམས་ཁྱོད་ལ་ཕྱག་འཚལ་ལོ། ༼སྣར།༽ གང་གིས་རྟེན་མེད་ཀྱང་ཡན་དེ་རོ་ནི་མེད་པ་ལ། །ཟླས་ཤིང་བསྒོམ་པའི་ཚུལ་བསམ་གཏན་པས་གྱིས་ནི ༼པེ།༽ གང་གི་རྟེན་མེད་ཀྱང་ཡན་དེ་རོ་ནི་མེད་པ་ལ། །ཟླས་ཤིང་བསྒོམ་པའི་ཚུལ་བསམ་གཏན་པས་གྱིས་ནི།"
    },
    {
      "span": {
        "start": 3148,
        "end": 3449
      },
      "text": "བསྟོད་ནས་མེ་ལྷར་གསོལ་བ་གདབ། །མེ་ལྷ་རྡོ་རྗེ་ལས་ཀྱི་གཙོ། །ཚེ་འདས་སེམས་ཅན་སྦྱང་བ་དང་། །ལྷ་རྣམས་ཚིམ་པར་བྱ་བའི་ཕྱིར། །དེ་ཉིད་དུ་ནི་ཕྲིན་ལས་མཛོད། །ཕྲིན་ལས་རྣམ་པ་གཉིས་ཞེས་བྱ། །མེ་ལྷའི་རྒྱལ་པོའི་ཐུགས་ཀ་ནས། །ཡེ་ཤེས་འབར་བའི་མེ་ཕྱུང་སྟེ། །ཚེ་འདས་སེམས་ཅན་མི་མཐུན་ཕྱོགས། །རྣམ་རྟོག་བག་ཆགས་བསྲེག་པ་དང་། །ལྷ་རྣམས་ཚིམ་ ༼སྣར།༽ ཅུང་ཟད་ངེས་པ་ཡིད་ཚིག་པར་བྱས་ནས་རྙེད་པ་དང་། །དཀྱིལ་འཁོར་དཀྱིལ་འཁོར་ཞུགས་པ་དང་མཚན་མ་བྲིས་ནས་ནི། །ཚ་ཚྭ་མང་པོ་མཆོད་རྟེན་ཕྲེང་བ་བྱ་བ་འམ། །ཡང་ན་སྐུ་གཟུགས་བྱས་ཀྱང་ལུགས་མ་ལགས་པ་རུང་། །སྦྱིན་བསྲེག་མངོན་པར་དབང་བསྐུར་བས། །གདོན་མི་ཟ་བར་གྲོལ་བར་ནི་ནུས་གསུང་སུས་གསུངས་ན་རྣམ་པར་རྒྱལ་བ་ལགས་པ་ནས། །དེ་བཞིན་གཤེགས་པས་ངེས་ ༼པེ།༽ ཅུང་ཟད་ངེས་པ་ཡིད་ཚིག་པར་བྱས་ནས་རྙེད་པ་དང་། །དཀྱིལ་འཁོར་དཀྱིལ་འཁོར་ཞུགས་པ་དང་མཚན་མ་བྲིས་ནས་ནི། །ཚ་ཚྭ་མང་པོ་མཆོད་རྟེན་ཕྲེང་བ་བྱ་བ་འམ། །ཡང་ན་སྐུ་གཟུགས་བྱས་ཀྱང་ལུགས་མ་ལགས་པ་རུང་། །སྦྱིན་བསྲེག་མངོན་པར་དབང་སྐུར་བས། །གདོན་མི་ཟ་བར་གྲོལ་བར་ནི་ནུས་གསུང་སུས་གསུངས་ན་རྣམ་པར་རྒྱལ་བ་ལགས་པ་ནས། །དེ་བཞིན་གཤེགས་པས་ངེས་"
    }
  ]
}