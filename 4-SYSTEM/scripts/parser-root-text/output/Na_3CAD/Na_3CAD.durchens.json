{
  "durchens": [
    {
      "span": {
        "start": 253,
        "end": 263
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 467,
        "end": 476
      },
      "text": "གྱུར་གྱི་ ༼པེ།༽ གྱུར་པའི་"
    },
    {
      "span": {
        "start": 677,
        "end": 684
      },
      "text": "གཟུང་བ་ ༼པེ།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 846,
        "end": 852
      },
      "text": "ཏི་བི་ ༼སྣར།༽ ཏི་ ༼པེ།༽ ཏི་ཨ་"
    },
    {
      "span": {
        "start": 897,
        "end": 905
      },
      "text": "མཛུབ་མོ་ ༼སྣར།༽ མཛུབ་"
    },
    {
      "span": {
        "start": 1301,
        "end": 1308
      },
      "text": "ས་བྱིན་ ༼སྣར།༽ བྱིན་"
    },
    {
      "span": {
        "start": 1341,
        "end": 1349
      },
      "text": "དེ་ནས་ས་ ༼སྣར།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 1382,
        "end": 1387
      },
      "text": "སྲེག་ ༼པེ།༽ བསྲེག་"
    },
    {
      "span": {
        "start": 1423,
        "end": 1429
      },
      "text": "ཙམ་མམ་ ༼སྣར།༽ ཙམ་"
    },
    {
      "span": {
        "start": 1571,
        "end": 1577
      },
      "text": "གའོ། ། ༼པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 1626,
        "end": 1632
      },
      "text": "བླ་རེ་ ༼སྣར།༽ བླ་བྲེ་"
    },
    {
      "span": {
        "start": 1658,
        "end": 1663
      },
      "text": "བཀྲམ་ ༼སྣར།༽ བཀྲས་"
    },
    {
      "span": {
        "start": 1734,
        "end": 1743
      },
      "text": "གཏུགས་ཏེ། ༼པེ།༽ གཏུགས།"
    },
    {
      "span": {
        "start": 1832,
        "end": 1840
      },
      "text": "བརླབས་པ་ ༼སྣར། པེ།༽ བརླབ་པ་"
    },
    {
      "span": {
        "start": 1845,
        "end": 1852
      },
      "text": "གཟུང་བ་ ༼པེ།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 2031,
        "end": 2040
      },
      "text": "སྨྱུང་བར་ ༼པེ།༽ བསྙུང་བར་"
    },
    {
      "span": {
        "start": 2134,
        "end": 2141
      },
      "text": "བསགས་པ་ ༼སྣར།༽ བསག་པ་"
    },
    {
      "span": {
        "start": 2146,
        "end": 2155
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 2303,
        "end": 2312
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 2557,
        "end": 2567
      },
      "text": "བརླབས་པའི་ ༼སྣར། པེ།༽ བརླབ་པའི་"
    },
    {
      "span": {
        "start": 2735,
        "end": 2743
      },
      "text": "སྔོན་ཅན་ ༼སྣར། པེ།༽ སྔོན་"
    },
    {
      "span": {
        "start": 2855,
        "end": 2863
      },
      "text": "བཟུང་བས། ༼སྣར།༽ གཟུངས་པས།"
    },
    {
      "span": {
        "start": 3098,
        "end": 3102
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱིས་"
    },
    {
      "span": {
        "start": 3104,
        "end": 3109
      },
      "text": "བཟུང་ ༼སྣར།༽ གཟུང་"
    },
    {
      "span": {
        "start": 3226,
        "end": 3231
      },
      "text": "བཟུང་ ༼སྣར།༽ གཟུང་"
    },
    {
      "span": {
        "start": 3344,
        "end": 3349
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 3465,
        "end": 3470
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 3544,
        "end": 3546
      },
      "text": "བ། ༼པེ།༽ བའི་"
    },
    {
      "span": {
        "start": 3551,
        "end": 3556
      },
      "text": "མཐིལ་ ༼པེ།༽ འཐིལ་"
    },
    {
      "span": {
        "start": 3614,
        "end": 3618
      },
      "text": "བྱས་ ༼པེ།༽ བྱས་ཏེ་"
    },
    {
      "span": {
        "start": 3908,
        "end": 3917
      },
      "text": "དཀྱིལ་ནས། ༼པེ།༽ དཀྱིལ་ན།"
    },
    {
      "span": {
        "start": 3919,
        "end": 3926
      },
      "text": "དཔའ་བོ་ ༼སྣར།༽ དཔའ་བོའི་"
    },
    {
      "span": {
        "start": 4010,
        "end": 4018
      },
      "text": "སྲེག་པར་ ༼སྣར། པེ།༽ བསྲེག་པར་"
    },
    {
      "span": {
        "start": 4385,
        "end": 4389
      },
      "text": "དེང་ ༼སྣར། པེ།༽ དིང་"
    },
    {
      "span": {
        "start": 4547,
        "end": 4556
      },
      "text": "ཕྱིར་དང་། ༼པེ།༽ ཕྱིར།"
    },
    {
      "span": {
        "start": 4621,
        "end": 4624
      },
      "text": "སུ་ ༼སྣར། པེ།༽ སུ་ཡང་"
    },
    {
      "span": {
        "start": 5039,
        "end": 5041
      },
      "text": "ཏ་ ༼སྣར།༽ འགྱུར་ཏེ་"
    },
    {
      "span": {
        "start": 5172,
        "end": 5179
      },
      "text": "ཕྱུང་ལ་ ༼པེ།༽ ཕྱུང་བ་"
    },
    {
      "span": {
        "start": 5192,
        "end": 5201
      },
      "text": "བསྐྲད་པར་ ༼སྣར།༽ བསྐྲོད་ ༼པེ།༽ བསྐྱོད་པར་"
    },
    {
      "span": {
        "start": 5231,
        "end": 5240
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 5410,
        "end": 5413
      },
      "text": "དང་ ༼སྣར།༽ སུ་"
    },
    {
      "span": {
        "start": 5460,
        "end": 5462
      },
      "text": "ན་ ༼སྣར། པེ།༽ དུཥྚན་"
    },
    {
      "span": {
        "start": 5549,
        "end": 5551
      },
      "text": "ར་ ༼པེ།༽ རོ་"
    },
    {
      "span": {
        "start": 5682,
        "end": 5687
      },
      "text": "སྲུང་ ༼པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 5716,
        "end": 5724
      },
      "text": "བདུགས་པ་ ༼སྣར། པེ།༽ བདུག་པ་"
    },
    {
      "span": {
        "start": 5781,
        "end": 5786
      },
      "text": "གོ་ཆ་ ༼སྣར།༽ གོ་ཆས་ ༼པེ།༽ ཆོ་ག་"
    },
    {
      "span": {
        "start": 5823,
        "end": 5827
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམ་པ་"
    },
    {
      "span": {
        "start": 5948,
        "end": 5960
      },
      "text": "བཏེག་པའི་ལྷ་ ༼སྣར།༽ བཏེག་པ་ལ་ ༼པེ།༽ སྡོག་པའི་ལྷ་"
    },
    {
      "span": {
        "start": 5974,
        "end": 5977
      },
      "text": "ལོ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 6169,
        "end": 6173
      },
      "text": "རིག་ ༼སྣར།༽ རིགས་"
    },
    {
      "span": {
        "start": 6383,
        "end": 6390
      },
      "text": "བྱའོ། ། ༼པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 6427,
        "end": 6434
      },
      "text": "གཙང་མས་ ༼སྣར།༽ གཙང་མ་"
    },
    {
      "span": {
        "start": 6439,
        "end": 6441
      },
      "text": "པ་ ༼སྣར།༽ པར་"
    },
    {
      "span": {
        "start": 6647,
        "end": 6650
      },
      "text": "ལས་ ༼སྣར།༽ ཧྲི་ལས་ ༼པེ།༽ ཧྲཱི་ལས་"
    },
    {
      "span": {
        "start": 6955,
        "end": 6961
      },
      "text": "པའོ། ། ༼པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 7832,
        "end": 7840
      },
      "text": "བཟད་པའི། ༼པེ།༽ བཟད་པས།"
    },
    {
      "span": {
        "start": 7935,
        "end": 7941
      },
      "text": "དེས་ན་ ༼པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 8068,
        "end": 8073
      },
      "text": "སྲུང་ ༼སྣར།༽ སྤུང་ ༼པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 8112,
        "end": 8126
      },
      "text": "བཤད་པར་བྱ་སྟེ། ༼སྣར།༽ བཤད་པ་བྱ་སྟེ་ ༼པེ།༽ བཤད་པ་བྱ་"
    },
    {
      "span": {
        "start": 8153,
        "end": 8158
      },
      "text": "རྣམས། ༼སྣར།༽ རྣམ།"
    },
    {
      "span": {
        "start": 8187,
        "end": 8195
      },
      "text": "བརྒྱ་ལམ་ ༼སྣར། པེ།༽ རྒྱ་ལམ་"
    },
    {
      "span": {
        "start": 8357,
        "end": 8364
      },
      "text": "བསྐལ་པ་ ༼སྣར།༽ སྐལ་བ་"
    },
    {
      "span": {
        "start": 8513,
        "end": 8520
      },
      "text": "དོང་པས་ ༼པེ།༽ འདོད་པས་"
    },
    {
      "span": {
        "start": 8683,
        "end": 8688
      },
      "text": "ཤར་བ་ ༼སྣར།༽ ཤར་"
    },
    {
      "span": {
        "start": 8698,
        "end": 8705
      },
      "text": "བཤམས་ལ། ༼པེ།༽ བཤམས་པ་དང་།"
    },
    {
      "span": {
        "start": 8736,
        "end": 8740
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 8744,
        "end": 8750
      },
      "text": "རྣམ་པ་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 8872,
        "end": 8878
      },
      "text": "བརླབས་ ༼སྣར།༽ བརླབ་"
    },
    {
      "span": {
        "start": 8902,
        "end": 8906
      },
      "text": "གདན་ ༼སྣར།༽ གནས་"
    },
    {
      "span": {
        "start": 9057,
        "end": 9064
      },
      "text": "པོ་དང་། ༼པེ།༽ པོ་"
    },
    {
      "span": {
        "start": 9072,
        "end": 9077
      },
      "text": "ཆེའི་ ༼སྣར། པེ།༽ ཆེ་"
    },
    {
      "span": {
        "start": 9164,
        "end": 9171
      },
      "text": "བཅས་པར་ ༼སྣར།༽ བཅས་པ་"
    },
    {
      "span": {
        "start": 9228,
        "end": 9242
      },
      "text": "མཆོད་རྫས་རྣམས་ ༼སྣར།༽ མཆོད་རྫས་"
    },
    {
      "span": {
        "start": 9308,
        "end": 9313
      },
      "text": "བཏེག་ ༼སྣར།༽ བཏགས་"
    },
    {
      "span": {
        "start": 9693,
        "end": 9700
      },
      "text": "ནས་ཆུར་ ༼སྣར།༽ ཚུར་ ༼པེ།༽ ནས་ཆུ་"
    },
    {
      "span": {
        "start": 10068,
        "end": 10078
      },
      "text": "སློབ་མ་ཡི། ༼སྣར། པེ།༽ སློབ་མ་ཡིས།"
    },
    {
      "span": {
        "start": 10097,
        "end": 10105
      },
      "text": "གསུངས་པ་ ༼སྣར། པེ།༽ བསྲུངས་པ་"
    },
    {
      "span": {
        "start": 10105,
        "end": 10108
      },
      "text": "ཡི། ༼སྣར། པེ།༽ ཡིས།"
    },
    {
      "span": {
        "start": 10191,
        "end": 10196
      },
      "text": "སྣོད། ༼སྣར།༽ སློབ།"
    },
    {
      "span": {
        "start": 10278,
        "end": 10285
      },
      "text": "གཟུང་བ་ ༼པེ།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 10778,
        "end": 10788
      },
      "text": "བསྒྲགས་ཏེ། ༼སྣར། པེ།༽ བསྒྲག་སྟེ།"
    },
    {
      "span": {
        "start": 10819,
        "end": 10828
      },
      "text": "བསྒོ་བའི་ ༼སྣར།༽ བསྒོས་པའི་"
    },
    {
      "span": {
        "start": 10944,
        "end": 10951
      },
      "text": "བསྲེག ། ༼སྣར། པེ།༽ སྲེག །"
    },
    {
      "span": {
        "start": 10972,
        "end": 10977
      },
      "text": "པ་ནི། ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 11076,
        "end": 11081
      },
      "text": "གཞུག་ ༼པེ།༽ བཞུག་"
    },
    {
      "span": {
        "start": 11136,
        "end": 11141
      },
      "text": "རྟགས་ ༼སྣར།༽ རྟག་"
    },
    {
      "span": {
        "start": 11247,
        "end": 11252
      },
      "text": "ལྟ་བ་ ༼སྣར།༽ བལྟ་བ་"
    },
    {
      "span": {
        "start": 11327,
        "end": 11335
      },
      "text": "དྲི་མེད་ ༼སྣར།༽ དྲི་མ་"
    },
    {
      "span": {
        "start": 11419,
        "end": 11424
      },
      "text": "ལྷ། ། ༼སྣར།༽ ལྷག །"
    },
    {
      "span": {
        "start": 11638,
        "end": 11645
      },
      "text": "གདབ་བྱ། ༼པེ།༽ གདབ་པར་བྱ་སྟེ།"
    },
    {
      "span": {
        "start": 11668,
        "end": 11674
      },
      "text": "ནས་བྱ། ༼སྣར། པེ།༽ ནས་ཀྱང་།"
    },
    {
      "span": {
        "start": 12108,
        "end": 12115
      },
      "text": "བསམས་པ་ ༼པེ།༽ བསམ་པ་"
    },
    {
      "span": {
        "start": 12122,
        "end": 12132
      },
      "text": "འབྱུང་བའི་ ༼པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 12539,
        "end": 12543
      },
      "text": "གོས་ ༼སྣར། པེ།༽ གོས་སྔོན་"
    },
    {
      "span": {
        "start": 12547,
        "end": 12554
      },
      "text": "ཐོབ་པར་ ༼སྣར། པེ།༽ ཐོབ་"
    },
    {
      "span": {
        "start": 12719,
        "end": 12726
      },
      "text": "ཐོབ་པས། ༼སྣར། པེ།༽ ཐོབ་པ།"
    },
    {
      "span": {
        "start": 13094,
        "end": 13103
      },
      "text": "བསྐུར་ཏེ། ༼སྣར།༽ བསྐུར་བ།"
    },
    {
      "span": {
        "start": 13342,
        "end": 13350
      },
      "text": "དང་པོའི་ ༼སྣར། པེ།༽ སྙིང་པོ་"
    },
    {
      "span": {
        "start": 13459,
        "end": 13468
      },
      "text": "སྦྱིན་ཏེ། ༼སྣར།༽ སྦྱིན་"
    },
    {
      "span": {
        "start": 13552,
        "end": 13560
      },
      "text": "ཟུངས་ཏེ། ༼སྣར།༽ བཟུང་སྟེ ༼པེ།༽ ཟུང་སྟེ།"
    },
    {
      "span": {
        "start": 13917,
        "end": 13927
      },
      "text": "སྦྱིན་པའོ། ༼པེ།༽ སྦྱིན།"
    },
    {
      "span": {
        "start": 14152,
        "end": 14157
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 14189,
        "end": 14194
      },
      "text": "བརྟན། ༼པེ།༽ བསྟན།"
    },
    {
      "span": {
        "start": 14245,
        "end": 14250
      },
      "text": "ཡ་མི་ ༼སྣར།༽ ཡ་ནི་"
    },
    {
      "span": {
        "start": 14267,
        "end": 14270
      },
      "text": "ཧི་ ༼སྣར། པེ།༽ ཧི་ཧ་"
    },
    {
      "span": {
        "start": 14391,
        "end": 14396
      },
      "text": "བཟུང་ ༼སྣར།༽ གཟུང་"
    },
    {
      "span": {
        "start": 14404,
        "end": 14411
      },
      "text": "གཡས་པས་ ༼སྣར། པེ།༽ གཡས་པ་"
    },
    {
      "span": {
        "start": 14425,
        "end": 14429
      },
      "text": "བྱས། ༼སྣར། པེ།༽ བྱ།"
    },
    {
      "span": {
        "start": 14646,
        "end": 14659
      },
      "text": "ལུང་བསྟན་པའོ། ༼པེ།༽ ལུང་བསྟན་ཏེ།"
    },
    {
      "span": {
        "start": 14730,
        "end": 14741
      },
      "text": "དད་པར་གྱིས་ ༼པེ།༽ དད་པར་"
    },
    {
      "span": {
        "start": 14784,
        "end": 14795
      },
      "text": "སྦྱར་བ་ཡིས། ༼སྣར། པེ།༽ སྦྱར་བ་ཡི།"
    },
    {
      "span": {
        "start": 14957,
        "end": 14961
      },
      "text": "པོས་ ༼སྣར། པེ།༽ བཟང་སྙིང་པོའི་"
    },
    {
      "span": {
        "start": 14973,
        "end": 14982
      },
      "text": "བསྡེབས་པ་ ༼པེ།༽ སྡེབས་པ་"
    }
  ]
}