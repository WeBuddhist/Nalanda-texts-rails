{
  "durchens": [
    {
      "span": {
        "start": 25,
        "end": 29
      },
      "text": "ཏཱ་ར་ ༼པེ། སྣར།༽ ཏཱ་རཱ།"
    },
    {
      "span": {
        "start": 231,
        "end": 236
      },
      "text": "དེ་ལ་ ༼པེ། སྣར།༽ དེ་ལ།"
    },
    {
      "span": {
        "start": 274,
        "end": 278
      },
      "text": "ན་མ་ ༼པེ། སྣར།༽ ན་མཿ།"
    },
    {
      "span": {
        "start": 295,
        "end": 301
      },
      "text": "ཤྭ་རཱ་ ༼པེ། སྣར།༽ ཤྭ་ར།"
    },
    {
      "span": {
        "start": 310,
        "end": 315
      },
      "text": "སཏྭཱ་ ༼པེ། སྣར།༽ སཏྭ།"
    },
    {
      "span": {
        "start": 322,
        "end": 327
      },
      "text": "སཏྭཱ་ ༼པེ། སྣར།༽ སཏྭ།"
    },
    {
      "span": {
        "start": 330,
        "end": 338
      },
      "text": "མ་ཧཱ་ཀཱ་ ༼པེ། སྣར།༽ མ་ཧཱ་ཀ"
    },
    {
      "span": {
        "start": 341,
        "end": 347
      },
      "text": "ཎི་ཀཱ་ ༼པེ། སྣར།༽ ཎི་ཀ"
    },
    {
      "span": {
        "start": 397,
        "end": 404
      },
      "text": "དུཥྚཱཾ་ ༼པེ། སྣར།༽ དུཥྚཾ་པྲ་དུཥྚཾ།"
    },
    {
      "span": {
        "start": 438,
        "end": 443
      },
      "text": "བནྡྷ་ ༼པེ། སྣར།༽ བྷནྡྷ།"
    },
    {
      "span": {
        "start": 474,
        "end": 481
      },
      "text": "དུཥྚཱཾ་ ༼པེ། སྣར།༽ དུཥྚཾ།"
    },
    {
      "span": {
        "start": 510,
        "end": 516
      },
      "text": "དང་པོ་ ༼པེ། སྣར།༽ དང་པོར།"
    },
    {
      "span": {
        "start": 874,
        "end": 877
      },
      "text": "ཀོ྅་ ༼པེ། སྣར།༽ ྅།"
    },
    {
      "span": {
        "start": 969,
        "end": 972
      },
      "text": "ཏཱཾ་ ༼པེ། སྣར།༽ ཏཾ།"
    },
    {
      "span": {
        "start": 1273,
        "end": 1278
      },
      "text": "སྐོར་ ༼པེ། སྣར།༽ བསྐོར།"
    },
    {
      "span": {
        "start": 1363,
        "end": 1368
      },
      "text": "རྒྱན་ ༼སྣར།༽ བརྒྱན།"
    },
    {
      "span": {
        "start": 1368,
        "end": 1376
      },
      "text": "འོད་དམར་ ༼སྣར།༽ པོད་དཔག"
    },
    {
      "span": {
        "start": 1506,
        "end": 1517
      },
      "text": "སྡིགས་མཛུབ་ ༼པེ།༽ སྡིགས་མཛུབས།"
    },
    {
      "span": {
        "start": 1732,
        "end": 1739
      },
      "text": "གཉིས་མ་ ༼པེ། སྣར།༽ གཉིས་པ།"
    },
    {
      "span": {
        "start": 1764,
        "end": 1776
      },
      "text": "རྣམ་པར་བརྒྱན་ ༼པེ། སྣར།༽ རྒྱན་དང་ལྡན།"
    },
    {
      "span": {
        "start": 1967,
        "end": 1975
      },
      "text": "རྣ་རྒྱན་ ༼སྣར།༽ བརྒྱན།"
    },
    {
      "span": {
        "start": 2019,
        "end": 2026
      },
      "text": "བྱང་དུ་ ༼པེ། སྣར།༽ བྱང་ན།"
    },
    {
      "span": {
        "start": 2225,
        "end": 2232
      },
      "text": "བཞུགས་མ། ༼པེ། སྣར།༽ བཞུགས་པ།"
    },
    {
      "span": {
        "start": 2549,
        "end": 2560
      },
      "text": "ལྕགས་ཀྱུའི་ ༼པེ། སྣར།༽ ལྕགས་ཀྱུས།"
    },
    {
      "span": {
        "start": 2793,
        "end": 2798
      },
      "text": "རྒྱན་ ༼སྣར།༽ བརྒྱན།"
    },
    {
      "span": {
        "start": 2874,
        "end": 2880
      },
      "text": "ཕྱག་ན་ ༼པེ། སྣར།༽ ཕྱག་རྒྱ།"
    },
    {
      "span": {
        "start": 3189,
        "end": 3195
      },
      "text": "ནག་མོ་ ༼སྣར།༽ ནག་པོ།"
    },
    {
      "span": {
        "start": 3195,
        "end": 3206
      },
      "text": "བསྒོམ་པར་བྱ། ༼པེ། སྣར།༽ བསྒོམ་པར་བྱའོ།"
    },
    {
      "span": {
        "start": 3627,
        "end": 3636
      },
      "text": "ཀུན་གྱིས་ ༼པེ། སྣར།༽ ཀུན་གྱི།"
    },
    {
      "span": {
        "start": 3648,
        "end": 3654
      },
      "text": "བཀླགས་ ༼སྣར།༽ ཀླགས།"
    },
    {
      "span": {
        "start": 4113,
        "end": 4118
      },
      "text": "མ་ནཱ་ ༼པེ། སྣར།༽ མཱ་ན།"
    },
    {
      "span": {
        "start": 4174,
        "end": 4185
      },
      "text": "དེ་བཞིན་དུ་ ༼པེ། སྣར།༽ དུ།"
    },
    {
      "span": {
        "start": 4329,
        "end": 4338
      },
      "text": "ཤཱི་གྷྲཾ་ ༼སྣར།༽ ཤྲཱི་གྷ།"
    },
    {
      "span": {
        "start": 4349,
        "end": 4361
      },
      "text": "དཏྟ་ཨུཙྪཱ་ཊ་ ༼པེ། སྣར།༽ དཏ་མུཙྪ་ཊཱ།"
    },
    {
      "span": {
        "start": 4380,
        "end": 4386
      },
      "text": "བསྐྲད་ ༼སྣར།༽ སྐྲད།"
    },
    {
      "span": {
        "start": 4447,
        "end": 4452
      },
      "text": "ཨ་མུ་ ༼པེ། སྣར།༽ ཨ་མཱུ།"
    },
    {
      "span": {
        "start": 4459,
        "end": 4467
      },
      "text": "དྷཱ་ནཱཾ་ ༼པེ། སྣར།༽ དྷཱ་ནཾ།"
    },
    {
      "span": {
        "start": 4467,
        "end": 4477
      },
      "text": "ཀུ་མཱ་རཱི་ ༼པེ། སྣར།༽ ཀུ་མཱ་རི།"
    },
    {
      "span": {
        "start": 4496,
        "end": 4499
      },
      "text": "ཏ་སྱཱཿ ༼པེ། སྣར།༽ ཧ་སྱ།"
    },
    {
      "span": {
        "start": 4509,
        "end": 4516
      },
      "text": "ཡ་ཙྪནྟུ་ ༼པེ། སྣར།༽ ཡ་ཙྪན་ཏུ།"
    },
    {
      "span": {
        "start": 4683,
        "end": 4689
      },
      "text": "སྒྲུབ་ ༼སྣར།༽ གྲུབ།"
    },
    {
      "span": {
        "start": 4699,
        "end": 4704
      },
      "text": "བསྔགས་ ༼པེ། སྣར།༽ སྔགས།"
    },
    {
      "span": {
        "start": 4840,
        "end": 4846
      },
      "text": "སྭསྠཱ་ ༼པེ། སྣར།༽ བྷ་དྷཱི་ནཾ་སྭརྦ་སྠཱ།"
    },
    {
      "span": {
        "start": 4853,
        "end": 4857
      },
      "text": "ཀརྵ་ ༼པེ། སྣར།༽ ཀཱརྵ།"
    },
    {
      "span": {
        "start": 4895,
        "end": 4899
      },
      "text": "རྒྱ་ཤུག་གི་ ༼སྣར།༽ རྒྱ་ཤུག་གིས།"
    },
    {
      "span": {
        "start": 4963,
        "end": 4969
      },
      "text": "བྱས་ན་ ༼པེ། སྣར།༽ སྲེགས་བྱས་ནས།"
    },
    {
      "span": {
        "start": 5231,
        "end": 5238
      },
      "text": "མཆོད་པ་ ༼པེ། སྣར།༽ མཆོད་པར།"
    },
    {
      "span": {
        "start": 5338,
        "end": 5343
      },
      "text": "ཀ་ཐཱ་ ༼པེ། སྣར།༽ ཀ་ཐ།"
    },
    {
      "span": {
        "start": 5721,
        "end": 5728
      },
      "text": "དབང་དུ་ ༼པེ། སྣར།༽ དུ།"
    },
    {
      "span": {
        "start": 5794,
        "end": 5808
      },
      "text": "བརྒྱ་རྩ་བརྒྱད་ ༼པེ། སྣར།༽ རྩ་བརྒྱད།"
    },
    {
      "span": {
        "start": 5934,
        "end": 5938
      },
      "text": "མིག་སྨན་ ༼སྣར།༽ སྨིག་སྨན།"
    },
    {
      "span": {
        "start": 5977,
        "end": 5983
      },
      "text": "དག་ཡང་ ༼པེ། སྣར།༽ དང་མ།"
    },
    {
      "span": {
        "start": 6357,
        "end": 6364
      },
      "text": "སྦྱར་ལ་ ༼པེ། སྣར།༽ སྦྱར་བ།"
    },
    {
      "span": {
        "start": 6579,
        "end": 6586
      },
      "text": "བྷྲྀངྒ་ ༼པེ། སྣར།༽ བྷྲིང་གར།"
    },
    {
      "span": {
        "start": 6596,
        "end": 6602
      },
      "text": "གི་ཝང་ ༼པེ། སྣར།༽ གི་ཧཾ།"
    },
    {
      "span": {
        "start": 6825,
        "end": 6828
      },
      "text": "སཱ་ལུའི་ ༼པེ།༽ ས་ལུའི།"
    },
    {
      "span": {
        "start": 7387,
        "end": 7395
      },
      "text": "ཨ་མུ་ཀཱ་ ༼པེ། སྣར།༽ ཨ་མུ་ཀ"
    },
    {
      "span": {
        "start": 7406,
        "end": 7413
      },
      "text": "མུཀྟིཾ་ ༼པེ། སྣར།༽ མུཀྟི།"
    },
    {
      "span": {
        "start": 7466,
        "end": 7472
      },
      "text": "བར་དུ་ ༼པེ། སྣར།༽ -བར་དུ།"
    }
  ]
}