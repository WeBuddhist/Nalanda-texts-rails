{
  "durchens": [
    {
      "span": {
        "start": 39,
        "end": 42
      },
      "text": "ཏྱ་ ༼སྣར། པེ།༽ ཏ་"
    },
    {
      "span": {
        "start": 492,
        "end": 495
      },
      "text": "ནི། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 541,
        "end": 555
      },
      "text": "མཆོད་རྟེན་བཞི་ ༼སྣར། པེ།༽ མཆོད་རྟེན་གཞི་"
    },
    {
      "span": {
        "start": 619,
        "end": 622
      },
      "text": "ཆོ་ ༼སྣར། པེ།༽ ཆུ་"
    },
    {
      "span": {
        "start": 1250,
        "end": 1254
      },
      "text": "དག ། ༼སྣར། པེ།༽ དང་། །"
    },
    {
      "span": {
        "start": 1337,
        "end": 1341
      },
      "text": "འཚལ། ༼སྣར། པེ།༽ འཚལ་ལ།"
    },
    {
      "span": {
        "start": 1539,
        "end": 1543
      },
      "text": "ཏིང་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 1670,
        "end": 1675
      },
      "text": "སོ། ། ༼པེ།༽ ། །མངྒཱ་ལཾ།"
    }
  ]
}