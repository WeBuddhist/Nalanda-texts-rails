{
  "durchens": [
    {
      "span": {
        "start": 452,
        "end": 461
      },
      "text": "འཁོར་བ་ན་ ༼སྣར། པེ།༽ འཁོར་བ་"
    },
    {
      "span": {
        "start": 575,
        "end": 583
      },
      "text": "བགྱིད་པ་ ༼སྣར། པེ།༽ བགྱིས་པ་"
    },
    {
      "span": {
        "start": 753,
        "end": 761
      },
      "text": "བཤགས་པས་ ༼སྣར། པེ།༽ བཤགས་པར་"
    },
    {
      "span": {
        "start": 1212,
        "end": 1221
      },
      "text": "རང་བའོ། ། ༼སྣར། པེ།༽ རང་ངོ་།། །།"
    },
    {
      "span": {
        "start": 1756,
        "end": 1761
      },
      "text": "ཞི་བ་ ༼སྣར།༽ ཞི་བ་ལ་"
    },
    {
      "span": {
        "start": 1773,
        "end": 1780
      },
      "text": "སོ་སོར་ ༼སྣར། པེ།༽ སོ་སོ་"
    },
    {
      "span": {
        "start": 2084,
        "end": 2089
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 2211,
        "end": 2216
      },
      "text": "དབུལ་ ༼སྣར། པེ།༽ འབུལ་"
    },
    {
      "span": {
        "start": 2264,
        "end": 2273
      },
      "text": "བདག་བཞེས་ ༼ཅོ།༽ བདག་ལ་དགོངས་ ༼སྣར།༽ བདག་ལ་བཞེས་"
    },
    {
      "span": {
        "start": 2298,
        "end": 2302
      },
      "text": "ཟླས། ༼སྡེ། ཅོ། སྣར།༽ བཟླས།"
    },
    {
      "span": {
        "start": 2419,
        "end": 2425
      },
      "text": "ཡང་དག་ ༼སྣར། པེ།༽ ཡང་དག་པར་"
    },
    {
      "span": {
        "start": 2681,
        "end": 2688
      },
      "text": "ཅི་ལྟར་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 3698,
        "end": 3710
      },
      "text": "ཕམ་པར་བགྱིས་ ༼པེ།༽ ཕམ་པར་གྱིས་"
    },
    {
      "span": {
        "start": 4311,
        "end": 4317
      },
      "text": "མགྲོན་ ༼སྣར། པེ།༽ འགྲོན་"
    },
    {
      "span": {
        "start": 4561,
        "end": 4569
      },
      "text": "བགྱིད་པ་ ༼སྣར།༽ བགྱིས་པ་"
    },
    {
      "span": {
        "start": 4750,
        "end": 4757
      },
      "text": "བརྒལ་བ་ ༼སྣར། པེ།༽ རྒལ་བ་"
    },
    {
      "span": {
        "start": 4765,
        "end": 4771
      },
      "text": "བསྒྲལ་ ༼སྣར། པེ།༽ སྒྲལ་"
    },
    {
      "span": {
        "start": 4934,
        "end": 4942
      },
      "text": "རྣམས་ནི་ ༼སྣར།༽ རྣམས་"
    },
    {
      "span": {
        "start": 5017,
        "end": 5029
      },
      "text": "དཔུང་གཉེན་མ་ ༼པེ།༽ དཔུང་གཉེན་"
    },
    {
      "span": {
        "start": 5326,
        "end": 5333
      },
      "text": "བརྩམ་པ་ ༼སྣར།༽ རྩོམ་"
    },
    {
      "span": {
        "start": 5355,
        "end": 5361
      },
      "text": "གཞག་པ་ ༼སྣར། པེ།༽ བཞག་པ་"
    },
    {
      "span": {
        "start": 5380,
        "end": 5388
      },
      "text": "དཔྱོད་པ་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 5862,
        "end": 5874
      },
      "text": "ཐམས་ཅད་ཀྱིས། ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི།"
    },
    {
      "span": {
        "start": 6297,
        "end": 6306
      },
      "text": "རྫོགས། །། ༼སྣར། པེ།༽ རྫོགསརྫོགས་སོ། །།"
    },
    {
      "span": {
        "start": 6324,
        "end": 6333
      },
      "text": "སུ་རན་དྲ་ ༼སྣར། པེ།༽ སུ་རེནྟྲ་"
    }
  ]
}