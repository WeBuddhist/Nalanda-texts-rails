{
  "durchens": [
    {
      "span": {
        "start": 21,
        "end": 30
      },
      "text": "པྲཛྙཱ་པཱ། ༼པེ། སྣར།༽ པ།"
    },
    {
      "span": {
        "start": 134,
        "end": 141
      },
      "text": "ཕྱིན་མ། ༼པེ། སྣར།༽ ཕྱིན་པ།"
    },
    {
      "span": {
        "start": 386,
        "end": 392
      },
      "text": "དང་པོ། ༼པེ།༽ དང་པོར།"
    },
    {
      "span": {
        "start": 414,
        "end": 418
      },
      "text": "གཞག ༼སྣར།༽ བཞག"
    },
    {
      "span": {
        "start": 628,
        "end": 632
      },
      "text": "བྷྱ་ ༼པེ། སྣར།༽ ཡ།"
    },
    {
      "span": {
        "start": 680,
        "end": 684
      },
      "text": "བྷྱ་ ༼པེ། སྣར།༽ ཡ།"
    },
    {
      "span": {
        "start": 812,
        "end": 816
      },
      "text": "དཱི། ༼པེ། སྣར།༽ དྷི།"
    },
    {
      "span": {
        "start": 920,
        "end": 925
      },
      "text": "ཙ་ནཱ། ༼པེ། སྣར།༽ ཙ་ན།"
    },
    {
      "span": {
        "start": 983,
        "end": 989
      },
      "text": "ཕྱོགས་སུ་ ༼པེ། སྣར།༽ ལོགས་སུ།"
    },
    {
      "span": {
        "start": 1091,
        "end": 1096
      },
      "text": "ཧྲཱིཿ ༼པ། སྣར།༽ ཧཱིཿ།"
    },
    {
      "span": {
        "start": 1104,
        "end": 1110
      },
      "text": "པུཥྤེ་ ༼པེ། སྣར།༽ ཡེ། ཨོཾ་ཨཱཿཧཱུཾ།"
    },
    {
      "span": {
        "start": 1159,
        "end": 1171
      },
      "text": "སིདྡྷི་ཡེ་ཨཿ ༼པེ། སྣར།༽ སིདྡྷི་ཡེ།"
    },
    {
      "span": {
        "start": 1422,
        "end": 1425
      },
      "text": "མཱ་ ༼པེ། སྣར། ༽ མ།"
    },
    {
      "span": {
        "start": 1512,
        "end": 1517
      },
      "text": "ན་མོ། ༼པེ། སྣར།༽ ན་མོཿ།"
    },
    {
      "span": {
        "start": 1522,
        "end": 1528
      },
      "text": "རཱ་ཡེ་ ༼པེ། སྣར།༽ རཱ་ཡཻ།"
    },
    {
      "span": {
        "start": 1587,
        "end": 1591
      },
      "text": "སྣང་ ༼པེ། སྣར།༽ སྣང་།"
    },
    {
      "span": {
        "start": 1618,
        "end": 1624
      },
      "text": "སྟཱ་ར་ ༼པེ། སྣར།༽ སྟ་རཱ།"
    },
    {
      "span": {
        "start": 1701,
        "end": 1704
      },
      "text": "པྲ་ཛྙཱ་པཱ་ ༼པེ། སྣར།༽ མཿཔྲ་ཛྙཱ་པ།"
    },
    {
      "span": {
        "start": 1843,
        "end": 1846
      },
      "text": "ཀོ྅ ༼པེ། སྣར།༽ ྅།"
    },
    {
      "span": {
        "start": 1857,
        "end": 1863
      },
      "text": "ལྷ་མོ་ ༼པེ། སྣར།༽ ལྷའི།"
    },
    {
      "span": {
        "start": 2024,
        "end": 2032
      },
      "text": "འཁོར་བར་ ༼པེ། སྣར།༽ འཁོར་བར།"
    },
    {
      "span": {
        "start": 2150,
        "end": 2160
      },
      "text": "རྣལ་འབྱོར་ ༼པེ། སྣར།༽ བརྙེས།"
    },
    {
      "span": {
        "start": 2616,
        "end": 2622
      },
      "text": "མེད་པ་ ༼པེ། སྣར།༽ མེད་པས།"
    },
    {
      "span": {
        "start": 2991,
        "end": 3001
      },
      "text": "རྣམས་ཀྱིས་ ༼པེ། སྣར།༽ རྣམས་ཀྱི།"
    },
    {
      "span": {
        "start": 3461,
        "end": 3468
      },
      "text": "ཤུདྡྷོ྅ ༼པེ།༽ བ་ཤུདྡྷཿསརྦ་དྷརྨཱ་སྭ་བྷཱ་བ་ཤུད་དྷོ་ཧཾ། ༼སྣར།༽ ཛྙཱ་ན་ ༼པེ། སྣར།༽ བ་ཤུདྡྷཿསརྦ་དྷརྨཱ་སྭ་བྷཱ་བ་ཤུདྡྷོ་ཧཾ།"
    },
    {
      "span": {
        "start": 3711,
        "end": 3717
      },
      "text": "ཛྙཱ་ན་ ༼སྣར།༽ ཛྙཱ་ནཱ།"
    },
    {
      "span": {
        "start": 3735,
        "end": 3738
      },
      "text": "ཀོ྅ ༼པེ། སྣར།༽ ྅།"
    },
    {
      "span": {
        "start": 3962,
        "end": 3968
      },
      "text": "འདྲ་བ་ ༼པེ། སྣར།༽ འདྲ་བར།"
    },
    {
      "span": {
        "start": 4006,
        "end": 4009
      },
      "text": "པདྨ་ ༼པེ། སྣར།༽ པདྨ་དང་།"
    },
    {
      "span": {
        "start": 4024,
        "end": 4026
      },
      "text": "ཧ་ ༼པེ། སྣར།༽ ཧཱཿ"
    },
    {
      "span": {
        "start": 4287,
        "end": 4294
      },
      "text": "དྲི་ཆབ་ ༼པེ། སྣར།༽ དྲི་ཆབ།"
    },
    {
      "span": {
        "start": 4467,
        "end": 4474
      },
      "text": "པུསྟིའོ་ ༼པེ། སྣར།༽ པོ་ཏི།"
    },
    {
      "span": {
        "start": 4560,
        "end": 4566
      },
      "text": "པུསྟི་ ༼པེ། སྣར།༽ པོ་ཏི།"
    },
    {
      "span": {
        "start": 4708,
        "end": 4720
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼པེ། སྣར།༽ ཐམས་ཅད་ཀྱི།"
    },
    {
      "span": {
        "start": 4805,
        "end": 4812
      },
      "text": "གཉིས་པ་ ༼པེ། སྣར།༽ གཉིས།"
    },
    {
      "span": {
        "start": 4938,
        "end": 4941
      },
      "text": "ལས་ ༼པེ། སྣར།༽ ལ།"
    },
    {
      "span": {
        "start": 4992,
        "end": 4999
      },
      "text": "ཕྱིན་མ་ ༼པེ། སྣར།༽ ཕྱིན་པ།"
    },
    {
      "span": {
        "start": 5073,
        "end": 5076
      },
      "text": "ཨཱཿ ༼པེ། སྣར།༽ ཨཱཿ།"
    },
    {
      "span": {
        "start": 5138,
        "end": 5146
      },
      "text": "སེར་པོར། ༼པེ། སྣར།༽ སེར་པོ།"
    },
    {
      "span": {
        "start": 5248,
        "end": 5253
      },
      "text": "སྔོན་པོའོ། ། ༼པེ། སྣར།༽ སྔོན་པོ།"
    },
    {
      "span": {
        "start": 5287,
        "end": 5289
      },
      "text": "ཕྱིན་མ་ཡི། ༼པེ། སྣར།༽ ཕྱིན་པ།"
    },
    {
      "span": {
        "start": 5361,
        "end": 5365
      },
      "text": "ཐོབ་ ༼པེ། སྣར།༽ འཐོབ།"
    },
    {
      "span": {
        "start": 5466,
        "end": 5470
      },
      "text": "།། །། ༼པེ།༽ དང་པོའི་དུམ་པོའོ། ། ༼སྣར།༽ དང་པོའི་དུམ་བུའོ། །"
    }
  ]
}