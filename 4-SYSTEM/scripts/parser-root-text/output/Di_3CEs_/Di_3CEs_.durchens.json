{
  "durchens": [
    {
      "span": {
        "start": 26,
        "end": 30
      },
      "text": "བ་ན་ ༼སྣར། པེ།༽ པ་ཎ་"
    },
    {
      "span": {
        "start": 557,
        "end": 567
      },
      "text": "རྫས་ཡོད་ལ། ༼སྣར། པེ།༽ རྫས་ཡོད་པ།"
    },
    {
      "span": {
        "start": 569,
        "end": 576
      },
      "text": "མེད་དེ་ ༼སྣར། པེ།༽ དེ་མེད་"
    },
    {
      "span": {
        "start": 642,
        "end": 648
      },
      "text": "བསལ་ན་ ༼སྣར། པེ།༽ གསལ་བ་"
    },
    {
      "span": {
        "start": 667,
        "end": 682
      },
      "text": "ཉམས་འགྱུར་ཞིང་། ༼སྣར། པེ།༽ ཉམས་པར་འགྱུར།"
    },
    {
      "span": {
        "start": 733,
        "end": 737
      },
      "text": "དེར། ༼སྣར། པེ།༽ དེ།"
    },
    {
      "span": {
        "start": 789,
        "end": 793
      },
      "text": "ཡིན་ ༼སྣར།༽ ཡིན་པའི་"
    },
    {
      "span": {
        "start": 852,
        "end": 861
      },
      "text": "རིམ་གྱིས་ ༼སྣར། པེ།༽ རིམ་གྱི་"
    },
    {
      "span": {
        "start": 890,
        "end": 893
      },
      "text": "ཡི། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 1001,
        "end": 1006
      },
      "text": "ཐོགས་ ༼སྣར། པེ།༽ ཐོག་མ་"
    },
    {
      "span": {
        "start": 1010,
        "end": 1017
      },
      "text": "དུས་ནས་ ༼སྣར། པེ།༽ དུས་"
    },
    {
      "span": {
        "start": 1038,
        "end": 1046
      },
      "text": "བརྟགས་པ་ ༼སྣར། པེ།༽ བརྟག་པའི་ཚིག་ལེའུར་བྱས་པ་"
    }
  ]
}