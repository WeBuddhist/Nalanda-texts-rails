{
  "durchens": [
    {
      "span": {
        "start": 214,
        "end": 223
      },
      "text": "བསྟོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 384,
        "end": 388
      },
      "text": "ཡོང་ ༼སྣར། པེ།༽ ཡོངས་"
    },
    {
      "span": {
        "start": 601,
        "end": 605
      },
      "text": "གནག་ ༼སྣར། པེ།༽ ནག་"
    },
    {
      "span": {
        "start": 633,
        "end": 637
      },
      "text": "ཡོང་ ༼སྣར། པེ།༽ ཡོངས་"
    },
    {
      "span": {
        "start": 709,
        "end": 716
      },
      "text": "ཟླུམ་པ་ ༼སྣར། པེ།༽ ཟླུམ་པས་"
    },
    {
      "span": {
        "start": 960,
        "end": 965
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 996,
        "end": 1002
      },
      "text": "བསྟོད། ༼སྣར། པེ།༽ འདུད།"
    },
    {
      "span": {
        "start": 1041,
        "end": 1046
      },
      "text": "འདིར་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 1136,
        "end": 1140
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 1173,
        "end": 1175
      },
      "text": "པ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 1192,
        "end": 1201
      },
      "text": "མི་མངའ་བ། ༼སྣར། པེ།༽ མ་མཆིས་པས།"
    },
    {
      "span": {
        "start": 1287,
        "end": 1297
      },
      "text": "བསྟོད་པའི། ༼སྣར། པེ།༽ བསྟོད་པས།"
    },
    {
      "span": {
        "start": 1380,
        "end": 1397
      },
      "text": "སློབ་དཔོན་འཕགས་པ་ ༼སྣར། པེ།༽ སློབ་དཔོན་"
    }
  ]
}