{
  "durchens": [
    {
      "span": {
        "start": 23,
        "end": 26
      },
      "text": "དི་ ༼སྣར། པེ།༽ དྷི་"
    },
    {
      "span": {
        "start": 151,
        "end": 159
      },
      "text": "སྔགས་པས་ ༼སྣར།༽ སྔགས་པ་"
    },
    {
      "span": {
        "start": 218,
        "end": 224
      },
      "text": "བརྒྱན་ ༼སྣར། པེ།༽ རྒྱས་"
    },
    {
      "span": {
        "start": 582,
        "end": 589
      },
      "text": "མཆོད་པ་ ༼སྣར། པེ།༽ མཆོད་པ་བདུན་གྱིས་མཆོད་པར་"
    },
    {
      "span": {
        "start": 679,
        "end": 684
      },
      "text": "བསྔོ་ ༼སྣར། པེ།༽ ལ་རྗེས་སུ་སྔོ་"
    },
    {
      "span": {
        "start": 752,
        "end": 760
      },
      "text": "བསྟེན་པ་ ༼སྣར། པེ།༽ བརྟེན་པ་"
    },
    {
      "span": {
        "start": 1188,
        "end": 1191
      },
      "text": "ལས་ ༼སྡེ།༽ ལ་"
    },
    {
      "span": {
        "start": 1416,
        "end": 1419
      },
      "text": "ལས་ ༼སྣར།༽ ལ་"
    },
    {
      "span": {
        "start": 1701,
        "end": 1712
      },
      "text": "འོད་ཟེར་ཅན་ ༼སྣར། པེ།༽ འོད་ཟེར་"
    },
    {
      "span": {
        "start": 2036,
        "end": 2046
      },
      "text": "གཉིས་ཀྱིས་ ༼སྣར།༽ གཉིས་"
    },
    {
      "span": {
        "start": 2050,
        "end": 2057
      },
      "text": "རྗེ་དང་ ༼སྣར། པེ།༽ རྗེ་"
    },
    {
      "span": {
        "start": 2061,
        "end": 2069
      },
      "text": "གྲི་གུག་ ༼སྣར། པེ།༽ གྲི་གུག་དང་ཐོད་པ་"
    },
    {
      "span": {
        "start": 2171,
        "end": 2178
      },
      "text": "གཡས་པས་ ༼སྣར། པེ།༽ གཡས་པ་"
    },
    {
      "span": {
        "start": 2455,
        "end": 2460
      },
      "text": "རྒྱས་ ༼སྣར།༽ བརྒྱས་"
    },
    {
      "span": {
        "start": 2543,
        "end": 2553
      },
      "text": "བསྒོམས་པས་ ༼སྣར། པེ།༽ བསྒོམ་པས་"
    },
    {
      "span": {
        "start": 2778,
        "end": 2784
      },
      "text": "བསྔོས་ ༼སྣར།༽ བསྔོ་བར་"
    },
    {
      "span": {
        "start": 2855,
        "end": 2858
      },
      "text": "པར་ ༼སྣར།༽ དང་"
    },
    {
      "span": {
        "start": 3076,
        "end": 3080
      },
      "text": "བཛྲ་ ༼སྣར། པེ།༽ ཨ་བཛྲ་"
    }
  ]
}