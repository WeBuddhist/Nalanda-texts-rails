{
  "durchens": [
    {
      "span": {
        "start": 629,
        "end": 638
      },
      "text": "བཀྲམ་སྟེ། ༼པེ།༽ བཀྲམ་ཏེ།"
    },
    {
      "span": {
        "start": 667,
        "end": 672
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 744,
        "end": 751
      },
      "text": "བསྟིམས་ ༼སྣར། པེ།༽ བསྟིམ་"
    },
    {
      "span": {
        "start": 759,
        "end": 768
      },
      "text": "སྔགས་ཀྱི་ ༼སྣར། པེ།༽ སྔགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 1045,
        "end": 1050
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ སྲུངས་"
    },
    {
      "span": {
        "start": 1156,
        "end": 1159
      },
      "text": "བེ་ ༼སྣར། པེ།༽ བེ་ཡེ་"
    },
    {
      "span": {
        "start": 1255,
        "end": 1259
      },
      "text": "ཛཿ ། ༼སྣར། པེ།༽ ཛ། །"
    },
    {
      "span": {
        "start": 1378,
        "end": 1387
      },
      "text": "བརླབས་ཏེ། ༼སྣར། པེ།༽ བརླབ་སྟེ།"
    },
    {
      "span": {
        "start": 1745,
        "end": 1750
      },
      "text": "བསླུ་ ༼སྣར། པེ།༽ སླུ་"
    },
    {
      "span": {
        "start": 2199,
        "end": 2205
      },
      "text": "བའོ། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 2376,
        "end": 2381
      },
      "text": "གྱུར། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 2418,
        "end": 2424
      },
      "text": "པའོ། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 2430,
        "end": 2442
      },
      "text": "བཟང་པོས་བཀང་ ༼སྣར། པེ།༽ བཟང་པོ་བརྐོ་"
    },
    {
      "span": {
        "start": 2545,
        "end": 2549
      },
      "text": "འཐས་ ༼སྣར། པེ།༽ མཐས་"
    },
    {
      "span": {
        "start": 2647,
        "end": 2658
      },
      "text": "བདག་བསྐྱེད་ ༼སྣར། པེ།༽ དག་བྱེད་"
    },
    {
      "span": {
        "start": 2714,
        "end": 2720
      },
      "text": "བའོ། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 2917,
        "end": 2924
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 2971,
        "end": 2973
      },
      "text": "བ་ ༼སྣར། པེ།༽ ཝ་"
    },
    {
      "span": {
        "start": 2994,
        "end": 2999
      },
      "text": "བཟླས་ ༼སྣར། པེ།༽ བཟླས་ས་"
    },
    {
      "span": {
        "start": 3006,
        "end": 3014
      },
      "text": "ལྡན་བྱས་ ༼སྣར། པེ།༽ ལྡན་"
    },
    {
      "span": {
        "start": 3072,
        "end": 3078
      },
      "text": "པའོ། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 3311,
        "end": 3317
      },
      "text": "བཅུའི་ ༼སྣར། པེ།༽ བཅུ་"
    },
    {
      "span": {
        "start": 3380,
        "end": 3383
      },
      "text": "ནས་ ༼ཅོ།༽ ན་དང་"
    },
    {
      "span": {
        "start": 3529,
        "end": 3536
      },
      "text": "གསོལ་བ་ ༼སྣར། པེ།༽ གསོལ་བ་གདབ་པ་"
    },
    {
      "span": {
        "start": 3589,
        "end": 3597
      },
      "text": "བཟུང་བར་ ༼སྣར། པེ།༽ གཟུང་བར་"
    },
    {
      "span": {
        "start": 3610,
        "end": 3616
      },
      "text": "བཅུའི་ ༼སྣར། པེ།༽ བཅུ་"
    },
    {
      "span": {
        "start": 3681,
        "end": 3687
      },
      "text": "པའོ། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 4047,
        "end": 4055
      },
      "text": "བྲི་བའི་ ༼སྣར། པེ།༽ དྲི་བའི་"
    },
    {
      "span": {
        "start": 4328,
        "end": 4333
      },
      "text": "སྐུར་ ༼སྣར། པེ།༽ སྐུ་"
    },
    {
      "span": {
        "start": 4444,
        "end": 4451
      },
      "text": "འདི་དག་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 4458,
        "end": 4461
      },
      "text": "བྱ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 4701,
        "end": 4704
      },
      "text": "བྱ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 4909,
        "end": 4915
      },
      "text": "བཞིའི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 4984,
        "end": 4988
      },
      "text": "བྱས། ༼སྣར། པེ།༽ བྱ།"
    },
    {
      "span": {
        "start": 5063,
        "end": 5070
      },
      "text": "དེང་ནས་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 5195,
        "end": 5199
      },
      "text": "ཡིག་ ༼སྣར། པེ།༽ ཡི་གེ་"
    },
    {
      "span": {
        "start": 5361,
        "end": 5371
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 5453,
        "end": 5457
      },
      "text": "ཧའི་ ༼སྣར། པེ།༽ ཧ་"
    },
    {
      "span": {
        "start": 5497,
        "end": 5506
      },
      "text": "གཡོན་པའི་ ༼སྣར། པེ།༽ གཡོན་པ་"
    },
    {
      "span": {
        "start": 5530,
        "end": 5537
      },
      "text": "གཡས་པས་ ༼སྣར། པེ།༽ གཡས་པ་"
    },
    {
      "span": {
        "start": 5594,
        "end": 5599
      },
      "text": "བསྒོ་ ༼སྣར། པེ།༽ སྒོ་"
    },
    {
      "span": {
        "start": 5729,
        "end": 5745
      },
      "text": "ཐམས་ཅད་མ་གནས་པར་ ༼ཅོ།༽ ཐམས་ཅད་མ་གནས་པ་ས་པ་ ༼སྣར། པེ།༽ ཅད་"
    },
    {
      "span": {
        "start": 5969,
        "end": 5976
      },
      "text": "འགས་པར་ ༼སྣར། པེ།༽ འགས་པས་"
    },
    {
      "span": {
        "start": 6121,
        "end": 6125
      },
      "text": "སྤོ་ ༼སྣར། པེ།༽ སྥོ་"
    },
    {
      "span": {
        "start": 6129,
        "end": 6133
      },
      "text": "སྤོ་ ༼སྣར། པེ།༽ སྥོ་"
    },
    {
      "span": {
        "start": 6363,
        "end": 6373
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 6380,
        "end": 6385
      },
      "text": "ལག་པ་ ༼སྣར། པེ།༽ ལག་པར་"
    },
    {
      "span": {
        "start": 6500,
        "end": 6509
      },
      "text": "ཁྲོ་བོའི་ ༼སྣར། པེ།༽ ཁྲོ་བོ་"
    },
    {
      "span": {
        "start": 6718,
        "end": 6723
      },
      "text": "སྐུར་ ༼སྣར། པེ།༽ སྐུ་"
    },
    {
      "span": {
        "start": 6877,
        "end": 6881
      },
      "text": "རིག་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 7066,
        "end": 7068
      },
      "text": "བ་ ༼སྣར། པེ།༽ བར་"
    },
    {
      "span": {
        "start": 7081,
        "end": 7091
      },
      "text": "དགོངས་ཤིག་ ༼སྣར། པེ།༽ དགོངས་ཤིང་"
    },
    {
      "span": {
        "start": 7173,
        "end": 7186
      },
      "text": "གསང་སྔགས་རིག་ ༼སྣར། པེ།༽ གསང་སྔགས་རིགས་"
    },
    {
      "span": {
        "start": 7665,
        "end": 7672
      },
      "text": "དེང་ནས་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 7672,
        "end": 7678
      },
      "text": "བརྩམས་ ༼སྣར། པེ།༽ བསམས་"
    },
    {
      "span": {
        "start": 7685,
        "end": 7694
      },
      "text": "སྔོན་གྱི། ༼སྣར། པེ།༽ སྔོན་གྱིས།"
    },
    {
      "span": {
        "start": 7797,
        "end": 7806
      },
      "text": "བརྒྱད་དང་ ༼སྣར། པེ།༽ བརྒྱད་"
    },
    {
      "span": {
        "start": 7958,
        "end": 7966
      },
      "text": "ཉི་ཟླའི་ ༼སྣར། པེ།༽ ཉི་མའི་"
    },
    {
      "span": {
        "start": 8006,
        "end": 8009
      },
      "text": "ཀང་ ༼སྣར། པེ།༽ རྐང་"
    },
    {
      "span": {
        "start": 8360,
        "end": 8367
      },
      "text": "བུམ་པར་ ༼སྣར། པེ།༽ བུམ་པས་"
    },
    {
      "span": {
        "start": 8580,
        "end": 8587
      },
      "text": "བཅའ་བར་ ༼སྣར། པེ།༽ བཅིང་བར་"
    },
    {
      "span": {
        "start": 8701,
        "end": 8710
      },
      "text": "བརྟག་པའི་ ༼སྣར། པེ།༽ ལྷག་པའི་"
    },
    {
      "span": {
        "start": 8813,
        "end": 8819
      },
      "text": "བྱུགས་ ༼སྡེ།༽ ཕྱུགས་"
    },
    {
      "span": {
        "start": 8854,
        "end": 8862
      },
      "text": "ཕྱི་རིམ་ ༼སྣར། པེ།༽ ཕྱི་རོལ་"
    },
    {
      "span": {
        "start": 9010,
        "end": 9015
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 9037,
        "end": 9042
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 9129,
        "end": 9134
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 9526,
        "end": 9530
      },
      "text": "བོག་ ༼སྣར།༽ ཕོག་"
    },
    {
      "span": {
        "start": 9653,
        "end": 9661
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 9703,
        "end": 9711
      },
      "text": "དྲིལ་བུ་ ༼སྣར། པེ།༽ དྲིལ་བུའི་"
    },
    {
      "span": {
        "start": 9738,
        "end": 9746
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 9803,
        "end": 9813
      },
      "text": "ཆེན་པོ་ཡི། ༼སྣར། པེ།༽ ཆེན་པོ་ཡིས།"
    },
    {
      "span": {
        "start": 9957,
        "end": 9960
      },
      "text": "ནང་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 9992,
        "end": 10000
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 10074,
        "end": 10082
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 10141,
        "end": 10147
      },
      "text": "གཟུང་། ༼སྣར། པེ།༽ བཟུང་།"
    },
    {
      "span": {
        "start": 10160,
        "end": 10165
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 10177,
        "end": 10189
      },
      "text": "སློབ་མའི་ཡང་ ༼སྣར། པེ།༽ སློབ་མ་ལ་འོད་"
    },
    {
      "span": {
        "start": 10215,
        "end": 10220
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 10395,
        "end": 10403
      },
      "text": "སྔོན་ཅན། ༼སྣར། པེ།༽ སྔོན་ནོ།"
    },
    {
      "span": {
        "start": 10452,
        "end": 10460
      },
      "text": "སྔོན་ཅན། ༼སྣར། པེ།༽ སྔོན་ནོ།"
    },
    {
      "span": {
        "start": 10692,
        "end": 10698
      },
      "text": "རྩིའི་ ༼སྣར། པེ།༽ རྩི་"
    },
    {
      "span": {
        "start": 10723,
        "end": 10728
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 10961,
        "end": 10971
      },
      "text": "གདགས་བྱའོ། ༼སྣར། པེ།༽ གདགས་པར་བྱ།"
    },
    {
      "span": {
        "start": 11071,
        "end": 11076
      },
      "text": "བྱའོ། ༼སྣར། པེ།༽ བྱ།"
    },
    {
      "span": {
        "start": 11114,
        "end": 11121
      },
      "text": "ཁ་བལྟས་ ༼སྣར། པེ།༽ ཁ་ལྟས་"
    },
    {
      "span": {
        "start": 11381,
        "end": 11384
      },
      "text": "ལྟ། ༼སྣར། པེ།༽ བལྟ།"
    },
    {
      "span": {
        "start": 11619,
        "end": 11629
      },
      "text": "རྒྱལ་པོའི་ ༼སྣར། པེ།༽ རྒྱལ་པོ་"
    },
    {
      "span": {
        "start": 11673,
        "end": 11680
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 11691,
        "end": 11695
      },
      "text": "སྔས་ ༼སྣར། པེ།༽ སྔགས་"
    },
    {
      "span": {
        "start": 11743,
        "end": 11754
      },
      "text": "བསྐྱེད་པའི་ ༼སྣར། པེ།༽ སྐྱེད་པའི་"
    },
    {
      "span": {
        "start": 12094,
        "end": 12101
      },
      "text": "འདི་ཡི་ ༼པེ།༽ འདི་ཡིས་"
    },
    {
      "span": {
        "start": 12152,
        "end": 12158
      },
      "text": "དེ་ཡི་ ༼སྣར། པེ།༽ དེ་ཡིས་"
    },
    {
      "span": {
        "start": 12180,
        "end": 12188
      },
      "text": "སྤྱད་པར་ ༼སྣར། པེ།༽ ཁྱད་པར་"
    },
    {
      "span": {
        "start": 12926,
        "end": 12931
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིག་"
    },
    {
      "span": {
        "start": 13265,
        "end": 13270
      },
      "text": "སྐོར་ ༼སྣར། པེ།༽ བསྐོར་"
    },
    {
      "span": {
        "start": 13513,
        "end": 13521
      },
      "text": "མཐིང་གར་ ༼སྣར། པེ།༽ མཐིང་ག་"
    },
    {
      "span": {
        "start": 13533,
        "end": 13543
      },
      "text": "འཁོར་ལོའི་ ༼སྣར། པེ།༽ འཁོར་ལོ་"
    },
    {
      "span": {
        "start": 13855,
        "end": 13864
      },
      "text": "ལྗང་གུའི་ ༼སྣར། པེ།༽ ལྗང་གུ་"
    },
    {
      "span": {
        "start": 14065,
        "end": 14079
      },
      "text": "དྲིལ་བུག་གོང་། ༼སྣར། པེ།༽ དྲིལ་བུ་དགོད།"
    },
    {
      "span": {
        "start": 14105,
        "end": 14107
      },
      "text": "པ། ༼སྣར། པེ།༽ སུ།"
    },
    {
      "span": {
        "start": 14117,
        "end": 14122
      },
      "text": "ཕ་གུ་ ༼སྣར། པེ།༽ ཕ་ཁུ་"
    },
    {
      "span": {
        "start": 14268,
        "end": 14273
      },
      "text": "བྱེད། ༼སྣར། པེ།༽ བསྐྱེད།"
    },
    {
      "span": {
        "start": 14367,
        "end": 14377
      },
      "text": "སྤོས་ཀྱིས་ ༼སྣར། པེ།༽ སྤོས་ཀྱི་"
    },
    {
      "span": {
        "start": 14670,
        "end": 14678
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 14687,
        "end": 14693
      },
      "text": "བཞིའི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 14707,
        "end": 14710
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 14774,
        "end": 14780
      },
      "text": "པའོ། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 15019,
        "end": 15026
      },
      "text": "ཁྱོད། ། ༼སྣར། པེ།༽ ། །ལས་འཕྲོ་དང་ནི་ཐུགས་རྗེས་འབྱུང་། །བཅོམ་ལྡན་རྡོ་རྗེ་འཛིན་པ་ཆེ། །ཐོགས་པ་མེད་པའི་སྐུ་བརྙེས་པ། །འདི་ཡི་ཚུལ་གྱིས་མངོན་པར་བསྒྲུབ། །སེམས་ཅན་སྐལ་བ་ངན་པ་ཡིས། །དེ་ཡིས་མིང་ཡང་ཐོས་མི་སྲིད། །སྤྱད་པར་འགྱུར་བ་སྨོས་ཅི་དགོས། །སང་གི་ཉིན་མོ་ཁྱེད་རྣམས་ཀུན། །དཀྱིལ་འཁོར་བཟང་པོ་མཐོང་བ་ཡིས། །བླ་མེད་མཆོག་ལ་རེག་པར་འགྱུར། །ཞེས་སྤྲོ་བ་བསྐྱེད་པའི་ཆོས་གཞན་ཡང་བཤད་པར་བྱའོ།། །།ནང་པར་སྔར་ནི་བློ་ཅན་ལངས། །རྨི་ལམ་ཅི་མཐོང་དྲི་བར་བྱ། །གོས་སྔོན་སྐུ་གཟུགས་མཐོང་བ་དང་། །"
    },
    {
      "span": {
        "start": 15287,
        "end": 15293
      },
      "text": "བསྒྲག་ ༼སྣར། པེ།༽ བསྒྲགས་"
    },
    {
      "span": {
        "start": 15391,
        "end": 15396
      },
      "text": "བཀུམ་ ༼སྣར། པེ།༽ བསྐུལ་"
    },
    {
      "span": {
        "start": 15618,
        "end": 15626
      },
      "text": "སྲེག་པར་ ༼སྣར། པེ།༽ བསྲེག་པར་"
    },
    {
      "span": {
        "start": 15726,
        "end": 15730
      },
      "text": "མྲི་ ༼སྣར། པེ།༽ མྲྀ་"
    },
    {
      "span": {
        "start": 15751,
        "end": 15757
      },
      "text": "བསྒགས་ ༼སྣར། པེ།༽ བསྒག་"
    },
    {
      "span": {
        "start": 15779,
        "end": 15789
      },
      "text": "ཁྱོད་ཀྱིས། ༼སྣར། པེ།༽ ཁྱོད་ཀྱི།"
    },
    {
      "span": {
        "start": 15918,
        "end": 15923
      },
      "text": "བཀུམ་ ༼སྣར། པེ།༽ བསྐུལ་"
    },
    {
      "span": {
        "start": 16047,
        "end": 16052
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 16197,
        "end": 16203
      },
      "text": "བསྐུལ་ ༼སྣར། པེ།༽ སྐུལ་"
    },
    {
      "span": {
        "start": 16257,
        "end": 16270
      },
      "text": "བསྲེག་བྱས་ནས། ༼སྣར། པེ།༽ བསྲེག་པ་ཀུན།"
    },
    {
      "span": {
        "start": 16517,
        "end": 16522
      },
      "text": "བྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 16683,
        "end": 16691
      },
      "text": "སྟེར་བར་ ༼སྣར། པེ།༽ རིང་བར་"
    },
    {
      "span": {
        "start": 16705,
        "end": 16717
      },
      "text": "ལ་སོགས་པ་ནི་ ༼སྣར། པེ།༽ ལ་སོགས་བཞི་"
    },
    {
      "span": {
        "start": 16774,
        "end": 16783
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 16826,
        "end": 16835
      },
      "text": "བརྟབ་པའི་ ༼སྣར། པེ།༽ བཀབ་པའི་"
    },
    {
      "span": {
        "start": 17001,
        "end": 17005
      },
      "text": "ཞེས་ ༼སྣར། པེ།༽ ཞེས་པ་ནི་"
    },
    {
      "span": {
        "start": 17376,
        "end": 17385
      },
      "text": "རོལ་མོའི་ ༼སྣར། པེ།༽ རོལ་མོ་"
    },
    {
      "span": {
        "start": 17626,
        "end": 17631
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 17853,
        "end": 17864
      },
      "text": "བླ་མེད་པའི། ༼སྣར། པེ།༽ བླ་ན་མེད།"
    },
    {
      "span": {
        "start": 18233,
        "end": 18237
      },
      "text": "ཅིས་ ༼སྣར། པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 18982,
        "end": 18987
      },
      "text": "ཟུང་། ༼སྣར། པེ།༽ བཟུང་།"
    },
    {
      "span": {
        "start": 19197,
        "end": 19213
      },
      "text": "དཔལ་ལྡན་རྡོ་རྗེ་ ༼སྣར། པེ།༽ དཔལ་ལྡན་རྡོར་"
    },
    {
      "span": {
        "start": 19218,
        "end": 19224
      },
      "text": "ལ་གནས། ༼སྣར། པེ།༽ ལག་ན།"
    },
    {
      "span": {
        "start": 19263,
        "end": 19273
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 19384,
        "end": 19394
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 19612,
        "end": 19621
      },
      "text": "སྨྲེ་བའི་ ༼སྣར། པེ།༽ སྨེ་བའི་"
    },
    {
      "span": {
        "start": 19649,
        "end": 19655
      },
      "text": "བྲལ་བ་ ༼སྣར། པེ།༽ ཕྲལ་བ་"
    },
    {
      "span": {
        "start": 19972,
        "end": 19979
      },
      "text": "ཞུགས་པ་ ༼པེ།༽ བཞུགས་པ་"
    },
    {
      "span": {
        "start": 19998,
        "end": 20003
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 20160,
        "end": 20168
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 20559,
        "end": 20567
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་བའི་"
    },
    {
      "span": {
        "start": 20668,
        "end": 20671
      },
      "text": "དང་ ༼སྣར། པེ།༽ ལང་"
    },
    {
      "span": {
        "start": 20840,
        "end": 20848
      },
      "text": "བྱུགས། ། ༼སྣར། པེ།༽ བྱུག །"
    },
    {
      "span": {
        "start": 20859,
        "end": 20867
      },
      "text": "སྟེང་དུ་ ༼སྣར། པེ།༽ སྟེང་ན་"
    },
    {
      "span": {
        "start": 20956,
        "end": 20966
      },
      "text": "རོལ་པ་ཡིས། ༼སྣར། པེ།༽ རོལ་པ་ཡི།"
    },
    {
      "span": {
        "start": 21587,
        "end": 21589
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 22032,
        "end": 22042
      },
      "text": "དབང་ངོ་། ། ༼སྣར། པེ།༽ དབང་།། །།"
    },
    {
      "span": {
        "start": 22392,
        "end": 22400
      },
      "text": "གདབ་པའོ། ༼སྣར། པེ།༽ གདབ་བོ།"
    },
    {
      "span": {
        "start": 22523,
        "end": 22531
      },
      "text": "སྟེང་གི་ ༼སྣར། པེ།༽ སྟེང་གིས་"
    },
    {
      "span": {
        "start": 22645,
        "end": 22651
      },
      "text": "གཟུང་། ༼སྣར། པེ།༽ བཟུང་།"
    },
    {
      "span": {
        "start": 22692,
        "end": 22699
      },
      "text": "ལྡན་པས་ ༼སྣར། པེ།༽ ལྡན་པ་"
    },
    {
      "span": {
        "start": 22797,
        "end": 22804
      },
      "text": "ཇི་ལྟར་ ༼སྣར། པེ།༽ ཇི་སྙེད་"
    },
    {
      "span": {
        "start": 22811,
        "end": 22819
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 22862,
        "end": 22866
      },
      "text": "ཡུལ་ ༼སྣར། པེ།༽ ཡུམ་"
    },
    {
      "span": {
        "start": 22881,
        "end": 22885
      },
      "text": "བལྟ། ༼སྣར། པེ།༽ ལྟ།"
    },
    {
      "span": {
        "start": 22977,
        "end": 22982
      },
      "text": "བྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 22995,
        "end": 22997
      },
      "text": "ག་ ༼སྣར། པེ།༽ གའི་"
    },
    {
      "span": {
        "start": 23270,
        "end": 23279
      },
      "text": "དང་ཁ་སྤད་ ༼སྣར། པེ།༽ དང་ཁ་སྤྲད་"
    },
    {
      "span": {
        "start": 23292,
        "end": 23303
      },
      "text": "བསྐྱོད་པའི་ ༼སྣར། པེ།༽ བསྐྱེད་པའི་"
    },
    {
      "span": {
        "start": 23475,
        "end": 23478
      },
      "text": "མེ་ ༼སྣར། པེ།༽ མེས་"
    },
    {
      "span": {
        "start": 23538,
        "end": 23547
      },
      "text": "ཆན་གཟུང་། ༼སྣར། པེ།༽ ཚད་བཟུང་།"
    },
    {
      "span": {
        "start": 23801,
        "end": 23811
      },
      "text": "དབང་ངོ་། ། ༼སྣར། པེ།༽ དབང་།། །།"
    },
    {
      "span": {
        "start": 24352,
        "end": 24359
      },
      "text": "བྱི་རུ་ ༼སྣར། པེ།༽ བྱུ་རུ་"
    },
    {
      "span": {
        "start": 24589,
        "end": 24593
      },
      "text": "བའོ། ༼སྣར། པེ།༽ ལོ།"
    },
    {
      "span": {
        "start": 24769,
        "end": 24777
      },
      "text": "དབང་གིས་ ༼སྣར། པེ།༽ དབང་གི་"
    },
    {
      "span": {
        "start": 24834,
        "end": 24839
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ ཟུང་"
    },
    {
      "span": {
        "start": 24973,
        "end": 24981
      },
      "text": "དབང་གིས་ ༼སྣར། པེ།༽ དབང་གི་"
    },
    {
      "span": {
        "start": 25041,
        "end": 25048
      },
      "text": "ལྷག་པར་ ༼སྣར།༽ རྟག་པར་ ༼པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 25449,
        "end": 25456
      },
      "text": "དེང་ནས་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 25537,
        "end": 25545
      },
      "text": "སྦྱན་དང་ ༼སྣར། པེ།༽ སྦྱན་དྲང་"
    },
    {
      "span": {
        "start": 25960,
        "end": 25965
      },
      "text": "བཀུམ་ ༼སྣར། པེ།༽ བསྐུལ་"
    },
    {
      "span": {
        "start": 26029,
        "end": 26039
      },
      "text": "སྒྲུབ་པའི་ ༼སྣར། པེ།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 26047,
        "end": 26056
      },
      "text": "བརྩམས་པར་ ༼སྣར། པེ།༽ བརྩམ་པར་"
    },
    {
      "span": {
        "start": 26114,
        "end": 26117
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 26168,
        "end": 26176
      },
      "text": "གྲུབ་པར་ ༼པེ།༽ འགྲུབ་པར་"
    },
    {
      "span": {
        "start": 26267,
        "end": 26274
      },
      "text": "དབང་གི་ ༼སྣར།༽ དབང་གིས་"
    },
    {
      "span": {
        "start": 26478,
        "end": 26486
      },
      "text": "དཔལ་ལྡན་ ༼སྣར། པེ།༽ དཔལ་"
    }
  ]
}