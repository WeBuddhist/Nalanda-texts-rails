{
  "durchens": [
    {
      "span": {
        "start": 32,
        "end": 35
      },
      "text": "ཀེ་ ༼སྣར། པེ།༽ ཀི་"
    },
    {
      "span": {
        "start": 1060,
        "end": 1065
      },
      "text": "བསམས་ ༼སྣར།༽ བསམ་"
    },
    {
      "span": {
        "start": 1090,
        "end": 1097
      },
      "text": "འཁོར་བ་ ༼པེ།༽ འཁོར་བའི་"
    },
    {
      "span": {
        "start": 1107,
        "end": 1115
      },
      "text": "གྱི་རྒྱ་ ༼སྣར།༽ གྱི་"
    },
    {
      "span": {
        "start": 1135,
        "end": 1144
      },
      "text": "སྙམ་པ་ནི་ ༼སྣར།༽ སྙམ་པ་"
    },
    {
      "span": {
        "start": 1365,
        "end": 1387
      },
      "text": "བརྒྱད་པོ་དེ་དག་ཐམས་ཅད་ ༼སྣར། པེ།༽ བརྒྱད་པོ་"
    },
    {
      "span": {
        "start": 2038,
        "end": 2044
      },
      "text": "བཅས་པ་ ༼སྣར། པེ།༽ བཅས་པ་དང་"
    },
    {
      "span": {
        "start": 2187,
        "end": 2190
      },
      "text": "མི་ ༼པེ།༽ མི་་"
    },
    {
      "span": {
        "start": 2284,
        "end": 2287
      },
      "text": "མི། ༼སྣར། པེ།༽ མི་་"
    },
    {
      "span": {
        "start": 2882,
        "end": 2890
      },
      "text": "གཏིབས་པ་ ༼སྣར། པེ།༽ བསྟིབས་པ་"
    },
    {
      "span": {
        "start": 3001,
        "end": 3012
      },
      "text": "ལས་འོད་ཟེར་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 3057,
        "end": 3063
      },
      "text": "བླ་རེ་ ༼སྣར།༽ བྲེད་ ༼པེ།༽ བླ་བྲེས་"
    },
    {
      "span": {
        "start": 3068,
        "end": 3083
      },
      "text": "འཁོར་ལོས་སྒྱུར་ ༼སྣར།༽ འཁོར་ལོ་སྒྱུར་ ༼པེ།༽ འཁོར་ལོ་བསྒྱུར་"
    },
    {
      "span": {
        "start": 3160,
        "end": 3168
      },
      "text": "ཐོག་མེད་ ༼སྣར།༽ ཐོགས་མེད་"
    },
    {
      "span": {
        "start": 3432,
        "end": 3436
      },
      "text": "ཡིས་ ༼པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 3469,
        "end": 3471
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 3920,
        "end": 3926
      },
      "text": "སྐྱོན་ ༼སྣར།༽ བསྐྱོན་"
    },
    {
      "span": {
        "start": 4018,
        "end": 4022
      },
      "text": "ས་མ་ ༼པེ།༽ ཤ་མ་"
    },
    {
      "span": {
        "start": 4124,
        "end": 4132
      },
      "text": "བདག་གིས་ ༼སྣར།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 4939,
        "end": 4947
      },
      "text": "དེ་བཞིན་ ༼སྣར།༽ དེ་བཞིན་དེ་"
    },
    {
      "span": {
        "start": 5276,
        "end": 5287
      },
      "text": "མེད་པ་སྟོན་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 5588,
        "end": 5591
      },
      "text": "ལས་ ༼སྣར།༽ ལ་"
    },
    {
      "span": {
        "start": 5616,
        "end": 5630
      },
      "text": "ཐམས་ཅད་འཕགས་པ་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 5698,
        "end": 5703
      },
      "text": "སྟོང་ ༼སྣར། པེ།༽ སྟོང་པ་"
    },
    {
      "span": {
        "start": 5778,
        "end": 5789
      },
      "text": "ཤམ་ཐབས་བྱས་ ༼སྣར།༽ ཤམ་ཐབས་"
    },
    {
      "span": {
        "start": 5909,
        "end": 5929
      },
      "text": "པ་བདུན་གྱིས་བརྒྱན་པ། ༼པེ།༽ པ་"
    },
    {
      "span": {
        "start": 6353,
        "end": 6356
      },
      "text": "དེ་ ༼སྣར།༽ དེས་"
    },
    {
      "span": {
        "start": 6455,
        "end": 6463
      },
      "text": "གཡོན་པས་ ༼སྣར། པེ།༽ གཡོན་པ་"
    },
    {
      "span": {
        "start": 6506,
        "end": 6518
      },
      "text": "འོག་མས་བགྲང་ ༼སྣར།༽ འོག་མ་བགྲངས་ ༼པེ།༽ འོག་མ་བགྲང་"
    },
    {
      "span": {
        "start": 6591,
        "end": 6598
      },
      "text": "ཡི་དགས་ ༼སྣར། པེ།༽ ཡི་དགས་ཀྱི་"
    },
    {
      "span": {
        "start": 6628,
        "end": 6639
      },
      "text": "མཆོག་སྦྱིན་ ༼སྣར། པེ།༽ མཆོག་སྦྱིན་མཛད་"
    },
    {
      "span": {
        "start": 6689,
        "end": 6695
      },
      "text": "ན་མདའ་ ༼སྣར།༽ ན་"
    },
    {
      "span": {
        "start": 6932,
        "end": 6939
      },
      "text": "མེ་ཤེལ་ ༼སྣར།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 7323,
        "end": 7331
      },
      "text": "ཁར་གསིལ་ ༼སྣར། པེ།༽ འཁར་སིལ་"
    },
    {
      "span": {
        "start": 7390,
        "end": 7395
      },
      "text": "ཁར་བ་ ༼སྣར། པེ།༽ འཁར་བ་"
    },
    {
      "span": {
        "start": 7638,
        "end": 7646
      },
      "text": "སྤྱན་རེ་ ༼སྣར།༽ སྤྱན་"
    },
    {
      "span": {
        "start": 7711,
        "end": 7720
      },
      "text": "འཕྲོས་པས་ ༼སྣར། པེ།༽ འཕྲོས་"
    },
    {
      "span": {
        "start": 7831,
        "end": 7846
      },
      "text": "རྒྱལ་པོ་ཆེན་པོ་ ༼སྣར། པེ།༽ རྒྱལ་པོ་"
    },
    {
      "span": {
        "start": 7859,
        "end": 7864
      },
      "text": "འཁོར་ ༼པེ།༽ གཡོག་"
    },
    {
      "span": {
        "start": 8107,
        "end": 8117
      },
      "text": "བཅིང་བ་དང་ ༼སྣར། པེ།༽ བཅིངས་པས་"
    },
    {
      "span": {
        "start": 8151,
        "end": 8172
      },
      "text": "པདྨ་ཁ་ཕྱེ་བའི་ཚུལ་དུ་ ༼སྣར།༽ ཁ་ཕྱེ་བའི་"
    },
    {
      "span": {
        "start": 8274,
        "end": 8282
      },
      "text": "འོད་ཟེར་ ༼སྣར།༽ འོད་"
    },
    {
      "span": {
        "start": 8379,
        "end": 8384
      },
      "text": "སྩོལ་ ༼སྣར། པེ།༽ གསོལ་"
    },
    {
      "span": {
        "start": 8646,
        "end": 8650
      },
      "text": "སརྦ་ ༼སྣར།༽ སརྦྦ་"
    },
    {
      "span": {
        "start": 8742,
        "end": 8746
      },
      "text": "གསལ། ༼སྣར། པེ།༽ བསམ།"
    },
    {
      "span": {
        "start": 8813,
        "end": 8818
      },
      "text": "སརྦྦ་ ༼པེ།༽ སརྦ་"
    },
    {
      "span": {
        "start": 9108,
        "end": 9110
      },
      "text": "ཀ་ ༼པེ།༽ ཀཱ་"
    },
    {
      "span": {
        "start": 9147,
        "end": 9159
      },
      "text": "སརྦྦེ་ཏྱུ་པ་ ༼སྣར།༽ སརྦྦེ་ཏྱུ་བ་ ༼པེ།༽ སརྦ་ཏོ་བ་"
    },
    {
      "span": {
        "start": 9180,
        "end": 9185
      },
      "text": "སརྦྦ་ ༼པེ།༽ སརྦ་"
    },
    {
      "span": {
        "start": 9296,
        "end": 9301
      },
      "text": "སརྦྦ་ ༼པེ།༽ སརྦ་"
    },
    {
      "span": {
        "start": 9382,
        "end": 9394
      },
      "text": "ལོ་ཀེ །ལོ་ཀ་ ༼སྣར།༽ ལོ་ཀི་ལོ་ཀ་ ༼པེ།༽ ལོ་ཀི་"
    },
    {
      "span": {
        "start": 9438,
        "end": 9448
      },
      "text": "ཨེ་ཧྱེ་ཧི། ༼པེ།༽ ཧཱེུ་ཧཱ་རེ།"
    },
    {
      "span": {
        "start": 9476,
        "end": 9480
      },
      "text": "སཏྭ། ༼སྣར།༽ སཏྭཱ།"
    },
    {
      "span": {
        "start": 9481,
        "end": 9486
      },
      "text": "ཧེ་མ་ ༼སྣར།༽ ཧེ་མ་ཧཱ་བོ་དྷི་སཏྭཱ་ཧེ་མ་"
    },
    {
      "span": {
        "start": 9496,
        "end": 9500
      },
      "text": "སཏྭ། ༼སྣར།༽ སཏཱ།"
    },
    {
      "span": {
        "start": 9511,
        "end": 9514
      },
      "text": "པོ་ ༼སྣར། པེ།༽ བོ་"
    },
    {
      "span": {
        "start": 9554,
        "end": 9556
      },
      "text": "ཡ། ༼སྣར། པེ།༽ ཡཾ།"
    },
    {
      "span": {
        "start": 9557,
        "end": 9567
      },
      "text": "ཨེ་ཧྱེ་ཧི། ༼པེ།༽ ཧཱི་ཧཱི་ཧཱ་རེ།"
    },
    {
      "span": {
        "start": 9638,
        "end": 9642
      },
      "text": "ཀརྨ། ༼པེ།༽ ཀརྨ་སཱ་དྷ་ཡ།"
    },
    {
      "span": {
        "start": 9668,
        "end": 9676
      },
      "text": "ཧི་མེ་ཝ་ ༼སྣར།༽ ཧི། མེ་ཨ་ ༼པེ།༽ ཧི་བེ་བ་"
    },
    {
      "span": {
        "start": 9830,
        "end": 9833
      },
      "text": "ཀི་ ༼སྣར།༽ ཤི་"
    },
    {
      "span": {
        "start": 9904,
        "end": 9906
      },
      "text": "བ་ ༼པེ།༽ བ།"
    },
    {
      "span": {
        "start": 9982,
        "end": 9987
      },
      "text": "ཧཱ་མ་ ༼པེ།༽ ཧཱ་མཱ་"
    },
    {
      "span": {
        "start": 10086,
        "end": 10091
      },
      "text": "སརྦྦ་ ༼པེ།༽ སརྦ་"
    },
    {
      "span": {
        "start": 10137,
        "end": 10148
      },
      "text": "ཏྲི་པུ་ར་ད་ ༼སྣར།༽ ཏྲི་བུ་རད་ ༼པེ།༽ ཏྲི་བུ་ར་ད་"
    },
    {
      "span": {
        "start": 10150,
        "end": 10153
      },
      "text": "ནེ་ ༼པེ།༽ ན་"
    },
    {
      "span": {
        "start": 10216,
        "end": 10220
      },
      "text": "ཧ་ལ་ ༼སྣར།༽ ཧཱ་ལ་ ༼པེ།༽ ཧ་ལ།"
    },
    {
      "span": {
        "start": 10242,
        "end": 10245
      },
      "text": "སྱ་ ༼པེ།༽ ཙ་"
    },
    {
      "span": {
        "start": 10248,
        "end": 10250
      },
      "text": "བ་ ༼སྣར། པེ།༽ ག་"
    },
    {
      "span": {
        "start": 10264,
        "end": 10268
      },
      "text": "དྭེ་ ༼པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 10280,
        "end": 10282
      },
      "text": "ན། ༼སྣར། པེ།༽ ནཾ།"
    },
    {
      "span": {
        "start": 10353,
        "end": 10360
      },
      "text": "ས་ར་སར། ༼སྣར། པེ།༽ ས་ར་ས་ར།"
    },
    {
      "span": {
        "start": 10667,
        "end": 10669
      },
      "text": "ཏ། ༼སྣར།༽ ཏཱ ༼པེ།༽ ཏཾ།"
    },
    {
      "span": {
        "start": 10690,
        "end": 10692
      },
      "text": "ཀ་ ༼པེ།༽ ཀཱ་"
    },
    {
      "span": {
        "start": 10796,
        "end": 10799
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ནཱི་"
    },
    {
      "span": {
        "start": 11214,
        "end": 11221
      },
      "text": "ནི་བ་ས་ ༼སྣར།༽ ནི་བས་"
    },
    {
      "span": {
        "start": 11351,
        "end": 11354
      },
      "text": "བོ་ ༼སྣར། པེ།༽ བྷོ་"
    },
    {
      "span": {
        "start": 11364,
        "end": 11368
      },
      "text": "ཡ།མ་ ༼སྣར།༽ ཡ་མ་"
    },
    {
      "span": {
        "start": 11456,
        "end": 11460
      },
      "text": "མ་ཨ་ ༼པེ།༽ ཡ་ཨཱ་"
    },
    {
      "span": {
        "start": 11843,
        "end": 11849
      },
      "text": "ལྔ་དང་ ༼སྣར།༽ ལྔ་"
    },
    {
      "span": {
        "start": 11862,
        "end": 11867
      },
      "text": "དཀོར་ ༼པེ།༽ སྐོར་"
    },
    {
      "span": {
        "start": 12066,
        "end": 12070
      },
      "text": "སུས་ ༼སྣར།༽ སུམ་"
    },
    {
      "span": {
        "start": 12203,
        "end": 12212
      },
      "text": "རྒྱུན་མི་ ༼སྣར།༽ རྒྱུན་མ་"
    },
    {
      "span": {
        "start": 12219,
        "end": 12224
      },
      "text": "བཟུང་ ༼པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 12361,
        "end": 12369
      },
      "text": "ཆོས་ཀྱི་ ༼པེ།༽ ཆོས་ཀྱིས་"
    },
    {
      "span": {
        "start": 12431,
        "end": 12435
      },
      "text": "བཅད་ ༼སྣར། པེ།༽ གཅད་"
    },
    {
      "span": {
        "start": 12999,
        "end": 13006
      },
      "text": "བྱུང་བ་ ༼པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 13214,
        "end": 13218
      },
      "text": "གཞག་ ༼པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 13362,
        "end": 13373
      },
      "text": "བྱས་ནས་རིས་ ༼སྣར།༽ བྱས་ནས་"
    },
    {
      "span": {
        "start": 13427,
        "end": 13433
      },
      "text": "འགྱུར། ༼པེ།༽ འགྱུར་རོ། །"
    },
    {
      "span": {
        "start": 13451,
        "end": 13460
      },
      "text": "འགྱུར་རོ། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 13495,
        "end": 13501
      },
      "text": "བྱས་བ་ ༼སྣར།༽ བྱས་པས་"
    },
    {
      "span": {
        "start": 13509,
        "end": 13516
      },
      "text": "ལེགས་པ་ ༼སྣར། པེ།༽ ལེགས་པར་"
    },
    {
      "span": {
        "start": 13580,
        "end": 13590
      },
      "text": "བསྐྱེད་པར་ ༼པེ།༽ སྐྱེད་པར་"
    },
    {
      "span": {
        "start": 13882,
        "end": 13888
      },
      "text": "བསྐོལ་ ༼པེ།༽ སྐོལ་"
    },
    {
      "span": {
        "start": 14030,
        "end": 14037
      },
      "text": "ལོང་བར་ ༼སྣར།༽ འོང་བར་"
    },
    {
      "span": {
        "start": 14186,
        "end": 14191
      },
      "text": "བཏགས་ ༼སྣར། པེ།༽ གདགས་"
    },
    {
      "span": {
        "start": 14340,
        "end": 14347
      },
      "text": "གིས་མི་ ༼སྣར། པེ།༽ གིས་མ་"
    },
    {
      "span": {
        "start": 14520,
        "end": 14536
      },
      "text": "སྦྲང་རྩི་དཀར་པོ་ ༼སྣར། པེ།༽ སྦྲང་རྩི་"
    },
    {
      "span": {
        "start": 14663,
        "end": 14671
      },
      "text": "གདོན་ནས་ ༼སྣར། པེ།༽ གདོན་ནམ་"
    },
    {
      "span": {
        "start": 14788,
        "end": 14795
      },
      "text": "རྟུག་པ་ ༼སྣར། པེ།༽ སྟུག་པ་"
    },
    {
      "span": {
        "start": 14985,
        "end": 14990
      },
      "text": "བཏགས་ ༼སྣར།༽ གཏགས་"
    },
    {
      "span": {
        "start": 15026,
        "end": 15038
      },
      "text": "དཀར་པོའི་གི་ ༼སྣར།༽ དཀར་པོའི་གིའུ་ ༼པེ།༽ དཀར་པོའི་གྷི་"
    },
    {
      "span": {
        "start": 15126,
        "end": 15142
      },
      "text": "རྣམས་ལ་བསྐུས་ཏེ་ ༼སྣར།༽ རྣམས་བསྐུས་"
    },
    {
      "span": {
        "start": 15433,
        "end": 15450
      },
      "text": "ནོར་བུ་རིན་པོ་ཆེ་ ༼སྣར། པེ།༽ ནོར་བུ་"
    },
    {
      "span": {
        "start": 15776,
        "end": 15783
      },
      "text": "ཕས་ཀྱི་ ༼སྣར།༽ ཕས་ཀྱིས་"
    },
    {
      "span": {
        "start": 15788,
        "end": 15792
      },
      "text": "བའི་ ༼སྣར།༽ བར་"
    },
    {
      "span": {
        "start": 16496,
        "end": 16504
      },
      "text": "གཅན་གཟན་ ༼སྣར། པེ།༽ གཅན་ཟན་"
    },
    {
      "span": {
        "start": 16601,
        "end": 16604
      },
      "text": "ལས་ ༼སྣར།༽ ལ་"
    },
    {
      "span": {
        "start": 16819,
        "end": 16825
      },
      "text": "དག་པར་ ༼པེ།༽ དག་པར་སྐྱེ་བར་"
    },
    {
      "span": {
        "start": 17035,
        "end": 17044
      },
      "text": "སའི་གཏེར་ ༼སྣར། པེ།༽ ས་གཏེར་"
    },
    {
      "span": {
        "start": 17128,
        "end": 17138
      },
      "text": "བསྒྲུབ་པར་ ༼པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 17336,
        "end": 17343
      },
      "text": "བསལ་བར་ ༼པེ།༽ གསལ་བར་"
    },
    {
      "span": {
        "start": 17485,
        "end": 17493
      },
      "text": "འཁོལ་བར་ ༼སྣར། པེ།༽ འཁོར་བར་"
    },
    {
      "span": {
        "start": 17508,
        "end": 17513
      },
      "text": "ཁར་བ་ ༼པེ།༽ འཁར་བ་"
    },
    {
      "span": {
        "start": 17672,
        "end": 17681
      },
      "text": "འགྲུབ་པར་ ༼པེ།༽ གྲུབ་པར་"
    },
    {
      "span": {
        "start": 17930,
        "end": 17935
      },
      "text": "བྱམས་ ༼སྣར། པེ།༽ བྱམས་པ་"
    },
    {
      "span": {
        "start": 17983,
        "end": 17988
      },
      "text": "གསིལ་ ༼པེ།༽ བསིལ་"
    },
    {
      "span": {
        "start": 18047,
        "end": 18055
      },
      "text": "གུས་པའི་ ༼སྣར། པེ།༽ གུས་པར་"
    },
    {
      "span": {
        "start": 18176,
        "end": 18184
      },
      "text": "འབྲལ་བར་ ༼སྣར། པེ།༽ བྲལ་བར་"
    },
    {
      "span": {
        "start": 18258,
        "end": 18261
      },
      "text": "དུ་ ༼སྣར།༽ དུ་རྟག་ཏུ་"
    },
    {
      "span": {
        "start": 18527,
        "end": 18531
      },
      "text": "ཐུག་ ༼སྣར།༽ ཐུགས་"
    },
    {
      "span": {
        "start": 18665,
        "end": 18676
      },
      "text": "ལ་སོགས་པའི་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 18844,
        "end": 18854
      },
      "text": "སྤྱི་བོ་ན་ ༼སྣར།༽ སྤྱི་བོ་ནས་"
    },
    {
      "span": {
        "start": 19247,
        "end": 19265
      },
      "text": "གཉིས་མཛུབ་མོ་གཉིས་ ༼སྣར།༽ གཉིས་"
    },
    {
      "span": {
        "start": 19577,
        "end": 19593
      },
      "text": "ཀྱིས་མཐོ་བཙམས་པ་ ༼སྣར།༽ ཀྱི་མཐུས་བརྩམས་པས་ ༼པེ།༽ ཀྱི་མཐུས་བརྩམས་པ་"
    },
    {
      "span": {
        "start": 19884,
        "end": 19892
      },
      "text": "གཙང་ཞིང་ ༼པེ།༽ གཅད་ཅིང་"
    },
    {
      "span": {
        "start": 20224,
        "end": 20227
      },
      "text": "པོ། ༼སྣར།༽ སོ། །"
    },
    {
      "span": {
        "start": 20286,
        "end": 20295
      },
      "text": "དེ་དག་གི་ ༼སྣར།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 20328,
        "end": 20334
      },
      "text": "བྲིའོ། ༼སྣར།༽ དྲིའོ།"
    },
    {
      "span": {
        "start": 20421,
        "end": 20429
      },
      "text": "མདུན་དུ་ ༼སྣར།༽ མདུན་"
    },
    {
      "span": {
        "start": 20472,
        "end": 20483
      },
      "text": "གཟུགས་སྔགས་ ༼སྣར། པེ།༽ གཟུངས་སྔགས་"
    },
    {
      "span": {
        "start": 20827,
        "end": 20835
      },
      "text": "དབང་ངོ་། ༼སྣར། པེ།༽ དབབ་པོ།"
    },
    {
      "span": {
        "start": 20863,
        "end": 20870
      },
      "text": "མི་འཆད་ ༼པེ།༽ མ་ཆད་"
    },
    {
      "span": {
        "start": 20926,
        "end": 20939
      },
      "text": "སྣ་ཚོགས་ཀྱིས་ ༼སྣར།༽ སྣ་ཚོགས་ཀྱི་"
    },
    {
      "span": {
        "start": 21060,
        "end": 21070
      },
      "text": "སྟོང་བརྒྱ་ ༼པེ།༽ སྟོང་"
    },
    {
      "span": {
        "start": 21268,
        "end": 21275
      },
      "text": "མཆོད་ལ་ ༼སྣར།༽ མཆོད་"
    },
    {
      "span": {
        "start": 21396,
        "end": 21399
      },
      "text": "ཡང་ ༼པེ།༽ ཡང་ནི་"
    },
    {
      "span": {
        "start": 21520,
        "end": 21523
      },
      "text": "ནི་ ༼སྣར།༽ ནི་ཅི་"
    },
    {
      "span": {
        "start": 21831,
        "end": 21844
      },
      "text": "བདག་ཉིད་ཀྱིས་ ༼སྣར།༽ བདག་ཉིད་"
    },
    {
      "span": {
        "start": 22010,
        "end": 22014
      },
      "text": "གྲུ་ ༼སྣར།༽ གྲུབ་ ༼པེ།༽ གྲྭ་"
    },
    {
      "span": {
        "start": 22083,
        "end": 22089
      },
      "text": "བསམ་པ་ ༼སྣར། པེ།༽ བསམས་པ་"
    },
    {
      "span": {
        "start": 22253,
        "end": 22259
      },
      "text": "བགྱིས་ ༼སྣར། པེ།༽ བགྱིད་"
    },
    {
      "span": {
        "start": 22474,
        "end": 22477
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 22532,
        "end": 22537
      },
      "text": "ལག་པ་ ༼སྣར།༽ ལག་"
    },
    {
      "span": {
        "start": 22555,
        "end": 22565
      },
      "text": "སྒྱུར་བའི་ ༼པེ།༽ བསྒྱུར་བའི་"
    },
    {
      "span": {
        "start": 23139,
        "end": 23146
      },
      "text": "བརླབ་པ་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 23239,
        "end": 23244
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 23694,
        "end": 23703
      },
      "text": "དྲན་ན་ནི། ༼སྣར། པེ།༽ དྲན་པ་ཡིས།"
    },
    {
      "span": {
        "start": 23785,
        "end": 23792
      },
      "text": "ཀུན་ནས་ ༼པེ།༽ ཀུན་ལས་"
    },
    {
      "span": {
        "start": 23917,
        "end": 23923
      },
      "text": "དྲན་ན་ ༼སྣར། པེ།༽ དྲན་ནས་"
    },
    {
      "span": {
        "start": 24020,
        "end": 24026
      },
      "text": "དྲན་ན་ ༼སྣར། པེ།༽ དྲན་ནས་"
    },
    {
      "span": {
        "start": 24217,
        "end": 24223
      },
      "text": "ཡི་ནི་ ༼པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 24226,
        "end": 24229
      },
      "text": "དག་ ༼སྣར།༽ དྭགས་"
    },
    {
      "span": {
        "start": 24235,
        "end": 24239
      },
      "text": "བསད་ ༼སྣར། པེ།༽ ། གསད་"
    },
    {
      "span": {
        "start": 24398,
        "end": 24401
      },
      "text": "རབ་ ༼སྣར། པེ།༽ ཀུན་"
    },
    {
      "span": {
        "start": 24653,
        "end": 24657
      },
      "text": "རིག་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 25065,
        "end": 25069
      },
      "text": "ཤོག་ ༼པེ།༽ མཛོད།། །།"
    },
    {
      "span": {
        "start": 25137,
        "end": 25147
      },
      "text": "ཐུགས་རྗེར་ ༼སྣར།༽ ཐུགས་རྗེ་"
    },
    {
      "span": {
        "start": 25312,
        "end": 25322
      },
      "text": "བྱིན་གྱིས་ ༼སྣར།༽ བྱིན་"
    },
    {
      "span": {
        "start": 25360,
        "end": 25370
      },
      "text": "གསུངས་པ་ལ་ ༼པེ།༽ གསུངས་པ་"
    },
    {
      "span": {
        "start": 25477,
        "end": 25484
      },
      "text": "དཔག་ཏུ་ ༼པེ།༽ དཔག་"
    },
    {
      "span": {
        "start": 25792,
        "end": 25805
      },
      "text": "བསྒྱུར་བའོ། ། ༼པེ།༽ བབསྒྱུར་བའོ་ཨ་ཏི་ཤ་སྐྱེས་བུ་ཆེན་པོས་ལྷ་བཙུན་པ་བྱང་ཆུབ་འོད་ཟེར་འབྲོམ་སྟོན་པ་དང་རྣལ་འབྱོར་པ་ཤེས་རབ་རྡོ་རྗེ། སུམ་ལ་གསུངས་པའོ། །འབྲོམ་སྟོན་པས་ཀྱང་རིན་པོ་ཆེ་དང་། དེས་བྱ་ཡུལ་བ་ལ་གསུངས། འཛམ་བུ་གླིང་གི་སྒྲུབ་ཐབས་གཅིག་ལ་འདི་ཟབ་གསུང་ངོ་། །ཇོ་བོས་བོད་དུ་ལོ་བཅུ་བཞི་བཞུགས་ཏེ། བདུན་ཅུ་རྩ་བདུན་ལ་འདས་སོ། །སྟོན་པས་ལོ་བཅུ་གསུམ་བསྟེན། རྣལ་འབྱོར་པ་དང་དགོན་པ་པ་གཉིས་ཀྱིས་དགུ །རྣལ་འབྱོར་པ་ཤེས་རབ་རྡོ་རྗེ་དང་། ཕྱག་པ་ཁྲི་མཆོག་ཕྱག་དར་སྟོན་པ་གསུམ་གྱིས་ལོ་ལྔ་ལྔའོ། །དགེ་ཤེས་གསང་ཕུ་བས་ལོ་བཅུ་བསྟེན་ནོ།། །།"
    }
  ]
}