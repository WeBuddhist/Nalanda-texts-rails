{
  "durchens": [
    {
      "span": {
        "start": 120,
        "end": 122
      },
      "text": "བ། ༼སྣར། པེ།༽ བ། དཔལ་"
    },
    {
      "span": {
        "start": 467,
        "end": 471
      },
      "text": "བསམ་ ༼སྣར།༽ བསམས་"
    },
    {
      "span": {
        "start": 588,
        "end": 597
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 867,
        "end": 882
      },
      "text": "གླང་ཆེན་སྟག་གི་ ༼སྣར། པེ།༽ གླང་ཆེན་"
    },
    {
      "span": {
        "start": 1091,
        "end": 1099
      },
      "text": "བཅུ་ཡིས་ ༼སྣར། པེ།༽ བཅུ་ཡིག་"
    },
    {
      "span": {
        "start": 1192,
        "end": 1197
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 1207,
        "end": 1215
      },
      "text": "སྦུ་གུས་ ༼སྣར། པེ།༽ བུ་གུས་"
    },
    {
      "span": {
        "start": 1312,
        "end": 1318
      },
      "text": "དགའ་བ་ ༼སྣར།༽ དགའི་བ་"
    },
    {
      "span": {
        "start": 1562,
        "end": 1579
      },
      "text": "ལྟ་བུར་རྡོ་རྗེའི་ ༼སྣར། པེ།༽ ལྟ་བུར་"
    },
    {
      "span": {
        "start": 2022,
        "end": 2043
      },
      "text": "གཤིན་རྗེ་གཤེད་རྣམ་པར་ ༼སྣར།༽ གཤིན་རྗེ་གཤེདནག་པོར་"
    }
  ]
}