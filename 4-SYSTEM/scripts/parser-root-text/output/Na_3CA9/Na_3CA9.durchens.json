{
  "durchens": [
    {
      "span": {
        "start": 179,
        "end": 190
      },
      "text": "ཐུགས་རྗེའི་ ༼སྣར། པེ།༽ ཐུགས་རྗེ་"
    },
    {
      "span": {
        "start": 298,
        "end": 309
      },
      "text": "དྲག་པོ་ཡིས། ༼སྣར།༽ དྲག་པོ་ཡི།"
    },
    {
      "span": {
        "start": 404,
        "end": 409
      },
      "text": "བྱེད་ ༼སྣར།༽ བྱ་"
    },
    {
      "span": {
        "start": 456,
        "end": 462
      },
      "text": "གནས་པ། ༼པེ།༽ གནས་པས།"
    },
    {
      "span": {
        "start": 539,
        "end": 546
      },
      "text": "བརླབ་པ་ ༼སྣར།༽ བརླབས་པ་"
    },
    {
      "span": {
        "start": 646,
        "end": 652
      },
      "text": "འདག་པ་ ༼སྣར།༽ འདགས་པ་ ༼པེ།༽ མདག་པ་"
    },
    {
      "span": {
        "start": 746,
        "end": 753
      },
      "text": "བཟོ་བོ་ ༼པེ།༽ གཟོ་བོ་"
    },
    {
      "span": {
        "start": 768,
        "end": 772
      },
      "text": "འདྲ་ ༼པེ།༽ འདྲར་"
    },
    {
      "span": {
        "start": 800,
        "end": 810
      },
      "text": "རྒྱ་ཤོག་ལ། ༼སྣར།༽ རྒྱ་ཤོག།"
    },
    {
      "span": {
        "start": 836,
        "end": 838
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལས།"
    },
    {
      "span": {
        "start": 939,
        "end": 946
      },
      "text": "གཞུག་པ་ ༼པེ།༽ བཞུག་པ་"
    },
    {
      "span": {
        "start": 955,
        "end": 960
      },
      "text": "གདུང་ ༼པེ།༽ གསུང་"
    },
    {
      "span": {
        "start": 965,
        "end": 970
      },
      "text": "རླབས་ ༼སྣར།༽ བརླབ་"
    },
    {
      "span": {
        "start": 978,
        "end": 984
      },
      "text": "གཞུག ། ༼པེ།༽ བཞུག། །"
    },
    {
      "span": {
        "start": 1383,
        "end": 1390
      },
      "text": "བསྲེགས་ ༼པེ།༽ སྲེགས་"
    },
    {
      "span": {
        "start": 1594,
        "end": 1600
      },
      "text": "བསྲེག་ ༼ཅོ། པེ།༽ བསྲེགས་"
    },
    {
      "span": {
        "start": 1754,
        "end": 1781
      },
      "text": "།བླ་མ་ལྷར་བསམ་ཡིད་སྡིག་དག ། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 1854,
        "end": 1862
      },
      "text": "ཆོས་སྐུ་ ༼པེ།༽ ཆོས་སྐུར་"
    },
    {
      "span": {
        "start": 1866,
        "end": 1872
      },
      "text": "ལྡན་ན། ༼སྣར།༽ ལྡན་པ།"
    },
    {
      "span": {
        "start": 1953,
        "end": 1957
      },
      "text": "དུག་ ༼སྣར།༽ བདུག་"
    },
    {
      "span": {
        "start": 1960,
        "end": 2029
      },
      "text": "མཚུངས། །དེ་བས་གསང་སྔགས་ལེགས་པར་སྦ། །སྣོད་ལྡན་རྣམས་ཀྱིས་འགྲུབ་པར་ཤོག ། ༼པེ།༽ མཚུངས། །།།། །།"
    }
  ]
}