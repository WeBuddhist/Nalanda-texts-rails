{
  "durchens": [
    {
      "span": {
        "start": 157,
        "end": 163
      },
      "text": "གཅད་པ་ ༼སྣར། པེ།༽ བཅད་པ་"
    },
    {
      "span": {
        "start": 234,
        "end": 241
      },
      "text": "ཅན་གྱི་ ༼སྣར། པེ།༽ ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 282,
        "end": 292
      },
      "text": "རྫོགས་པའི་ ༼སྣར། པེ།༽ རྫོགས་"
    },
    {
      "span": {
        "start": 544,
        "end": 550
      },
      "text": "སྟོངས་ ༼སྣར།༽ སྟོང་"
    },
    {
      "span": {
        "start": 595,
        "end": 601
      },
      "text": "ལྡན་པ་ ༼སྣར། པེ།༽ ལྡན་པ་ལ་"
    },
    {
      "span": {
        "start": 636,
        "end": 649
      },
      "text": "མཐར་གྱིས་གནས་ ༼སྣར། པེ།༽ མཐར་གྱིས་"
    },
    {
      "span": {
        "start": 684,
        "end": 692
      },
      "text": "གཅད་པའི་ ༼སྣར། པེ།༽ བཅད་པའི་"
    },
    {
      "span": {
        "start": 707,
        "end": 711
      },
      "text": "བཀལ་ ༼སྣར། པེ།༽ བསྐལ་"
    },
    {
      "span": {
        "start": 802,
        "end": 806
      },
      "text": "རིམ་ ༼སྣར། པེ།༽ རིམས་"
    },
    {
      "span": {
        "start": 900,
        "end": 904
      },
      "text": "རིམ་ ༼སྣར། པེ།༽ རིམས་"
    },
    {
      "span": {
        "start": 1028,
        "end": 1040
      },
      "text": "བསམ་གཏན་གྱི་ ༼སྣར། པེ།༽ བསམ་གཏན་གྱིས་"
    },
    {
      "span": {
        "start": 1307,
        "end": 1312
      },
      "text": "སུ་ལ་ ༼སྣར། པེ།༽ སུ་"
    },
    {
      "span": {
        "start": 1880,
        "end": 1886
      },
      "text": "གཅད་པ་ ༼སྣར། པེ།༽ བཅད་པ་"
    },
    {
      "span": {
        "start": 2250,
        "end": 2265
      },
      "text": "རྣལ་འབྱོར་བྱེད་ ༼སྣར། པེ།༽ རྣལ་འབྱོར་"
    },
    {
      "span": {
        "start": 2324,
        "end": 2326
      },
      "text": "ན། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 2373,
        "end": 2382
      },
      "text": "མགོ་མཇུག་ ༼སྣར། པེ།༽ མགོ་གཞུག་"
    },
    {
      "span": {
        "start": 2385,
        "end": 2394
      },
      "text": "བསྐུ་མཉེ་ ༼སྣར། པེ།༽ སྐུ་མཉེ་"
    },
    {
      "span": {
        "start": 3155,
        "end": 3161
      },
      "text": "ཚུལ་ལ་ ༼སྣར། པེ།༽ ཚུལ་"
    },
    {
      "span": {
        "start": 3224,
        "end": 3232
      },
      "text": "སོགས་པས་ ༼སྣར། པེ།༽ ལོག་པས་"
    },
    {
      "span": {
        "start": 3590,
        "end": 3594
      },
      "text": "སྣང་ ༼སྣར། པེ།༽ སྣང་བ་"
    },
    {
      "span": {
        "start": 3630,
        "end": 3637
      },
      "text": "མེད་དོ། ༼སྣར། པེ།༽ མེད་པའོ།"
    },
    {
      "span": {
        "start": 3914,
        "end": 3923
      },
      "text": "ངོས་གཟུང་ ༼སྣར། པེ།༽ ངོས་བཟུང་"
    },
    {
      "span": {
        "start": 4089,
        "end": 4095
      },
      "text": "རྐྱེན་ ༼སྣར། པེ།༽ སྐྱོན་"
    },
    {
      "span": {
        "start": 4431,
        "end": 4437
      },
      "text": "སྐྱོན་ ༼སྣར། པེ།༽ རྐྱེན་"
    },
    {
      "span": {
        "start": 4442,
        "end": 4448
      },
      "text": "འཇོམས། ༼སྣར། པེ།༽ འཇོམ།"
    },
    {
      "span": {
        "start": 4482,
        "end": 4493
      },
      "text": "སྣ་ཚོགས་སུ་ ༼སྣར། པེ།༽ སྣ་ཚོགས་"
    },
    {
      "span": {
        "start": 4515,
        "end": 4524
      },
      "text": "བཙལ་བ་ནི། ༼སྣར། པེ།༽ བཙལ།"
    },
    {
      "span": {
        "start": 4535,
        "end": 4558
      },
      "text": "བཙལ་བ་དང་ནང་སེམས་ལ་བཙལ་ ༼སྣར། པེ།༽ བཙལ་"
    },
    {
      "span": {
        "start": 4638,
        "end": 4645
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 4760,
        "end": 4765
      },
      "text": "མཇུག་ ༼སྣར། པེ།༽ འཇུག་"
    },
    {
      "span": {
        "start": 5046,
        "end": 5056
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ སྒོམ་པའི་"
    },
    {
      "span": {
        "start": 5276,
        "end": 5281
      },
      "text": "སྤོས་ ༼སྣར། པེ།༽ སྤོངས་"
    },
    {
      "span": {
        "start": 5285,
        "end": 5299
      },
      "text": "སྣང་གྲགས་ཀྱིས་ ༼སྣར། པེ།༽ སྣང་གྲགས་ཀྱི་"
    },
    {
      "span": {
        "start": 5367,
        "end": 5372
      },
      "text": "གཏང་། ༼སྣར། པེ།༽ བཏང་།"
    },
    {
      "span": {
        "start": 5386,
        "end": 5395
      },
      "text": "ངོས་གཟུང་ ༼སྣར། པེ།༽ ངོས་བཟུང་"
    },
    {
      "span": {
        "start": 5461,
        "end": 5467
      },
      "text": "རྩི་བ་ ༼སྣར། པེ།༽ བརྩི་བ་"
    },
    {
      "span": {
        "start": 5791,
        "end": 5800
      },
      "text": "ངོས་གཟུང་ ༼སྣར། པེ།༽ ངོས་བཟུང་"
    },
    {
      "span": {
        "start": 5967,
        "end": 5980
      },
      "text": "རྣལ་འབྱོར་དུ་ ༼སྣར། པེ།༽ རྣལ་འབྱོར་དུ་མ་"
    },
    {
      "span": {
        "start": 6090,
        "end": 6094
      },
      "text": "གསལ་ ༼པེ།༽ གསལ་ལ་"
    },
    {
      "span": {
        "start": 6335,
        "end": 6346
      },
      "text": "དམིགས་པ་ནི་ ༼སྣར། པེ།༽ དམིགས་པ་"
    },
    {
      "span": {
        "start": 6404,
        "end": 6411
      },
      "text": "ལྟ་བའི་ ༼སྣར། པེ།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 6721,
        "end": 6730
      },
      "text": "མཐར་གྱིས་ ༼སྣར། པེ།༽ མཐར་གྱི་"
    },
    {
      "span": {
        "start": 6741,
        "end": 6748
      },
      "text": "ངེས་བར་ ༼སྣར། པེ།༽ ངེས་པར་"
    },
    {
      "span": {
        "start": 7051,
        "end": 7057
      },
      "text": "ལྡང་བ་ ༼སྣར། པེ།༽ སྡང་བ་"
    },
    {
      "span": {
        "start": 7183,
        "end": 7187
      },
      "text": "ལུས་ ༼སྣར།༽ ཡུལ་"
    },
    {
      "span": {
        "start": 7220,
        "end": 7231
      },
      "text": "ཆེན་པོ་དཔལ་ ༼སྣར། པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 7285,
        "end": 7294
      },
      "text": "བསྡེབས་པ་ ༼སྣར། པེ།༽ སྡེབས་པ་"
    }
  ]
}