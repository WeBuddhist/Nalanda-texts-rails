{
  "durchens": [
    {
      "span": {
        "start": 184,
        "end": 191
      },
      "text": "བསྒོམས་ ༼སྣར། པེ།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 513,
        "end": 517
      },
      "text": "བལྟ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 916,
        "end": 924
      },
      "text": "གཏོར་མས་ ༼སྣར། པེ།༽ གཏོར་མ་"
    },
    {
      "span": {
        "start": 1093,
        "end": 1096
      },
      "text": "ཀུ་ ༼སྣར། པེ།༽ ཨུ་"
    },
    {
      "span": {
        "start": 1112,
        "end": 1116
      },
      "text": "ཀི ། ༼སྣར། པེ།༽ ཏི། །"
    },
    {
      "span": {
        "start": 1285,
        "end": 1294
      },
      "text": "རིགས་ལྡན་ ༼སྣར། པེ།༽ རིག་ལྡན་"
    },
    {
      "span": {
        "start": 1366,
        "end": 1376
      },
      "text": "ཉེ་དགའ་བོ། ༼སྣར། པེ།༽ ཉེ་དགའོ།"
    },
    {
      "span": {
        "start": 1707,
        "end": 1713
      },
      "text": "སྣོམས་ ༼སྣར། པེ།༽ བསྣོམས་"
    },
    {
      "span": {
        "start": 1854,
        "end": 1866
      },
      "text": "བདག་པས་གཅེས་ ༼སྣར། པེ།༽ བདག་པས་ཅེས་"
    },
    {
      "span": {
        "start": 1979,
        "end": 1990
      },
      "text": "སྐྱེས་པ་ཡི། ༼སྣར། པེ།༽ སྐྱེས་པ་ཡིས།"
    },
    {
      "span": {
        "start": 2054,
        "end": 2060
      },
      "text": "ཕ་འབབ་ ༼སྣར། པེ།༽ ཕམ་ཕབས་"
    },
    {
      "span": {
        "start": 2064,
        "end": 2070
      },
      "text": "སྣོམས་ ༼སྣར། པེ།༽ བསྣོམས་"
    },
    {
      "span": {
        "start": 2083,
        "end": 2086
      },
      "text": "རང་ ༼སྣར། པེ།༽ རེའི་"
    },
    {
      "span": {
        "start": 2119,
        "end": 2124
      },
      "text": "གཏང་། ༼སྣར། པེ།༽ བཏང་།"
    }
  ]
}