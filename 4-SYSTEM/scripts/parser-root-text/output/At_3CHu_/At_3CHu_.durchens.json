{
  "durchens": [
    {
      "span": {
        "start": 179,
        "end": 187
      },
      "text": "བདེ་བ་ལ་ ༼སྣར། པེ།༽ བདེ་བ་"
    },
    {
      "span": {
        "start": 1225,
        "end": 1232
      },
      "text": "ཕྲེང་བ་ ༼སྣར། པེ།༽ ཕྲེང་བར་"
    },
    {
      "span": {
        "start": 1273,
        "end": 1275
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 2041,
        "end": 2046
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 2230,
        "end": 2239
      },
      "text": "མཛད་ཀྱིས་ ༼སྣར། པེ།༽ མཛད་པས་"
    }
  ]
}