{
  "durchens": [
    {
      "span": {
        "start": 20,
        "end": 25
      },
      "text": "གཡེན་ ༼ཅོ། སྡེ།༽ གཡིན་"
    },
    {
      "span": {
        "start": 77,
        "end": 84
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 102,
        "end": 110
      },
      "text": "འཇམ་པའི་ ༼སྣར། པེ།༽ འཇམ་དཔལ་"
    },
    {
      "span": {
        "start": 562,
        "end": 572
      },
      "text": "བསྒྲུབ་པར་ ༼པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 733,
        "end": 737
      },
      "text": "བཞི་ ༼སྣར། པེ།༽ གཞི་"
    },
    {
      "span": {
        "start": 859,
        "end": 865
      },
      "text": "སྤྱིས་ ༼སྣར། པེ།༽ སྤྱིའི་"
    },
    {
      "span": {
        "start": 907,
        "end": 916
      },
      "text": "མི་རྟག་པ་ ༼སྣར། པེ།༽ མི་རྟག་"
    },
    {
      "span": {
        "start": 1440,
        "end": 1446
      },
      "text": "བྱས་པ་ ༼སྣར། པེ།༽ བྱས་པའི་"
    },
    {
      "span": {
        "start": 2230,
        "end": 2240
      },
      "text": "བསྒྲུབ་པར་ ༼པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 2310,
        "end": 2324
      },
      "text": "མངོན་སུམ་གྱིས་ ༼སྣར། པེ།༽ མངོན་སུམ་གྱི་"
    },
    {
      "span": {
        "start": 2335,
        "end": 2348
      },
      "text": "རྗེས་དཔག་གིས་ ༼སྣར། པེ།༽ རྗེས་དཔག་གི་"
    },
    {
      "span": {
        "start": 2359,
        "end": 2370
      },
      "text": "ཡིད་ཆེས་པས་ ༼སྣར། པེ།༽ ཡིད་ཆེས་པའི་"
    },
    {
      "span": {
        "start": 2400,
        "end": 2411
      },
      "text": "རང་ཚིག་གིས་ ༼སྣར། པེ།༽ རང་ཚིག་གི་"
    },
    {
      "span": {
        "start": 2529,
        "end": 2543
      },
      "text": "མངོན་སུམ་གྱིས་ ༼སྣར། པེ།༽ མངོན་སུམ་གྱི་"
    },
    {
      "span": {
        "start": 2667,
        "end": 2678
      },
      "text": "ཡིད་ཆེས་པས་ ༼སྣར། པེ།༽ ཡིད་ཆེས་པའི་"
    },
    {
      "span": {
        "start": 2687,
        "end": 2708
      },
      "text": "དཔེར་ན་བྱེ་བྲག་པ་སྒྲ་ ༼སྣར། པེ།༽ བྱེ་བྲག་པ་"
    },
    {
      "span": {
        "start": 2715,
        "end": 2724
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 2734,
        "end": 2742
      },
      "text": "གྲགས་པས་ ༼སྣར། པེ།༽ གྲགས་པའི་"
    },
    {
      "span": {
        "start": 2900,
        "end": 2911
      },
      "text": "རང་ཚིག་གིས་ ༼སྣར། པེ།༽ རང་ཚིག་གི་"
    },
    {
      "span": {
        "start": 3110,
        "end": 3117
      },
      "text": "སེམས་པ་ ༼སྣར།༽ སེམས་ཅན་"
    },
    {
      "span": {
        "start": 3194,
        "end": 3197
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 3392,
        "end": 3400
      },
      "text": "གསལ་བའི་ ༼སྣར། པེ།༽ བསལ་བའི་"
    },
    {
      "span": {
        "start": 3410,
        "end": 3417
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 3439,
        "end": 3449
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 3540,
        "end": 3547
      },
      "text": "ཟིན་ཏོ། ༼པེ།༽ ཟིན་ཏེ།"
    },
    {
      "span": {
        "start": 3820,
        "end": 3824
      },
      "text": "མིང་ ༼སྣར། པེ།༽ མིག་"
    },
    {
      "span": {
        "start": 3911,
        "end": 3918
      },
      "text": "གསལ་བར་ ༼སྣར། པེ།༽ བསལ་བར་"
    },
    {
      "span": {
        "start": 4168,
        "end": 4177
      },
      "text": "རྟེན་པའི་ ༼སྣར། པེ།༽ བརྟེན་པའི་"
    },
    {
      "span": {
        "start": 4341,
        "end": 4350
      },
      "text": "ལ་འཇུག་ལ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 4470,
        "end": 4475
      },
      "text": "རེ་ལ་ ༼སྣར། པེ།༽ རེ་"
    },
    {
      "span": {
        "start": 4863,
        "end": 4866
      },
      "text": "བྱ་ ༼པེ།༽ བྱར་"
    },
    {
      "span": {
        "start": 5076,
        "end": 5081
      },
      "text": "བརྩལ་ ༼སྣར། པེ།༽ བཙལ་"
    },
    {
      "span": {
        "start": 5143,
        "end": 5150
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྐྱ་"
    },
    {
      "span": {
        "start": 5574,
        "end": 5582
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་བ་དང་"
    },
    {
      "span": {
        "start": 5710,
        "end": 5719
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 6013,
        "end": 6016
      },
      "text": "རེ་ ༼པེ།༽ རེ་རེ་"
    },
    {
      "span": {
        "start": 6156,
        "end": 6165
      },
      "text": "མེད་པ་དེ་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 6183,
        "end": 6188
      },
      "text": "འཇུག་ ༼སྣར།༽ འཇུག་པ་"
    },
    {
      "span": {
        "start": 6277,
        "end": 6283
      },
      "text": "ཡོད་ལ་ ༼སྣར། པེ།༽ ཡོད་པ་"
    },
    {
      "span": {
        "start": 7303,
        "end": 7311
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 7326,
        "end": 7334
      },
      "text": "ཕྱིར་རོ། ༼སྣར། པེ།༽ ཕྱིར།"
    },
    {
      "span": {
        "start": 7563,
        "end": 7569
      },
      "text": "ཡིན་པ་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 7805,
        "end": 7812
      },
      "text": "ཡིན་པར་ ༼སྣར། པེ།༽ ཡིན་པ་"
    },
    {
      "span": {
        "start": 7911,
        "end": 7918
      },
      "text": "ཟིན་ཏོ། ༼སྣར། པེ།༽ ཟིན་ཏེ།"
    },
    {
      "span": {
        "start": 7920,
        "end": 7922
      },
      "text": "ད་ ༼པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 7946,
        "end": 7953
      },
      "text": "བྱ་སྟེ། ༼སྣར། པེ།༽ བྱས་ཏེ།"
    },
    {
      "span": {
        "start": 7975,
        "end": 7979
      },
      "text": "སྣང་ ༼སྣར།༽ སྣང་བ་"
    },
    {
      "span": {
        "start": 8021,
        "end": 8050
      },
      "text": "། བསྒྲུབ་བྱ་ཆོས་མ་གྲུབ་པ་དང་། ༼སྣར།༽ ། ༼པེ།༽ ། སྒྲུབ་བྱ་དང་ཆོས་མ་གྲུབ་པ་དང་།"
    },
    {
      "span": {
        "start": 8101,
        "end": 8107
      },
      "text": "སྦྱོར་ ༼སྣར། པེ།༽ སྦྱར་"
    },
    {
      "span": {
        "start": 8137,
        "end": 8143
      },
      "text": "སྣང་ལ་ ༼སྣར། པེ།༽ སྣང་བ་"
    },
    {
      "span": {
        "start": 8249,
        "end": 8256
      },
      "text": "ལྡོག་པ་ ༼སྣར། པེ།༽ ལྡོག་པ་དང་"
    },
    {
      "span": {
        "start": 8380,
        "end": 8390
      },
      "text": "མེད་པ་སྟེ་ ༼སྣར། པེ།༽ མེད་པ་དེ་"
    },
    {
      "span": {
        "start": 8509,
        "end": 8522
      },
      "text": "ཐོགས་པ་མེད་པ་ ༼སྣར། པེ།༽ ཐོགས་པ་"
    },
    {
      "span": {
        "start": 8552,
        "end": 8559
      },
      "text": "ཐོགས་པ་ ༼སྣར། པེ།༽ ཐོགས་པ་མེད་པ་"
    },
    {
      "span": {
        "start": 9321,
        "end": 9330
      },
      "text": "མཐུན་པའི་ ༼སྣར། པེ།༽ མཐུན་"
    },
    {
      "span": {
        "start": 9355,
        "end": 9366
      },
      "text": "བྱ་བའི་ཆོས་ ༼སྣར། པེ།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 9591,
        "end": 9598
      },
      "text": "ཐོགས་པ་ ༼སྣར། པེ།༽ ཐོགས་"
    },
    {
      "span": {
        "start": 9634,
        "end": 9644
      },
      "text": "བསྒྲུབ་བྱ་ ༼སྣར། པེ།༽ བསྒྲུབ་བྱའི་"
    },
    {
      "span": {
        "start": 9651,
        "end": 9653
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 9715,
        "end": 9723
      },
      "text": "ཕྱིར་རོ། ༼སྣར། པེ།༽ ཕྱིར།"
    },
    {
      "span": {
        "start": 9732,
        "end": 9745
      },
      "text": "ལྡོག་པ་མེད་པ་ ༼སྣར། པེ།༽ ལྡོག་པ་"
    },
    {
      "span": {
        "start": 9776,
        "end": 9783
      },
      "text": "ནམ་མཁའ་ ༼སྣར། པེ།༽ ནམ་མཁའི་"
    },
    {
      "span": {
        "start": 10014,
        "end": 10022
      },
      "text": "ཕྱིར་རོ། ༼སྣར། པེ།༽ ཕྱིར།"
    },
    {
      "span": {
        "start": 10046,
        "end": 10053
      },
      "text": "སྦྱར་བ་ ༼སྣར། པེ།༽ སྦྱར་བ་བཞིན་"
    },
    {
      "span": {
        "start": 10194,
        "end": 10202
      },
      "text": "ཡང་དག་པ་ ༼སྣར། པེ།༽ ཡང་དག་"
    },
    {
      "span": {
        "start": 10216,
        "end": 10222
      },
      "text": "དེས་ན་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 10663,
        "end": 10666
      },
      "text": "མེ་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 10933,
        "end": 10942
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 10957,
        "end": 10964
      },
      "text": "རྟོག་པ་ ༼སྣར།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 11087,
        "end": 11096
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 11178,
        "end": 11184
      },
      "text": "བཤད་པ་ ༼སྣར། པེ།༽ བཤད་པ་བཤད་པ་"
    },
    {
      "span": {
        "start": 11280,
        "end": 11289
      },
      "text": "རྗེས་དཔག་ ༼སྣར།༽ རྗེས་སུ་དཔག་པ་ ༼པེ།༽ རྗེས་སུ་དཔག་"
    },
    {
      "span": {
        "start": 11309,
        "end": 11318
      },
      "text": "ཡང་དག་པར་ ༼སྣར། པེ།༽ ཡང་དག་པར་མ་"
    },
    {
      "span": {
        "start": 11382,
        "end": 11388
      },
      "text": "ཡང་དག་ ༼སྣར། པེ།༽ ཡང་དག་པར་"
    },
    {
      "span": {
        "start": 11468,
        "end": 11475
      },
      "text": "བསྒྲུབ་ ༼པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 11588,
        "end": 11595
      },
      "text": "གསལ་བར་ ༼སྣར། པེ།༽ བསལ་བར་"
    },
    {
      "span": {
        "start": 11604,
        "end": 11614
      },
      "text": "ཕྱིར་རྒོལ་ ༼སྣར། པེ།༽ ཕྱི་རྒོལ་"
    },
    {
      "span": {
        "start": 11614,
        "end": 11618
      },
      "text": "གྱི་ ༼སྣར། པེ།༽ གྱིས་"
    },
    {
      "span": {
        "start": 11847,
        "end": 11849
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 11972,
        "end": 11983
      },
      "text": "གཏན་ཚིགས་མ་ ༼སྣར། པེ།༽ གཏན་ཚིགས་མི་"
    },
    {
      "span": {
        "start": 12178,
        "end": 12185
      },
      "text": "ཡིན་པར་ ༼སྣར། པེ།༽ ཡིན་པ་"
    },
    {
      "span": {
        "start": 12501,
        "end": 12506
      },
      "text": "བཤེས་ ༼སྣར། པེ།༽ ཤེས་"
    },
    {
      "span": {
        "start": 12690,
        "end": 12698
      },
      "text": "དཔལ་ལྡན་ ༼སྣར། པེ།༽ དཔལ་"
    },
    {
      "span": {
        "start": 12876,
        "end": 12881
      },
      "text": "སོ། ། ༼སྣར། པེ།༽ ། །འགྲོ་བ་སེམས་ཅན་ཐམས་ཅད་ལ་ཕན་ཐོགས་པར་གྱུར་ཅིག །"
    }
  ]
}