{
  "durchens": [
    {
      "span": {
        "start": 70,
        "end": 80
      },
      "text": "སྒྲུབ་པའི་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 127,
        "end": 133
      },
      "text": "དང་པོ་ ༼སྣར། པེ།༽ དང་པོར་"
    },
    {
      "span": {
        "start": 151,
        "end": 159
      },
      "text": "བདེ་བའི་ ༼སྣར།༽ ཆེན་པོའི་"
    },
    {
      "span": {
        "start": 175,
        "end": 181
      },
      "text": "རང་གི་ ༼སྣར།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 555,
        "end": 572
      },
      "text": "སྐྱེས་པའི་ཉི་མའི་ ༼སྣར། པེ།༽ སྐྱེས་པའི་"
    },
    {
      "span": {
        "start": 667,
        "end": 675
      },
      "text": "ཧཱུཾ་གི་ ༼པེ།༽ ཧཱུཾ་གིས་"
    },
    {
      "span": {
        "start": 717,
        "end": 727
      },
      "text": "བཞུགས་པའི་ ༼སྣར། པེ།༽ བཞུགས་པ་"
    },
    {
      "span": {
        "start": 826,
        "end": 833
      },
      "text": "གཡོན་པ་ ༼སྣར། པེ།༽ གཡོན་"
    },
    {
      "span": {
        "start": 918,
        "end": 923
      },
      "text": "འཕྱར་ ༼སྣར། པེ།༽ འཕྱང་"
    }
  ]
}