{
  "durchens": [
    {
      "span": {
        "start": 33,
        "end": 37
      },
      "text": "མརྡ་ ༼སྣར། པེ།༽ མ་དྷ་"
    },
    {
      "span": {
        "start": 101,
        "end": 110
      },
      "text": "གཏན་ཚིགས་ ༼ཅོ།༽ གཏན་ཚིགས་སུ་"
    },
    {
      "span": {
        "start": 406,
        "end": 414
      },
      "text": "བདེན་ལམ་ ༼སྣར། པེ།༽ བདེན་ལས་"
    },
    {
      "span": {
        "start": 656,
        "end": 662
      },
      "text": "སྒྲུབ། ༼སྣར། པེ།༽ བསྒྲུབ།"
    },
    {
      "span": {
        "start": 1423,
        "end": 1426
      },
      "text": "ལྷ། ༼ཅོ། སྣར།༽ ལྟ།"
    },
    {
      "span": {
        "start": 1453,
        "end": 1460
      },
      "text": "རིགས། ། ༼སྣར། པེ།༽ རིག །"
    },
    {
      "span": {
        "start": 1568,
        "end": 1572
      },
      "text": "གཟང་ ༼སྣར། པེ།༽ གཟངས་"
    },
    {
      "span": {
        "start": 3134,
        "end": 3137
      },
      "text": "ཡང་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 3374,
        "end": 3379
      },
      "text": "བཙོས། ༼སྣར། པེ།༽ རྩོས།"
    },
    {
      "span": {
        "start": 3407,
        "end": 3412
      },
      "text": "འཐོར། ༼སྣར། པེ།༽ མཐོར།"
    },
    {
      "span": {
        "start": 3521,
        "end": 3524
      },
      "text": "ནས་ ༼སྣར། པེ།༽ གནས་"
    },
    {
      "span": {
        "start": 3735,
        "end": 3749
      },
      "text": "ལ་ནི་སྦྲུལ་དུ་ ༼སྣར། པེ།༽ ལ་སྦྲུལ་"
    },
    {
      "span": {
        "start": 3777,
        "end": 3784
      },
      "text": "འདྲལ་བ་ ༼སྣར། པེ།༽ འདྲ་བ་"
    },
    {
      "span": {
        "start": 3784,
        "end": 3787
      },
      "text": "དག་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 4820,
        "end": 4827
      },
      "text": "ངེས་ནས་ ༼པེ།༽ དེས་གནས་"
    },
    {
      "span": {
        "start": 5053,
        "end": 5061
      },
      "text": "གྲུམ་པོ་ ༼སྣར། པེ།༽ གྲུབ་པོ་"
    },
    {
      "span": {
        "start": 5562,
        "end": 5566
      },
      "text": "ཅིས་ ༼སྣར། པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 5645,
        "end": 5647
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལས།"
    },
    {
      "span": {
        "start": 5936,
        "end": 5945
      },
      "text": "དབྱུག་གུ་ ༼སྣར། པེ།༽ དབྱུ་གུ་"
    },
    {
      "span": {
        "start": 6088,
        "end": 6099
      },
      "text": "དབྱུག་གུའི་ ༼སྣར།༽ དབྱུ་གུའི་"
    },
    {
      "span": {
        "start": 7325,
        "end": 7340
      },
      "text": "རལ་པའམ་སྤྱི་བོ་ ༼སྣར།༽ རལ་པའམ་སྤྱིའུ་ ༼པེ།༽ རལ་པའང་སྤྱིའུ་"
    },
    {
      "span": {
        "start": 7345,
        "end": 7349
      },
      "text": "ཕུད་ ༼སྣར། པེ།༽ པུད་"
    },
    {
      "span": {
        "start": 7475,
        "end": 7481
      },
      "text": "བགྲངས་ ༼སྣར། པེ།༽ གྲངས་"
    },
    {
      "span": {
        "start": 7618,
        "end": 7624
      },
      "text": "བགྲངས་ ༼སྣར། པེ།༽ འགྲངས་"
    },
    {
      "span": {
        "start": 7821,
        "end": 7825
      },
      "text": "རླན་ ༼སྣར། པེ།༽ བརླན་"
    },
    {
      "span": {
        "start": 7854,
        "end": 7860
      },
      "text": "ཡོད་པ་ ༼སྣར། པེ།༽ ཡོད་མ་"
    },
    {
      "span": {
        "start": 7981,
        "end": 7986
      },
      "text": "དབེན་ ༼སྣར།༽ དབྱེན་"
    },
    {
      "span": {
        "start": 8162,
        "end": 8167
      },
      "text": "རྫུས་ ༼སྣར། པེ།༽ བརྫུས་"
    },
    {
      "span": {
        "start": 8355,
        "end": 8360
      },
      "text": "བཙོག་ ༼སྣར། པེ།༽ བརྩོག་"
    },
    {
      "span": {
        "start": 8366,
        "end": 8370
      },
      "text": "བསད་ ༼སྣར། པེ།༽ གསད་"
    },
    {
      "span": {
        "start": 8517,
        "end": 8522
      },
      "text": "འཁོལ་ ༼སྣར། པེ།༽ འཁྲོལ་"
    },
    {
      "span": {
        "start": 8585,
        "end": 8591
      },
      "text": "བསྙབས་ ༼སྣར། པེ།༽ བརྙབ་"
    },
    {
      "span": {
        "start": 8823,
        "end": 8831
      },
      "text": "བཙགས་ལས་ ༼སྣར། པེ།༽ བཙགས་ནས་"
    },
    {
      "span": {
        "start": 9199,
        "end": 9204
      },
      "text": "ཀླགས་ ༼སྣར།༽ བཀླགས་"
    },
    {
      "span": {
        "start": 9365,
        "end": 9368
      },
      "text": "ཆར། ༼སྣར། པེ།༽ ཆ།"
    },
    {
      "span": {
        "start": 9829,
        "end": 9836
      },
      "text": "རྣམས། ། ༼སྣར། པེ།༽ དག །"
    },
    {
      "span": {
        "start": 10087,
        "end": 10093
      },
      "text": "པའོ། ། ༼སྣར། པེ།༽ ། །འདིས་བསྟན་པ་དང་སེམས་ཅན་ལ་ཕན་ཐོགས་པར་གྱུར་ཅིག །།"
    }
  ]
}