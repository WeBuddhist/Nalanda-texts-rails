{
  "durchens": [
    {
      "span": {
        "start": 308,
        "end": 316
      },
      "text": "འགྲོ་བར་ ༼སྣར། པེ།༽ འགྲོ་བ་"
    },
    {
      "span": {
        "start": 324,
        "end": 336
      },
      "text": "བདུན་པོ་ཡིས་ ༼སྣར། པེ།༽ བདུན་པོ་ཡིད་"
    },
    {
      "span": {
        "start": 914,
        "end": 920
      },
      "text": "སྒེག ། ༼སྣར། པེ།༽ བསྒེགས། །"
    },
    {
      "span": {
        "start": 1025,
        "end": 1030
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 1334,
        "end": 1341
      },
      "text": "གཏོར་མ་ ༼སྣར། པེ།༽ གཏོར་མའི་"
    },
    {
      "span": {
        "start": 1347,
        "end": 1350
      },
      "text": "པར་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 1547,
        "end": 1550
      },
      "text": "དུ་ ༼སྣར།༽ དུ་ས་"
    },
    {
      "span": {
        "start": 1629,
        "end": 1633
      },
      "text": "མཛད་ ༼སྣར། པེ།༽ མཛད་ཡེ་ཤེས་"
    }
  ]
}