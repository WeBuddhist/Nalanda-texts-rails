{
  "durchens": [
    {
      "span": {
        "start": 401,
        "end": 410
      },
      "text": "རྗེས་སའམ་ ༼སྣར། པེ།༽ རྗེས་སམ་"
    },
    {
      "span": {
        "start": 436,
        "end": 443
      },
      "text": "རྙེད་པ་ ༼སྣར། པེ།༽ སྙེད་པ་"
    },
    {
      "span": {
        "start": 443,
        "end": 452
      },
      "text": "དང་བཅས་པ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 572,
        "end": 577
      },
      "text": "མོ་པ་ ༼སྣར། པེ།༽ མོས་པ་"
    },
    {
      "span": {
        "start": 594,
        "end": 602
      },
      "text": "ཆུག་ཅིག་ ༼སྣར། པེ།༽ ཆུག་གཅིག་"
    },
    {
      "span": {
        "start": 616,
        "end": 624
      },
      "text": "མིང་གིས་ ༼སྣར། པེ།༽ མིང་གི་"
    },
    {
      "span": {
        "start": 669,
        "end": 676
      },
      "text": "འཁོར་བ་ ༼སྣར། པེ།༽ འཁོར་བར་"
    },
    {
      "span": {
        "start": 1325,
        "end": 1332
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 1340,
        "end": 1345
      },
      "text": "བྱེད་ ༼སྣར། པེ།༽ བྱད་"
    }
  ]
}