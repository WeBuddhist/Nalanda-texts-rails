{
  "durchens": [
    {
      "span": {
        "start": 518,
        "end": 524
      },
      "text": "མཐའ་མ་ ༼སྣར། པེ།༽ ཐ་མ་"
    },
    {
      "span": {
        "start": 540,
        "end": 544
      },
      "text": "གྲྭ་ ༼སྣར།༽ གྲ་"
    },
    {
      "span": {
        "start": 608,
        "end": 614
      },
      "text": "མཐའ་མ་ ༼སྣར། པེ།༽ ཐ་མ་"
    },
    {
      "span": {
        "start": 1008,
        "end": 1014
      },
      "text": "བྱས་ལ་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 1141,
        "end": 1153
      },
      "text": "ཅེས་བརྒྱ་རྩ་ ༼སྣར། པེ།༽ ཅེས་"
    },
    {
      "span": {
        "start": 1371,
        "end": 1376
      },
      "text": "བགྲད་ ༼སྣར། པེ།༽ བསྒྲད་"
    },
    {
      "span": {
        "start": 1964,
        "end": 1973
      },
      "text": "སེམས་དཔལ་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 2003,
        "end": 2008
      },
      "text": "བཏོན་ ༼སྣར། པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 2019,
        "end": 2028
      },
      "text": "གཅིག་ཅིག་ ༼སྣར། པེ།༽ གཅིག་གཅིག་"
    },
    {
      "span": {
        "start": 2036,
        "end": 2038
      },
      "text": "བ། ༼སྣར། པེ།༽ ལ།"
    }
  ]
}