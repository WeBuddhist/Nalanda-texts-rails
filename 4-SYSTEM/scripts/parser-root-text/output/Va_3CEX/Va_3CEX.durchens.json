{
  "durchens": [
    {
      "span": {
        "start": 873,
        "end": 883
      },
      "text": "སྒྲིབ་པའོ། ༼སྣར། པེ།༽ སྒྲིབ་པ།"
    },
    {
      "span": {
        "start": 892,
        "end": 901
      },
      "text": "བརྟགས་པས་ ༼སྣར། པེ།༽ བཏགས་པས་"
    },
    {
      "span": {
        "start": 918,
        "end": 922
      },
      "text": "བའོ་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 2231,
        "end": 2238
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 2502,
        "end": 2507
      },
      "text": "བྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 2762,
        "end": 2767
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 2942,
        "end": 2949
      },
      "text": "མི་ཆེས་ ༼སྣར།༽ ནི་ཆོས་ ༼པེ།༽ ནི་ཆེས་"
    },
    {
      "span": {
        "start": 3197,
        "end": 3200
      },
      "text": "དག་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 4113,
        "end": 4119
      },
      "text": "གཡེང་། ༼སྣར།༽ གཡང་།"
    },
    {
      "span": {
        "start": 4189,
        "end": 4194
      },
      "text": "ཕྱེད་ ༼སྣར།༽ བྱེད་"
    },
    {
      "span": {
        "start": 4660,
        "end": 4664
      },
      "text": "ལྡན་ ༼སྣར། པེ།༽ ལྷན་"
    },
    {
      "span": {
        "start": 4816,
        "end": 4823
      },
      "text": "སྟེན་པ་ ༼སྣར། པེ།༽ བསྟེན་པ་"
    },
    {
      "span": {
        "start": 4830,
        "end": 4836
      },
      "text": "ལྷག་མ་ ༼སྣར། པེ།༽ ལྷག་པ་"
    },
    {
      "span": {
        "start": 4875,
        "end": 4881
      },
      "text": "རང་གི་ ༼སྣར། པེ།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 5154,
        "end": 5159
      },
      "text": "སྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 5654,
        "end": 5658
      },
      "text": "པའང་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 5960,
        "end": 5976
      },
      "text": "བསྟན་པ་ཞེས་བྱ་བ་ ༼ཅོ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 6045,
        "end": 6050
      },
      "text": "ལ་ལོ། ༼སྣར། པེ།༽ ལའོ།"
    },
    {
      "span": {
        "start": 6205,
        "end": 6208
      },
      "text": "ཕོ་ ༼སྣར། པེ།༽ ཕོའི་"
    },
    {
      "span": {
        "start": 6216,
        "end": 6220
      },
      "text": "རིས་ ༼སྡེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 6835,
        "end": 6842
      },
      "text": "ཡིད་མི་ ༼པེ།༽ ཡིད་ནི་"
    },
    {
      "span": {
        "start": 7375,
        "end": 7378
      },
      "text": "དང་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 7400,
        "end": 7410
      },
      "text": "གཉིས་ཀྱིས་ ༼ཅོ།༽ གཉིས་ཀྱི་ ༼སྣར། པེ།༽ ཡིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 7490,
        "end": 7493
      },
      "text": "པར་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 7524,
        "end": 7529
      },
      "text": "རྫུས་ ༼སྣར། པེ།༽ བརྫུས་"
    },
    {
      "span": {
        "start": 7628,
        "end": 7631
      },
      "text": "ནི། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 8696,
        "end": 8700
      },
      "text": "དྲན། ༼པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 9068,
        "end": 9073
      },
      "text": "སྒྱུ་ ༼སྣར། པེ།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 9164,
        "end": 9170
      },
      "text": "དཔྱོད་ ༼སྣར། པེ།༽ སྤྱོད་"
    },
    {
      "span": {
        "start": 9226,
        "end": 9234
      },
      "text": "འགྱོད་པ་ ༼སྣར། པེ།༽ འགྱོད་པས་"
    },
    {
      "span": {
        "start": 9453,
        "end": 9464
      },
      "text": "དེ་བསྣན་ནོ། ༼སྣར། པེ།༽ དེས་བསྟན་ཏོ།"
    },
    {
      "span": {
        "start": 9469,
        "end": 9472
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 9988,
        "end": 9990
      },
      "text": "པ་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 10058,
        "end": 10066
      },
      "text": "རྙེད་དང་ ༼སྣར། པེ།༽ རྙེད་པ་"
    },
    {
      "span": {
        "start": 10240,
        "end": 10246
      },
      "text": "རྣམ་པ་ ༼སྣར། པེ།༽ རྣམས་ནི་"
    },
    {
      "span": {
        "start": 10488,
        "end": 10492
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 10845,
        "end": 10855
      },
      "text": "གཅིག་འཐོབ། ༼སྣར། པེ།༽ ཅིག་ཐོབ།"
    },
    {
      "span": {
        "start": 11007,
        "end": 11010
      },
      "text": "བྱ། ༼སྣར།༽ བྱས།"
    },
    {
      "span": {
        "start": 11052,
        "end": 11056
      },
      "text": "ཐོབ་ ༼སྣར། པེ།༽ འཐོབ་"
    },
    {
      "span": {
        "start": 11246,
        "end": 11252
      },
      "text": "སྐྱེས་ ༼སྣར། པེ།༽ སྐྱེ་"
    },
    {
      "span": {
        "start": 11510,
        "end": 11521
      },
      "text": "གསུམ་པ་སྟེ་ ༼སྣར། པེ།༽ གསུམ་པ་དེ་"
    },
    {
      "span": {
        "start": 11990,
        "end": 11998
      },
      "text": "རང་རིགས་ ༼སྣར། པེ།༽ རང་"
    },
    {
      "span": {
        "start": 12085,
        "end": 12093
      },
      "text": "དེ་གཉིས་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 12113,
        "end": 12118
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 12239,
        "end": 12244
      },
      "text": "རང་ས་ ༼སྣར། པེ།༽ རང་སར་"
    },
    {
      "span": {
        "start": 12253,
        "end": 12256
      },
      "text": "སྔ། ༼སྣར། པེ།༽ ལྔ།"
    },
    {
      "span": {
        "start": 12943,
        "end": 12949
      },
      "text": "དང་པོ་ ༼སྣར། པེ།༽ དང་པོར་"
    },
    {
      "span": {
        "start": 13020,
        "end": 13026
      },
      "text": "སྐྱེས། ༼སྣར། པེ།༽ སྐྱེ།"
    },
    {
      "span": {
        "start": 13246,
        "end": 13249
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱར་"
    },
    {
      "span": {
        "start": 13285,
        "end": 13287
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལས།"
    },
    {
      "span": {
        "start": 13370,
        "end": 13378
      },
      "text": "བཞི་ཡིས་ ༼སྣར། པེ།༽ བཞི་ཡི་"
    },
    {
      "span": {
        "start": 13457,
        "end": 13462
      },
      "text": "སྐྱེ། ༼སྣར། པེ།༽ སྐྱེས།"
    },
    {
      "span": {
        "start": 13610,
        "end": 13614
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 13649,
        "end": 13659
      },
      "text": "བསྒྲིབས་པ་ ༼སྣར། པེ།༽ སྒྲིབ་པ་"
    },
    {
      "span": {
        "start": 13878,
        "end": 13883
      },
      "text": "མཇུག་ ༼སྣར། པེ།༽ འཇུག་"
    },
    {
      "span": {
        "start": 13942,
        "end": 13950
      },
      "text": "ཡི་མཇུག་ ༼སྣར།༽ ནི་འཇུག་ ༼པེ།༽ ནི་མཇུག་"
    },
    {
      "span": {
        "start": 13979,
        "end": 13982
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དྲུག་"
    },
    {
      "span": {
        "start": 14061,
        "end": 14064
      },
      "text": "ལོ་ ༼སྣར།༽ ལ་"
    },
    {
      "span": {
        "start": 14934,
        "end": 14941
      },
      "text": "རྟེན་པ་ ༼སྣར། པེ།༽ བརྟེན་པ་"
    },
    {
      "span": {
        "start": 15601,
        "end": 15608
      },
      "text": "མངལ་ནས་ ༼སྣར། པེ།༽ མངལ་ན་"
    },
    {
      "span": {
        "start": 15779,
        "end": 15786
      },
      "text": "བྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 15856,
        "end": 15858
      },
      "text": "ན་ ༼སྣར།༽ ནི་"
    },
    {
      "span": {
        "start": 15905,
        "end": 15910
      },
      "text": "བྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 15948,
        "end": 15958
      },
      "text": "ལྔར་གསུངས་ ༼སྣར། པེ།༽ སྔར་གསུང་"
    },
    {
      "span": {
        "start": 16687,
        "end": 16692
      },
      "text": "འཕངས་ ༼སྣར། པེ།༽ ཕངས་"
    },
    {
      "span": {
        "start": 16697,
        "end": 16706
      },
      "text": "རིམ་གྱིས་ ༼སྣར། པེ།༽ རིམ་གྱི་"
    },
    {
      "span": {
        "start": 16941,
        "end": 16946
      },
      "text": "མངོན་ ༼སྣར། པེ།༽ སྔོན་"
    },
    {
      "span": {
        "start": 17418,
        "end": 17426
      },
      "text": "འདོད་ལོ། ༼སྣར།༽ འདོད་དོ།"
    },
    {
      "span": {
        "start": 17546,
        "end": 17550
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 17852,
        "end": 17857
      },
      "text": "རྫུན་ ༼སྣར། པེ།༽ བརྫུན་"
    },
    {
      "span": {
        "start": 17934,
        "end": 17940
      },
      "text": "དེ་དང་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 18004,
        "end": 18008
      },
      "text": "མིན་ ༼སྣར། པེ།༽ མིང་"
    },
    {
      "span": {
        "start": 18196,
        "end": 18202
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 18274,
        "end": 18281
      },
      "text": "དེ་ཡིད་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 18756,
        "end": 18760
      },
      "text": "རྩྭ་ ༼སྣར། པེ།༽ རྩ་"
    },
    {
      "span": {
        "start": 18867,
        "end": 18871
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 18983,
        "end": 18987
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 18992,
        "end": 18995
      },
      "text": "པོ་ ༼སྣར། པེ།༽ མོ་"
    },
    {
      "span": {
        "start": 19158,
        "end": 19168
      },
      "text": "དང་སེམས་པ་ ༼སྣར། པེ།༽ དང་སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 19203,
        "end": 19205
      },
      "text": "ན། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 19211,
        "end": 19214
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 19289,
        "end": 19296
      },
      "text": "རྟེན་པ་ ༼སྣར། པེ།༽ བསྟེན་པ་"
    },
    {
      "span": {
        "start": 19379,
        "end": 19383
      },
      "text": "འཆད་ ༼སྣར།༽ ཆད་"
    },
    {
      "span": {
        "start": 19559,
        "end": 19567
      },
      "text": "འོག་མའི་ ༼སྣར། པེ།༽ འོག་མིན་"
    },
    {
      "span": {
        "start": 20178,
        "end": 20182
      },
      "text": "བལྟ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 20453,
        "end": 20462
      },
      "text": "བརྒྱད་པོ་ ༼སྣར། པེ།༽ བརྒྱད་པོའི་"
    },
    {
      "span": {
        "start": 20639,
        "end": 20652
      },
      "text": "ཕྱེད་ཕྱེད་དོ། ༼སྣར། པེ།༽ ཕྱེད་ཕྱེད་དབྲི།"
    },
    {
      "span": {
        "start": 20718,
        "end": 20726
      },
      "text": "གཉིས་སོ་ ༼སྣར། པེ།༽ གཉིས་པོ་"
    },
    {
      "span": {
        "start": 20846,
        "end": 20852
      },
      "text": "ཟླ་ཁམ་ ༼སྣར། པེ།༽ ཟླ་གམ་"
    },
    {
      "span": {
        "start": 20867,
        "end": 20874
      },
      "text": "འདི་དང་ ༼སྣར། པེ།༽ འདི་དག་"
    },
    {
      "span": {
        "start": 21237,
        "end": 21248
      },
      "text": "ངད་ལྡང་བའི་ ༼སྣར། པེ།༽ ངད་ལྡན་པའི་"
    },
    {
      "span": {
        "start": 21377,
        "end": 21380
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 21418,
        "end": 21423
      },
      "text": "མེ་མ་ ༼སྣར། པེ།༽ མེ་མར་"
    },
    {
      "span": {
        "start": 21444,
        "end": 21454
      },
      "text": "སྤུ་གྲིའི་ ༼སྣར། པེ།༽ སྤུ་གྲི་"
    },
    {
      "span": {
        "start": 21693,
        "end": 21701
      },
      "text": "ཐུང་ངུར་ ༼སྣར། པེ།༽ ཐུང་ངུ་"
    },
    {
      "span": {
        "start": 21717,
        "end": 21724
      },
      "text": "བཟློག ། ༼སྣར། པེ།༽ ལྡོག །"
    },
    {
      "span": {
        "start": 22177,
        "end": 22181
      },
      "text": "བལྟ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 22262,
        "end": 22266
      },
      "text": "གཞི་ ༼སྣར།༽ བཞི་"
    },
    {
      "span": {
        "start": 22433,
        "end": 22437
      },
      "text": "བཅད་ ༼སྣར། པེ།༽ བཤད་"
    },
    {
      "span": {
        "start": 22755,
        "end": 22763
      },
      "text": "གསུམ་པོ་ ༼སྣར། པེ།༽ གསུམ་པ་"
    },
    {
      "span": {
        "start": 22866,
        "end": 22874
      },
      "text": "ཇི་སྲིད་ ༼སྣར། པེ།༽ ཇི་སྙེད་"
    },
    {
      "span": {
        "start": 23188,
        "end": 23195
      },
      "text": "འཛམ་བུ་ ༼སྣར། པེ།༽ འཛམ་བུའི་"
    },
    {
      "span": {
        "start": 23529,
        "end": 23533
      },
      "text": "དོར་ ༼སྣར། པེ།༽ འདོར་"
    },
    {
      "span": {
        "start": 23683,
        "end": 23688
      },
      "text": "རྣམས་ ༼པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 23858,
        "end": 23864
      },
      "text": "ཉི་ཤུ་ ༼སྣར། པེ།༽ ཉི་ཤུས་"
    },
    {
      "span": {
        "start": 23871,
        "end": 23877
      },
      "text": "ལྷག་པ་ ༼སྣར།༽ ལྷག་པས་"
    },
    {
      "span": {
        "start": 24170,
        "end": 24176
      },
      "text": "སྦྱངས་ ༼སྣར། པེ།༽ རྫངས་"
    },
    {
      "span": {
        "start": 24354,
        "end": 24357
      },
      "text": "རབ་ ༼སྣར། པེ།༽ རབས་"
    },
    {
      "span": {
        "start": 24439,
        "end": 24446
      },
      "text": "དང་སྲོ་ ༼སྣར།༽ དང་སོ་"
    },
    {
      "span": {
        "start": 24506,
        "end": 24513
      },
      "text": "བསྒྱུར། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 24801,
        "end": 24804
      },
      "text": "ཡི། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 25051,
        "end": 25058
      },
      "text": "གཞན་ནི་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 25147,
        "end": 25153
      },
      "text": "ཆགས་པ་ ༼སྣར། པེ།༽ འཆགས་པ་"
    },
    {
      "span": {
        "start": 25387,
        "end": 25394
      },
      "text": "བསྐལ་པ་ ༼སྣར།༽ བསྐལ་"
    },
    {
      "span": {
        "start": 25399,
        "end": 25402
      },
      "text": "ཡི་ ༼སྣར། པེ།༽ ཡིས་"
    },
    {
      "span": {
        "start": 25464,
        "end": 25469
      },
      "text": "འཕྱི། ༼སྣར།༽ ཕྱི།"
    },
    {
      "span": {
        "start": 25547,
        "end": 25553
      },
      "text": "ལས་མས་ ༼སྣར། པེ།༽ ལ་མས་"
    },
    {
      "span": {
        "start": 25633,
        "end": 25639
      },
      "text": "བརྩམས་ ༼སྣར།༽ བརྩེམས་"
    },
    {
      "span": {
        "start": 25780,
        "end": 25784
      },
      "text": "སོག་ ༼སྣར། པེ།༽ བསོགས་"
    },
    {
      "span": {
        "start": 25943,
        "end": 25948
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 25979,
        "end": 25987
      },
      "text": "གོ་རིམས་ ༼སྣར། པེ།༽ གོ་རིམ་"
    },
    {
      "span": {
        "start": 26296,
        "end": 26305
      },
      "text": "དེ་ནས་ནི། ༼སྣར། པེ།༽ དེ་ནས་ཀྱང་།"
    },
    {
      "span": {
        "start": 26341,
        "end": 26350
      },
      "text": "མངོན་པའི་ ༼སྣར། པེ།༽ མངོན་པ་"
    },
    {
      "span": {
        "start": 26379,
        "end": 26389
      },
      "text": "འཇིག་རྟེན་ ༼སྣར། པེ།༽ འཇིག་རྟེན་པ་"
    },
    {
      "span": {
        "start": 26515,
        "end": 26522
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེས་"
    },
    {
      "span": {
        "start": 26633,
        "end": 26643
      },
      "text": "སྐད་ཅིག་མ་ ༼སྣར། པེ།༽ སྐད་ཅིག་པ་"
    },
    {
      "span": {
        "start": 26732,
        "end": 26741
      },
      "text": "འགྱུར་ཏེ་ ༼སྣར། པེ།༽ འགྱུར་དེ་"
    },
    {
      "span": {
        "start": 26757,
        "end": 26766
      },
      "text": "རྣམས་རིག་ ༼སྣར། པེ།༽ རྣམ་རིག་"
    },
    {
      "span": {
        "start": 26978,
        "end": 26988
      },
      "text": "སྐྱེས་པའི་ ༼སྣར། པེ།༽ སྐྱེས་པ་"
    },
    {
      "span": {
        "start": 27145,
        "end": 27151
      },
      "text": "སྐྱེས། ༼སྣར། པེ།༽ སྐྱེ།"
    },
    {
      "span": {
        "start": 27217,
        "end": 27221
      },
      "text": "ནའོ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 27318,
        "end": 27322
      },
      "text": "མེད་ ༼སྣར། པེ།༽ མེ་"
    },
    {
      "span": {
        "start": 27413,
        "end": 27418
      },
      "text": "བྱ་བ་ ༼སྣར།༽ བྱས་པ་"
    },
    {
      "span": {
        "start": 27867,
        "end": 27876
      },
      "text": "གསུམ་ཤེས་ ༼སྣར། པེ།༽ གསུམ་ཞེས་"
    },
    {
      "span": {
        "start": 28335,
        "end": 28341
      },
      "text": "སྐྱེས་ ༼སྣར། པེ།༽ སྐྱེ་"
    },
    {
      "span": {
        "start": 28509,
        "end": 28518
      },
      "text": "དབང་པོའི་ ༼སྣར། པེ།༽ དབང་པོ་"
    },
    {
      "span": {
        "start": 28567,
        "end": 28570
      },
      "text": "དག་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 28582,
        "end": 28594
      },
      "text": "རྣམ་རིག་མིན་ ༼སྣར།༽ རྣམ་རིག་མི་"
    },
    {
      "span": {
        "start": 29069,
        "end": 29079
      },
      "text": "བསྒྲིབས་པ་ ༼པེ།༽ བསྒྲིབ་པ་"
    },
    {
      "span": {
        "start": 29203,
        "end": 29206
      },
      "text": "ཞན་ ༼སྣར།༽ གཞན་"
    },
    {
      "span": {
        "start": 29339,
        "end": 29344
      },
      "text": "འཐོབ་ ༼སྣར། པེ།༽ ཐོབ་"
    },
    {
      "span": {
        "start": 29351,
        "end": 29354
      },
      "text": "ནི། ༼པེ།༽ གྱི།"
    },
    {
      "span": {
        "start": 29404,
        "end": 29415
      },
      "text": "སྩོགས་ཀྱིས། ༼པེ།༽ སྩོགས་ཀྱི།"
    },
    {
      "span": {
        "start": 29568,
        "end": 29574
      },
      "text": "ནང་པར་ ༼སྣར། པེ།༽ ནངས་པར་"
    },
    {
      "span": {
        "start": 29931,
        "end": 29938
      },
      "text": "སྲུང་བ་ ༼སྣར། པེ།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 30586,
        "end": 30594
      },
      "text": "འཐོབ་པར་ ༼སྣར། པེ།༽ ཐོབ་པར་"
    },
    {
      "span": {
        "start": 30722,
        "end": 30728
      },
      "text": "ཆད་དམ་ ༼སྣར། པེ།༽ ཆད་དང་"
    },
    {
      "span": {
        "start": 31290,
        "end": 31301
      },
      "text": "དེ་བཞིན་ནོ། ༼སྣར། པེ།༽ དེ་བཞིན་ལ།"
    },
    {
      "span": {
        "start": 31320,
        "end": 31328
      },
      "text": "གསུམ་མོ། ༼སྣར།༽ གསུམ་པ།"
    },
    {
      "span": {
        "start": 31655,
        "end": 31665
      },
      "text": "རྣམས་སྨིན་ ༼སྣར། པེ།༽ རྣམ་སྨིན་"
    },
    {
      "span": {
        "start": 31795,
        "end": 31801
      },
      "text": "འདིའི་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 32014,
        "end": 32020
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 32053,
        "end": 32061
      },
      "text": "ངེས་དང་། ༼སྣར། པེ།༽ ངེས་པ།"
    },
    {
      "span": {
        "start": 32131,
        "end": 32135
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 32185,
        "end": 32190
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིས་"
    },
    {
      "span": {
        "start": 32279,
        "end": 32285
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 32471,
        "end": 32476
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིས་"
    },
    {
      "span": {
        "start": 32583,
        "end": 32586
      },
      "text": "གང་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 32694,
        "end": 32700
      },
      "text": "ངེས་པ་ ༼སྣར། པེ།༽ ངེས་པར་"
    },
    {
      "span": {
        "start": 32863,
        "end": 32870
      },
      "text": "ལས་ཀྱི་ ༼སྣར། པེ།༽ ལས་ནི་"
    },
    {
      "span": {
        "start": 32912,
        "end": 32923
      },
      "text": "མི་དགེ་བའི་ ༼སྣར། པེ།༽ མི་དགེ་བ་"
    },
    {
      "span": {
        "start": 32962,
        "end": 32969
      },
      "text": "སེམས་ལ། ༼སྣར། པེ།༽ སེམས་པ།"
    },
    {
      "span": {
        "start": 33309,
        "end": 33315
      },
      "text": "བྲལ་བ་ ༼སྣར། པེ།༽ འབྲལ་བ་"
    },
    {
      "span": {
        "start": 33315,
        "end": 33318
      },
      "text": "ཡི། ༼ཅོ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 33474,
        "end": 33478
      },
      "text": "བྲལ་ ༼སྣར། པེ།༽ འབྲལ་"
    },
    {
      "span": {
        "start": 33695,
        "end": 33700
      },
      "text": "སྤྱད་ ༼སྣར།༽ དབྱེད་ ༼པེ།༽ དཔྱད་"
    },
    {
      "span": {
        "start": 34054,
        "end": 34058
      },
      "text": "རྣམ་ ༼སྣར།༽ རྣམས་"
    },
    {
      "span": {
        "start": 34083,
        "end": 34095
      },
      "text": "རྣམ་རིག་མིན། ༼སྣར། པེ།༽ རྣམ་རིག་བྱེད།"
    },
    {
      "span": {
        "start": 34174,
        "end": 34179
      },
      "text": "མཇུག་ ༼སྣར། པེ།༽ འཇུག་"
    },
    {
      "span": {
        "start": 34297,
        "end": 34302
      },
      "text": "མཇུག་ ༼སྣར། པེ།༽ འཇུག་"
    },
    {
      "span": {
        "start": 34336,
        "end": 34342
      },
      "text": "སྐྱེས། ༼སྣར།༽ སྐྱེས་སོ།"
    },
    {
      "span": {
        "start": 34570,
        "end": 34573
      },
      "text": "ནི་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 34745,
        "end": 34749
      },
      "text": "གསད་ ༼སྣར། པེ།༽ བསད་"
    },
    {
      "span": {
        "start": 34822,
        "end": 34829
      },
      "text": "འགྲོ་བ་ ༼སྣར། པེ།༽ བགྲོད་པར་"
    },
    {
      "span": {
        "start": 35142,
        "end": 35148
      },
      "text": "ཀྱལ་པ་ ༼སྣར། པེ།༽ བཀྱལ་པ་"
    },
    {
      "span": {
        "start": 35184,
        "end": 35188
      },
      "text": "གསག་ ༼སྣར།༽ བསག་"
    },
    {
      "span": {
        "start": 35243,
        "end": 35250
      },
      "text": "ལོག་པས་ ༼སྣར། པེ།༽ ལོག་པ་"
    },
    {
      "span": {
        "start": 35290,
        "end": 35294
      },
      "text": "སྡང་ ༼སྣར། པེ།༽ ལྡང་"
    },
    {
      "span": {
        "start": 35347,
        "end": 35355
      },
      "text": "གསུམ་ལམ་ ༼སྣར། པེ།༽ གསུམ་ལས་"
    },
    {
      "span": {
        "start": 35737,
        "end": 35743
      },
      "text": "ཀྱལ་པ་ ༼སྣར། པེ།༽ བཀྱལ་པ་"
    },
    {
      "span": {
        "start": 35829,
        "end": 35836
      },
      "text": "ཡོད་དེ། ༼སྣར། པེ།༽ ཡོད་དོ།"
    },
    {
      "span": {
        "start": 36186,
        "end": 36190
      },
      "text": "རྣམ་ ༼སྣར།༽ རྣམས་"
    },
    {
      "span": {
        "start": 36287,
        "end": 36292
      },
      "text": "བསླང་ ༼སྣར། པེ།༽ སླང་"
    },
    {
      "span": {
        "start": 36335,
        "end": 36341
      },
      "text": "དག་གི། ༼སྣར། པེ།༽ དག་གིས།"
    },
    {
      "span": {
        "start": 36349,
        "end": 36355
      },
      "text": "ལྔ་ཡི་ ༼སྣར། པེ།༽ ལྔ་ཡིས་"
    },
    {
      "span": {
        "start": 36378,
        "end": 36385
      },
      "text": "བཞི་ཡི་ ༼སྣར། པེ།༽ བཞི་ཡིས་"
    },
    {
      "span": {
        "start": 36906,
        "end": 36911
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 36914,
        "end": 36919
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ གསུམ་"
    },
    {
      "span": {
        "start": 37158,
        "end": 37163
      },
      "text": "རིགས་ ༼སྣར།༽ རིམས་"
    },
    {
      "span": {
        "start": 37201,
        "end": 37214
      },
      "text": "ཉམས་པའང་ཞེའོ། ༼སྣར། པེ།༽ ཉམས་པའང་ཞེས།"
    },
    {
      "span": {
        "start": 37258,
        "end": 37263
      },
      "text": "ཕྱེད་ ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 37479,
        "end": 37483
      },
      "text": "ཡོད། ༼སྣར། པེ།༽ འདོད།"
    },
    {
      "span": {
        "start": 37485,
        "end": 37489
      },
      "text": "ཟ་མ་ ༼སྣར།༽ ཟ་མ་ལ་"
    },
    {
      "span": {
        "start": 37697,
        "end": 37703
      },
      "text": "དེ་དང་ ༼པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 37873,
        "end": 37881
      },
      "text": "བྱེ་བའོ་ ༼སྣར།༽ བྱེད་པའོ་"
    },
    {
      "span": {
        "start": 37915,
        "end": 37921
      },
      "text": "དབྱེན་ ༼སྣར། པེ།༽ དབེན་"
    },
    {
      "span": {
        "start": 37953,
        "end": 37962
      },
      "text": "སོགས་ཀྱི། ༼སྣར། པེ།༽ སོགས་ཀྱིས།"
    },
    {
      "span": {
        "start": 38028,
        "end": 38032
      },
      "text": "མཐའ་ ༼པེ།༽ མཐའི་"
    },
    {
      "span": {
        "start": 38208,
        "end": 38217
      },
      "text": "གྱུར་ཀྱང་ ༼སྣར། པེ།༽ གྱུར་དང་"
    },
    {
      "span": {
        "start": 38225,
        "end": 38231
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་ཞིག་"
    },
    {
      "span": {
        "start": 38241,
        "end": 38248
      },
      "text": "བྱུང་མ། ༼པེ།༽ བྱུང་བ།"
    },
    {
      "span": {
        "start": 38689,
        "end": 38694
      },
      "text": "གེགས་ ༼སྣར། པེ།༽ བགེགས་"
    },
    {
      "span": {
        "start": 38797,
        "end": 38801
      },
      "text": "ཕོར་ ༼སྣར། པེ།༽ ཕོ་"
    },
    {
      "span": {
        "start": 38845,
        "end": 38850
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 38966,
        "end": 38971
      },
      "text": "སྐྱེ། ༼སྣར། པེ།༽ སྐྱེས།"
    },
    {
      "span": {
        "start": 39070,
        "end": 39083
      },
      "text": "སྙིང་རྗེ་ཡིས། ༼པེ།༽ སྙིང་རྗེ་ཡིན།"
    },
    {
      "span": {
        "start": 39148,
        "end": 39155
      },
      "text": "འཁྲུགས་ ༼སྣར། པེ།༽ འཁྲུག་"
    },
    {
      "span": {
        "start": 39179,
        "end": 39183
      },
      "text": "སྐར་ ༼པེ།༽ སྐལ་"
    },
    {
      "span": {
        "start": 39386,
        "end": 39389
      },
      "text": "དེ་ ༼སྣར། པེ།༽ བདེ་"
    },
    {
      "span": {
        "start": 39734,
        "end": 39745
      },
      "text": "གཞོན་ཤ་དང་། ༼སྣར། པེ།༽ གཞོན་ཤ་ཅན།"
    },
    {
      "span": {
        "start": 39846,
        "end": 39849
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 39857,
        "end": 39866
      },
      "text": "གྲོལ་བའམ། ༼སྣར། པེ།༽ གྲོལ་བ་ལམ།"
    },
    {
      "span": {
        "start": 40020,
        "end": 40024
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 40494,
        "end": 40499
      },
      "text": "འཕེན་ ༼སྣར། པེ།༽ འཕན་"
    },
    {
      "span": {
        "start": 40509,
        "end": 40512
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 40523,
        "end": 40526
      },
      "text": "ཞི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 40528,
        "end": 40533
      },
      "text": "རྟེན། ༼སྣར། པེ།༽ བརྟེན།"
    },
    {
      "span": {
        "start": 40578,
        "end": 40582
      },
      "text": "སྒོ་ ༼སྣར། པེ།༽ སྒོམ་"
    },
    {
      "span": {
        "start": 40645,
        "end": 40651
      },
      "text": "གཙོའི་ ༼སྣར། པེ།༽ བཙོའི་"
    },
    {
      "span": {
        "start": 40674,
        "end": 40682
      },
      "text": "དགའ་གནས་ ༼སྣར། པེ།༽ དགའ་བའི་"
    },
    {
      "span": {
        "start": 40880,
        "end": 40885
      },
      "text": "སློང་ ༼སྣར།༽ ཀློང་"
    },
    {
      "span": {
        "start": 40943,
        "end": 40951
      },
      "text": "གོ་རིམས་ ༼སྣར།༽ གོ་རིམ་"
    },
    {
      "span": {
        "start": 41034,
        "end": 41040
      },
      "text": "བསྟེན་ ༼སྣར།༽ བསྟན་"
    },
    {
      "span": {
        "start": 41336,
        "end": 41341
      },
      "text": "བལྟས་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 41898,
        "end": 41902
      },
      "text": "དམན་ ༼སྣར། པེ།༽ དམའ་"
    },
    {
      "span": {
        "start": 41934,
        "end": 41941
      },
      "text": "དེར་ལྟ་ ༼སྣར། པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 42128,
        "end": 42137
      },
      "text": "ལོག་ཕྱིར་ ༼སྣར། པེ།༽ ལོག་པ་"
    },
    {
      "span": {
        "start": 42292,
        "end": 42297
      },
      "text": "གསོད་ ༼སྣར། པེ།༽ གཅོད་"
    },
    {
      "span": {
        "start": 42310,
        "end": 42316
      },
      "text": "དཀྲིས་ ༼སྣར། པེ།༽ བཀྲིས་"
    },
    {
      "span": {
        "start": 42720,
        "end": 42727
      },
      "text": "ལྡན་དང་ ༼སྣར། པེ།༽ ལྡན་པ་"
    },
    {
      "span": {
        "start": 42844,
        "end": 42855
      },
      "text": "ལམ་ནི་དེའི། ༼སྣར། པེ།༽ ལམ་དེ་ཡི།"
    },
    {
      "span": {
        "start": 42857,
        "end": 42867
      },
      "text": "སྤྱོད་ཡུལ་ ༼སྣར། པེ།༽ སྤྱོད་ཚུལ་"
    },
    {
      "span": {
        "start": 43307,
        "end": 43315
      },
      "text": "མ་རིག་པ། ༼སྣར། པེ།༽ མ་རིག་པའང་།"
    },
    {
      "span": {
        "start": 43469,
        "end": 43474
      },
      "text": "མཐོར་ ༼སྣར། པེ།༽ འཐོར་"
    },
    {
      "span": {
        "start": 43610,
        "end": 43617
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 43642,
        "end": 43645
      },
      "text": "དང་ ༼སྣར། པེ།༽ བར་"
    },
    {
      "span": {
        "start": 44304,
        "end": 44314
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 44583,
        "end": 44589
      },
      "text": "སྐྱེས་ ༼སྣར། པེ།༽ སྐྱེ་"
    },
    {
      "span": {
        "start": 44672,
        "end": 44677
      },
      "text": "གླགས་ ༼སྣར། པེ།༽ ཀླག་"
    },
    {
      "span": {
        "start": 44776,
        "end": 44780
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 45478,
        "end": 45482
      },
      "text": "རྣམ་ ༼སྣར།༽ རྣམས་"
    },
    {
      "span": {
        "start": 45617,
        "end": 45625
      },
      "text": "འབྲང་བས་ ༼སྣར། པེ།༽ འབྲང་བ་"
    },
    {
      "span": {
        "start": 45711,
        "end": 45716
      },
      "text": "འབྱར་ ༼སྣར།༽ འབྱོར་"
    },
    {
      "span": {
        "start": 45800,
        "end": 45809
      },
      "text": "སོགས་ཀྱི། ༼སྣར། པེ།༽ སོགས་ཀྱིས།"
    },
    {
      "span": {
        "start": 46110,
        "end": 46116
      },
      "text": "རྩ་བས་ ༼སྣར། པེ།༽ རྩ་བ་"
    },
    {
      "span": {
        "start": 47188,
        "end": 47191
      },
      "text": "དང་ ༼སྣར། པེ།༽ ནང་"
    },
    {
      "span": {
        "start": 47218,
        "end": 47225
      },
      "text": "ཚངས་པས་ ༼སྣར། པེ།༽ ཚངས་པ་"
    },
    {
      "span": {
        "start": 47314,
        "end": 47319
      },
      "text": "གཉིད་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 47761,
        "end": 47773
      },
      "text": "འཆབ་དང་གཉིས། ༼སྣར། པེ།༽ འཆབ་པ་ཉིད།"
    },
    {
      "span": {
        "start": 47785,
        "end": 47802
      },
      "text": "ལྡན་བདེ་དག་དང་། ། ༼སྣར། པེ།༽ ལྡན་པ་དེ་དག །"
    },
    {
      "span": {
        "start": 48240,
        "end": 48244
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 49019,
        "end": 49022
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 49340,
        "end": 49350
      },
      "text": "དང་བསྒོམས་ ༼སྣར། པེ།༽ ཞིང་བསྒོམ་"
    },
    {
      "span": {
        "start": 49401,
        "end": 49413
      },
      "text": "རྣམ་གཉིས་ཏེ། ༼སྣར། པེ།༽ རྣམ་པ་གཉིས།"
    },
    {
      "span": {
        "start": 49688,
        "end": 49696
      },
      "text": "བློ་ཡིས་ ༼སྣར། པེ།༽ བློ་ཡི་"
    },
    {
      "span": {
        "start": 49897,
        "end": 49903
      },
      "text": "བསྲིང་ ༼སྣར། པེ།༽ བསྲིངས་"
    },
    {
      "span": {
        "start": 50044,
        "end": 50048
      },
      "text": "ཁམས་ ༼སྣར། པེ།༽ ཁམ་"
    },
    {
      "span": {
        "start": 50267,
        "end": 50269
      },
      "text": "པ། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 50320,
        "end": 50324
      },
      "text": "ལྷག་ ༼སྣར། པེ།༽ ལྷགས་"
    },
    {
      "span": {
        "start": 50575,
        "end": 50584
      },
      "text": "སྐྱེད་དོ། ༼སྣར། པེ།༽ སྐྱེད་བསྐྱེད་།"
    },
    {
      "span": {
        "start": 50660,
        "end": 50668
      },
      "text": "ཕྱི་བའི་ ༼སྣར། པེ།༽ ཕྱི་མའི་"
    },
    {
      "span": {
        "start": 50813,
        "end": 50821
      },
      "text": "མ་རྟོགས་ ༼སྣར། པེ།༽ མི་གཏོགས་"
    },
    {
      "span": {
        "start": 51162,
        "end": 51165
      },
      "text": "ལྟ། ༼སྣར། པེ།༽ ལྟའོ།"
    },
    {
      "span": {
        "start": 51373,
        "end": 51382
      },
      "text": "ཆོས་ཀྱིས་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 51756,
        "end": 51761
      },
      "text": "ཡོངས་ ༼སྣར། པེ།༽ འོངས་"
    },
    {
      "span": {
        "start": 51818,
        "end": 51821
      },
      "text": "ཚེ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 52493,
        "end": 52498
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 53094,
        "end": 53104
      },
      "text": "བསྒོམ་སྤང་ ༼སྣར། པེ།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 53104,
        "end": 53107
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱ་སྤང་"
    },
    {
      "span": {
        "start": 53114,
        "end": 53121
      },
      "text": "རེ་ལྟར་ ༼སྣར།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 53534,
        "end": 53543
      },
      "text": "ཕྱེད་འཕར་ ༼སྣར། པེ།༽ བྱེད་མཐར་"
    },
    {
      "span": {
        "start": 53672,
        "end": 53684
      },
      "text": "གཟུགས་སུ་ཉེ་ ༼ཅོ།༽ གཟུགས་ཉེ་ ༼སྣར། པེ།༽ གཟུགས་སུ་ཉེར་"
    },
    {
      "span": {
        "start": 53855,
        "end": 53863
      },
      "text": "ཕྱིར་དེ། ༼སྣར། པེ།༽ ཕྱིར་ཏེ།"
    },
    {
      "span": {
        "start": 53924,
        "end": 53930
      },
      "text": "དེ་དང་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 53973,
        "end": 53978
      },
      "text": "སྟེན། ༼སྣར། པེ།༽ བསྟེན།"
    },
    {
      "span": {
        "start": 54029,
        "end": 54034
      },
      "text": "གྲུབ། ༼སྣར།༽ འགྲུབ ༼པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 54170,
        "end": 54175
      },
      "text": "འོངས། ༼སྡེ། ཅོ།༽ འོང་།"
    },
    {
      "span": {
        "start": 54221,
        "end": 54226
      },
      "text": "བར་ཆ་ ༼སྣར།༽ བར་ཆད་"
    },
    {
      "span": {
        "start": 54382,
        "end": 54391
      },
      "text": "འདས་ཀྱིས་ ༼སྣར། པེ།༽ འདས་ཀྱི་"
    },
    {
      "span": {
        "start": 54405,
        "end": 54414
      },
      "text": "ཆགས་འབྲལ་ ༼སྣར།༽ ཆགས་བྲལ་"
    },
    {
      "span": {
        "start": 54689,
        "end": 54693
      },
      "text": "བསམ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 54706,
        "end": 54713
      },
      "text": "བསྡོགས་ ༼པེ།༽ སྔོགས་"
    },
    {
      "span": {
        "start": 54747,
        "end": 54754
      },
      "text": "བསྡོགས་ ༼སྣར། པེ།༽ སྔོགས་"
    },
    {
      "span": {
        "start": 54987,
        "end": 54992
      },
      "text": "སློབ་ ༼སྣར། པེ།༽ ཤེས་"
    },
    {
      "span": {
        "start": 55122,
        "end": 55127
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 55558,
        "end": 55563
      },
      "text": "འདིར་ ༼སྣར། པེ།༽ འདིས་"
    },
    {
      "span": {
        "start": 55861,
        "end": 55863
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལས།"
    },
    {
      "span": {
        "start": 55869,
        "end": 55875
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 55991,
        "end": 56000
      },
      "text": "གསུམ་ཤེས་ ༼སྣར། པེ།༽ གསུམ་ཞེས་"
    },
    {
      "span": {
        "start": 56230,
        "end": 56236
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 56273,
        "end": 56275
      },
      "text": "བ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 56567,
        "end": 56572
      },
      "text": "འཇུག་ ༼སྣར།༽ མཇུག་"
    },
    {
      "span": {
        "start": 56750,
        "end": 56756
      },
      "text": "དག་གི་ ༼པེ།༽ དག་གིས་"
    },
    {
      "span": {
        "start": 56764,
        "end": 56767
      },
      "text": "སླ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 56823,
        "end": 56835
      },
      "text": "ཅིག་ཤོས་ཀྱི་ ༼སྣར། པེ།༽ ཅིག་ཤོས་ཀྱིས་"
    },
    {
      "span": {
        "start": 57225,
        "end": 57233
      },
      "text": "གོ་རིམས་ ༼སྣར། པེ།༽ གོ་རིམ་"
    },
    {
      "span": {
        "start": 57243,
        "end": 57252
      },
      "text": "ནི་དང་པོ་ ༼སྣར།༽ ནི་དངོས་"
    },
    {
      "span": {
        "start": 57576,
        "end": 57587
      },
      "text": "སྲིད་རྩེ་ན། ༼སྣར། པེ།༽ སྲིད་རྩེ་ནས།"
    },
    {
      "span": {
        "start": 57640,
        "end": 57645
      },
      "text": "འཐོབ། ༼པེ།༽ ཐོབ།"
    },
    {
      "span": {
        "start": 57979,
        "end": 57987
      },
      "text": "བཤད་ཅེས་ ༼སྣར། པེ།༽ བཤད་ཤེས་"
    },
    {
      "span": {
        "start": 58183,
        "end": 58186
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 58220,
        "end": 58224
      },
      "text": "གཞི། ༼སྣར།༽ བཞི།"
    },
    {
      "span": {
        "start": 58294,
        "end": 58302
      },
      "text": "ཀུན་གྱི་ ༼སྣར། པེ།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 58327,
        "end": 58334
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 58357,
        "end": 58371
      },
      "text": "མངོན་པའི་མཛོད་ ༼སྣར།༽ མངོན་པ་མཛད་ ༼པེ།༽ མངོན་པ་མཛོད་"
    },
    {
      "span": {
        "start": 58418,
        "end": 58427
      },
      "text": "བྱ་བ་སྟེ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 58457,
        "end": 58466
      },
      "text": "རྣམས་ཤེས་ ༼སྣར། པེ།༽ རྣམ་ཤེས་"
    },
    {
      "span": {
        "start": 58468,
        "end": 58472
      },
      "text": "མིན། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 58989,
        "end": 58998
      },
      "text": "སྐྱེས་མི་ ༼སྣར། པེ།༽ སྐྱེས་མ་"
    },
    {
      "span": {
        "start": 59116,
        "end": 59123
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 59129,
        "end": 59135
      },
      "text": "ཟད་པར་ ༼སྣར། པེ།༽ ཟད་པ་"
    },
    {
      "span": {
        "start": 59164,
        "end": 59173
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 59180,
        "end": 59204
      },
      "text": "། །ཡོངས་ཤེས་བྱར་མེད་ཅེས་ ༼སྣར། པེ།༽ ཡོངས་ཤེས་བྱ་བ་མེད་"
    },
    {
      "span": {
        "start": 59226,
        "end": 59230
      },
      "text": "བློ་ ༼སྣར། པེ།༽ བློར་"
    },
    {
      "span": {
        "start": 59589,
        "end": 59628
      },
      "text": "དྲི་མེད་ཀྱང་། །དེ་བཞིན་དྲི་མ་དང་བཅས་ནི། ༼པེ།༽ དྲི་མེད་ཀྱང་།"
    },
    {
      "span": {
        "start": 59630,
        "end": 59637
      },
      "text": "ཤེས་བྱ་ ༼སྣར། པེ།༽ ཤེས་བྱའི་"
    },
    {
      "span": {
        "start": 59651,
        "end": 59655
      },
      "text": "རྣམ། ༼སྣར། པེ།༽ རྣམས།"
    },
    {
      "span": {
        "start": 59761,
        "end": 59765
      },
      "text": "རྣམ་ ༼པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 59911,
        "end": 59917
      },
      "text": "དང་པོ་ ༼སྣར། པེ།༽ དབང་པོ་"
    },
    {
      "span": {
        "start": 59969,
        "end": 59989
      },
      "text": "ན་ཆོས་ཤེས་བྱ་བར་དགུ། ༼སྣར། པེ།༽ ཆོས་ཤེས་བྱ་དགུ་ན།"
    },
    {
      "span": {
        "start": 60041,
        "end": 60045
      },
      "text": "བཞི། ༼སྣར། པེ།༽ བཞིན།"
    },
    {
      "span": {
        "start": 60292,
        "end": 60298
      },
      "text": "བློའི་ ༼སྣར། པེ།༽ བློ་"
    },
    {
      "span": {
        "start": 60923,
        "end": 60931
      },
      "text": "འཐོབ་བོ། ༼སྣར། པེ།༽ ཐོབ་པོ།"
    },
    {
      "span": {
        "start": 60989,
        "end": 60993
      },
      "text": "པའི། ༼སྣར། པེ།༽ པའོ་"
    },
    {
      "span": {
        "start": 61143,
        "end": 61152
      },
      "text": "སྲིད་རྩེ་ ༼སྣར། པེ།༽ སྲིད་རྩེའི་"
    },
    {
      "span": {
        "start": 61168,
        "end": 61173
      },
      "text": "ཟད་པ་ ༼སྣར། པེ།༽ ཟད་པའི་"
    },
    {
      "span": {
        "start": 61391,
        "end": 61401
      },
      "text": "བསྟེན་ཞེས་ ༼སྣར། པེ།༽ བསྟན་ཅེས་"
    },
    {
      "span": {
        "start": 61453,
        "end": 61459
      },
      "text": "བསྲིང་ ༼སྣར། པེ།༽ སྲིང་"
    },
    {
      "span": {
        "start": 61757,
        "end": 61763
      },
      "text": "ལྷག་མ་ ༼སྣར། པེ།༽ ལྷག་པ་"
    },
    {
      "span": {
        "start": 61861,
        "end": 61869
      },
      "text": "དག་ཚིགས་ ༼སྣར། པེ།༽ དང་ཚིག་"
    },
    {
      "span": {
        "start": 61886,
        "end": 61900
      },
      "text": "བདུན་ཅུས་བླགས་ ༼སྣར། པེ།༽ བདུན་ཅུ་གླགས་"
    },
    {
      "span": {
        "start": 62138,
        "end": 62142
      },
      "text": "ཆེས་ ༼སྣར། པེ།༽ ཆས་"
    },
    {
      "span": {
        "start": 62320,
        "end": 62324
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ མིན།"
    },
    {
      "span": {
        "start": 62396,
        "end": 62400
      },
      "text": "རིག་ ༼སྣར།༽ རིགས་"
    },
    {
      "span": {
        "start": 62475,
        "end": 62481
      },
      "text": "སྐྱེས་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 62513,
        "end": 62518
      },
      "text": "གཞིར་ ༼སྣར།༽ བཞིར་"
    },
    {
      "span": {
        "start": 62690,
        "end": 62699
      },
      "text": "ཐོགས་མེད་ ༼སྣར། པེ།༽ ཐོག་མེད་"
    },
    {
      "span": {
        "start": 63092,
        "end": 63097
      },
      "text": "རྣ་བ་ ༼སྣར། པེ།༽ རྣམ་པ་"
    },
    {
      "span": {
        "start": 63320,
        "end": 63324
      },
      "text": "ཡུལ་ ༼སྣར། པེ།༽ ཡུན་"
    },
    {
      "span": {
        "start": 63485,
        "end": 63490
      },
      "text": "སྔོན་ ༼སྣར། པེ།༽ མངོན་"
    },
    {
      "span": {
        "start": 63561,
        "end": 63563
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 63628,
        "end": 63634
      },
      "text": "ན་རིག་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 63634,
        "end": 63636
      },
      "text": "མ་ ༼སྣར། པེ།༽ མ་རིག་"
    },
    {
      "span": {
        "start": 63701,
        "end": 63712
      },
      "text": "འཁྲུལ་ཕྱིར་ ༼སྣར། པེ།༽ འཕྲུལ་ཕྱི་"
    },
    {
      "span": {
        "start": 64061,
        "end": 64069
      },
      "text": "དེ་རྙེད་ ༼སྣར། པེ།༽ དེ་སྙེད་"
    },
    {
      "span": {
        "start": 64250,
        "end": 64256
      },
      "text": "བརླབས་ ༼སྣར། པེ།༽ བརླབ་"
    },
    {
      "span": {
        "start": 64289,
        "end": 64295
      },
      "text": "དང་པོ་ ༼སྣར། པེ།༽ དང་པོར་"
    },
    {
      "span": {
        "start": 64342,
        "end": 64349
      },
      "text": "བསྒོམས་ ༼སྣར། པེ།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 64519,
        "end": 64524
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ སྟེན་"
    },
    {
      "span": {
        "start": 64715,
        "end": 64719
      },
      "text": "གང་། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 65038,
        "end": 65054
      },
      "text": "སྔ་སྔ་སྤངས་པ་ཡི། ༼སྣར།༽ ལྔ་ལྔ་སྤང་བ་ཡིན ༼པེ།༽ སྔ་སྔ་སྤང་བ་ཡིན།"
    },
    {
      "span": {
        "start": 65120,
        "end": 65127
      },
      "text": "བསྡོགས་ ༼སྣར།༽ བསྡོམས་"
    },
    {
      "span": {
        "start": 65802,
        "end": 65807
      },
      "text": "རྣམས། ༼སྣར། པེ།༽ གནས།"
    },
    {
      "span": {
        "start": 66259,
        "end": 66263
      },
      "text": "ཡོད། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 66427,
        "end": 66432
      },
      "text": "འཐོབ། ༼སྣར། པེ།༽ ཐོབ།"
    },
    {
      "span": {
        "start": 66547,
        "end": 66554
      },
      "text": "སྐྱེའོ་ ༼སྣར། པེ།༽ སྐྱེ་བོས་"
    },
    {
      "span": {
        "start": 66663,
        "end": 66669
      },
      "text": "འཕོའི་ ༼སྣར། པེ།༽ འཕོ་"
    },
    {
      "span": {
        "start": 66820,
        "end": 66827
      },
      "text": "མཐུན་པ། ༼སྣར། པེ།༽ མཐུན་པའོ།"
    },
    {
      "span": {
        "start": 66926,
        "end": 66930
      },
      "text": "རྒལ་ ༼སྣར། པེ།༽ བརྒལ་"
    },
    {
      "span": {
        "start": 66951,
        "end": 66956
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིས་"
    },
    {
      "span": {
        "start": 66985,
        "end": 66989
      },
      "text": "རྒལ་ ༼སྣར། པེ།༽ བརྒལ་"
    },
    {
      "span": {
        "start": 67083,
        "end": 67092
      },
      "text": "འཕགས་པའི་ ༼སྣར། པེ།༽ འཕགས་པ་"
    },
    {
      "span": {
        "start": 67145,
        "end": 67150
      },
      "text": "སྲེད་ ༼སྣར། པེ།༽ སྲིད་"
    },
    {
      "span": {
        "start": 67293,
        "end": 67299
      },
      "text": "བཟློག་ ༼སྣར། པེ།༽ སྡོགས་"
    },
    {
      "span": {
        "start": 67327,
        "end": 67333
      },
      "text": "བཟློག་ ༼སྣར། པེ།༽ སྡོགས་"
    },
    {
      "span": {
        "start": 67436,
        "end": 67454
      },
      "text": "བདེ་མིན་སྡུག་བསྔལ་ ༼སྣར། པེ།༽ དེ་བདེ་མི་སྡུག་"
    },
    {
      "span": {
        "start": 67856,
        "end": 67862
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བཏགས་"
    },
    {
      "span": {
        "start": 67899,
        "end": 67906
      },
      "text": "བསྡོགས་ ༼སྣར། པེ།༽ སྡོགས་"
    },
    {
      "span": {
        "start": 67973,
        "end": 67980
      },
      "text": "སྒོམ་པ་ ༼སྣར། པེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 68107,
        "end": 68113
      },
      "text": "བསྒོམ། ༼སྣར། པེ།༽ སྒོམ།"
    },
    {
      "span": {
        "start": 68311,
        "end": 68315
      },
      "text": "སྙམ་ ༼སྣར། པེ།༽ མཉམ་"
    },
    {
      "span": {
        "start": 68436,
        "end": 68445
      },
      "text": "སྐྱེད་དེ་ ༼སྣར། པེ།༽ སྐྱེད་དོ་"
    },
    {
      "span": {
        "start": 68603,
        "end": 68608
      },
      "text": "ཕྲ་བ་ ༼སྣར། པེ།༽ ཕྲ་བའི་"
    },
    {
      "span": {
        "start": 68691,
        "end": 68702
      },
      "text": "འདོད་གཏོགས་ ༼སྣར། པེ།༽ འདོད་ཆགས་"
    },
    {
      "span": {
        "start": 68862,
        "end": 68867
      },
      "text": "བཞིན། ༼སྣར། པེ།༽ གཉིས།"
    },
    {
      "span": {
        "start": 68884,
        "end": 68892
      },
      "text": "བཞིན་དེ་ ༼སྣར། པེ།༽ བཞིན་ནོ་"
    },
    {
      "span": {
        "start": 69206,
        "end": 69216
      },
      "text": "ཀྱིས་སྐྱེ། ༼སྣར།༽ ཀྱིས་སྟེ།"
    },
    {
      "span": {
        "start": 69743,
        "end": 69748
      },
      "text": "རྟོག་ ༼སྣར།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 70189,
        "end": 70192
      },
      "text": "ཛི་ ༼པེ།༽ འཛི་"
    }
  ]
}