{
  "durchens": [
    {
      "span": {
        "start": 824,
        "end": 834
      },
      "text": "སྒྲིབ་པའོ། ༼སྣར། པེ།༽ སྒྲིབ་པ།"
    },
    {
      "span": {
        "start": 843,
        "end": 852
      },
      "text": "བརྟགས་པས་ ༼སྣར། པེ།༽ བཏགས་པས་"
    },
    {
      "span": {
        "start": 869,
        "end": 873
      },
      "text": "བའོ་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 2182,
        "end": 2189
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 2453,
        "end": 2458
      },
      "text": "བྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 2713,
        "end": 2718
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 2893,
        "end": 2900
      },
      "text": "མི་ཆེས་ ༼སྣར།༽ ནི་ཆོས་ ༼པེ།༽ ནི་ཆེས་"
    },
    {
      "span": {
        "start": 3148,
        "end": 3151
      },
      "text": "དག་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 4064,
        "end": 4070
      },
      "text": "གཡེང་། ༼སྣར།༽ གཡང་།"
    },
    {
      "span": {
        "start": 4140,
        "end": 4145
      },
      "text": "ཕྱེད་ ༼སྣར།༽ བྱེད་"
    },
    {
      "span": {
        "start": 4611,
        "end": 4615
      },
      "text": "ལྡན་ ༼སྣར། པེ།༽ ལྷན་"
    },
    {
      "span": {
        "start": 4767,
        "end": 4774
      },
      "text": "སྟེན་པ་ ༼སྣར། པེ།༽ བསྟེན་པ་"
    },
    {
      "span": {
        "start": 4781,
        "end": 4787
      },
      "text": "ལྷག་མ་ ༼སྣར། པེ།༽ ལྷག་པ་"
    },
    {
      "span": {
        "start": 4826,
        "end": 4832
      },
      "text": "རང་གི་ ༼སྣར། པེ།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 5105,
        "end": 5110
      },
      "text": "སྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 5605,
        "end": 5609
      },
      "text": "པའང་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 5911,
        "end": 5927
      },
      "text": "བསྟན་པ་ཞེས་བྱ་བ་ ༼ཅོ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 5996,
        "end": 6001
      },
      "text": "ལ་ལོ། ༼སྣར། པེ།༽ ལའོ།"
    },
    {
      "span": {
        "start": 6156,
        "end": 6159
      },
      "text": "ཕོ་ ༼སྣར། པེ།༽ ཕོའི་"
    },
    {
      "span": {
        "start": 6167,
        "end": 6171
      },
      "text": "རིས་ ༼སྡེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 6786,
        "end": 6793
      },
      "text": "ཡིད་མི་ ༼པེ།༽ ཡིད་ནི་"
    },
    {
      "span": {
        "start": 7326,
        "end": 7329
      },
      "text": "དང་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 7351,
        "end": 7361
      },
      "text": "གཉིས་ཀྱིས་ ༼ཅོ།༽ གཉིས་ཀྱི་ ༼སྣར། པེ།༽ ཡིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 7441,
        "end": 7444
      },
      "text": "པར་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 7475,
        "end": 7480
      },
      "text": "རྫུས་ ༼སྣར། པེ།༽ བརྫུས་"
    },
    {
      "span": {
        "start": 7579,
        "end": 7582
      },
      "text": "ནི། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 8647,
        "end": 8651
      },
      "text": "དྲན། ༼པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 9019,
        "end": 9024
      },
      "text": "སྒྱུ་ ༼སྣར། པེ།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 9115,
        "end": 9121
      },
      "text": "དཔྱོད་ ༼སྣར། པེ།༽ སྤྱོད་"
    },
    {
      "span": {
        "start": 9177,
        "end": 9185
      },
      "text": "འགྱོད་པ་ ༼སྣར། པེ།༽ འགྱོད་པས་"
    },
    {
      "span": {
        "start": 9404,
        "end": 9415
      },
      "text": "དེ་བསྣན་ནོ། ༼སྣར། པེ།༽ དེས་བསྟན་ཏོ།"
    },
    {
      "span": {
        "start": 9420,
        "end": 9423
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 9939,
        "end": 9941
      },
      "text": "པ་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 10009,
        "end": 10017
      },
      "text": "རྙེད་དང་ ༼སྣར། པེ།༽ རྙེད་པ་"
    },
    {
      "span": {
        "start": 10191,
        "end": 10197
      },
      "text": "རྣམ་པ་ ༼སྣར། པེ།༽ རྣམས་ནི་"
    },
    {
      "span": {
        "start": 10439,
        "end": 10443
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 10796,
        "end": 10806
      },
      "text": "གཅིག་འཐོབ། ༼སྣར། པེ།༽ ཅིག་ཐོབ།"
    },
    {
      "span": {
        "start": 10958,
        "end": 10961
      },
      "text": "བྱ། ༼སྣར།༽ བྱས།"
    },
    {
      "span": {
        "start": 11003,
        "end": 11007
      },
      "text": "ཐོབ་ ༼སྣར། པེ།༽ འཐོབ་"
    },
    {
      "span": {
        "start": 11197,
        "end": 11203
      },
      "text": "སྐྱེས་ ༼སྣར། པེ།༽ སྐྱེ་"
    },
    {
      "span": {
        "start": 11461,
        "end": 11472
      },
      "text": "གསུམ་པ་སྟེ་ ༼སྣར། པེ།༽ གསུམ་པ་དེ་"
    },
    {
      "span": {
        "start": 11941,
        "end": 11949
      },
      "text": "རང་རིགས་ ༼སྣར། པེ།༽ རང་"
    },
    {
      "span": {
        "start": 12036,
        "end": 12044
      },
      "text": "དེ་གཉིས་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 12064,
        "end": 12069
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 12190,
        "end": 12195
      },
      "text": "རང་ས་ ༼སྣར། པེ།༽ རང་སར་"
    },
    {
      "span": {
        "start": 12204,
        "end": 12207
      },
      "text": "སྔ། ༼སྣར། པེ།༽ ལྔ།"
    },
    {
      "span": {
        "start": 12894,
        "end": 12900
      },
      "text": "དང་པོ་ ༼སྣར། པེ།༽ དང་པོར་"
    },
    {
      "span": {
        "start": 12971,
        "end": 12977
      },
      "text": "སྐྱེས། ༼སྣར། པེ།༽ སྐྱེ།"
    },
    {
      "span": {
        "start": 13197,
        "end": 13200
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱར་"
    },
    {
      "span": {
        "start": 13236,
        "end": 13238
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལས།"
    },
    {
      "span": {
        "start": 13321,
        "end": 13329
      },
      "text": "བཞི་ཡིས་ ༼སྣར། པེ།༽ བཞི་ཡི་"
    },
    {
      "span": {
        "start": 13408,
        "end": 13413
      },
      "text": "སྐྱེ། ༼སྣར། པེ།༽ སྐྱེས།"
    },
    {
      "span": {
        "start": 13561,
        "end": 13565
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 13600,
        "end": 13610
      },
      "text": "བསྒྲིབས་པ་ ༼སྣར། པེ།༽ སྒྲིབ་པ་"
    },
    {
      "span": {
        "start": 13829,
        "end": 13834
      },
      "text": "མཇུག་ ༼སྣར། པེ།༽ འཇུག་"
    },
    {
      "span": {
        "start": 13893,
        "end": 13901
      },
      "text": "ཡི་མཇུག་ ༼སྣར།༽ ནི་འཇུག་ ༼པེ།༽ ནི་མཇུག་"
    },
    {
      "span": {
        "start": 13930,
        "end": 13933
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དྲུག་"
    },
    {
      "span": {
        "start": 14012,
        "end": 14015
      },
      "text": "ལོ་ ༼སྣར།༽ ལ་"
    },
    {
      "span": {
        "start": 14885,
        "end": 14892
      },
      "text": "རྟེན་པ་ ༼སྣར། པེ།༽ བརྟེན་པ་"
    },
    {
      "span": {
        "start": 15552,
        "end": 15559
      },
      "text": "མངལ་ནས་ ༼སྣར། པེ།༽ མངལ་ན་"
    },
    {
      "span": {
        "start": 15730,
        "end": 15737
      },
      "text": "བྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 15807,
        "end": 15809
      },
      "text": "ན་ ༼སྣར།༽ ནི་"
    },
    {
      "span": {
        "start": 15856,
        "end": 15861
      },
      "text": "བྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 15899,
        "end": 15909
      },
      "text": "ལྔར་གསུངས་ ༼སྣར། པེ།༽ སྔར་གསུང་"
    },
    {
      "span": {
        "start": 16638,
        "end": 16643
      },
      "text": "འཕངས་ ༼སྣར། པེ།༽ ཕངས་"
    },
    {
      "span": {
        "start": 16648,
        "end": 16657
      },
      "text": "རིམ་གྱིས་ ༼སྣར། པེ།༽ རིམ་གྱི་"
    },
    {
      "span": {
        "start": 16892,
        "end": 16897
      },
      "text": "མངོན་ ༼སྣར། པེ།༽ སྔོན་"
    },
    {
      "span": {
        "start": 17369,
        "end": 17377
      },
      "text": "འདོད་ལོ། ༼སྣར།༽ འདོད་དོ།"
    },
    {
      "span": {
        "start": 17497,
        "end": 17501
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 17803,
        "end": 17808
      },
      "text": "རྫུན་ ༼སྣར། པེ།༽ བརྫུན་"
    },
    {
      "span": {
        "start": 17885,
        "end": 17891
      },
      "text": "དེ་དང་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 17955,
        "end": 17959
      },
      "text": "མིན་ ༼སྣར། པེ།༽ མིང་"
    },
    {
      "span": {
        "start": 18147,
        "end": 18153
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 18225,
        "end": 18232
      },
      "text": "དེ་ཡིད་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 18707,
        "end": 18711
      },
      "text": "རྩྭ་ ༼སྣར། པེ།༽ རྩ་"
    },
    {
      "span": {
        "start": 18818,
        "end": 18822
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 18934,
        "end": 18938
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 18943,
        "end": 18946
      },
      "text": "པོ་ ༼སྣར། པེ།༽ མོ་"
    },
    {
      "span": {
        "start": 19109,
        "end": 19119
      },
      "text": "དང་སེམས་པ་ ༼སྣར། པེ།༽ དང་སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 19154,
        "end": 19156
      },
      "text": "ན། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 19162,
        "end": 19165
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 19240,
        "end": 19247
      },
      "text": "རྟེན་པ་ ༼སྣར། པེ།༽ བསྟེན་པ་"
    },
    {
      "span": {
        "start": 19330,
        "end": 19334
      },
      "text": "འཆད་ ༼སྣར།༽ ཆད་"
    },
    {
      "span": {
        "start": 19510,
        "end": 19518
      },
      "text": "འོག་མའི་ ༼སྣར། པེ།༽ འོག་མིན་"
    },
    {
      "span": {
        "start": 20129,
        "end": 20133
      },
      "text": "བལྟ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 20404,
        "end": 20413
      },
      "text": "བརྒྱད་པོ་ ༼སྣར། པེ།༽ བརྒྱད་པོའི་"
    },
    {
      "span": {
        "start": 20590,
        "end": 20603
      },
      "text": "ཕྱེད་ཕྱེད་དོ། ༼སྣར། པེ།༽ ཕྱེད་ཕྱེད་དབྲི།"
    },
    {
      "span": {
        "start": 20669,
        "end": 20677
      },
      "text": "གཉིས་སོ་ ༼སྣར། པེ།༽ གཉིས་པོ་"
    },
    {
      "span": {
        "start": 20797,
        "end": 20803
      },
      "text": "ཟླ་ཁམ་ ༼སྣར། པེ།༽ ཟླ་གམ་"
    },
    {
      "span": {
        "start": 20818,
        "end": 20825
      },
      "text": "འདི་དང་ ༼སྣར། པེ།༽ འདི་དག་"
    },
    {
      "span": {
        "start": 21188,
        "end": 21199
      },
      "text": "ངད་ལྡང་བའི་ ༼སྣར། པེ།༽ ངད་ལྡན་པའི་"
    },
    {
      "span": {
        "start": 21328,
        "end": 21331
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 21369,
        "end": 21374
      },
      "text": "མེ་མ་ ༼སྣར། པེ།༽ མེ་མར་"
    },
    {
      "span": {
        "start": 21395,
        "end": 21405
      },
      "text": "སྤུ་གྲིའི་ ༼སྣར། པེ།༽ སྤུ་གྲི་"
    },
    {
      "span": {
        "start": 21644,
        "end": 21652
      },
      "text": "ཐུང་ངུར་ ༼སྣར། པེ།༽ ཐུང་ངུ་"
    },
    {
      "span": {
        "start": 21668,
        "end": 21675
      },
      "text": "བཟློག ། ༼སྣར། པེ།༽ ལྡོག །"
    },
    {
      "span": {
        "start": 22128,
        "end": 22132
      },
      "text": "བལྟ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 22213,
        "end": 22217
      },
      "text": "གཞི་ ༼སྣར།༽ བཞི་"
    },
    {
      "span": {
        "start": 22384,
        "end": 22388
      },
      "text": "བཅད་ ༼སྣར། པེ།༽ བཤད་"
    },
    {
      "span": {
        "start": 22706,
        "end": 22714
      },
      "text": "གསུམ་པོ་ ༼སྣར། པེ།༽ གསུམ་པ་"
    },
    {
      "span": {
        "start": 22817,
        "end": 22825
      },
      "text": "ཇི་སྲིད་ ༼སྣར། པེ།༽ ཇི་སྙེད་"
    },
    {
      "span": {
        "start": 23139,
        "end": 23146
      },
      "text": "འཛམ་བུ་ ༼སྣར། པེ།༽ འཛམ་བུའི་"
    },
    {
      "span": {
        "start": 23480,
        "end": 23484
      },
      "text": "དོར་ ༼སྣར། པེ།༽ འདོར་"
    },
    {
      "span": {
        "start": 23634,
        "end": 23639
      },
      "text": "རྣམས་ ༼པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 23809,
        "end": 23815
      },
      "text": "ཉི་ཤུ་ ༼སྣར། པེ།༽ ཉི་ཤུས་"
    },
    {
      "span": {
        "start": 23822,
        "end": 23828
      },
      "text": "ལྷག་པ་ ༼སྣར།༽ ལྷག་པས་"
    },
    {
      "span": {
        "start": 24121,
        "end": 24127
      },
      "text": "སྦྱངས་ ༼སྣར། པེ།༽ རྫངས་"
    },
    {
      "span": {
        "start": 24305,
        "end": 24308
      },
      "text": "རབ་ ༼སྣར། པེ།༽ རབས་"
    },
    {
      "span": {
        "start": 24390,
        "end": 24397
      },
      "text": "དང་སྲོ་ ༼སྣར།༽ དང་སོ་"
    },
    {
      "span": {
        "start": 24457,
        "end": 24464
      },
      "text": "བསྒྱུར། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 24752,
        "end": 24755
      },
      "text": "ཡི། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 25002,
        "end": 25009
      },
      "text": "གཞན་ནི་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 25098,
        "end": 25104
      },
      "text": "ཆགས་པ་ ༼སྣར། པེ།༽ འཆགས་པ་"
    },
    {
      "span": {
        "start": 25338,
        "end": 25345
      },
      "text": "བསྐལ་པ་ ༼སྣར།༽ བསྐལ་"
    },
    {
      "span": {
        "start": 25350,
        "end": 25353
      },
      "text": "ཡི་ ༼སྣར། པེ།༽ ཡིས་"
    },
    {
      "span": {
        "start": 25415,
        "end": 25420
      },
      "text": "འཕྱི། ༼སྣར།༽ ཕྱི།"
    },
    {
      "span": {
        "start": 25498,
        "end": 25504
      },
      "text": "ལས་མས་ ༼སྣར། པེ།༽ ལ་མས་"
    },
    {
      "span": {
        "start": 25584,
        "end": 25590
      },
      "text": "བརྩམས་ ༼སྣར།༽ བརྩེམས་"
    },
    {
      "span": {
        "start": 25731,
        "end": 25735
      },
      "text": "སོག་ ༼སྣར། པེ།༽ བསོགས་"
    },
    {
      "span": {
        "start": 25894,
        "end": 25899
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 25930,
        "end": 25938
      },
      "text": "གོ་རིམས་ ༼སྣར། པེ།༽ གོ་རིམ་"
    },
    {
      "span": {
        "start": 26247,
        "end": 26256
      },
      "text": "དེ་ནས་ནི། ༼སྣར། པེ།༽ དེ་ནས་ཀྱང་།"
    },
    {
      "span": {
        "start": 26292,
        "end": 26301
      },
      "text": "མངོན་པའི་ ༼སྣར། པེ།༽ མངོན་པ་"
    },
    {
      "span": {
        "start": 26330,
        "end": 26340
      },
      "text": "འཇིག་རྟེན་ ༼སྣར། པེ།༽ འཇིག་རྟེན་པ་"
    },
    {
      "span": {
        "start": 26466,
        "end": 26473
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེས་"
    },
    {
      "span": {
        "start": 26584,
        "end": 26594
      },
      "text": "སྐད་ཅིག་མ་ ༼སྣར། པེ།༽ སྐད་ཅིག་པ་"
    },
    {
      "span": {
        "start": 26683,
        "end": 26692
      },
      "text": "འགྱུར་ཏེ་ ༼སྣར། པེ།༽ འགྱུར་དེ་"
    },
    {
      "span": {
        "start": 26708,
        "end": 26717
      },
      "text": "རྣམས་རིག་ ༼སྣར། པེ།༽ རྣམ་རིག་"
    },
    {
      "span": {
        "start": 26929,
        "end": 26939
      },
      "text": "སྐྱེས་པའི་ ༼སྣར། པེ།༽ སྐྱེས་པ་"
    },
    {
      "span": {
        "start": 27096,
        "end": 27102
      },
      "text": "སྐྱེས། ༼སྣར། པེ།༽ སྐྱེ།"
    },
    {
      "span": {
        "start": 27168,
        "end": 27172
      },
      "text": "ནའོ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 27269,
        "end": 27273
      },
      "text": "མེད་ ༼སྣར། པེ།༽ མེ་"
    },
    {
      "span": {
        "start": 27364,
        "end": 27369
      },
      "text": "བྱ་བ་ ༼སྣར།༽ བྱས་པ་"
    },
    {
      "span": {
        "start": 27818,
        "end": 27827
      },
      "text": "གསུམ་ཤེས་ ༼སྣར། པེ།༽ གསུམ་ཞེས་"
    },
    {
      "span": {
        "start": 28286,
        "end": 28292
      },
      "text": "སྐྱེས་ ༼སྣར། པེ།༽ སྐྱེ་"
    },
    {
      "span": {
        "start": 28460,
        "end": 28469
      },
      "text": "དབང་པོའི་ ༼སྣར། པེ།༽ དབང་པོ་"
    },
    {
      "span": {
        "start": 28518,
        "end": 28521
      },
      "text": "དག་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 28533,
        "end": 28545
      },
      "text": "རྣམ་རིག་མིན་ ༼སྣར།༽ རྣམ་རིག་མི་"
    },
    {
      "span": {
        "start": 29020,
        "end": 29030
      },
      "text": "བསྒྲིབས་པ་ ༼པེ།༽ བསྒྲིབ་པ་"
    },
    {
      "span": {
        "start": 29154,
        "end": 29157
      },
      "text": "ཞན་ ༼སྣར།༽ གཞན་"
    },
    {
      "span": {
        "start": 29290,
        "end": 29295
      },
      "text": "འཐོབ་ ༼སྣར། པེ།༽ ཐོབ་"
    },
    {
      "span": {
        "start": 29302,
        "end": 29305
      },
      "text": "ནི། ༼པེ།༽ གྱི།"
    },
    {
      "span": {
        "start": 29355,
        "end": 29366
      },
      "text": "སྩོགས་ཀྱིས། ༼པེ།༽ སྩོགས་ཀྱི།"
    },
    {
      "span": {
        "start": 29519,
        "end": 29525
      },
      "text": "ནང་པར་ ༼སྣར། པེ།༽ ནངས་པར་"
    },
    {
      "span": {
        "start": 29882,
        "end": 29889
      },
      "text": "སྲུང་བ་ ༼སྣར། པེ།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 30537,
        "end": 30545
      },
      "text": "འཐོབ་པར་ ༼སྣར། པེ།༽ ཐོབ་པར་"
    },
    {
      "span": {
        "start": 30673,
        "end": 30679
      },
      "text": "ཆད་དམ་ ༼སྣར། པེ།༽ ཆད་དང་"
    },
    {
      "span": {
        "start": 31241,
        "end": 31252
      },
      "text": "དེ་བཞིན་ནོ། ༼སྣར། པེ།༽ དེ་བཞིན་ལ།"
    },
    {
      "span": {
        "start": 31271,
        "end": 31279
      },
      "text": "གསུམ་མོ། ༼སྣར།༽ གསུམ་པ།"
    },
    {
      "span": {
        "start": 31606,
        "end": 31616
      },
      "text": "རྣམས་སྨིན་ ༼སྣར། པེ།༽ རྣམ་སྨིན་"
    },
    {
      "span": {
        "start": 31746,
        "end": 31752
      },
      "text": "འདིའི་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 31965,
        "end": 31971
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 32004,
        "end": 32012
      },
      "text": "ངེས་དང་། ༼སྣར། པེ།༽ ངེས་པ།"
    },
    {
      "span": {
        "start": 32082,
        "end": 32086
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 32136,
        "end": 32141
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིས་"
    },
    {
      "span": {
        "start": 32230,
        "end": 32236
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 32422,
        "end": 32427
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིས་"
    },
    {
      "span": {
        "start": 32534,
        "end": 32537
      },
      "text": "གང་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 32645,
        "end": 32651
      },
      "text": "ངེས་པ་ ༼སྣར། པེ།༽ ངེས་པར་"
    },
    {
      "span": {
        "start": 32814,
        "end": 32821
      },
      "text": "ལས་ཀྱི་ ༼སྣར། པེ།༽ ལས་ནི་"
    },
    {
      "span": {
        "start": 32863,
        "end": 32874
      },
      "text": "མི་དགེ་བའི་ ༼སྣར། པེ།༽ མི་དགེ་བ་"
    },
    {
      "span": {
        "start": 32913,
        "end": 32920
      },
      "text": "སེམས་ལ། ༼སྣར། པེ།༽ སེམས་པ།"
    },
    {
      "span": {
        "start": 33260,
        "end": 33266
      },
      "text": "བྲལ་བ་ ༼སྣར། པེ།༽ འབྲལ་བ་"
    },
    {
      "span": {
        "start": 33266,
        "end": 33269
      },
      "text": "ཡི། ༼ཅོ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 33425,
        "end": 33429
      },
      "text": "བྲལ་ ༼སྣར། པེ།༽ འབྲལ་"
    },
    {
      "span": {
        "start": 33646,
        "end": 33651
      },
      "text": "སྤྱད་ ༼སྣར།༽ དབྱེད་ ༼པེ།༽ དཔྱད་"
    },
    {
      "span": {
        "start": 34005,
        "end": 34009
      },
      "text": "རྣམ་ ༼སྣར།༽ རྣམས་"
    },
    {
      "span": {
        "start": 34034,
        "end": 34046
      },
      "text": "རྣམ་རིག་མིན། ༼སྣར། པེ།༽ རྣམ་རིག་བྱེད།"
    },
    {
      "span": {
        "start": 34125,
        "end": 34130
      },
      "text": "མཇུག་ ༼སྣར། པེ།༽ འཇུག་"
    },
    {
      "span": {
        "start": 34248,
        "end": 34253
      },
      "text": "མཇུག་ ༼སྣར། པེ།༽ འཇུག་"
    },
    {
      "span": {
        "start": 34287,
        "end": 34293
      },
      "text": "སྐྱེས། ༼སྣར།༽ སྐྱེས་སོ།"
    },
    {
      "span": {
        "start": 34521,
        "end": 34524
      },
      "text": "ནི་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 34696,
        "end": 34700
      },
      "text": "གསད་ ༼སྣར། པེ།༽ བསད་"
    },
    {
      "span": {
        "start": 34773,
        "end": 34780
      },
      "text": "འགྲོ་བ་ ༼སྣར། པེ།༽ བགྲོད་པར་"
    },
    {
      "span": {
        "start": 35093,
        "end": 35099
      },
      "text": "ཀྱལ་པ་ ༼སྣར། པེ།༽ བཀྱལ་པ་"
    },
    {
      "span": {
        "start": 35135,
        "end": 35139
      },
      "text": "གསག་ ༼སྣར།༽ བསག་"
    },
    {
      "span": {
        "start": 35194,
        "end": 35201
      },
      "text": "ལོག་པས་ ༼སྣར། པེ།༽ ལོག་པ་"
    },
    {
      "span": {
        "start": 35241,
        "end": 35245
      },
      "text": "སྡང་ ༼སྣར། པེ།༽ ལྡང་"
    },
    {
      "span": {
        "start": 35298,
        "end": 35306
      },
      "text": "གསུམ་ལམ་ ༼སྣར། པེ།༽ གསུམ་ལས་"
    },
    {
      "span": {
        "start": 35688,
        "end": 35694
      },
      "text": "ཀྱལ་པ་ ༼སྣར། པེ།༽ བཀྱལ་པ་"
    },
    {
      "span": {
        "start": 35780,
        "end": 35787
      },
      "text": "ཡོད་དེ། ༼སྣར། པེ།༽ ཡོད་དོ།"
    },
    {
      "span": {
        "start": 36137,
        "end": 36141
      },
      "text": "རྣམ་ ༼སྣར།༽ རྣམས་"
    },
    {
      "span": {
        "start": 36238,
        "end": 36243
      },
      "text": "བསླང་ ༼སྣར། པེ།༽ སླང་"
    },
    {
      "span": {
        "start": 36286,
        "end": 36292
      },
      "text": "དག་གི། ༼སྣར། པེ།༽ དག་གིས།"
    },
    {
      "span": {
        "start": 36300,
        "end": 36306
      },
      "text": "ལྔ་ཡི་ ༼སྣར། པེ།༽ ལྔ་ཡིས་"
    },
    {
      "span": {
        "start": 36329,
        "end": 36336
      },
      "text": "བཞི་ཡི་ ༼སྣར། པེ།༽ བཞི་ཡིས་"
    },
    {
      "span": {
        "start": 36857,
        "end": 36862
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 36865,
        "end": 36870
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ གསུམ་"
    },
    {
      "span": {
        "start": 37109,
        "end": 37114
      },
      "text": "རིགས་ ༼སྣར།༽ རིམས་"
    },
    {
      "span": {
        "start": 37152,
        "end": 37165
      },
      "text": "ཉམས་པའང་ཞེའོ། ༼སྣར། པེ།༽ ཉམས་པའང་ཞེས།"
    },
    {
      "span": {
        "start": 37209,
        "end": 37214
      },
      "text": "ཕྱེད་ ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 37430,
        "end": 37434
      },
      "text": "ཡོད། ༼སྣར། པེ།༽ འདོད།"
    },
    {
      "span": {
        "start": 37436,
        "end": 37440
      },
      "text": "ཟ་མ་ ༼སྣར།༽ ཟ་མ་ལ་"
    },
    {
      "span": {
        "start": 37648,
        "end": 37654
      },
      "text": "དེ་དང་ ༼པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 37824,
        "end": 37832
      },
      "text": "བྱེ་བའོ་ ༼སྣར།༽ བྱེད་པའོ་"
    },
    {
      "span": {
        "start": 37866,
        "end": 37872
      },
      "text": "དབྱེན་ ༼སྣར། པེ།༽ དབེན་"
    },
    {
      "span": {
        "start": 37904,
        "end": 37913
      },
      "text": "སོགས་ཀྱི། ༼སྣར། པེ།༽ སོགས་ཀྱིས།"
    },
    {
      "span": {
        "start": 37979,
        "end": 37983
      },
      "text": "མཐའ་ ༼པེ།༽ མཐའི་"
    },
    {
      "span": {
        "start": 38159,
        "end": 38168
      },
      "text": "གྱུར་ཀྱང་ ༼སྣར། པེ།༽ གྱུར་དང་"
    },
    {
      "span": {
        "start": 38176,
        "end": 38182
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་ཞིག་"
    },
    {
      "span": {
        "start": 38192,
        "end": 38199
      },
      "text": "བྱུང་མ། ༼པེ།༽ བྱུང་བ།"
    },
    {
      "span": {
        "start": 38640,
        "end": 38645
      },
      "text": "གེགས་ ༼སྣར། པེ།༽ བགེགས་"
    },
    {
      "span": {
        "start": 38748,
        "end": 38752
      },
      "text": "ཕོར་ ༼སྣར། པེ།༽ ཕོ་"
    },
    {
      "span": {
        "start": 38796,
        "end": 38801
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 38917,
        "end": 38922
      },
      "text": "སྐྱེ། ༼སྣར། པེ།༽ སྐྱེས།"
    },
    {
      "span": {
        "start": 39021,
        "end": 39034
      },
      "text": "སྙིང་རྗེ་ཡིས། ༼པེ།༽ སྙིང་རྗེ་ཡིན།"
    },
    {
      "span": {
        "start": 39099,
        "end": 39106
      },
      "text": "འཁྲུགས་ ༼སྣར། པེ།༽ འཁྲུག་"
    },
    {
      "span": {
        "start": 39130,
        "end": 39134
      },
      "text": "སྐར་ ༼པེ།༽ སྐལ་"
    },
    {
      "span": {
        "start": 39337,
        "end": 39340
      },
      "text": "དེ་ ༼སྣར། པེ།༽ བདེ་"
    },
    {
      "span": {
        "start": 39685,
        "end": 39696
      },
      "text": "གཞོན་ཤ་དང་། ༼སྣར། པེ།༽ གཞོན་ཤ་ཅན།"
    },
    {
      "span": {
        "start": 39797,
        "end": 39800
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 39808,
        "end": 39817
      },
      "text": "གྲོལ་བའམ། ༼སྣར། པེ།༽ གྲོལ་བ་ལམ།"
    },
    {
      "span": {
        "start": 39971,
        "end": 39975
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 40445,
        "end": 40450
      },
      "text": "འཕེན་ ༼སྣར། པེ།༽ འཕན་"
    },
    {
      "span": {
        "start": 40460,
        "end": 40463
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 40474,
        "end": 40477
      },
      "text": "ཞི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 40479,
        "end": 40484
      },
      "text": "རྟེན། ༼སྣར། པེ།༽ བརྟེན།"
    },
    {
      "span": {
        "start": 40529,
        "end": 40533
      },
      "text": "སྒོ་ ༼སྣར། པེ།༽ སྒོམ་"
    },
    {
      "span": {
        "start": 40596,
        "end": 40602
      },
      "text": "གཙོའི་ ༼སྣར། པེ།༽ བཙོའི་"
    },
    {
      "span": {
        "start": 40625,
        "end": 40633
      },
      "text": "དགའ་གནས་ ༼སྣར། པེ།༽ དགའ་བའི་"
    },
    {
      "span": {
        "start": 40831,
        "end": 40836
      },
      "text": "སློང་ ༼སྣར།༽ ཀློང་"
    },
    {
      "span": {
        "start": 40894,
        "end": 40902
      },
      "text": "གོ་རིམས་ ༼སྣར།༽ གོ་རིམ་"
    },
    {
      "span": {
        "start": 40985,
        "end": 40991
      },
      "text": "བསྟེན་ ༼སྣར།༽ བསྟན་"
    },
    {
      "span": {
        "start": 41287,
        "end": 41292
      },
      "text": "བལྟས་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 41849,
        "end": 41853
      },
      "text": "དམན་ ༼སྣར། པེ།༽ དམའ་"
    },
    {
      "span": {
        "start": 41885,
        "end": 41892
      },
      "text": "དེར་ལྟ་ ༼སྣར། པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 42079,
        "end": 42088
      },
      "text": "ལོག་ཕྱིར་ ༼སྣར། པེ།༽ ལོག་པ་"
    },
    {
      "span": {
        "start": 42243,
        "end": 42248
      },
      "text": "གསོད་ ༼སྣར། པེ།༽ གཅོད་"
    },
    {
      "span": {
        "start": 42261,
        "end": 42267
      },
      "text": "དཀྲིས་ ༼སྣར། པེ།༽ བཀྲིས་"
    },
    {
      "span": {
        "start": 42671,
        "end": 42678
      },
      "text": "ལྡན་དང་ ༼སྣར། པེ།༽ ལྡན་པ་"
    },
    {
      "span": {
        "start": 42795,
        "end": 42806
      },
      "text": "ལམ་ནི་དེའི། ༼སྣར། པེ།༽ ལམ་དེ་ཡི།"
    },
    {
      "span": {
        "start": 42808,
        "end": 42818
      },
      "text": "སྤྱོད་ཡུལ་ ༼སྣར། པེ།༽ སྤྱོད་ཚུལ་"
    },
    {
      "span": {
        "start": 43258,
        "end": 43266
      },
      "text": "མ་རིག་པ། ༼སྣར། པེ།༽ མ་རིག་པའང་།"
    },
    {
      "span": {
        "start": 43420,
        "end": 43425
      },
      "text": "མཐོར་ ༼སྣར། པེ།༽ འཐོར་"
    },
    {
      "span": {
        "start": 43561,
        "end": 43568
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 43593,
        "end": 43596
      },
      "text": "དང་ ༼སྣར། པེ།༽ བར་"
    },
    {
      "span": {
        "start": 44255,
        "end": 44265
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 44534,
        "end": 44540
      },
      "text": "སྐྱེས་ ༼སྣར། པེ།༽ སྐྱེ་"
    },
    {
      "span": {
        "start": 44623,
        "end": 44628
      },
      "text": "གླགས་ ༼སྣར། པེ།༽ ཀླག་"
    },
    {
      "span": {
        "start": 44727,
        "end": 44731
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 45429,
        "end": 45433
      },
      "text": "རྣམ་ ༼སྣར།༽ རྣམས་"
    },
    {
      "span": {
        "start": 45568,
        "end": 45576
      },
      "text": "འབྲང་བས་ ༼སྣར། པེ།༽ འབྲང་བ་"
    },
    {
      "span": {
        "start": 45662,
        "end": 45667
      },
      "text": "འབྱར་ ༼སྣར།༽ འབྱོར་"
    },
    {
      "span": {
        "start": 45751,
        "end": 45760
      },
      "text": "སོགས་ཀྱི། ༼སྣར། པེ།༽ སོགས་ཀྱིས།"
    },
    {
      "span": {
        "start": 46061,
        "end": 46067
      },
      "text": "རྩ་བས་ ༼སྣར། པེ།༽ རྩ་བ་"
    },
    {
      "span": {
        "start": 47139,
        "end": 47142
      },
      "text": "དང་ ༼སྣར། པེ།༽ ནང་"
    },
    {
      "span": {
        "start": 47169,
        "end": 47176
      },
      "text": "ཚངས་པས་ ༼སྣར། པེ།༽ ཚངས་པ་"
    },
    {
      "span": {
        "start": 47265,
        "end": 47270
      },
      "text": "གཉིད་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 47712,
        "end": 47724
      },
      "text": "འཆབ་དང་གཉིས། ༼སྣར། པེ།༽ འཆབ་པ་ཉིད།"
    },
    {
      "span": {
        "start": 47736,
        "end": 47753
      },
      "text": "ལྡན་བདེ་དག་དང་། ། ༼སྣར། པེ།༽ ལྡན་པ་དེ་དག །"
    },
    {
      "span": {
        "start": 48191,
        "end": 48195
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 48970,
        "end": 48973
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 49291,
        "end": 49301
      },
      "text": "དང་བསྒོམས་ ༼སྣར། པེ།༽ ཞིང་བསྒོམ་"
    },
    {
      "span": {
        "start": 49352,
        "end": 49364
      },
      "text": "རྣམ་གཉིས་ཏེ། ༼སྣར། པེ།༽ རྣམ་པ་གཉིས།"
    },
    {
      "span": {
        "start": 49639,
        "end": 49647
      },
      "text": "བློ་ཡིས་ ༼སྣར། པེ།༽ བློ་ཡི་"
    },
    {
      "span": {
        "start": 49848,
        "end": 49854
      },
      "text": "བསྲིང་ ༼སྣར། པེ།༽ བསྲིངས་"
    },
    {
      "span": {
        "start": 49995,
        "end": 49999
      },
      "text": "ཁམས་ ༼སྣར། པེ།༽ ཁམ་"
    },
    {
      "span": {
        "start": 50218,
        "end": 50220
      },
      "text": "པ། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 50271,
        "end": 50275
      },
      "text": "ལྷག་ ༼སྣར། པེ།༽ ལྷགས་"
    },
    {
      "span": {
        "start": 50526,
        "end": 50535
      },
      "text": "སྐྱེད་དོ། ༼སྣར། པེ།༽ སྐྱེད་བསྐྱེད་།"
    },
    {
      "span": {
        "start": 50611,
        "end": 50619
      },
      "text": "ཕྱི་བའི་ ༼སྣར། པེ།༽ ཕྱི་མའི་"
    },
    {
      "span": {
        "start": 50764,
        "end": 50772
      },
      "text": "མ་རྟོགས་ ༼སྣར། པེ།༽ མི་གཏོགས་"
    },
    {
      "span": {
        "start": 51113,
        "end": 51116
      },
      "text": "ལྟ། ༼སྣར། པེ།༽ ལྟའོ།"
    },
    {
      "span": {
        "start": 51324,
        "end": 51333
      },
      "text": "ཆོས་ཀྱིས་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 51707,
        "end": 51712
      },
      "text": "ཡོངས་ ༼སྣར། པེ།༽ འོངས་"
    },
    {
      "span": {
        "start": 51769,
        "end": 51772
      },
      "text": "ཚེ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 52444,
        "end": 52449
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 53045,
        "end": 53055
      },
      "text": "བསྒོམ་སྤང་ ༼སྣར། པེ།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 53055,
        "end": 53058
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱ་སྤང་"
    },
    {
      "span": {
        "start": 53065,
        "end": 53072
      },
      "text": "རེ་ལྟར་ ༼སྣར།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 53485,
        "end": 53494
      },
      "text": "ཕྱེད་འཕར་ ༼སྣར། པེ།༽ བྱེད་མཐར་"
    },
    {
      "span": {
        "start": 53623,
        "end": 53635
      },
      "text": "གཟུགས་སུ་ཉེ་ ༼ཅོ།༽ གཟུགས་ཉེ་ ༼སྣར། པེ།༽ གཟུགས་སུ་ཉེར་"
    },
    {
      "span": {
        "start": 53806,
        "end": 53814
      },
      "text": "ཕྱིར་དེ། ༼སྣར། པེ།༽ ཕྱིར་ཏེ།"
    },
    {
      "span": {
        "start": 53875,
        "end": 53881
      },
      "text": "དེ་དང་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 53924,
        "end": 53929
      },
      "text": "སྟེན། ༼སྣར། པེ།༽ བསྟེན།"
    },
    {
      "span": {
        "start": 53980,
        "end": 53985
      },
      "text": "གྲུབ། ༼སྣར།༽ འགྲུབ ༼པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 54121,
        "end": 54126
      },
      "text": "འོངས། ༼སྡེ། ཅོ།༽ འོང་།"
    },
    {
      "span": {
        "start": 54172,
        "end": 54177
      },
      "text": "བར་ཆ་ ༼སྣར།༽ བར་ཆད་"
    },
    {
      "span": {
        "start": 54333,
        "end": 54342
      },
      "text": "འདས་ཀྱིས་ ༼སྣར། པེ།༽ འདས་ཀྱི་"
    },
    {
      "span": {
        "start": 54356,
        "end": 54365
      },
      "text": "ཆགས་འབྲལ་ ༼སྣར།༽ ཆགས་བྲལ་"
    },
    {
      "span": {
        "start": 54640,
        "end": 54644
      },
      "text": "བསམ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 54657,
        "end": 54664
      },
      "text": "བསྡོགས་ ༼པེ།༽ སྔོགས་"
    },
    {
      "span": {
        "start": 54698,
        "end": 54705
      },
      "text": "བསྡོགས་ ༼སྣར། པེ།༽ སྔོགས་"
    },
    {
      "span": {
        "start": 54938,
        "end": 54943
      },
      "text": "སློབ་ ༼སྣར། པེ།༽ ཤེས་"
    },
    {
      "span": {
        "start": 55073,
        "end": 55078
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 55509,
        "end": 55514
      },
      "text": "འདིར་ ༼སྣར། པེ།༽ འདིས་"
    },
    {
      "span": {
        "start": 55812,
        "end": 55814
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལས།"
    },
    {
      "span": {
        "start": 55820,
        "end": 55826
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 55942,
        "end": 55951
      },
      "text": "གསུམ་ཤེས་ ༼སྣར། པེ།༽ གསུམ་ཞེས་"
    },
    {
      "span": {
        "start": 56181,
        "end": 56187
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 56224,
        "end": 56226
      },
      "text": "བ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 56518,
        "end": 56523
      },
      "text": "འཇུག་ ༼སྣར།༽ མཇུག་"
    },
    {
      "span": {
        "start": 56701,
        "end": 56707
      },
      "text": "དག་གི་ ༼པེ།༽ དག་གིས་"
    },
    {
      "span": {
        "start": 56715,
        "end": 56718
      },
      "text": "སླ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 56774,
        "end": 56786
      },
      "text": "ཅིག་ཤོས་ཀྱི་ ༼སྣར། པེ།༽ ཅིག་ཤོས་ཀྱིས་"
    },
    {
      "span": {
        "start": 57176,
        "end": 57184
      },
      "text": "གོ་རིམས་ ༼སྣར། པེ།༽ གོ་རིམ་"
    },
    {
      "span": {
        "start": 57194,
        "end": 57203
      },
      "text": "ནི་དང་པོ་ ༼སྣར།༽ ནི་དངོས་"
    },
    {
      "span": {
        "start": 57527,
        "end": 57538
      },
      "text": "སྲིད་རྩེ་ན། ༼སྣར། པེ།༽ སྲིད་རྩེ་ནས།"
    },
    {
      "span": {
        "start": 57591,
        "end": 57596
      },
      "text": "འཐོབ། ༼པེ།༽ ཐོབ།"
    },
    {
      "span": {
        "start": 57930,
        "end": 57938
      },
      "text": "བཤད་ཅེས་ ༼སྣར། པེ།༽ བཤད་ཤེས་"
    },
    {
      "span": {
        "start": 58134,
        "end": 58137
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 58171,
        "end": 58175
      },
      "text": "གཞི། ༼སྣར།༽ བཞི།"
    },
    {
      "span": {
        "start": 58245,
        "end": 58253
      },
      "text": "ཀུན་གྱི་ ༼སྣར། པེ།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 58278,
        "end": 58285
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 58308,
        "end": 58322
      },
      "text": "མངོན་པའི་མཛོད་ ༼སྣར།༽ མངོན་པ་མཛད་ ༼པེ།༽ མངོན་པ་མཛོད་"
    },
    {
      "span": {
        "start": 58369,
        "end": 58378
      },
      "text": "བྱ་བ་སྟེ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 58408,
        "end": 58417
      },
      "text": "རྣམས་ཤེས་ ༼སྣར། པེ།༽ རྣམ་ཤེས་"
    },
    {
      "span": {
        "start": 58419,
        "end": 58423
      },
      "text": "མིན། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 58940,
        "end": 58949
      },
      "text": "སྐྱེས་མི་ ༼སྣར། པེ།༽ སྐྱེས་མ་"
    },
    {
      "span": {
        "start": 59067,
        "end": 59074
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 59080,
        "end": 59086
      },
      "text": "ཟད་པར་ ༼སྣར། པེ།༽ ཟད་པ་"
    },
    {
      "span": {
        "start": 59115,
        "end": 59124
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 59131,
        "end": 59155
      },
      "text": "། །ཡོངས་ཤེས་བྱར་མེད་ཅེས་ ༼སྣར། པེ།༽ ཡོངས་ཤེས་བྱ་བ་མེད་"
    },
    {
      "span": {
        "start": 59177,
        "end": 59181
      },
      "text": "བློ་ ༼སྣར། པེ།༽ བློར་"
    },
    {
      "span": {
        "start": 59540,
        "end": 59579
      },
      "text": "དྲི་མེད་ཀྱང་། །དེ་བཞིན་དྲི་མ་དང་བཅས་ནི། ༼པེ།༽ དྲི་མེད་ཀྱང་།"
    },
    {
      "span": {
        "start": 59581,
        "end": 59588
      },
      "text": "ཤེས་བྱ་ ༼སྣར། པེ།༽ ཤེས་བྱའི་"
    },
    {
      "span": {
        "start": 59602,
        "end": 59606
      },
      "text": "རྣམ། ༼སྣར། པེ།༽ རྣམས།"
    },
    {
      "span": {
        "start": 59712,
        "end": 59716
      },
      "text": "རྣམ་ ༼པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 59862,
        "end": 59868
      },
      "text": "དང་པོ་ ༼སྣར། པེ།༽ དབང་པོ་"
    },
    {
      "span": {
        "start": 59920,
        "end": 59940
      },
      "text": "ན་ཆོས་ཤེས་བྱ་བར་དགུ། ༼སྣར། པེ།༽ ཆོས་ཤེས་བྱ་དགུ་ན།"
    },
    {
      "span": {
        "start": 59992,
        "end": 59996
      },
      "text": "བཞི། ༼སྣར། པེ།༽ བཞིན།"
    },
    {
      "span": {
        "start": 60243,
        "end": 60249
      },
      "text": "བློའི་ ༼སྣར། པེ།༽ བློ་"
    },
    {
      "span": {
        "start": 60874,
        "end": 60882
      },
      "text": "འཐོབ་བོ། ༼སྣར། པེ།༽ ཐོབ་པོ།"
    },
    {
      "span": {
        "start": 60940,
        "end": 60944
      },
      "text": "པའི། ༼སྣར། པེ།༽ པའོ་"
    },
    {
      "span": {
        "start": 61094,
        "end": 61103
      },
      "text": "སྲིད་རྩེ་ ༼སྣར། པེ།༽ སྲིད་རྩེའི་"
    },
    {
      "span": {
        "start": 61119,
        "end": 61124
      },
      "text": "ཟད་པ་ ༼སྣར། པེ།༽ ཟད་པའི་"
    },
    {
      "span": {
        "start": 61342,
        "end": 61352
      },
      "text": "བསྟེན་ཞེས་ ༼སྣར། པེ།༽ བསྟན་ཅེས་"
    },
    {
      "span": {
        "start": 61404,
        "end": 61410
      },
      "text": "བསྲིང་ ༼སྣར། པེ།༽ སྲིང་"
    },
    {
      "span": {
        "start": 61708,
        "end": 61714
      },
      "text": "ལྷག་མ་ ༼སྣར། པེ།༽ ལྷག་པ་"
    },
    {
      "span": {
        "start": 61812,
        "end": 61820
      },
      "text": "དག་ཚིགས་ ༼སྣར། པེ།༽ དང་ཚིག་"
    },
    {
      "span": {
        "start": 61837,
        "end": 61851
      },
      "text": "བདུན་ཅུས་བླགས་ ༼སྣར། པེ།༽ བདུན་ཅུ་གླགས་"
    },
    {
      "span": {
        "start": 62089,
        "end": 62093
      },
      "text": "ཆེས་ ༼སྣར། པེ།༽ ཆས་"
    },
    {
      "span": {
        "start": 62271,
        "end": 62275
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ མིན།"
    },
    {
      "span": {
        "start": 62347,
        "end": 62351
      },
      "text": "རིག་ ༼སྣར།༽ རིགས་"
    },
    {
      "span": {
        "start": 62426,
        "end": 62432
      },
      "text": "སྐྱེས་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 62464,
        "end": 62469
      },
      "text": "གཞིར་ ༼སྣར།༽ བཞིར་"
    },
    {
      "span": {
        "start": 62641,
        "end": 62650
      },
      "text": "ཐོགས་མེད་ ༼སྣར། པེ།༽ ཐོག་མེད་"
    },
    {
      "span": {
        "start": 63043,
        "end": 63048
      },
      "text": "རྣ་བ་ ༼སྣར། པེ།༽ རྣམ་པ་"
    },
    {
      "span": {
        "start": 63271,
        "end": 63275
      },
      "text": "ཡུལ་ ༼སྣར། པེ།༽ ཡུན་"
    },
    {
      "span": {
        "start": 63436,
        "end": 63441
      },
      "text": "སྔོན་ ༼སྣར། པེ།༽ མངོན་"
    },
    {
      "span": {
        "start": 63512,
        "end": 63514
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 63579,
        "end": 63585
      },
      "text": "ན་རིག་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 63585,
        "end": 63587
      },
      "text": "མ་ ༼སྣར། པེ།༽ མ་རིག་"
    },
    {
      "span": {
        "start": 63652,
        "end": 63663
      },
      "text": "འཁྲུལ་ཕྱིར་ ༼སྣར། པེ།༽ འཕྲུལ་ཕྱི་"
    },
    {
      "span": {
        "start": 64012,
        "end": 64020
      },
      "text": "དེ་རྙེད་ ༼སྣར། པེ།༽ དེ་སྙེད་"
    },
    {
      "span": {
        "start": 64201,
        "end": 64207
      },
      "text": "བརླབས་ ༼སྣར། པེ།༽ བརླབ་"
    },
    {
      "span": {
        "start": 64240,
        "end": 64246
      },
      "text": "དང་པོ་ ༼སྣར། པེ།༽ དང་པོར་"
    },
    {
      "span": {
        "start": 64293,
        "end": 64300
      },
      "text": "བསྒོམས་ ༼སྣར། པེ།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 64470,
        "end": 64475
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ སྟེན་"
    },
    {
      "span": {
        "start": 64666,
        "end": 64670
      },
      "text": "གང་། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 64989,
        "end": 65005
      },
      "text": "སྔ་སྔ་སྤངས་པ་ཡི། ༼སྣར།༽ ལྔ་ལྔ་སྤང་བ་ཡིན ༼པེ།༽ སྔ་སྔ་སྤང་བ་ཡིན།"
    },
    {
      "span": {
        "start": 65071,
        "end": 65078
      },
      "text": "བསྡོགས་ ༼སྣར།༽ བསྡོམས་"
    },
    {
      "span": {
        "start": 65753,
        "end": 65758
      },
      "text": "རྣམས། ༼སྣར། པེ།༽ གནས།"
    },
    {
      "span": {
        "start": 66210,
        "end": 66214
      },
      "text": "ཡོད། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 66378,
        "end": 66383
      },
      "text": "འཐོབ། ༼སྣར། པེ།༽ ཐོབ།"
    },
    {
      "span": {
        "start": 66498,
        "end": 66505
      },
      "text": "སྐྱེའོ་ ༼སྣར། པེ།༽ སྐྱེ་བོས་"
    },
    {
      "span": {
        "start": 66614,
        "end": 66620
      },
      "text": "འཕོའི་ ༼སྣར། པེ།༽ འཕོ་"
    },
    {
      "span": {
        "start": 66771,
        "end": 66778
      },
      "text": "མཐུན་པ། ༼སྣར། པེ།༽ མཐུན་པའོ།"
    },
    {
      "span": {
        "start": 66877,
        "end": 66881
      },
      "text": "རྒལ་ ༼སྣར། པེ།༽ བརྒལ་"
    },
    {
      "span": {
        "start": 66902,
        "end": 66907
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིས་"
    },
    {
      "span": {
        "start": 66936,
        "end": 66940
      },
      "text": "རྒལ་ ༼སྣར། པེ།༽ བརྒལ་"
    },
    {
      "span": {
        "start": 67034,
        "end": 67043
      },
      "text": "འཕགས་པའི་ ༼སྣར། པེ།༽ འཕགས་པ་"
    },
    {
      "span": {
        "start": 67096,
        "end": 67101
      },
      "text": "སྲེད་ ༼སྣར། པེ།༽ སྲིད་"
    },
    {
      "span": {
        "start": 67244,
        "end": 67250
      },
      "text": "བཟློག་ ༼སྣར། པེ།༽ སྡོགས་"
    },
    {
      "span": {
        "start": 67278,
        "end": 67284
      },
      "text": "བཟློག་ ༼སྣར། པེ།༽ སྡོགས་"
    },
    {
      "span": {
        "start": 67387,
        "end": 67405
      },
      "text": "བདེ་མིན་སྡུག་བསྔལ་ ༼སྣར། པེ།༽ དེ་བདེ་མི་སྡུག་"
    },
    {
      "span": {
        "start": 67807,
        "end": 67813
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བཏགས་"
    },
    {
      "span": {
        "start": 67850,
        "end": 67857
      },
      "text": "བསྡོགས་ ༼སྣར། པེ།༽ སྡོགས་"
    },
    {
      "span": {
        "start": 67924,
        "end": 67931
      },
      "text": "སྒོམ་པ་ ༼སྣར། པེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 68058,
        "end": 68064
      },
      "text": "བསྒོམ། ༼སྣར། པེ།༽ སྒོམ།"
    },
    {
      "span": {
        "start": 68262,
        "end": 68266
      },
      "text": "སྙམ་ ༼སྣར། པེ།༽ མཉམ་"
    },
    {
      "span": {
        "start": 68387,
        "end": 68396
      },
      "text": "སྐྱེད་དེ་ ༼སྣར། པེ།༽ སྐྱེད་དོ་"
    },
    {
      "span": {
        "start": 68554,
        "end": 68559
      },
      "text": "ཕྲ་བ་ ༼སྣར། པེ།༽ ཕྲ་བའི་"
    },
    {
      "span": {
        "start": 68642,
        "end": 68653
      },
      "text": "འདོད་གཏོགས་ ༼སྣར། པེ།༽ འདོད་ཆགས་"
    },
    {
      "span": {
        "start": 68813,
        "end": 68818
      },
      "text": "བཞིན། ༼སྣར། པེ།༽ གཉིས།"
    },
    {
      "span": {
        "start": 68835,
        "end": 68843
      },
      "text": "བཞིན་དེ་ ༼སྣར། པེ།༽ བཞིན་ནོ་"
    },
    {
      "span": {
        "start": 69157,
        "end": 69167
      },
      "text": "ཀྱིས་སྐྱེ། ༼སྣར།༽ ཀྱིས་སྟེ།"
    },
    {
      "span": {
        "start": 69694,
        "end": 69699
      },
      "text": "རྟོག་ ༼སྣར།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 70140,
        "end": 70143
      },
      "text": "ཛི་ ༼པེ།༽ འཛི་"
    }
  ]
}