{
  "durchens": [
    {
      "span": {
        "start": 158,
        "end": 162
      },
      "text": "གཏའ་ ༼སྣར། པེ།༽ རྟ་"
    },
    {
      "span": {
        "start": 162,
        "end": 178
      },
      "text": "གཏོར་དང་། བུམ་པ་ ༼སྣར། པེ།༽ གཏོར་"
    },
    {
      "span": {
        "start": 617,
        "end": 624
      },
      "text": "བསྲེག ། ༼པེ།༽ སྲེག །"
    },
    {
      "span": {
        "start": 624,
        "end": 631
      },
      "text": "དེ་ཡིས་ ༼སྣར།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 689,
        "end": 695
      },
      "text": "ཡི་ནི་ ༼སྣར།༽ ཡི་"
    },
    {
      "span": {
        "start": 876,
        "end": 879
      },
      "text": "བར་ ༼སྣར།༽ རབ་"
    },
    {
      "span": {
        "start": 882,
        "end": 886
      },
      "text": "བཅད། ༼སྣར། པེ།༽ གཅད།"
    },
    {
      "span": {
        "start": 1006,
        "end": 1013
      },
      "text": "བསྐྱེད་ ༼པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 1094,
        "end": 1100
      },
      "text": "གཟུང་། ༼པེ།༽ བཟུང་།"
    },
    {
      "span": {
        "start": 1223,
        "end": 1231
      },
      "text": "བསྙེན་པ་ ༼པེ།༽ གཉེན་པ་"
    },
    {
      "span": {
        "start": 1250,
        "end": 1258
      },
      "text": "མཆོག་གི་ ༼སྣར།༽ མཆོག་གིས་"
    },
    {
      "span": {
        "start": 1282,
        "end": 1289
      },
      "text": "བསྒྲུབ་ ༼པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 1323,
        "end": 1332
      },
      "text": "ལྡན་པ་ཡི། ༼པེ།༽ ལྡན་པ་ཡིས།"
    },
    {
      "span": {
        "start": 1478,
        "end": 1488
      },
      "text": "བསྒོམས་ཏེ། ༼པེ།༽ བསྒོམ་སྟེ།"
    },
    {
      "span": {
        "start": 1641,
        "end": 1645
      },
      "text": "ཤོག་ ༼པེ།༽ ཤོག།། །།"
    }
  ]
}