{
  "durchens": [
    {
      "span": {
        "start": 229,
        "end": 234
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 242,
        "end": 248
      },
      "text": "སྤྱོད་ ༼སྣར།༽ སྤྱོ་"
    },
    {
      "span": {
        "start": 256,
        "end": 265
      },
      "text": "དཔས་བཅོས་ ༼སྣར། པེ།༽ ཉམས་བཅོས་"
    },
    {
      "span": {
        "start": 602,
        "end": 611
      },
      "text": "བསྒོ་བའི་ ༼སྣར། པེ།༽ བསྒོམ་པའི་"
    },
    {
      "span": {
        "start": 624,
        "end": 631
      },
      "text": "སྙན་པར་ ༼སྣར། པེ།༽ སྙན་པ་"
    },
    {
      "span": {
        "start": 892,
        "end": 900
      },
      "text": "སྙོམས་པ་ ༼པེ།༽ སྙོམ་པ་"
    },
    {
      "span": {
        "start": 978,
        "end": 985
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ བརྟན་པ་"
    },
    {
      "span": {
        "start": 1058,
        "end": 1063
      },
      "text": "གྱུར་ ༼སྣར།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 1081,
        "end": 1087
      },
      "text": "སྲུངས། ༼སྣར། པེ།༽ སྲུང་།"
    },
    {
      "span": {
        "start": 1104,
        "end": 1109
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 1112,
        "end": 1117
      },
      "text": "གྱུར། ༼སྣར།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 1288,
        "end": 1295
      },
      "text": "སྤོང་བ་ ༼སྣར། པེ།༽ སྤོངས་པ་"
    },
    {
      "span": {
        "start": 1599,
        "end": 1606
      },
      "text": "རང་གིས་ ༼སྣར། པེ།༽ རང་གི་"
    },
    {
      "span": {
        "start": 1671,
        "end": 1676
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 1758,
        "end": 1763
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 1962,
        "end": 1967
      },
      "text": "གང་ལ་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 1975,
        "end": 1979
      },
      "text": "དེས་ ༼པེ།༽ དེས་ལ་"
    },
    {
      "span": {
        "start": 2542,
        "end": 2550
      },
      "text": "བསྔོས་པ་ ༼སྣར། པེ།༽ སྔོས་པ་"
    },
    {
      "span": {
        "start": 2632,
        "end": 2638
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 2825,
        "end": 2836
      },
      "text": "སྟོབས་ཀྱིས་ ༼སྣར། པེ།༽ སྟོབས་ཀྱི་"
    },
    {
      "span": {
        "start": 3036,
        "end": 3040
      },
      "text": "ཆེར་ ༼ཅོ།༽ ཆེན་"
    },
    {
      "span": {
        "start": 3199,
        "end": 3208
      },
      "text": "དུས་རྗེས་ ༼སྣར། པེ།༽ དུས་"
    },
    {
      "span": {
        "start": 3208,
        "end": 3211
      },
      "text": "སུ་ ༼སྣར། པེ།༽ སུ་རྗེས་"
    },
    {
      "span": {
        "start": 3594,
        "end": 3596
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 3611,
        "end": 3618
      },
      "text": "རང་གིས་ ༼སྣར། པེ།༽ རང་གི་"
    },
    {
      "span": {
        "start": 4106,
        "end": 4112
      },
      "text": "གསལ་བ་ ༼སྣར།༽ བསལ་བ་"
    },
    {
      "span": {
        "start": 4168,
        "end": 4175
      },
      "text": "གྱུར་པ་ ༼སྣར།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 4221,
        "end": 4239
      },
      "text": "ཇི་ལྟར་འགྱུར་ཞེ་ན། ༼སྣར།༽ ཇི་ལྟར་འབྱུང་།"
    },
    {
      "span": {
        "start": 4882,
        "end": 4886
      },
      "text": "ལྟར་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 5153,
        "end": 5158
      },
      "text": "སྤོང་ ༼སྣར།༽ སྟོང་"
    },
    {
      "span": {
        "start": 5365,
        "end": 5374
      },
      "text": "ཡུལ་གྱིས་ ༼སྣར། པེ།༽ ཡུལ་གྱི་"
    },
    {
      "span": {
        "start": 5377,
        "end": 5380
      },
      "text": "ལྟ་ ༼སྣར།༽ ལྟར་"
    },
    {
      "span": {
        "start": 5526,
        "end": 5537
      },
      "text": "སྙིང་པོ་ཅན་ ༼སྣར། པེ།༽ སྙིང་པོ་"
    },
    {
      "span": {
        "start": 5685,
        "end": 5688
      },
      "text": "ཏེ། ༼སྣར། པེ།༽ རོ། །"
    },
    {
      "span": {
        "start": 5871,
        "end": 5880
      },
      "text": "ཏིང་འཛིན་ ༼སྣར། པེ།༽ ཏིང་ངེ་འཛིན་"
    },
    {
      "span": {
        "start": 5969,
        "end": 5978
      },
      "text": "དུས་ཀྱིས་ ༼སྣར།༽ དུས་ ༼པེ།༽ དུས་ཀྱི་"
    },
    {
      "span": {
        "start": 6029,
        "end": 6036
      },
      "text": "ལོན་པར་ ༼སྣར། པེ།༽ ལོག་པར་"
    },
    {
      "span": {
        "start": 6087,
        "end": 6093
      },
      "text": "བར་དུ་ ༼སྣར། པེ།༽ བར་"
    },
    {
      "span": {
        "start": 6107,
        "end": 6114
      },
      "text": "སྦྱང་བ་ ༼སྣར། པེ།༽ སྦྱངས་པ་"
    },
    {
      "span": {
        "start": 6128,
        "end": 6134
      },
      "text": "རྒྱུན་ ༼སྣར། པེ།༽ རྒྱན་"
    },
    {
      "span": {
        "start": 6339,
        "end": 6343
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 6591,
        "end": 6593
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 6611,
        "end": 6622
      },
      "text": "གྲོགས་ཀྱིས་ ༼སྣར། པེ།༽ གྲོགས་ཀྱི་"
    },
    {
      "span": {
        "start": 6755,
        "end": 6761
      },
      "text": "གཟུངས་ ༼སྣར། པེ།༽ བཟུངས་"
    },
    {
      "span": {
        "start": 6787,
        "end": 6797
      },
      "text": "མ་རབས་ཀྱི་ ༼སྣར། པེ།༽ མ་རབས་ཀྱིས་"
    },
    {
      "span": {
        "start": 7128,
        "end": 7134
      },
      "text": "གཞན་ལ་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 7600,
        "end": 7611
      },
      "text": "སྟོབས་ཀྱིས་ ༼སྣར། པེ།༽ སྟོབས་ཀྱི་"
    },
    {
      "span": {
        "start": 7837,
        "end": 7850
      },
      "text": "ཇི་ལྟར་འགྱུར་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 7963,
        "end": 7970
      },
      "text": "བརྒྱུད་ ༼སྣར། པེ།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 8140,
        "end": 8144
      },
      "text": "སྟན་ ༼སྣར།༽ བསྟན་"
    },
    {
      "span": {
        "start": 8196,
        "end": 8202
      },
      "text": "བསྲང་། ༼སྣར། པེ།༽ སྲང་།"
    },
    {
      "span": {
        "start": 8900,
        "end": 8908
      },
      "text": "ཡིས་བྱེ་ ༼སྣར། པེ།༽ ཡི་ཕྱེ་"
    },
    {
      "span": {
        "start": 9014,
        "end": 9020
      },
      "text": "ཆ་ཡིས་ ༼སྣར། པེ།༽ ཆ་ཡི་"
    },
    {
      "span": {
        "start": 9094,
        "end": 9100
      },
      "text": "དང་དུ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 9464,
        "end": 9471
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 9608,
        "end": 9614
      },
      "text": "བསྟོད། ༼སྣར། པེ།༽ གཏོད།"
    },
    {
      "span": {
        "start": 9704,
        "end": 9711
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 9782,
        "end": 9794
      },
      "text": "བྱེ་བྲག་གིས་ ༼སྣར། པེ།༽ བྱེ་བྲག་གི་"
    },
    {
      "span": {
        "start": 9874,
        "end": 9877
      },
      "text": "ལས་ ༼པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 9897,
        "end": 9905
      },
      "text": "པས་སེམས་ ༼སྣར། པེ།༽ པས་"
    },
    {
      "span": {
        "start": 9926,
        "end": 9930
      },
      "text": "བའོ། ༼སྣར། པེ།༽ རོ།"
    },
    {
      "span": {
        "start": 9940,
        "end": 9952
      },
      "text": "བྱེ་བྲག་གིས་ ༼སྣར། པེ།༽ བྱེ་བྲག་གི་"
    },
    {
      "span": {
        "start": 10135,
        "end": 10146
      },
      "text": "སྟོབས་ཀྱིས་ ༼སྣར། པེ།༽ སྟོབས་ཀྱི་"
    },
    {
      "span": {
        "start": 10396,
        "end": 10408
      },
      "text": "བྱེ་བྲག་གིས་ ༼སྣར། པེ།༽ བྱེ་བྲག་གི་"
    },
    {
      "span": {
        "start": 10652,
        "end": 10654
      },
      "text": "པ་ ༼སྣར། པེ།༽ པས་"
    },
    {
      "span": {
        "start": 10818,
        "end": 10828
      },
      "text": "ཞེ་སྡང་དང་ ༼སྣར། པེ།༽ ཞེ་སྡང་"
    },
    {
      "span": {
        "start": 11039,
        "end": 11051
      },
      "text": "བྱེ་བྲག་གིས་ ༼སྣར། པེ།༽ བྱེ་བྲག་གི་"
    },
    {
      "span": {
        "start": 11335,
        "end": 11344
      },
      "text": "བཟུང་བའང་ ༼སྣར། པེ།༽ གཟུང་བའང་"
    },
    {
      "span": {
        "start": 11378,
        "end": 11384
      },
      "text": "ཤེས་པ་ ༼སྣར། པེ།༽ ཤེས་པས་"
    },
    {
      "span": {
        "start": 11623,
        "end": 11630
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 11789,
        "end": 11794
      },
      "text": "བསྔོ་ ༼སྣར། པེ།༽ སྔོ་"
    },
    {
      "span": {
        "start": 11887,
        "end": 11894
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 11972,
        "end": 11994
      },
      "text": "འདི་ལྟར་ཉོན་མོངས་པ་དང་ ༼སྣར། པེ།༽ ཉོན་མོངས་པ་"
    },
    {
      "span": {
        "start": 12546,
        "end": 12551
      },
      "text": "དག་པ་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 12594,
        "end": 12601
      },
      "text": "ལ་ལྟ་བ་ ༼སྣར།༽ ལ་"
    },
    {
      "span": {
        "start": 12667,
        "end": 12673
      },
      "text": "རྟག་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 12712,
        "end": 12720
      },
      "text": "ཁམས་ཀྱི་ ༼སྣར། པེ།༽ ཁམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 12859,
        "end": 12865
      },
      "text": "བསྲིང་ ༼སྣར།༽ སྲིང་"
    },
    {
      "span": {
        "start": 12924,
        "end": 12930
      },
      "text": "རྣམ་པ་ ༼སྣར། པེ།༽ རྣམ་པ་ལ་"
    },
    {
      "span": {
        "start": 13340,
        "end": 13346
      },
      "text": "བཟའ་བ་ ༼སྣར། པེ།༽ ཟ་བ་"
    },
    {
      "span": {
        "start": 13432,
        "end": 13437
      },
      "text": "ལྟ་བ་ ༼སྣར།༽ བལྟ་བ་"
    },
    {
      "span": {
        "start": 13499,
        "end": 13509
      },
      "text": "ལུས་ངག་གི་ ༼སྣར།༽ ལུས་ངག་གིས་"
    },
    {
      "span": {
        "start": 13612,
        "end": 13619
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 13758,
        "end": 13766
      },
      "text": "ས་ལ་གནས། ༼སྣར། པེ།༽ ས་ནས།"
    },
    {
      "span": {
        "start": 13862,
        "end": 13867
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 13883,
        "end": 13887
      },
      "text": "བལྟ། ༼སྣར། པེ།༽ ལྟ།"
    },
    {
      "span": {
        "start": 13889,
        "end": 13901
      },
      "text": "ཡོན་ཏན་དམ་པ་ ༼ཅོ།༽ ཡོན་ཏན་དམ་"
    },
    {
      "span": {
        "start": 14045,
        "end": 14058
      },
      "text": "སེམས་ཅན་གྱིས་ ༼སྣར། པེ།༽ སེམས་ཅན་གྱི་"
    },
    {
      "span": {
        "start": 14120,
        "end": 14128
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ དང་པོ་"
    },
    {
      "span": {
        "start": 14502,
        "end": 14508
      },
      "text": "བདེ་བ་ ༼སྣར། པེ།༽ བདེན་པ་"
    },
    {
      "span": {
        "start": 14553,
        "end": 14562
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 14693,
        "end": 14698
      },
      "text": "རྟགས་ ༼སྣར། པེ།༽ བརྟགས་"
    },
    {
      "span": {
        "start": 14712,
        "end": 14717
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 14899,
        "end": 14908
      },
      "text": "ནི་དེ་ལས་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 15080,
        "end": 15084
      },
      "text": "སྙམ་ ༼སྣར།༽ སྙམས་"
    },
    {
      "span": {
        "start": 15337,
        "end": 15339
      },
      "text": "ན། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 15478,
        "end": 15481
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 15962,
        "end": 15965
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 15999,
        "end": 16007
      },
      "text": "བཟློག་པ་ ༼སྣར། པེ།༽ བཟློག་པ་ནི་"
    },
    {
      "span": {
        "start": 16063,
        "end": 16070
      },
      "text": "བརྟན་པ་ ༼སྣར།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 16164,
        "end": 16169
      },
      "text": "བྱའོ། ༼སྣར། པེ།༽ བྱེད་དོ།"
    },
    {
      "span": {
        "start": 16271,
        "end": 16279
      },
      "text": "འཕེལ་བར་ ༼པེ།༽ འཕེལ་"
    },
    {
      "span": {
        "start": 16876,
        "end": 16882
      },
      "text": "གཞག་པ་ ༼སྣར། པེ།༽ བཞག་པ་"
    },
    {
      "span": {
        "start": 17066,
        "end": 17071
      },
      "text": "ཕྲ་བ་ ༼སྣར། པེ།༽ ཕྲ་བ་དང་"
    },
    {
      "span": {
        "start": 17126,
        "end": 17135
      },
      "text": "བྱེད་པའོ། ༼སྣར། པེ།༽ བྱེད་དོ།"
    },
    {
      "span": {
        "start": 17245,
        "end": 17250
      },
      "text": "སྒོམ་ ༼སྣར།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 17825,
        "end": 17830
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ བརྟགས་"
    },
    {
      "span": {
        "start": 17868,
        "end": 17874
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 17980,
        "end": 17990
      },
      "text": "གཉིན་འདུན་ ༼སྣར། པེ།༽ གཉེན་འདུན་"
    },
    {
      "span": {
        "start": 18036,
        "end": 18039
      },
      "text": "ཡི་ ༼སྣར། པེ།༽ ཡིད་"
    },
    {
      "span": {
        "start": 18322,
        "end": 18331
      },
      "text": "ལུས་ཀྱིས་ ༼སྣར། པེ།༽ ལུས་ཀྱི་"
    },
    {
      "span": {
        "start": 18390,
        "end": 18397
      },
      "text": "ངག་གིས་ ༼སྣར། པེ།༽ ངག་གི་"
    },
    {
      "span": {
        "start": 18541,
        "end": 18547
      },
      "text": "ཅི་ཡང་ ༼སྣར། པེ།༽ ཙམ་དུ་"
    },
    {
      "span": {
        "start": 18732,
        "end": 18737
      },
      "text": "འཆོས་ ༼སྣར། པེ།༽ ཆོས་"
    },
    {
      "span": {
        "start": 18944,
        "end": 18955
      },
      "text": "རྒྱལ་བ་ཡིས་ ༼སྣར། པེ།༽ རྒྱལ་བ་ཡི་"
    },
    {
      "span": {
        "start": 18994,
        "end": 18996
      },
      "text": "བ་ ༼སྣར། པེ།༽ ས་"
    },
    {
      "span": {
        "start": 19035,
        "end": 19040
      },
      "text": "སྟོན་ ༼སྣར། པེ།༽ བཏོན་"
    },
    {
      "span": {
        "start": 19047,
        "end": 19057
      },
      "text": "སྤྱན་གྱིས་ ༼སྣར།༽ སྤྱན་གྱི་"
    },
    {
      "span": {
        "start": 19243,
        "end": 19252
      },
      "text": "ཆོས་ཀྱིས་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 19440,
        "end": 19447
      },
      "text": "རིག་པར་ ༼སྣར། པེ།༽ རིགས་པར་"
    },
    {
      "span": {
        "start": 19519,
        "end": 19523
      },
      "text": "མེད་ ༼སྣར། པེ།༽ མིན་"
    },
    {
      "span": {
        "start": 19542,
        "end": 19547
      },
      "text": "ལོ། ། ༼སྣར། པེ།༽ །། །།"
    }
  ]
}