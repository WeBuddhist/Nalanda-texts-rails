      },
      "text": "བརླབས་པ་ ༼སྣར། པེ།༽ བརླམས་པ་"
    },
    {
      "span": {
        "start": 734,
        "end": 737
      },
      "text": "ཡི། ༼སྣར། པེ།༽ ཡིས།"
    },
    {
      "span": {
        "start": 1030,
        "end": 1036
      },
      "text": "བསལ་ན། ༼སྣར། པེ།༽ བསལ་ནས།"
    },
    {
      "span": {
        "start": 1469,
        "end": 1478
      },
      "text": "ཡུན་རིངས་ ༼སྣར། པེ།༽ ཡུན་རིང་"
    }
  ]
