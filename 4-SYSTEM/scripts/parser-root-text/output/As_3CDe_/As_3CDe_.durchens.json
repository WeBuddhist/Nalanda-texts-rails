{
  "durchens": [
    {
      "span": {
        "start": 29,
        "end": 33
      },
      "text": "ཏྲི་ ༼སྣར། པེ།༽ ཏྲཻ་"
    },
    {
      "span": {
        "start": 314,
        "end": 316
      },
      "text": "ཏ་ ༼སྣར། པེ།༽ ཏ་ཡ་"
    },
    {
      "span": {
        "start": 634,
        "end": 656
      },
      "text": "། རྗེས་སུ་ཡི་རང་བ་དང་། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 778,
        "end": 791
      },
      "text": "གནས་པ་ལ་སོགས་ ༼སྣར། པེ།༽ གནས་པ་ལེགས་"
    },
    {
      "span": {
        "start": 821,
        "end": 824
      },
      "text": "ནྱ་ ༼སྣར། པེ།༽ ནྱེ་"
    },
    {
      "span": {
        "start": 974,
        "end": 982
      },
      "text": "སེམས་དང་ ༼སྣར། པེ།༽ སེམས་"
    },
    {
      "span": {
        "start": 992,
        "end": 1001
      },
      "text": "མཁན་གྱིས་ ༼སྣར། པེ།༽ མཁན་གྱི་"
    },
    {
      "span": {
        "start": 1039,
        "end": 1053
      },
      "text": "འཇིག་རྟེན་གྱི་ ༼སྣར། པེ།༽ འཇིག་རྟེན་གྱིས་"
    },
    {
      "span": {
        "start": 1076,
        "end": 1087
      },
      "text": "སྦྱང་བར་བྱ་ ༼སྣར། པེ།༽ སྦྱང་"
    },
    {
      "span": {
        "start": 1107,
        "end": 1114
      },
      "text": "ཁུག་རྣ་ ༼སྣར། པེ།༽ ཁུག་སྣ་"
    },
    {
      "span": {
        "start": 1366,
        "end": 1373
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོག་པ་མེད་པ་"
    },
    {
      "span": {
        "start": 1876,
        "end": 1890
      },
      "text": "རབ་འཕྲོས་ཤིང་། ༼སྣར། པེ།༽ རབ་འཕྲོ་ཞིང་།"
    },
    {
      "span": {
        "start": 2265,
        "end": 2271
      },
      "text": "བཅིངས་ ༼སྣར། པེ།༽ བཅིང་"
    },
    {
      "span": {
        "start": 2450,
        "end": 2453
      },
      "text": "ཡེ་ ༼སྣར། པེ།༽ ཡ་"
    },
    {
      "span": {
        "start": 2551,
        "end": 2556
      },
      "text": "བཤེས་ ༼སྣར།༽ གཤེས་"
    },
    {
      "span": {
        "start": 2636,
        "end": 2646
      },
      "text": "བཅོས་སོ། ། ༼སྣར།༽ བཅོས་། །ཡ་"
    },
    {
      "span": {
        "start": 2662,
        "end": 2667
      },
      "text": "སྨ་ར་ ༼སྣར། པེ།༽ སྨ་ར་ཉེ་སྙིང་ངོ་"
    }
  ]
}