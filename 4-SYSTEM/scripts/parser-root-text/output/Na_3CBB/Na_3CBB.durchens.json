{
  "durchens": [
    {
      "span": {
        "start": 26,
        "end": 36
      },
      "text": "མཱུ་ལ་སརྦ་ ༼སྣར། པེ།༽ མཱུ་ལས་རྦཱ་"
    },
    {
      "span": {
        "start": 43,
        "end": 46
      },
      "text": "དི་ ༼སྣར། པེ།༽ ད་"
    },
    {
      "span": {
        "start": 716,
        "end": 724
      },
      "text": "ཡིད་ཉིད་ ༼སྣར། པེ།༽ ཡིད་གཉིས་"
    },
    {
      "span": {
        "start": 745,
        "end": 750
      },
      "text": "གཞག ་ ༼སྣར། པེ།༽ གཞགབཞག་"
    },
    {
      "span": {
        "start": 836,
        "end": 840
      },
      "text": "ཡིན་ ༼སྣར།༽ ཡིད་"
    },
    {
      "span": {
        "start": 863,
        "end": 871
      },
      "text": "གསད་པའི་ ༼སྣར། པེ།༽ བསད་པའི་"
    },
    {
      "span": {
        "start": 884,
        "end": 888
      },
      "text": "མེད་ ༼སྣར།༽ མེ་"
    },
    {
      "span": {
        "start": 942,
        "end": 949
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 1029,
        "end": 1037
      },
      "text": "གསོད་པར་ ༼སྡེ།༽ གསད་པར་"
    },
    {
      "span": {
        "start": 1119,
        "end": 1123
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ ཡི།"
    },
    {
      "span": {
        "start": 1207,
        "end": 1222
      },
      "text": "དངོས་གཞིའོ་མིན་ ༼སྣར། པེ།༽ དངོས་གཞིའོ་མི་"
    },
    {
      "span": {
        "start": 1265,
        "end": 1271
      },
      "text": "གསད་པ་ ༼སྣར།༽ བསད་པ་"
    },
    {
      "span": {
        "start": 1271,
        "end": 1274
      },
      "text": "ཡི། ༼སྣར།༽ ཡིས།"
    },
    {
      "span": {
        "start": 1410,
        "end": 1415
      },
      "text": "བསམས་ ༼སྣར།༽ བསམ་"
    },
    {
      "span": {
        "start": 1429,
        "end": 1435
      },
      "text": "བསད་པ་ ༼སྣར། པེ།༽ གསད་པ་"
    },
    {
      "span": {
        "start": 1459,
        "end": 1467
      },
      "text": "བརྟགས་པ་ ༼པེ།༽ བརྟག་པ་"
    },
    {
      "span": {
        "start": 1524,
        "end": 1531
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་ཞིག་"
    },
    {
      "span": {
        "start": 1573,
        "end": 1593
      },
      "text": "ལ་སོགས་བླུགས་བྱེད་ལ། ༼སྣར།༽ ལ་སོགས་ལྡུགས་བྱེད ༼པེ།༽ ལ་སོགས་ལྡུགས་བྱེད་ལ།"
    },
    {
      "span": {
        "start": 1722,
        "end": 1728
      },
      "text": "བརྟག ། ༼སྣར། པེ།༽ རྟག །"
    },
    {
      "span": {
        "start": 1747,
        "end": 1750
      },
      "text": "ཀེ་ ༼སྣར། པེ།༽ ཀ་"
    },
    {
      "span": {
        "start": 1755,
        "end": 1765
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 1768,
        "end": 1773
      },
      "text": "རྡུལ་ ༼སྣར། པེ།༽ སྡུལ་"
    },
    {
      "span": {
        "start": 1831,
        "end": 1837
      },
      "text": "བརྟགས་ ༼སྣར།༽ བརྟེག་ ༼པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 2235,
        "end": 2239
      },
      "text": "ཚགས། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 2485,
        "end": 2493
      },
      "text": "གཅུགས་པ་ ༼སྣར། པེ།༽ བཅུགས་པ་"
    },
    {
      "span": {
        "start": 2787,
        "end": 2791
      },
      "text": "ཉིས་ ༼སྣར།༽ ནི་ ༼པེ།༽ ཉི་"
    },
    {
      "span": {
        "start": 2906,
        "end": 2911
      },
      "text": "ཁྲོན་ ༼སྣར། པེ།༽ ཁྲོམ་"
    },
    {
      "span": {
        "start": 2950,
        "end": 2957
      },
      "text": "བཙགས་ན་ ༼སྣར། པེ།༽ བཙགས་པ་"
    },
    {
      "span": {
        "start": 3071,
        "end": 3079
      },
      "text": "གྲྭ་སྲད་ ༼སྣར། པེ།༽ གྲ་སད་"
    },
    {
      "span": {
        "start": 3107,
        "end": 3114
      },
      "text": "བཙག་པར་ ༼སྣར། པེ།༽ བཙགས་པར་"
    },
    {
      "span": {
        "start": 3231,
        "end": 3234
      },
      "text": "དག་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 3318,
        "end": 3325
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 3383,
        "end": 3386
      },
      "text": "ཐར་ ༼སྣར། པེ།༽ ཐར་པར་"
    },
    {
      "span": {
        "start": 3391,
        "end": 3396
      },
      "text": "པ་ཡི་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 3597,
        "end": 3604
      },
      "text": "འཐུང་ན་ ༼སྣར། པེ།༽ འཐུངས་ཀྱང་"
    },
    {
      "span": {
        "start": 3681,
        "end": 3690
      },
      "text": "བཏུང་བའི་ ༼སྣར། པེ།༽ རུང་བའི་"
    },
    {
      "span": {
        "start": 3695,
        "end": 3706
      },
      "text": "རྣམས་དག་གི་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་ནི་"
    },
    {
      "span": {
        "start": 3717,
        "end": 3724
      },
      "text": "རྟག་ཏུ་ ༼སྣར། པེ།༽ རབ་ཏུ་"
    },
    {
      "span": {
        "start": 3931,
        "end": 3938
      },
      "text": "ཁྲོན་པ་ ༼སྣར། པེ།༽ ཁྲོམ་པ་"
    },
    {
      "span": {
        "start": 3982,
        "end": 3987
      },
      "text": "ཚིགས་ ༼སྣར། པེ།༽ ཚིག་"
    },
    {
      "span": {
        "start": 4017,
        "end": 4028
      },
      "text": "བྱེད་པ་ནའང་ ༼སྣར། པེ།༽ བྱེད་ན་ཡང་"
    },
    {
      "span": {
        "start": 4178,
        "end": 4183
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 4192,
        "end": 4200
      },
      "text": "དལ་གྱིས་ ༼པེ།༽ དལ་གྱི་"
    },
    {
      "span": {
        "start": 4203,
        "end": 4210
      },
      "text": "བལ་གཞག་ ༼སྣར། པེ།༽ མར་བཞག་"
    },
    {
      "span": {
        "start": 4282,
        "end": 4286
      },
      "text": "རྩྭ་ ༼ཅོ།༽ རྩ་"
    },
    {
      "span": {
        "start": 4489,
        "end": 4494
      },
      "text": "མཚོན་ ༼སྣར། པེ།༽ ཚོན་"
    },
    {
      "span": {
        "start": 4666,
        "end": 4671
      },
      "text": "བསྐོ། ༼སྣར།༽ བསྒོ།"
    },
    {
      "span": {
        "start": 4827,
        "end": 4831
      },
      "text": "ཤིག་ ༼སྣར། པེ།༽ ཅིག་"
    },
    {
      "span": {
        "start": 4901,
        "end": 4910
      },
      "text": "ན་རེ་སྤོ་ ༼སྣར། པེ།༽ ན་བས་སྤོས་"
    },
    {
      "span": {
        "start": 5058,
        "end": 5064
      },
      "text": "དང་། ། ༼སྣར། པེ།༽ དག །"
    },
    {
      "span": {
        "start": 5101,
        "end": 5109
      },
      "text": "རྡེག་པར་ ༼སྣར། པེ།༽ བརྡེག་པར་"
    },
    {
      "span": {
        "start": 5311,
        "end": 5321
      },
      "text": "མེས་གཏོང་། ༼པེ།༽ མེད་གཏུང་།"
    },
    {
      "span": {
        "start": 5344,
        "end": 5350
      },
      "text": "བརྟོལ་ ༼པེ།༽ རྟོལ་"
    },
    {
      "span": {
        "start": 5803,
        "end": 5807
      },
      "text": "རྐུ་ ༼སྣར། པེ།༽ སྐུ་"
    },
    {
      "span": {
        "start": 5822,
        "end": 5824
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 6098,
        "end": 6104
      },
      "text": "ཕྲོགས་ ༼སྣར། པེ།༽ འཕྲོག་"
    },
    {
      "span": {
        "start": 6187,
        "end": 6201
      },
      "text": "འཇིག་རྟེན་གྱི། ༼སྣར། པེ།༽ འཇིག་རྟེན་གྱིས།"
    },
    {
      "span": {
        "start": 6334,
        "end": 6341
      },
      "text": "འདམ་པར་ ༼སྣར། པེ།༽ འདམས་པར་"
    },
    {
      "span": {
        "start": 6480,
        "end": 6482
      },
      "text": "པ་ ༼སྣར། པེ།༽ ས་"
    },
    {
      "span": {
        "start": 6682,
        "end": 6691
      },
      "text": "སྐོར་བའི་ ༼སྣར། པེ།༽ བསྐོར་བའི་"
    },
    {
      "span": {
        "start": 6806,
        "end": 6813
      },
      "text": "ལྟུང་བ་ ༼སྣར། པེ།༽ བརྐུས་པ་"
    },
    {
      "span": {
        "start": 6845,
        "end": 6854
      },
      "text": "རྐུ་ན་ནི། ༼སྣར། པེ།༽ རྐུ་བ་ན།"
    },
    {
      "span": {
        "start": 6998,
        "end": 7011
      },
      "text": "གོམ་པར་སྐྱེད་ ༼ཅོ།༽ གོམ་པར་བསྐྱེད་ ༼སྣར། པེ།༽ གོམ་པ་བསྐྱེད་"
    },
    {
      "span": {
        "start": 7019,
        "end": 7025
      },
      "text": "འབྲིད་ ༼སྣར། པེ།༽ ཕྲི་"
    },
    {
      "span": {
        "start": 7089,
        "end": 7098
      },
      "text": "ཕྲོག་པའང་ ༼སྣར། པེ།༽ འཕྲོག་པའང་"
    },
    {
      "span": {
        "start": 7343,
        "end": 7348
      },
      "text": "བརྐུ་ ༼པེ།༽ རྐུ་"
    },
    {
      "span": {
        "start": 7693,
        "end": 7701
      },
      "text": "ཤོག་ཤིག་ ༼སྣར། པེ།༽ ཤོག་ཅིག་"
    },
    {
      "span": {
        "start": 7746,
        "end": 7748
      },
      "text": "པ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 7801,
        "end": 7808
      },
      "text": "འགྲིབས་ ༼སྣར།༽ འགྲིངས་"
    },
    {
      "span": {
        "start": 7823,
        "end": 7829
      },
      "text": "འགྱུར། ༼སྣར།༽ གྱུར།"
    },
    {
      "span": {
        "start": 7916,
        "end": 7922
      },
      "text": "བརྟེག་ ༼སྣར། པེ།༽ བཏེག་"
    },
    {
      "span": {
        "start": 7956,
        "end": 7962
      },
      "text": "བརྒྱབ་ ༼པེ།༽ བརྒྱབས་"
    },
    {
      "span": {
        "start": 8216,
        "end": 8221
      },
      "text": "གཞག ་ ༼སྣར། པེ།༽ གཞགབཞག་"
    },
    {
      "span": {
        "start": 8268,
        "end": 8272
      },
      "text": "ཆེད་ ༼སྣར། པེ།༽ ཕྱེད་"
    },
    {
      "span": {
        "start": 8304,
        "end": 8307
      },
      "text": "མང་ ༼སྣར། པེ།༽ མིན་"
    },
    {
      "span": {
        "start": 8438,
        "end": 8506
      },
      "text": "། །ཤིང་ནི་བཏོན་ནས་རྐུ་ཞེས་བཤད་པ་ལས། །ཁ་གདངས་ནས་ནི་ཉལ་བ་ཇི་བཞིན་ནོ། ། ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 8645,
        "end": 8650
      },
      "text": "བྱེད་ ༼སྣར།༽ བྱང་"
    },
    {
      "span": {
        "start": 8679,
        "end": 8684
      },
      "text": "སྙོན་ ༼སྣར། པེ།༽ སྙོམས་"
    },
    {
      "span": {
        "start": 8760,
        "end": 8765
      },
      "text": "བརྐུ། ༼སྣར། པེ།༽ རྐུ།"
    },
    {
      "span": {
        "start": 8801,
        "end": 8807
      },
      "text": "སྐྱིས་ ༼སྣར།༽ བསྐྱིས་ ༼པེ།༽ བསྐྱིད་"
    },
    {
      "span": {
        "start": 8855,
        "end": 8861
      },
      "text": "ཉེས་པ་ ༼སྣར། པེ།༽ བརྐུས་པ་"
    },
    {
      "span": {
        "start": 9355,
        "end": 9362
      },
      "text": "པ་སྟེང་ ༼སྣར། པེ།༽ ས་སྟེང་"
    },
    {
      "span": {
        "start": 9539,
        "end": 9543
      },
      "text": "རྐུ་ ༼སྣར།༽ རྐུས་"
    },
    {
      "span": {
        "start": 9696,
        "end": 9704
      },
      "text": "རྐུ་བའི་ ༼སྣར། པེ།༽ བརྐུ་བྱའི་"
    },
    {
      "span": {
        "start": 9765,
        "end": 9771
      },
      "text": "ངེས་པ་ ༼སྣར།༽ ངས་པ་"
    },
    {
      "span": {
        "start": 9794,
        "end": 9799
      },
      "text": "གཞག ་ ༼སྣར། པེ།༽ གཞགབཞག་"
    },
    {
      "span": {
        "start": 9875,
        "end": 9883
      },
      "text": "ནན་གྱིས་ ༼སྣར། པེ།༽ ནན་གྱི་"
    },
    {
      "span": {
        "start": 9952,
        "end": 9959
      },
      "text": "དེ་བདག་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 10090,
        "end": 10103
      },
      "text": "སྐྲོགས་པ་ཡིས། ༼སྣར། པེ།༽ སྐྲོགས་པ་ཡི།"
    },
    {
      "span": {
        "start": 10144,
        "end": 10150
      },
      "text": "བཤད་པ་ ༼སྣར། པེ།༽ ཤད་པ་"
    },
    {
      "span": {
        "start": 10285,
        "end": 10287
      },
      "text": "ན། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 10521,
        "end": 10534
      },
      "text": "དངོས་པོ་རྣམས། ༼སྣར། པེ།༽ རྣམ་པ་འོངས།"
    },
    {
      "span": {
        "start": 10823,
        "end": 10830
      },
      "text": "ཙམ་ཞིག་ ༼སྣར། པེ།༽ གཅིག་གཅིག་"
    },
    {
      "span": {
        "start": 10993,
        "end": 10999
      },
      "text": "བརྩོན་ ༼སྣར།༽ རྩོན་"
    },
    {
      "span": {
        "start": 11481,
        "end": 11487
      },
      "text": "ལག་གི་ ༼སྣར། པེ།༽ ལག་གིས་"
    },
    {
      "span": {
        "start": 11550,
        "end": 11554
      },
      "text": "གཞལ། ༼སྣར།༽ བཞལ།"
    },
    {
      "span": {
        "start": 11708,
        "end": 11713
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 11724,
        "end": 11729
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 11762,
        "end": 11768
      },
      "text": "དད་པས་ ༼སྣར། པེ།༽ ནད་པས་"
    },
    {
      "span": {
        "start": 11908,
        "end": 11911
      },
      "text": "ཚན་ ༼སྣར། པེ།༽ མཚན་"
    },
    {
      "span": {
        "start": 12270,
        "end": 12274
      },
      "text": "དག ་ ༼སྣར། པེ།༽ དགཡི་"
    },
    {
      "span": {
        "start": 12304,
        "end": 12308
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ མིན།"
    },
    {
      "span": {
        "start": 12324,
        "end": 12337
      },
      "text": "མཚམས་གཉིས་པར་ ༼སྣར། པེ།༽ མཚན་གཉིས་པར་"
    },
    {
      "span": {
        "start": 12337,
        "end": 12340
      },
      "text": "ཤི་ ༼སྣར།༽ ཤིས་"
    },
    {
      "span": {
        "start": 12393,
        "end": 12399
      },
      "text": "གཞག་པ་ ༼སྣར། པེ།༽ བཞག་པ་"
    },
    {
      "span": {
        "start": 12411,
        "end": 12423
      },
      "text": "གཉིས་ཀར་གཞག་ ༼སྣར། པེ།༽ གཉི་གར་བཞག་"
    },
    {
      "span": {
        "start": 12425,
        "end": 12433
      },
      "text": "དེ་བཞིན་ ༼སྣར། པེ།༽ དེ་ཕྱིར་"
    },
    {
      "span": {
        "start": 12579,
        "end": 12581
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 12657,
        "end": 12663
      },
      "text": "བརླབས། ༼སྣར། པེ།༽ བརླབ།"
    },
    {
      "span": {
        "start": 12774,
        "end": 12778
      },
      "text": "གཏང་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 12834,
        "end": 12840
      },
      "text": "བོར་ན། ༼སྣར།༽ བོར་ནས།"
    },
    {
      "span": {
        "start": 12879,
        "end": 12883
      },
      "text": "རིམ་ ༼སྣར། པེ།༽ རིམས་"
    },
    {
      "span": {
        "start": 12948,
        "end": 12954
      },
      "text": "ནད་པས་ ༼སྣར། པེ།༽ ནད་པ་"
    },
    {
      "span": {
        "start": 12969,
        "end": 12974
      },
      "text": "བླང་། ༼སྣར། པེ།༽ བླངས།"
    },
    {
      "span": {
        "start": 13013,
        "end": 13022
      },
      "text": "ནོར་གྱིས་ ༼སྣར། པེ།༽ ནོར་གྱི་"
    },
    {
      "span": {
        "start": 13027,
        "end": 13030
      },
      "text": "པས་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 13268,
        "end": 13276
      },
      "text": "བསྒོ་བར་ ༼སྣར། པེ།༽ བསྐོ་བར་"
    },
    {
      "span": {
        "start": 13336,
        "end": 13339
      },
      "text": "དག་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 13533,
        "end": 13538
      },
      "text": "གཞག། ༼སྣར། པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 13762,
        "end": 13765
      },
      "text": "ཟས་ ༼སྣར། པེ།༽ ཟན་"
    },
    {
      "span": {
        "start": 13846,
        "end": 13850
      },
      "text": "དང་། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 13968,
        "end": 13976
      },
      "text": "བཀྲོལ་བ་ ༼སྣར། པེ།༽ འགྲོལ་བ་"
    },
    {
      "span": {
        "start": 14021,
        "end": 14026
      },
      "text": "འཇིག་ ༼པེ།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 14076,
        "end": 14082
      },
      "text": "གཅུགས་ ༼སྣར། པེ།༽ བཅུགས་"
    },
    {
      "span": {
        "start": 14177,
        "end": 14183
      },
      "text": "གཅུགས་ ༼སྣར། པེ།༽ བཅུགས་"
    },
    {
      "span": {
        "start": 14209,
        "end": 14272
      },
      "text": "། །ཐ་མ་ལ་ནི་ཐ་མ་འབྲིང་ལ་འབྲིང་། །ཐ་མ་དང་སྟེ་དང་པོ་མཐའ་དག་ཉིད། ། ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 14394,
        "end": 14407
      },
      "text": "པི་ལིང་དབད་ས་ ༼སྣར། པེ།༽ པི་ལིནྡ་བཏས་"
    },
    {
      "span": {
        "start": 14577,
        "end": 14581
      },
      "text": "སྟན་ ༼སྣར།༽ བསྟན་"
    },
    {
      "span": {
        "start": 14626,
        "end": 14628
      },
      "text": "ན། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 14652,
        "end": 14655
      },
      "text": "དེ་ ༼སྣར།༽ ང་"
    },
    {
      "span": {
        "start": 14742,
        "end": 14747
      },
      "text": "སྟེན་ ༼སྣར། པེ།༽ སྟན་"
    },
    {
      "span": {
        "start": 14864,
        "end": 14872
      },
      "text": "བརྐམ་པས་ ༼སྣར། པེ།༽ སྐམ་པས་"
    },
    {
      "span": {
        "start": 14888,
        "end": 14892
      },
      "text": "བཞད་ ༼སྣར། པེ།༽ གཞད་"
    },
    {
      "span": {
        "start": 15019,
        "end": 15025
      },
      "text": "སྔ་ནས་ ༼སྣར། པེ།༽ སྔ་མ་"
    },
    {
      "span": {
        "start": 15030,
        "end": 15032
      },
      "text": "ལ་ ༼སྣར།༽ པ་"
    },
    {
      "span": {
        "start": 15037,
        "end": 15041
      },
      "text": "མནན་ ༼སྣར།༽ གནད་ ༼པེ།༽ གནན་"
    },
    {
      "span": {
        "start": 15052,
        "end": 15057
      },
      "text": "སྟེན་ ༼སྣར། པེ།༽ སྟན་"
    },
    {
      "span": {
        "start": 15102,
        "end": 15106
      },
      "text": "སྔོ་ ༼སྣར། པེ།༽ བསྔོ་"
    },
    {
      "span": {
        "start": 15142,
        "end": 15147
      },
      "text": "དཔེས་ ༼སྣར། པེ།༽ དཔེ་"
    },
    {
      "span": {
        "start": 15216,
        "end": 15222
      },
      "text": "འཇིགས་ ༼སྣར། པེ།༽ འཇིག་"
    },
    {
      "span": {
        "start": 15321,
        "end": 15326
      },
      "text": "གུའི་ ༼སྣར། པེ།༽ བའི་"
    },
    {
      "span": {
        "start": 15356,
        "end": 15359
      },
      "text": "ལས་ ༼སྣར།༽ པས་"
    },
    {
      "span": {
        "start": 15383,
        "end": 15391
      },
      "text": "རིག་པའི་ ༼སྣར། པེ།༽ རེག་པའི་"
    },
    {
      "span": {
        "start": 15999,
        "end": 16004
      },
      "text": "སྟུག་ ༼སྣར། པེ།༽ སྡུག་"
    },
    {
      "span": {
        "start": 16048,
        "end": 16054
      },
      "text": "ཡིན་ན་ ༼སྣར། པེ།༽ ཡིན་པས་"
    },
    {
      "span": {
        "start": 16285,
        "end": 16299
      },
      "text": "འདོད་ཆགས་ཀྱིས་ ༼སྣར། པེ།༽ འདོད་ཆགས་ཀྱི་"
    },
    {
      "span": {
        "start": 16346,
        "end": 16352
      },
      "text": "སྒྲོག་ ༼སྣར། པེ།༽ སྒྲོགས་"
    },
    {
      "span": {
        "start": 16486,
        "end": 16491
      },
      "text": "གཡོབ་ ༼སྣར། པེ།༽ གཡབ་"
    },
    {
      "span": {
        "start": 16735,
        "end": 16744
      },
      "text": "འཁྲི་ཤིང་ ༼སྣར། པེ།༽ ཁྲི་ཤིང་"
    },
    {
      "span": {
        "start": 16810,
        "end": 16815
      },
      "text": "བལྟས་ ༼པེ།༽ ལྷས་"
    },
    {
      "span": {
        "start": 16942,
        "end": 16945
      },
      "text": "མི་ ༼སྣར། པེ།༽ མ་"
    },
    {
      "span": {
        "start": 17101,
        "end": 17108
      },
      "text": "སྤོང་བ་ ༼སྣར། པེ།༽ སྤང་བ་"
    },
    {
      "span": {
        "start": 17357,
        "end": 17365
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 17395,
        "end": 17402
      },
      "text": "བྱ་ཡིས་ ༼སྣར། པེ།༽ བྱ་ཡི་"
    },
    {
      "span": {
        "start": 17521,
        "end": 17525
      },
      "text": "བདག་ ༼སྣར།༽ གདག་"
    },
    {
      "span": {
        "start": 17570,
        "end": 17581
      },
      "text": "གང་སྟན་བཀྲ་ ༼སྣར། པེ།༽ ཡང་བསྟན་འདྲ་"
    },
    {
      "span": {
        "start": 17634,
        "end": 17641
      },
      "text": "ཐོབ་ལས་ ༼སྣར། པེ།༽ ཐོབ་པས་"
    },
    {
      "span": {
        "start": 17649,
        "end": 17653
      },
      "text": "ཉམས་ ༼སྣར། པེ།༽ ཉམ་"
    },
    {
      "span": {
        "start": 17911,
        "end": 17916
      },
      "text": "བཏགས་ ༼སྣར། པེ།༽ བརྟགས་"
    },
    {
      "span": {
        "start": 17969,
        "end": 17981
      },
      "text": "འབྱུང་བས་ནི་ ༼སྣར། པེ།༽ ཚང་བྱུང་ན་"
    },
    {
      "span": {
        "start": 18152,
        "end": 18157
      },
      "text": "ཁྱོད་ ༼སྣར། པེ།༽ ཁྱེད་"
    },
    {
      "span": {
        "start": 18238,
        "end": 18247
      },
      "text": "ཟུར་གྱིས་ ༼སྣར། པེ།༽ ཟུར་གྱི་"
    },
    {
      "span": {
        "start": 18322,
        "end": 18328
      },
      "text": "ཁར་ཚང་ ༼སྣར། པེ།༽ ཁར་སང་"
    },
    {
      "span": {
        "start": 18332,
        "end": 18338
      },
      "text": "ཏེ་ལས་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 18462,
        "end": 18473
      },
      "text": "ཏེ་དེ་བཞིན་ ༼སྣར། པེ།༽ དེ་རེ་ཞིག་"
    },
    {
      "span": {
        "start": 18510,
        "end": 18517
      },
      "text": "དྲིས་ན། ༼སྣར། པེ།༽ དྲིས་ནས།"
    },
    {
      "span": {
        "start": 18579,
        "end": 18586
      },
      "text": "རྫུན་པ་ ༼སྣར།༽ བརྫུན་དུ་ ༼པེ།༽ རྫུན་དུ་"
    },
    {
      "span": {
        "start": 18690,
        "end": 18696
      },
      "text": "ཡིན། ། ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 18733,
        "end": 18740
      },
      "text": "ངག་གིས་ ༼སྣར། པེ།༽ ངག་གི་"
    },
    {
      "span": {
        "start": 18934,
        "end": 18941
      },
      "text": "དགོས་པ་ ༼སྣར། པེ།༽ དོགས་པ་"
    },
    {
      "span": {
        "start": 19021,
        "end": 19029
      },
      "text": "བརྩེ་བར་ ༼སྣར། པེ།༽ བརྩེ་བས་"
    },
    {
      "span": {
        "start": 19251,
        "end": 19255
      },
      "text": "སྨྲ་ ༼སྣར།༽ སྨ་"
    },
    {
      "span": {
        "start": 19295,
        "end": 19308
      },
      "text": "དབྱེ་བསྟན་ནས། ༼སྣར། པེ།༽ དབྱེ་བ་བསྟན།"
    },
    {
      "span": {
        "start": 19796,
        "end": 19799
      },
      "text": "ཡི། ༼སྣར།༽ ཡིན།"
    },
    {
      "span": {
        "start": 19837,
        "end": 19844
      },
      "text": "ངལ་སོས་ ༼སྣར། པེ།༽ ངལ་བ་སེས་"
    },
    {
      "span": {
        "start": 19987,
        "end": 19994
      },
      "text": "མཛའ་བོ་ ༼སྣར། པེ།༽ མཛའོ་"
    },
    {
      "span": {
        "start": 20084,
        "end": 20090
      },
      "text": "གསུངས་ ༼ཅོ།༽ གསུངས་མ་"
    },
    {
      "span": {
        "start": 20135,
        "end": 20143
      },
      "text": "རྫུན་དུ་ ༼ཅོ།༽ བརྫུན་ཏུ་"
    },
    {
      "span": {
        "start": 20268,
        "end": 20273
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱས་པ་"
    },
    {
      "span": {
        "start": 20288,
        "end": 20293
      },
      "text": "མྱོས་ ༼སྣར། པེ།༽ མྱོང་"
    },
    {
      "span": {
        "start": 20299,
        "end": 20303
      },
      "text": "རྩྭ་ ༼པེ།༽ རྩ་"
    },
    {
      "span": {
        "start": 20316,
        "end": 20321
      },
      "text": "བཏུང་ ༼ཅོ།༽ གཏུང་"
    },
    {
      "span": {
        "start": 20369,
        "end": 20372
      },
      "text": "དེ་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 20380,
        "end": 20387
      },
      "text": "ལ་སོགས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 20523,
        "end": 20530
      },
      "text": "མྱོས་ན་ ༼སྣར། པེ།༽ མྱོས་པས་"
    },
    {
      "span": {
        "start": 20570,
        "end": 20574
      },
      "text": "ཟ་བ་ ༼སྣར། པེ།༽ ཟ་བྱེད་"
    },
    {
      "span": {
        "start": 20648,
        "end": 20654
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 20777,
        "end": 20785
      },
      "text": "མཁུར་བར་ ༼སྣར། པེ།༽ འཁུ་བར་"
    },
    {
      "span": {
        "start": 20835,
        "end": 20840
      },
      "text": "སྐོལ་ ༼སྣར། པེ།༽ སྐོམ་"
    },
    {
      "span": {
        "start": 20916,
        "end": 20921
      },
      "text": "འཐུང་ ༼སྣར།༽ འཐུངས་"
    },
    {
      "span": {
        "start": 21017,
        "end": 21027
      },
      "text": "དྲེག་བཅོང་ ༼སྣར། པེ།༽ བྲེག་ཙོང་"
    },
    {
      "span": {
        "start": 21348,
        "end": 21355
      },
      "text": "སྤོང་བ་ ༼སྣར། པེ།༽ སྤང་བ་"
    },
    {
      "span": {
        "start": 21397,
        "end": 21406
      },
      "text": "རོལ་མོའི་ ༼སྣར། པེ།༽ རོལ་མོ་"
    },
    {
      "span": {
        "start": 21431,
        "end": 21439
      },
      "text": "ཅན་གྱིས་ ༼སྣར།༽ ཅན་གྱི་"
    },
    {
      "span": {
        "start": 21830,
        "end": 21834
      },
      "text": "མཆུ་ ༼སྣར། པེ།༽ ཆུ་"
    },
    {
      "span": {
        "start": 22003,
        "end": 22008
      },
      "text": "དགོད་ ༼སྣར། པེ།༽ རྒོད་"
    },
    {
      "span": {
        "start": 22064,
        "end": 22076
      },
      "text": "ཆོས་གོས་ཀྱི་ ༼སྣར། པེ།༽ ཆོས་གོས་ཀྱིས་"
    },
    {
      "span": {
        "start": 22186,
        "end": 22190
      },
      "text": "ཉེས་ ༼སྣར། པེ།༽ ཉེས་པ་"
    },
    {
      "span": {
        "start": 22279,
        "end": 22288
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 22467,
        "end": 22471
      },
      "text": "འདབ་ ༼སྣར། པེ།༽ འདག་"
    },
    {
      "span": {
        "start": 22582,
        "end": 22588
      },
      "text": "འདྲུད་ ༼སྣར།༽ འདྲུད་ཆད་འདྲུད་པ་"
    },
    {
      "span": {
        "start": 22590,
        "end": 22597
      },
      "text": "སོགས་པ་ ༼སྣར། པེ།༽ སོགས་"
    },
    {
      "span": {
        "start": 22625,
        "end": 22633
      },
      "text": "འདུག་ནས་ ༼སྣར། པེ།༽ འདུག་ན་"
    },
    {
      "span": {
        "start": 22721,
        "end": 22734
      },
      "text": "སྦྱིན་བདག་གི་ ༼སྣར། པེ།༽ སྦྱིན་བདག་གིས་"
    },
    {
      "span": {
        "start": 22860,
        "end": 22867
      },
      "text": "ཡིན་པས། ༼སྣར། པེ།༽ ཡིན་ནོ།"
    },
    {
      "span": {
        "start": 23131,
        "end": 23138
      },
      "text": "བྲལ་ནས་ ༼ཅོ།༽ བྲལ་ན་"
    },
    {
      "span": {
        "start": 23181,
        "end": 23188
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 23204,
        "end": 23211
      },
      "text": "དག་གིས་ ༼ཅོ།༽ དག་གི་"
    },
    {
      "span": {
        "start": 23279,
        "end": 23287
      },
      "text": "བྱས་པའམ་ ༼ཅོ།༽ བྱས་འང་ ༼སྣར། པེ།༽ བྱས་སམ་"
    },
    {
      "span": {
        "start": 23513,
        "end": 23518
      },
      "text": "སྤྲས་ ༼སྣར། པེ།༽ སྤྲད་"
    },
    {
      "span": {
        "start": 23574,
        "end": 23579
      },
      "text": "འཇིག་ ༼སྣར།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 23604,
        "end": 23610
      },
      "text": "འཛེགས་ ༼སྣར། པེ།༽ འཛེག་"
    },
    {
      "span": {
        "start": 23654,
        "end": 23662
      },
      "text": "ཆོས་ཀྱི་ ༼སྣར། པེ།༽ ཆོས་ནི་"
    },
    {
      "span": {
        "start": 23722,
        "end": 23729
      },
      "text": "མི་རྟག་ ༼སྣར།༽ མི་རྟག་པ་"
    },
    {
      "span": {
        "start": 23736,
        "end": 23745
      },
      "text": "བསྒོམ་པས་ ༼ཅོ།༽ བསྒོམས་པས་"
    },
    {
      "span": {
        "start": 23874,
        "end": 23879
      },
      "text": "གཉིད་ ༼སྣར།༽ གཉིས་"
    },
    {
      "span": {
        "start": 23903,
        "end": 23908
      },
      "text": "གནང་། ༼སྣར། པེ།༽ གནས།"
    },
    {
      "span": {
        "start": 24089,
        "end": 24094
      },
      "text": "འཁོབ་ ༼སྣར། པེ།༽ ཁོབ་"
    },
    {
      "span": {
        "start": 24106,
        "end": 24111
      },
      "text": "དབང་། ༼སྣར། པེ།༽ གནང་།"
    },
    {
      "span": {
        "start": 24507,
        "end": 24515
      },
      "text": "སྨན་གྱི་ ༼སྣར། པེ།༽ སྨན་གྱིས་"
    },
    {
      "span": {
        "start": 24637,
        "end": 24644
      },
      "text": "བསྒྲིམ། ༼སྣར། པེ།༽ བསྒྲིམས།"
    },
    {
      "span": {
        "start": 24749,
        "end": 24754
      },
      "text": "རེངས་ ༼སྣར། པེ།༽ རེང་"
    },
    {
      "span": {
        "start": 24765,
        "end": 24770
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 24881,
        "end": 24889
      },
      "text": "སྒེགས་པ་ ༼ཅོ།༽ སྦྲེགས་པ་ ༼སྣར། པེ།༽ སྒྲེགས་པ་"
    },
    {
      "span": {
        "start": 24889,
        "end": 24896
      },
      "text": "ཟས་བཅས་ ༼སྣར། པེ།༽ ཟས་ཅན་"
    },
    {
      "span": {
        "start": 24907,
        "end": 24914
      },
      "text": "བྱས་ནས། ༼སྣར། པེ།༽ བྱས་ཏེ།"
    },
    {
      "span": {
        "start": 25080,
        "end": 25083
      },
      "text": "ཚེ། ༼སྣར། པེ།༽ ཕྱིར།"
    },
    {
      "span": {
        "start": 25165,
        "end": 25167
      },
      "text": "ཤ་ ༼སྣར། པེ།༽ ཉ་"
    },
    {
      "span": {
        "start": 25170,
        "end": 25172
      },
      "text": "ཉ་ ༼སྣར། པེ།༽ ཤ་"
    },
    {
      "span": {
        "start": 25532,
        "end": 25535
      },
      "text": "ཚེ། ༼སྣར།༽ ཚྭ ༼པེ།༽ ཚུ།"
    },
    {
      "span": {
        "start": 25635,
        "end": 25639
      },
      "text": "ཡུང་ ༼སྣར། པེ།༽ ཡུལ་"
    },
    {
      "span": {
        "start": 25687,
        "end": 25694
      },
      "text": "དམར་པོ་ ༼སྣར། པེ།༽ དམར་པོ་ལ་"
    },
    {
      "span": {
        "start": 25699,
        "end": 25707
      },
      "text": "སྡོང་བུ། ༼སྣར། པེ།༽ སྡོང་།"
    },
    {
      "span": {
        "start": 25739,
        "end": 25750
      },
      "text": "མེ་ཏོག་ད་ཏ་ ༼སྣར། པེ།༽ མེ་ཏོག་གདྷ་"
    },
    {
      "span": {
        "start": 25780,
        "end": 25783
      },
      "text": "ལེ་ ༼སྣར། པེ།༽ ལེན་"
    },
    {
      "span": {
        "start": 25809,
        "end": 25814
      },
      "text": "སྨེལ་ ༼སྣར།༽ སྤྲེལ་"
    },
    {
      "span": {
        "start": 25853,
        "end": 25855
      },
      "text": "ཚ་ ༼སྣར། པེ།༽ ཚྭ་"
    },
    {
      "span": {
        "start": 25892,
        "end": 25896
      },
      "text": "ཀུན་ ༼སྣར། པེ།༽ ཁུན་"
    },
    {
      "span": {
        "start": 25955,
        "end": 25960
      },
      "text": "བཅངས་ ༼སྣར། པེ།༽ བཅང་"
    },
    {
      "span": {
        "start": 26175,
        "end": 26178
      },
      "text": "པར་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 26367,
        "end": 26371
      },
      "text": "བྱས་ ༼སྣར། པེ།༽ བཅས་"
    },
    {
      "span": {
        "start": 26380,
        "end": 26386
      },
      "text": "ཟས་མི་ ༼སྣར། པེ།༽ བཟའ་མི་"
    },
    {
      "span": {
        "start": 26386,
        "end": 26390
      },
      "text": "བཟའ། ༼སྣར། པེ།༽ བྱ།"
    },
    {
      "span": {
        "start": 26463,
        "end": 26473
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 26483,
        "end": 26491
      },
      "text": "བྱས་པའི་ ༼སྣར། པེ།༽ བཅས་པའི་"
    },
    {
      "span": {
        "start": 26512,
        "end": 26515
      },
      "text": "ཐན་ ༼སྣར། པེ།༽ ཐོན་"
    },
    {
      "span": {
        "start": 26543,
        "end": 26547
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 26559,
        "end": 26566
      },
      "text": "མནན་ནས་ ༼ཅོ།༽ མནན་ནན་"
    },
    {
      "span": {
        "start": 26700,
        "end": 26706
      },
      "text": "འདྲིམ་ ༼སྣར།༽ འདྲིན་"
    },
    {
      "span": {
        "start": 26774,
        "end": 26783
      },
      "text": "རིམ་གྱིས་ ༼སྣར། པེ།༽ རིམ་གྱི་"
    },
    {
      "span": {
        "start": 26815,
        "end": 26821
      },
      "text": "བཀག་པ་ ༼སྣར། པེ།༽ དགག་པ་"
    },
    {
      "span": {
        "start": 26847,
        "end": 26850
      },
      "text": "ཆང་ ༼སྣར། པེ།༽ ཆངས་"
    },
    {
      "span": {
        "start": 26855,
        "end": 26860
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 26903,
        "end": 26910
      },
      "text": "རྫས་སམ་ ༼སྣར། པེ།༽ རྫས་དང་"
    },
    {
      "span": {
        "start": 27259,
        "end": 27270
      },
      "text": "རུས་ལ་སོགས་ ༼སྣར། པེ།༽ རུས་བ་ལས་བྱས་"
    },
    {
      "span": {
        "start": 27325,
        "end": 27331
      },
      "text": "བཙོངས་ ༼སྣར། པེ།༽ ཚོང་"
    },
    {
      "span": {
        "start": 27355,
        "end": 27363
      },
      "text": "འབྲེལ་བ་ ༼སྣར། པེ།༽ བྲེལ་བ་"
    },
    {
      "span": {
        "start": 27432,
        "end": 27439
      },
      "text": "རང་གིས་ ༼སྣར། པེ།༽ རང་གི་"
    },
    {
      "span": {
        "start": 27653,
        "end": 27657
      },
      "text": "ཐོབ་ ༼སྣར། པེ།༽ འཐོབ་"
    },
    {
      "span": {
        "start": 27704,
        "end": 27712
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 27727,
        "end": 27738
      },
      "text": "གཞོགས་སློང་ ༼སྣར། པེ།༽ གཞོག་སློངས་"
    },
    {
      "span": {
        "start": 27761,
        "end": 27765
      },
      "text": "གཙང་ ༼སྣར། པེ།༽ གཅམ་"
    },
    {
      "span": {
        "start": 27835,
        "end": 27839
      },
      "text": "ལོག་ ༼སྣར།༽ ལོབ་"
    },
    {
      "span": {
        "start": 27863,
        "end": 27866
      },
      "text": "དག་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 28091,
        "end": 28095
      },
      "text": "ཚོན་ ༼སྣར། པེ།༽ མཚོན་"
    },
    {
      "span": {
        "start": 28188,
        "end": 28193
      },
      "text": "བཏིང་ ༼སྣར།༽ གཏིང་"
    },
    {
      "span": {
        "start": 28582,
        "end": 28586
      },
      "text": "གཞག་ ༼སྣར། པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 28685,
        "end": 28694
      },
      "text": "ཁུང་རྐེད་ ༼སྣར། པེ།༽ ཁུན་སྐེད་"
    },
    {
      "span": {
        "start": 28754,
        "end": 28761
      },
      "text": "བྱས་ནས་ ༼སྣར། པེ།༽ བྱས་ན་"
    },
    {
      "span": {
        "start": 28804,
        "end": 28810
      },
      "text": "དང་པོ་ ༼སྣར། པེ།༽ དང་པོར་"
    },
    {
      "span": {
        "start": 28829,
        "end": 28835
      },
      "text": "བྲེག ་ ༼སྣར། པེ།༽ བྲེགབྱ་"
    },
    {
      "span": {
        "start": 28878,
        "end": 28887
      },
      "text": "སེན་མོའི་ ༼སྣར། པེ།༽ སེན་མོ་"
    },
    {
      "span": {
        "start": 29028,
        "end": 29034
      },
      "text": "བསྐུར་ ༼སྣར། པེ།༽ བཀུར་"
    },
    {
      "span": {
        "start": 29203,
        "end": 29209
      },
      "text": "དེ་དག་ ༼སྣར། པེ།༽ འདི་དག་"
    },
    {
      "span": {
        "start": 29437,
        "end": 29440
      },
      "text": "ཟས་ ༼སྣར། པེ།༽ ཟན་"
    },
    {
      "span": {
        "start": 29487,
        "end": 29495
      },
      "text": "བསྟེན་པ་ ༼སྣར།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 29800,
        "end": 29807
      },
      "text": "བཤང་དང་ ༼སྣར། པེ།༽ བཤང་བ་"
    },
    {
      "span": {
        "start": 29828,
        "end": 29836
      },
      "text": "བྱུང་བར་ ༼སྣར། པེ།༽ འབྱུང་བར་"
    },
    {
      "span": {
        "start": 29850,
        "end": 29857
      },
      "text": "གཏང་བར་ ༼སྣར། པེ།༽ བཏང་བར་"
    },
    {
      "span": {
        "start": 30014,
        "end": 30021
      },
      "text": "གཉི་གར་ ༼སྣར། པེ།༽ གཉིས་ཀར་"
    },
    {
      "span": {
        "start": 30054,
        "end": 30059
      },
      "text": "གཞག ་ ༼སྣར། པེ།༽ གཞགབཞག་"
    },
    {
      "span": {
        "start": 30164,
        "end": 30168
      },
      "text": "ཕྱི་ ༼སྣར།༽ ཕྱིས་"
    },
    {
      "span": {
        "start": 30283,
        "end": 30291
      },
      "text": "གསུངས་པ་ ༼སྣར། པེ།༽ གསུང་བ་"
    },
    {
      "span": {
        "start": 30618,
        "end": 30626
      },
      "text": "ཁར་གསིལ་ ༼སྣར། པེ།༽ འཁར་གསིལ་"
    },
    {
      "span": {
        "start": 30718,
        "end": 30725
      },
      "text": "མཐུན་པ་ ༼ཅོ།༽ མཐུན་པའི་"
    },
    {
      "span": {
        "start": 30891,
        "end": 30895
      },
      "text": "གྲོ་ ༼སྣར། པེ།༽ འགྲོ་"
    },
    {
      "span": {
        "start": 31041,
        "end": 31045
      },
      "text": "སྔར་ ༼སྣར། པེ།༽ སྔ་"
    },
    {
      "span": {
        "start": 31109,
        "end": 31115
      },
      "text": "བླ་མར་ ༼སྣར། པེ།༽ བླ་མ་"
    },
    {
      "span": {
        "start": 31150,
        "end": 31156
      },
      "text": "མ་ཉམས་ ༼སྣར། པེ།༽ མཉམ་མམ་"
    },
    {
      "span": {
        "start": 31160,
        "end": 31168
      },
      "text": "འདྲི་ནས། ༼སྣར། པེ།༽ འདྲི་ན།"
    },
    {
      "span": {
        "start": 31536,
        "end": 31545
      },
      "text": "གསུམ་གྱི་ ༼སྣར། པེ།༽ གསུམ་གྱིས་"
    },
    {
      "span": {
        "start": 31554,
        "end": 31557
      },
      "text": "མི་ ༼སྣར། པེ།༽ གསུང་"
    },
    {
      "span": {
        "start": 31575,
        "end": 31584
      },
      "text": "ཨ་རོག་གྱ་ ༼སྣར། པེ།༽ ཨ་རོཀྵ་"
    },
    {
      "span": {
        "start": 31703,
        "end": 31712
      },
      "text": "ཨ་རོག་གྱ་ ༼སྣར། པེ།༽ ཨ་རོཀྵ་"
    },
    {
      "span": {
        "start": 31738,
        "end": 31746
      },
      "text": "ཚིག་གིས་ ༼སྣར། པེ།༽ ཚིག་གི་"
    },
    {
      "span": {
        "start": 31838,
        "end": 31845
      },
      "text": "བླ་མའི་ ༼སྣར། པེ།༽ བླ་མ་"
    },
    {
      "span": {
        "start": 31879,
        "end": 31890
      },
      "text": "བྱ་ཚིག་གིས་ ༼སྣར། པེ།༽ བྱ་ཚིག་གི་"
    },
    {
      "span": {
        "start": 32025,
        "end": 32031
      },
      "text": "ཟས་དང་ ༼སྣར། པེ།༽ ཟས་"
    },
    {
      "span": {
        "start": 32031,
        "end": 32035
      },
      "text": "བཅས་ ༼སྣར། པེ།༽ བཅས་ཁ་"
    },
    {
      "span": {
        "start": 32079,
        "end": 32087
      },
      "text": "ཁྱིམ་ནས་ ༼སྣར། པེ།༽ ཁྱིམ་གནས་"
    },
    {
      "span": {
        "start": 32273,
        "end": 32281
      },
      "text": "འདུད་པས་ ༼སྣར། པེ།༽ བཏུད་པས་"
    },
    {
      "span": {
        "start": 32509,
        "end": 32533
      },
      "text": "མཐུན་པ་སྟེ་བསླབ་པའི་གཞི་ ༼སྣར། པེ།༽ མཐུན་པ་སྟེ་"
    },
    {
      "span": {
        "start": 32942,
        "end": 32949
      },
      "text": "བདག་གི་ ༼སྣར།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 32964,
        "end": 32967
      },
      "text": "ཡང་ ༼སྣར། པེ།༽ ཡང་བདག་"
    },
    {
      "span": {
        "start": 32989,
        "end": 32996
      },
      "text": "ཡིན་ནོ། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 33190,
        "end": 33199
      },
      "text": "སྙིང་རྗེ་ ༼སྣར། པེ།༽ སྙིང་བརྩེ་"
    },
    {
      "span": {
        "start": 33836,
        "end": 33843
      },
      "text": "ཤི་ཞིང་ ༼སྣར། པེ།༽ ཆུ་ཤིང་"
    },
    {
      "span": {
        "start": 33926,
        "end": 33931
      },
      "text": "བཞིན་ ༼སྣར།༽ བཞི་"
    },
    {
      "span": {
        "start": 34048,
        "end": 34053
      },
      "text": "འདོན། ༼སྣར། པེ།༽ འདོད།"
    },
    {
      "span": {
        "start": 34095,
        "end": 34100
      },
      "text": "གསུང་ ༼སྣར།༽ གསུངས་"
    },
    {
      "span": {
        "start": 34115,
        "end": 34120
      },
      "text": "བཏོན་ ༼ཅོ།༽ གཏོན་"
    },
    {
      "span": {
        "start": 34132,
        "end": 34140
      },
      "text": "དཔྱད་པར་ ༼སྣར། པེ།༽ སྤྱད་པར་"
    },
    {
      "span": {
        "start": 34155,
        "end": 34161
      },
      "text": "བཀླག ། ༼སྣར། པེ།༽ ཀླག །"
    },
    {
      "span": {
        "start": 34247,
        "end": 34255
      },
      "text": "སྨོས་པས་ ༼སྣར། པེ།༽ སྨོས་པ་"
    },
    {
      "span": {
        "start": 34266,
        "end": 34273
      },
      "text": "བྱ་སྟེ། ༼སྣར། པེ།༽ བྱ་བྱས་ཏེ།"
    },
    {
      "span": {
        "start": 35226,
        "end": 35231
      },
      "text": "།། །། ༼སྣར། པེ།༽ །། །།ཉན་ཐོས་བྱེ་བྲག་ཏུ་སྨྲ་བའི་སློབ་དཔོན་སརྦ་ཛྙཱ་དེ་བ་དང་། ཞུ་ཆེན་གྱི་ལོ་ཙྪ་བ་དགེ་སློང་དེ་བེནྡྲ་རཀྵི་ཏས་བསྒྱུར་ཅིང་ཞུས་པའོ།། །།"
    }
  ]
}