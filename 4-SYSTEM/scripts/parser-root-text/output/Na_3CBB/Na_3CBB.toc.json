{
  "sections": [
    {
      "title": {
        "bo": "༄༅། །འཕགས་པ་གཞི་ཐམས་ཅད་ཡོད་པར་སྨྲ་བའི་དགེ་ཚུལ་གྱི་ཚིག་ལེའུར་བྱས་པ།"
      },
      "span": {
        "start": 0,
        "end": 35231
      },
      "subsections": [
        {
          "title": {
            "bo": "ཀླད་ཀྱི་དོན།"
          },
          "span": {
            "start": 0,
            "end": 169
          }
        },
        {
          "title": {
            "bo": "སྲོག་གཅོད་པ་སྤོང་བ་སྟེ་བསླབ་པའི་གཞི་དང་པོ།"
          },
          "span": {
            "start": 169,
            "end": 5524
          }
        },
        {
          "title": {
            "bo": "མ་བྱིན་པར་ལེན་པ་སྤོང་བ་སྟེ་བསླབ་པའི་གཞི་གཉིས་པ།"
          },
          "span": {
            "start": 5524,
            "end": 15209
          }
        },
        {
          "title": {
            "bo": "མི་ཚངས་སྤྱོད་པ་སྤོང་བ་སྟེ་བསླབ་པའི་གཞི་གསུམ་པ།"
          },
          "span": {
            "start": 15209,
            "end": 17138
          }
        },
        {
          "title": {
            "bo": "རྫུན་དུ་སྨྲ་བ་སྤོང་བ་སྟེ་བསླབ་པའི་གཞི་བཞི་པ།"
          },
          "span": {
            "start": 17138,
            "end": 20185
          }
        },
        {
          "title": {
            "bo": "མྱོས་པར་འགྱུར་བ་སྤོང་བ་སྟེ་བསླབ་པའི་གཞི་ལྔ་པ།"
          },
          "span": {
            "start": 20185,
            "end": 21383
          }
        },
        {
          "title": {
            "bo": "གླུ་གར་ལ་སོགས་པ་སྤོང་བ་སྟེ་བསླབ་པའི་གཞི་དྲུག་པ།"
          },
          "span": {
            "start": 21383,
            "end": 22325
          }
        },
        {
          "title": {
            "bo": "སྤོས་ལ་སོགས་པ་སྤོང་བ་སྟེ་བསླབ་པའི་གཞི་བདུན་པ།"
          },
          "span": {
            "start": 22325,
            "end": 23390
          }
        },
        {
          "title": {
            "bo": "མལ་མཐོན་པོ་ལ་སོགས་པ་སྤོང་བ་སྟེ་བསླབ་པའི་གཞི་བརྒྱད་པ།"
          },
          "span": {
            "start": 23390,
            "end": 24737
          }
        },
        {
          "title": {
            "bo": "དུས་མ་ཡིན་པའི་ཁ་ཟས་སྤོང་བ་སྟེ་བསླབ་པའི་གཞི་དགུ་པ།"
          },
          "span": {
            "start": 24737,
            "end": 27019
          }
        },
        {
          "title": {
            "bo": "གསེར་དངུལ་ལ་རེག་པ་སྤོང་བ་སྟེ་བསླབ་པའི་གཞི་བཅུ་པ།"
          },
          "span": {
            "start": 27019,
            "end": 27937
          }
        },
        {
          "title": {
            "bo": "ཁྱིམ་པའི་རྟགས་སྤོང་བའི་ཕྱོགས་དང་མཐུན་པ་སྟེ་བསླབ་པའི་གཞི་བཅུ་གཅིག་པ།"
          },
          "span": {
            "start": 27937,
            "end": 29295
          }
        },
        {
          "title": {
            "bo": "རབ་ཏུ་བྱུང་བ་ཉམས་པའི་ཕྱོགས་དང་མཐུན་པ་སྤོང་བ་སྟེ་བསླབ་པའི་གཞི་བཅུ་གཉིས་པ།"
          },
          "span": {
            "start": 29295,
            "end": 30766
          }
        },
        {
          "title": {
            "bo": "བླ་མར་གསོལ་བ་བཏབ་པ་ཉམས་པའི་ཕྱོགས་དང་མཐུན་པ་སྟེ་བསླབ་པའི་གཞི་བཅུ་གསུམ་པ།"
          },
          "span": {
            "start": 30766,
            "end": 32550
          }
        },
        {
          "title": {
            "bo": "སྡོམ་པ་མཐའ་དག་ཉམས་པའི་ཕྱོགས་དང་མཐུན་པ་སྟེ་བསླབ་པའི་གཞི་བཅུ་བཞི་པ།"
