{
  "durchens": [
    {
      "span": {
        "start": 310,
        "end": 317
      },
      "text": "གང་དེར་ ༼སྣར། པེ།༽ གང་དུ་"
    },
    {
      "span": {
        "start": 443,
        "end": 450
      },
      "text": "ཕྲད་པར་ ༼སྣར།༽ ཕྲད་པ་"
    },
    {
      "span": {
        "start": 581,
        "end": 589
      },
      "text": "བསྒོམ་པ་ ༼སྣར། པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 648,
        "end": 655
      },
      "text": "ཀྱང་། ། ༼སྣར། པེ།༽ ། །ཐེག་པ་ཆེན་པོའི་དོན་རྟོགས་ནས། །"
    },
    {
      "span": {
        "start": 804,
        "end": 812
      },
      "text": "མཚན་མའི་ ༼སྣར། པེ།༽ མཚན་པའི་"
    }
  ]
}