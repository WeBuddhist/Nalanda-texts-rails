{
  "durchens": [
    {
      "span": {
        "start": 124,
        "end": 128
      },
      "text": "འགལ་ ༼སྣར། པེ།༽ གལ་"
    },
    {
      "span": {
        "start": 254,
        "end": 259
      },
      "text": "བསྟན་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 531,
        "end": 538
      },
      "text": "ངོ་བོས་ ༼སྣར། པེ།༽ ངོ་བོ་"
    },
    {
      "span": {
        "start": 707,
        "end": 711
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ ཡི།"
    },
    {
      "span": {
        "start": 746,
        "end": 754
      },
      "text": "དོན་གྱི་ ༼སྣར། པེ།༽ དོན་གྱིས་"
    },
    {
      "span": {
        "start": 970,
        "end": 976
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 1032,
        "end": 1037
      },
      "text": "བསྟན་ ༼པེ།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 1184,
        "end": 1192
      },
      "text": "བརྟགས། ། ༼སྣར། པེ།༽ བརྟག །"
    },
    {
      "span": {
        "start": 1492,
        "end": 1498
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ རྟགས་"
    },
    {
      "span": {
        "start": 2026,
        "end": 2033
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 2214,
        "end": 2222
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ དངོས་པོའི་"
    },
    {
      "span": {
        "start": 2244,
        "end": 2247
      },
      "text": "ཕྲ་ ༼སྣར། པེ།༽ ཁྲ་"
    },
    {
      "span": {
        "start": 2584,
        "end": 2594
      },
      "text": "བརྟེན་གནས་ ༼སྣར། པེ།༽ རྟེན་གནས་"
    },
    {
      "span": {
        "start": 2855,
        "end": 2863
      },
      "text": "དོན་གྱི་ ༼སྣར།༽ དོན་གྱིས་"
    },
    {
      "span": {
        "start": 3074,
        "end": 3082
      },
      "text": "ཀུན་གྱི་ ༼པེ།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 3264,
        "end": 3269
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 3488,
        "end": 3493
      },
      "text": "མིག ། ༼སྣར། པེ།༽ མི། །"
    },
    {
      "span": {
        "start": 3779,
        "end": 3786
      },
      "text": "ནས་དང་། ༼སྣར། པེ།༽ ནས་"
    }
  ]
}