{
  "durchens": [
    {
      "span": {
        "start": 47,
        "end": 50
      },
      "text": "ཏུ་ ༼སྣར། པེ།༽ དུ་"
    },
    {
      "span": {
        "start": 54,
        "end": 64
      },
      "text": "རྡོ་དྲེགས་ ༼སྣར། པེ།༽ རྡོ་དྲེག་"
    },
    {
      "span": {
        "start": 78,
        "end": 86
      },
      "text": "སྤྲ་ཚིལ་ ༼སྣར། པེ།༽ པྲ་ཚིལ་"
    },
    {
      "span": {
        "start": 88,
        "end": 91
      },
      "text": "ལེ་ ༼སྣར།༽ ལི་"
    },
    {
      "span": {
        "start": 104,
        "end": 106
      },
      "text": "ཚ་ ༼སྣར། པེ།༽ ཚྭ་"
    },
    {
      "span": {
        "start": 295,
        "end": 307
      },
      "text": "ཤིང་ཆ་ཨ་ཀ་ར་ ༼སྣར། པེ།༽ ཤིང་ཚྭ་ཨ་གར་"
    },
    {
      "span": {
        "start": 316,
        "end": 321
      },
      "text": "ཀ་ཏུ་ ༼སྣར། པེ།༽ ཀ་དུ་"
    },
    {
      "span": {
        "start": 343,
        "end": 353
      },
      "text": "རྡོ་དྲེགས་ ༼སྣར། པེ།༽ རྡོ་དྲེག་"
    },
    {
      "span": {
        "start": 366,
        "end": 369
      },
      "text": "གན་ ༼སྣར། པེ།༽ གྷཾ་"
    },
    {
      "span": {
        "start": 504,
        "end": 510
      },
      "text": "ཉི་ཤུ་ ༼སྣར། པེ།༽ ཉི་ཤུ་ཆ་"
    },
    {
      "span": {
        "start": 510,
        "end": 516
      },
      "text": "ལས་ནི་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 558,
        "end": 560
      },
      "text": "ར་ ༼སྣར། པེ།༽ གར་"
    },
    {
      "span": {
        "start": 567,
        "end": 572
      },
      "text": "ར་ཏུ་ ༼སྣར།༽ ར་དུར་"
    },
    {
      "span": {
        "start": 576,
        "end": 579
      },
      "text": "གན་ ༼སྣར། པེ།༽ གྷཾ་"
    },
    {
      "span": {
        "start": 615,
        "end": 626
      },
      "text": "སུག་སྨེལ་པ་ ༼སྣར། པེ།༽ སུག་སྨེལ་པ་ན་"
    },
    {
      "span": {
        "start": 638,
        "end": 658
      },
      "text": "ཀུ་རེའུ་མིག་ཙོར་གཞག་ ༼སྣར།༽ ཀུ་རེའུརྩོར་བཞག་ ༼པེ།༽ ཀུ་རེའུཙོ་ར་བཞག་"
    },
    {
      "span": {
        "start": 672,
        "end": 676
      },
      "text": "ཚའི་ ༼སྣར། པེ།༽ ཚྭའི་"
    },
    {
      "span": {
        "start": 724,
        "end": 731
      },
      "text": "བྱས་ཏེ། ༼སྣར། པེ།༽ བྱ་སྟེ།"
    },
    {
      "span": {
        "start": 821,
        "end": 824
      },
      "text": "ལི་ ༼སྣར། པེ།༽ རི་"
    },
    {
      "span": {
        "start": 882,
        "end": 886
      },
      "text": "དྲི་ ༼སྣར། པེ།༽ གསེང་ཕྲོམ་ཧཾ་ན་གསུམ་གསུམ་བཞག་པ་དྲིལ་"
    },
    {
      "span": {
        "start": 910,
        "end": 912
      },
      "text": "ཚ་ ༼སྣར། པེ།༽ ཚྭ་"
    },
    {
      "span": {
        "start": 937,
        "end": 941
      },
      "text": "སེང་ ༼སྣར། པེ།༽ གསེང་"
    },
    {
      "span": {
        "start": 995,
        "end": 998
      },
      "text": "ལང་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 1012,
        "end": 1019
      },
      "text": "སྲེག་པ་ ༼སྣར། པེ།༽ བསྲེག་པ་"
    },
    {
      "span": {
        "start": 1061,
        "end": 1065
      },
      "text": "གའི་ ༼སྣར། པེ།༽ ཀའི་"
    },
    {
      "span": {
        "start": 1106,
        "end": 1108
      },
      "text": "ཀ་ ༼སྣར། པེ།༽ སྐ་"
    },
    {
      "span": {
        "start": 1281,
        "end": 1283
      },
      "text": "ར་ ༼སྣར། པེ།༽ གར་"
    },
    {
      "span": {
        "start": 1295,
        "end": 1297
      },
      "text": "ན་ ༼སྣར།༽ ནཱ་གཱ་ ༼པེ།༽ ན་ག་"
    },
    {
      "span": {
        "start": 1315,
        "end": 1321
      },
      "text": "ཨ་སྨྲ་ ༼སྣར། པེ།༽ ཨ་མྲ་"
    },
    {
      "span": {
        "start": 1339,
        "end": 1341
      },
      "text": "ཀ་ ༼སྣར། པེ།༽ སྐ་"
    }
  ]
}