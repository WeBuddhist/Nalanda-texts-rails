{
  "durchens": [
    {
      "span": {
        "start": 465,
        "end": 473
      },
      "text": "འཁྲུག་པ་ ༼སྣར།༽ འཁྲུགས་པ་ ༼པེ།༽ འཁྲུལ་པ་"
    },
    {
      "span": {
        "start": 493,
        "end": 503
      },
      "text": "སྐྱེས་པའི་ ༼སྣར། པེ།༽ བསྐྱེད་པའི་"
    },
    {
      "span": {
        "start": 759,
        "end": 769
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ བསྒོམས་པའི་"
    },
    {
      "span": {
        "start": 783,
        "end": 790
      },
      "text": "བྱུང་བ་ ༼སྣར། པེ།༽ བྱུང་བའི་"
    },
    {
      "span": {
        "start": 976,
        "end": 984
      },
      "text": "མཚན་ཉིད་ ༼སྣར། པེ།༽ ནུས་པ་"
    },
    {
      "span": {
        "start": 1832,
        "end": 1842
      },
      "text": "ཡིན་པ་སྟེ། ༼པེ།༽ ཡིན་ཏེ།"
    },
    {
      "span": {
        "start": 1913,
        "end": 1918
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ གསུམ་པོ་"
    },
    {
      "span": {
        "start": 2324,
        "end": 2332
      },
      "text": "ཆོས་ཀྱི་ ༼སྣར། པེ།༽ ཆོས་"
    },
    {
      "span": {
        "start": 2456,
        "end": 2468
      },
      "text": "དོ་ཞེས་བྱ་བ་ ༼སྣར། པེ།༽ དོ་ཞེས་པ་"
    },
    {
      "span": {
        "start": 2703,
        "end": 2713
      },
      "text": "བསྒྲུབ་པར་ ༼པེ།༽ བསྒྲུབ་པར་བྱ་བར་"
    },
    {
      "span": {
        "start": 2744,
        "end": 2753
      },
      "text": "ཕྱིར་དང་། ༼སྣར།༽ བྱ་ཏེ ༼པེ།༽ ཕྱིར་ཏེ།"
    },
    {
      "span": {
        "start": 2778,
        "end": 2788
      },
      "text": "འབྱུང་བའི་ ༼སྣར། པེ།༽ བྱུང་བའི་"
    },
    {
      "span": {
        "start": 2788,
        "end": 2796
      },
      "text": "ཕྱིར་ཏེ། ༼སྣར། པེ།༽ ཕྱིར་དང་།"
    },
    {
      "span": {
        "start": 2869,
        "end": 2881
      },
      "text": "རང་བཞིན་ཡིན་ ༼སྣར། པེ།༽ རང་བཞིན་"
    },
    {
      "span": {
        "start": 2992,
        "end": 2997
      },
      "text": "གྲུབ་ ༼སྣར། པེ།༽ འགྲུབ་"
    },
    {
      "span": {
        "start": 3008,
        "end": 3018
      },
      "text": "སྒྲུབ་ཀྱང་ ༼སྣར། པེ།༽ འགྲུབ་པ་ཡང་"
    },
    {
      "span": {
        "start": 3207,
        "end": 3211
      },
      "text": "ལོག་ ༼སྣར།༽ ལྡོག་"
    },
    {
      "span": {
        "start": 3364,
        "end": 3375
      },
      "text": "དེ་ཉིད་ཀྱི་ ༼སྣར། པེ།༽ དེ་ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 3500,
        "end": 3503
      },
      "text": "དེ་ ༼སྣར།༽ དེར་"
    },
    {
      "span": {
        "start": 3698,
        "end": 3708
      },
      "text": "བྱེད་པ་མི་ ༼པེ།༽ བྱེད་པ་མ་"
    },
    {
      "span": {
        "start": 3976,
        "end": 3982
      },
      "text": "འགལ་བ་ ༼སྣར། པེ།༽ འགལ་བས་"
    },
    {
      "span": {
        "start": 4014,
        "end": 4021
      },
      "text": "བྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 4039,
        "end": 4047
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 4164,
        "end": 4171
      },
      "text": "རྒྱུའི་ ༼སྣར། པེ།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 4460,
        "end": 4468
      },
      "text": "བྱེ་བྲག་ ༼སྣར། པེ།༽ བྱེ་བྲག་དག་"
    },
    {
      "span": {
        "start": 4708,
        "end": 4717
      },
      "text": "ཡོད་པ་དང་ ༼པེ།༽ ཡོད་པ་"
    },
    {
      "span": {
        "start": 4816,
        "end": 4826
      },
      "text": "བཅུ་པོ་དེ་ ༼སྣར། པེ།༽ བཅུ་པོ་"
    },
    {
      "span": {
        "start": 4866,
        "end": 4874
      },
      "text": "བསྡུ་བར་ ༼སྣར།༽ དུ་ ༼པེ།༽ འདུ་བར་"
    },
    {
      "span": {
        "start": 4940,
        "end": 4947
      },
      "text": "གཅོད་པ་ ༼སྣར། པེ།༽ བཅད་པ་"
    },
    {
      "span": {
        "start": 5174,
        "end": 5178
      },
      "text": "རིག་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 5368,
        "end": 5376
      },
      "text": "དཔག་པའི་ ༼སྣར། པེ།༽ དཔག་པ་ལ་སོགས་པའི་"
    },
    {
      "span": {
        "start": 5467,
        "end": 5473
      },
      "text": "ཐིག་པ་ ༼སྣར། པེ།༽ ཐིགས་པ་"
    },
    {
      "span": {
        "start": 5508,
        "end": 5512
      },
      "text": "དོན་ ༼སྣར། པེ།༽ དོན་གྱི་"
    },
    {
      "span": {
        "start": 5855,
        "end": 5862
      },
      "text": "གྱུར་པ་ ༼སྣར།༽ གྱུར་"
    },
    {
      "span": {
        "start": 6102,
        "end": 6105
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ནི་ལ་ཡང་"
    },
    {
      "span": {
        "start": 6284,
        "end": 6296
      },
      "text": "བྱེ་བྲག་གིས་ ༼སྣར། པེ།༽ བྱེ་བྲག་གི་"
    },
    {
      "span": {
        "start": 6350,
        "end": 6358
      },
      "text": "བྱ་བ་དེ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 6409,
        "end": 6416
      },
      "text": "བྱ་བའི་ ༼སྣར། པེ།༽ བྱེད་པའི་"
    },
    {
      "span": {
        "start": 6456,
        "end": 6464
      },
      "text": "བྱས་པའོ་ ༼སྣར། པེ།༽ བྱས་པ་"
    },
    {
      "span": {
        "start": 6475,
        "end": 6480
      },
      "text": "བརྩལ་ ༼སྣར། པེ།༽ བཙལ་"
    },
    {
      "span": {
        "start": 6561,
        "end": 6568
      },
      "text": "བལྟ་བར་ ༼སྣར། པེ།༽ ལྟ་བར་"
    },
    {
      "span": {
        "start": 6686,
        "end": 6698
      },
      "text": "རང་གི་ངོ་བོ་ ༼སྣར། པེ།༽ རང་གི་"
    },
    {
      "span": {
        "start": 6900,
        "end": 6903
      },
      "text": "དེ་ ༼པེ།༽ ད་"
    },
    {
      "span": {
        "start": 6920,
        "end": 6925
      },
      "text": "ན་ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 7034,
        "end": 7040
      },
      "text": "ཡོད་པ་ ༼སྣར། པེ།༽ ཡོད་"
    },
    {
      "span": {
        "start": 7066,
        "end": 7069
      },
      "text": "བང་ ༼སྣར། པེ།༽ མང་"
    },
    {
      "span": {
        "start": 7143,
        "end": 7153
      },
      "text": "འབྲས་བུའི་ ༼སྣར། པེ།༽ འབྲས་བུ་ནི་"
    },
    {
      "span": {
        "start": 7312,
        "end": 7320
      },
      "text": "དམིགས་པ་ ༼སྣར། པེ།༽ དམིགས་པར་"
    },
    {
      "span": {
        "start": 7376,
        "end": 7380
      },
      "text": "ཡིན་ ༼སྣར།༽ མིན་"
    },
    {
      "span": {
        "start": 7386,
        "end": 7391
      },
      "text": "ན་ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 7771,
        "end": 7778
      },
      "text": "མཐུན་པ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 7814,
        "end": 7819
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བ་ལ་"
    },
    {
      "span": {
        "start": 8138,
        "end": 8144
      },
      "text": "དེས་ན་ ༼སྣར།༽ ངས་ནི་"
    },
    {
      "span": {
        "start": 8203,
        "end": 8207
      },
      "text": "ཚིག་ ༼སྣར། པེ།༽ ཚིགས་"
    },
    {
      "span": {
        "start": 8347,
        "end": 8354
      },
      "text": "སྒོ་ཡང་ ༼སྣར། པེ།༽ སྒོ་ནས་"
    },
    {
      "span": {
        "start": 8532,
        "end": 8539
      },
      "text": "གང་ཡོད་ ༼ཅོ།༽ གང་ཡོད་པ་"
    },
    {
      "span": {
        "start": 8620,
        "end": 8626
      },
      "text": "དེ་ལྟ་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 8802,
        "end": 8805
      },
      "text": "གང་ ༼སྣར། པེ།༽ གང་མ་"
    },
    {
      "span": {
        "start": 8882,
        "end": 8891
      },
      "text": "བུམ་པ་མི་ ༼སྣར། པེ།༽ བུམ་པ་མ་"
    },
    {
      "span": {
        "start": 8987,
        "end": 8994
      },
      "text": "ཉིད་ཅན་ ༼པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 9304,
        "end": 9312
      },
      "text": "བསྩལ་བར་ ༼སྣར། པེ།༽ བསལ་བས་"
    },
    {
      "span": {
        "start": 9349,
        "end": 9354
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 9462,
        "end": 9467
      },
      "text": "ཁོ་ན་ ༼སྣར། པེ།༽ ཁོ་ནར་"
    },
    {
      "span": {
        "start": 9490,
        "end": 9498
      },
      "text": "ཉིད་ཡིན་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 9676,
        "end": 9686
      },
      "text": "བསྒྲུབ་པར་ ༼ཅོ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 9689,
        "end": 9695
      },
      "text": "བ་ཉིད་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 9729,
        "end": 9737
      },
      "text": "བྱ་བ་ནི་ ༼ཅོ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 9856,
        "end": 9864
      },
      "text": "བྱེད་པས་ ༼སྣར། པེ།༽ མེད་པས་"
    },
    {
      "span": {
        "start": 9986,
        "end": 9988
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 10031,
        "end": 10036
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བ་ནི་"
    },
    {
      "span": {
        "start": 10061,
        "end": 10068
      },
      "text": "བཀོད་པ་ ༼སྣར།༽ བཀོད་"
    },
    {
      "span": {
        "start": 10085,
        "end": 10091
      },
      "text": "པའོ། ། ༼སྣར། པེ།༽ པས།"
    },
    {
      "span": {
        "start": 10097,
        "end": 10101
      },
      "text": "ཚིག་ ༼སྣར། པེ།༽ ཚིགས་"
    },
    {
      "span": {
        "start": 10153,
        "end": 10157
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 10219,
        "end": 10227
      },
      "text": "གཞན་གྱི་ ༼པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 10442,
        "end": 10448
      },
      "text": "བསལ་བ་ ༼སྣར། པེ།༽ བཙལ་བ་"
    },
    {
      "span": {
        "start": 10468,
        "end": 10474
      },
      "text": "དེ་དག་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 10617,
        "end": 10628
      },
      "text": "ཡིན་ནོ་ཞེས་ ༼སྣར། པེ།༽ ཡིན་ནོ་"
    },
    {
      "span": {
        "start": 10660,
        "end": 10669
      },
      "text": "གྱིས་བསལ་ ༼སྣར། པེ།༽ གྱི་གསལ་"
    },
    {
      "span": {
        "start": 10756,
        "end": 10765
      },
      "text": "བུམ་པ་ནི་ ༼པེ།༽ བུམ་པ་མི་"
    },
    {
      "span": {
        "start": 10934,
        "end": 10944
      },
      "text": "ལྟ་བུ་སྟེ། ༼སྣར། པེ།༽ ལྟ།"
    },
    {
      "span": {
        "start": 11184,
        "end": 11188
      },
      "text": "དང་། ༼སྣར། པེ།༽ དང་། འདོད་པ་དང་"
    },
    {
      "span": {
        "start": 11342,
        "end": 11349
      },
      "text": "སྨྲས་པ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 11352,
        "end": 11355
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 11448,
        "end": 11456
      },
      "text": "གཉིས་ལས་ ༼སྣར། པེ།༽ གཉིས་ཀ་ལ་"
    },
    {
      "span": {
        "start": 11519,
        "end": 11528
      },
      "text": "གྲུབ་པའམ། ༼སྣར། པེ།༽ གྲུབ་བམ།"
    },
    {
      "span": {
        "start": 11585,
        "end": 11604
      },
      "text": "སྒྲ་མི་རྟག་པའོ་ཞེས་ ༼སྣར། པེ།༽ མི་རྟག་པ་ཉིད་དུ་"
    },
    {
      "span": {
        "start": 11668,
        "end": 11675
      },
      "text": "རྣམས་ལ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 11711,
        "end": 11719
      },
      "text": "བཤུས་ནས་ ༼སྣར། པེ།༽ བཤུས་ན་"
    },
    {
      "span": {
        "start": 11725,
        "end": 11742
      },
      "text": "ནི་ཕྱིར་རྒོལ་བ་ལ་ ༼སྣར། པེ།༽ ཕྱིར་རྒོལ་བ་"
    },
    {
      "span": {
        "start": 12081,
        "end": 12088
      },
      "text": "རླངས་པ་ ༼སྣར། པེ།༽ བསླབས་པ་"
    },
    {
      "span": {
        "start": 12166,
        "end": 12174
      },
      "text": "གྲག་པའི་ ༼སྣར། པེ།༽ གྲགས་པའི་"
    },
    {
      "span": {
        "start": 12190,
        "end": 12192
      },
      "text": "ན་ ༼སྣར།༽ ནི་"
    },
    {
      "span": {
        "start": 12220,
        "end": 12228
      },
      "text": "གྲག་པའི་ ༼པེ།༽ གྲགས་པའི་"
    },
    {
      "span": {
        "start": 12316,
        "end": 12324
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 12513,
        "end": 12517
      },
      "text": "གཞལ་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 12542,
        "end": 12557
      },
      "text": "མཐུན་པའི་ཕྱོགས་ ༼སྣར། པེ།༽ མཐུན་པ་"
    },
    {
      "span": {
        "start": 12758,
        "end": 12764
      },
      "text": "ལྡན་པ་ ༼སྣར།༽ ལྡན་པ་ལ་"
    },
    {
      "span": {
        "start": 12798,
        "end": 12805
      },
      "text": "བུ་སྟེ། ༼སྣར། པེ།༽ བུའོ། །"
    },
    {
      "span": {
        "start": 12881,
        "end": 12890
      },
      "text": "དམིགས་སོ་ ༼པེ།༽ ཡིན་ནོ་"
    },
    {
      "span": {
        "start": 12989,
        "end": 12998
      },
      "text": "། །དེ་བས་ ༼སྣར། པེ།༽ ། །དེས་"
    },
    {
      "span": {
        "start": 13023,
        "end": 13026
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 13070,
        "end": 13078
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 13116,
        "end": 13125
      },
      "text": "ཉིད་གཉིས་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 13176,
        "end": 13184
      },
      "text": "མཁྱེན་པ་ ༼པེ།༽ མཁྱེན་པ་ཉིད་"
    },
    {
      "span": {
        "start": 13196,
        "end": 13204
      },
      "text": "སྨྲ་བ་མ་ ༼སྣར། པེ།༽ སྨྲ་བ་"
    },
    {
      "span": {
        "start": 13215,
        "end": 13227
      },
      "text": "བྱ་བའི་ལྡོག་ ༼སྣར།༽ བྱ་བ་ལྡོག་ ༼པེ།༽ བྱ་བ་ལྡེག་"
    },
    {
      "span": {
        "start": 13235,
        "end": 13241
      },
      "text": "འགྲུབ་ ༼སྣར། པེ།༽ གྲུབ་"
    },
    {
      "span": {
        "start": 13568,
        "end": 13573
      },
      "text": "ཕྱིར་ ༼སྣར། པེ།༽ ཕྱིར་མི་"
    },
    {
      "span": {
        "start": 13590,
        "end": 13598
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 13630,
        "end": 13635
      },
      "text": "ཚིགས་ ༼སྣར། པེ།༽ ཚིག་"
    },
    {
      "span": {
        "start": 13759,
        "end": 13763
      },
      "text": "ཚིག་ ༼སྣར། པེ།༽ ན་ཚིགས་"
    },
    {
      "span": {
        "start": 13824,
        "end": 13833
      },
      "text": "གཉིས་ཀྱི་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 13938,
        "end": 13942
      },
      "text": "མེད་ ༼སྣར། པེ།༽ ཡོད་"
    },
    {
      "span": {
        "start": 13961,
        "end": 13966
      },
      "text": "བརྩལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 13974,
        "end": 13982
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ བྱུང་བ་"
    },
    {
      "span": {
        "start": 13982,
        "end": 13999
      },
      "text": "ཉིད་ནི་རྟག་པ་ཉིད་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 14005,
        "end": 14009
      },
      "text": "པ་ལ་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 14040,
        "end": 14043
      },
      "text": "ཏེ། ༼སྣར། པེ།༽ ནོ། །"
    },
    {
      "span": {
        "start": 14048,
        "end": 14057
      },
      "text": "གཉིས་ཀྱི་ ༼སྣར། པེ།༽ གཉིས་ནི་"
    },
    {
      "span": {
        "start": 14105,
        "end": 14112
      },
      "text": "ཡོད་པས་ ༼སྣར། པེ།༽ ཡོད་པས་ཕྱིར་"
    },
    {
      "span": {
        "start": 14152,
        "end": 14162
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 14182,
        "end": 14197
      },
      "text": "སྒྲུབ་པའི་ཕྱིར་ ༼སྣར། པེ།༽ སྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 14251,
        "end": 14256
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ གསུམ་ཡོད་"
    },
    {
      "span": {
        "start": 14256,
        "end": 14263
      },
      "text": "པ་ཡང་བ་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 14287,
        "end": 14300
      },
      "text": "ཡིན་པའི་ཕྱིར་ ༼སྣར། པེ།༽ ཡིན་པའི་"
    },
    {
      "span": {
        "start": 14304,
        "end": 14311
      },
      "text": "ལ་སོགས་ ༼སྣར། པེ།༽ ལ་སོགས་སོགས་"
    },
    {
      "span": {
        "start": 14328,
        "end": 14339
      },
      "text": "བྱེད་པ་ཉིད་ ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 14533,
        "end": 14547
      },
      "text": "འདུས་པའི་ཕྱིར། ༼སྣར། པེ།༽ འདུས་པའི།"
    },
    {
      "span": {
        "start": 14564,
        "end": 14569
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 14576,
        "end": 14587
      },
      "text": "བསྒྲུབས་པས་ ༼ཅོ།༽ བསྒྲུབ་པས་ ༼སྣར། པེ།༽ སྒྲུབ་པས་"
    },
    {
      "span": {
        "start": 14741,
        "end": 14743
      },
      "text": "བ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 14754,
        "end": 14761
      },
      "text": "ཡིན་ཏེ། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 14834,
        "end": 14844
      },
      "text": "ལྟ་བུ་སྟེ། ༼སྣར། པེ།༽ ལྟ།"
    },
    {
      "span": {
        "start": 14849,
        "end": 14851
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་ནི་"
    },
    {
      "span": {
        "start": 14886,
        "end": 14891
      },
      "text": "ལ་ནི་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 14940,
        "end": 14946
      },
      "text": "བྲལ་བ་ ༼སྣར། པེ།༽ བྲལ་བ་དག་"
    },
    {
      "span": {
        "start": 14995,
        "end": 15002
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 15032,
        "end": 15036
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 15149,
        "end": 15159
      },
      "text": "ལྟ་བུ་སྟེ། ༼སྣར། པེ།༽ ལྟ།"
    },
    {
      "span": {
        "start": 15186,
        "end": 15189
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 15392,
        "end": 15401
      },
      "text": "ལ་སོགས་པ་ ༼སྣར།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 15412,
        "end": 15420
      },
      "text": "ཕྱིར་རོ། ༼སྣར། པེ།༽ ཕྱིར།"
    },
    {
      "span": {
        "start": 15462,
        "end": 15467
      },
      "text": "སྲོག་ ༼སྣར། པེ།༽ སྲོག་པ་"
    },
    {
      "span": {
        "start": 15568,
        "end": 15572
      },
      "text": "བདག་ ༼སྣར། པེ།༽ བདག་ལ་"
    },
    {
      "span": {
        "start": 15643,
        "end": 15653
      },
      "text": "བདག་མེད་པ་ ༼སྣར། པེ།༽ བདག་མེད་པ་ལས་"
    },
    {
      "span": {
        "start": 15751,
        "end": 15756
      },
      "text": "གཅོད་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 15801,
        "end": 15810
      },
      "text": "ངེས་པ་ནི་ ༼སྣར། པེ།༽ ངེས་ན་"
    },
    {
      "span": {
        "start": 15978,
        "end": 15987
      },
      "text": "དེ་ལྟར་ན་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 15991,
        "end": 16002
      },
      "text": "གསུམ་པོ་དེ་ ༼སྣར། པེ།༽ གསུམ་པོ་"
    },
    {
      "span": {
        "start": 16088,
        "end": 16102
      },
      "text": "སྣང་བ་གསུམ་པོ་ ༼སྣར། པེ།༽ སྣང་བ་"
    },
    {
      "span": {
        "start": 16260,
        "end": 16265
      },
      "text": "བུའམ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 16304,
        "end": 16306
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 16312,
        "end": 16329
      },
      "text": "མི་འཁྲུལ་པ་ཅན་མི་ ༼སྣར། པེ།༽ མི་"
    },
    {
      "span": {
        "start": 16567,
        "end": 16572
      },
      "text": "རྣམས་ ༼པེ།༽ རྣམས་ནི་དོན་རྣམས་"
    },
    {
      "span": {
        "start": 16591,
        "end": 16595
      },
      "text": "ལོག་ ༼སྣར། པེ།༽ ལོགས་"
    },
    {
      "span": {
        "start": 16781,
        "end": 16790
      },
      "text": "གཅིག་པུར་ ༼སྣར། པེ།༽ ཅིག་ཅར་དུ་"
    },
    {
      "span": {
        "start": 16819,
        "end": 16821
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 16842,
        "end": 16858
      },
      "text": "ནམ་མཁའ་ལ་སོགས་པ་ ༼སྣར། པེ།༽ ནམ་མཁའ་"
    },
    {
      "span": {
        "start": 16868,
        "end": 16876
      },
      "text": "སྤྱི་ཡང་ ༼སྣར། པེ།༽ སྤྱི་དང་"
    },
    {
      "span": {
        "start": 16880,
        "end": 16887
      },
      "text": "ཐམས་ཅད་ ༼སྣར། པེ།༽ ཐམས་ཅད་ན་གནས་"
    },
    {
      "span": {
        "start": 17071,
        "end": 17083
      },
      "text": "ཡུལ་བདག་ཉིད་ ༼སྣར། པེ།༽ ཡུལ་བདག་ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 17110,
        "end": 17118
      },
      "text": "བྱ་བ་ནི་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 17130,
        "end": 17143
      },
      "text": "གཏན་ཚིགས་ཀྱི་ ༼སྣར། པེ།༽ གཏན་ཚིགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 17168,
        "end": 17178
      },
      "text": "གཉིས་པ་ཡང་ ༼སྣར། པེ།༽ གཉིས་པ་"
    },
    {
      "span": {
        "start": 17296,
        "end": 17304
      },
      "text": "གསལ་བའི་ ༼སྣར། པེ།༽ བསལ་བའི་"
    },
    {
      "span": {
        "start": 17363,
        "end": 17370
      },
      "text": "བྱ་བའོ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 17426,
        "end": 17436
      },
      "text": "བསྒྲུབས་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 17645,
        "end": 17653
      },
      "text": "ཕྱིར་རོ། ༼སྣར། པེ།༽ ཕྱིར།"
    },
    {
      "span": {
        "start": 17727,
        "end": 17743
      },
      "text": "ལྡོག་པའི་ཚུལ་དུ་ ༼སྣར། པེ།༽ ལྡོག་པའི་"
    },
    {
      "span": {
        "start": 17803,
        "end": 17812
      },
      "text": "གཉིས་ཀྱི་ ༼སྣར། པེ།༽ གཉིས་ནི་"
    },
    {
      "span": {
        "start": 17854,
        "end": 17861
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 17970,
        "end": 17973
      },
      "text": "བང་ ༼སྣར། པེ།༽ མང་"
    },
    {
      "span": {
        "start": 17992,
        "end": 17997
      },
      "text": "གང་ན་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 18094,
        "end": 18104
      },
      "text": "ནམ་མཁའ་དག་ ༼སྣར། པེ།༽ ནམ་མཁའ་"
    },
    {
      "span": {
        "start": 18427,
        "end": 18440
      },
      "text": "རྟག་པ་ཡིན་ཏེ་ ༼སྣར། པེ།༽ རྟག་པ་སྟེ་"
    },
    {
      "span": {
        "start": 18512,
        "end": 18546
      },
      "text": "བསྒྲུབ་པར་བྱ་བ་དང་། སྒྲུབ་པར་བྱེད་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 18554,
        "end": 18557
      },
      "text": "དག་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 18886,
        "end": 18893
      },
      "text": "ཡིན་ཏེ། ༼པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 19027,
        "end": 19036
      },
      "text": "ལ་སོགས་པ་ ༼པེ།༽ ལ་སོ་སོ་བ་"
    },
    {
      "span": {
        "start": 19227,
        "end": 19237
      },
      "text": "ལྟ་བུ་སྟེ། ༼སྣར། པེ།༽ ལྟ་བུའོ།"
    },
    {
      "span": {
        "start": 19341,
        "end": 19350
      },
      "text": "ལ་སོགས་པ་ ༼པེ།༽ ལ་སོ་སོ་བ་"
    },
    {
      "span": {
        "start": 19378,
        "end": 19389
      },
      "text": "དེ་བཞིན་དུ་ ༼སྣར། པེ།༽ དེ་བཞིན་"
    },
    {
      "span": {
        "start": 19456,
        "end": 19465
      },
      "text": "ལ་སོགས་པ་ ༼པེ།༽ ལ་སོ་སོ་བ་"
    },
    {
      "span": {
        "start": 19709,
        "end": 19717
      },
      "text": "སྐར་མའི་ ༼སྣར། པེ།༽ སྐར་མ་"
    },
    {
      "span": {
        "start": 19778,
        "end": 19786
      },
      "text": "ལྟ་བུའོ། ༼སྣར། པེ།༽ ལྟ་བུ་སྟེ།"
    },
    {
      "span": {
        "start": 19808,
        "end": 19811
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 19839,
        "end": 19851
      },
      "text": "མཁྱེན་པ་ཉིད་ ༼སྣར། པེ།༽ མཁྱེན་པ་"
    },
    {
      "span": {
        "start": 19971,
        "end": 19979
      },
      "text": "བྲམ་ཟེས་ ༼སྣར། པེ།༽ བྲམ་ཟེ་"
    },
    {
      "span": {
        "start": 20344,
        "end": 20354
      },
      "text": "གཉིས་ཀ་ལས་ ༼སྣར། པེ།༽ གཉིས་ཀ་ལ་"
    },
    {
      "span": {
        "start": 20547,
        "end": 20553
      },
      "text": "བྲལ་བ་ ༼སྣར། པེ།༽ འབྲལ་བ་"
    },
    {
      "span": {
        "start": 20640,
        "end": 20650
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 20650,
        "end": 20655
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 20829,
        "end": 20835
      },
      "text": "བྲལ་བ་ ༼སྣར། པེ།༽ བྲལ་བའི་"
    },
    {
      "span": {
        "start": 20896,
        "end": 20898
      },
      "text": "པ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 20960,
        "end": 20967
      },
      "text": "བུ་སྟེ། ༼སྣར། པེ།༽ བུའོ། །"
    },
    {
      "span": {
        "start": 21180,
        "end": 21188
      },
      "text": "བྱས་པའི་ ༼སྣར། པེ།༽ བྱས་པའི་ཕྱིར་"
    },
    {
      "span": {
        "start": 21427,
        "end": 21436
      },
      "text": "ཐམས་ཅད་ལ་ ༼སྣར།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 21600,
        "end": 21611
      },
      "text": "བསྒྲུབ་པའི་ ༼སྡེ།༽ སྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 21611,
        "end": 21617
      },
      "text": "རྐྱེན་ ༼སྣར། པེ།༽ སྐྱོན་"
    },
    {
      "span": {
        "start": 21690,
        "end": 21699
      },
      "text": "ཕ་རོལ་པོ་ ༼སྣར། པེ།༽ ཕ་རོལ་པོའི་"
    },
    {
      "span": {
        "start": 21778,
        "end": 21782
      },
      "text": "ཆོད་ ༼སྣར། པེ།༽ གཅོད་"
    },
    {
      "span": {
        "start": 21833,
        "end": 21837
      },
      "text": "ཆོད་ ༼སྣར། པེ།༽ གཅོད་"
    },
    {
      "span": {
        "start": 21859,
        "end": 21867
      },
      "text": "དོན་གྱི་ ༼སྣར། པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 21905,
        "end": 21914
      },
      "text": "རིགས་པའི་ ༼སྣར། པེ།༽ རིག་པའི་"
    },
    {
      "span": {
        "start": 22062,
        "end": 22067
      },
      "text": "།། །། ༼སྣར། པེ།༽ །། །།ཤཱཀྱ་ཐུབ་པས་བདུད་ཀྱི་སྡེ་བོ་ཆེ། །ཆོས་ཀྱི་གྲགས་པས་མུ་སྟེགས་མ་ལུས་པ། །ཉི་མས་དམག་རུམ་རིག་པའི་ཐིགས་པ་ཡིས། །བདག་གི་ལྟ་བ་དྲུངས་ཕྱུང་ངོ་མཚར་ཉིད། །"
    }
  ]
}