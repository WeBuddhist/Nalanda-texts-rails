{
  "durchens": [
    {
      "span": {
        "start": 920,
        "end": 922
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 1947,
        "end": 1955
      },
      "text": "གཉེན་པོ་ ༼སྣར། པེ།༽ གཉེན་པོར་"
    },
    {
      "span": {
        "start": 2177,
        "end": 2181
      },
      "text": "གཞར་ ༼སྣར། པེ།༽ གཞིར་"
    },
    {
      "span": {
        "start": 2206,
        "end": 2212
      },
      "text": "དག་གི་ ༼སྣར། པེ།༽ དག་གིས་"
    },
    {
      "span": {
        "start": 2517,
        "end": 2526
      },
      "text": "གསེར་གྱི་ ༼པེ།༽ གསེར་གྱིས་"
    }
  ]
}