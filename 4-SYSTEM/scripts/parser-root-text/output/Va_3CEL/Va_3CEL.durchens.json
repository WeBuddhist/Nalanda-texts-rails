{
  "durchens": [
    {
      "span": {
        "start": 497,
        "end": 508
      },
      "text": "ལ་སོགས་པའང་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 590,
        "end": 593
      },
      "text": "རབ་ ༼སྣར། པེ།༽ རང་"
    },
    {
      "span": {
        "start": 714,
        "end": 721
      },
      "text": "འགྲོགས། ༼སྣར།༽ དགྲོགས།"
    },
    {
      "span": {
        "start": 1412,
        "end": 1417
      },
      "text": "འཚིག་ ༼པེ།༽ ཚིག་"
    },
    {
      "span": {
        "start": 1447,
        "end": 1453
      },
      "text": "སྒྱུར་ ༼སྣར། པེ།༽ རྒྱུར་"
    },
    {
      "span": {
        "start": 1611,
        "end": 1616
      },
      "text": "གཉིད་ ༼པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 1643,
        "end": 1658
      },
      "text": "ནི་དཔྱོད་པ་དང་། ༼སྣར། པེ།༽ ནི་དཔྱོདཔའོ།"
    },
    {
      "span": {
        "start": 1758,
        "end": 1769
      },
      "text": "ལྷན་ཅིག་གམ་ ༼སྣར། པེ།༽ ལྷན་ཅིག་འམ་"
    },
    {
      "span": {
        "start": 1805,
        "end": 1813
      },
      "text": "ཡིད་ཀྱི་ ༼པེ།༽ ཡིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 2298,
        "end": 2304
      },
      "text": "བརྟགས་ ༼སྣར།༽ བརྟག་"
    },
    {
      "span": {
        "start": 2451,
        "end": 2465
      },
      "text": "མེད་པར་གྱུར་པ་ ༼སྣར། པེ།༽ མེད་པརའགྱུར་བ་"
    },
    {
      "span": {
        "start": 3285,
        "end": 3289
      },
      "text": "མེད། ༼སྣར། པེ།༽ དེ།"
    },
    {
      "span": {
        "start": 3454,
        "end": 3459
      },
      "text": "བྱ། ། ༼སྣར། པེ།༽ །། །།།"
    },
    {
      "span": {
        "start": 3503,
        "end": 3519
      },
      "text": "དབྱིག་གཉེན་གྱིས་ ༼སྣར། པེ།༽ དབྱིག་གཉེན་"
    }
  ]
}