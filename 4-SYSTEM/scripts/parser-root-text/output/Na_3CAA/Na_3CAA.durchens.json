{
  "durchens": [
    {
      "span": {
        "start": 392,
        "end": 395
      },
      "text": "ནས། ༼སྣར། པེ།༽ ནས་ནི།"
    },
    {
      "span": {
        "start": 400,
        "end": 411
      },
      "text": "རྗེས་སུ་ནི་ ༼སྣར། པེ།༽ རྗེས་སུ་"
    },
    {
      "span": {
        "start": 438,
        "end": 441
      },
      "text": "གར་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 652,
        "end": 656
      },
      "text": "མཚན་ ༼སྣར།༽ མཚན་ཉིད་"
    },
    {
      "span": {
        "start": 659,
        "end": 667
      },
      "text": "གཡོས་པས་ ༼སྣར། པེ།༽ གཡོས་པ་ཡིས་"
    },
    {
      "span": {
        "start": 723,
        "end": 731
      },
      "text": "ཡིག་གིས་ ༼པེ།༽ ཡིག་ལས་"
    },
    {
      "span": {
        "start": 820,
        "end": 826
      },
      "text": "ལྕེའི་ ༼སྣར།༽ ལྷེའི་"
    },
    {
      "span": {
        "start": 864,
        "end": 873
      },
      "text": "སེམས་ཀྱི་ ༼སྣར། པེ།༽ སེམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 1161,
        "end": 1166
      },
      "text": "བྱ། ། ༼པེ།༽ །། །།"
    }
  ]
}