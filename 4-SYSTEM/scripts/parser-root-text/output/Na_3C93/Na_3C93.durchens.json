{
  "durchens": [
    {
      "span": {
        "start": 21,
        "end": 27
      },
      "text": "ནི་རུ་ ༼སྣར། པེ།༽ ནི་རཱུ་"
    },
    {
      "span": {
        "start": 232,
        "end": 242
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 288,
        "end": 298
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 400,
        "end": 407
      },
      "text": "ཨེ་མའོ་ ༼སྣར། པེ།༽ ཨེ་མ་ཧོ་"
    },
    {
      "span": {
        "start": 626,
        "end": 635
      },
      "text": "བཞེད་ཀྱི། ༼སྣར། པེ།༽ བཞེད་ཀྱིས།"
    },
    {
      "span": {
        "start": 830,
        "end": 839
      },
      "text": "ཀྱིས་འགའ་ ༼སྣར། པེ།༽ ཀྱི་གང་"
    },
    {
      "span": {
        "start": 918,
        "end": 925
      },
      "text": "ཚིམ་པར་ ༼སྣར། པེ།༽ ཚིམ་པའང་"
    },
    {
      "span": {
        "start": 1178,
        "end": 1199
      },
      "text": "སྡུག་བསྔལ་དེ་བཞིན་དུ། ༼སྣར། པེ།༽ སྡུག་བསྔལ་དེགྱུར་པ།"
    },
    {
      "span": {
        "start": 1217,
        "end": 1219
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 1330,
        "end": 1340
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 1363,
        "end": 1371
      },
      "text": "སྤུངས་པ་ ༼སྣར། པེ།༽ སྤུངས་པའང་"
    },
    {
      "span": {
        "start": 1373,
        "end": 1379
      },
      "text": "ལགས་ལ། ༼སྡེ། ཅོ།༽ མཆིས་པ།"
    },
    {
      "span": {
        "start": 1381,
        "end": 1389
      },
      "text": "དེ་ཕྱིར་ ༼སྣར། པེ།༽ དེ་བཞིན་"
    },
    {
      "span": {
        "start": 1601,
        "end": 1605
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 1610,
        "end": 1612
      },
      "text": "པ། ༼སྣར། པེ།༽ པར།"
    },
    {
      "span": {
        "start": 1620,
        "end": 1626
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 1720,
        "end": 1725
      },
      "text": "ཚོགས་ ༼སྣར། པེ།༽ སོགས་"
    },
    {
      "span": {
        "start": 1767,
        "end": 1772
      },
      "text": "གཞིར་ ༼སྣར།༽ བཞིར་"
    },
    {
      "span": {
        "start": 1855,
        "end": 1865
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 1898,
        "end": 1908
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 2182,
        "end": 2190
      },
      "text": "ཁྲག་མེད་ ༼སྣར། པེ།༽ ཁྲག་"
    },
    {
      "span": {
        "start": 2190,
        "end": 2195
      },
      "text": "ཀྱང་། ༼སྣར། པེ།༽ ཀྱང་མེད།"
    },
    {
      "span": {
        "start": 2274,
        "end": 2281
      },
      "text": "མི་གཙང་ ༼སྣར། པེ།༽ རུས་པའང་"
    },
    {
      "span": {
        "start": 2375,
        "end": 2383
      },
      "text": "སྟོན་པར་ ༼སྣར། པེ།༽ བསྟེན་པར་"
    },
    {
      "span": {
        "start": 2412,
        "end": 2420
      },
      "text": "རྣམས་ནི། ༼སྣར། པེ།༽ རྣམས་ཀྱང་།"
    },
    {
      "span": {
        "start": 2431,
        "end": 2441
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 2457,
        "end": 2467
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 2475,
        "end": 2485
      },
      "text": "རྗེས་གཟུང་ ༼སྣར། པེ།༽ རྗེས་འཇུག་"
    },
    {
      "span": {
        "start": 2495,
        "end": 2503
      },
      "text": "སྤངས་པར་ ༼སྣར། པེ།༽ སྤངས་པ་"
    },
    {
      "span": {
        "start": 2564,
        "end": 2570
      },
      "text": "དབྱེར་ ༼སྣར། པེ།༽ དབྱེ་"
    },
    {
      "span": {
        "start": 2584,
        "end": 2593
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 2715,
        "end": 2724
      },
      "text": "འགྲོ་བའི་ ༼སྣར། པེ།༽ དགྲོལ་བའི་"
    },
    {
      "span": {
        "start": 2731,
        "end": 2740
      },
      "text": "ཁྱོད་ཉིད་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 2824,
        "end": 2833
      },
      "text": "འཁོར་བའང་ ༼སྣར། པེ།༽ འཁོར་བ་"
    },
    {
      "span": {
        "start": 2870,
        "end": 2878
      },
      "text": "ཀྱིས་ཡང་ ༼སྣར། པེ།༽ ཀྱིས་ཀྱང་"
    },
    {
      "span": {
        "start": 2943,
        "end": 2952
      },
      "text": "ཁྱོད་ཉིད་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 3069,
        "end": 3072
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལས་བདག་གི་"
    },
    {
      "span": {
        "start": 3100,
        "end": 3104
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིས་"
    },
    {
      "span": {
        "start": 3199,
        "end": 3216
      },
      "text": "སློབ་དཔོན་འཕགས་པ་ ༼སྣར། པེ།༽ སློབ་དཔོན་"
    },
    {
      "span": {
        "start": 3289,
        "end": 3303
      },
      "text": "ཙཱ་བ་དགེ་སློང་ ༼སྣར། པེ།༽ ཙཱ་བ་"
    },
    {
      "span": {
        "start": 3321,
        "end": 3332
      },
      "text": "བསྒྱུར་བའོ། ༼པེ།༽ བབསྒྱུར་བའོ་མངྒ་ལཾ།"
    }
  ]
}