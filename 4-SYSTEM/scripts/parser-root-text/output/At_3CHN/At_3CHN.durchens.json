{
  "durchens": [
    {
      "span": {
        "start": 185,
        "end": 191
      },
      "text": "ས་ཆོག་ ༼པེ། སྣར།༽ མཆོག"
    },
    {
      "span": {
        "start": 354,
        "end": 362
      },
      "text": "དཀར་པོས་ ༼པེ། སྣར།༽ དཀར་པོ།"
    },
    {
      "span": {
        "start": 1103,
        "end": 1111
      },
      "text": "སྔོན་མོ་ ༼པེ། སྣར།༽ སྔོན་པོ།"
    },
    {
      "span": {
        "start": 1212,
        "end": 1222
      },
      "text": "མདངས་ཅན་མ་ ༼པེ། སྣར།༽ མདངས་ཅན་མ།"
    },
    {
      "span": {
        "start": 1637,
        "end": 1645
      },
      "text": "སྒྲ་གྲག་ ༼པེ། སྣར།༽ སྒྲ་གྲག"
    },
    {
      "span": {
        "start": 2119,
        "end": 2123
      },
      "text": "ཧ་ཏ་ ༼པེ། སྣར།༽ ཧ་ཏ།"
    },
    {
      "span": {
        "start": 2165,
        "end": 2172
      },
      "text": "ཨེ་ཧྱེ་ ༼པེ། སྣར།༽ ཨེ་ཧྱེ།"
    },
    {
      "span": {
        "start": 2355,
        "end": 2360
      },
      "text": "དྲངས་ཏེ་ ༼པེ། སྣར།༽ སྤྱན་དྲངས་ཏེ།"
    },
    {
      "span": {
        "start": 2508,
        "end": 2516
      },
      "text": "བསྟོད་པ་ ༼པེ། སྣར།༽ བསྟོད་པར།"
    },
    {
      "span": {
        "start": 2524,
        "end": 2531
      },
      "text": "རྣམ་དག་ ༼པེ། སྣར།༽ པར།"
    },
    {
      "span": {
        "start": 2794,
        "end": 2798
      },
      "text": "བཟང་ ༼པེ། སྣར།༽ བཟངས།"
    }
  ]
}