{
  "durchens": [
    {
      "span": {
        "start": 126,
        "end": 130
      },
      "text": "ལགས། ༼སྣར། པེ།༽ ལག།"
    },
    {
      "span": {
        "start": 467,
        "end": 472
      },
      "text": "བྱའོ། ༼སྣར། པེ།༽ བྱ།"
    },
    {
      "span": {
        "start": 542,
        "end": 551
      },
      "text": "བསྐུ་མཉེ་ ༼སྣར། པེ།༽ སྐུ་མཉེ་"
    },
    {
      "span": {
        "start": 598,
        "end": 601
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལས་ལ་"
    },
    {
      "span": {
        "start": 1053,
        "end": 1057
      },
      "text": "གཟའ་ ༼སྣར། པེ།༽ བཟའ་"
    },
    {
      "span": {
        "start": 1081,
        "end": 1091
      },
      "text": "སྦྱར་བ་ཡི། ༼པེ།༽ སྦྱར་བ་ཡིས།"
    },
    {
      "span": {
        "start": 1093,
        "end": 1100
      },
      "text": "དེ་ཡིས་ ༼པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 1391,
        "end": 1395
      },
      "text": "གཟའ་ ༼པེ།༽ བཟའ་"
    },
    {
      "span": {
        "start": 1455,
        "end": 1464
      },
      "text": "བརྟགས་ནས། ༼སྣར། པེ།༽ བརྟགས་ན།"
    },
    {
      "span": {
        "start": 2723,
        "end": 2726
      },
      "text": "དང་ ༼སྡེ།༽ རང་"
    },
    {
      "span": {
        "start": 2894,
        "end": 2904
      },
      "text": "ཐམས་ཅད་དུ། ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི།"
    },
    {
      "span": {
        "start": 3873,
        "end": 3885
      },
      "text": "ཆུ་སྲིན་གྱི། ༼པེ།༽ ཆུ་སྲིན་གྱིས།"
    },
    {
      "span": {
        "start": 3955,
        "end": 3963
      },
      "text": "བཞི་པོས་ ༼སྣར།༽ བཞི་ཡིས་ ༼པེ།༽ བཞི་ཡི་"
    },
    {
      "span": {
        "start": 3967,
        "end": 3971
      },
      "text": "མའི་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 4026,
        "end": 4031
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 4112,
        "end": 4123
      },
      "text": "མཆན་ཁུང་གི་ ༼སྣར། པེ།༽ མཆན་ཁུང་"
    }
  ]
}