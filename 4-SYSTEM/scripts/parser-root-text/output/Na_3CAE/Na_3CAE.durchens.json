{
  "durchens": [
    {
      "span": {
        "start": 334,
        "end": 347
      },
      "text": "སྣང་སྲིད་ཀྱི། ༼སྣར། པེ།༽ སྣང་སྲིད་ཀྱིས།"
    },
    {
      "span": {
        "start": 809,
        "end": 814
      },
      "text": "ལག་ན་ ༼སྣར། པེ།༽ ལག་པ་"
    },
    {
      "span": {
        "start": 862,
        "end": 867
      },
      "text": "ལག་ན་ ༼སྣར། པེ།༽ ལག་པ་"
    },
    {
      "span": {
        "start": 1032,
        "end": 1036
      },
      "text": "དྱེ་ ༼སྣར། པེ།༽ དྱཱ་"
    },
    {
      "span": {
        "start": 1139,
        "end": 1146
      },
      "text": "དེང་ནས་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 1225,
        "end": 1231
      },
      "text": "གཟུང་། ༼སྣར། པེ།༽ བཟུང་།"
    },
    {
      "span": {
        "start": 1348,
        "end": 1354
      },
      "text": "བསྒོམ། ༼སྣར། པེ།༽ བསྒོམས།"
    },
    {
      "span": {
        "start": 1403,
        "end": 1408
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ བདུན་"
    },
    {
      "span": {
        "start": 1660,
        "end": 1666
      },
      "text": "དེ་ལས་ ༼སྣར། པེ།༽ དེ་བས་"
    },
    {
      "span": {
        "start": 1747,
        "end": 1756
      },
      "text": "གྲུབ་པའི་ ༼སྣར། པེ།༽ གྲུབ་པ་"
    },
    {
      "span": {
        "start": 1859,
        "end": 1864
      },
      "text": "དུ་མ་ ༼སྣར། པེ།༽ དུ་མས་"
    },
    {
      "span": {
        "start": 1942,
        "end": 1950
      },
      "text": "ཞིང་གིས་ ༼སྣར། པེ།༽ ཞིང་ཆེན་"
    },
    {
      "span": {
        "start": 2033,
        "end": 2038
      },
      "text": "ཀ་ཞུ་ ༼སྣར། པེ།༽ ཀ་གཞུ་"
    },
    {
      "span": {
        "start": 2092,
        "end": 2098
      },
      "text": "བསྒོམ། ༼སྣར། པེ།༽ བསྒོམས།"
    },
    {
      "span": {
        "start": 2672,
        "end": 2676
      },
      "text": "ཐབས་ ༼སྣར།༽ ཐབ་"
    },
    {
      "span": {
        "start": 2729,
        "end": 2737
      },
      "text": "གཉིས་པས་ ༼སྣར། པེ།༽ གཉིས་པ་"
    },
    {
      "span": {
        "start": 2791,
        "end": 2799
      },
      "text": "གཉིས་པས་ ༼སྣར། པེ།༽ གཉིས་པ་"
    },
    {
      "span": {
        "start": 3052,
        "end": 3059
      },
      "text": "འཁྲུགས་ ༼སྣར། པེ།༽ འཁྲུག་"
    },
    {
      "span": {
        "start": 3305,
        "end": 3311
      },
      "text": "ཡེ་ནས་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 3416,
        "end": 3421
      },
      "text": "འབུལ། ༼སྣར། པེ།༽ དབུལ།"
    },
    {
      "span": {
        "start": 3663,
        "end": 3671
      },
      "text": "དང་པོའི་ ༼སྣར། པེ།༽ དང་པོ་"
    },
    {
      "span": {
        "start": 3698,
        "end": 3704
      },
      "text": "ལྔ་པས་ ༼སྣར། པེ།༽ ལྔ་པ་"
    },
    {
      "span": {
        "start": 3966,
        "end": 3972
      },
      "text": "བཟུང་། ༼སྣར། པེ།༽ གཟུང་།"
    },
    {
      "span": {
        "start": 4047,
        "end": 4055
      },
      "text": "གསུམ་པས་ ༼སྣར། པེ།༽ གསུམ་པ་"
    },
    {
      "span": {
        "start": 4067,
        "end": 4083
      },
      "text": "གནས་བཞི་པོ་གཟུང་ ༼སྣར། པེ།༽ གནས་བཞིཔ་བཟུང་"
    },
    {
      "span": {
        "start": 5175,
        "end": 5179
      },
      "text": "དམར་ ༼སྣར། པེ།༽ ཧྲི་དམར་"
    },
    {
      "span": {
        "start": 5333,
        "end": 5338
      },
      "text": "བྱའི་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 5527,
        "end": 5548
      },
      "text": "འཇིག་རྟེན་ལས་འདས་པའི་ ༼སྣར། པེ།༽ འཇིག་རྟེན་འདས་"
    }
  ]
}