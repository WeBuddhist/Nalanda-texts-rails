{
  "durchens": [
    {
      "span": {
        "start": 348,
        "end": 353
      },
      "text": "ཞུགས། ༼སྣར། པེ།༽ བཞུགས།"
    },
    {
      "span": {
        "start": 595,
        "end": 604
      },
      "text": "གིས་གཟུང་ ༼སྣར། པེ།༽ གི་གཟུགས་"
    },
    {
      "span": {
        "start": 790,
        "end": 797
      },
      "text": "མིན་པར་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 851,
        "end": 855
      },
      "text": "ཚིག་ ༼སྣར། པེ།༽ འཚིག་"
    },
    {
      "span": {
        "start": 874,
        "end": 881
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 936,
        "end": 947
      },
      "text": "རང་དབང་ཉིད་ ༼སྣར། པེ།༽ རང་དབང་"
    },
    {
      "span": {
        "start": 947,
        "end": 950
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལས་ཉིད་"
    },
    {
      "span": {
        "start": 993,
        "end": 1000
      },
      "text": "ལྟོས་པ་ ༼སྣར། པེ།༽ བལྟོས་པ་"
    },
    {
      "span": {
        "start": 1109,
        "end": 1114
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 1165,
        "end": 1171
      },
      "text": "གསུང་། ༼སྣར། པེ།༽ གསུངས།"
    },
    {
      "span": {
        "start": 1186,
        "end": 1193
      },
      "text": "ཤེས་བྱ་ ༼སྣར། པེ།༽ ཤེས་པ་"
    },
    {
      "span": {
        "start": 1279,
        "end": 1285
      },
      "text": "གསུང་། ༼སྣར། པེ།༽ གསུངས།"
    },
    {
      "span": {
        "start": 1311,
        "end": 1313
      },
      "text": "ན། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 1355,
        "end": 1363
      },
      "text": "ནའང་མེད་ ༼སྣར། པེ།༽ ནའང་"
    },
    {
      "span": {
        "start": 1363,
        "end": 1366
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་མེད་"
    },
    {
      "span": {
        "start": 1463,
        "end": 1472
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 1612,
        "end": 1619
      },
      "text": "སྐྱེ་བ་ ༼སྣར།༽ སྐྱེས་པ་"
    },
    {
      "span": {
        "start": 1703,
        "end": 1708
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིག་"
    },
    {
      "span": {
        "start": 1966,
        "end": 1972
      },
      "text": "གསུངས། ༼སྣར། པེ།༽ བསྲུངས།"
    },
    {
      "span": {
        "start": 2295,
        "end": 2305
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 2446,
        "end": 2451
      },
      "text": "སྒྲས། ༼སྣར། པེ།༽ སྒྲ།"
    },
    {
      "span": {
        "start": 2469,
        "end": 2477
      },
      "text": "སྤང་པའི་ ༼སྣར། པེ།༽ སྤངས་པའི་"
    },
    {
      "span": {
        "start": 2822,
        "end": 2832
      },
      "text": "ཀྱིས་བསྟན་ ༼སྣར། པེ།༽ ཀྱི་བརྟེན་"
    },
    {
      "span": {
        "start": 2839,
        "end": 2845
      },
      "text": "བསྒོམ་ ༼སྣར། པེ།༽ བསྒོམས་"
    },
    {
      "span": {
        "start": 3044,
        "end": 3052
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    }
  ]
}