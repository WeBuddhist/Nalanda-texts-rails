{
  "durchens": [
    {
      "span": {
        "start": 599,
        "end": 604
      },
      "text": "ཁྲོན་ ༼སྣར། པེ།༽ འཁོན་"
    },
    {
      "span": {
        "start": 886,
        "end": 893
      },
      "text": "མི་རིག་ ༼སྣར། པེ།༽ མི་རིགས་"
    },
    {
      "span": {
        "start": 1130,
        "end": 1136
      },
      "text": "འཇོམས། ༼སྣར། པེ།༽ བླངས།"
    },
    {
      "span": {
        "start": 1218,
        "end": 1224
      },
      "text": "བདེ་མ་ ༼སྣར། པེ།༽ བདེ་བ་"
    },
    {
      "span": {
        "start": 1334,
        "end": 1344
      },
      "text": "འདི་འདྲ་བ། ༼སྣར། པེ།༽ འདི་འདྲ་བས།"
    },
    {
      "span": {
        "start": 1477,
        "end": 1482
      },
      "text": "རྟེན་ ༼སྣར།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 1495,
        "end": 1503
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 1895,
        "end": 1899
      },
      "text": "ལགས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 1965,
        "end": 1971
      },
      "text": "རྫོགས། ༼སྣར། པེ།༽ རྫོགས། འདིས་ཀྱང་འགྲོ་བ་དུ་མ་ལ་ཕན་པ་རྒྱ་ཆེན་པོ་འབྱུང་བར་གྱུར་ཅིག །དཔལ་ར་ས་ར་མོ་ཆེའི་གཙུག་ལག་ཁང་དུ་གྲོང་ཁྱེར་དཔེ་མེད་ཀྱི་པཎྜི་ཏ་ཏི་ལ་ཀ་དང་། བོད་ཀྱི་ལོ་ཙཱ་བ་ཆེན་པོ་ཤཱཀྱའི་དགེ་སློང་པ་ཚབ་ཉི་མ་གྲགས་ཀྱིས་བསྒྱུར་ཅིང་ཞུས་ཏེ་གཏན་ལ་ཕབ་པའོ། །"
    }
  ]
}