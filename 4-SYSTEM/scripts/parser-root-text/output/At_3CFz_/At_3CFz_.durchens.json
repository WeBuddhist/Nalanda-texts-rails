{
  "durchens": [
    {
      "span": {
        "start": 30,
        "end": 34
      },
      "text": "ཁ་ཡ་ ༼སྣར། པེ།༽ ཁ་"
    },
    {
      "span": {
        "start": 379,
        "end": 388
      },
      "text": "འགྲོ་འོང་ ༼སྣར། པེ།༽ འགྲོ་བའི་"
    },
    {
      "span": {
        "start": 533,
        "end": 540
      },
      "text": "བསྟར་བ་ ༼པེ།༽ བལྟར་བ་"
    },
    {
      "span": {
        "start": 823,
        "end": 828
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 1082,
        "end": 1087
      },
      "text": "མནབས། ༼སྣར། པེ།༽ མནབ།"
    },
    {
      "span": {
        "start": 1417,
        "end": 1426
      },
      "text": "བཀྲོལ་བར་ ༼སྣར། པེ།༽ དགྲོལ་བར་"
    },
    {
      "span": {
        "start": 1496,
        "end": 1499
      },
      "text": "དག་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 1664,
        "end": 1673
      },
      "text": "མེད་པ་ཡི། ༼པེ།༽ མེད་པ་ཡིས།"
    }
  ]
}