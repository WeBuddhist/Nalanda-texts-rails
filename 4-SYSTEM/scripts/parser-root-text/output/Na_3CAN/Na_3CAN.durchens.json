{
  "durchens": [
    {
      "span": {
        "start": 25,
        "end": 31
      },
      "text": "ཏཱ་རཱ། ༼པེ། སྣར།༽ ཏཱ་ར།"
    },
    {
      "span": {
        "start": 141,
        "end": 150
      },
      "text": "འདོད་པའི་ ༼པེ། སྣར།༽ འདོད་པ།"
    },
    {
      "span": {
        "start": 249,
        "end": 252
      },
      "text": "སྔགས་ཀྱི་ ༼པེ། སྣར།༽ སྔགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 264,
        "end": 272
      },
      "text": "འགྱུར་ཏེ་ ༼སྣར།༽ འགྱུར་སྟེ།"
    },
    {
      "span": {
        "start": 284,
        "end": 286
      },
      "text": "ཨཱརྱཱ་ ༼པེ།༽ ཿཨཱརྱཱ་ ༼སྣར།༽ ཨཱརྱ་"
    },
    {
      "span": {
        "start": 295,
        "end": 301
      },
      "text": "ཤྭ་རཱ་ ༼སྣར། ༽ ར།"
    },
    {
      "span": {
        "start": 311,
        "end": 316
      },
      "text": "ས་ཏྭཱ་ ༼སྣར།༽ སཏྭ།"
    },
    {
      "span": {
        "start": 324,
        "end": 329
      },
      "text": "ས་ཏྭཱ་ ༼པེ།༽ མ་ཧཱ་ས་ཏྭཱ་ཡ།"
    },
    {
      "span": {
        "start": 332,
        "end": 339
      },
      "text": "མ་ཧཱ་ཀ་ ༼པེ། སྣར།༽ ཀཱ།"
    },
    {
      "span": {
        "start": 345,
        "end": 348
      },
      "text": "ཀཱ་ ༼སྣར།༽ ཀ།"
    },
    {
      "span": {
        "start": 363,
        "end": 384
      },
      "text": "ཏཱ་རེ་ཏུཏྟཱ་རེ་ཏུ་རེ་ ༼སྣར༽ ཏྭ་རེ་ཏུད་ཏཱ་རེ།"
    },
    {
      "span": {
        "start": 409,
        "end": 415
      },
      "text": "ཀྲ་ཏེ་ ༼པེ།༽ ཀྲི་ཊེ།"
    },
    {
      "span": {
        "start": 432,
        "end": 437
      },
      "text": "མོ་ཧ་ ༼སྣར།༽ མོ་ཧཱ།"
    },
    {
      "span": {
        "start": 484,
        "end": 488
      },
      "text": "སྟཾ་ ༼སྣར།༽ ཏཾ།"
    },
    {
      "span": {
        "start": 578,
        "end": 585
      },
      "text": "ཞལ་བཞི་ ༼སྣར།༽ ཞལ་གཅིག"
    },
    {
      "span": {
        "start": 623,
        "end": 625
      },
      "text": "ཡི། ༼སྣར།༽ ཡིས།"
    },
    {
      "span": {
        "start": 743,
        "end": 745
      },
      "text": "ཆེ་ ༼སྣར།༽ ཅན།"
    },
    {
      "span": {
        "start": 786,
        "end": 794
      },
      "text": "རྣ་རྒྱན་ ༼སྣར།༽ བརྒྱན།"
    },
    {
      "span": {
        "start": 960,
        "end": 965
      },
      "text": "མཛུབ་ ༼སྣར།༽ འཛུབ།"
    },
    {
      "span": {
        "start": 1036,
        "end": 1043
      },
      "text": "བསྒྲུབ་ ༼པེ། སྣར།༽ སྒྲུབ།"
    },
    {
      "span": {
        "start": 1093,
        "end": 1101
      },
      "text": "ཡིད་འོང་ ༼སྣར་།༽ ཡིད་འོངས་།"
    },
    {
      "span": {
        "start": 1113,
        "end": 1123
      },
      "text": "རྣམ་པ་ཉིད་ ༼པེ། སྣར།༽ རྣམ་པ་གཉིས།"
    },
    {
      "span": {
        "start": 1162,
        "end": 1170
      },
      "text": "ཞལ་གཅིག་ ༼སྣར།༽ ཞལ་ཅིག"
    },
    {
      "span": {
        "start": 1177,
        "end": 1184
      },
      "text": "གཉིས་མ་ ༼སྣར།༽ གཉིས་པ།"
    },
    {
      "span": {
        "start": 1200,
        "end": 1209
      },
      "text": "ཀུན་གྱིས་ ༼སྣར།༽ ཀུན་གྱི།"
    },
    {
      "span": {
        "start": 1244,
        "end": 1254
      },
      "text": "སྒྲོལ་མ་ནི། ༼པེ། སྣར།༽ སྒྲོལ་མ་སྟེ།"
    },
    {
      "span": {
        "start": 1373,
        "end": 1383
      },
      "text": "སྒྲོལ་མ་ནི། ༼པེ། སྣར།༽ སྒྲོལ་མ་སྟེ།"
    },
    {
      "span": {
        "start": 1386,
        "end": 1391
      },
      "text": "རྒྱལ་ཆེན་ ༼པེ། སྣར།༽ རྒྱན་ཆེན་"
    },
    {
      "span": {
        "start": 1482,
        "end": 1489
      },
      "text": "དྲི་ཡི་ ༼སྣར།༽ དྲི་ཟའི།"
    },
    {
      "span": {
        "start": 1550,
        "end": 1555
      },
      "text": "འབར་མ་ ༼པེ།༽ པ།"
    },
    {
      "span": {
        "start": 1653,
        "end": 1661
      },
      "text": "ཤར་སྒོར་ ༼སྣར།༽ སྐོར།"
    },
    {
      "span": {
        "start": 1825,
        "end": 1833
      },
      "text": "ཞལ་གཅིག་ ༼སྣར།༽ ཞལ་ཅིག"
    },
    {
      "span": {
        "start": 1898,
        "end": 1909
      },
      "text": "ལྕགས་སྒྲོག་ ༼སྣར།༽ ལྕགས་སྒྲོགས།"
    },
    {
      "span": {
        "start": 1950,
        "end": 1962
      },
      "text": "དམར་མོ་བཞིན། ༼པེ།༽ དཀར་མོ་བཞིན།"
    },
    {
      "span": {
        "start": 1962,
        "end": 1968
      },
      "text": "འཇིགས་ ༼སྣར།༽དཀར་མོ་འཛིན།"
    },
    {
      "span": {
        "start": 2034,
        "end": 2042
      },
      "text": "ཞལ་གཅིག ༼སྣར།༽ ཞལ་ཅིག"
    },
    {
      "span": {
        "start": 2132,
        "end": 2142
      },
      "text": "གཡས་བརྐྱང་ ༼པེ། སྣར།༽ གཡས་རྐྱང་།"
    },
    {
      "span": {
        "start": 2238,
        "end": 2247
      },
      "text": "བརྒྱན་པར་ ༼པེ། སྣར།༽ རྒྱན་པ།"
    },
    {
      "span": {
        "start": 2337,
        "end": 2346
      },
      "text": "བསྒོམས་ནས་ ༼པེ། སྣར།༽ བསྒོམ་ན།"
    },
    {
      "span": {
        "start": 2366,
        "end": 2374
      },
      "text": "བཟླས་པར་ ༼པེ། སྣར།༽ བཟླས་པ།"
    },
    {
      "span": {
        "start": 2389,
        "end": 2395
      },
      "text": "ཏུཏྟཱ་ ༼སྣར།༽ ད་ཏ།"
    },
    {
      "span": {
        "start": 2417,
        "end": 2425
      },
      "text": "བཅུ་ཡིས་ ༼པེ།༽ བཅུ་ཡི།"
    },
    {
      "span": {
        "start": 2531,
        "end": 2540
      },
      "text": "ཀུན་གྱིས་ ༼པེ། སྣར།༽ ཀུན་གྱི།"
    },
    {
      "span": {
        "start": 2584,
        "end": 2596
      },
      "text": "བཀླགས་པ་ཡིས་ ༼སྣར།༽ བཀླགས་པ་ཡི།"
    },
    {
      "span": {
        "start": 2635,
        "end": 2646
      },
      "text": "གུར་བསྒོམས་ ༼སྣར།༽ གུར་བསྡམ།"
    },
    {
      "span": {
        "start": 2690,
        "end": 2696
      },
      "text": "བསྔགས་ ༼སྣར།༽ སྔགས་།"
    },
    {
      "span": {
        "start": 2705,
        "end": 2710
      },
      "text": "མདུད་ ༼སྣར།༽ བསྟོད།"
    },
    {
      "span": {
        "start": 2899,
        "end": 2910
      },
      "text": "སྦྱིན་སྲེག་ ༼སྣར།༽ སྦྱིན་བསྲེག"
    },
    {
      "span": {
        "start": 2980,
        "end": 2983
      },
      "text": "ཀི་མེ་བ་ ༼སྣར།༽ བྷ།"
    },
    {
      "span": {
        "start": 2987,
        "end": 2992
      },
      "text": "མ་ནཱ་ ༼པེ།༽ མཱ་ན། ༼སྣར།༽ མ་ན།"
    },
    {
      "span": {
        "start": 3080,
        "end": 3083
      },
      "text": "སྦས་ ༼སྣར།༽ བཟླས།"
    },
    {
      "span": {
        "start": 3099,
        "end": 3105
      },
      "text": "སྐྲོད་ ༼པེ། སྣར།༽ བསྐྲོད།"
    },
    {
      "span": {
        "start": 3155,
        "end": 3167
      },
      "text": "ཤཱི་གྷྲཾ་གཱ་ ༼པེ།༽ ཤི་གྷཾ་གྷ། ༼སྣར།༽ ཤི་གྷཾ་ག"
    },
    {
      "span": {
        "start": 3183,
        "end": 3190
      },
      "text": "ཨུཙྪ་ཊ་ ༼སྣར།༽ ད་ཏཾ། ཨུཙྪ་ཏྲ།"
    },
    {
      "span": {
        "start": 3265,
        "end": 3270
      },
      "text": "རེ་ཨ་ ༼པེ༽ ཨཱ།"
    },
    {
      "span": {
        "start": 3289,
        "end": 3299
      },
      "text": "ཀུ་མཱ་རཱི་ ༼སྣར།༽ དྷ་ནཱ་རི།"
    },
    {
      "span": {
        "start": 3321,
        "end": 3327
      },
      "text": "པི་ཏཱ་ ༼སྣར།༽ བྷྱི་བ་ཧ་ན་ཏྱཿཔི་ཏ།"
    },
    {
      "span": {
        "start": 3354,
        "end": 3359
      },
      "text": "གཏུམ་པོའི་ ༼པེ། སྣར།༽ གཏུམ་མོའི།"
    },
    {
      "span": {
        "start": 3376,
        "end": 3384
      },
      "text": "དེ་བཞིན་ ༼པེ།༽ དེ་བཞིན་དུ།"
    },
    {
      "span": {
        "start": 3482,
        "end": 3491
      },
      "text": "བུ་རམ་གྱི་ ༼སྣར།༽ གྱིས།"
    },
    {
      "span": {
        "start": 3511,
        "end": 3518
      },
      "text": "བསྒྲུབ་ ༼སྣར།༽ སྒྲུབ།"
    },
    {
      "span": {
        "start": 3520,
        "end": 3525
      },
      "text": "བསྔགས་ ༼པེ།༽ སྔགས།"
    },
    {
      "span": {
        "start": 3542,
        "end": 3553
      },
      "text": "སྦྱོར་བ་ཡིས་ ༼སྣར།༽ སྦྱོར་བའི་ས།"
    },
    {
      "span": {
        "start": 3600,
        "end": 3606
      },
      "text": "རབ་ཏུ་ ༼པེ།༽ རབ་ལ་ཡང་། ༼སྣར།༽ ཡང་།"
    },
    {
      "span": {
        "start": 3616,
        "end": 3623
      },
      "text": "གྱུར་ཏེ་ ༼སྣར།༽ འགྱུར་སྟེ།"
    },
    {
      "span": {
        "start": 3657,
        "end": 3663
      },
      "text": "ཨ་བྷི་ ༼པེ།༽ ཨ་བི།"
    },
    {
      "span": {
        "start": 3679,
        "end": 3682
      },
      "text": "སྭ་སྠཱ་ན་ཏེ་ ༼པེ།༽ སྭཱསྠཱ་ན་ཏ། ༼སྣར།༽ སྭསྠཱ་ན་ཏ།"
    },
    {
      "span": {
        "start": 3756,
        "end": 3764
      },
      "text": "རང་བྱུང་ ༼སྣར།༽ རང་འབྱུང་།"
    },
    {
      "span": {
        "start": 3776,
        "end": 3783
      },
      "text": "བསྙུགས་ ༼སྣར།༽ བསྙུངས།"
    },
    {
      "span": {
        "start": 3885,
        "end": 3893
      },
      "text": "རང་བྱུང་ ༼སྣར།༽ རང་འབྱུང་།"
    },
    {
      "span": {
        "start": 3907,
        "end": 3913
      },
      "text": "བསྐུས་ ༼སྣར།༽ བཀུས།"
    },
    {
      "span": {
        "start": 3931,
        "end": 3937
      },
      "text": "འདས་མ་ ༼སྣར།༽ མ།"
    },
    {
      "span": {
        "start": 3968,
        "end": 3977
      },
      "text": "ཨུཏྤ་ལའི་ ༼སྣར།༽ ཨུདྤལ།"
    },
    {
      "span": {
        "start": 4013,
        "end": 4020
      },
      "text": "ལྷ་རྫས་ ༼སྣར།༽ རྣམས་རྫས་ལ།"
    },
    {
      "span": {
        "start": 4038,
        "end": 4044
      },
      "text": "ཞེས་པ། ༼པེ། སྣར།༽ བཞེས།"
    },
    {
      "span": {
        "start": 4054,
        "end": 4061
      },
      "text": "མཆོད་པ་ ༼སྣར།༽ མཆོད་པ་ཡང་།"
    },
    {
      "span": {
        "start": 4074,
        "end": 4080
      },
      "text": "བསྒོམ་ ༼སྣར།༽ བསྒོམས།"
    },
    {
      "span": {
        "start": 4125,
        "end": 4131
      },
      "text": "ཏུ་རེ་ ༼སྣར།༽ +ཏུ་རེ།"
    },
    {
      "span": {
        "start": 4136,
        "end": 4151
      },
      "text": "ཀི་མ་མ་ཨེ་པ་ཙི་ ༼པེ།༽ ཀཱི་མ་མ་ཨི་པ་ཙི། ༼སྣར།༽ གི་མ་མ་ཨཱི་བ་ཆི།"
    },
    {
      "span": {
        "start": 4161,
        "end": 4166
      },
      "text": "ཀ་ཐཱ་ ༼པེ། སྣར།༽ ཀ་ཐ།"
    },
    {
      "span": {
        "start": 4245,
        "end": 4252
      },
      "text": "བསྒྲུབ་ ༼སྣར།༽ སྒྲུབ།"
    },
    {
      "span": {
        "start": 4271,
        "end": 4276
      },
      "text": "བསམས་ ༼པེ། སྣར།༽ བསམ།"
    },
    {
      "span": {
        "start": 4333,
        "end": 4342
      },
      "text": "སྦྱོར་བར་ ༼སྣར།༽ སྤྱོད་པར།"
    },
    {
      "span": {
        "start": 4368,
        "end": 4376
      },
      "text": "ལན་བདུན་ ༼སྣར།༽ ལན་བདུན་དུ།"
    },
    {
      "span": {
        "start": 4384,
        "end": 4390
      },
      "text": "བསྔགས་ ༼སྣར།༽ སྔགས།"
    },
    {
      "span": {
        "start": 4488,
        "end": 4496
      },
      "text": "གྱུར་པས་ ༼པེ།༽ གྱུར་ནས། ༼སྣར།༽ ནས་མི།"
    },
    {
      "span": {
        "start": 4503,
        "end": 4511
      },
      "text": "བྱེད་པར་ ༼སྣར།༽+མི།"
    },
    {
      "span": {
        "start": 4522,
        "end": 4529
      },
      "text": "འགལ་བར་ ༼སྣར།༽ འགྱུར་བས།"
    },
    {
      "span": {
        "start": 4724,
        "end": 4732
      },
      "text": "འགྱུར་ཏེ་ ༼པེ། ཤྣར།༽ འགྱུར་རོ།"
    },
    {
      "span": {
        "start": 4758,
        "end": 4763
      },
      "text": "བཟླས་ནས་ ༼སྣར།༽ བཟླས་ན།"
    },
    {
      "span": {
        "start": 4820,
        "end": 4826
      },
      "text": "ཨརྐའི་ ༼པེ། སྣར།༽ ཨ་ཀའི།"
    },
    {
      "span": {
        "start": 4891,
        "end": 4899
      },
      "text": "རྡོ་རྗེ་ ༼པེ། སྣར།༽ རྡོ་རྗེའི།"
    },
    {
      "span": {
        "start": 4934,
        "end": 4943
      },
      "text": "མཆོག་གིས་ ༼པེ། སྣར།༽ མཆོག་གི།"
    },
    {
      "span": {
        "start": 5123,
        "end": 5132
      },
      "text": "གཞན་ལ་ཡང་ ༼པེ། སྣར།༽ གཞན་ཡང་"
    },
    {
      "span": {
        "start": 5147,
        "end": 5155
      },
      "text": "འགྱུར་ཏེ། ༼པེ། སྣར།༽ འགྱུར་རོ།།"
    },
    {
      "span": {
        "start": 5238,
        "end": 5249
      },
      "text": "བྷྲིང་ག་རཱ་ ༼སྣར།༽ བྷྲིང་ག་ར།"
    },
    {
      "span": {
        "start": 5263,
        "end": 5266
      },
      "text": "གི་ཝང་ ༼པེ། སྣར།༽ འགི་ཝང་།"
    },
    {
      "span": {
        "start": 5523,
        "end": 5531
      },
      "text": "རྡོ་རྗེ་ ༼པེ། སྣར།༽ རྡོ་རྗེའི།"
    },
    {
      "span": {
        "start": 5843,
        "end": 5846
      },
      "text": "སཱ་ལུའི་ ༼པེ། སྣར།༽ ས་ལུའི།"
    },
    {
      "span": {
        "start": 5993,
        "end": 6001
      },
      "text": "གཟས་ཟིན་ ༼སྣར།༽ གཟིན།"
    },
    {
      "span": {
        "start": 6107,
        "end": 6112
      },
      "text": "སྦྱར་ ༼པེ། སྣར།༽ སྤང་།"
    },
    {
      "span": {
        "start": 6275,
        "end": 6278
      },
      "text": "བརྒྱ་རྩ་བརྒྱད་ ༼པེ། སྣར།༽ བརྒྱ་རྩ།"
    },
    {
      "span": {
        "start": 6300,
        "end": 6311
      },
      "text": "འབྲས་བུ་དེ་ ༼པེ། སྣར།༽ དེ།"
    },
    {
      "span": {
        "start": 6341,
        "end": 6347
      },
      "text": "བྱུགས་ ༼པེ། སྣར།༽-ནས་བྱུགས།"
    },
    {
      "span": {
        "start": 6376,
        "end": 6383
      },
      "text": "གཞན་དུ་ ༼པེ། སྣར།༽ ལས་གཞན་ལ།"
    },
    {
      "span": {
        "start": 6454,
        "end": 6461
      },
      "text": "མུ་ཀྟིཾ་ ༼པེ། སྣར།༽ མུཀྵིཾ།"
    },
    {
      "span": {
        "start": 6461,
        "end": 6466
      },
      "text": "ཀུ་རུ་ ༼པེ། སྣར།༽ ཀུ་མུ།"
    }
  ]
}