{
  "durchens": [
    {
      "span": {
        "start": 88,
        "end": 90
      },
      "text": "བ་ ༼སྣར། པེ།༽ བ་ལ་"
    },
    {
      "span": {
        "start": 165,
        "end": 171
      },
      "text": "རིམ་པ་ ༼སྣར། པེ།༽ རིམ་པའི་"
    },
    {
      "span": {
        "start": 221,
        "end": 230
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་པ་"
    },
    {
      "span": {
        "start": 342,
        "end": 352
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 805,
        "end": 812
      },
      "text": "ནམ་མཁའ་ ༼སྣར།༽ ནམ་མཁའི་"
    },
    {
      "span": {
        "start": 1093,
        "end": 1102
      },
      "text": "བསྒོམ་པར་ ༼སྣར། པེ།༽ སྒོམ་པར་"
    },
    {
      "span": {
        "start": 1195,
        "end": 1205
      },
      "text": "བསྐྱེད་པར་ ༼སྣར། པེ།༽ སྐྱེད་པར་"
    },
    {
      "span": {
        "start": 1506,
        "end": 1516
      },
      "text": "བསྐྱེད་པས་ ༼སྣར། པེ།༽ བསྐྱེད་པས་རྗེས་སུ་ཞུགས་པས་"
    },
    {
      "span": {
        "start": 1710,
        "end": 1719
      },
      "text": "ཁྲོ་བོའི་ ༼སྣར། པེ།༽ ཁྲོ་བོ་"
    },
    {
      "span": {
        "start": 2172,
        "end": 2175
      },
      "text": "ཐབ་ ༼སྣར། པེ།༽ ཐལ་"
    },
    {
      "span": {
        "start": 2508,
        "end": 2517
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 2683,
        "end": 2692
      },
      "text": "དོན་གྱིས་ ༼སྣར།༽ དོན་གྱི་"
    },
    {
      "span": {
        "start": 2718,
        "end": 2724
      },
      "text": "བསྒོམ་ ༼སྣར། པེ།༽ སྒོམ་"
    },
    {
      "span": {
        "start": 2812,
        "end": 2818
      },
      "text": "བསྒོམ། ༼སྣར། པེ།༽ སྒོམ།"
    },
    {
      "span": {
        "start": 3096,
        "end": 3104
      },
      "text": "ཀུན་གྱི་ ༼སྣར། པེ།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 3240,
        "end": 3250
      },
      "text": "མཛེས་པ་ཡི། ༼སྣར། པེ།༽ མཛེས་པ་ཡིས།"
    },
    {
      "span": {
        "start": 3353,
        "end": 3364
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱིས་"
    },
    {
      "span": {
        "start": 3370,
        "end": 3374
      },
      "text": "གནས་ ༼སྣར། པེ།༽ ནས་"
    },
    {
      "span": {
        "start": 3691,
        "end": 3694
      },
      "text": "རབ་ ༼སྣར། པེ།༽ ཀུན་"
    },
    {
      "span": {
        "start": 3827,
        "end": 3840
      },
      "text": "དམིགས་པར་སྟན་ ༼སྣར། པེ།༽ དམིགས་པ་བསྟན་"
    },
    {
      "span": {
        "start": 3878,
        "end": 3883
      },
      "text": "བརྩམ་ ༼སྣར། པེ།༽ ཙམ་"
    },
    {
      "span": {
        "start": 4173,
        "end": 4179
      },
      "text": "གཏོགས་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 4354,
        "end": 4358
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱིས་"
    },
    {
      "span": {
        "start": 4435,
        "end": 4444
      },
      "text": "གཟུགས་སུ་ ༼སྣར། པེ།༽ གཟུགས་"
    },
    {
      "span": {
        "start": 4686,
        "end": 4691
      },
      "text": "བལྟས་ ༼སྣར། པེ།༽ ལྟས་"
    },
    {
      "span": {
        "start": 4717,
        "end": 4740
      },
      "text": "གྱི་འཕྲོ་འདུ་བསྐྱེད་ནས་ ༼སྣར། པེ།༽ གྱི་ཕྲོ་བ་"
    },
    {
      "span": {
        "start": 5144,
        "end": 5151
      },
      "text": "དག་གིས་ ༼སྣར། པེ།༽ དག་གི་"
    },
    {
      "span": {
        "start": 5403,
        "end": 5424
      },
      "text": "རང་བཞིན་གྱི་ལུས་ཀྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 5495,
        "end": 5499
      },
      "text": "རྒྱ་ ༼སྣར། པེ།༽ རྒྱས་"
    },
    {
      "span": {
        "start": 5554,
        "end": 5561
      },
      "text": "གསང་བར་ ༼སྣར། པེ།༽ གསང་བ་"
    },
    {
      "span": {
        "start": 6018,
        "end": 6027
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 6342,
        "end": 6350
      },
      "text": "གྱུར་ཏེ་ ༼སྣར། པེ།༽ གྱུར་ཏོ་"
    },
    {
      "span": {
        "start": 6532,
        "end": 6541
      },
      "text": "བཅུ་གཅིག་ ༼སྣར། པེ།༽ བཅུ་"
    },
    {
      "span": {
        "start": 6705,
        "end": 6712
      },
      "text": "ཨཱཿཞེས་ ༼སྣར། པེ།༽ ཨཱཿཨ་ཞེས་"
    },
    {
      "span": {
        "start": 6977,
        "end": 6981
      },
      "text": "བཏབ་ ༼པེ།༽ བཏབ་པ་"
    },
    {
      "span": {
        "start": 7571,
        "end": 7580
      },
      "text": "མཆོག་གིས་ ༼སྣར། པེ།༽ མཆོག་གི་"
    },
    {
      "span": {
        "start": 7640,
        "end": 7649
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་དཔའི་"
    },
    {
      "span": {
        "start": 7787,
        "end": 7792
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 7826,
        "end": 7834
      },
      "text": "ཐུགས་ཀར་ ༼སྣར། པེ།༽ སྙིང་གར་"
    },
    {
      "span": {
        "start": 7877,
        "end": 7883
      },
      "text": "བསྒོམ་ ༼པེ།༽ སྒོམ་"
    },
    {
      "span": {
        "start": 8426,
        "end": 8435
      },
      "text": "ཕྱུངས་ཏེ་ ༼སྣར། པེ།༽ ཕྱུང་སྟེ་"
    },
    {
      "span": {
        "start": 8519,
        "end": 8528
      },
      "text": "གསུངས་པས་ ༼སྣར། པེ།༽ གསུངས་པའི་"
    },
    {
      "span": {
        "start": 9068,
        "end": 9072
      },
      "text": "བལྟ། ༼སྣར། པེ།༽ ལྟ།"
    },
    {
      "span": {
        "start": 9126,
        "end": 9140
      },
      "text": "རྡོ་རྗེས་མཉེས་ ༼སྣར།༽ རྡོ་རྗེ་མཉེས་ ༼པེ།༽ རྡོ་རྗེ་གཉིས་"
    },
    {
      "span": {
        "start": 9453,
        "end": 9460
      },
      "text": "བསྒོམས་ ༼སྣར། པེ།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 10167,
        "end": 10176
      },
      "text": "འཁོར་ལོར་ ༼སྣར། པེ།༽ འཁོར་ལོ་"
    },
    {
      "span": {
        "start": 10236,
        "end": 10240
      },
      "text": "རྒྱ་ ༼སྣར།༽ བརྒྱ་"
    },
    {
      "span": {
        "start": 10426,
        "end": 10433
      },
      "text": "རིག་པས་ ༼སྣར། པེ།༽ རིགས་པས་"
    },
    {
      "span": {
        "start": 10530,
        "end": 10538
      },
      "text": "བསླངས་པ་ ༼སྣར། པེ།༽ སླངས་པ་"
    },
    {
      "span": {
        "start": 10563,
        "end": 10565
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 10633,
        "end": 10643
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 10685,
        "end": 10691
      },
      "text": "བརྗོད་ ༼སྣར། པེ།༽ རྗོད་"
    },
    {
      "span": {
        "start": 10694,
        "end": 10702
      },
      "text": "རྡོ་རྗེ་ ༼སྣར། པེ།༽ རྡོ་རྗེའི་"
    },
    {
      "span": {
        "start": 10915,
        "end": 10934
      },
      "text": "གཤེགས་པ་ཐམས་ཅད་ཀྱི་ ༼སྣར། པེ།༽ གཤེགས་པའི་"
    },
    {
      "span": {
        "start": 11006,
        "end": 11014
      },
      "text": "བསྟོད་པ་ ༼སྣར། པེ།༽ བསྟོད་པས་"
    },
    {
      "span": {
        "start": 11076,
        "end": 11081
      },
      "text": "ཞུགས་ ༼སྣར། པེ།༽ ཞུགས་པ་"
    },
    {
      "span": {
        "start": 11214,
        "end": 11224
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 11250,
        "end": 11256
      },
      "text": "སད་པར་ ༼སྣར། པེ།༽ བསད་པར་"
    },
    {
      "span": {
        "start": 11571,
        "end": 11580
      },
      "text": "བསྒོམས་ན། ༼སྣར། པེ།༽ བསྒོམ་ལ།"
    },
    {
      "span": {
        "start": 11735,
        "end": 11740
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 11882,
        "end": 11894
      },
      "text": "རྣལ་འབྱོར་ལ་ ༼སྣར། པེ།༽ རྣལ་འབྱོར་"
    },
    {
      "span": {
        "start": 12113,
        "end": 12118
      },
      "text": "བཏོན་ ༼སྣར། པེ།༽ སྟོན་"
    },
    {
      "span": {
        "start": 12848,
        "end": 12857
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 12910,
        "end": 12919
      },
      "text": "བསྐྱེད་པ་ ༼པེ།༽ སྐྱེད་པ་"
    },
    {
      "span": {
        "start": 13102,
        "end": 13111
      },
      "text": "སྔགས་ཀྱི་ ༼པེ།༽ སྔགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 13166,
        "end": 13175
      },
      "text": "ཐུགས་ཀྱི་ ༼སྣར། པེ།༽ ཐུགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 13285,
        "end": 13293
      },
      "text": "བརླབས་པ་ ༼སྣར།༽ བརླབ་པ་"
    },
    {
      "span": {
        "start": 13556,
        "end": 13563
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 13567,
        "end": 13571
      },
      "text": "གྱི་ ༼སྣར། པེ།༽ གྱིས་"
    },
    {
      "span": {
        "start": 13640,
        "end": 13646
      },
      "text": "ཞལ་སྔ་ ༼སྣར།༽ ཞལ་"
    }
  ]
}