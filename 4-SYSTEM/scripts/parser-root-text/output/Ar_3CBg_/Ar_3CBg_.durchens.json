{
  "durchens": [
    {
      "span": {
        "start": 56,
        "end": 59
      },
      "text": "པི་ ༼སྣར། པེ།༽ ཕི་"
    },
    {
      "span": {
        "start": 454,
        "end": 462
      },
      "text": "ཚིག་གིས་ ༼སྣར། པེ།༽ ཚིག་གི་"
    },
    {
      "span": {
        "start": 604,
        "end": 607
      },
      "text": "པས། ༼སྣར། པེ།༽ པའི། འདོད་པ།"
    },
    {
      "span": {
        "start": 688,
        "end": 695
      },
      "text": "རུང་པས་ ༼སྣར། པེ།༽ རུང་བར་"
    },
    {
      "span": {
        "start": 743,
        "end": 757
      },
      "text": "རྣལ་འབྱོར་གྱི་ ༼སྣར། པེ།༽ རྣལ་འབྱོར་"
    },
    {
      "span": {
        "start": 1010,
        "end": 1015
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 1032,
        "end": 1036
      },
      "text": "གཞག་ ༼སྣར། པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 1096,
        "end": 1101
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 1125,
        "end": 1131
      },
      "text": "དེ་ནས་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 1542,
        "end": 1550
      },
      "text": "ནི་ལག་པ་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 1682,
        "end": 1689
      },
      "text": "གཉིས་ལ་ ༼སྣར། པེ།༽ གཉིས་པ་"
    },
    {
      "span": {
        "start": 1777,
        "end": 1786
      },
      "text": "གཅིག་གིས། ༼སྣར། པེ།༽ གཅིག་ལ།"
    },
    {
      "span": {
        "start": 2855,
        "end": 2860
      },
      "text": "དྲ་བ་ ༼སྣར། པེ།༽ ར་བ་"
    },
    {
      "span": {
        "start": 2989,
        "end": 2998
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 3164,
        "end": 3169
      },
      "text": "དཀུར་ ༼སྣར། པེ།༽ བཀུག་ནས་"
    },
    {
      "span": {
        "start": 3238,
        "end": 3243
      },
      "text": "བྱའོ། ༼སྣར། པེ།༽ བྱ་སྟེ།"
    },
    {
      "span": {
        "start": 3266,
        "end": 3274
      },
      "text": "གདན་གྱི་ ༼ཅོ།༽ གདན་"
    },
    {
      "span": {
        "start": 4549,
        "end": 4554
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 4599,
        "end": 4608
      },
      "text": "བསམས་པའི་ ༼སྣར། པེ།༽ བསམ་པའི་"
    },
    {
      "span": {
        "start": 4757,
        "end": 4764
      },
      "text": "བསམ་པར་ ༼སྣར། པེ།༽ བསམས་པར་"
    },
    {
      "span": {
        "start": 5118,
        "end": 5127
      },
      "text": "རྨ་བྱ་ཡི། ༼སྣར། པེ།༽ རྨ་བྱ་ཡིས།"
    },
    {
      "span": {
        "start": 5193,
        "end": 5200
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 5254,
        "end": 5259
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 5939,
        "end": 5942
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 6179,
        "end": 6184
      },
      "text": "ཏྭ་ཨ་ ༼སྣར། པེ།༽ ཏྭ་"
    },
    {
      "span": {
        "start": 6275,
        "end": 6279
      },
      "text": "ཧྱོ་ ༼སྣར། པེ།༽ ཧྱ་"
    },
    {
      "span": {
        "start": 7443,
        "end": 7450
      },
      "text": "འདས་པར་ ༼སྣར། པེ།༽ འདེབས་པར་"
    },
    {
      "span": {
        "start": 7761,
        "end": 7768
      },
      "text": "དག་འབར། ༼སྣར། པེ།༽ དགའ་བར།"
    },
    {
      "span": {
        "start": 8069,
        "end": 8087
      },
      "text": "རྣལ་འབྱོར་གྱིས་ནི་ ༼སྣར། པེ།༽ རྣལ་འབྱོར་"
    },
    {
      "span": {
        "start": 8875,
        "end": 8878
      },
      "text": "དེ་ ༼སྣར། པེ།༽ མེ་"
    },
    {
      "span": {
        "start": 9581,
        "end": 9590
      },
      "text": "ཙོག་བུའི་ ༼སྣར། པེ།༽ ཅོག་བུའི་"
    },
    {
      "span": {
        "start": 9667,
        "end": 9674
      },
      "text": "མཛད་པས། ༼སྣར། པེ།༽ མཛད་པ།"
    },
    {
      "span": {
        "start": 9698,
        "end": 9703
      },
      "text": "གྱེས། ༼སྣར། པེ།༽ དགྱེས།"
    },
    {
      "span": {
        "start": 11572,
        "end": 11577
      },
      "text": "ཤན་པ་ ༼སྣར། པེ།༽ ཤེན་པ་"
    },
    {
      "span": {
        "start": 11696,
        "end": 11702
      },
      "text": "འགྲེལ། ༼སྣར། པེ།༽ འབྲེལ།"
    },
    {
      "span": {
        "start": 11854,
        "end": 11864
      },
      "text": "གཏུམ་མོའི་ ༼སྣར། པེ།༽ གཏུམ་མོ་"
    },
    {
      "span": {
        "start": 12090,
        "end": 12097
      },
      "text": "དྲག་མོ་ ༼སྣར། པེ།༽ དྲག་པོ་"
    },
    {
      "span": {
        "start": 12528,
        "end": 12536
      },
      "text": "སྦྱར་བས་ ༼སྣར། པེ།༽ ཁྱེར་བས་"
    },
    {
      "span": {
        "start": 13002,
        "end": 13006
      },
      "text": "འདུ་ ༼སྣར། པེ།༽ འཛུ་"
    },
    {
      "span": {
        "start": 13110,
        "end": 13117
      },
      "text": "དྲག་པོ་ ༼སྣར། པེ།༽ དྲག་མོ་"
    },
    {
      "span": {
        "start": 13358,
        "end": 13361
      },
      "text": "ནི། ༼སྣར། པེ།༽ དྷྱེ།"
    },
    {
      "span": {
        "start": 13562,
        "end": 13571
      },
      "text": "འདུག་པའི་ ༼སྣར། པེ།༽ སྡུག་པའི་"
    },
    {
      "span": {
        "start": 13729,
        "end": 13733
      },
      "text": "ཀའི་ ༼སྣར། པེ།༽ བཀའི་"
    },
    {
      "span": {
        "start": 13900,
        "end": 13907
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 14128,
        "end": 14133
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 14244,
        "end": 14251
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 14349,
        "end": 14356
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 14418,
        "end": 14422
      },
      "text": "གཞག་ ༼སྣར། པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 14479,
        "end": 14486
      },
      "text": "དམ་ཚིག་ ༼སྣར། པེ།༽ དམ་ཚིག་གི་"
    },
    {
      "span": {
        "start": 14499,
        "end": 14503
      },
      "text": "གཞག་ ༼སྣར། པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 14907,
        "end": 14918
      },
      "text": "བསྲེགས་པའི་ ༼སྣར། པེ།༽ བསྲེག་པའི་"
    },
    {
      "span": {
        "start": 15103,
        "end": 15112
      },
      "text": "གསུམ་གྱི་ ༼སྣར། པེ།༽ གསུམ་གྱིས་"
    },
    {
      "span": {
        "start": 15122,
        "end": 15127
      },
      "text": "བཏང་། ༼སྣར། པེ།༽ གཏང་།"
    },
    {
      "span": {
        "start": 15419,
        "end": 15421
      },
      "text": "ཧ་ ༼སྣར། པེ།༽ ཧ་་"
    },
    {
      "span": {
        "start": 15533,
        "end": 15538
      },
      "text": "མདུན་ ༼སྣར། པེ།༽ བདུན་"
    },
    {
      "span": {
        "start": 15812,
        "end": 15817
      },
      "text": "བཅིང་ ༼སྣར། པེ།༽ བཅིངས་"
    },
    {
      "span": {
        "start": 16321,
        "end": 16329
      },
      "text": "བསྐོར་བ་ ༼སྣར། པེ།༽ སྐོར་བ་"
    },
    {
      "span": {
        "start": 16572,
        "end": 16577
      },
      "text": "བརྟན་ ༼སྣར།༽ བསྟན་ ༼པེ།༽ སྙན་"
    },
    {
      "span": {
        "start": 16909,
        "end": 16914
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 16979,
        "end": 16988
      },
      "text": "བཅུག་སྟེ། ༼སྣར། པེ།༽ བཅུག་ནས།"
    },
    {
      "span": {
        "start": 17576,
        "end": 17584
      },
      "text": "བཅིངས་ལ། ༼སྣར། པེ།༽ བཅིངས་ནས།"
    },
    {
      "span": {
        "start": 17619,
        "end": 17625
      },
      "text": "ཀུ་རུ་ ༼སྣར། པེ།༽ ཀུ་རུ་ཀུ་རུ་"
    },
    {
      "span": {
        "start": 17756,
        "end": 17763
      },
      "text": "རྩེ་མོ་ ༼སྣར། པེ།༽ རྩེ་མོའི་"
    },
    {
      "span": {
        "start": 17799,
        "end": 17803
      },
      "text": "རྒྱ། ༼པེ།༽ བརྒྱ།"
    },
    {
      "span": {
        "start": 17861,
        "end": 17868
      },
      "text": "རྐེད་པ་ ༼སྣར།༽ རྐང་པ་"
    },
    {
      "span": {
        "start": 17885,
        "end": 17890
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 18057,
        "end": 18061
      },
      "text": "པྲི་ ༼ཅོ།༽ པྲ་ ༼སྣར། པེ།༽ པྲྀ་"
    },
    {
      "span": {
        "start": 18460,
        "end": 18468
      },
      "text": "བཅིངས་ལ། ༼སྣར། པེ།༽ བཅིངས་ཏེ།"
    },
    {
      "span": {
        "start": 18551,
        "end": 18560
      },
      "text": "གཡས་པ་ཡི། ༼སྣར། པེ།༽ གཡས་པ་ཡིས།"
    },
    {
      "span": {
        "start": 18581,
        "end": 18586
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 18659,
        "end": 18664
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 18990,
        "end": 18998
      },
      "text": "བསྒྲེང་། ༼སྣར། པེ།༽ འགྲེང་།"
    },
    {
      "span": {
        "start": 19511,
        "end": 19536
      },
      "text": "ལག་པ་གཉིས་ནི་བརྐྱང་ནས་ནི། ༼སྣར། པེ།༽ ཁུ་ཚུར་བྱས་ནས་དཀར་པོ་བསྒྲེང་།"
    },
    {
      "span": {
        "start": 19740,
        "end": 19752
      },
      "text": "དབང་ལྡན་གྱི་ ༼སྣར། པེ།༽ དབང་ལྡན་གྱིས་"
    },
    {
      "span": {
        "start": 19979,
        "end": 19982
      },
      "text": "སུ། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 20271,
        "end": 20276
      },
      "text": "བཅིང་ ༼སྣར། པེ།༽ བཅིངས་"
    },
    {
      "span": {
        "start": 20376,
        "end": 20380
      },
      "text": "དྲི་ ༼སྣར། པེ།༽ དི་"
    },
    {
      "span": {
        "start": 20407,
        "end": 20415
      },
      "text": "མར་མེའོ། ༼སྣར། པེ།༽ མར་མེའི།"
    },
    {
      "span": {
        "start": 20764,
        "end": 20768
      },
      "text": "བླང་ ༼སྣར།༽ བླས་ ༼པེ།༽ བླངས་"
    },
    {
      "span": {
        "start": 20825,
        "end": 20831
      },
      "text": "གཏོགས་ ༼སྣར། པེ།༽ གཏོག་"
    },
    {
      "span": {
        "start": 20998,
        "end": 21006
      },
      "text": "འདོན་པར་ ༼སྣར། པེ།༽ གདོན་པར་"
    },
    {
      "span": {
        "start": 21181,
        "end": 21187
      },
      "text": "འབད་པ་ ༼ཅོ།༽ འབོད་པ་"
    },
    {
      "span": {
        "start": 21359,
        "end": 21362
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ཎི་"
    },
    {
      "span": {
        "start": 21394,
        "end": 21396
      },
      "text": "ཙ་ ༼སྣར། པེ།༽ ཙཱ་"
    },
    {
      "span": {
        "start": 21560,
        "end": 21567
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 21581,
        "end": 21587
      },
      "text": "བགེགས་ ༼སྣར། པེ།༽ སྒེག་"
    },
    {
      "span": {
        "start": 21609,
        "end": 21614
      },
      "text": "དགུག་ ༼སྣར།༽ དགས་"
    },
    {
      "span": {
        "start": 21623,
        "end": 21627
      },
      "text": "གཞག་ ༼སྣར། པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 21755,
        "end": 21761
      },
      "text": "བརྡབས་ ༼སྣར། པེ།༽ བརྡེབ་"
    },
    {
      "span": {
        "start": 21971,
        "end": 21981
      },
      "text": "ཅང་ཧེའུའི་ ༼ཅོ།༽ ཅང་ཏེའུའི་ ༼སྣར། པེ།༽ ཅང་ཏེའུ་"
    },
    {
      "span": {
        "start": 21990,
        "end": 21999
      },
      "text": "བརྡེགས་པ་ ༼སྣར། པེ།༽ བརྡེག་པ་"
    },
    {
      "span": {
        "start": 22458,
        "end": 22466
      },
      "text": "སྙེམས་པ་ ༼སྣར། པེ།༽ བསྙེམས་པ་"
    },
    {
      "span": {
        "start": 22489,
        "end": 22499
      },
      "text": "སེམས་དཔའི་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 22596,
        "end": 22606
      },
      "text": "འཇོམས་པའི། ༼སྣར། པེ།༽ འཇོམས་པ།"
    },
    {
      "span": {
        "start": 22680,
        "end": 22689
      },
      "text": "ཧཱུྃ་སྟེ་ ༼སྣར། པེ།༽ ཧཱུྃ་ད་"
    },
    {
      "span": {
        "start": 22934,
        "end": 22940
      },
      "text": "བསྙམས། ༼སྣར། པེ།༽ བརྙེས།"
    },
    {
      "span": {
        "start": 23444,
        "end": 23448
      },
      "text": "ནོར། ༼སྣར། པེ།༽ དོན།"
    },
    {
      "span": {
        "start": 23505,
        "end": 23509
      },
      "text": "དཔལ། ༼སྣར། པེ།༽ རྒྱལ།"
    },
    {
      "span": {
        "start": 23546,
        "end": 23555
      },
      "text": "བདུད་རྩི་ ༼སྣར། པེ།༽ འདུད་ཅིང་"
    },
    {
      "span": {
        "start": 23830,
        "end": 23841
      },
      "text": "བད་ཛའུ་སྟེ་ ༼སྣར། པེ།༽ བཏྫ་ཧཱུཾ་ཏེ་"
    },
    {
      "span": {
        "start": 24041,
        "end": 24046
      },
      "text": "ད་ནི་ ༼སྣར། པེ།༽ ད་"
    },
    {
      "span": {
        "start": 24092,
        "end": 24105
      },
      "text": "ར་པ་པ་ན་ཙེ་བ་ ༼སྣར། པེ།༽ ར་པ་པཉྩཱ་"
    },
    {
      "span": {
        "start": 24247,
        "end": 24250
      },
      "text": "ཤན་ ༼སྣར། པེ།༽ ཥི་"
    },
    {
      "span": {
        "start": 24311,
        "end": 24324
      },
      "text": "ནུ་ཀན་ཙ་ཀན་ཙ། ༼སྣར། པེ།༽ ནུ་ཀཉྩ་ཀཉྩ།"
    },
    {
      "span": {
        "start": 24450,
        "end": 24456
      },
      "text": "སོ་རུ་ ༼སྣར། པེ།༽ སོ་སུ་"
    },
    {
      "span": {
        "start": 24554,
        "end": 24557
      },
      "text": "ལུ། ༼སྣར། པེ།༽ ལུ། ཧ་རི་ཧ་ར་"
    },
    {
      "span": {
        "start": 24584,
        "end": 24587
      },
      "text": "བི་ ༼ཅོ།༽ ཡི་"
    },
    {
      "span": {
        "start": 24590,
        "end": 24595
      },
      "text": "ར་རུ་ ༼སྣར། པེ།༽ ར་"
    },
    {
      "span": {
        "start": 24676,
        "end": 24686
      },
      "text": "དྲིལ་བུའི་ ༼སྣར། པེ།༽ དྲིལ་བུར་"
    },
    {
      "span": {
        "start": 24716,
        "end": 24719
      },
      "text": "ཀ ། ༼སྣར། པེ།༽ གི། །"
    },
    {
      "span": {
        "start": 25208,
        "end": 25216
      },
      "text": "ལྷ་མོའི་ ༼སྣར། པེ།༽ ལྷའི་"
    },
    {
      "span": {
        "start": 25234,
        "end": 25238
      },
      "text": "རིམ་ ༼སྣར། པེ།༽ རིམ་གྱིས་རིམ་"
    },
    {
      "span": {
        "start": 25454,
        "end": 25459
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 26016,
        "end": 26024
      },
      "text": "བརྡེབ་པ་ ༼སྣར། པེ།༽ བརྡབ་པ་"
    },
    {
      "span": {
        "start": 26365,
        "end": 26367
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནཱ་"
    },
    {
      "span": {
        "start": 26600,
        "end": 26604
      },
      "text": "ཞེས་ ༼སྣར།༽ ཨཱ་ཞེས་"
    },
    {
      "span": {
        "start": 26672,
        "end": 26680
      },
      "text": "བཤད་པའི་ ༼སྣར། པེ།༽ བཤད་པ་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 27102,
        "end": 27107
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 27110,
        "end": 27125
      },
      "text": "དེ་བཞིན་སྦྱར། ། ༼སྣར། པེ།༽ དེ་བཞིན་སྦར་"
    },
    {
      "span": {
        "start": 27128,
        "end": 27135
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 27363,
        "end": 27365
      },
      "text": "ཀ་ ༼སྣར། པེ།༽ ཀཱ་"
    }
  ]
}