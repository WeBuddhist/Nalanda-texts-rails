        "end": 26219
      },
      "text": "ནམ་བུས་ ༼ཅོ།༽ ནོམ་བུས་ ༼སྣར། པེ།༽ ནུམ་"
    },
    {
      "span": {
        "start": 26249,
        "end": 26256
      },
      "text": "བཀྲུ་བ་ ༼སྣར། པེ།༽ དཀྲུ་བ་"
    },
    {
      "span": {
        "start": 26376,
        "end": 26382
      },
      "text": "རགས་པ་ ༼པེ།༽ རག་པ་"
    },
    {
      "span": {
        "start": 26455,
        "end": 26459
      },
      "text": "ནོམ་ ༼པེ།༽ ནུམ་"
    },
    {
      "span": {
        "start": 26516,
        "end": 26524
      },
      "text": "འགྱེད་པ་ ༼སྣར། པེ།༽ འགྱེས་པ་"
    },
    {
      "span": {
        "start": 26848,
        "end": 26860
      },
      "text": "རྟོག་པ་བྱུང་ ༼སྣར།༽ རྟོག་པར་བྱུང་ ༼པེ།༽ རྟོག་པར་འབྱུང་"
    },
    {
      "span": {
        "start": 27049,
        "end": 27055
      },
      "text": "པ་དང་། ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 27088,
        "end": 27096
      },
      "text": "ལས་ཀྱིས་ ༼སྣར། པེ།༽ ལས་ཀྱི་"
    },
    {
      "span": {
        "start": 27249,
        "end": 27259
      },
      "text": "བྲལ་བར་བྱ་ ༼སྣར། པེ།༽ བྲལ་"
    },
    {
      "span": {
        "start": 27293,
        "end": 27302
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 27431,
        "end": 27440
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 27578,
        "end": 27587
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 27608,
        "end": 27617
      },
      "text": "གྲོ་བཞིན་ ༼སྣར། པེ།༽ གྲོ་ཞིན་"
    },
    {
      "span": {
        "start": 27654,
        "end": 27659
      },
      "text": "དྲགས་ ༼སྣར།༽ གྲགས་"
    },
    {
      "span": {
        "start": 27789,
        "end": 27798
      },
      "text": "ཟུང་ཤིག ། ༼སྣར། པེ།༽ གཟུང་ཞིག །"
    },
    {
      "span": {
        "start": 27802,
        "end": 27807
      },
      "text": "རློམ་ ༼སྣར། པེ།༽ རློམས་"
    },
    {
      "span": {
        "start": 27979,
        "end": 27984
      },
      "text": "གྱུར་ ༼སྣར།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 27988,
        "end": 27992
      },
      "text": "ལྷམ་ ༼སྣར།༽ ལྷ་"
    },
    {
      "span": {
        "start": 28154,
        "end": 28158
      },
      "text": "བལྟ། ༼སྣར། པེ།༽ ལྟ།"
    },
    {
      "span": {
        "start": 28230,
        "end": 28236
      },
      "text": "བལྟའོ་ ༼སྣར། པེ།༽ ལྟའོ་"
    },
    {
      "span": {
        "start": 28277,
        "end": 28288
      },
      "text": "གཞོགས་སློང་ ༼སྣར། པེ།༽ གཞོག་སློངས་"
    },
    {
      "span": {
        "start": 28355,
        "end": 28360
      },
      "text": "ཟླ་བ་ ༼སྣར། པེ།༽ ཟླ་"
    },
    {
      "span": {
        "start": 28416,
        "end": 28419
      },
      "text": "ཅི་ ༼སྣར། པེ།༽ ཅིའི་"
    },
    {
      "span": {
        "start": 28774,
        "end": 28779
      },
      "text": "བླངས་ ༼སྣར། པེ།༽ བླང་"
    },
    {
      "span": {
        "start": 29497,
        "end": 29505
      },
      "text": "ཉི་མས་མ་ ༼སྣར། པེ།༽ ཉི་མས་"
    },
    {
      "span": {
        "start": 29894,
        "end": 29901
      },
      "text": "གནོད་པ་ ༼སྣར།༽ ནོད་པ་"
    },
    {
      "span": {
        "start": 30184,
        "end": 30191
      },
      "text": "ཆུང་ཟད་ ༼སྣར། པེ།༽ ཅུང་ཟད་"
    },
    {
      "span": {
        "start": 30191,
        "end": 30198
      },
      "text": "ཆུང་ཟད་ ༼སྣར། པེ།༽ ཅུང་ཟད་"
    },
    {
      "span": {
        "start": 30247,
        "end": 30260
      },
      "text": "སེམས་ཅན་སྲོག་ ༼སྣར། པེ།༽ སེམས་ཅན་"
    },
    {
      "span": {
        "start": 30297,
        "end": 30305
      },
      "text": "སྒོམ་པར་ ༼ཅོ། སྣར།༽ བསྒོམ་པར་"
    },
    {
      "span": {
        "start": 30305,
        "end": 30322
      },
      "text": "བྱེད་པའི་དགེ་བའི་ ༼སྣར། པེ།༽ བྱེད་པའི་"
    },
    {
      "span": {
        "start": 30393,
        "end": 30399
      },
      "text": "བསྒོམ་ ༼པེ།༽ སྒོམ་"
    },
    {
      "span": {
        "start": 30626,
        "end": 30632
      },
      "text": "ད་ལྟར་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 30748,
        "end": 30757
      },
      "text": "འདས་ཀྱིས་ ༼སྣར། པེ།༽ འདས་"
    },
    {
      "span": {
        "start": 30813,
        "end": 30819
      },
      "text": "ད་ལྟར་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 30963,
        "end": 30976
      },
      "text": "འདས་རྣམས་ཀྱི་ ༼སྣར། པེ།༽ འདས་"
    },
    {
      "span": {
        "start": 31316,
        "end": 31324
      },
      "text": "སྒྲིབ་པ་ ༼སྣར། པེ།༽ སྒྲིབས་པ་"
    },
    {
      "span": {
        "start": 31424,
        "end": 31432
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 31794,
        "end": 31797
      },
      "text": "དེ་ ༼སྣར། པེ།༽ སྟེ་"
    },
    {
      "span": {
        "start": 32427,
        "end": 32435
      },
      "text": "བྱི་དོར་ ༼སྣར། པེ།༽ བྱི་"
    },
    {
      "span": {
        "start": 32535,
        "end": 32538
      },
      "text": "ཁས་ ༼སྣར།༽ མཁས་"
    },
    {
      "span": {
        "start": 32582,
        "end": 32591
      },
      "text": "འདས་ཀྱིས་ ༼སྣར། པེ།༽ འདས་ཀྱི་"
    },
    {
      "span": {
        "start": 32828,
        "end": 32836
      },
      "text": "གསོན་པར་ ༼སྣར། པེ།༽ གསོན་པོར་"
    },
    {
      "span": {
        "start": 33004,
        "end": 33012
      },
      "text": "ཙམ་གྱིས་ ༼སྣར། པེ།༽ ཙམ་གྱི་"
    },
    {
      "span": {
        "start": 33068,
        "end": 33073
      },
      "text": "སེམས་ ༼སྣར། པེ།༽ སེམས་པ་"
    },
    {
      "span": {
        "start": 33078,
        "end": 33086
      },
      "text": "བསྲིང་བ་ ༼སྣར། པེ།༽ བསྲིང་བར་"
    },
    {
      "span": {
        "start": 33331,
        "end": 33342
      },
      "text": "དབྱངས་ཀྱིས་ ༼སྣར། པེ།༽ དབྱངས་ཀྱི་"
    },
    {
      "span": {
        "start": 33441,
        "end": 33447
      },
      "text": "གཞིའི་ ༼སྣར།༽ བཞིའི་"
    },
    {
      "span": {
        "start": 33510,
        "end": 33520
      },
      "text": "སྐྱེས་པའི་ ༼སྣར། པེ།༽ སྐྱེས་པ་"
    },
    {
      "span": {
        "start": 33630,
        "end": 33636
      },
      "text": "བའོ། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 33740,
        "end": 33745
      },
      "text": "དེ་ཝ་ ༼སྣར། པེ།༽ དེ་བ་"
    }
  ]
}