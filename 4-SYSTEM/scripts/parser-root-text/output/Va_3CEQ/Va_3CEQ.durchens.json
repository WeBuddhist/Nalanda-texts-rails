    {
      "span": {
        "start": 25861,
        "end": 25869
      },
      "text": "བསྐམས་པ་ ༼སྣར། པེ།༽ སྐམས་པ་"
    },
    {
      "span": {
        "start": 25966,
        "end": 25975
      },
      "text": "ཏི་མུག་ཏ་ ༼སྣར། པེ།༽ ཏི་མུཀྟ་"
    },
    {
      "span": {
        "start": 25998,
        "end": 26005
      },
      "text": "ཟེགས་པ་ ༼སྣར། པེ།༽ གཟེགས་པ་"
