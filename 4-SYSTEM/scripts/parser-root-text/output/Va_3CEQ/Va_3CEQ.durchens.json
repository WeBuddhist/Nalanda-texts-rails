      "span": {
        "start": 21054,
        "end": 21059
      },
      "text": "ཕན་པ་ ༼སྣར། པེ།༽ གནས་པ་"
    },
    {
      "span": {
        "start": 21138,
        "end": 21147
      },
      "text": "མཚང་འདྲུ་ ༼ཅོ།༽ འཚང་འདྲུ་བ་ ༼སྣར།༽ འཚང་འབྲུ་བ་ ༼པེ།༽ འབྲུ་"
    },
    {
      "span": {
        "start": 21164,
        "end": 21172
      },
      "text": "འགྱེད་པ་ ༼སྣར། པེ།༽ འགྱེད་པར་"
    },
    {
      "span": {
        "start": 21346,
        "end": 21350
      },
      "text": "མཚང་ ༼སྣར། པེ།༽ འཚང་"
    },
    {
      "span": {
        "start": 21363,
        "end": 21367
      },
      "text": "མཚང་ ༼སྣར། པེ།༽ འཚང་"
    },
    {
      "span": {
        "start": 21469,
        "end": 21475
      },
      "text": "པ་དང་། ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 21486,
        "end": 21492
      },
      "text": "པ་དང་། ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 21509,
        "end": 21515
      },
      "text": "པ་དང་། ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 21658,
        "end": 21664
      },
      "text": "བྱ་བར་ ༼སྣར། པེ།༽ བྱ་བ་"
