{
  "durchens": [
    {
      "span": {
        "start": 70,
        "end": 76
      },
      "text": "བཤད་པ་ ༼སྣར། པེ།༽ བཤད་པའི་"
    },
    {
      "span": {
        "start": 323,
        "end": 331
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 399,
        "end": 402
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 432,
        "end": 439
      },
      "text": "བཟུང་བ་ ༼སྣར། པེ།༽ གཟུང་བ་"
    },
    {
      "span": {
        "start": 552,
        "end": 561
      },
      "text": "དེ་ནི་དེ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 694,
        "end": 700
      },
      "text": "སྒྱུར་ ༼སྣར།༽ བསྒྱུར་"
    },
    {
      "span": {
        "start": 1096,
        "end": 1102
      },
      "text": "རྫོགས་ ༼པེ།༽ རྫོགས་པའི་བྱང་ཆུབ་མངོན་པར་རྫོགས་"
    },
    {
      "span": {
        "start": 1362,
        "end": 1370
      },
      "text": "ལམ་ཐུགས་ ༼ཅོ།༽ ཐུགས་"
    },
    {
      "span": {
        "start": 1570,
        "end": 1579
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 1582,
        "end": 1586
      },
      "text": "གིས་ ༼སྣར། པེ།༽ གི་"
    },
    {
      "span": {
        "start": 1593,
        "end": 1600
      },
      "text": "བྱ་བའོ་ ༼སྣར། པེ།༽ བྱའོ་"
    },
    {
      "span": {
        "start": 1672,
        "end": 1677
      },
      "text": "བསྟན་ ༼སྣར། པེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 1775,
        "end": 1782
      },
      "text": "རྟེན་པ་ ༼སྣར།༽ བདེན་པ་ ༼པེ།༽ བརྟེན་པ་"
    },
    {
      "span": {
        "start": 1981,
        "end": 1990
      },
      "text": "བསྟན་པའོ་ ༼སྣར། པེ།༽ བརྟན་པའོ་"
    },
    {
      "span": {
        "start": 2060,
        "end": 2068
      },
      "text": "རིགས་པར་ ༼སྣར།༽ རིག་པར་"
    },
    {
      "span": {
        "start": 2470,
        "end": 2478
      },
      "text": "འགྲོ་དེ། ༼སྣར། པེ།༽ འགྲོ་སྟེ།"
    },
    {
      "span": {
        "start": 2557,
        "end": 2561
      },
      "text": "བཞག་ ༼སྣར། པེ།༽ གཞག་"
    },
    {
      "span": {
        "start": 3077,
        "end": 3085
      },
      "text": "མིག་གིས་ ༼སྣར། པེ།༽ མིག་གི་"
    },
    {
      "span": {
        "start": 3125,
        "end": 3135
      },
      "text": "བྲམ་ཟེ་འམ་ ༼སྣར། པེ།༽ བྲམ་ཟེ་ཟེ་"
    },
    {
      "span": {
        "start": 3149,
        "end": 3158
      },
      "text": "འདོད་ཀྱི་ ༼པེ།༽ འདོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 3618,
        "end": 3623
      },
      "text": "བསྟན་ ༼སྣར།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 4648,
        "end": 4654
      },
      "text": "སྦྱིན་ ༼སྣར། པེ།༽ བྱིན་"
    },
    {
      "span": {
        "start": 4728,
        "end": 4732
      },
      "text": "གཞི་ ༼སྣར།༽ བཞི་"
    },
    {
      "span": {
        "start": 4797,
        "end": 4800
      },
      "text": "དང་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 5184,
        "end": 5197
      },
      "text": "འདོད་ཆགས་ཀྱི་ ༼པེ།༽ འདོད་ཆགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 5462,
        "end": 5468
      },
      "text": "ཆུ་བོ་ ༼སྣར། པེ།༽ ཆུ་"
    },
    {
      "span": {
        "start": 5545,
        "end": 5554
      },
      "text": "འཁྲུགས་པ་ ༼སྣར། པེ།༽ འཁྲུག་པ་"
    },
    {
      "span": {
        "start": 5565,
        "end": 5572
      },
      "text": "གྲུ་བུ་ ༼སྣར། པེ།༽ དྲུ་བུ་"
    },
    {
      "span": {
        "start": 5797,
        "end": 5809
      },
      "text": "སྡུག་བསྔལ་བ་ ༼པེ།༽ སྡུག་བསྔལ་"
    },
    {
      "span": {
        "start": 5812,
        "end": 5818
      },
      "text": "བཟད་པ་ ༼པེ།༽ ཟད་པ་"
    },
    {
      "span": {
        "start": 6556,
        "end": 6562
      },
      "text": "སྤང་བ་ ༼སྣར། པེ།༽ སྤོང་བ་"
    },
    {
      "span": {
        "start": 6732,
        "end": 6738
      },
      "text": "གསལ་བ་ ༼ཅོ།༽ གསོལ་བར་ ༼སྣར། པེ།༽ བསལ་བ་"
    },
    {
      "span": {
        "start": 6917,
        "end": 6922
      },
      "text": "བརྟན་ ༼སྣར། པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 7699,
        "end": 7707
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 7729,
        "end": 7735
      },
      "text": "དེ་དེ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 7751,
        "end": 7757
      },
      "text": "གཞག་པ་ ༼སྣར། པེ།༽ བཞག་པ་"
    },
    {
      "span": {
        "start": 8052,
        "end": 8057
      },
      "text": "འབྲི་ ༼སྣར། པེ།༽ འབྲིང་"
    },
    {
      "span": {
        "start": 8354,
        "end": 8362
      },
      "text": "དཔྱོད་པ་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 8449,
        "end": 8460
      },
      "text": "དཔྱོད་པ་དང་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 8521,
        "end": 8529
      },
      "text": "དུས་བྱས་ ༼སྣར། པེ།༽ འདུས་བྱས་"
    },
    {
      "span": {
        "start": 8619,
        "end": 8628
      },
      "text": "དཀྲུགས་པ་ ༼སྣར། པེ།༽ དཀྲུག་པ་"
    },
    {
      "span": {
        "start": 8680,
        "end": 8687
      },
      "text": "གང་ཡིན་ ༼སྣར། པེ།༽ གང་ཡིན་པ་"
    },
    {
      "span": {
        "start": 8884,
        "end": 8891
      },
      "text": "ཤེས་བར་ ༼སྣར། པེ།༽ ཤེས་རབ་"
    },
    {
      "span": {
        "start": 9342,
        "end": 9352
      },
      "text": "ཀྱིས་ཐོགས་ ༼སྣར། པེ།༽ ཀྱི་ཐོག་"
    },
    {
      "span": {
        "start": 9764,
        "end": 9773
      },
      "text": "ལུས་ཀྱིས་ ༼སྣར། པེ།༽ ལུས་ཀྱི་"
    },
    {
      "span": {
        "start": 9777,
        "end": 9784
      },
      "text": "བསྒྱུར་ ༼སྣར། པེ།༽ སྒྱུར་"
    },
    {
      "span": {
        "start": 10147,
        "end": 10155
      },
      "text": "བསྡམས་པ་ ༼སྣར། པེ།༽ བསྡམ་པ་"
    },
    {
      "span": {
        "start": 10783,
        "end": 10787
      },
      "text": "གཞག་ ༼སྣར། པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 11168,
        "end": 11171
      },
      "text": "ཟབ་ ༼སྣར། པེ།༽ ཟབས་"
    },
    {
      "span": {
        "start": 11194,
        "end": 11197
      },
      "text": "སྲ་ ༼སྣར། པེ།༽ བསྲ་"
    },
    {
      "span": {
        "start": 11240,
        "end": 11246
      },
      "text": "ཆགས་པ་ ༼སྣར། པེ།༽ འཆགས་པ་"
    },
    {
      "span": {
        "start": 11246,
        "end": 11253
      },
      "text": "ཡིན་ནོ་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 11338,
        "end": 11351
      },
      "text": "རྡུལ་མེད་མེད་ ༼སྣར། པེ།༽ རྡུལ་མེད་"
    },
    {
      "span": {
        "start": 11394,
        "end": 11403
      },
      "text": "ཆོས་ཀྱིས་ ༼སྣར།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 12010,
        "end": 12013
      },
      "text": "གོ་ ༼སྣར། པེ།༽ སྒོ་"
    },
    {
      "span": {
        "start": 12145,
        "end": 12150
      },
      "text": "བླ་མ་ ༼པེ།༽ བླ་"
    },
    {
      "span": {
        "start": 12173,
        "end": 12181
      },
      "text": "མེད་པ་ལ་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 12321,
        "end": 12329
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 12525,
        "end": 12533
      },
      "text": "མོང་པོས་ ༼སྣར། པེ།༽ མང་པོས་"
    },
    {
      "span": {
        "start": 12726,
        "end": 12734
      },
      "text": "ཞིབ་མོས་ ༼སྣར། པེ།༽ ཞིབ་མོ་"
    },
    {
      "span": {
        "start": 12755,
        "end": 12763
      },
      "text": "མཛངས་པས་ ༼པེ།༽ འཛངས་པས་"
    },
    {
      "span": {
        "start": 12983,
        "end": 12987
      },
      "text": "བདེ་ ༼སྣར།༽ བདེ་བྱིད་"
    },
    {
      "span": {
        "start": 13117,
        "end": 13124
      },
      "text": "བཀུར་བ་ ༼སྣར། པེ།༽ བསྐུར་བ་"
    },
    {
      "span": {
        "start": 13132,
        "end": 13140
      },
      "text": "བཅད་པའི་ ༼སྣར། པེ།༽ གཅད་པའི་"
    },
    {
      "span": {
        "start": 13311,
        "end": 13320
      },
      "text": "གཟུང་བའི་ ༼སྣར། པེ།༽ བཟུང་བའི་"
    },
    {
      "span": {
        "start": 13370,
        "end": 13379
      },
      "text": "ཕྱིར་སྟེ་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 13566,
        "end": 13571
      },
      "text": "ཟག་པ་ ༼པེ།༽ ཟག་"
    },
    {
      "span": {
        "start": 13598,
        "end": 13605
      },
      "text": "འགགས་པ་ ༼སྣར། པེ།༽ འགག་པ་"
    },
    {
      "span": {
        "start": 13835,
        "end": 13841
      },
      "text": "སྒོམས་ ༼སྣར། པེ།༽ བསྒོམས་"
    },
    {
      "span": {
        "start": 14232,
        "end": 14237
      },
      "text": "གཤོལ་ ༼སྣར། པེ།༽ བཤོལ་"
    },
    {
      "span": {
        "start": 14316,
        "end": 14324
      },
      "text": "གཅོད་པར་ ༼སྣར། པེ།༽ སྤྱོད་པར་"
    },
    {
      "span": {
        "start": 14403,
        "end": 14409
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 14511,
        "end": 14519
      },
      "text": "ཞིག་གིས་ ༼སྣར།༽ ཞིག་ ༼པེ།༽ ཞིག་གི་"
    },
    {
      "span": {
        "start": 14547,
        "end": 14555
      },
      "text": "མང་བ་ཤས་ ༼ཅོ།༽ ཞིག་ ༼སྣར།༽ མང་བ་ཤེས་"
    },
    {
      "span": {
        "start": 14654,
        "end": 14660
      },
      "text": "བསྟེན་ ༼པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 14737,
        "end": 14741
      },
      "text": "ཐོག་ ༼སྣར། པེ།༽ ཐོགས་"
    },
    {
      "span": {
        "start": 14748,
        "end": 14754
      },
      "text": "དོག་པ་ ༼སྣར། པེ།༽ དོགས་པ་"
    },
    {
      "span": {
        "start": 14816,
        "end": 14821
      },
      "text": "བརྟན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 14904,
        "end": 14918
      },
      "text": "འབྱུང་བ་ཡིན་པ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 14955,
        "end": 14961
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 15032,
        "end": 15038
      },
      "text": "དེ་དག་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 15311,
        "end": 15320
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 15501,
        "end": 15513
      },
      "text": "འདུ་ཤེས་ཀྱང་ ༼སྣར། པེ།༽ འདུ་ཤེས་"
    },
    {
      "span": {
        "start": 15634,
        "end": 15637
      },
      "text": "བབ་ ༼སྣར། པེ།༽ འབབ་"
    },
    {
      "span": {
        "start": 15810,
        "end": 15819
      },
      "text": "ཡོགས་པའི་ ༼སྣར། པེ།༽ ཡོག་པའི་"
    },
    {
      "span": {
        "start": 15832,
        "end": 15840
      },
      "text": "འོད་ཀྱི་ ༼སྣར། པེ།༽ འོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 15946,
        "end": 15956
      },
      "text": "སྒྱུར་བའི་ ༼སྣར།༽ བསྒྱུར་བའི་"
    },
    {
      "span": {
        "start": 16095,
        "end": 16100
      },
      "text": "བསྟན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 16756,
        "end": 16764
      },
      "text": "སྐྱེད་པ་ ༼སྣར། པེ།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 16905,
        "end": 16914
      },
      "text": "བརྩེ་བའི་ ༼སྣར།༽ རྩེ་བའི་"
    },
    {
      "span": {
        "start": 16941,
        "end": 16945
      },
      "text": "སྟི་ ༼པེ།༽ བསྟི་"
    },
    {
      "span": {
        "start": 16967,
        "end": 16974
      },
      "text": "རྟེན་པ་ ༼སྣར། པེ།༽ བརྟེན་པ་"
    },
    {
      "span": {
        "start": 17136,
        "end": 17143
      },
      "text": "མཉན་པར་ ༼སྣར། པེ།༽ ཉན་པར་"
    },
    {
      "span": {
        "start": 17183,
        "end": 17190
      },
      "text": "མཉན་པར་ ༼སྣར། པེ།༽ ཉན་པར་"
    },
    {
      "span": {
        "start": 17209,
        "end": 17216
      },
      "text": "མཉན་པར་ ༼སྣར། པེ།༽ ཉན་པར་"
    },
    {
      "span": {
        "start": 17273,
        "end": 17280
      },
      "text": "བསྒོ་བ་ ༼སྣར། པེ།༽ སྒོ་བ་"
    },
    {
      "span": {
        "start": 17306,
        "end": 17312
      },
      "text": "ཚོལ་བ་ ༼སྣར། པེ།༽ འཚོལ་བ་"
    },
    {
      "span": {
        "start": 17791,
        "end": 17797
      },
      "text": "འོས་པ་ ༼སྣར།༽ འདོད་པ་"
    },
    {
      "span": {
        "start": 17805,
        "end": 17812
      },
      "text": "རྟེན་པ་ ༼སྣར། པེ།༽ བརྟེན་པ་"
    },
    {
      "span": {
        "start": 17846,
        "end": 17854
      },
      "text": "གཏུགས་པ་ ༼སྣར། པེ།༽ གཏུགས་"
    },
    {
      "span": {
        "start": 18215,
        "end": 18222
      },
      "text": "ཡོད་པར་ ༼སྣར། པེ།༽ མཆོད་པར་"
    },
    {
      "span": {
        "start": 18280,
        "end": 18292
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 18304,
        "end": 18311
      },
      "text": "མཉན་པར་ ༼སྣར། པེ།༽ ཉན་པར་"
    },
    {
      "span": {
        "start": 18370,
        "end": 18378
      },
      "text": "དྲིས་པས་ ༼སྣར། པེ།༽ དྲིས་པ་"
    },
    {
      "span": {
        "start": 18407,
        "end": 18414
      },
      "text": "རིགས་པ་ ༼སྣར།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 18483,
        "end": 18489
      },
      "text": "འཚམ་པ་ ༼སྣར། པེ།༽ འཚམས་པ་"
    },
    {
      "span": {
        "start": 18506,
        "end": 18510
      },
      "text": "རྟག་ ༼སྣར། པེ།༽ རྟགས་"
    },
    {
      "span": {
        "start": 18539,
        "end": 18549
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 18608,
        "end": 18613
      },
      "text": "བྱ་ན། ༼སྣར། པེ།༽ བྱ་སྟེ།"
    },
    {
      "span": {
        "start": 18740,
        "end": 18748
      },
      "text": "འཆབ་པའི་ ༼སྣར། པེ།༽ འཐབ་པའི་"
    },
    {
      "span": {
        "start": 19412,
        "end": 19424
      },
      "text": "དགེ་སློང་དག་ ༼སྣར། པེ།༽ དགེ་སློང་"
    },
    {
      "span": {
        "start": 19439,
        "end": 19446
      },
      "text": "སྤང་བར་ ༼སྣར། པེ།༽ སྤངས་པར་"
    },
    {
      "span": {
        "start": 19683,
        "end": 19692
      },
      "text": "སྤོངས་པས་ ༼སྣར། པེ།༽ སྤངས་པས་"
    },
    {
      "span": {
        "start": 19782,
        "end": 19792
      },
      "text": "ཤིག་ཅེས་ང་ ༼སྣར། པེ།༽ ཤིག་ཅེས་"
    },
    {
      "span": {
        "start": 20000,
        "end": 20010
      },
      "text": "བཟུང་ཤིག ། ༼སྣར། པེ།༽ གཟུང་ཞིག །"
    },
    {
      "span": {
        "start": 20016,
        "end": 20025
      },
      "text": "ལ་ཚད་ཀྱང་ ༼སྣར། པེ།༽ ལ་ཚད་"
    },
    {
      "span": {
        "start": 20056,
        "end": 20066
      },
      "text": "གང་ཟག་གིས་ ༼སྣར། པེ།༽ གང་ཟག་གི་"
    },
    {
      "span": {
        "start": 20221,
        "end": 20229
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 20286,
        "end": 20294
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 20507,
        "end": 20509
      },
      "text": "ལ་ ༼སྣར། པེ།༽ དང་"
