{
  "durchens": [
    {
      "span": {
        "start": 36,
        "end": 39
      },
      "text": "སུ་ ༼སྣར། པེ།༽ སཱུ་"
    },
    {
      "span": {
        "start": 389,
        "end": 394
      },
      "text": "འདུལ་ ༼སྣར། པེ།༽ དུལ་"
    },
    {
      "span": {
        "start": 835,
        "end": 846
      },
      "text": "ནན་ཏན་གཅེས་ ༼སྣར། པེ།༽ ནན་ཏན་ཅེས་"
    },
    {
      "span": {
        "start": 983,
        "end": 988
      },
      "text": "སྤངས་ ༼པེ།༽ སྤང་"
    },
    {
      "span": {
        "start": 1035,
        "end": 1038
      },
      "text": "བྱ། ༼སྣར། པེ།༽ གནས།"
    },
    {
      "span": {
        "start": 1060,
        "end": 1066
      },
      "text": "སྦྱངས། ༼སྣར། པེ།༽ སྦྱང་།"
    },
    {
      "span": {
        "start": 1184,
        "end": 1190
      },
      "text": "བཟུང་། ༼སྣར། པེ།༽ གཟུང་།"
    },
    {
      "span": {
        "start": 1231,
        "end": 1236
      },
      "text": "འགྲོ་ ༼སྣར། པེ།༽ གྲོགས་"
    },
    {
      "span": {
        "start": 1335,
        "end": 1337
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 1482,
        "end": 1488
      },
      "text": "གསད་པ་ ༼པེ།༽ བསད་པ་"
    },
    {
      "span": {
        "start": 1706,
        "end": 1712
      },
      "text": "བཟུང་། ༼སྣར། པེ།༽ གཟུང་།"
    },
    {
      "span": {
        "start": 1761,
        "end": 1769
      },
      "text": "དུས་ཤེས་ ༼སྣར། པེ།༽ འདུ་ཤེས་"
    },
    {
      "span": {
        "start": 1905,
        "end": 1913
      },
      "text": "ཆོག་ཤེས་ ༼པེ།༽ མཆོག་ཤེས་"
    },
    {
      "span": {
        "start": 1959,
        "end": 1965
      },
      "text": "གཞོགས་ ༼སྣར། པེ།༽ གཞོག་"
    },
    {
      "span": {
        "start": 2047,
        "end": 2058
      },
      "text": "ཁས་ལེན་དཔའ་ ༼སྣར། པེ།༽ ཁས་ལེན་པ་"
    },
    {
      "span": {
        "start": 2207,
        "end": 2214
      },
      "text": "ཞེན་པར་ ༼སྣར། པེ།༽ ཞེན་པས་"
    },
    {
      "span": {
        "start": 2298,
        "end": 2301
      },
      "text": "ལས་ ༼སྣར།༽ ལག་"
    },
    {
      "span": {
        "start": 2497,
        "end": 2501
      },
      "text": "ཁེང་ ༼སྣར། པེ།༽ ཁེངས་"
    },
    {
      "span": {
        "start": 2513,
        "end": 2518
      },
      "text": "སྤང་། ༼སྣར། པེ།༽ སྤངས།"
    },
    {
      "span": {
        "start": 2567,
        "end": 2574
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ གྱུར་པས་"
    },
    {
      "span": {
        "start": 2740,
        "end": 2750
      },
      "text": "བཀུར་སྟིས་ ༼སྣར། པེ།༽ བཀུར་སྟི་"
    },
    {
      "span": {
        "start": 3074,
        "end": 3079
      },
      "text": "སྦྱང་ ༼སྣར། པེ།༽ སྦྱངས་"
    },
    {
      "span": {
        "start": 3088,
        "end": 3094
      },
      "text": "གཟུང་། ༼སྣར། པེ།༽ བཟུང་།"
    },
    {
      "span": {
        "start": 3415,
        "end": 3421
      },
      "text": "སྐོམས། ༼སྣར།༽ སྒོམས།"
    },
    {
      "span": {
        "start": 3472,
        "end": 3481
      },
      "text": "གཞིལ་སྟེ། ༼སྣར། པེ།༽ གཞིལ་ཏེ།"
    },
    {
      "span": {
        "start": 3525,
        "end": 3531
      },
      "text": "སྦྱོང་ ༼སྣར། པེ།༽ སྦྱོངས་"
    },
    {
      "span": {
        "start": 3565,
        "end": 3570
      },
      "text": "འཐོབ་ ༼སྣར། པེ།༽ ཐོབ་"
    },
    {
      "span": {
        "start": 3597,
        "end": 3604
      },
      "text": "སྒྲུབས། ༼སྣར། པེ།༽ བསྒྲུབས།"
    }
  ]
}