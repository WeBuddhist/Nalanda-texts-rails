{
  "durchens": [
    {
      "span": {
        "start": 99,
        "end": 104
      },
      "text": "བཏུས་ ༼སྣར། པེ།༽ བསྡུས་"
    },
    {
      "span": {
        "start": 416,
        "end": 422
      },
      "text": "གཟུང་། ༼སྣར།༽ བཟུང་།"
    },
    {
      "span": {
        "start": 452,
        "end": 457
      },
      "text": "བརྩམ། ༼སྣར། པེ།༽ བཙམ།"
    },
    {
      "span": {
        "start": 613,
        "end": 620
      },
      "text": "རས་རིས་ ༼སྣར། པེ།༽ རས་བྲིས་"
    },
    {
      "span": {
        "start": 1081,
        "end": 1087
      },
      "text": "བཀླག ། ༼པེ།༽ བརླག །"
    },
    {
      "span": {
        "start": 1158,
        "end": 1166
      },
      "text": "བཀླག་པར་ ༼སྣར། པེ།༽ བརླག་པར་"
    },
    {
      "span": {
        "start": 1557,
        "end": 1568
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱིས་"
    },
    {
      "span": {
        "start": 1573,
        "end": 1582
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 1695,
        "end": 1703
      },
      "text": "དེ་བཞིན་ ༼སྡེ།༽ དེ་"
    },
    {
      "span": {
        "start": 2271,
        "end": 2276
      },
      "text": "བསུང་ ༼པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 2398,
        "end": 2402
      },
      "text": "བདལ་ ༼སྣར། པེ།༽ གདལ་"
    },
    {
      "span": {
        "start": 2689,
        "end": 2695
      },
      "text": "དཔྱངས་ ༼སྣར། པེ།༽ སྤྱངས་"
    },
    {
      "span": {
        "start": 3209,
        "end": 3220
      },
      "text": "བསྒྱུར་བའི་ ༼སྣར། པེ།༽ སྒྱུར་བའི་"
    },
    {
      "span": {
        "start": 3489,
        "end": 3495
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 4495,
        "end": 4502
      },
      "text": "ལ་སོགས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 4601,
        "end": 4606
      },
      "text": "བཞུག་ ༼སྣར། པེ།༽ བཞུགས་"
    },
    {
      "span": {
        "start": 4993,
        "end": 4997
      },
      "text": "ཀྱང་ ༼སྣར། པེ།༽ ཀྱང་གདན་"
    },
    {
      "span": {
        "start": 5080,
        "end": 5087
      },
      "text": "བཟླས་ལ། ༼སྡེ། ཅོ།༽ བཟླས།"
    },
    {
      "span": {
        "start": 5167,
        "end": 5176
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 5395,
        "end": 5401
      },
      "text": "བཙུགས་ ༼པེ།༽ གཙུགས་"
    },
    {
      "span": {
        "start": 5489,
        "end": 5501
      },
      "text": "ཡོངས་བསྒྲགས་ ༼སྣར།༽ སྒྲགས་ ༼པེ།༽ ཡོངས་སུ་སྒྲགས་"
    },
    {
      "span": {
        "start": 5642,
        "end": 5647
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 5974,
        "end": 5980
      },
      "text": "བཞུགས་ ༼པེ།༽ ཞུགས་"
    },
    {
      "span": {
        "start": 6500,
        "end": 6504
      },
      "text": "བཟང་ ༼པེ།༽ བཟང་པོ་"
    },
    {
      "span": {
        "start": 6531,
        "end": 6540
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 6576,
        "end": 6579
      },
      "text": "གེ་ ༼སྣར། པེ།༽ གེ་མོ་"
    },
    {
      "span": {
        "start": 6601,
        "end": 6611
      },
      "text": "བསྐྱབ་པའི་ ༼སྣར།༽ བསྐྱབས་པའི་ ༼པེ།༽ སྐྱབས་"
    },
    {
      "span": {
        "start": 6755,
        "end": 6770
      },
      "text": "བྱིན་གྱིས་བརླབ་ ༼སྣར། པེ།༽ བྱིན་བརླབས་"
    },
    {
      "span": {
        "start": 6782,
        "end": 6788
      },
      "text": "ད་ལྟར་ ༼སྡེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 6788,
        "end": 6798
      },
      "text": "བདག་ཅག་གི་ ༼སྣར། པེ།༽ བདག་ཅག་གིས་"
    },
    {
      "span": {
        "start": 7227,
        "end": 7237
      },
      "text": "བསྐྱབ་པའི་ ༼སྣར།༽ སྐྱབ་ ༼པེ།༽ སྐྱོབ་པའི་"
    },
    {
      "span": {
        "start": 7388,
        "end": 7396
      },
      "text": "བརླབ་པར་ ༼སྣར།༽ བརླབས་པར་"
    },
    {
      "span": {
        "start": 7727,
        "end": 7737
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 7794,
        "end": 7804
      },
      "text": "བསྐྱབ་པའི་ ༼པེ།༽ བསྐྱབས་པའི་"
    },
    {
      "span": {
        "start": 8062,
        "end": 8073
      },
      "text": "མདོངས་གསོལ་ ༼སྣར།༽ གདོང་བསོལ་ ༼པེ།༽ གདོང་གསོལ་"
    },
    {
      "span": {
        "start": 8304,
        "end": 8309
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 8931,
        "end": 8935
      },
      "text": "ཆེན་ ༼སྡེ།༽ ཆེན་པོ་སྨྲ་འཛིན་དང་། གནོད་སྦྱིན་གྱི་སྡེ་དཔོན་ཆེན་"
    },
    {
      "span": {
        "start": 9689,
        "end": 9698
      },
      "text": "དྲངས་པའི་ ༼སྣར། པེ།༽ དྲང་བའི་"
    },
    {
      "span": {
        "start": 9903,
        "end": 9909
      },
      "text": "འབྱུང་ ༼སྣར། པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 10270,
        "end": 10277
      },
      "text": "རང་གིས་ ༼སྣར། པེ།༽ རང་གི་"
    },
    {
      "span": {
        "start": 10390,
        "end": 10399
      },
      "text": "བསམས་པའི་ ༼སྣར། པེ།༽ བསམ་པའི་"
    },
    {
      "span": {
        "start": 11048,
        "end": 11053
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 11099,
        "end": 11108
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་དཔའི་"
    },
    {
      "span": {
        "start": 11405,
        "end": 11412
      },
      "text": "བསྒྲགས་ ༼པེ།༽ སྒྲགས་"
    },
    {
      "span": {
        "start": 12862,
        "end": 12866
      },
      "text": "མཐའ་ ༼སྣར། པེ།༽ མཐས་"
    },
    {
      "span": {
        "start": 12938,
        "end": 12948
      },
      "text": "བདག་ཅག་གི་ ༼སྣར། པེ།༽ བདག་ཅག་གིས་"
    },
    {
      "span": {
        "start": 12952,
        "end": 12956
      },
      "text": "མ་མ་ ༼སྣར། པེ།༽ མ་"
    },
    {
      "span": {
        "start": 13079,
        "end": 13085
      },
      "text": "ལས་ནི་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 13409,
        "end": 13415
      },
      "text": "ལས་མི་ ༼སྡེ།༽ ལས་"
    },
    {
      "span": {
        "start": 13464,
        "end": 13472
      },
      "text": "གསོལ་བར་ ༼སྣར། པེ།༽ གསོལ་བ་"
    },
    {
      "span": {
        "start": 13971,
        "end": 13975
      },
      "text": "བཏབ་ ༼སྣར། པེ།༽ བརླབ་"
    },
    {
      "span": {
        "start": 14231,
        "end": 14240
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 14618,
        "end": 14637
      },
      "text": "མདོ་སྡེ་དང་མདོ་སྡེ་ ༼སྣར། པེ།༽ མདོ་སྡེ་"
    },
    {
      "span": {
        "start": 15475,
        "end": 15480
      },
      "text": "ཡོངས་ ༼སྣར།༽ ཡོངས་སུ་"
    },
    {
      "span": {
        "start": 15576,
        "end": 15583
      },
      "text": "པ་འབུལ། ༼སྣར། པེ།༽ པ་དབུལ་"
    },
    {
      "span": {
        "start": 15948,
        "end": 15953
      },
      "text": "གཤེད་ ༼སྣར། པེ།༽ བཤེད་"
    },
    {
      "span": {
        "start": 17725,
        "end": 17979
      },
      "text": "རབ་ཏུ་ཞི་བར་གྱུར་ཅིག ་བདག་ཅག་ལ་སོགས་པ་སེམས་ཅན་གང་དག་མགོན་མེད་པར་གྱུར་པ་ལུས་ལ་གདུང་བའི་མེ་འབར་བ་དང་། སེང་གེ་དང་། སྟག་དང་། དོམ་དང་། དྲེད་དང་། སྦྲུལ་གདུག་པའི་ནང་དུ་ཆུད་དེ། སྲོག་ལ་བབ་ཅིང་ཉམ་ཐག་པ་དེ་དག་བྱང་ཆུབ་ཀྱི་མཐར་ཐུག་གི་བར་དུ་ལུས་ལ་གདུང་བའི་མེ་ཐམས་ཅད་རབ་ ༼སྡེ།༽ རབ་"
    },
    {
      "span": {
        "start": 17988,
        "end": 17997
      },
      "text": "གྱུར་ཅིག་ ༼སྡེ།༽ གྱུར་ཅིག"
    },
    {
      "span": {
        "start": 18444,
        "end": 18452
      },
      "text": "ཕྱིན་ནས་ ༼སྣར། པེ།༽ ཕྱིན་པ་"
    },
    {
      "span": {
        "start": 18727,
        "end": 18732
      },
      "text": "ལེགས་ ༼སྣར།༽ ལེགས་པ་ ༼པེ།༽ ལེགས་པར་"
    },
    {
      "span": {
        "start": 19912,
        "end": 19922
      },
      "text": "འཁྱམས་ཤིང་ ༼སྣར། པེ།༽ འཁྱམ་ཞིང་"
    },
    {
      "span": {
        "start": 20307,
        "end": 20315
      },
      "text": "རྣམས་ནི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 20419,
        "end": 20430
      },
      "text": "ལ་སོགས་པའི་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 20497,
        "end": 20499
      },
      "text": "པ་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 20632,
        "end": 20645
      },
      "text": "ལས་ཀྱི་སྒྲིབ་ ༼སྣར།༽ ལས་ཀྱི་སྒྲིབས་ ༼པེ།༽ ལས་སྒྲིབ་"
    },
    {
      "span": {
        "start": 20995,
        "end": 21020
      },
      "text": "ཐམས་ཅད་ཀྱི་སྡུག་བསྔལ་ཐམས་ ༼པེ།༽ ཐམས་"
    },
    {
      "span": {
        "start": 21052,
        "end": 21055
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 21497,
        "end": 21504
      },
      "text": "མཚན་མོ་ ༼སྣར། པེ།༽ མཚན་མོ་མུན་པ་"
    },
    {
      "span": {
        "start": 22397,
        "end": 22407
      },
      "text": "རྒྱབ་ཀྱིས་ ༼སྣར། པེ།༽ རྒྱབ་ཀྱི་"
    },
    {
      "span": {
        "start": 22544,
        "end": 22551
      },
      "text": "རང་སངས་ ༼སྣར། པེ།༽ སངས་"
    },
    {
      "span": {
        "start": 22714,
        "end": 22735
      },
      "text": "ཀུན་དུ་འབར་ཞིང་རབ་ཏུ་ ༼སྣར། པེ།༽ ཀུན་དུ་"
    },
    {
      "span": {
        "start": 22857,
        "end": 22867
      },
      "text": "སྡུག་བསྔལ་ ༼སྣར། པེ།༽ སྡུག་བསྔལ་བ་"
    },
    {
      "span": {
        "start": 22876,
        "end": 22879
      },
      "text": "ལས་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 23015,
        "end": 23023
      },
      "text": "བརྒྱན་པ་ ༼སྣར། པེ།༽ རྒྱན་པ་"
    },
    {
      "span": {
        "start": 23297,
        "end": 23307
      },
      "text": "གཟི་བརྗིད་ ༼སྣར། པེ།༽ གཟི་བརྗིད་ཀྱི་"
    },
    {
      "span": {
        "start": 23570,
        "end": 23575
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 23779,
        "end": 23784
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 23920,
        "end": 23925
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 24060,
        "end": 24067
      },
      "text": "ལས་ཀྱི་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 24325,
        "end": 24329
      },
      "text": "འཆི་ ༼སྣར། པེ།༽ འཆི་བའི་"
    },
    {
      "span": {
        "start": 24432,
        "end": 24437
      },
      "text": "རྐུས་ ༼སྣར། པེ།༽ བརྐུས་"
    },
    {
      "span": {
        "start": 24554,
        "end": 24559
      },
      "text": "འཕྲལ་ ༼སྣར། པེ།༽ ཕྲལ་"
    },
    {
      "span": {
        "start": 25021,
        "end": 25026
      },
      "text": "ལོངས་ ༼སྣར།༽ ལོང་"
    },
    {
      "span": {
        "start": 25083,
        "end": 25091
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 25119,
        "end": 25127
      },
      "text": "སྒྲིབ་པ་ ༼སྣར། པེ།༽ བསྒྲིབ་པ་"
    },
    {
      "span": {
        "start": 25486,
        "end": 25492
      },
      "text": "གརྦྦེ། ༼སྣར། པེ།༽ གརྦྷེ།"
    },
    {
      "span": {
        "start": 25537,
        "end": 25540
      },
      "text": "སེ། ༼སྣར། པེ།༽ སི།"
    },
    {
      "span": {
        "start": 25550,
        "end": 25553
      },
      "text": "སེ། ༼སྣར། པེ།༽ སི།"
    },
    {
      "span": {
        "start": 25632,
        "end": 25639
      },
      "text": "སརྦ་ཏྲ་ ༼སྣར། པེ།༽ སརྦ་"
    },
    {
      "span": {
        "start": 25688,
        "end": 25692
      },
      "text": "ཧ་ཏ་ ༼སྣར། པེ།༽ ཧ་ཏེ་"
    },
    {
      "span": {
        "start": 25791,
        "end": 25796
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 26048,
        "end": 26055
      },
      "text": "རྣམས་ལ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 26204,
        "end": 26209
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 26377,
        "end": 26382
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 26450,
        "end": 26455
      },
      "text": "འཕོས་ ༼སྣར།༽ ཕོས་"
    },
    {
      "span": {
        "start": 26483,
        "end": 26488
      },
      "text": "བཟངས་ ༼སྣར།༽ བཟང་"
    },
    {
      "span": {
        "start": 26705,
        "end": 26710
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 27889,
        "end": 27896
      },
      "text": "མཐོང་བ་ ༼སྣར། པེ།༽ མཐོང་བར་"
    },
    {
      "span": {
        "start": 28288,
        "end": 28293
      },
      "text": "རྒྱན་ ༼སྣར། པེ།༽ བརྒྱན་"
    },
    {
      "span": {
        "start": 28994,
        "end": 29011
      },
      "text": "རྫུས་ཏེ་སྐྱེ་ཞིང་ ༼པེ།༽ རྫུས་ཏེ་"
    },
    {
      "span": {
        "start": 29540,
        "end": 29550
      },
      "text": "དབྱངས་ཀྱི་ ༼སྣར། པེ།༽ དབྱངས་ཀྱིས་"
    },
    {
      "span": {
        "start": 29649,
        "end": 29656
      },
      "text": "བསྒྲགས་ ༼སྣར།༽ སྒྲག་"
    },
    {
      "span": {
        "start": 29745,
        "end": 29752
      },
      "text": "ལོག་པར་ ༼སྣར། པེ།༽ ལོག་པའི་"
    },
    {
      "span": {
        "start": 30353,
        "end": 30355
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 30454,
        "end": 30458
      },
      "text": "ཆོས་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 31019,
        "end": 31029
      },
      "text": "ལྡན་པ་མེད་ ༼སྣར།༽ ལྡན་པར་མེད་ ༼པེ།༽ ལྡན་"
    },
    {
      "span": {
        "start": 31156,
        "end": 31168
      },
      "text": "གཅིག་ལ་གཅིག་ ༼པེ།༽ གཅིག་"
    },
    {
      "span": {
        "start": 31186,
        "end": 31193
      },
      "text": "གསད་པར་ ༼སྣར། པེ།༽ བསོད་པར་"
    },
    {
      "span": {
        "start": 31205,
        "end": 31212
      },
      "text": "བཏུང་བ་ ༼ཅོ།༽ བརྟུང་བ་ ༼སྣར། པེ།༽ བཏུལ་བ་"
    },
    {
      "span": {
        "start": 31281,
        "end": 31289
      },
      "text": "དེ་དག་ལ་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 31973,
        "end": 31983
      },
      "text": "གྱུར་ཅིག ་ ༼སྣར། པེ།༽ གྱུར་ཅིག།། །།"
    },
    {
      "span": {
        "start": 32055,
        "end": 32065
      },
      "text": "རྒྱ་མཚོའི་ ༼སྣར། པེ།༽ རྒྱ་མཚོ་"
    },
    {
      "span": {
        "start": 32301,
        "end": 32311
      },
      "text": "རྒྱ་མཚོའི་ ༼སྣར། པེ།༽ རྒྱ་མཚོ་"
    },
    {
      "span": {
        "start": 32374,
        "end": 32382
      },
      "text": "དྲན་ཞིང་ ༼སྣར། པེ།༽ དྲན་པའི་"
    },
    {
      "span": {
        "start": 32528,
        "end": 32541
      },
      "text": "ཁྱད་པར་ཅན་དང་ ༼སྣར། པེ།༽ ཁྱད་པར་ཅན་"
    },
    {
      "span": {
        "start": 32693,
        "end": 32700
      },
      "text": "བདག་གི་ ༼པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 32899,
        "end": 32904
      },
      "text": "བླངས་ ༼སྣར། པེ།༽ སླངས་"
    },
    {
      "span": {
        "start": 32916,
        "end": 32924
      },
      "text": "དམྱལ་བར་ ༼སྣར། པེ།༽ དམྱལ་བ་"
    },
    {
      "span": {
        "start": 33003,
        "end": 33009
      },
      "text": "གང་དག་ ༼སྣར། པེ།༽ གང་ཡང་"
    },
    {
      "span": {
        "start": 33014,
        "end": 33017
      },
      "text": "བར་ ༼སྣར། པེ།༽ བར་འགྲོ་བར་"
    },
    {
      "span": {
        "start": 33100,
        "end": 33108
      },
      "text": "བརྡེག་པ་ ༼སྣར། པེ།༽ བརྡེགས་པ་"
    },
    {
      "span": {
        "start": 33205,
        "end": 33213
      },
      "text": "བརྡེག་པ་ ༼པེ།༽ རྡེག་པ་"
    },
    {
      "span": {
        "start": 33329,
        "end": 33336
      },
      "text": "ཐུང་བར་ ༼པེ།༽ འཐུང་བར་"
    },
    {
      "span": {
        "start": 33542,
        "end": 33550
      },
      "text": "རྒྱ་མཚོ་ ༼པེ།༽ རྒྱ་མཚོའི་"
    },
    {
      "span": {
        "start": 33570,
        "end": 33577
      },
      "text": "རོལ་པས་ ༼སྣར། པེ།༽ རོལ་པ་"
    },
    {
      "span": {
        "start": 33608,
        "end": 33612
      },
      "text": "གྲག་ ༼སྣར། པེ།༽ གྲགས་"
    },
    {
      "span": {
        "start": 34008,
        "end": 34010
      },
      "text": "པ་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 34080,
        "end": 34088
      },
      "text": "མཆོག་གི་ ༼སྣར།༽ མཆོག་གིས་"
    },
    {
      "span": {
        "start": 34809,
        "end": 34818
      },
      "text": "པོའི་མཚན་ ༼སྣར།༽ པོའི་"
    },
    {
      "span": {
        "start": 34853,
        "end": 34863
      },
      "text": "བརྒྱད་ཅུས་ ༼སྣར། པེ།༽ བརྒྱད་ཅུ་"
    },
    {
      "span": {
        "start": 34964,
        "end": 34977
      },
      "text": "འོད་ཟེར་གྱིས་ ༼སྣར། པེ།༽ འོད་ཟེར་ཀྱི་"
    },
    {
      "span": {
        "start": 35476,
        "end": 35489
      },
      "text": "མཚན་མོ་མུན་པ་ ༼སྣར། པེ།༽ མཚན་མོ་"
    },
    {
      "span": {
        "start": 35526,
        "end": 35535
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 35542,
        "end": 35551
      },
      "text": "འོད་ཀྱིས་ ༼ཅོ། པེ།༽ འོད་ཀྱི་"
    },
    {
      "span": {
        "start": 35709,
        "end": 35717
      },
      "text": "དཔག་གིས་ ༼སྣར། པེ།༽ དཔག་གི་"
    },
    {
      "span": {
        "start": 36028,
        "end": 36038
      },
      "text": "གསུམ་གྱིས་ ༼སྣར། པེ།༽ གསུམ་གྱི་"
    },
    {
      "span": {
        "start": 37067,
        "end": 37074
      },
      "text": "ཟང་ཟིང་ ༼ཅོ། སྣར།༽ ཟིང་ཟིང་"
    },
    {
      "span": {
        "start": 37098,
        "end": 37108
      },
      "text": "ཡང་དག་པའི་ ༼སྣར། པེ།༽ ཡང་དག་པར་"
    },
    {
      "span": {
        "start": 37280,
        "end": 37287
      },
      "text": "གཞུག་པ་ ༼སྣར།༽ གཞུགས་པ་ ༼པེ།༽ བཞུགས་པ་"
    },
    {
      "span": {
        "start": 37404,
        "end": 37417
      },
      "text": "བསོད་ནམས་ཀྱི་ ༼སྣར། པེ།༽ བསོད་ནམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 37653,
        "end": 37661
      },
      "text": "ཆོས་ཀྱི་ ༼སྣར། པེ།༽ ཆོས་ཀྱིས་"
    },
    {
      "span": {
        "start": 38168,
        "end": 38176
      },
      "text": "བརྫི་བར་ ༼སྣར། པེ།༽ རྫི་བར་"
    },
    {
      "span": {
        "start": 38485,
        "end": 38493
      },
      "text": "འོད་ཀྱི་ ༼སྣར། པེ།༽ འོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 38652,
        "end": 38662
      },
      "text": "གྱུར་ཅིག ་ ༼སྣར།༽ གྱུར་ཅིག།། །།"
    },
    {
      "span": {
        "start": 39193,
        "end": 39198
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 39484,
        "end": 39492
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 39914,
        "end": 39927
      },
      "text": "ཨི་མི་ནེ། མི་ ༼སྣར། པེ།༽ ཨི་མེ་མི་ནི་"
    },
    {
      "span": {
        "start": 40295,
        "end": 40300
      },
      "text": "ཤ་མེ། ༼སྣར། པེ།༽ ཤ་མ་"
    },
    {
      "span": {
        "start": 40351,
        "end": 40353
      },
      "text": "ར་ ༼སྣར། པེ།༽ ཏྲ་"
    },
    {
      "span": {
        "start": 40360,
        "end": 40362
      },
      "text": "ར་ ༼པེ།༽ ཏྲ་"
    },
    {
      "span": {
        "start": 40492,
        "end": 40509
      },
      "text": "བུའམ་རིགས་ཀྱི་བུ་ ༼སྣར། པེ།༽ བུ་"
    },
    {
      "span": {
        "start": 40961,
        "end": 40969
      },
      "text": "འཇིགས་པ་ ༼སྣར། པེ།༽ འཇིག་པ་"
    },
    {
      "span": {
        "start": 41102,
        "end": 41113
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱིས་"
    },
    {
      "span": {
        "start": 41141,
        "end": 41150
      },
      "text": "བསམས་པའི་ ༼སྣར། པེ།༽ བསམ་པའི་"
    },
    {
      "span": {
        "start": 41419,
        "end": 41425
      },
      "text": "བརླབས་ ༼སྣར། པེ།༽ བརླབ་"
    },
    {
      "span": {
        "start": 41902,
        "end": 41907
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 42112,
        "end": 42125
      },
      "text": "འོད་ཟེར་གྱིས་ ༼སྣར། པེ།༽ འོད་ཟེར་གྱི་"
    },
    {
      "span": {
        "start": 42186,
        "end": 42190
      },
      "text": "རིག་ ༼སྣར།༽ རིགས་"
    },
    {
      "span": {
        "start": 42807,
        "end": 42815
      },
      "text": "བརྫི་བར་ ༼སྣར། པེ།༽ རྫི་བར་"
    },
    {
      "span": {
        "start": 42905,
        "end": 42911
      },
      "text": "བསམ་པ་ ༼སྣར། པེ།༽ བསམས་པ་"
    },
    {
      "span": {
        "start": 43504,
        "end": 43514
      },
      "text": "བསྒྲགས་པར་ ༼སྣར། པེ།༽ བསྒྲག་པར་"
    },
    {
      "span": {
        "start": 43826,
        "end": 43832
      },
      "text": "འཕྲོག་ ༼སྣར། པེ།༽ འཕྲོགས་"
    },
    {
      "span": {
        "start": 43860,
        "end": 43869
      },
      "text": "འཕྲོག་པར་ ༼སྣར། པེ།༽ ཕྲོགས་པར་"
    },
    {
      "span": {
        "start": 44711,
        "end": 44719
      },
      "text": "ལུས་ཀྱི་ ༼པེ།༽ ལུས་ཀྱིས་"
    },
    {
      "span": {
        "start": 44993,
        "end": 44999
      },
      "text": "འཁྲིད་ ༼སྣར། པེ།༽ ཁྲིད་"
    },
    {
      "span": {
        "start": 45406,
        "end": 45412
      },
      "text": "བགྱིས་ ༼སྣར། པེ།༽ བགྱིད་"
    },
    {
      "span": {
        "start": 45489,
        "end": 45495
      },
      "text": "གནས་མ་ ༼སྣར།༽ གནས་དེར་"
    },
    {
      "span": {
        "start": 45699,
        "end": 45706
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 46661,
        "end": 46664
      },
      "text": "དང་ ༼སྣར། པེ།༽ དང་ནད་"
    },
    {
      "span": {
        "start": 46808,
        "end": 46815
      },
      "text": "གཏང་བར་ ༼སྣར། པེ།༽ བཏང་བར་"
    },
    {
      "span": {
        "start": 47065,
        "end": 47069
      },
      "text": "ལྡན་ ༼ཅོ། སྡེ།༽ ལྡང་"
    },
    {
      "span": {
        "start": 47463,
        "end": 47471
      },
      "text": "ཡང་དག་པ་ ༼སྣར། པེ།༽ ཡང་དག་པར་"
    },
    {
      "span": {
        "start": 47980,
        "end": 47985
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 48119,
        "end": 48142
      },
      "text": "མཆིའོ་ཞེས་ལན་བདུན་བཟླས། ༼སྣར། པེ།༽ མཆིའོ་"
    },
    {
      "span": {
        "start": 48290,
        "end": 48295
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 48350,
        "end": 48352
      },
      "text": "པ་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 48464,
        "end": 48475
      },
      "text": "མདོངས་གསོལ་ ༼སྣར། པེ།༽ མདོང་གསོལ་"
    },
    {
      "span": {
        "start": 48565,
        "end": 48573
      },
      "text": "སྨོན་ལམ་ ༼སྣར། པེ།༽ སྨོན་ལམ་གྱི་"
    },
    {
      "span": {
        "start": 48891,
        "end": 48893
      },
      "text": "བ་ ༼སྣར། པེ།༽ སྩོལ་"
    },
    {
      "span": {
        "start": 49038,
        "end": 49047
      },
      "text": "གཤེགས་པས་ ༼སྣར། པེ།༽ གཤེགས་པའི་"
    },
    {
      "span": {
        "start": 49052,
        "end": 49061
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 49725,
        "end": 49728
      },
      "text": "ཛུ་ ༼སྣར། པེ།༽ ཛུ་རྫུ་"
    },
    {
      "span": {
        "start": 49922,
        "end": 49925
      },
      "text": "དུ་ ༼སྣར། པེ།༽ དུ་མི་"
    },
    {
      "span": {
        "start": 49932,
        "end": 49939
      },
      "text": "རིག་པར་ ༼སྣར། པེ།༽ རིགས་པར་"
    },
    {
      "span": {
        "start": 50106,
        "end": 50112
      },
      "text": "འགྱུར། ༼སྣར། པེ།༽ འགྱུར་རོ། །"
    },
    {
      "span": {
        "start": 50310,
        "end": 50316
      },
      "text": "དེ་དག་ ༼སྣར། པེ།༽ དེ་དག་གི་དོན་དུ་བདག་"
    },
    {
      "span": {
        "start": 50320,
        "end": 50330
      },
      "text": "གཟུངས་ཀྱི་ ༼སྣར། པེ།༽ གཟུངས་ཀྱིས་"
    },
    {
      "span": {
        "start": 50395,
        "end": 50403
      },
      "text": "བདུན་པོ་ ༼སྣར། པེ།༽ བདུན་པོ་དག་"
    },
    {
      "span": {
        "start": 50485,
        "end": 50489
      },
      "text": "བཛྲ་ ༼སྣར། པེ།༽ བཛྲེ་"
    },
    {
      "span": {
        "start": 50526,
        "end": 50536
      },
      "text": "ཧ་ཏེ། ཧ་ཧ་ ༼སྣར། པེ།༽ ཧ་ཏ་"
    },
    {
      "span": {
        "start": 50628,
        "end": 50632
      },
      "text": "བཛྲ་ ༼སྣར། པེ།༽ བཛྲེ་"
    },
    {
      "span": {
        "start": 50964,
        "end": 50971
      },
      "text": "སྩལ་བར་ ༼སྣར། པེ།༽ སྩོལ་བར་"
    },
    {
      "span": {
        "start": 50971,
        "end": 50978
      },
      "text": "བགྱིའོ། ༼སྣར། པེ།༽ བགྱི།"
    },
    {
      "span": {
        "start": 51350,
        "end": 51362
      },
      "text": "འཕགས་པའི་ལམ་ ༼སྣར། པེ།༽ འཕགས་པའི་"
    },
    {
      "span": {
        "start": 52002,
        "end": 52014
      },
      "text": "གྱི་སྨོན་ལམ་ ༼སྣར།༽ གྱི་སྔོན་ ༼པེ།༽ གྱི་སྔོན་གྱི་སྨོན་ལམ་"
    },
    {
      "span": {
        "start": 52492,
        "end": 52498
      },
      "text": "འདས་པ་ ༼སྣར། པེ།༽ བདས་པ་"
    },
    {
      "span": {
        "start": 52630,
        "end": 52639
      },
      "text": "ཆུས་སྲིད་ ༼སྣར།༽ ཆུ་སྲིད་ ༼པེ།༽ ཆུ་སྲིན་"
    },
    {
      "span": {
        "start": 52816,
        "end": 52822
      },
      "text": "བསམ་པ་ ༼སྣར། པེ།༽ བསམས་པ་"
    },
    {
      "span": {
        "start": 53038,
        "end": 53045
      },
      "text": "དམ་པོས་ ༼སྣར། པེ།༽ དམ་པོ་"
    },
    {
      "span": {
        "start": 53669,
        "end": 53673
      },
      "text": "དབང་ ༼སྣར། པེ།༽ དབང་པོ་"
    },
    {
      "span": {
        "start": 53910,
        "end": 53914
      },
      "text": "བསམ་ ༼སྣར། པེ།༽ བསམས་"
    },
    {
      "span": {
        "start": 54247,
        "end": 54252
      },
      "text": "འབུམ་ ༼སྣར། པེ།༽ འབུམ་བདུན་འབུམ་"
    },
    {
      "span": {
        "start": 54337,
        "end": 54345
      },
      "text": "གཅིག་ཏུ། ༼སྣར། པེ།༽ གཅིག་"
    },
    {
      "span": {
        "start": 54375,
        "end": 54386
      },
      "text": "བདག་ཅག་གིས་ ༼སྣར། པེ།༽ བདག་ཅག་གི་"
    },
    {
      "span": {
        "start": 55002,
        "end": 55008
      },
      "text": "བསམ་པ་ ༼སྣར། པེ།༽ བསམས་པ་"
    },
    {
      "span": {
        "start": 55587,
        "end": 55591
      },
      "text": "གྱི་ ༼སྣར། པེ།༽ གྱི་སྔོན་གྱི་"
    },
    {
      "span": {
        "start": 56066,
        "end": 56070
      },
      "text": "འདས་ ༼སྣར། པེ།༽ གདས་"
    },
    {
      "span": {
        "start": 56198,
        "end": 56202
      },
      "text": "ཆུས་ ༼སྣར། པེ།༽ ཆུ་"
    },
    {
      "span": {
        "start": 56256,
        "end": 56260
      },
      "text": "རུང་ ༼སྣར། པེ།༽ རུང་བ་ལ་ཅི་ཡང་རུང་"
    },
    {
      "span": {
        "start": 56431,
        "end": 56441
      },
      "text": "བགྱི་ཞིང་། ༼སྣར། པེ།༽ བགྱིད་ཅིང་།"
    },
    {
      "span": {
        "start": 56659,
        "end": 56666
      },
      "text": "མཛད་པར་ ༼སྣར། པེ།༽ མཛད་པ་"
    },
    {
      "span": {
        "start": 56708,
        "end": 56714
      },
      "text": "གདབ་པ་ ༼སྣར། པེ།༽ གདབ་"
    },
    {
      "span": {
        "start": 56773,
        "end": 56791
      },
      "text": "འཛོམ་པའི་སྤྱན་སྔར་ ༼སྣར། པེ།༽ འཛོམ་པའི་སྤྱིར་"
    },
    {
      "span": {
        "start": 57137,
        "end": 57145
      },
      "text": "སྨོན་ལམ་ ༼སྣར། པེ།༽ སྨོན་ལམ་གྱི་"
    },
    {
      "span": {
        "start": 57340,
        "end": 57345
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 57524,
        "end": 57530
      },
      "text": "བཙན་པ་ ༼སྣར། པེ།༽ བརྩན་པ་"
    },
    {
      "span": {
        "start": 57758,
        "end": 57766
      },
      "text": "ཆབས་འོག་ ༼སྣར། པེ།༽ ཆབ་འོག་"
    },
    {
      "span": {
        "start": 58012,
        "end": 58020
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 59238,
        "end": 59247
      },
      "text": "འབྱོན་པར་ ༼སྣར། པེ།༽ བྱོན་པར་"
    },
    {
      "span": {
        "start": 59262,
        "end": 59271
      },
      "text": "ཐུགས་རྗེ་ ༼སྣར། པེ།༽ ཐུགས་རྗེས་"
    },
    {
      "span": {
        "start": 59478,
        "end": 59482
      },
      "text": "གཞི་ ༼སྣར།༽ བཞི་"
    },
    {
      "span": {
        "start": 59660,
        "end": 59667
      },
      "text": "སྒྲོགས་ ༼སྣར། པེ།༽ སྒྲོག་"
    },
    {
      "span": {
        "start": 59751,
        "end": 59754
      },
      "text": "མར་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 59878,
        "end": 59886
      },
      "text": "འཆར་བའི་ ༼སྣར། པེ།༽ མཆོད་པའི་"
    },
    {
      "span": {
        "start": 60084,
        "end": 60089
      },
      "text": "སྲིད་ ༼སྣར། པེ།༽ སྲེད་"
    },
    {
      "span": {
        "start": 60121,
        "end": 60129
      },
      "text": "སྒྲིབ་པ་ ༼སྣར། པེ།༽ སྒྲིབས་པ་"
    },
    {
      "span": {
        "start": 60215,
        "end": 60222
      },
      "text": "དག་པའི་ ༼སྣར། པེ།༽ དག་པར་"
    },
    {
      "span": {
        "start": 60287,
        "end": 60293
      },
      "text": "བཞུགས། ༼པེ།༽ གཞུགས།"
    },
    {
      "span": {
        "start": 60391,
        "end": 60398
      },
      "text": "སྦྱར་བ་ ༼སྣར། པེ།༽ སྦྱར་"
    },
    {
      "span": {
        "start": 60493,
        "end": 60499
      },
      "text": "བཅས་པ་ ༼སྣར། པེ།༽ བཅས་"
    },
    {
      "span": {
        "start": 60563,
        "end": 60572
      },
      "text": "ཐུགས་རྗེ་ ༼སྣར། པེ།༽ ཐུགས་རྗེས་"
    },
    {
      "span": {
        "start": 60627,
        "end": 60637
      },
      "text": "གྱུར་པ་ཡི། ༼སྣར།༽ གྱུར་པ་ཡིས།"
    },
    {
      "span": {
        "start": 60758,
        "end": 60771
      },
      "text": "ཐུགས་རྗེ་ཡིས། ༼པེ།༽ ཐུགས་རྗེ་ཡི།"
    },
    {
      "span": {
        "start": 60807,
        "end": 60813
      },
      "text": "སྒྲུབ་ ༼སྣར།༽ བསྒྲུབ་ ༼པེ།༽ བསྒྲུབས་"
    },
    {
      "span": {
        "start": 60966,
        "end": 60974
      },
      "text": "མཚན་གྱི་ ༼སྣར། པེ།༽ མཚན་གྱིས་"
    },
    {
      "span": {
        "start": 61135,
        "end": 61146
      },
      "text": "བརྒྱན་ཞིང་། ༼སྣར། པེ།༽ བརྒྱན་ཅིང་།"
    },
    {
      "span": {
        "start": 61159,
        "end": 61161
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་མ་"
    },
    {
      "span": {
        "start": 61161,
        "end": 61169
      },
      "text": "ཆགས་པའི་ ༼སྣར། པེ།༽ ཆགས་"
    },
    {
      "span": {
        "start": 61372,
        "end": 61377
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 61601,
        "end": 61605
      },
      "text": "དངས་ ༼སྣར། པེ།༽ ཟང་"
    },
    {
      "span": {
        "start": 61671,
        "end": 61681
      },
      "text": "རྒྱ་མཚོའི་ ༼སྣར། པེ།༽ རྒྱ་མཚོ་"
    },
    {
      "span": {
        "start": 61900,
        "end": 61908
      },
      "text": "དངས་པའི་ ༼སྣར། པེ།༽ དང་བའི་"
    },
    {
      "span": {
        "start": 61930,
        "end": 61939
      },
      "text": "འོད་ཀྱིས་ ༼སྣར། པེ།༽ འོད་ཀྱི་"
    },
    {
      "span": {
        "start": 62118,
        "end": 62127
      },
      "text": "ཐུགས་རྗེ་ ༼སྣར། པེ།༽ ཐུགས་རྗེས་"
    },
    {
      "span": {
        "start": 62210,
        "end": 62217
      },
      "text": "ལྟ་བུར་ ༼སྣར། པེ།༽ ལྟ་བུ་"
    },
    {
      "span": {
        "start": 62267,
        "end": 62271
      },
      "text": "རིག་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 62279,
        "end": 62289
      },
      "text": "སྒྲོན་མའི་ ༼སྣར། པེ།༽ སྒྲོལ་མའི་"
    },
    {
      "span": {
        "start": 62424,
        "end": 62431
      },
      "text": "སྐུ་ཡི་ ༼སྣར། པེ།༽ སྐུ་ཡིས་"
    },
    {
      "span": {
        "start": 62514,
        "end": 62522
      },
      "text": "འཇིགས་པ་ ༼སྣར། པེ།༽ འཇིག་པ་"
    },
    {
      "span": {
        "start": 62531,
        "end": 62537
      },
      "text": "སྐྱོབ་ ༼སྣར།༽ སྐྱོབས་"
    },
    {
      "span": {
        "start": 62703,
        "end": 62713
      },
      "text": "ཐུགས་ཀྱིས་ ༼སྡེ།༽ ཐུགས་ཀྱི་"
    },
    {
      "span": {
        "start": 62766,
        "end": 62772
      },
      "text": "བསྣམས་ ༼སྣར། པེ།༽ སྣམས་"
    },
    {
      "span": {
        "start": 63048,
        "end": 63052
      },
      "text": "ཚངས། ༼སྣར། པེ།༽ འཚངས།"
    },
    {
      "span": {
        "start": 63206,
        "end": 63212
      },
      "text": "ལྷ་ཡི་ ༼སྣར། པེ།༽ ལྷ་ཡིས་"
    },
    {
      "span": {
        "start": 63332,
        "end": 63343
      },
      "text": "སྲས་རྣམས་ལ། ༼སྣར། པེ།༽ སྲས་པོ་རྣམས།"
    },
    {
      "span": {
        "start": 63374,
        "end": 63380
      },
      "text": "ལྷ་མི་ ༼སྣར། པེ།༽ ལྷ་མིན་"
    },
    {
      "span": {
        "start": 63607,
        "end": 63612
      },
      "text": "སྐོང་ ༼སྣར།༽ བསྐོངས་ ༼པེ།༽ སྐོངས་"
    },
    {
      "span": {
        "start": 63786,
        "end": 63791
      },
      "text": "མདོག་ ༼སྣར།༽ འདོག་"
    },
    {
      "span": {
        "start": 64000,
        "end": 64005
      },
      "text": "ཕྱིར་ ༼སྣར། པེ།༽ དྲུག་"
    },
    {
      "span": {
        "start": 64013,
        "end": 64016
      },
      "text": "ཅན། ༼སྣར། པེ།༽ བསྟན།"
    },
    {
      "span": {
        "start": 64089,
        "end": 64094
      },
      "text": "བཟང་། ༼སྣར།༽ བཟུང་།"
    },
    {
      "span": {
        "start": 64159,
        "end": 64170
      },
      "text": "ཐུགས་དམ་ཅན། ༼སྣར། པེ།༽ ཐུགས་དམ་བསྟན།"
    },
    {
      "span": {
        "start": 64381,
        "end": 64388
      },
      "text": "བསྟན་པ་ ༼སྣར།༽ བརྟན་པ་"
    },
    {
      "span": {
        "start": 64433,
        "end": 64442
      },
      "text": "རྔོམ་པའི་ ༼སྣར། པེ།༽ རྔམ་པའི་"
    },
    {
      "span": {
        "start": 64548,
        "end": 64553
      },
      "text": "གཏང་། ༼སྣར། པེ།༽ བཏང་།"
    }
  ]
}