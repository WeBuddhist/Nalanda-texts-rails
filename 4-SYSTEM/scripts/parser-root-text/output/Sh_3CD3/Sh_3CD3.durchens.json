{
  "durchens": [
    {
      "span": {
        "start": 347,
        "end": 352
      },
      "text": "བརྣབ་ ༼སྣར། པེ།༽ བསྣབས་"
    },
    {
      "span": {
        "start": 558,
        "end": 564
      },
      "text": "མཐུའི་ ༼སྣར། པེ།༽ མཐེའུ་"
    },
    {
      "span": {
        "start": 1046,
        "end": 1051
      },
      "text": "དྲངས། ༼སྣར།༽ དྲང་།"
    },
    {
      "span": {
        "start": 1681,
        "end": 1691
      },
      "text": "བདུན་པོའི་ ༼སྣར། པེ།༽ བདུན་པའི་"
    },
    {
      "span": {
        "start": 2090,
        "end": 2094
      },
      "text": "ཉིན་ ༼སྣར། པེ།༽ ཉིན་མཚན་"
    },
    {
      "span": {
        "start": 2119,
        "end": 2123
      },
      "text": "སྤོ་ ༼པེ།༽ སྤོང་"
    },
    {
      "span": {
        "start": 2238,
        "end": 2245
      },
      "text": "ཁྱབ་པར་ ༼པེ།༽ ཁྱད་པར་"
    },
    {
      "span": {
        "start": 2308,
        "end": 2313
      },
      "text": "བརྡར་ ༼སྣར། པེ།༽ བདར་"
    },
    {
      "span": {
        "start": 2327,
        "end": 2332
      },
      "text": "བརླབ། ༼སྣར། པེ།༽ བརླབས་ཏེ།"
    },
    {
      "span": {
        "start": 2589,
        "end": 2600
      },
      "text": "འབྱུང་བཞིན་ ༼སྣར། པེ།༽ འབྱུང་བའི་"
    },
    {
      "span": {
        "start": 2636,
        "end": 2645
      },
      "text": "ཀུན་གྱིས་ ༼སྣར། པེ།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 2735,
        "end": 2747
      },
      "text": "རྗེས་ལ་སྤྱི་ ༼སྣར། པེ།༽ རྗེས་"
    },
    {
      "span": {
        "start": 2837,
        "end": 2842
      },
      "text": "ཚིགས་ ༼སྡེ།༽ ཚོགས་"
    },
    {
      "span": {
        "start": 2855,
        "end": 2860
      },
      "text": "གྱེས། ༼སྣར།༽ གྱེ།"
    },
    {
      "span": {
        "start": 2891,
        "end": 2902
      },
      "text": "སྟོབས་ཀྱིས་ ༼སྣར། པེ།༽ སྟོབས་ཀྱི་"
    },
    {
      "span": {
        "start": 2905,
        "end": 2914
      },
      "text": "ནུས་པ་དང་ ༼སྣར། པེ།༽ ནུས་པར་"
    },
    {
      "span": {
        "start": 3162,
        "end": 3165
      },
      "text": "ཚས་ ༼སྣར།༽ རས་"
    },
    {
      "span": {
        "start": 3170,
        "end": 3180
      },
      "text": "དཀྲིས་པའི་ ༼པེ།༽ བཀྲིས་པའི་"
    },
    {
      "span": {
        "start": 4103,
        "end": 4108
      },
      "text": "ཁྱུད་ ༼སྣར།༽ མཁྱུད་"
    },
    {
      "span": {
        "start": 4249,
        "end": 4258
      },
      "text": "ཚོན་གྱིས་ ༼སྣར། པེ།༽ ཚོན་ཕྱེས་"
    },
    {
      "span": {
        "start": 4320,
        "end": 4329
      },
      "text": "གདུགས་ཅི་ ༼པེ།༽ གདུགས་ཅིང་"
    },
    {
      "span": {
        "start": 4509,
        "end": 4515
      },
      "text": "ཡན་ཆད་ ༼སྣར། པེ།༽ ཡན་ཆད་བཞི་བཅུ་རྩ་དགུ་མན་ཆད་"
    },
    {
      "span": {
        "start": 4546,
        "end": 4551
      },
      "text": "གཏང་། ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 4996,
        "end": 5000
      },
      "text": "གྲྭ་ ༼སྣར། པེ།༽ གྲ་"
    },
    {
      "span": {
        "start": 5013,
        "end": 5021
      },
      "text": "བཤམས་ཏེ་ ༼སྣར། པེ།༽ བཤམ་སྟེ་"
    },
    {
      "span": {
        "start": 5177,
        "end": 5181
      },
      "text": "གྲྭ་ ༼སྣར། པེ།༽ གྲ་"
    },
    {
      "span": {
        "start": 5193,
        "end": 5200
      },
      "text": "བ་བསྟར་ ༼སྣར། པེ།༽ ལ་བལྟར་"
    },
    {
      "span": {
        "start": 5331,
        "end": 5338
      },
      "text": "བྱས་ཏེ། ༼སྣར། པེ།༽ བྱ་སྟེ།"
    },
    {
      "span": {
        "start": 5479,
        "end": 5487
      },
      "text": "བསམ་ཞིང་ ༼སྣར། པེ།༽ བསམས་ཤིང་"
    },
    {
      "span": {
        "start": 5743,
        "end": 5758
      },
      "text": "དགེ་འདུན་འཚོགས་ ༼སྣར། པེ།༽ དེ་དག་བདུན་ཚོགས་"
    },
    {
      "span": {
        "start": 6127,
        "end": 6136
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 6369,
        "end": 6378
      },
      "text": "བརྒྱུད་པ་ ༼སྣར། པེ།༽ རྒྱུད་པ་"
    },
    {
      "span": {
        "start": 6386,
        "end": 6398
      },
      "text": "བདག་གི་བཤེས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 6398,
        "end": 6403
      },
      "text": "གཉེན་ ༼སྣར། པེ།༽ གཉེན་གཤེས་"
    },
    {
      "span": {
        "start": 6417,
        "end": 6426
      },
      "text": "ཞིང་དུ་མ་ ༼སྣར། པེ།༽ ཞིང་དུ་"
    },
    {
      "span": {
        "start": 7076,
        "end": 7085
      },
      "text": "གཟུང་བའི་ ༼སྣར། པེ།༽ བཟུང་བའི་"
    },
    {
      "span": {
        "start": 7307,
        "end": 7320
      },
      "text": "དཔུང་གཉེན་དུ་ ༼སྣར། པེ།༽ དཔུང་གཉེན་"
    },
    {
      "span": {
        "start": 7367,
        "end": 7376
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 7498,
        "end": 7504
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 7547,
        "end": 7561
      },
      "text": "བྱམས་པའི་སེམས་ ༼སྣར། པེ།༽ བྱམས་པའི་"
    },
    {
      "span": {
        "start": 7691,
        "end": 7700
      },
      "text": "ཡིད་ཀྱིས་ ༼སྣར། པེ།༽ ཡིད་ཀྱི་"
    },
    {
      "span": {
        "start": 7724,
        "end": 7731
      },
      "text": "བསྔོ་བ། ༼སྣར། པེ།༽ བསྔོ།། །།"
    },
    {
      "span": {
        "start": 7809,
        "end": 7818
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 8483,
        "end": 8496
      },
      "text": "སྣ་ཚོགས་ཀྱིས་ ༼སྣར། པེ།༽ སྣ་ཚོགས་ཀྱི་"
    },
    {
      "span": {
        "start": 8575,
        "end": 8581
      },
      "text": "བདལ་བ་ ༼སྣར། པེ།༽ བརྡལ་བ་"
    },
    {
      "span": {
        "start": 8646,
        "end": 8651
      },
      "text": "ཅིག ། ༼སྣར། པེ།༽ ཅིང་། །"
    },
    {
      "span": {
        "start": 8675,
        "end": 8684
      },
      "text": "སྒྲོགས་པ་ ༼སྣར། པེ།༽ སྒྲོག་པ་"
    },
    {
      "span": {
        "start": 8871,
        "end": 8877
      },
      "text": "དཔྱངས་ ༼སྣར།༽ སྤྱངས་"
    },
    {
      "span": {
        "start": 9026,
        "end": 9033
      },
      "text": "སྦྲེངས་ ༼སྣར། པེ།༽ སྒྲེངས་"
    },
    {
      "span": {
        "start": 9147,
        "end": 9154
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 9526,
        "end": 9532
      },
      "text": "དྲི་ཟ་ ༼སྣར།༽ དྲི་"
    },
    {
      "span": {
        "start": 9679,
        "end": 9685
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 9962,
        "end": 9971
      },
      "text": "ཆེན་པོའི་ ༼སྣར།༽ ཆེན་པའི་"
    },
    {
      "span": {
        "start": 10131,
        "end": 10141
      },
      "text": "བརྟེན་པའི་ ༼སྣར། པེ།༽ རྟེན་པའི་"
    },
    {
      "span": {
        "start": 10267,
        "end": 10276
      },
      "text": "བཅོས་བུས་ ༼སྣར། པེ།༽ བཅོས་བུ་"
    },
    {
      "span": {
        "start": 10600,
        "end": 10606
      },
      "text": "འཚམ་པ་ ༼སྣར། པེ།༽ འཚམ་པར་"
    },
    {
      "span": {
        "start": 10946,
        "end": 10951
      },
      "text": "རྗེས་ ༼སྣར། པེ།༽ རྗེས་སུ་"
    },
    {
      "span": {
        "start": 11013,
        "end": 11024
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱིས་"
    },
    {
      "span": {
        "start": 11029,
        "end": 11038
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླས་"
    },
    {
      "span": {
        "start": 11244,
        "end": 11250
      },
      "text": "བཙུགས་ ༼སྣར། པེ།༽ གཙུགས་"
    },
    {
      "span": {
        "start": 11873,
        "end": 11878
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 12281,
        "end": 12288
      },
      "text": "བསྒྲགས་ ༼སྣར། པེ།༽ སྒྲགས་"
    },
    {
      "span": {
        "start": 13041,
        "end": 13048
      },
      "text": "བརྒྱ་བ་ ༼སྣར། པེ།༽ བརྒྱ་"
    },
    {
      "span": {
        "start": 13122,
        "end": 13130
      },
      "text": "བསྒྲིབས་ ༼སྣར།༽ བསྒྲིབ་"
    },
    {
      "span": {
        "start": 13259,
        "end": 13268
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 13416,
        "end": 13425
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 14877,
        "end": 14882
      },
      "text": "བརླབ་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 14936,
        "end": 14940
      },
      "text": "གཏད་ ༼པེ།༽ བཏད་"
    },
    {
      "span": {
        "start": 15024,
        "end": 15028
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 15032,
        "end": 15038
      },
      "text": "སྐྱོང་ ༼སྣར། པེ།༽ བསྐྱོང་"
    },
    {
      "span": {
        "start": 16068,
        "end": 16073
      },
      "text": "ལྟུང་ ༼པེ།༽ བཏུང་"
    },
    {
      "span": {
        "start": 16281,
        "end": 16290
      },
      "text": "སྡེ་དཔོན་ ༼སྣར། པེ།༽ སྡེ་དཔོན་ཆེན་པོ་"
    },
    {
      "span": {
        "start": 16654,
        "end": 16660
      },
      "text": "བསྒོམ་ ༼སྣར། པེ།༽ བསྒམ་"
    },
    {
      "span": {
        "start": 17275,
        "end": 17280
      },
      "text": "སྟོད་ ༼སྣར། པེ།༽ བསྟོད་"
    },
    {
      "span": {
        "start": 17418,
        "end": 17427
      },
      "text": "སྡེ་དཔོན་ ༼སྣར། པེ།༽ སྡེ་དཔོན་ཆེན་པོ་"
    },
    {
      "span": {
        "start": 17541,
        "end": 17545
      },
      "text": "ལྡན་ ༼སྣར། པེ།༽ གདན་"
    },
    {
      "span": {
        "start": 17616,
        "end": 17624
      },
      "text": "སྔོན་དུ་ ༼སྣར། པེ།༽ མངོན་དུ་"
    },
    {
      "span": {
        "start": 17736,
        "end": 17746
      },
      "text": "བསྐྱེད་དེ་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 18123,
        "end": 18131
      },
      "text": "འབྲིང་བ་ ༼སྣར། པེ།༽ འབྲིང་"
    },
    {
      "span": {
        "start": 20131,
        "end": 20140
      },
      "text": "བཟུང་ཞིང་ ༼སྣར། པེ།༽ བཟུང་བའི་"
    },
    {
      "span": {
        "start": 20211,
        "end": 20220
      },
      "text": "རིགས་པའི་ ༼སྣར། པེ།༽ རིག་པའི་"
    },
    {
      "span": {
        "start": 20557,
        "end": 20565
      },
      "text": "བགྱི་བར་ ༼སྣར།༽ བགྱིད་པར་"
    },
    {
      "span": {
        "start": 20581,
        "end": 20605
      },
      "text": "བགྱིས་པ་ལ་སོགས་པའི་དངོས་ ༼སྣར།༽ ལ་སོགས་པ་དང་ ༼པེ།༽ པའི་དང་"
    },
    {
      "span": {
        "start": 20685,
        "end": 20695
      },
      "text": "མཐའ་དག་གི་ ༼སྣར།༽ མཐའ་དག་གིས་"
    },
    {
      "span": {
        "start": 20952,
        "end": 20959
      },
      "text": "གསོལ་བ་ ༼སྣར། པེ།༽ གསོལ་བར་"
    },
    {
      "span": {
        "start": 21112,
        "end": 21114
      },
      "text": "ན། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 21304,
        "end": 21309
      },
      "text": "ཕན་པ་ ༼སྣར། པེ།༽ ཕན་པའི་"
    },
    {
      "span": {
        "start": 22393,
        "end": 22401
      },
      "text": "མཆིས་པས་ ༼སྣར། པེ།༽ མཆིས་པས་མཆོད་པའི་ཚོགས་"
    },
    {
      "span": {
        "start": 22673,
        "end": 22684
      },
      "text": "བདག་ཅག་གིས་ ༼སྣར། པེ།༽ བདག་ཅག་གི་"
    },
    {
      "span": {
        "start": 23126,
        "end": 23130
      },
      "text": "ཞིང་ ༼སྣར།༽ བཞིང་"
    },
    {
      "span": {
        "start": 23248,
        "end": 23253
      },
      "text": "སྟོན་ ༼སྣར། པེ།༽ བྱད་"
    },
    {
      "span": {
        "start": 23432,
        "end": 23443
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱིས་"
    },
    {
      "span": {
        "start": 23662,
        "end": 23670
      },
      "text": "སྨྱོན་པ་ ༼སྣར།༽ སྨྱན་པ་ ༼པེ།༽ སྨྱོས་པ་"
    },
    {
      "span": {
        "start": 24087,
        "end": 24094
      },
      "text": "དམྱལ་བ་ ༼སྣར། པེ།༽ དམྱལ་བར་"
    },
    {
      "span": {
        "start": 24788,
        "end": 24795
      },
      "text": "བཞུག་པ་ ༼སྣར། པེ།༽ གཞུག་པ་"
    },
    {
      "span": {
        "start": 24906,
        "end": 24914
      },
      "text": "བརྡོག་པ་ ༼སྣར།༽ བརྡེག་པ་ ༼པེ།༽ རྡེག་པ་"
    },
    {
      "span": {
        "start": 25116,
        "end": 25121
      },
      "text": "གདུག་ ༼སྣར།༽ གདུགས་"
    },
    {
      "span": {
        "start": 25154,
        "end": 25157
      },
      "text": "ཉམ་ ༼སྣར།༽ ཉམས་"
    },
    {
      "span": {
        "start": 27210,
        "end": 27216
      },
      "text": "འཁྱམས་ ༼སྣར། པེ།༽ འཁྱམ་"
    },
    {
      "span": {
        "start": 27245,
        "end": 27251
      },
      "text": "རྒལ་བ་ ༼སྣར། པེ།༽ རྒ་བ་"
    },
    {
      "span": {
        "start": 27588,
        "end": 27596
      },
      "text": "དགེ་བའི་ ༼སྣར།༽ དག་པའི་"
    },
    {
      "span": {
        "start": 27846,
        "end": 27851
      },
      "text": "སྐོམ་ ༼སྣར། པེ།༽ བསྐོམ་"
    },
    {
      "span": {
        "start": 28175,
        "end": 28179
      },
      "text": "ཞིང་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 28326,
        "end": 28346
      },
      "text": "སྐྱེ་བ་དེ་ཡང་ཐ་མ་པར་ ༼སྣར།༽ དེ་ཡང་ཐ་མར་"
    },
    {
      "span": {
        "start": 28761,
        "end": 28770
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 28905,
        "end": 28910
      },
      "text": "སྨྲེ་ ༼སྣར། པེ།༽ སྨེ་"
    },
    {
      "span": {
        "start": 28928,
        "end": 28934
      },
      "text": "པ་དང་། ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 28987,
        "end": 28990
      },
      "text": "ནག་ ༼སྣར། པེ།༽ གནག་"
    },
    {
      "span": {
        "start": 29156,
        "end": 29164
      },
      "text": "དམན་པ་ལ་ ༼སྣར། པེ།༽ དམན་པར་"
    },
    {
      "span": {
        "start": 29401,
        "end": 29408
      },
      "text": "ཏིང་ངེ་ ༼སྣར།༽ ཏིང་"
    },
    {
      "span": {
        "start": 29570,
        "end": 29578
      },
      "text": "དམན་པ་ལ་ ༼སྣར། པེ།༽ དམན་པར་"
    },
    {
      "span": {
        "start": 29895,
        "end": 29903
      },
      "text": "བྱང་ཆུབ་ ༼སྣར། པེ།༽ བྱང་ཆུབ་ཀྱི་སེམས་"
    },
    {
      "span": {
        "start": 30038,
        "end": 30048
      },
      "text": "འཁྲུགས་པར་ ༼སྣར།༽ འཁྲུག་པར་"
    },
    {
      "span": {
        "start": 30320,
        "end": 30328
      },
      "text": "བརྒྱན་པ་ ༼སྣར། པེ།༽ རྒྱན་པ་"
    },
    {
      "span": {
        "start": 31330,
        "end": 31335
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 31521,
        "end": 31526
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 31687,
        "end": 31698
      },
      "text": "བརྟུལ་ཞུགས་ ༼སྣར།༽ བརྟུལ་ཞུགས་པ་"
    },
    {
      "span": {
        "start": 31868,
        "end": 31881
      },
      "text": "སྲོག་གཅོད་པར་ ༼སྣར། པེ།༽ སྲོག་གཅོད་པ་"
    },
    {
      "span": {
        "start": 32035,
        "end": 32045
      },
      "text": "གྱུར་ཅིག ་ ༼སྣར། པེ།༽ གྱུར་ཅིག ་ནད་མེད་པར་གྱུར་ཅིག་"
    },
    {
      "span": {
        "start": 32150,
        "end": 32153
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 32364,
        "end": 32369
      },
      "text": "ཕྱུག་ ༼སྣར། པེ།༽ ཕྱུགས་"
    },
    {
      "span": {
        "start": 32775,
        "end": 32784
      },
      "text": "སྤྱོད་པས་ ༼སྣར། པེ།༽ སྤྱད་པས་"
    },
    {
      "span": {
        "start": 32868,
        "end": 32876
      },
      "text": "སྒྲིབ་པ་ ༼སྣར། པེ།༽ སྒྲིབས་པ་"
    },
    {
      "span": {
        "start": 33673,
        "end": 33680
      },
      "text": "འཆིང་བ་ ༼སྣར། པེ།༽ འཆི་བ་"
    },
    {
      "span": {
        "start": 33729,
        "end": 33737
      },
      "text": "ཐུབ་པའི་ ༼སྣར། པེ།༽ ཐུག་པའི་"
    },
    {
      "span": {
        "start": 33785,
        "end": 33794
      },
      "text": "དེ་དག་གི་ ༼སྣར།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 33999,
        "end": 34008
      },
      "text": "གྱི་རླབས་ ༼སྣར།༽ གྱིས་བརླབས་ ༼པེ།༽ གྱི་བརླབས་"
    },
    {
      "span": {
        "start": 34215,
        "end": 34221
      },
      "text": "བསམ་པ་ ༼སྣར།༽ བསམས་པ་"
    },
    {
      "span": {
        "start": 34386,
        "end": 34391
      },
      "text": "བཟངས་ ༼སྣར།༽ བཟང་"
    },
    {
      "span": {
        "start": 34457,
        "end": 34467
      },
      "text": "སྙིང་པོའི་ ༼སྣར། པེ།༽ སྙིང་པོ་"
    },
    {
      "span": {
        "start": 34482,
        "end": 34487
      },
      "text": "རྫུས་ ༼སྣར། པེ།༽ བརྫུས་"
    },
    {
      "span": {
        "start": 34487,
        "end": 34499
      },
      "text": "ཏེ་སྐྱེ་ཞིང་ ༼སྣར། པེ།༽ ཏེ་"
    },
    {
      "span": {
        "start": 35626,
        "end": 35629
      },
      "text": "ནག་ ༼སྣར། པེ།༽ གནག་"
    },
    {
      "span": {
        "start": 36073,
        "end": 36079
      },
      "text": "ཕྲོགས་ ༼སྣར། པེ།༽ འཕྲོགས་"
    },
    {
      "span": {
        "start": 36540,
        "end": 36552
      },
      "text": "མདོངས་ཕྲོགས་ ༼སྣར། པེ།༽ མདངས་འཕྲོགས་"
    },
    {
      "span": {
        "start": 36688,
        "end": 36700
      },
      "text": "མདོངས་ཕྲོགས་ ༼སྣར། པེ།༽ མདངས་འཕྲོག་"
    },
    {
      "span": {
        "start": 37254,
        "end": 37261
      },
      "text": "ཐམས་ཅད་ ༼སྣར། པེ།༽ ཐམས་ཅད་ལས་"
    },
    {
      "span": {
        "start": 37428,
        "end": 37436
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 37769,
        "end": 37775
      },
      "text": "བཙལ་བ་ ༼སྣར། པེ།༽ འཚལ་བ་"
    },
    {
      "span": {
        "start": 38109,
        "end": 38120
      },
      "text": "མཐར་ཐུག་གི་ ༼སྣར། པེ།༽ མཐར་ཐུག་གིས་"
    },
    {
      "span": {
        "start": 38385,
        "end": 38393
      },
      "text": "གྲག་པའི་ ༼སྣར། པེ།༽ གྲག་པ་"
    },
    {
      "span": {
        "start": 38495,
        "end": 38502
      },
      "text": "ངན་སོང་ ༼སྣར། པེ།༽ ངན་སོང་གསུམ་"
    },
    {
      "span": {
        "start": 38627,
        "end": 38635
      },
      "text": "གྲགས་པར་ ༼སྣར། པེ།༽ གྲག་པར་"
    },
    {
      "span": {
        "start": 38748,
        "end": 38756
      },
      "text": "གྱུར་ཏེ། ༼པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 39147,
        "end": 39152
      },
      "text": "བསགས་ ༼སྣར། པེ།༽ བསམས་"
    },
    {
      "span": {
        "start": 39449,
        "end": 39456
      },
      "text": "གསད་པར་ ༼ཅོ།༽ གསོད་པར་"
    },
    {
      "span": {
        "start": 39499,
        "end": 39502
      },
      "text": "དག་ ༼པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 40018,
        "end": 40029
      },
      "text": "ལ་སོགས་པའི་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 40773,
        "end": 40777
      },
      "text": "བཏབ་ ༼སྣར།༽ གདབ་"
    },
    {
      "span": {
        "start": 40933,
        "end": 40937
      },
      "text": "ལེན་ ༼སྣར། པེ།༽ ལན་"
    },
    {
      "span": {
        "start": 41022,
        "end": 41025
      },
      "text": "གི་ ༼སྣར། པེ།༽ གི་བློས་"
    },
    {
      "span": {
        "start": 41173,
        "end": 41180
      },
      "text": "འཐབ་མོ་ ༼སྣར། པེ།༽ ཐབ་མོ་"
    },
    {
      "span": {
        "start": 41606,
        "end": 41612
      },
      "text": "བཅད་པ་ ༼སྣར།༽ གཅད་པ་"
    },
    {
      "span": {
        "start": 41846,
        "end": 41853
      },
      "text": "ཐུང་བར་ ༼པེ།༽ འཐུང་བར་"
    },
    {
      "span": {
        "start": 42122,
        "end": 42125
      },
      "text": "རྣ་ ༼སྣར།༽ རྣམ་"
    },
    {
      "span": {
        "start": 42131,
        "end": 42140
      },
      "text": "གྲགས་ཤིང་ ༼སྣར། པེ།༽ གྲག་ཅིང་"
    },
    {
      "span": {
        "start": 42165,
        "end": 42177
      },
      "text": "མཐོ་རིས་ཀྱི་ ༼སྣར། པེ།༽ མཐོ་རིས་ཀྱིས་"
    },
    {
      "span": {
        "start": 42572,
        "end": 42579
      },
      "text": "སྟོན་པ་ ༼སྣར། པེ།༽ བསྟོན་པ་"
    },
    {
      "span": {
        "start": 42717,
        "end": 42722
      },
      "text": "མཉེས་ ༼སྣར། པེ།༽ གཉེས་"
    },
    {
      "span": {
        "start": 43415,
        "end": 43424
      },
      "text": "ཅི་འདྲ་བ་ ༼སྣར། པེ།༽ ཅི་འདྲ་"
    },
    {
      "span": {
        "start": 43631,
        "end": 43647
      },
      "text": "ཅི་འདྲ་བ་དེ་འདྲ་ ༼སྣར། པེ།༽ ཅི་འདྲ་"
    },
    {
      "span": {
        "start": 44102,
        "end": 44108
      },
      "text": "བཅུའི་ ༼སྣར། པེ།༽ བཅུར་"
    },
    {
      "span": {
        "start": 44477,
        "end": 44484
      },
      "text": "ཆེན་པོ་ ༼སྣར། པེ།༽ ཆེན་པོའི་"
    },
    {
      "span": {
        "start": 44558,
        "end": 44571
      },
      "text": "གཤེགས་པ་དེའི་ ༼སྣར། པེ།༽ གཤེགས་པའི་"
    },
    {
      "span": {
        "start": 44704,
        "end": 44713
      },
      "text": "བསྡོམས་པ་ ༼སྣར།༽ བསྡམས་པ་"
    },
    {
      "span": {
        "start": 45256,
        "end": 45265
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 45971,
        "end": 45976
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ རྒྱུན་"
    },
    {
      "span": {
        "start": 46152,
        "end": 46160
      },
      "text": "སྐམ་པའི་ ༼སྣར། པེ།༽ སྐོམ་པའི་"
    },
    {
      "span": {
        "start": 46169,
        "end": 46175
      },
      "text": "འབར་བ། ༼སྣར། པེ།༽ བརྩོན་པ།"
    },
    {
      "span": {
        "start": 46656,
        "end": 46670
      },
      "text": "ཚུལ་ཁྲིམས་ཀྱི་ ༼སྣར། པེ།༽ ཚུལ་ཁྲིམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 46724,
        "end": 46732
      },
      "text": "བརྫི་བར་ ༼སྣར། པེ།༽ རྫི་བར་"
    },
    {
      "span": {
        "start": 46902,
        "end": 46907
      },
      "text": "རྫུས་ ༼སྣར། པེ།༽ བརྫུས་"
    },
    {
      "span": {
        "start": 47514,
        "end": 47521
      },
      "text": "སྔགས་པ་ ༼སྡེ།༽ བསྔགས་པ་"
    },
    {
      "span": {
        "start": 47556,
        "end": 47560
      },
      "text": "བཏང་ ༼སྣར། པེ།༽ གཏོང་"
    },
    {
      "span": {
        "start": 47835,
        "end": 47846
      },
      "text": "ཚོལ་བ་རྣམས་ ༼སྣར། པེ།༽ ཚོལ་བ་"
    },
    {
      "span": {
        "start": 47922,
        "end": 47929
      },
      "text": "གྱུར་པ། ༼སྣར། པེ།༽ གྱུར་ཏེ།"
    },
    {
      "span": {
        "start": 48016,
        "end": 48020
      },
      "text": "བཟད་ ༼སྣར། པེ།༽ ཟད་"
    },
    {
      "span": {
        "start": 48154,
        "end": 48158
      },
      "text": "པའི་ ༼སྣར། པེ།༽ ཞིང་"
    },
    {
      "span": {
        "start": 48483,
        "end": 48491
      },
      "text": "ལྕག་གིས་ ༼སྣར། པེ།༽ ལྕག་"
    },
    {
      "span": {
        "start": 48801,
        "end": 48807
      },
      "text": "བཙལ་བ་ ༼སྣར། པེ།༽ བརྩལ་བ་"
    },
    {
      "span": {
        "start": 49058,
        "end": 49066
      },
      "text": "འཁྲུག་པ་ ༼སྣར། པེ།༽ འཁྲུགས་པ་"
    },
    {
      "span": {
        "start": 49240,
        "end": 49247
      },
      "text": "བྱེད་པ། ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 49650,
        "end": 49664
      },
      "text": "རང་ཞིག་ཅིང་རང་ ༼སྣར། པེ།༽ རང་ཞིག་ཅིང་"
    },
    {
      "span": {
        "start": 50102,
        "end": 50111
      },
      "text": "འཁོར་ལོས་ ༼སྣར། པེ།༽ འཁོར་ལོ་"
    },
    {
      "span": {
        "start": 50446,
        "end": 50455
      },
      "text": "ཚན་པོ་ཆེ་ ༼སྣར། པེ།༽ ཚན་པོ་"
    },
    {
      "span": {
        "start": 50699,
        "end": 50706
      },
      "text": "དབང་པོ་ ༼སྣར། པེ།༽ དངོས་པོ་"
    },
    {
      "span": {
        "start": 50896,
        "end": 50906
      },
      "text": "ཕ་རོལ་གྱི་ ༼སྣར། པེ།༽ ཕ་རོལ་གྱིས་"
    },
    {
      "span": {
        "start": 50933,
        "end": 50942
      },
      "text": "ཚོམ་པོའི་ ༼སྣར། པེ།༽ ཆོམ་པོའི་"
    },
    {
      "span": {
        "start": 51359,
        "end": 51366
      },
      "text": "གཏན་ནས་ ༼སྣར། པེ།༽ གཏན་"
    },
    {
      "span": {
        "start": 51504,
        "end": 51512
      },
      "text": "བཙས་ཤིང་ ༼སྣར། པེ།༽ བཙའ་ཞིང་"
    },
    {
      "span": {
        "start": 51518,
        "end": 51524
      },
      "text": "བཟང་བ་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 51625,
        "end": 51636
      },
      "text": "མདངས་ཕྲོགས་ ༼སྣར། པེ།༽ མདངས་འཕྲོག་"
    },
    {
      "span": {
        "start": 51717,
        "end": 51719
      },
      "text": "ས་ ༼སྣར། པེ།༽ སཱ་"
    },
    {
      "span": {
        "start": 51921,
        "end": 51924
      },
      "text": "ནི། ༼སྣར། པེ།༽ ཎི།"
    },
    {
      "span": {
        "start": 52295,
        "end": 52307
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 53300,
        "end": 53313
      },
      "text": "སྣ་ཚོགས་ཀྱིས་ ༼སྣར། པེ།༽ སྣ་ཚོགས་ཀྱི་"
    },
    {
      "span": {
        "start": 53573,
        "end": 53583
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 53673,
        "end": 53681
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 53718,
        "end": 53724
      },
      "text": "བྱས་ན། ༼སྣར། པེ།༽ བྱས་ནས།"
    },
    {
      "span": {
        "start": 53737,
        "end": 53771
      },
      "text": "ཐམས་ཅད་དང་། ལས་ཀྱི་སྒྲིབ་པ་ཐམས་ཅད་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 53831,
        "end": 53840
      },
      "text": "པར་འགྱུར། ༼པེ།༽ པར་"
    },
    {
      "span": {
        "start": 54024,
        "end": 54028
      },
      "text": "གཟི་ ༼པེ།༽ བཟི་"
    },
    {
      "span": {
        "start": 54099,
        "end": 54106
      },
      "text": "གུས་པར་ ༼པེ།༽ གུད་པར་"
    },
    {
      "span": {
        "start": 54292,
        "end": 54299
      },
      "text": "གཙང་མར་ ༼པེ།༽ གཙང་བར་"
    },
    {
      "span": {
        "start": 54943,
        "end": 54949
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 55079,
        "end": 55089
      },
      "text": "སྙིང་པོའི་ ༼སྣར། པེ།༽ སྙིང་པོ་"
    },
    {
      "span": {
        "start": 55104,
        "end": 55109
      },
      "text": "རྫུས་ ༼སྣར།༽ བརྫུས་"
    },
    {
      "span": {
        "start": 56102,
        "end": 56111
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 56118,
        "end": 56126
      },
      "text": "སྒྲིབ་པ་ ༼སྣར།༽ སྒྲིབས་པ་"
    },
    {
      "span": {
        "start": 56275,
        "end": 56281
      },
      "text": "འགྱུར། ༼སྣར། པེ།༽ འགྱུར། སྐྱེ་བ་དྲན་པར་འགྱུར་"
    },
    {
      "span": {
        "start": 56441,
        "end": 56449
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 57440,
        "end": 57444
      },
      "text": "ཕེབ་ ༼སྣར། པེ།༽ ཕེག་"
    },
    {
      "span": {
        "start": 57529,
        "end": 57536
      },
      "text": "འདྲི་བ་ ༼སྣར། པེ།༽ འབྲི་བ་"
    },
    {
      "span": {
        "start": 57548,
        "end": 57554
      },
      "text": "འདྲིར་ ༼སྣར། པེ།༽ འབྲིར་"
    },
    {
      "span": {
        "start": 58262,
        "end": 58264
      },
      "text": "བ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 58483,
        "end": 58490
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 58723,
        "end": 58730
      },
      "text": "ནས་ཀྱང་ ༼སྣར། པེ།༽ ནས་ཡང་"
    },
    {
      "span": {
        "start": 58917,
        "end": 58925
      },
      "text": "གཏོར་བར་ ༼སྣར། པེ།༽ གཏོང་བར་"
    },
    {
      "span": {
        "start": 58925,
        "end": 58931
      },
      "text": "འགྱུར། ༼སྣར། པེ།༽ འགྱུར་ཏེ།"
    },
    {
      "span": {
        "start": 59192,
        "end": 59197
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 59476,
        "end": 59480
      },
      "text": "གཡང་ ༼སྣར། པེ།༽ གཡངས་"
    },
    {
      "span": {
        "start": 59490,
        "end": 59498
      },
      "text": "ལྟུང་བར་ ༼སྣར། པེ།༽ ལྷུང་བར་"
    },
    {
      "span": {
        "start": 60178,
        "end": 60184
      },
      "text": "སྐྱེས་ ༼སྣར། པེ།༽ སྐྱེ་"
    },
    {
      "span": {
        "start": 60497,
        "end": 60503
      },
      "text": "འགྱུར། ༼སྣར།༽ འགྱུར་རོ།"
    },
    {
      "span": {
        "start": 61329,
        "end": 61333
      },
      "text": "རིག་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 61661,
        "end": 61669
      },
      "text": "བདོག་པས་ ༼པེ།༽ དོག་པས་"
    },
    {
      "span": {
        "start": 61801,
        "end": 61811
      },
      "text": "བསྙེན་གནས་ ༼སྣར། པེ།༽ བསྙེན་གནས་ལ་ཉེ་བར་གནས་"
    },
    {
      "span": {
        "start": 61819,
        "end": 61826
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 61934,
        "end": 61942
      },
      "text": "ཤོག་ཤིག་ ༼སྣར། པེ།༽ ཤོག་ཅིག་"
    },
    {
      "span": {
        "start": 62026,
        "end": 62039
      },
      "text": "རྒྱལ་པོ་དེའི་ ༼སྣར། པེ།༽ རྒྱལ་པོའི་"
    },
    {
      "span": {
        "start": 62103,
        "end": 62107
      },
      "text": "ལྷག་ ༼སྣར། པེ།༽ ལྷགས་"
    },
    {
      "span": {
        "start": 64016,
        "end": 64023
      },
      "text": "དབང་པོ་ ༼སྣར། པེ།༽ དངོས་པོ་"
    },
    {
      "span": {
        "start": 64093,
        "end": 64097
      },
      "text": "གཡང་ ༼སྣར། པེ།༽ གཡངས་"
    },
    {
      "span": {
        "start": 64262,
        "end": 64271
      },
      "text": "ཆོམ་པོའི་ ༼སྣར། པེ།༽ ཆོམ་པོ་ཡིད་"
    },
    {
      "span": {
        "start": 64441,
        "end": 64446
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ སུམ་"
    },
    {
      "span": {
        "start": 65112,
        "end": 65124
      },
      "text": "གཟུགས་བཟང་ལ་ ༼སྣར། པེ།༽ གཟུགས་བཟང་བ་"
    },
    {
      "span": {
        "start": 65557,
        "end": 65571
      },
      "text": "བཀའ་སྩལ་པ་དང་། ༼སྣར། པེ།༽ བཀའ་བསྩལ་པ།། །།"
    },
    {
      "span": {
        "start": 65632,
        "end": 65638
      },
      "text": "ག་ཏ་ས་ ༼སྣར།༽ ག་ཏཱས་ ༼པེ།༽ ག་ཏཱ་"
    },
    {
      "span": {
        "start": 66395,
        "end": 66400
      },
      "text": "སྦྱང་ ༼སྣར། པེ།༽ སྤྱོང་"
    },
    {
      "span": {
        "start": 66537,
        "end": 66543
      },
      "text": "འགྱུར། ༼སྣར།༽ འགྱུར་རོ། །"
    },
    {
      "span": {
        "start": 66552,
        "end": 66559
      },
      "text": "འཛིན་པ་ ༼སྣར། པེ།༽ འཛིན་"
    },
    {
      "span": {
        "start": 66759,
        "end": 66771
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 67009,
        "end": 67015
      },
      "text": "འགྱུར། ༼སྣར།༽ གྱུར།"
    },
    {
      "span": {
        "start": 67019,
        "end": 67028
      },
      "text": "བསམས་པའི་ ༼སྣར། པེ།༽ བསམ་པའི་"
    },
    {
      "span": {
        "start": 67330,
        "end": 67338
      },
      "text": "ཡང་གདའི། ༼སྣར།༽ ཡང་གདེའི་"
    },
    {
      "span": {
        "start": 67573,
        "end": 67576
      },
      "text": "གེ་ ༼སྣར། པེ།༽ གེ་མོ་"
    },
    {
      "span": {
        "start": 67641,
        "end": 67653
      },
      "text": "ཚུལ་བཞིན་དུ་ ༼སྣར། པེ།༽ ཚུལ་བཞིན་"
    },
    {
      "span": {
        "start": 67788,
        "end": 67793
      },
      "text": "ཐོགས་ ༼སྣར། པེ།༽ ཐོག་"
    },
    {
      "span": {
        "start": 68014,
        "end": 68026
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 68251,
        "end": 68257
      },
      "text": "བྲལ་བ་ ༼སྣར། པེ།༽ བྲལ་"
    },
    {
      "span": {
        "start": 68453,
        "end": 68461
      },
      "text": "འཇོམས་པ་ ༼སྣར། པེ།༽ འཇོམ་པ་"
    },
    {
      "span": {
        "start": 68951,
        "end": 68959
      },
      "text": "བརྫི་བར་ ༼སྣར། པེ།༽ རྫི་བར་"
    },
    {
      "span": {
        "start": 69083,
        "end": 69091
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ འགྱུར་བར་"
    },
    {
      "span": {
        "start": 69123,
        "end": 69137
      },
      "text": "སྔོན་གྱི་སྨོན་ ༼སྣར།༽ སྔོན་གྱི་"
    },
    {
      "span": {
        "start": 69673,
        "end": 69687
      },
      "text": "སྣ་ཚོགས་བསྒྲག་ ༼སྣར། པེ།༽ སྣ་ཚོགས་སུ་བསྒྲགས་"
    },
    {
      "span": {
        "start": 69748,
        "end": 69757
      },
      "text": "བསྒྲག་པར་ ༼སྣར། པེ།༽ བསྒྲགས་པར་"
    },
    {
      "span": {
        "start": 70009,
        "end": 70015
      },
      "text": "ཕྲོགས་ ༼སྣར། པེ།༽ འཕྲོག་"
    },
    {
      "span": {
        "start": 70107,
        "end": 70115
      },
      "text": "ཡང་དག་པ་ ༼སྣར། པེ།༽ ཡང་དག་པར་"
    },
    {
      "span": {
        "start": 70880,
        "end": 70887
      },
      "text": "འགུམ་པ་ ༼པེ།༽ འགུལ་པ་"
    },
    {
      "span": {
        "start": 70932,
        "end": 70936
      },
      "text": "སྣག་ ༼སྣར། པེ།༽ རྣག་"
    },
    {
      "span": {
        "start": 71563,
        "end": 71568
      },
      "text": "ལྡོག་ ༼སྣར། པེ།༽ ལོག་"
    },
    {
      "span": {
        "start": 71625,
        "end": 71633
      },
      "text": "གནས་དེར་ ༼སྣར། པེ།༽ གནས་"
    },
    {
      "span": {
        "start": 72019,
        "end": 72023
      },
      "text": "ཉིན་ ༼སྣར། པེ།༽ ཉིན་བདུན་མཚན་"
    },
    {
      "span": {
        "start": 72691,
        "end": 72699
      },
      "text": "ནད་ཀྱིས་ ༼སྣར། པེ།༽ ནད་ཀྱི་"
    },
    {
      "span": {
        "start": 72901,
        "end": 72906
      },
      "text": "གྱུར་ ༼སྣར།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 72953,
        "end": 72961
      },
      "text": "སེམས་ཅན་ ༼སྣར། པེ།༽ སེམས་ཅན་ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 73004,
        "end": 73011
      },
      "text": "གཏང་བར་ ༼སྣར། པེ།༽ བཏང་བར་"
    },
    {
      "span": {
        "start": 73018,
        "end": 73021
      },
      "text": "གང་ ༼སྣར། པེ།༽ གོང་"
    },
    {
      "span": {
        "start": 73096,
        "end": 73107
      },
      "text": "དེ་ལྟ་བུའི་ ༼སྣར། པེ།༽ དེ་ལྟ་བུ་"
    },
    {
      "span": {
        "start": 73232,
        "end": 73244
      },
      "text": "ཁྱད་པར་གྱིས། ༼པེ།༽ ཁྱད་པར་གྱི།"
    },
    {
      "span": {
        "start": 74017,
        "end": 74022
      },
      "text": "བརླབ་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 74192,
        "end": 74197
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 74261,
        "end": 74273
      },
      "text": "ཆོས་སོང་བའི་ ༼སྣར།༽ ཆོས་སྐྱོང་བའི་ ༼པེ།༽ ཆོས་སྐྱོང་བ་"
    },
    {
      "span": {
        "start": 74282,
        "end": 74288
      },
      "text": "བསྙེན་ ༼སྣར། པེ།༽ སྙེན་"
    },
    {
      "span": {
        "start": 74449,
        "end": 74454
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 74622,
        "end": 74632
      },
      "text": "མདངས་གསོལ་ ༼སྣར། པེ།༽ མདོང་གསོལ་"
    },
    {
      "span": {
        "start": 74709,
        "end": 74713
      },
      "text": "གྱི་ ༼སྣར། པེ།༽ གྱི་སྔོན་གྱི་"
    },
    {
      "span": {
        "start": 74915,
        "end": 74926
      },
      "text": "གཡོགས་འཁོར་ ༼སྣར། པེ།༽ གཡོག་འཁོར་"
    },
    {
      "span": {
        "start": 75215,
        "end": 75224
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 75318,
        "end": 75325
      },
      "text": "དགོན་པ་ ༼སྣར། པེ།༽ གནོད་པ་"
    },
    {
      "span": {
        "start": 75986,
        "end": 75993
      },
      "text": "འདྲི་བ་ ༼སྣར། པེ།༽ འབྲི་བ་"
    },
    {
      "span": {
        "start": 76005,
        "end": 76011
      },
      "text": "འདྲིར་ ༼སྣར། པེ།༽ འབྲིར་"
    },
    {
      "span": {
        "start": 76379,
        "end": 76383
      },
      "text": "ཕྱག་ ༼སྣར། པེ།༽ ལག་"
    },
    {
      "span": {
        "start": 76474,
        "end": 76482
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 76520,
        "end": 76527
      },
      "text": "སྩལ་བར་ ༼སྣར། པེ།༽ བསྩལ་བར་"
    },
    {
      "span": {
        "start": 77157,
        "end": 77163
      },
      "text": "འདྲིར་ ༼སྣར། པེ།༽ འབྲིར་"
    },
    {
      "span": {
        "start": 77687,
        "end": 77693
      },
      "text": "ཕྱིའི་ ༼སྣར། པེ།༽ ཕྱི་མའི་"
    },
    {
      "span": {
        "start": 77785,
        "end": 77793
      },
      "text": "མཐོང་བར་ ༼སྣར། པེ།༽ མཐོང་བ་"
    },
    {
      "span": {
        "start": 77806,
        "end": 77815
      },
      "text": "འཕེལ་བའི་ ༼སྣར། པེ།༽ འབེལ་བའི་"
    },
    {
      "span": {
        "start": 78066,
        "end": 78071
      },
      "text": "བསྐང་ ༼སྣར། པེ།༽ བཀང་"
    },
    {
      "span": {
        "start": 78275,
        "end": 78280
      },
      "text": "གསུང་ ༼སྣར།༽ གསུངས་"
    },
    {
      "span": {
        "start": 78586,
        "end": 78595
      },
      "text": "སེམས་པའི་ ༼པེ།༽ སེམས་"
    },
    {
      "span": {
        "start": 78703,
        "end": 78708
      },
      "text": "བསངས་ ༼སྣར། པེ།༽ གངས་"
    },
    {
      "span": {
        "start": 78835,
        "end": 78839
      },
      "text": "ཆུས་ ༼སྣར། པེ།༽ ཆུ་"
    },
    {
      "span": {
        "start": 79079,
        "end": 79085
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ བསྒྱུར་"
    },
    {
      "span": {
        "start": 79893,
        "end": 79906
      },
      "text": "སྡེ་དཔོན་ཆེན་ ༼སྣར།༽ སྡེ་དཔོན་"
    },
    {
      "span": {
        "start": 80457,
        "end": 80468
      },
      "text": "གནོད་སྦྱིན་ ༼སྣར། པེ།༽ གནོད་སྦྱིན་བདུན་འབུམ་"
    },
    {
      "span": {
        "start": 81058,
        "end": 81061
      },
      "text": "གང་ ༼སྣར།༽ གང་ན་"
    },
    {
      "span": {
        "start": 81419,
        "end": 81424
      },
      "text": "ཁྱོད་ ༼སྣར། པེ།༽ ཁྱེད་"
    },
    {
      "span": {
        "start": 81552,
        "end": 81555
      },
      "text": "སོ་ ༼སྣར། པེ།༽ སོ་ལེགས་སོ་"
    },
    {
      "span": {
        "start": 81620,
        "end": 81630
      },
      "text": "ཕོ་བྲང་གི་ ༼སྣར།༽ ཕོ་བྲང་གིས་"
    },
    {
      "span": {
        "start": 81691,
        "end": 81699
      },
      "text": "བརྩོ་བས་ ༼སྣར། པེ།༽ རྩེ་བས་"
    },
    {
      "span": {
        "start": 81812,
        "end": 81824
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼པེ།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 82091,
        "end": 82097
      },
      "text": "ནད་དང་ ༼སྣར། པེ།༽ ནད་"
    },
    {
      "span": {
        "start": 82143,
        "end": 82151
      },
      "text": "རུངས་པར་ ༼སྣར། པེ།༽ རུང་བར་"
    },
    {
      "span": {
        "start": 82248,
        "end": 82253
      },
      "text": "གདོན་ ༼སྣར། པེ།༽ བདོན་"
    },
    {
      "span": {
        "start": 82349,
        "end": 82357
      },
      "text": "འདས་པའམ། ༼སྣར། པེ།༽ གདས་པ་དང་།"
    },
    {
      "span": {
        "start": 82376,
        "end": 82385
      },
      "text": "གྱུར་པའམ། ༼སྣར། པེ།༽ གྱུར་པ་དང་།"
    },
    {
      "span": {
        "start": 82403,
        "end": 82406
      },
      "text": "ཚན་ ༼སྣར།༽ མཚན་"
    },
    {
      "span": {
        "start": 82522,
        "end": 82531
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 82821,
        "end": 82828
      },
      "text": "སླན་ཆད་ ༼སྣར། པེ།༽ སླན་ཆད་ཀྱང་"
    },
    {
      "span": {
        "start": 83051,
        "end": 83058
      },
      "text": "བྱུང་བ་ ༼སྣར། པེ།༽ ཕྱུང་བ་"
    },
    {
      "span": {
        "start": 83397,
        "end": 83410
      },
      "text": "སྣ་ཚོགས་ཀྱིས་ ༼པེ།༽ སྣ་ཚོགས་ཀྱི་"
    },
    {
      "span": {
        "start": 83596,
        "end": 83604
      },
      "text": "སྨོན་ལམ་ ༼སྣར། པེ།༽ སྨོན་ལམ་གྱི་"
    },
    {
      "span": {
        "start": 83935,
        "end": 83940
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 84009,
        "end": 84019
      },
      "text": "མཁྱེན་ཉིད་ ༼སྣར། པེ།༽ མཁྱེན་ཅིང་"
    },
    {
      "span": {
        "start": 84050,
        "end": 84060
      },
      "text": "ཐུགས་ཀྱིས་ ༼སྣར། པེ།༽ ཐུགས་ཀྱི་"
    },
    {
      "span": {
        "start": 84239,
        "end": 84251
      },
      "text": "འབྱུང་བ་བའི་ ༼སྣར། པེ།༽ འབྱུང་བའི་"
    },
    {
      "span": {
        "start": 84396,
        "end": 84401
      },
      "text": "ཐོགས་ ༼སྣར། པེ།༽ ཐོག་"
    },
    {
      "span": {
        "start": 84414,
        "end": 84422
      },
      "text": "དཔག་སྟེ་ ༼སྣར། པེ།༽ དཔགས་ཏེ་"
    },
    {
      "span": {
        "start": 84517,
        "end": 84522
      },
      "text": "ཆོ་ག་ ༼སྡེ།༽ ཚོག་"
    },
    {
      "span": {
        "start": 84559,
        "end": 84564
      },
      "text": "བརླབ་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 84623,
        "end": 84643
      },
      "text": "ཐམས་ཅད་ཀྱི་དོན་འཔྲལ་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱིས་འཔྲལ་"
    },
    {
      "span": {
        "start": 85011,
        "end": 85015
      },
      "text": "གྱི་ ༼སྣར། པེ།༽ གྱི་སྔོན་གྱི་"
    },
    {
      "span": {
        "start": 85340,
        "end": 85345
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 85448,
        "end": 85455
      },
      "text": "བསྒྲགས་ ༼སྣར།༽ སྒྲགས་"
    },
    {
      "span": {
        "start": 85822,
        "end": 85831
      },
      "text": "སྤྱན་སྔར་ ༼སྣར། པེ།༽ སྤྱན་སྔར་དེང་འདིར་"
    },
    {
      "span": {
        "start": 85973,
        "end": 85982
      },
      "text": "གྱི་རླབས་ ༼སྣར།༽ གྱིས་བརླབས་ ༼པེ།༽ གྱིས་བརླབ་"
    },
    {
      "span": {
        "start": 86005,
        "end": 86013
      },
      "text": "ནས་ཀྱིས་ ༼སྣར། པེ།༽ ནས་ཀྱི་"
    },
    {
      "span": {
        "start": 86017,
        "end": 86021
      },
      "text": "མ་མ་ ༼སྣར།༽ མ་"
    },
    {
      "span": {
        "start": 86081,
        "end": 86088
      },
      "text": "ཐམས་ཅད་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཞུ་"
    },
    {
      "span": {
        "start": 86168,
        "end": 86174
      },
      "text": "བཙན་པ་ ༼སྣར། པེ།༽ བརྩན་པ་"
    },
    {
      "span": {
        "start": 86390,
        "end": 86394
      },
      "text": "འཕང་ ༼སྣར། པེ།༽ འཕངས་"
    },
    {
      "span": {
        "start": 86453,
        "end": 86459
      },
      "text": "ནང་གི་ ༼སྣར། པེ།༽ ནང་"
    },
    {
      "span": {
        "start": 86619,
        "end": 86623
      },
      "text": "ཉེས་ ༼སྡེ།༽ ཉས་"
    },
    {
      "span": {
        "start": 86678,
        "end": 86687
      },
      "text": "ཅི་ཡང་མི་ ༼པེ།༽ ཅི་ཡང་"
    },
    {
      "span": {
        "start": 87261,
        "end": 87266
      },
      "text": "བཟངས་ ༼སྣར།༽ བཟང་"
    },
    {
      "span": {
        "start": 87933,
        "end": 87941
      },
      "text": "ཆུང་ཞིང་ ༼སྣར། པེ།༽ ཆུངས་ཤིང་"
    },
    {
      "span": {
        "start": 88331,
        "end": 88343
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 88545,
        "end": 88554
      },
      "text": "བསྔོ་བའི་ ༼སྣར། པེ།༽ སྔོ་བའི་"
    },
    {
      "span": {
        "start": 88861,
        "end": 88866
      },
      "text": "སཏྭས། ༼སྣར། པེ།༽ སཏྭས་མཛད་པ།"
    }
  ]
}