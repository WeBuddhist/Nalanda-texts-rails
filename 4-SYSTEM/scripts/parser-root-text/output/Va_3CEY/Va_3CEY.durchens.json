{
  "durchens": [
    {
      "span": {
        "start": 410,
        "end": 416
      },
      "text": "ངག་དག་ ༼སྣར། པེ།༽ གང་དག་"
    },
    {
      "span": {
        "start": 831,
        "end": 836
      },
      "text": "འཆིས་ ༼སྣར།༽ མཆིས་"
    },
    {
      "span": {
        "start": 847,
        "end": 856
      },
      "text": "བརྟན་པའི་ ༼སྣར། པེ།༽ བསྟན་པའི་"
    },
    {
      "span": {
        "start": 993,
        "end": 1008
      },
      "text": "དུད་པས་བདུགས། ། ༼སྣར།༽ དུ་བས་འདུག ། ༼པེ།༽ དུ་བས་བདུག །"
    },
    {
      "span": {
        "start": 1097,
        "end": 1101
      },
      "text": "དེར་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 1181,
        "end": 1183
      },
      "text": "བ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 1478,
        "end": 1480
      },
      "text": "ཟ་ ༼སྣར། པེ།༽ ཟད་"
    },
    {
      "span": {
        "start": 1489,
        "end": 1496
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 1723,
        "end": 1730
      },
      "text": "འདི་ཡི་ ༼སྣར། པེ།༽ འདི་ཡིས་"
    },
    {
      "span": {
        "start": 1754,
        "end": 1768
      },
      "text": "གནས་ཚུལ་ཁྲིམས་ ༼སྣར། པེ།༽ འགས་ཤེས་རབ་"
    },
    {
      "span": {
        "start": 1843,
        "end": 1851
      },
      "text": "སྐྱེ་བོ་ ༼སྣར། པེ།༽ སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 2178,
        "end": 2185
      },
      "text": "བྱས་པས་ ༼སྣར། པེ།༽ བྱས་པ་"
    },
    {
      "span": {
        "start": 2208,
        "end": 2215
      },
      "text": "སྨྲ་བྱ་ ༼སྣར། པེ།༽ སྨྲ་བ་"
    },
    {
      "span": {
        "start": 2288,
        "end": 2297
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 2322,
        "end": 2328
      },
      "text": "དག་གི་ ༼སྣར། པེ།༽ དག་ནི་"
    },
    {
      "span": {
        "start": 2473,
        "end": 2480
      },
      "text": "དགྲ་མི་ ༼སྣར། པེ།༽ དགྲ་མ་"
    },
    {
      "span": {
        "start": 2793,
        "end": 2797
      },
      "text": "འདི་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 2876,
        "end": 2883
      },
      "text": "འཐོར་བ་ ༼སྣར། པེ།༽ མཐོར་བ་"
    },
    {
      "span": {
        "start": 3070,
        "end": 3076
      },
      "text": "འཛད་པ་ ༼སྣར།༽ མཛད་པ་"
    },
    {
      "span": {
        "start": 3112,
        "end": 3121
      },
      "text": "འདུས་པའི་ ༼སྣར། པེ།༽ འདུ་བའི་"
    },
    {
      "span": {
        "start": 3194,
        "end": 3200
      },
      "text": "འགྱུར། ༼སྣར། པེ།༽ གྱུར།"
    },
    {
      "span": {
        "start": 3485,
        "end": 3491
      },
      "text": "ཞུས། ། ༼པེ།༽ ། །དགེའོ། །"
    }
  ]
}