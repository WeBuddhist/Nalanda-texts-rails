{
  "durchens": [
    {
      "span": {
        "start": 76,
        "end": 83
      },
      "text": "འཕགས་མ་ ༼སྣར། པེ།༽ འཕགས་པ་"
    },
    {
      "span": {
        "start": 250,
        "end": 254
      },
      "text": "ལུས་ ༼སྣར། པེ།༽ ལུང་"
    },
    {
      "span": {
        "start": 391,
        "end": 398
      },
      "text": "གཅི་བས་ ༼སྣར། པེ།༽ ལྕི་བ་"
    },
    {
      "span": {
        "start": 707,
        "end": 710
      },
      "text": "ཙུ་ ༼སྣར། པེ།༽ ཙཱུ་"
    },
    {
      "span": {
        "start": 752,
        "end": 755
      },
      "text": "ལྔ་ ༼སྣར། པེ།༽ ལྔའི་སྣ་"
    },
    {
      "span": {
        "start": 1485,
        "end": 1490
      },
      "text": "འབྲང་ ༼སྣར།༽ འབྲངས་"
    },
    {
      "span": {
        "start": 1661,
        "end": 1666
      },
      "text": "བདུག་ ༼སྣར། པེ།༽ བདུགས་"
    },
    {
      "span": {
        "start": 1841,
        "end": 1853
      },
      "text": "ཕྱོགས་སྐྱོང་ ༼སྣར། པེ།༽ ཕྱོགས་སྐྱོང་བ་"
    },
    {
      "span": {
        "start": 2074,
        "end": 2082
      },
      "text": "བརྩམ་པར་ ༼སྣར། པེ།༽ བརྩམས་པར་"
    },
    {
      "span": {
        "start": 2082,
        "end": 2089
      },
      "text": "བྱས་ཏེ། ༼སྣར། པེ།༽ བྱ་སྟེ།"
    },
    {
      "span": {
        "start": 2128,
        "end": 2136
      },
      "text": "ཡི་གེ་ལ་ ༼སྣར། པེ།༽ ཡི་གེ་"
    },
    {
      "span": {
        "start": 2857,
        "end": 2861
      },
      "text": "གརྦ་ ༼སྣར། པེ།༽ བྷ་ག་"
    },
    {
      "span": {
        "start": 3002,
        "end": 3008
      },
      "text": "ཡ་བ་ལ་ ༼སྣར། པེ།༽ ཡ་"
    },
    {
      "span": {
        "start": 3017,
        "end": 3020
      },
      "text": "ནེ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 3126,
        "end": 3136
      },
      "text": "པྲ་བ་ར་བི་ ༼སྣར། པེ།༽ པྲ་རི་"
    },
    {
      "span": {
        "start": 3204,
        "end": 3211
      },
      "text": "ཨོཾ་བི་ ༼སྣར། པེ།༽ ཨོཾ་བོ་"
    },
    {
      "span": {
        "start": 3214,
        "end": 3219
      },
      "text": "ལ་བི་ ༼སྣར། པེ།༽ ལ་གི་"
    },
    {
      "span": {
        "start": 3295,
        "end": 3297
      },
      "text": "ར་ ༼སྣར། པེ།༽ རྭ་"
    },
    {
      "span": {
        "start": 3628,
        "end": 3631
      },
      "text": "འི་ ༼སྣར། པེ།༽ ཧྲཱིལི་"
    },
    {
      "span": {
        "start": 3900,
        "end": 3903
      },
      "text": "ཏྲ་ ༼སྣར། པེ།༽ དྲ་"
    },
    {
      "span": {
        "start": 4140,
        "end": 4146
      },
      "text": "གེ་ལེ་ ༼སྣར། པེ།༽ ག་ལེ་"
    },
    {
      "span": {
        "start": 4162,
        "end": 4168
      },
      "text": "མཱ་ལི་ ༼སྣར། པེ།༽ མཱ་མ་"
    },
    {
      "span": {
        "start": 4293,
        "end": 4295
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་བ་"
    },
    {
      "span": {
        "start": 4428,
        "end": 4431
      },
      "text": "སྱ་ ༼སྣར། པེ།༽ སྱེ་"
    },
    {
      "span": {
        "start": 4550,
        "end": 4558
      },
      "text": "ཀ་ལི་ནི་ ༼སྣར། པེ།༽ ཀ་ལི་"
    },
    {
      "span": {
        "start": 4675,
        "end": 4680
      },
      "text": "ཏ་ཛི་ ༼སྣར། པེ།༽ ཏ་"
    },
    {
      "span": {
        "start": 4902,
        "end": 4911
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 5538,
        "end": 5543
      },
      "text": "བྱའི་ ༼སྣར།༽ འཇུག་"
    }
  ]
}