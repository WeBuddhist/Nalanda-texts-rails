{
  "durchens": [
    {
      "span": {
        "start": 50,
        "end": 57
      },
      "text": "རྙེད་པ་ ༼སྣར།༽ སྙེད་པ་"
    },
    {
      "span": {
        "start": 124,
        "end": 132
      },
      "text": "རི་འཛིན་ ༼སྣར།༽ རིག་འཛིན་"
    },
    {
      "span": {
        "start": 381,
        "end": 388
      },
      "text": "དེ་ཡིས་ ༼སྣར།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 433,
        "end": 436
      },
      "text": "རར་ ༼སྣར།༽ ར་"
    },
    {
      "span": {
        "start": 442,
        "end": 448
      },
      "text": "འཚོགས་ ༼སྣར།༽ མཚོགས་"
    },
    {
      "span": {
        "start": 982,
        "end": 987
      },
      "text": "ངོགས་ ༼སྣར།༽ ངོས་"
    },
    {
      "span": {
        "start": 997,
        "end": 1004
      },
      "text": "ཐོགས་མ་ ༼སྣར།༽ ཐོག་མ་"
    },
    {
      "span": {
        "start": 1184,
        "end": 1188
      },
      "text": "ཡིན། ༼སྣར།༽ ཡི།"
    },
    {
      "span": {
        "start": 1437,
        "end": 1447
      },
      "text": "ཡིས་ཆོ་གས་ ༼སྣར།༽ ཡི་གོ་ཆས་"
    },
    {
      "span": {
        "start": 1495,
        "end": 1501
      },
      "text": "དེ་ནས་ ༼སྣར།༽ དེ་ནས་ས་"
    },
    {
      "span": {
        "start": 1638,
        "end": 1648
      },
      "text": "སྦྱིན་གྱི་ ༼སྣར།༽ སྦྱིན་གྱིས་"
    },
    {
      "span": {
        "start": 1929,
        "end": 1938
      },
      "text": "དགོས་པའི་ ༼སྣར།༽ དགོད་པའི་"
    },
    {
      "span": {
        "start": 2107,
        "end": 2114
      },
      "text": "དབང་པོ་ ༼སྣར།༽ དབང་པོར་"
    },
    {
      "span": {
        "start": 2258,
        "end": 2262
      },
      "text": "བཞག་ ༼སྣར།༽ གཞག་"
    },
    {
      "span": {
        "start": 2399,
        "end": 2403
      },
      "text": "ཚིག་ ༼སྣར།༽ མིག་"
    },
    {
      "span": {
        "start": 2415,
        "end": 2420
      },
      "text": "སྔགས་ ༼པེ།༽ སྔག་"
    },
    {
      "span": {
        "start": 2440,
        "end": 2444
      },
      "text": "ལུས་ ༼སྣར།༽ འདུ་"
    },
    {
      "span": {
        "start": 2474,
        "end": 2479
      },
      "text": "འདིར་ ༼སྣར།༽ འདི་"
    },
    {
      "span": {
        "start": 2496,
        "end": 2505
      },
      "text": "ཡིད་ཀྱིས་ ༼སྣར།༽ ཡིད་ཀྱི་"
    },
    {
      "span": {
        "start": 2610,
        "end": 2620
      },
      "text": "མཚོན་བྱའི་ ༼སྣར།༽ མཚོན་ཆའི་"
    },
    {
      "span": {
        "start": 2733,
        "end": 2737
      },
      "text": "བསལ་ ༼སྣར།༽ གསར་"
    },
    {
      "span": {
        "start": 2754,
        "end": 2764
      },
      "text": "བསྟན་གཅིག་ ༼སྣར།༽ སྟན་གཅིག་"
    },
    {
      "span": {
        "start": 3017,
        "end": 3028
      },
      "text": "བཞིན་དུ་བྱ། ༼སྣར།༽ བཞིན་དུ།"
    },
    {
      "span": {
        "start": 3217,
        "end": 3225
      },
      "text": "ཟིན་པའི་ ༼སྣར།༽ ཟིན་པའི་འོག་"
    },
    {
      "span": {
        "start": 3282,
        "end": 3285
      },
      "text": "གང་ ༼སྣར།༽ གང་གིས་རང་"
    },
    {
      "span": {
        "start": 3478,
        "end": 3486
      },
      "text": "བཏུངས་ན། ༼སྣར།༽ བཏུངས་ནས།"
    },
    {
      "span": {
        "start": 3542,
        "end": 3550
      },
      "text": "སྨྲས་པས་ ༼སྣར།༽ སྨྲ་བས་"
    },
    {
      "span": {
        "start": 3687,
        "end": 3689
      },
      "text": "ལ་ ༼སྣར།༽ ལས་"
    },
    {
      "span": {
        "start": 4323,
        "end": 4327
      },
      "text": "བཞག་ ༼སྣར།༽ གཞན་"
    },
    {
      "span": {
        "start": 4555,
        "end": 4560
      },
      "text": "བཟངས་ ༼སྣར།༽ བཟང་"
    },
    {
      "span": {
        "start": 4665,
        "end": 4669
      },
      "text": "བཞག་ ༼སྣར།༽ གཞན་"
    },
    {
      "span": {
        "start": 4683,
        "end": 4687
      },
      "text": "ཕྱེ། ༼སྡེ། ཅོ། པེ།༽ ཕྱེད།"
    },
    {
      "span": {
        "start": 4742,
        "end": 4747
      },
      "text": "བྱུང་ ༼སྣར།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 4842,
        "end": 4846
      },
      "text": "བསལ་ ༼སྣར།༽ བསལ་བའི་"
    },
    {
      "span": {
        "start": 4970,
        "end": 4978
      },
      "text": "འཁོར་ལོ་ ༼སྣར།༽ འཁོར་ལོའི་"
    },
    {
      "span": {
        "start": 5041,
        "end": 5049
      },
      "text": "བཅས་པའི་ ༼སྣར།༽ བཅས་པར་"
    },
    {
      "span": {
        "start": 5352,
        "end": 5358
      },
      "text": "རིང་ན་ ༼སྣར།༽ རང་ནི་"
    },
    {
      "span": {
        "start": 5398,
        "end": 5405
      },
      "text": "ལ་འབྲས་ ༼སྣར།༽ ལས་འབྲས་"
    },
    {
      "span": {
        "start": 5645,
        "end": 5650
      },
      "text": "མགུལ་ ༼སྣར།༽ མགུར་"
    },
    {
      "span": {
        "start": 5761,
        "end": 5769
      },
      "text": "འཚལ་རིས་ ༼སྣར།༽ མཚལ་རིས་"
    },
    {
      "span": {
        "start": 5886,
        "end": 5891
      },
      "text": "སྤྱད་ ༼སྣར།༽ སྦྱང་"
    },
    {
      "span": {
        "start": 6145,
        "end": 6149
      },
      "text": "རྟག་ ༼སྣར།༽ ཏག་"
    },
    {
      "span": {
        "start": 6260,
        "end": 6264
      },
      "text": "གསར་ ༼སྣར།༽ སར་"
    },
    {
      "span": {
        "start": 6271,
        "end": 6277
      },
      "text": "དང་ཡང་ ༼སྣར།༽ དང་པ་"
    },
    {
      "span": {
        "start": 6328,
        "end": 6338
      },
      "text": "གཞོན་ནུའི་ ༼སྣར།༽ གཞོན་ནུ་"
    },
    {
      "span": {
        "start": 6552,
        "end": 6559
      },
      "text": "དེ་ཡིས་ ༼སྣར།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 6590,
        "end": 6595
      },
      "text": "རིགས་ ༼སྣར།༽ བྱ་"
    },
    {
      "span": {
        "start": 6811,
        "end": 6827
      },
      "text": "དེ་བཞིན་པད་མོའི་ ༼སྣར།༽ དེ་བཞིནཔདྨའི་ ༼པེ།༽ དེ་བཞིནཔད་མོའི་"
    },
    {
      "span": {
        "start": 6858,
        "end": 6861
      },
      "text": "དག་ ༼སྣར།༽ བདག་"
    },
    {
      "span": {
        "start": 7055,
        "end": 7062
      },
      "text": "སྒྲུབས་ ༼སྣར།༽ བསྒྲུབས་"
    },
    {
      "span": {
        "start": 7081,
        "end": 7087
      },
      "text": "བསྙེན་ ༼སྣར།༽ བསྙེན་པ་ལ་"
    },
    {
      "span": {
        "start": 7354,
        "end": 7362
      },
      "text": "ཚན་མོའི་ ༼སྣར།༽ མཚན་མོའི་"
    },
    {
      "span": {
        "start": 7417,
        "end": 7427
      },
      "text": "འགྲུབ་པའི་ ༼སྣར།༽ གྲུབ་པའི་"
    },
    {
      "span": {
        "start": 7495,
        "end": 7501
      },
      "text": "གཟུགས་ ༼སྣར།༽ ལུས་"
    },
    {
      "span": {
        "start": 7816,
        "end": 7821
      },
      "text": "འདིར་ ༼སྣར།༽ འདི་"
    },
    {
      "span": {
        "start": 8585,
        "end": 8588
      },
      "text": "ནི་ ༼སྣར།༽ ན་"
    },
    {
      "span": {
        "start": 8812,
        "end": 8818
      },
      "text": "གཙོ་མ་ ༼སྣར།༽ བཙོ་མ་"
    },
    {
      "span": {
        "start": 8978,
        "end": 8982
      },
      "text": "བཞག་ ༼སྣར།༽ གཞག་"
    },
    {
      "span": {
        "start": 9057,
        "end": 9064
      },
      "text": "མཁས་པས་ ༼སྣར།༽ མཁས་པ་"
    },
    {
      "span": {
        "start": 9261,
        "end": 9270
      },
      "text": "འགྲུབ་པར་ ༼སྣར།༽ བསྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 9360,
        "end": 9366
      },
      "text": "བསྐུས་ ༼སྣར།༽ བཀུས་"
    },
    {
      "span": {
        "start": 9706,
        "end": 9709
      },
      "text": "དག་ ༼སྣར།༽ བདག་"
    },
    {
      "span": {
        "start": 9773,
        "end": 9784
      },
      "text": "གཞན་དག་གིས་ ༼སྣར།༽ གཞན་དག་གི་"
    },
    {
      "span": {
        "start": 9855,
        "end": 9859
      },
      "text": "ཤུལ་ ༼སྣར།༽ ཤཱུལ་"
    },
    {
      "span": {
        "start": 9923,
        "end": 9933
      },
      "text": "སྒྲུབ་པའི་ ༼སྣར།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 9993,
        "end": 9999
      },
      "text": "ཕྱི་མ་ ༼སྣར།༽ ཕྱེ་མ་"
    },
    {
      "span": {
        "start": 10125,
        "end": 10127
      },
      "text": "བ་ ༼སྣར།༽ ལ་"
    },
    {
      "span": {
        "start": 10357,
        "end": 10368
      },
      "text": "ཐོག་མར་ཡིས་ ༼སྣར།༽ ཐོག་མར་ཡིད་"
    },
    {
      "span": {
        "start": 10559,
        "end": 10575
      },
      "text": "དཔྱད་པ་རྫོགས་སོ། ༼པེ།༽ དཔྱད་རྫོགས།"
    }
  ]
}