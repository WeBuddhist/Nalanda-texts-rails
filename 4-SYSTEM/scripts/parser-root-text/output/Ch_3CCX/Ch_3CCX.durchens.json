    {
      "span": {
        "start": 30436,
        "end": 30444
      },
      "text": "གཞག་པའི་ ༼སྣར། པེ།༽ བཞག་པའི་"
    },
    {
      "span": {
        "start": 31062,
        "end": 31068
      },
      "text": "རྟག་པ་ ༼སྣར། པེ།༽ བརྟག་པ་"
    },
    {
      "span": {
        "start": 31313,
        "end": 31322
      },
      "text": "རྫས་རྗེས་ ༼སྣར།༽ རྫས་"
