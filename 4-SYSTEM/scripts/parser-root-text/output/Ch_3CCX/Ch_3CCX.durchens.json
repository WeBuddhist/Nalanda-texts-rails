{
  "durchens": [
    {
      "span": {
        "start": 35,
        "end": 37
      },
      "text": "ཀ་ ༼སྣར། པེ།༽ ཀཱ་"
    },
    {
      "span": {
        "start": 347,
        "end": 358
      },
      "text": "ཕུང་པོ་དང་། ༼སྣར།༽ ཕུང་པོའི།"
    },
    {
      "span": {
        "start": 720,
        "end": 733
      },
      "text": "བཅོ་བརྒྱད་དག་ ༼སྣར། པེ།༽ བཅོ་བརྒྱད་"
    },
    {
      "span": {
        "start": 1126,
        "end": 1131
      },
      "text": "བྱའོ། ༼སྣར།༽ བྱ་བའོ།"
    },
    {
      "span": {
        "start": 2280,
        "end": 2283
      },
      "text": "ནི་ ༼སྣར།༽ ནྀ་"
    },
    {
      "span": {
        "start": 2309,
        "end": 2318
      },
      "text": "ལས་སྐྱེད་ ༼སྣར། པེ།༽ ལ་བསྐྱེད་"
    },
    {
      "span": {
        "start": 2947,
        "end": 2956
      },
      "text": "ཡིན་པ་དེ་ ༼སྣར། པེ།༽ ཡིན་པའི་"
    },
    {
      "span": {
        "start": 3613,
        "end": 3624
      },
      "text": "དེའི་མ་རིག་ ༼སྣར།༽ དེའི་མེའི་ ༼པེ།༽ དེའི་མའི་"
    },
    {
      "span": {
        "start": 3659,
        "end": 3669
      },
      "text": "གྱུར་པ་ལས་ ༼སྣར། པེ།༽ འགྱུར་བས་"
    },
    {
      "span": {
        "start": 4001,
        "end": 4007
      },
      "text": "པགས་པ་ ༼སྣར། པེ།༽ ལྤགས་པ་"
    },
    {
      "span": {
        "start": 4090,
        "end": 4096
      },
      "text": "ཅེ་རེ་ ༼སྣར། པེ།༽ ཅེར་རེ་"
    },
    {
      "span": {
        "start": 4116,
        "end": 4121
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 4190,
        "end": 4197
      },
      "text": "མིག་གི་ ༼སྣར། པེ།༽ མིག་ལ་"
    },
    {
      "span": {
        "start": 4343,
        "end": 4349
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 4555,
        "end": 4563
      },
      "text": "དང་པོའི་ ༼སྣར། པེ།༽ དང་བའོ་"
    },
    {
      "span": {
        "start": 5916,
        "end": 5931
      },
      "text": "རང་བཞིན་གྱི་རང་ ༼སྣར། པེ།༽ རང་"
    },
    {
      "span": {
        "start": 6926,
        "end": 6929
      },
      "text": "དེ། ༼སྣར། པེ།༽ དོ། །"
    },
    {
      "span": {
        "start": 6957,
        "end": 6964
      },
      "text": "ཆེན་པོ་ ༼སྣར། པེ།༽ ཆེན་པོའི་"
    },
    {
      "span": {
        "start": 7401,
        "end": 7410
      },
      "text": "ཆེན་པོའི་ ༼སྣར། པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 7510,
        "end": 7517
      },
      "text": "ངེས་པར་ ༼སྣར། པེ།༽ ངེས་པ་"
    },
    {
      "span": {
        "start": 7781,
        "end": 7789
      },
      "text": "ཟིན་པའི་ ༼སྣར། པེ།༽ ཡིན་པའི་"
    },
    {
      "span": {
        "start": 7806,
        "end": 7817
      },
      "text": "རྒྱུ་ཅན་དུ་ ༼སྣར། པེ།༽ རྒྱུ་ཅན་"
    },
    {
      "span": {
        "start": 7848,
        "end": 7860
      },
      "text": "ངག་གི་སྒྲའོ། ༼སྣར། པེ།༽ ངག་གིའོ།"
    },
    {
      "span": {
        "start": 8207,
        "end": 8211
      },
      "text": "མཚན་ ༼སྣར། པེ།༽ ཚན་"
    },
    {
      "span": {
        "start": 8546,
        "end": 8556
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 8727,
        "end": 8737
      },
      "text": "གྲང་བ་ཉིད་ ༼སྣར། པེ།༽ གྲང་བ་"
    },
    {
      "span": {
        "start": 9799,
        "end": 9820
      },
      "text": "ཤེས་པས་རྣམ་པར་ཤེས་པས་ ༼ཅོ། སྡེ།༽ ཤེས་པས་"
    },
    {
      "span": {
        "start": 9975,
        "end": 9979
      },
      "text": "ཤེས་ ༼ཅོ། སྡེ།༽ ཤེས་སོ་"
    },
    {
      "span": {
        "start": 10092,
        "end": 10100
      },
      "text": "ཡིད་ཀྱི་ ༼ཅོ།༽ ཡིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 10176,
        "end": 10184
      },
      "text": "བསྡུས་པ་ ༼སྣར།༽ འདུས་པ་"
    },
    {
      "span": {
        "start": 10427,
        "end": 10435
      },
      "text": "དང་སེམས་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 10684,
        "end": 10687
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 10803,
        "end": 10811
      },
      "text": "འགའ་ཞིག་ ༼སྣར། པེ།༽ འགའ་"
    },
    {
      "span": {
        "start": 13011,
        "end": 13021
      },
      "text": "མྱོང་བ་དེ་ ༼སྣར། པེ།༽ མྱོང་བ་"
    },
    {
      "span": {
        "start": 13746,
        "end": 13753
      },
      "text": "ཚོར་བས་ ༼སྣར། པེ།༽ ཚོར་བ་"
    },
    {
      "span": {
        "start": 13810,
        "end": 13815
      },
      "text": "བྱའོ། ༼སྣར། པེ།༽ བྱ་སྟེ།"
    },
    {
      "span": {
        "start": 13876,
        "end": 13882
      },
      "text": "བྱ་བས་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 13903,
        "end": 13906
      },
      "text": "ཏེ། ༼སྣར། པེ།༽ རོ། །"
    },
    {
      "span": {
        "start": 14819,
        "end": 15158
      },
      "text": "སྡུག་བསྔལ་བ་ཡང་མ་ཡིན་པ་ནི་ཚོར་བ་ཞེས་བརྗོད་དོ། །ཡང་ཚོར་བ་དེ་ཉིད་རྣམ་པ་ལྔར་འགྱུར་ཏེ། བདེ་བའི་དབང་པོ་དང་། སྡུག་བསྔལ་གྱི་དབང་པོ་དང་། ཡིད་བདེ་བའི་དབང་པོ་དང་། ཡིད་མི་བདེ་བའི་དབང་པོ་དང་། བཏང་སྙོམས་ཀྱི་དབང་པོའོ། །དེ་ལ་དབང་པོ་གཟུགས་ཅན་ལ་བརྟེན་པའི་རྣམ་པར་ཤེས་པ་དང་མཚུངས་པར་ལྡན་པ་ཚོར་བ་བདེ་བ་དང་། བསམ་གཏན་གསུམ་པའི་སེམས་ཀྱི་ཚོར་བ་བདེ་བ་སྟེ། དེ་གཉིས་ཀ་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 15518,
        "end": 15525
      },
      "text": "ཅིས་ཤེ་ ༼སྣར། པེ།༽ ཅིས་ཤེས་"
    },
    {
      "span": {
        "start": 15581,
        "end": 15588
      },
      "text": "རྟོག་པ་ ༼སྣར།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 15591,
        "end": 15600
      },
      "text": "འབྱུང་གི་ ༼སྣར། པེ།༽ འབྱུང་གིས་"
    },
    {
      "span": {
        "start": 15715,
        "end": 15723
      },
      "text": "གཏོང་བར་ ༼སྣར། པེ།༽ བཏང་བར་"
    },
    {
      "span": {
        "start": 15799,
        "end": 15803
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱི་ལ་"
    },
    {
      "span": {
        "start": 15868,
        "end": 15872
      },
      "text": "རིས་ ༼སྣར།༽ རིག་"
    },
    {
      "span": {
        "start": 15959,
        "end": 15966
      },
      "text": "མིག་གི་ ༼པེ།༽ མིག་གིས་"
    },
    {
      "span": {
        "start": 16292,
        "end": 16311
      },
      "text": "གྱི་བྱེ་བྲག་ལ་ལྟོས་ ༼སྣར། པེ།༽ བྱེ་བྲག་ལས་བལྟོས་"
    },
    {
      "span": {
        "start": 17135,
        "end": 17137
      },
      "text": "ན་ ༼སྣར།༽ ནི་"
    },
    {
      "span": {
        "start": 19487,
        "end": 19495
      },
      "text": "ནི་སེམས་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 20902,
        "end": 20910
      },
      "text": "གཏོད་པོ་ ༼སྣར། པེ།༽ གཏོད་པ་"
    },
    {
      "span": {
        "start": 21217,
        "end": 21222
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 21869,
        "end": 21878
      },
      "text": "རྒྱུན་དུ་ ༼སྣར།༽ རྒྱུན་ཏུ་"
    },
    {
      "span": {
        "start": 21927,
        "end": 21936
      },
      "text": "རྒྱུན་དུ་ ༼སྣར། པེ།༽ རྒྱུན་ཏུ་"
    },
    {
      "span": {
        "start": 22254,
        "end": 22257
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ནི་མི་སློབ་པ་ཡང་མ་ཡིན་"
    },
    {
      "span": {
        "start": 22624,
        "end": 22631
      },
      "text": "གཙོ་བོ་ ༼སྣར། པེ།༽ བརྩོ་བ་"
    },
    {
      "span": {
        "start": 22777,
        "end": 22781
      },
      "text": "ཡིད་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 22877,
        "end": 22883
      },
      "text": "དེ་ནི་ ༼སྣར།༽ དེའི་"
    },
    {
      "span": {
        "start": 23041,
        "end": 23046
      },
      "text": "འཛིན་ ༼སྣར། པེ།༽ འཛིན་པར་"
    },
    {
      "span": {
        "start": 23064,
        "end": 23071
      },
      "text": "བསླང་བ་ ༼སྣར། པེ།༽ བསླང་"
    },
    {
      "span": {
        "start": 23474,
        "end": 23482
      },
      "text": "ལ་ཡིད་ལ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 23577,
        "end": 23586
      },
      "text": "ཆོས་སེམས་ ༼སྣར།༽ ལ་ཟག་པ་མེད་པའི་ཏིང་ངེ་འཛིན་དང་མཚུངས་པར་ལྡན་པ་དེ་ནི་སློབ་པའི་ཡིད་ལ་བྱེད་ ༼པེ།༽ ལ་ཟག་"
    },
    {
      "span": {
        "start": 23588,
        "end": 23636
      },
      "text": "དང་ཡིད་ལ་བྱེད་པའི་སྔོན་དུ་འདུན་པ་འགྲོ་བ་སྟེ། གང་ ༼པེ།༽ མེད་པའི་ཏིང་ངེ་འཛིན་དང་མཚུངས་པར་ལྡན་པ་དེ་ནི་སློབ་པའི་ཡིད་ལ་བྱེད་པ་དང་ཡིད་ལ་བྱེད་པའི་སྔོན་"
    },
    {
      "span": {
        "start": 23683,
        "end": 23691
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 23788,
        "end": 23796
      },
      "text": "སྐུལ་བར་ ༼སྣར། པེ།༽ སྐུར་པར་"
    },
    {
      "span": {
        "start": 23921,
        "end": 23931
      },
      "text": "གྱིས་བེམས་ ༼སྣར། པེ།༽ གྱི་བེམ་"
    },
    {
      "span": {
        "start": 24132,
        "end": 24134
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 24179,
        "end": 24187
      },
      "text": "འབྱར་བར་ ༼སྣར། པེ།༽ འཇལ་བར་"
    },
    {
      "span": {
        "start": 24227,
        "end": 24235
      },
      "text": "ཞེན་ཅིང་ ༼སྣར། པེ།༽ ཞེན་ཞིང་"
    },
    {
      "span": {
        "start": 24548,
        "end": 24557
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 24583,
        "end": 24590
      },
      "text": "དེ་ལྟར་ ༼སྣར།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 24603,
        "end": 24610
      },
      "text": "སྲེད་པ་ ༼སྣར།༽ སྲིད་པ་"
    },
    {
      "span": {
        "start": 25199,
        "end": 25401
      },
      "text": "། །དེ་ལ་བདེན་པ་ནི་བཞི་སྟེ། སྡུག་བསྔལ་དང་། ཀུན་འབྱུང་དང་། འགོག་པ་དང་། ལམ་ཞེས་བྱ་བའོ། །ཡང་ན་རྣམ་པ་གཉིས་ཏེ། ཀུན་རྫོབ་དང་དོན་དམ་པ་ཞེས་བྱ་བའོ། །དཀོན་མཆོག་ནི་གསུམ་སྟེ། སངས་རྒྱས་དང་། ཆོས་དང་། དགེ་འདུན་ནོ། །ལས་ ༼སྣར། པེ།༽ ། །ལམ་"
    },
    {
      "span": {
        "start": 25510,
        "end": 25512
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 25840,
        "end": 25844
      },
      "text": "འདང་ ༼སྣར། པེ།༽ ལྡང་"
    },
    {
      "span": {
        "start": 25918,
        "end": 25925
      },
      "text": "ནོར་བུ་ ༼སྣར། པེ།༽ ནོར་བུར་"
    },
    {
      "span": {
        "start": 26307,
        "end": 26309
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 26318,
        "end": 26326
      },
      "text": "བརྗེད་པ་ ༼སྣར། པེ།༽ བརྗོད་པ་"
    },
