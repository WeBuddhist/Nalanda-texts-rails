        "end": 48018
      },
      "text": "དཔྱོད་ ༼སྣར། པེ།༽ སྤྱོད་"
    },
    {
      "span": {
        "start": 48139,
        "end": 48147
      },
      "text": "སློང་བར་ ༼སྣར།༽ བསློང་ ༼པེ།༽ བསླང་བར་"
    },
    {
      "span": {
        "start": 48197,
        "end": 48203
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 48321,
        "end": 48326
      },
      "text": "སྒོམ་ ༼པེ།༽ སྒོམས་"
    },
    {
      "span": {
        "start": 48723,
        "end": 48731
      },
      "text": "གཞན་པའི་ ༼སྣར། པེ།༽ གཞན་པ་"
    },
    {
      "span": {
        "start": 49070,
        "end": 49077
      },
      "text": "ལྡན་ནས་ ༼སྣར། པེ།༽ ལྡན་ན་"
    },
    {
      "span": {
        "start": 49444,
        "end": 49447
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 49718,
        "end": 49727
      },
      "text": "བསྒོམ་པས་ ༼སྣར། པེ།༽ སྒོམ་པས་"
    },
    {
      "span": {
        "start": 49741,
        "end": 49749
      },
      "text": "ཡིད་ཀྱི་ ༼སྣར། པེ།༽ ཡིད་"
    },
    {
      "span": {
        "start": 49833,
        "end": 49841
      },
      "text": "རྗོད་པར་ ༼པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 49918,
        "end": 49924
      },
      "text": "གང་དང་ ༼སྣར། པེ།༽ གང་དག་"
    },
    {
      "span": {
        "start": 49986,
        "end": 49993
      },
      "text": "སྐྱོ་བ་ ༼སྣར། པེ།༽ སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 50035,
        "end": 50040
      },
      "text": "མཐུན་ ༼སྣར། པེ།༽ འཐུན་"
    },
    {
      "span": {
        "start": 50217,
        "end": 50226
      },
      "text": "ཤིན་ཏུ་མ་ ༼སྣར། པེ།༽ ཤིན་ཏུ་"
    },
    {
      "span": {
        "start": 50500,
        "end": 50508
      },
      "text": "གསུངས་པ་ ༼སྣར། པེ།༽ གསུངས་པ་དེ་"
    },
    {
      "span": {
        "start": 50592,
        "end": 50596
      },
      "text": "ལྕག་ ༼པེ།༽ ལྕགས་"
    },
    {
      "span": {
        "start": 50735,
        "end": 50740
      },
      "text": "འཚམས་ ༼སྣར། པེ།༽ འཚམ་"
    },
    {
      "span": {
        "start": 51066,
        "end": 51073
      },
      "text": "ལ་ལྟོས་ ༼སྣར། པེ།༽ ལས་བལྟོས་"
    },
    {
      "span": {
        "start": 51116,
        "end": 51118
      },
      "text": "ན་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 51217,
        "end": 51228
      },
      "text": "གསུངས་སོ། །༼ཅོ།༽ གསུངས་། །དེ་"
    },
    {
      "span": {
        "start": 52380,
        "end": 52393
      },
      "text": "དགེ་བའི་རྩ་བ་ ༼སྣར། པེ།༽ དགེ་བའི་"
    },
    {
      "span": {
        "start": 53296,
        "end": 53299
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 53367,
        "end": 53373
      },
      "text": "རིག་པ་ ༼པེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 53373,
        "end": 53380
      },
      "text": "ལུང་དུ་ ༼སྣར། པེ།༽ ལུང་"
    },
    {
      "span": {
        "start": 53591,
        "end": 53598
      },
      "text": "བསྟན་པ་ ༼སྣར།༽ བརྟན་པ་"
    },
    {
      "span": {
        "start": 54055,
        "end": 54062
      },
      "text": "སྲེད་པ་ ༼སྣར། པེ།༽ སྲིད་པ་"
    },
    {
      "span": {
        "start": 54261,
        "end": 54273
      },
      "text": "ཁོང་ཁྲོ་བའི་ ༼སྣར། པེ།༽ ཁོང་ཁྲོའི་"
    },
    {
      "span": {
        "start": 55436,
        "end": 55439
      },
      "text": "དག་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 55553,
        "end": 55556
      },
      "text": "ལས་ ༼སྣར།༽ ལ་"
    },
    {
      "span": {
        "start": 55927,
        "end": 55931
      },
      "text": "ཅེས་ ༼སྣར། པེ།༽ ཅིང་"
    },
    {
      "span": {
        "start": 56385,
        "end": 56390
      },
      "text": "བཏགས་ ༼སྣར། པེ།༽ བརྟགས་"
    },
    {
      "span": {
        "start": 56730,
        "end": 56737
      },
      "text": "ཤིན་ཏུ་ ༼སྣར།༽ ཤིན་དུ་"
    },
    {
      "span": {
        "start": 57095,
        "end": 57100
      },
      "text": "བཏགས་ ༼སྣར། པེ།༽ བརྟགས་"
    },
    {
      "span": {
        "start": 57407,
        "end": 57412
      },
      "text": "དེ་མ་ ༼སྣར། པེ།༽ དེ་ལ་"
    },
    {
      "span": {
        "start": 58120,
        "end": 58125
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 58340,
        "end": 58347
      },
      "text": "རྩིང་ང་ ༼ཅོ།༽ རྩི་དང་ ༼སྣར། པེ།༽ ཙི་ཉ་"
    },
    {
      "span": {
        "start": 58350,
        "end": 58358
      },
      "text": "བསྩགས་པ་ ༼སྣར། པེ།༽ བསགས་པ་"
    },
    {
      "span": {
        "start": 58362,
        "end": 58371
      },
      "text": "བསྩགས་པར་ ༼སྣར། པེ།༽ བསགས་པར་"
    },
    {
      "span": {
        "start": 58467,
        "end": 58475
      },
      "text": "བསྩགས་པ་ ༼སྣར། པེ།༽ བསགས་པ་"
    },
    {
      "span": {
        "start": 58683,
        "end": 58686
      },
      "text": "ཅན་ ༼སྣར། པེ།༽ ཅན་ནི་"
    },
    {
      "span": {
        "start": 58907,
        "end": 58912
      },
      "text": "བཏགས་ ༼སྣར། པེ།༽ བཏགས་པ་"
    },
    {
      "span": {
        "start": 59746,
        "end": 59751
      },
      "text": "དེ་མ་ ༼སྣར། པེ།༽ དེ་ལ་"
    },
    {
      "span": {
        "start": 59875,
        "end": 59879
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ ཉིད་དུ་"
    },
    {
      "span": {
        "start": 60006,
        "end": 60014
      },
      "text": "མཆོག་ཏུ་ ༼སྣར། པེ།༽ མཆོག་ཉིད་དུ་"
    },
    {
      "span": {
        "start": 60045,
        "end": 60050
      },
      "text": "འདིར་ ༼སྣར། པེ།༽ འདིར་བ་"
    },
    {
      "span": {
        "start": 60071,
        "end": 60078
      },
      "text": "བལྟ་བར་ ༼སྣར། པེ།༽ ལྟ་བར་"
    },
    {
      "span": {
        "start": 60192,
        "end": 60198
      },
      "text": "ཡིན་པ་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 60418,
        "end": 60422
      },
      "text": "དང་། ༼སྣར།༽ ལ།"
    },
    {
      "span": {
        "start": 60523,
        "end": 60530
      },
      "text": "འཛིན་པ་ ༼སྣར། པེ།༽ འཛིན་པའི་"
    },
    {
      "span": {
        "start": 60821,
        "end": 60830
      },
      "text": "ཕ་རོལ་དུ་ ༼སྣར། པེ།༽ ཕ་རོལ་ལ་"
    },
    {
      "span": {
        "start": 61003,
        "end": 61010
      },
      "text": "ཆོས་དེ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 61098,
        "end": 61108
      },
      "text": "སེམས་ཀྱིས་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 61380,
        "end": 61388
      },
      "text": "གསུམ་པོ་ ༼སྣར། པེ།༽ གསུམ་པ་"
    },
    {
      "span": {
        "start": 61447,
        "end": 61454
      },
      "text": "བྱ་བ་ལ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 61616,
        "end": 61624
      },
      "text": "ཕྲ་རྒྱས་ ༼སྣར། པེ།༽ ཕྲ་རྒྱས་དང་"
    },
    {
      "span": {
        "start": 61903,
        "end": 61910
      },
      "text": "འདི་དག་ ༼སྣར། པེ།༽ འདི་དག་གི་"
    },
    {
      "span": {
        "start": 62986,
        "end": 62994
      },
      "text": "བྱ་བ་ནི་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 63458,
        "end": 63467
      },
      "text": "ཁམས་རྣམས་ ༼ཅོ། སྡེ།༽ ཁམས་"
    },
    {
      "span": {
        "start": 63533,
        "end": 63541
      },
      "text": "གསུམ་པོ་ ༼ཅོ། སྡེ།༽ གསུམ་པ་"
    },
    {
      "span": {
        "start": 64076,
        "end": 64085
      },
      "text": "བདེན་པ་ལ་ ༼ཅོ།༽ བདེན་པས་"
    },
    {
      "span": {
        "start": 64384,
        "end": 64390
      },
      "text": "བྱ་བས་ ༼སྣར། པེ།༽ བྱས་པས་"
    },
    {
      "span": {
        "start": 65025,
        "end": 65029
      },
      "text": "ཀུན་ ༼སྣར། པེ།༽ ཀུན་ཏུ་"
    },
    {
      "span": {
        "start": 65110,
        "end": 65122
      },
      "text": "ཀུན་འབྱུང་ལ་ ༼སྣར། པེ།༽ ཀུན་འབྱུང་བ་"
    },
    {
      "span": {
        "start": 65156,
        "end": 65165
      },
      "text": "སྐྱེས་ཏེ། ༼ཅོ། སྡེ།༽ སྐྱེ་སྟེ།"
    },
    {
      "span": {
        "start": 65218,
        "end": 65232
      },
      "text": "གཉིས་པོ་གཟུགས་ ༼ཅོ། སྡེ།༽ གཉིས་པོ་"
    },
    {
      "span": {
        "start": 65668,
        "end": 65671
      },
      "text": "རབ་ ༼ཅོ། སྡེ།༽ རབ་ཏུ་"
    },
    {
      "span": {
        "start": 65689,
        "end": 65692
      },
      "text": "ལས་ ༼ཅོ། སྡེ།༽ ལ་"
    },
    {
      "span": {
        "start": 65754,
        "end": 65756
      },
      "text": "ན་ ༼ཅོ།༽ ནི་"
    },
    {
      "span": {
        "start": 65831,
        "end": 65840
      },
      "text": "གསུམ་པའི་ ༼ཅོ། སྡེ།༽ གསུམ་པོའི་"
    },
    {
      "span": {
        "start": 65972,
        "end": 65978
      },
      "text": "རིག་པ་ ༼ཅོ། སྡེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 66348,
        "end": 66356
      },
      "text": "བྱེད་དོ། ༼སྣར། པེ།༽ བྱེད་དེ།"
    },
    {
      "span": {
        "start": 66410,
        "end": 66417
      },
      "text": "བྱ་བའོ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 66507,
        "end": 66516
      },
      "text": "བསྒོམ་པས་ ༼སྣར། པེ།༽ སྒོམ་པས་"
    },
    {
      "span": {
        "start": 66523,
        "end": 66530
      },
      "text": "བྱ་བའོ། ༼སྣར།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 66586,
        "end": 66591
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམས་ནི་"
    },
    {
      "span": {
        "start": 66608,
        "end": 66617
      },
      "text": "བསྒོམ་པས་ ༼སྣར། པེ།༽ སྒོམ་པས་"
    },
    {
      "span": {
        "start": 66688,
        "end": 66697
      },
      "text": "བསྒོམ་པས་ ༼སྣར། པེ།༽ སྒོམ་པས་"
    },
    {
      "span": {
        "start": 66718,
        "end": 66725
      },
      "text": "བསྡོམས་ ༼སྣར། པེ།༽ སྡོམས་"
    },
    {
      "span": {
        "start": 67043,
        "end": 67051
      },
      "text": "ནས་ཤེ་ན། ༼སྣར། པེ།༽ ནས་ཤེས།"
    },
    {
      "span": {
        "start": 67074,
        "end": 67079
      },
      "text": "རིམས་ ༼སྣར། པེ།༽ རིམ་"
    },
    {
      "span": {
        "start": 67260,
        "end": 67270
      },
      "text": "བསྒོམ་སྤང་ ༼སྣར། པེ།༽ སྒོམ་སྤང་"
    },
    {
      "span": {
        "start": 67292,
        "end": 67296
      },
