{
  "durchens": [
    {
      "span": {
        "start": 304,
        "end": 311
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 885,
        "end": 893
      },
      "text": "དབུས་མི་ ༼སྣར། པེ།༽ དབུས་ན་"
    },
    {
      "span": {
        "start": 1503,
        "end": 1512
      },
      "text": "རྣམ་གསུམ་ ༼སྣར། པེ།༽ རྣམས་སུ་"
    },
    {
      "span": {
        "start": 1849,
        "end": 1855
      },
      "text": "འཛུམས་ ༼སྣར། པེ།༽ འཛུམ་"
    },
    {
      "span": {
        "start": 1933,
        "end": 1941
      },
      "text": "རླུང་གི་ ༼སྣར། པེ།༽ རླུང་གིས་"
    },
    {
      "span": {
        "start": 2177,
        "end": 2184
      },
      "text": "བདག་ནི་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 2422,
        "end": 2428
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 2453,
        "end": 2460
      },
      "text": "དག་སྟེ། ༼སྣར། པེ།༽ དག་དང་།"
    },
    {
      "span": {
        "start": 2561,
        "end": 2565
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 3146,
        "end": 3152
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 3655,
        "end": 3661
      },
      "text": "བྱ་ཡི་ ༼སྣར། པེ།༽ བྱ་ཡིས་"
    },
    {
      "span": {
        "start": 3852,
        "end": 3855
      },
      "text": "གར་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 3916,
        "end": 3919
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    }
  ]
}