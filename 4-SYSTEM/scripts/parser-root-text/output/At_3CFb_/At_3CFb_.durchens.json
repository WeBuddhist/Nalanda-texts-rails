{
  "durchens": [
    {
      "span": {
        "start": 43,
        "end": 46
      },
      "text": "ཀེ་ ༼སྣར། པེ།༽ ཀྱེ་"
    },
    {
      "span": {
        "start": 448,
        "end": 452
      },
      "text": "དིས་ ༼སྣར། པེ།༽ དྲི་"
    },
    {
      "span": {
        "start": 515,
        "end": 520
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 589,
        "end": 598
      },
      "text": "སྦྱང་གནས་ ༼སྣར། པེ།༽ སྦྱངས་ནས་"
    },
    {
      "span": {
        "start": 1325,
        "end": 1331
      },
      "text": "སྒྲོག་ ༼སྣར། པེ།༽ སྒྲོགས་"
    },
    {
      "span": {
        "start": 2122,
        "end": 2128
      },
      "text": "བསྐུལ་ ༼སྣར།༽ སྐུལ་"
    },
    {
      "span": {
        "start": 2910,
        "end": 2916
      },
      "text": "འབར་བ་ ༼སྣར། པེ།༽ འབར་བར་"
    },
    {
      "span": {
        "start": 4156,
        "end": 4166
      },
      "text": "བརྒྱད་བྲི། ༼སྣར། པེ།༽ བརྒྱད་ཀྱི།"
    },
    {
      "span": {
        "start": 4650,
        "end": 4655
      },
      "text": "བྷ་ག་ ༼སྣར། པེ།༽ བྷ་གི་"
    },
    {
      "span": {
        "start": 5230,
        "end": 5236
      },
      "text": "རྟོག ། ༼སྣར། པེ།༽ རྟོགས། །"
    },
    {
      "span": {
        "start": 5853,
        "end": 5856
      },
      "text": "ཀཏ་ ༼སྣར། པེ།༽ ཀད་"
    },
    {
      "span": {
        "start": 6347,
        "end": 6352
      },
      "text": "གཡོན། ༼སྣར། པེ།༽ མཛོད།"
    },
    {
      "span": {
        "start": 6466,
        "end": 6471
      },
      "text": "མཛེས། ༼སྣར། པེ།༽ བརྫེས།"
    },
    {
      "span": {
        "start": 6931,
        "end": 6936
      },
      "text": "སོགས་ ༼སྣར། པེ།༽ ཚོགས་"
    },
    {
      "span": {
        "start": 7242,
        "end": 7248
      },
      "text": "མགྲོན་ ༼ཅོ།༽ འགྲོན་ ༼པེ།༽ མགོན་"
    },
    {
      "span": {
        "start": 8605,
        "end": 8609
      },
      "text": "བདེ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 8782,
        "end": 8791
      },
      "text": "ཧཱུྃ་གིས་ ༼སྣར། པེ།༽ ཧཱུྃ་གི་"
    },
    {
      "span": {
        "start": 9338,
        "end": 9341
      },
      "text": "དག་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 9351,
        "end": 9357
      },
      "text": "ཡང་ནི་ ༼སྣར། པེ།༽ ཡང་ན་"
    },
    {
      "span": {
        "start": 9615,
        "end": 9627
      },
      "text": "རྡོ་རྗེ་ཡིས། ༼སྣར། པེ།༽ རྡོ་རྗེ་ཡིན།"
    },
    {
      "span": {
        "start": 10271,
        "end": 10278
      },
      "text": "ཏ་སྭ་ད་ ༼སྣར། པེ།༽ ཏ་སཏྭ་"
    },
    {
      "span": {
        "start": 11014,
        "end": 11017
      },
      "text": "དང་ ༼སྣར། པེ།༽ བཅུ་ང་"
    },
    {
      "span": {
        "start": 11128,
        "end": 11134
      },
      "text": "ཐོབ་པ་ ༼སྣར། པེ།༽ ཐོབ་"
    },
    {
      "span": {
        "start": 11198,
        "end": 11203
      },
      "text": "གྱུར་ ༼ཅོ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 11353,
        "end": 11361
      },
      "text": "འཁོར་ལོ་ ༼སྣར། པེ།༽ འཁོར་མོ་"
    },
    {
      "span": {
        "start": 12493,
        "end": 12500
      },
      "text": "འོག་ནས་ ༼ཅོ།༽ འོག་གནས་"
    },
    {
      "span": {
        "start": 13210,
        "end": 13213
      },
      "text": "ནེ་ ༼སྣར། པེ།༽ ནཻ་"
    },
    {
      "span": {
        "start": 13271,
        "end": 13275
      },
      "text": "ལ་ཨ་ ༼སྣར། པེ།༽ ལཱ་"
    },
    {
      "span": {
        "start": 13742,
        "end": 13746
      },
      "text": "ཏ་ཕ་ ༼སྣར། པེ།༽ ཏ་པ་"
    },
    {
      "span": {
        "start": 14005,
        "end": 14016
      },
      "text": "སྙིང་པོ། །། ༼སྣར།༽ སྙིང་པོཔོ་ཡིན་ནོ། །།"
    },
    {
      "span": {
        "start": 14392,
        "end": 14398
      },
      "text": "དུད་ཀ་ ༼སྣར། པེ།༽ དུད་ཁ་"
    },
    {
      "span": {
        "start": 15728,
        "end": 15731
      },
      "text": "ལྔ། ༼སྣར། པེ།༽ ལྟར།"
    },
    {
      "span": {
        "start": 15772,
        "end": 15780
      },
      "text": "ཛ་མ་ཛ་ལ་ ༼སྣར། པེ།༽ ཛ་མ་"
    },
    {
      "span": {
        "start": 16198,
        "end": 16200
      },
      "text": "ཏ་ ༼སྣར། པེ།༽ ཊ་"
    },
    {
      "span": {
        "start": 16315,
        "end": 16317
      },
      "text": "ཨ་ ༼སྣར། པེ།༽ ཨུ་"
    },
    {
      "span": {
        "start": 16342,
        "end": 16344
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལཱ་"
    },
    {
      "span": {
        "start": 16377,
        "end": 16397
      },
      "text": "ཧ་ཧི་བུ་རུ། ཨི་ཨ་ཨོ། ༼སྣར། པེ།༽ ཏ་ཧིཾ་བྷ་རུ་ཁཱ། ཨི་ཨཨི།"
    },
    {
      "span": {
        "start": 16398,
        "end": 16402
      },
      "text": "པྲེ་ ༼སྣར། པེ།༽ ཕྲེཾ་"
    },
    {
      "span": {
        "start": 16412,
        "end": 16420
      },
      "text": "ཀ་རན་ཏི། ༼སྣར། པེ།༽ ཀ་རནྟེ།"
    },
    {
      "span": {
        "start": 16503,
        "end": 16519
      },
      "text": "ས་ལ་ཛིར་ཀུ་རུ་ར་ ༼སྣར། པེ།༽ ས་ལི་ཛར་ཀུནྡུ་རུ་"
    },
    {
      "span": {
        "start": 16572,
        "end": 16576
      },
      "text": "གཏང་ ༼སྣར། པེ།༽ གཏོང་"
    },
    {
      "span": {
        "start": 17181,
        "end": 17187
      },
      "text": "བསྒོམ་ ༼སྣར། པེ།༽ བསྒོམས་"
    },
    {
      "span": {
        "start": 17319,
        "end": 17335
      },
      "text": "། །མེ་རི་དྲ་གུར་ ༼ཅོ།༽ མེ་རི་དགུ་པ་"
    },
    {
      "span": {
        "start": 17478,
        "end": 17483
      },
      "text": "རྒྱན་ ༼སྣར། པེ།༽ བརྒྱན་"
    },
    {
      "span": {
        "start": 18692,
        "end": 18697
      },
      "text": "གཉིད་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 18758,
        "end": 18762
      },
      "text": "དགག་ ༼སྣར། པེ།༽ དག་"
    }
  ]
}