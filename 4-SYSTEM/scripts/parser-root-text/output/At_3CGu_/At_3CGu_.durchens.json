{
  "durchens": [
    {
      "span": {
        "start": 510,
        "end": 519
      },
      "text": "གཤགས་པའི་ ༼སྣར། པེ།༽ བཤགས་པའི་"
    },
    {
      "span": {
        "start": 519,
        "end": 522
      },
      "text": "ཚད་ ༼སྣར། པེ།༽ ཚད་ཙམ་"
    },
    {
      "span": {
        "start": 526,
        "end": 531
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 794,
        "end": 798
      },
      "text": "ཅིང་ ༼སྣར། པེ།༽ ཅིང་དབྱིབས་དང་བྲལ་བ། ནམ་མཁའ་དང་འདྲ་བས་མ་གྲུབ་པ་འམ་ཡང་ན་གཅིག་དང་དུ་མ་དང་བྲལ་བས་སམ་དེ་ཡང་འདི་ལྟར་འདས་པའི་སེམས་ནི་འགགས་ཤིང་ཞིག །མ་འོངས་པའི་སེམས་ནི་མ་སྐྱེས་ཤིང་མ་བྱུང་། ད་ལྟར་གྱི་སེམས་ནི་འདི་ལྟར་ཡང་ཤིན་ཏུ་བརྟག་དཀའ་སྟེ། ཁ་དོག་མེད་ཅིང་"
    },
    {
      "span": {
        "start": 834,
        "end": 840
      },
      "text": "ཡིན་པ་ ༼སྣར། པེ།༽ ཡིན་པར་"
    },
    {
      "span": {
        "start": 1030,
        "end": 1039
      },
      "text": "འདྲ་བས་མ་ ༼སྣར། པེ།༽ འདྲ་བས་སམ་"
    },
    {
      "span": {
        "start": 1054,
        "end": 1062
      },
      "text": "གཅིག་དང་ ༼སྣར། པེ།༽ གཅིག་"
    },
    {
      "span": {
        "start": 1139,
        "end": 1141
      },
      "text": "པ། ༼སྣར། པེ།༽ པས།"
    },
    {
      "span": {
        "start": 1161,
        "end": 1166
      },
      "text": "དཔྱད་ ༼སྣར། པེ།༽ སྤྱད་"
    },
    {
      "span": {
        "start": 1170,
        "end": 1176
      },
      "text": "གཞིགས་ ༼སྣར། པེ།༽ བཞིགས་"
    },
    {
      "span": {
        "start": 1219,
        "end": 1229
      },
      "text": "ངོ་བོར་ཡང་ ༼སྣར། པེ།༽ ངོ་བོར་"
    },
    {
      "span": {
        "start": 1355,
        "end": 1363
      },
      "text": "གཉིས་པོ་ ༼སྣར། པེ།༽ གཉིས་པོ་ཉིད་"
    },
    {
      "span": {
        "start": 1505,
        "end": 1509
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ དེ་ཉིད་ཀྱང་"
    },
    {
      "span": {
        "start": 1515,
        "end": 1523
      },
      "text": "མེད་ཅིང་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 1617,
        "end": 1650
      },
      "text": "བར་སྐབས་དེ་ཤེས་པ་ཅིར་ཡང་མི་རྟོག ། ༼སྣར། པེ།༽ བར་སྐབས་དེར་ཤེས་པས་"
    },
    {
      "span": {
        "start": 2028,
        "end": 2034
      },
      "text": "བདེ་བ་ ༼སྣར། པེ།༽ བདེན་པ་"
    },
    {
      "span": {
        "start": 2063,
        "end": 2077
      },
      "text": "ནམ་མཁའི་དཀྱིལ་ ༼སྣར། པེ།༽ ནམ་མཁའ་"
    },
    {
      "span": {
        "start": 2238,
        "end": 2246
      },
      "text": "ལྟ་བུའི་ ༼སྣར། པེ།༽ ལྟ་བུ་"
    },
    {
      "span": {
        "start": 2287,
        "end": 2296
      },
      "text": "ཐོབ་པ་ཡང་ ༼སྣར། པེ།༽ ཐོབ་པ་སྤང་"
    },
    {
      "span": {
        "start": 2339,
        "end": 2345
      },
      "text": "དེ་ལྟ་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 2808,
        "end": 2813
      },
      "text": "བྱའི་ ༼ཅོ།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 2992,
        "end": 2998
      },
      "text": "ནག་ཚོ་ ༼སྣར། པེ།༽ ནགས་ཚེ་"
    }
  ]
}