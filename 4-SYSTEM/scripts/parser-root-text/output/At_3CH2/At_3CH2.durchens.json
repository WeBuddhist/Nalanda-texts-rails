{
  "durchens": [
    {
      "span": {
        "start": 208,
        "end": 219
      },
      "text": "ནན་ཏན་གཅེས་ ༼སྣར། པེ།༽ ནན་ཏན་ཅེས་"
    },
    {
      "span": {
        "start": 244,
        "end": 248
      },
      "text": "སྤང་ ༼པེ།༽ སྤངས་"
    },
    {
      "span": {
        "start": 258,
        "end": 271
      },
      "text": "རྟག་ཏུ་བརྩོན་ ༼སྣར།༽ རྟག་པར་རྩོན་"
    },
    {
      "span": {
        "start": 411,
        "end": 418
      },
      "text": "བདག་གི་ ༼པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 424,
        "end": 430
      },
      "text": "བསྒྲག་ ༼སྣར། པེ།༽ བསྒྲགས་"
    },
    {
      "span": {
        "start": 630,
        "end": 638
      },
      "text": "ནི་བརྟན་ ༼སྣར།༽ མི་བརྟག་ ༼པེ།༽ ནི་བརྟག་"
    },
    {
      "span": {
        "start": 829,
        "end": 838
      },
      "text": "སྤང་ཞིང་། ༼སྣར། པེ།༽ སྤངས་ཤིང་།"
    },
    {
      "span": {
        "start": 905,
        "end": 914
      },
      "text": "ནོར་གྱིས་ ༼སྣར། པེ།༽ ནོར་གྱི་"
    },
    {
      "span": {
        "start": 1087,
        "end": 1095
      },
      "text": "བདུན་དེ། ༼སྣར། པེ།༽ བདུན་ཏེ།"
    },
    {
      "span": {
        "start": 1184,
        "end": 1188
      },
      "text": "ཚིག་ ༼སྣར།༽ ཚིགས་"
    },
    {
      "span": {
        "start": 2035,
        "end": 2043
      },
      "text": "ཆགས་སྡང་ ༼སྣར།༽ ཆགས་སྡང་བ་"
    },
    {
      "span": {
        "start": 2251,
        "end": 2259
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 2482,
        "end": 2487
      },
      "text": "གཉེར་ ༼སྣར། པེ།༽ ཉེར་"
    },
    {
      "span": {
        "start": 2724,
        "end": 2728
      },
      "text": "གསར་ ༼སྣར། པེ།༽ གསང་"
    },
    {
      "span": {
        "start": 2946,
        "end": 2952
      },
      "text": "བཅུའི་ ༼སྣར། པེ།༽ བཅུ་"
    }
  ]
}