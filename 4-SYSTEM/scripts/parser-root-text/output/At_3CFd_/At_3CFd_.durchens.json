{
  "durchens": [
    {
      "span": {
        "start": 381,
        "end": 384
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 745,
        "end": 752
      },
      "text": "སྒོམ་པ་ ༼སྣར། པེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 3217,
        "end": 3224
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིར་"
    },
    {
      "span": {
        "start": 3637,
        "end": 3642
      },
      "text": "གཡོན་ ༼སྣར། པེ།༽ གཡོན་པ་"
    },
    {
      "span": {
        "start": 4077,
        "end": 4082
      },
      "text": "སོགས་ ༼སྣར། པེ།༽ ཚོགས་"
    },
    {
      "span": {
        "start": 4394,
        "end": 4397
      },
      "text": "ནི་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 6800,
        "end": 6813
      },
      "text": "བུད་མེད་ཀྱིས་ ༼སྣར།༽ བུད་མེད་ཀྱི་"
    },
    {
      "span": {
        "start": 7047,
        "end": 7055
      },
      "text": "ཕུར་བུས་ ༼སྣར། པེ།༽ ཕུར་བུ་"
    },
    {
      "span": {
        "start": 7164,
        "end": 7175
      },
      "text": "མཚན་ཉིད་མི་ ༼སྣར། པེ།༽ མཚན་ཉིད་མ་"
    },
    {
      "span": {
        "start": 7197,
        "end": 7205
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 7731,
        "end": 7735
      },
      "text": "ལོག་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 7971,
        "end": 7974
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 8469,
        "end": 8481
      },
      "text": "བླང་བར་གྱིས། ༼སྣར།༽ བླང་བར་བགྱི།"
    },
    {
      "span": {
        "start": 10024,
        "end": 10033
      },
      "text": "སྟོང་ཉིད་ ༼སྣར། པེ།༽ སྟོང་པ་ཉིད་"
    },
    {
      "span": {
        "start": 10849,
        "end": 10857
      },
      "text": "གསུམ་དུ་ ༼སྣར། པེ།༽ གསུམ་"
    },
    {
      "span": {
        "start": 11609,
        "end": 11616
      },
      "text": "འཕྲོ་བ་ ༼སྣར། པེ།༽ འཕྲོ་བར་"
    },
    {
      "span": {
        "start": 12350,
        "end": 12364
      },
      "text": "འདོད་ཆགས་ཀྱིས་ ༼སྣར། པེ།༽ འདོད་ཆགས་ཀྱི་"
    },
    {
      "span": {
        "start": 12403,
        "end": 12409
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 13346,
        "end": 13355
      },
      "text": "གྱི་ཁ་ནས་ ༼སྣར། པེ།༽ གྱི་ཁམས་"
    },
    {
      "span": {
        "start": 14317,
        "end": 14321
      },
      "text": "ཀེང་ ༼སྣར། པེ།༽ རྐེང་"
    },
    {
      "span": {
        "start": 14566,
        "end": 14575
      },
      "text": "ཀྱུང་ཀའི་ ༼སྣར། པེ།༽ ལྕུང་ཀའི་"
    },
    {
      "span": {
        "start": 15414,
        "end": 15422
      },
      "text": "གོ་རིམས་ ༼སྣར། པེ།༽ གོ་རིམ་"
    },
    {
      "span": {
        "start": 15863,
        "end": 15870
      },
      "text": "ཐབས་དང་ ༼སྣར། པེ།༽ ཐབས་"
    },
    {
      "span": {
        "start": 16581,
        "end": 16586
      },
      "text": "བྱེད་ ༼སྣར། པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 16860,
        "end": 16864
      },
      "text": "དེས་ ༼སྣར།༽ དེས་དུས་"
    },
    {
      "span": {
        "start": 16927,
        "end": 16934
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 17242,
        "end": 17249
      },
      "text": "ལྡན་པས་ ༼སྣར། པེ།༽ ལྡན་པ་"
    },
    {
      "span": {
        "start": 17293,
        "end": 17302
      },
      "text": "འཕགས་པའི་ ༼སྣར། པེ།༽ འཕངས་པའི་"
    },
    {
      "span": {
        "start": 17394,
        "end": 17403
      },
      "text": "གྱུར་པའོ། ༼སྣར། པེ།༽ འགྱུར་བའོ།"
    },
    {
      "span": {
        "start": 17650,
        "end": 17653
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 17716,
        "end": 17721
      },
      "text": "ངོ་ཚ་ ༼སྣར། པེ།༽ ངོ་བོ་"
    },
    {
      "span": {
        "start": 19124,
        "end": 19134
      },
      "text": "བསྲེགས་པས་ ༼སྣར། པེ།༽ བསྲེག་པས་"
    },
    {
      "span": {
        "start": 20385,
        "end": 20392
      },
      "text": "མཚམས་མ་ ༼སྣར། པེ།༽ མཚམས་"
    },
    {
      "span": {
        "start": 20574,
        "end": 20594
      },
      "text": "བློ་མ་ལ་སོགས་པ་ལྔའོ། ༼སྣར། པེ།༽ མ་ལ་སོགས་ལྔ་པའོ།"
    },
    {
      "span": {
        "start": 21084,
        "end": 21096
      },
      "text": "བྱང་ཆུབ་ཀྱི་ ༼སྣར། པེ།༽ བྱང་ཆུབ་"
    },
    {
      "span": {
        "start": 21114,
        "end": 21123
      },
      "text": "རིམ་གྱིས་ ༼སྣར། པེ།༽ རིམ་གྱི་"
    },
    {
      "span": {
        "start": 21142,
        "end": 21150
      },
      "text": "ཐོ་འཚམས་ ༼སྣར།༽ མཐོ་འཚམ་ ༼པེ།༽ མཐོ་འཚམས་"
    },
    {
      "span": {
        "start": 21292,
        "end": 21300
      },
      "text": "འཛིན་ཏོ། ༼སྣར། པེ།༽ འཛིན་ནོ།"
    },
    {
      "span": {
        "start": 21694,
        "end": 21699
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 24332,
        "end": 24336
      },
      "text": "མཉམ་ ༼སྣར།༽ མཉམ་ཞེས་"
    },
    {
      "span": {
        "start": 24641,
        "end": 24645
      },
      "text": "དབང་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 25032,
        "end": 25037
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ རྒྱ་"
    },
    {
      "span": {
        "start": 25382,
        "end": 25392
      },
      "text": "སྐྱེས་པའི་ ༼སྣར། པེ།༽ བསྐྱེད་པའི་"
    },
    {
      "span": {
        "start": 25773,
        "end": 25780
      },
      "text": "དྲངས་པ་ ༼སྣར། པེ།༽ དྲང་པ་"
    },
    {
      "span": {
        "start": 25798,
        "end": 25804
      },
      "text": "ནས་ཤེ་ ༼སྣར། པེ།༽ ནས་ཤེས་"
    },
    {
      "span": {
        "start": 26221,
        "end": 26226
      },
      "text": "སརྦྦ་ ༼པེ།༽ སརྦ་"
    },
    {
      "span": {
        "start": 27083,
        "end": 27090
      },
      "text": "དབང་ལྷ་ ༼སྣར། པེ།༽ དབང་"
    },
    {
      "span": {
        "start": 27103,
        "end": 27109
      },
      "text": "པ་དང་། ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 27817,
        "end": 27822
      },
      "text": "སྐུས་ ༼སྣར། པེ།༽ རྒྱུས་"
    },
    {
      "span": {
        "start": 28121,
        "end": 28131
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 28212,
        "end": 28220
      },
      "text": "བསྐོང་བ་ ༼སྣར། པེ།༽ བསྐོང་བ་པ་"
    },
    {
      "span": {
        "start": 28335,
        "end": 28347
      },
      "text": "བུམ་པའི་དབང་ ༼སྣར། པེ།༽ བུམ་པའི་"
    },
    {
      "span": {
        "start": 28865,
        "end": 28869
      },
      "text": "རིག་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 29446,
        "end": 29451
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ གསུམ་པ་རྣམས་"
    },
    {
      "span": {
        "start": 29914,
        "end": 29916
      },
      "text": "མ་ ༼སྣར། པེ།༽ མ་དང་"
    },
    {
      "span": {
        "start": 30127,
        "end": 30141
      },
      "text": "བསྒོམ་སྟེ། དེ་ ༼སྣར།༽ བསྒོམས་ཏེ་"
    },
    {
      "span": {
        "start": 30486,
        "end": 30489
      },
      "text": "ལྔ་ ༼སྣར། པེ།༽ ལྔ་དང་"
    },
    {
      "span": {
        "start": 30506,
        "end": 30513
      },
      "text": "ཁམས་ལྔ་ ༼སྣར།༽ ཁམས་"
    },
    {
      "span": {
        "start": 30694,
        "end": 30705
      },
      "text": "བགེགས་རྣམས་ ༼སྣར། པེ།༽ བགེགས་"
    },
    {
      "span": {
        "start": 30936,
        "end": 30945
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 31106,
        "end": 31112
      },
      "text": "བླ་རེ་ ༼སྣར།༽ བླ་བྲེ་"
    },
    {
      "span": {
        "start": 31539,
        "end": 31549
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 32275,
        "end": 32282
      },
      "text": "རྣམས་ན་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 32543,
        "end": 32548
      },
      "text": "ནི་ཁ་ ༼སྣར། པེ།༽ ན་ཁ་"
    },
    {
      "span": {
        "start": 32641,
        "end": 32653
      },
      "text": "བུད་མེད་ཀྱི་ ༼སྣར། པེ།༽ བུད་མེད་"
    },
    {
      "span": {
        "start": 35304,
        "end": 35309
      },
      "text": "ཅན་མ། ༼སྣར། པེ།༽ ཅན་"
    },
    {
      "span": {
        "start": 35489,
        "end": 35494
      },
      "text": "ཐོགས་ ༼སྣར། པེ།༽ ཐོགས་པ་"
    },
    {
      "span": {
        "start": 35654,
        "end": 35658
      },
      "text": "རིང་ ༼སྣར། པེ།༽ རིངས་"
    },
    {
      "span": {
        "start": 37087,
        "end": 37093
      },
      "text": "ངག་དང་ ༼སྣར། པེ།༽ ངག་"
    },
    {
      "span": {
        "start": 37226,
        "end": 37232
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 37971,
        "end": 37977
      },
      "text": "ཤུ་མར་ ༼སྣར། པེ།༽ ཤུར་མར་"
    },
    {
      "span": {
        "start": 38502,
        "end": 38504
      },
      "text": "ས་ ༼སྣར། པེ།༽ ཨཿས་"
    },
    {
      "span": {
        "start": 39422,
        "end": 39430
      },
      "text": "བརྩོན་ལ། ༼སྣར། པེ།༽ བརྩོན་པ།"
    },
    {
      "span": {
        "start": 39661,
        "end": 39667
      },
      "text": "དྲན་པ་ ༼སྣར། པེ།༽ དྲན་"
    },
    {
      "span": {
        "start": 39691,
        "end": 39700
      },
      "text": "བསྒོམས་ན་ ༼སྣར། པེ།༽ བསྒོམས་ནས་"
    },
    {
      "span": {
        "start": 40162,
        "end": 40170
      },
      "text": "བ་ལ་གཞག་ ༼སྣར། པེ།༽ བ་བཞག་"
    },
    {
      "span": {
        "start": 40233,
        "end": 40235
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 40341,
        "end": 40353
      },
      "text": "ཀུན་སྤྱོད་ལ། ༼སྣར།༽ ཀུན་སྤྱོད་པ།"
    },
    {
      "span": {
        "start": 41050,
        "end": 41065
      },
      "text": "སྐྱེད་པས་གཟུངས་ ༼སྣར། པེ།༽ སྐྱེ་བས་གཟུགས་"
    },
    {
      "span": {
        "start": 41334,
        "end": 41339
      },
      "text": "སྙོམ་ ༼སྣར། པེ།༽ སྙོམས་"
    },
    {
      "span": {
        "start": 41381,
        "end": 41385
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིའི་"
    },
    {
      "span": {
        "start": 41927,
        "end": 41933
      },
      "text": "དམན་པ་ ༼སྣར། པེ།༽ དམན་"
    },
    {
      "span": {
        "start": 41986,
        "end": 41990
      },
      "text": "པའི་ ༼སྣར། པེ།༽ པའི་གསང་"
    },
    {
      "span": {
        "start": 41990,
        "end": 42000
      },
      "text": "སྔགས་ཀྱིས་ ༼སྣར། པེ།༽ སྔགས་"
    },
    {
      "span": {
        "start": 42249,
        "end": 42253
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམ་པར་"
    },
    {
      "span": {
        "start": 42291,
        "end": 42297
      },
      "text": "ཚམ་དམ་ ༼སྣར། པེ།༽ ཚམ་རྔམ་"
    },
    {
      "span": {
        "start": 42602,
        "end": 42609
      },
      "text": "ཚངས་པར་ ༼སྣར། པེ།༽ ཚངས་པའི་"
    },
    {
      "span": {
        "start": 42704,
        "end": 42713
      },
      "text": "སྔགས་ཀྱི་ ༼སྣར། པེ།༽ སྔགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 43833,
        "end": 43842
      },
      "text": "སྤྱད་པའི་ ༼སྣར། པེ།༽ སྤྱོད་པའི་"
    },
    {
      "span": {
        "start": 43945,
        "end": 43953
      },
      "text": "བསྒོམ་པ་ ༼སྣར། པེ།༽ བསྒོམས་པ་"
    },
    {
      "span": {
        "start": 44183,
        "end": 44188
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 44745,
        "end": 44752
      },
      "text": "བརྩམ་པ་ ༼སྣར། པེ།༽ བརྩམས་པ་"
    },
    {
      "span": {
        "start": 45230,
        "end": 45239
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 45825,
        "end": 45829
      },
      "text": "གཞག་ ༼སྣར། པེ།༽ བཞག་པ་"
    },
    {
      "span": {
        "start": 45933,
        "end": 45940
      },
      "text": "ཏིང་ངེ་ ༼སྣར།༽ ཏིང་"
    },
    {
      "span": {
        "start": 46293,
        "end": 46297
      },
      "text": "ཕྲར་ ༼སྣར། པེ།༽ ཕྲ་"
    },
    {
      "span": {
        "start": 46571,
        "end": 46575
      },
      "text": "གཞག་ ༼སྣར། པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 46738,
        "end": 46746
      },
      "text": "དམིགས་པ་ ༼སྣར། པེ།༽ དམིགས་"
    },
    {
      "span": {
        "start": 47036,
        "end": 47041
      },
      "text": "སྐུར་ ༼སྣར། པེ།༽ སྐུ་"
    },
    {
      "span": {
        "start": 47716,
        "end": 47725
      },
      "text": "གནས་པ་དང་ ༼སྣར། པེ།༽ གནས་པ་"
    },
    {
      "span": {
        "start": 47884,
        "end": 47890
      },
      "text": "ཚད་དུ་ ༼སྣར། པེ།༽ ཚད་"
    },
    {
      "span": {
        "start": 47897,
        "end": 47903
      },
      "text": "བསྒོམ་ ༼སྣར། པེ།༽ བསྒོམས་"
    },
    {
      "span": {
        "start": 48265,
        "end": 48278
      },
      "text": "མེད་པའི་ཕྱིར་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 48451,
        "end": 48457
      },
      "text": "ནི་མར་ ༼སྣར། པེ།༽ ན་མར་"
    },
    {
      "span": {
        "start": 48744,
        "end": 48750
      },
      "text": "གནས་ས་ ༼སྣར། པེ།༽ གནས་"
    },
    {
      "span": {
        "start": 49338,
        "end": 49342
      },
      "text": "འཕོ་ ༼སྣར། པེ།༽ འཕྲོ་"
    },
    {
      "span": {
        "start": 49396,
        "end": 49405
      },
      "text": "གཞན་ཡང་མ་ ༼སྣར། པེ།༽ གཞན་ཡང་"
    },
    {
      "span": {
        "start": 49706,
        "end": 49709
      },
      "text": "ཀར་ ༼ཅོ།༽ སྐར་"
    },
    {
      "span": {
        "start": 49869,
        "end": 49875
      },
      "text": "འཕོ་བ་ ༼སྣར། པེ།༽ འཕོ་"
    },
    {
      "span": {
        "start": 49975,
        "end": 49979
      },
      "text": "ལུས་ ༼སྣར། པེ།༽ ལུས་ཀྱིས་"
    },
    {
      "span": {
        "start": 50277,
        "end": 50289
      },
      "text": "རྣལ་འབྱོར་མ་ ༼སྣར། པེ།༽ རྣལ་འབྱོར་"
    },
    {
      "span": {
        "start": 50315,
        "end": 50325
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 50416,
        "end": 50423
      },
      "text": "ཞེས་བྱ་ ༼སྣར། པེ།༽ ཞེས་པ་"
    },
    {
      "span": {
        "start": 50495,
        "end": 50504
      },
      "text": "ཡིད་ཀྱིས་ ༼སྣར། པེ།༽ ཡིད་ཀྱི་"
    },
    {
      "span": {
        "start": 50508,
        "end": 50512
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱིས་"
    },
    {
      "span": {
        "start": 50574,
        "end": 50588
      },
      "text": "ཆགས་པ་ཅན་རྣམས་ ༼སྣར། པེ།༽ ཆགས་པ་ཅན་"
    },
    {
      "span": {
        "start": 50646,
        "end": 50652
      },
      "text": "དེ་བས་ ༼སྣར། པེ།༽ བདེ་བས་"
    },
    {
      "span": {
        "start": 51848,
        "end": 51861
      },
      "text": "ཕྱིར་རྡོ་རྗེ་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 51873,
        "end": 51880
      },
      "text": "སྒོམ་པ་ ༼སྣར། པེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 52064,
        "end": 52073
      },
      "text": "སྟོབས་ནི་ ༼སྣར། པེ།༽ སྟོབས་"
    },
    {
      "span": {
        "start": 52156,
        "end": 52165
      },
      "text": "གནས་སྐབས་ ༼སྣར། པེ།༽ གནས་སྐབས་དང་"
    },
    {
      "span": {
        "start": 52305,
        "end": 52312
      },
      "text": "སྒྲུབས་ ༼སྣར། པེ།༽ བསྒྲུབས་"
    },
    {
      "span": {
        "start": 52841,
        "end": 52846
      },
      "text": "གཡེང་ ༼སྣར། པེ།༽ གཡེངས་"
    },
    {
      "span": {
        "start": 53105,
        "end": 53111
      },
      "text": "བསྲེག་ ༼སྣར། པེ།༽ བསྲེག་པར་"
    },
    {
      "span": {
        "start": 53284,
        "end": 53294
      },
      "text": "མཁའ་འགྲོས་ ༼སྣར། པེ།༽ མཁའ་འགྲོ་"
    },
    {
      "span": {
        "start": 53484,
        "end": 53494
      },
      "text": "ཀའི་སྒྲུབ་ ༼སྣར། པེ།༽ ཀའི་"
    }
  ]
}