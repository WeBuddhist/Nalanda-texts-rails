{
  "durchens": [
    {
      "span": {
        "start": 390,
        "end": 393
      },
      "text": "ཤོ་ ༼སྣར། པེ།༽ ཤྭ་"
    },
    {
      "span": {
        "start": 457,
        "end": 465
      },
      "text": "དབང་གིས་ ༼སྣར། པེ།༽ དབང་གི་"
    },
    {
      "span": {
        "start": 1277,
        "end": 1281
      },
      "text": "ཞེས་ ༼སྣར། པེ།༽ ཞེས་བྱ་བ་"
    },
    {
      "span": {
        "start": 1292,
        "end": 1297
      },
      "text": "བླ་མ་ ༼སྣར། པེ།༽ བླ་མ་བ་"
    },
    {
      "span": {
        "start": 1519,
        "end": 1529
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 1545,
        "end": 1550
      },
      "text": "གཅིག་ ༼སྣར། པེ།༽ གཅིག་གི་"
    },
    {
      "span": {
        "start": 1798,
        "end": 1805
      },
      "text": "མངའ་འོ་ ༼སྣར། པེ།༽ མངའ་བོ་"
    },
    {
      "span": {
        "start": 1864,
        "end": 1879
      },
      "text": "སློབ་དཔོན་གྱིས་ ༼སྣར། པེ།༽ སློབ་དཔོན་གྱི་"
    },
    {
      "span": {
        "start": 1949,
        "end": 1957
      },
      "text": "བརྟགས་པ་ ༼སྣར། པེ།༽ བཏགས་པ་"
    },
    {
      "span": {
        "start": 2122,
        "end": 2130
      },
      "text": "རི་བོ་པ་ ༼སྣར།༽ རི་བོ་པོ་"
    },
    {
      "span": {
        "start": 2192,
        "end": 2195
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 2413,
        "end": 2420
      },
      "text": "ཡོད་དེ་ ༼སྣར། པེ།༽ ཡོད་དོ་"
    },
    {
      "span": {
        "start": 2705,
        "end": 2711
      },
      "text": "རྒྱུར་ ༼སྣར། པེ།༽ རླུང་"
    },
    {
      "span": {
        "start": 2794,
        "end": 2802
      },
      "text": "གནས་པའི་ ༼སྣར། པེ།༽ གནས་པ་ནི་"
    },
    {
      "span": {
        "start": 3090,
        "end": 3097
      },
      "text": "བཀུར་བ་ ༼སྣར། པེ།༽ བཀུར་"
    },
    {
      "span": {
        "start": 3144,
        "end": 3151
      },
      "text": "བསྡུ་བ་ ༼སྣར། པེ།༽ བསྡུས་པ་"
    },
    {
      "span": {
        "start": 3165,
        "end": 3168
      },
      "text": "པན་ ༼ཅོ།༽ བོན་"
    },
    {
      "span": {
        "start": 3310,
        "end": 3321
      },
      "text": "ཡང་སྲིད་པར་ ༼སྣར། པེ།༽ ཡང་སྲིད་པའི་"
    },
    {
      "span": {
        "start": 3523,
        "end": 3533
      },
      "text": "སྲུངས་ཀྱི་ ༼སྣར། པེ།༽ བསྲུངས་གི་"
    },
    {
      "span": {
        "start": 3974,
        "end": 3981
      },
      "text": "སྟོང་པ་ ༼སྣར། པེ།༽ སྟོན་པ་"
    },
    {
      "span": {
        "start": 4098,
        "end": 4101
      },
      "text": "ཏེ། ༼སྣར། པེ།༽ ནོ། །"
    },
    {
      "span": {
        "start": 4190,
        "end": 4204
      },
      "text": "འཁོར་བར་འགྱུར་ ༼སྣར། པེ།༽ འཁོར་"
    },
    {
      "span": {
        "start": 4214,
        "end": 4221
      },
      "text": "གསལ་བར་ ༼སྣར། པེ།༽ བསལ་བར་"
    },
    {
      "span": {
        "start": 4392,
        "end": 4399
      },
      "text": "བརྟན་པ་ ༼པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 4461,
        "end": 4468
      },
      "text": "བརྟན་པ་ ༼པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 4642,
        "end": 4645
      },
      "text": "བུ་ ༼སྣར། པེ།༽ བུའི་"
    },
    {
      "span": {
        "start": 4903,
        "end": 4909
      },
      "text": "རི་བོ་ ༼སྣར། པེ།༽ རི་པ་"
    },
    {
      "span": {
        "start": 4945,
        "end": 4956
      },
      "text": "བརྟེན་གྲུབ་ ༼སྣར། པེ།༽ བདེན་དྲུག་"
    },
    {
      "span": {
        "start": 5131,
        "end": 5137
      },
      "text": "དམར་བ་ ༼སྣར།༽ དམར་པོ་"
    },
    {
      "span": {
        "start": 5509,
        "end": 5515
      },
      "text": "སྲུངས་ ༼སྣར།༽ བསྲུངས་"
    },
    {
      "span": {
        "start": 5595,
        "end": 5601
      },
      "text": "སོ་སོ་ ༼སྣར། པེ།༽ སོ་སོར་"
    },
    {
      "span": {
        "start": 5855,
        "end": 5862
      },
      "text": "བརྟན་པ་ ༼སྣར། པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 5883,
        "end": 5889
      },
      "text": "དག་གི་ ༼སྣར། པེ།༽ དག་གིས་"
    },
    {
      "span": {
        "start": 5911,
        "end": 5927
      },
      "text": "རྗེས་སུ་སྟོན་པར་ ༼སྣར།༽ རྗེས་སུ་བསྟོན་ ༼པེ།༽ རྗེས་སུ་སྟོན་"
    },
    {
      "span": {
        "start": 5973,
        "end": 5982
      },
      "text": "ཡིད་གཉིས་ ༼སྣར། པེ།༽ ཡིད་གཉིས་པ་"
    },
    {
      "span": {
        "start": 5995,
        "end": 6003
      },
      "text": "བརྟགས་པ་ ༼སྣར། པེ།༽ བཏགས་པ་"
    },
    {
      "span": {
        "start": 6332,
        "end": 6339
      },
      "text": "དེས་ཡང་ ༼སྣར། པེ།༽ དེ་ཡང་"
    },
    {
      "span": {
        "start": 6611,
        "end": 6623
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 6657,
        "end": 6662
      },
      "text": "གསུང་ ༼སྣར། པེ།༽ གསུངས་པ་"
    },
    {
      "span": {
        "start": 6749,
        "end": 6757
      },
      "text": "གཤེགས་པ་ ༼སྣར། པེ།༽ གཤེགས་པ་ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 7224,
        "end": 7235
      },
      "text": "མིག་གིས་ནི་ ༼སྣར། པེ།༽ མིག་གིས་"
    },
    {
      "span": {
        "start": 7404,
        "end": 7412
      },
      "text": "གཞག་པའི་ ༼སྣར། པེ།༽ བཞག་པའི་"
    },
    {
      "span": {
        "start": 7757,
        "end": 7766
      },
      "text": "ལྡང་བ་ཡང་ ༼སྣར། པེ།༽ ལྡང་བ་"
    },
    {
      "span": {
        "start": 7965,
        "end": 7973
      },
      "text": "བཏགས་པར་ ༼སྣར། པེ།༽ བརྟགས་པས་"
    },
    {
      "span": {
        "start": 8065,
        "end": 8073
      },
      "text": "དཔྱོད་པ་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 8176,
        "end": 8191
      },
      "text": "སྡུག་བསྔལ་རྣམས་ ༼སྣར། པེ།༽ སྡུག་བསྔལ་"
    },
    {
      "span": {
        "start": 8378,
        "end": 8396
      },
      "text": "བསྒྲུབ་པ་ཡོད་དོ། ། ༼སྣར། པེ།༽ བསྒྲུབ་པ་པའོ་"
    },
    {
      "span": {
        "start": 8438,
        "end": 8444
      },
      "text": "གཞག་པ་ ༼སྣར། པེ།༽ བཞག་པ་"
    },
    {
      "span": {
        "start": 8455,
        "end": 8462
      },
      "text": "འཇུག་པ་ ༼སྣར། པེ།༽ འཇུག་པ་ལ་"
    },
    {
      "span": {
        "start": 8522,
        "end": 8530
      },
      "text": "བཏགས་པར་ ༼སྣར། པེ།༽ བརྟགས་པར་"
    },
    {
      "span": {
        "start": 8849,
        "end": 8857
      },
      "text": "བཏགས་པར་ ༼སྣར། པེ།༽ བརྟགས་པར་"
    },
    {
      "span": {
        "start": 8909,
        "end": 8918
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 9144,
        "end": 9152
      },
      "text": "བཞག་སྟེ། ༼སྣར། པེ།༽ བཞག་ཏེ།"
    },
    {
      "span": {
        "start": 9241,
        "end": 9246
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 9352,
        "end": 9361
      },
      "text": "གཞན་གྱིས་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 9582,
        "end": 9601
      },
      "text": "ནི་གནས་བརྟན་པའི་རྩ་ ༼སྣར།༽ གནས་བརྟན་པར་རྩེ་"
    },
    {
      "span": {
        "start": 9688,
        "end": 9692
      },
      "text": "ཡིན་ ༼སྣར། པེ།༽ ཡིན་པ་"
    },
    {
      "span": {
        "start": 9735,
        "end": 9738
      },
      "text": "ནི་ ༼པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 9833,
        "end": 9840
      },
      "text": "འགགས་པ་ ༼སྣར། པེ།༽ འགགས་པར་"
    },
    {
      "span": {
        "start": 9876,
        "end": 9882
      },
      "text": "གཞག་པ་ ༼སྣར། པེ།༽ བཞག་པ་"
    },
    {
      "span": {
        "start": 9906,
        "end": 9913
      },
      "text": "ལམ་གྱི་ ༼སྣར། པེ།༽ ལམ་གྱིས་"
    },
    {
      "span": {
        "start": 10045,
        "end": 10053
      },
      "text": "གནས་མའི་ ༼སྣར། པེ།༽ གནས་མ་"
    },
    {
      "span": {
        "start": 10279,
        "end": 10285
      },
      "text": "རིག་པ་ ༼སྣར། པེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 10450,
        "end": 10459
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 10906,
        "end": 10912
      },
      "text": "ཉམས་པ་ ༼སྣར། པེ།༽ ཉམ་པ་"
    },
    {
      "span": {
        "start": 11192,
        "end": 11202
      },
      "text": "ཡང་དག་པའི་ ༼སྣར། པེ།༽ ཡང་དག་པར་"
    },
    {
      "span": {
        "start": 11268,
        "end": 11272
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ ཡིན་ནོ།"
    },
    {
      "span": {
        "start": 11520,
        "end": 11525
      },
      "text": "བྱའོ། ༼སྣར། པེ།༽ བྱ་བ།"
    },
    {
      "span": {
        "start": 11542,
        "end": 11551
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 11613,
        "end": 11622
      },
      "text": "འདུས་བྱས་ ༼པེ།༽ དུས་བྱས་"
    },
    {
      "span": {
        "start": 11827,
        "end": 11832
      },
      "text": "བསོག་ ༼སྣར། པེ།༽ སོག་"
    },
    {
      "span": {
        "start": 11942,
        "end": 11949
      },
      "text": "མཉམ་པོ་ ༼སྣར།༽ མཉམ་པ་"
    },
    {
      "span": {
        "start": 12082,
        "end": 12087
      },
      "text": "གཏོག་ ༼སྣར། པེ།༽ གཏོགས་"
    },
    {
      "span": {
        "start": 12615,
        "end": 12624
      },
      "text": "རྟག་ཏུ་བ་ ༼སྣར། པེ།༽ རྟག་ཏུ་"
    },
    {
      "span": {
        "start": 12655,
        "end": 12664
      },
      "text": "མཐོང་བའི་ ༼སྣར། པེ།༽ མཐོང་བས་"
    },
    {
      "span": {
        "start": 12882,
        "end": 12888
      },
      "text": "དེ་དག་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 13065,
        "end": 13069
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱི་རྩ་བའི་"
    },
    {
      "span": {
        "start": 13243,
        "end": 13249
      },
      "text": "སྲུངས་ ༼པེ།༽ སྲུངས་སྤུངས་"
    },
    {
      "span": {
        "start": 13318,
        "end": 13323
      },
      "text": "བྱའོ། ༼སྣར། པེ།༽ བྱ་བའོ།"
    },
    {
      "span": {
        "start": 13775,
        "end": 13781
      },
      "text": "བླང་བ་ ༼སྣར། པེ།༽ བླངས་པ་"
    },
    {
      "span": {
        "start": 14106,
        "end": 14113
      },
      "text": "ཉིད་དང་ ༼སྣར། པེ།༽ ཉིད་དམ་"
    },
    {
      "span": {
        "start": 14219,
        "end": 14224
      },
      "text": "ལྔའི་ ༼སྣར། པེ།༽ ལྔ་"
    },
    {
      "span": {
        "start": 14406,
        "end": 14413
      },
      "text": "མང་པོས་ ༼སྣར། པེ།༽ མང་པོ་"
    },
    {
      "span": {
        "start": 14501,
        "end": 14507
      },
      "text": "འགག་པ་ ༼སྣར།༽ འགགས་པ་"
    },
    {
      "span": {
        "start": 14676,
        "end": 14683
      },
      "text": "ཤེས་པར་ ༼སྣར། པེ།༽ ཤེས་པའི་"
    },
    {
      "span": {
        "start": 14723,
        "end": 14740
      },
      "text": "བྱ་བ་དེ་ལྟ་བུ་ནི་ ༼སྣར། པེ།༽ དེ་ལྟ་བུ་"
    },
    {
      "span": {
        "start": 14893,
        "end": 14898
      },
      "text": "སྐྱེ་ ༼སྣར། པེ།༽ སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 14902,
        "end": 14907
      },
      "text": "རག་པ་ ༼སྣར། པེ།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 14930,
        "end": 14937
      },
      "text": "ལ་མ་རག་ ༼སྣར།༽ རིག་ ༼པེ།༽ ལ་མ་རིག་ས་"
    },
    {
      "span": {
        "start": 15206,
        "end": 15212
      },
      "text": "འབྲངས་ ༼སྣར། པེ།༽ འབྲེངས་"
    },
    {
      "span": {
        "start": 15275,
        "end": 15282
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 15549,
        "end": 15557
      },
      "text": "འགྱུར་པ་ ༼སྣར། པེ།༽ འགྱུར་པ་ཉིད་"
    },
    {
      "span": {
        "start": 16044,
        "end": 16052
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 16077,
        "end": 16083
      },
      "text": "ཉམས་པ་ ༼སྣར། པེ།༽ ཉམས་པར་"
    },
    {
      "span": {
        "start": 16170,
        "end": 16177
      },
      "text": "སྒྲོགས་ ༼སྣར། པེ།༽ གྲོགས་"
    },
    {
      "span": {
        "start": 16238,
        "end": 16249
      },
      "text": "མཚན་ཉིད་དང་ ༼སྣར། པེ།༽ མཚན་ཉིད་"
    },
    {
      "span": {
        "start": 16377,
        "end": 16383
      },
      "text": "དང་མི་ ༼སྣར། པེ།༽ དང་མ་"
    },
    {
      "span": {
        "start": 16410,
        "end": 16419
      },
      "text": "སྐྱེས་བུ་ ༼སྣར། པེ།༽ སྐྱེས་བུ་དག་"
    },
    {
      "span": {
        "start": 16615,
        "end": 16623
      },
      "text": "རྗོད་པར་ ༼པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 16633,
        "end": 16669
      },
      "text": "གནས་སྐབས་གཞན་དུ་གྱུར་པ་ཡིན་གྱི། རྫས་ ༼སྣར། པེ།༽ གནས་སྐབས་སུ་"
    },
    {
      "span": {
        "start": 16719,
        "end": 16728
      },
      "text": "བགྲང་བའི་ ༼སྣར། པེ།༽ བགྲངས་པའི་"
    },
    {
      "span": {
        "start": 16949,
        "end": 16956
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 16966,
        "end": 16979
      },
      "text": "ཕྱི་མ་ལ་ལྟོས་ ༼སྣར། པེ།༽ ཕྱི་མ་བལྟོས་"
    },
    {
      "span": {
        "start": 17052,
        "end": 17066
      },
      "text": "བུ་མོ་ཞེས་ཀྱང་ ༼པེ།༽ བུ་མོ་ཞེས་"
    },
    {
      "span": {
        "start": 17320,
        "end": 17337
      },
      "text": "བདེན་པ་སོ་སོ་པའོ། ༼སྣར། པེ།༽ བདེན་པ་སོསོའོ།"
    },
    {
      "span": {
        "start": 17401,
        "end": 17410
      },
      "text": "རྟོག་པའི་ ༼སྣར། པེ།༽ རྟོགས་པའི་"
    },
    {
      "span": {
        "start": 17433,
        "end": 17437
      },
      "text": "ཟེར། ༼སྣར། པེ།༽ ཟེརརོ།"
    },
    {
      "span": {
        "start": 17508,
        "end": 17516
      },
      "text": "འདོད་དོ། ༼སྣར། པེ།༽ འདོད་དེ།"
    },
    {
      "span": {
        "start": 17583,
        "end": 17587
      },
      "text": "ལྷག་ ༼སྣར། པེ།༽ ལྷགས་"
    },
    {
      "span": {
        "start": 17658,
        "end": 17661
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ནི་མ་"
    },
    {
      "span": {
        "start": 18061,
        "end": 18069
      },
      "text": "གྱུར་པར་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 18111,
        "end": 18115
      },
      "text": "ཡིན་ ༼སྣར། པེ།༽ ཡིན་ནོ་"
    },
    {
      "span": {
        "start": 18135,
        "end": 18155
      },
      "text": "རང་བཞིན་གྱིས་ལུང་དུ་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་ལུང་"
    },
    {
      "span": {
        "start": 18178,
        "end": 18185
      },
      "text": "ལས་འདས་ ༼སྣར།༽ ལས་"
    },
    {
      "span": {
        "start": 18328,
        "end": 18337
      },
      "text": "སེམས་ཀྱི་ ༼སྣར། པེ།༽ སེམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 18788,
        "end": 18799
      },
      "text": "རོ་ཞེས་ཟེར་ ༼ཅོ།༽ རོ་ཞེས་"
    },
    {
      "span": {
        "start": 18894,
        "end": 18902
      },
      "text": "མཐུན་པར་ ༼སྣར། པེ།༽ མཐུན་པས་"
    },
    {
      "span": {
        "start": 19126,
        "end": 19133
      },
      "text": "བླངས་པ་ ༼སྣར། པེ།༽ བླང་བ་"
    },
    {
      "span": {
        "start": 19143,
        "end": 19148
      },
      "text": "བརྟག་ ༼སྣར། པེ།༽ བརྟགས་"
    },
    {
      "span": {
        "start": 19219,
        "end": 19226
      },
      "text": "བདེན་པ་ ༼སྣར།༽ བདོན་པ་"
    },
    {
      "span": {
        "start": 19304,
        "end": 19310
      },
      "text": "འབྱུང་ ༼སྣར། པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 19396,
        "end": 19402
      },
      "text": "གཏོགས་ ༼སྣར།༽ གཏོག་"
    },
    {
      "span": {
        "start": 19568,
        "end": 19584
      },
      "text": "། །དགྲ་བཅོམ་པ་ལ་ ༼སྣར། པེ།༽ དགྲ་བཅོམ་པ་"
    },
    {
      "span": {
        "start": 19681,
        "end": 19689
      },
      "text": "ཆོས་ཀྱི་ ༼སྣར། པེ།༽ ཆོས་ཀྱིས་"
    },
    {
      "span": {
        "start": 19740,
        "end": 19743
      },
      "text": "ལས་ ༼ཅོ།༽ ལ་"
    },
    {
      "span": {
        "start": 19781,
        "end": 19789
      },
      "text": "སྤྱོད་པ་ ༼ཅོ།༽ སྤྱོད་པར་"
    },
    {
      "span": {
        "start": 19964,
        "end": 19970
      },
      "text": "བྲལ་བ་ ༼པེ།༽ འབྲལ་བ་"
    },
    {
      "span": {
        "start": 20154,
        "end": 20157
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 20358,
        "end": 20364
      },
      "text": "འཆི་བ་ ༼པེ།༽ འཆི་བར་"
    },
    {
      "span": {
        "start": 20582,
        "end": 20589
      },
      "text": "བརྟག་པ་ ༼སྣར། པེ།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 21005,
        "end": 21012
      },
      "text": "འགག་པར་ ༼སྣར། པེ།༽ འགགས་པར་"
    },
    {
      "span": {
        "start": 21117,
        "end": 21128
      },
      "text": "མཐར་ཐུག་གི་ ༼སྣར། པེ།༽ མཐར་ཐུག་པའི་"
    },
    {
      "span": {
        "start": 21166,
        "end": 21174
      },
      "text": "གཅིག་པོ་ ༼སྣར། པེ།༽ གཅིག་པ་"
    },
    {
      "span": {
        "start": 21379,
        "end": 21388
      },
      "text": "སེམས་དཔས་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 21397,
        "end": 21406
      },
      "text": "སྦྱོང་བར་ ༼ཅོ།༽ སྐྱོད་པར་"
    },
    {
      "span": {
        "start": 21467,
        "end": 21475
      },
      "text": "ལམ་གྱིས་ ༼སྣར། པེ།༽ ལམ་གྱི་"
    },
    {
      "span": {
        "start": 21546,
        "end": 21559
      },
      "text": "དགེ་སྦྱོང་གི་ ༼སྣར། པེ།༽ དགེ་སྦྱོང་གིས་"
    },
    {
      "span": {
        "start": 21806,
        "end": 21812
      },
      "text": "ཉེ་བར་ ༼ཅོ།༽ ཉེ་བ་"
    },
    {
      "span": {
        "start": 22092,
        "end": 22099
      },
      "text": "འཕྲོགས་ ༼སྣར། པེ།༽ འཕོགས་"
    },
    {
      "span": {
        "start": 22152,
        "end": 22160
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 22351,
        "end": 22357
      },
      "text": "ལས་ནས་ ༼སྣར། པེ།༽ ལས་ནི་"
    },
    {
      "span": {
        "start": 23052,
        "end": 23059
      },
      "text": "སྤང་བར་ ༼སྣར། པེ།༽ སྤངས་པར་"
    },
    {
      "span": {
        "start": 23073,
        "end": 23079
      },
      "text": "ལྡང་བ་ ༼པེ།༽ ལྟང་བ་"
    },
    {
      "span": {
        "start": 23237,
        "end": 23246
      },
      "text": "བྱེད་ཀྱི་ ༼སྣར། པེ།༽ བྱེད་ཀྱིས་"
    },
    {
      "span": {
        "start": 23255,
        "end": 23262
      },
      "text": "སྤང་བར་ ༼སྣར། པེ།༽ སྤངས་པར་"
    },
    {
      "span": {
        "start": 23307,
        "end": 23319
      },
      "text": "ལ་འཇིག་རྟེན་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 23571,
        "end": 23579
      },
      "text": "ལུས་ཐ་མ་ ༼སྣར། པེ།༽ ལུས་"
    },
    {
      "span": {
        "start": 23713,
        "end": 23720
      },
      "text": "འགག་པར་ ༼སྣར།༽ འགོག་པར་"
    },
    {
      "span": {
        "start": 23720,
        "end": 23728
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 24061,
        "end": 24069
      },
      "text": "སྒོམ་པས་ ༼སྣར། པེ།༽ བསྒོམ་པས་"
    },
    {
      "span": {
        "start": 24207,
        "end": 24213
      },
      "text": "རྫོགས། ༼སྣར།༽ རྫོགས་སྷོ།"
    },
    {
      "span": {
        "start": 24458,
        "end": 24463
      },
      "text": "།། །། ༼སྣར། པེ།༽ །། །།སརྦ་མངྒལཾ།། །།"
    }
  ]
}