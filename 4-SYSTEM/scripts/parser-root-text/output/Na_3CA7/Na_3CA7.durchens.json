{
  "durchens": [
    {
      "span": {
        "start": 100,
        "end": 103
      },
      "text": "ཡི་ ༼སྣར།༽ གི་ཡི་"
    },
    {
      "span": {
        "start": 548,
        "end": 553
      },
      "text": "གསུམ་ ༼པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 666,
        "end": 687
      },
      "text": "ཡིད་འོང་བྱིན་ཆགས་པའི། ༼པེ།༽ བྱིན་ཆགས་ཡིད་འོང་བའི།"
    },
    {
      "span": {
        "start": 741,
        "end": 748
      },
      "text": "སོང་བས། ༼པེ།༽ སོང་ནས།"
    },
    {
      "span": {
        "start": 774,
        "end": 779
      },
      "text": "བཤམས། ༼སྣར། པེ།༽ བཤམ།"
    },
    {
      "span": {
        "start": 862,
        "end": 867
      },
      "text": "བལྟས་ ༼པེ།༽ ཧྲི་བལྟས་"
    },
    {
      "span": {
        "start": 892,
        "end": 896
      },
      "text": "དྲང་ ༼སྣར།༽ དྲངས་"
    },
    {
      "span": {
        "start": 950,
        "end": 955
      },
      "text": "བསགས་ ༼སྣར། པེ།༽ བསག་"
    },
    {
      "span": {
        "start": 1138,
        "end": 1147
      },
      "text": "བདུད་རྩི་ ༼སྣར།༽ བདུད་རྩིའི་"
    },
    {
      "span": {
        "start": 1728,
        "end": 1735
      },
      "text": "ལྕང་ལོ་ ༼སྣར། པེ།༽ ལྕང་ལོར་"
    },
    {
      "span": {
        "start": 1887,
        "end": 1892
      },
      "text": "འཆང་། ༼སྣར། པེ།༽ འཕྱང་།"
    },
    {
      "span": {
        "start": 1976,
        "end": 1985
      },
      "text": "བརླབས་ཏེ། ༼སྣར། པེ།༽ བརླབ་སྟེ།"
    },
    {
      "span": {
        "start": 2477,
        "end": 2486
      },
      "text": "མེད་པ་ཡི། ༼པེ།༽ མེད་པ་ཡིས།"
    },
    {
      "span": {
        "start": 2583,
        "end": 2593
      },
      "text": "བདེ་གཤེགས་ ༼པེ།༽ བདེར་གཤེགས་"
    },
    {
      "span": {
        "start": 3036,
        "end": 3041
      },
      "text": "གཞག ། ༼པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 3129,
        "end": 3137
      },
      "text": "སྣང་གྲག་ ༼སྣར། པེ།༽ སྣང་གྲགས་"
    },
    {
      "span": {
        "start": 3182,
        "end": 3187
      },
      "text": "བསགས་ ༼པེ།༽ བསག་"
    },
    {
      "span": {
        "start": 3366,
        "end": 3369
      },
      "text": "ཉི་ ༼པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 3835,
        "end": 3841
      },
      "text": "འགྱུར་ ༼པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 4076,
        "end": 4083
      },
      "text": "བཟོད་པ་ ༼པེ།༽ བཟོད་པར་"
    },
    {
      "span": {
        "start": 4174,
        "end": 4184
      },
      "text": "དགེ་བ་ཡིས། ༼སྣར།༽ དགེ་བ་ཡི།"
    },
    {
      "span": {
        "start": 4414,
        "end": 4421
      },
      "text": "ནས་དང་། ༼སྣར།༽ ནས་"
    }
  ]
}