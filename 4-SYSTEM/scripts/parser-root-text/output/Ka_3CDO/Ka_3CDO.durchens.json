{
  "durchens": [
    {
      "span": {
        "start": 46,
        "end": 56
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ སྒོམ་པའི་"
    },
    {
      "span": {
        "start": 170,
        "end": 178
      },
      "text": "བསྒོམ་པ་ ༼སྣར། པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 376,
        "end": 384
      },
      "text": "རྩ་བ་ནི་ ༼སྣར། པེ།༽ རྩ་བ་"
    },
    {
      "span": {
        "start": 427,
        "end": 439
      },
      "text": "ཐོག་མ་ཁོ་ནར་ ༼སྣར། པེ།༽ ཐོག་མར་"
    },
    {
      "span": {
        "start": 598,
        "end": 607
      },
      "text": "སེམས་དཔས་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 666,
        "end": 675
      },
      "text": "སེམས་དཔས་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 1422,
        "end": 1424
      },
      "text": "ཤ་ ༼སྣར།༽ ཤཱ་"
    },
    {
      "span": {
        "start": 1426,
        "end": 1429
      },
      "text": "དྭ་ ༼སྣར། པེ།༽ དྭཱ་"
    },
    {
      "span": {
        "start": 1486,
        "end": 1492
      },
      "text": "ནི་མི་ ༼སྡེ།༽ ནི་"
    },
    {
      "span": {
        "start": 1557,
        "end": 1560
      },
      "text": "དྭ་ ༼སྣར། པེ།༽ དྭཱ་"
    },
    {
      "span": {
        "start": 1568,
        "end": 1575
      },
      "text": "འདི་ལྟ་ ༼ཅོ།༽ འདི་"
    },
    {
      "span": {
        "start": 2107,
        "end": 2121
      },
      "text": "སེམས་དཔའ་རྣམས་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 2191,
        "end": 2201
      },
      "text": "ཤིན་ཏུ་བྱ་ ༼སྣར། པེ།༽ ཤིན་ཏུ་"
    },
    {
      "span": {
        "start": 2377,
        "end": 2384
      },
      "text": "སྐྱེ་བ་ ༼སྣར། པེ།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 2462,
        "end": 2472
      },
      "text": "ཤིན་ཏུ་བྱ་ ༼སྣར། པེ།༽ ཤིན་ཏུ་"
    },
    {
      "span": {
        "start": 2488,
        "end": 2496
      },
      "text": "རིང་པོར་ ༼སྣར། པེ།༽ རིང་པོ་"
    },
    {
      "span": {
        "start": 2609,
        "end": 2628
      },
      "text": "ཐམས་ཅད་ཀྱི་ཆོས་ཀྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 2822,
        "end": 2828
      },
      "text": "འདས་པ་ ༼སྣར། པེ།༽ འདས་པ་དེ་"
    },
    {
      "span": {
        "start": 2953,
        "end": 2968
      },
      "text": "བྱ་བ་མང་དུ་བྱས་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 3142,
        "end": 3151
      },
      "text": "དམྱལ་བ་པ་ ༼སྣར། པེ།༽ དམྱལ་བ་"
    },
    {
      "span": {
        "start": 3711,
        "end": 3722
      },
      "text": "དབང་མེད་པར་ ༼སྣར། པེ།༽ དབང་མེད་པ་"
    },
    {
      "span": {
        "start": 3964,
        "end": 3977
      },
      "text": "མེད་པ་མྱོང་བ་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 4121,
        "end": 4130
      },
      "text": "བསྐྱོན་པ་ ༼སྣར། པེ།༽ སྐྱོན་པ་"
    },
    {
      "span": {
        "start": 4135,
        "end": 4141
      },
      "text": "དཔྱངས་ ༼སྣར། པེ།༽ སྤྱངས་"
    },
    {
      "span": {
        "start": 5078,
        "end": 5084
      },
      "text": "རབ་ཏུ་ ༼སྣར། པེ།༽ རབ་"
    },
    {
      "span": {
        "start": 5150,
        "end": 5156
      },
      "text": "འཕོ་བ་ ༼པེ།༽ འཕོ་"
    },
    {
      "span": {
        "start": 5235,
        "end": 5250
      },
      "text": "གཟུགས་དང་གཟུགས་ ༼སྣར། པེ།༽ གཟུགས་"
    },
    {
      "span": {
        "start": 5266,
        "end": 5299
      },
      "text": "དེ་དག་ཀྱང་སྐད་ཅིག་སྡུག་བསྔལ་གྱིས་ ༼སྣར། པེ།༽ དེ་དག་ཀྱང་"
    },
    {
      "span": {
        "start": 5425,
        "end": 5432
      },
      "text": "ཡོད་པར་ ༼སྣར། པེ།༽ ཡོད་པས་"
    },
    {
      "span": {
        "start": 5521,
        "end": 5527
      },
      "text": "རྒྱུས་ ༼སྣར། པེ།༽ རྒྱུའི་"
    },
    {
      "span": {
        "start": 5944,
        "end": 5950
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 6099,
        "end": 6104
      },
      "text": "ཕལ་པ་ ༼སྣར། པེ།༽ འཕེལ་བ་"
    },
    {
      "span": {
        "start": 6290,
        "end": 6298
      },
      "text": "དེའི་ཚེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 6445,
        "end": 6462
      },
      "text": "འདོད་པའི་རྣམ་པའི་ ༼སྣར། པེ།༽ འདོད་པའི་"
    },
    {
      "span": {
        "start": 6504,
        "end": 6513
      },
      "text": "མཚུངས་པར་ ༼སྣར། པེ།༽ མཚུངས་པར་འཇུག་པར་"
    },
    {
      "span": {
        "start": 6596,
        "end": 6602
      },
      "text": "ཟད་པས་ ༼སྣར།༽ བཟད་པས་"
    },
    {
      "span": {
        "start": 7311,
        "end": 7322
      },
      "text": "ཡེ་ཤེས་ཀྱི་ ༼པེ།༽ ཡེ་ཤེས་ཀྱིས་"
    },
    {
      "span": {
        "start": 7372,
        "end": 7380
      },
      "text": "སེམས་དེ་ ༼སྣར། པེ།༽ སེམས་"
    },
    {
      "span": {
        "start": 7535,
        "end": 7538
      },
      "text": "ཆེ་ ༼སྣར། པེ།༽ ཆེ་ནི་"
    },
    {
      "span": {
        "start": 7846,
        "end": 7856
      },
      "text": "སེམས་དཔའི་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 7926,
        "end": 7929
      },
      "text": "གང་ ༼སྣར། པེ།༽ གང་ལ་"
    },
    {
      "span": {
        "start": 7965,
        "end": 7969
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱི་རྣམ་པ་"
    },
    {
      "span": {
        "start": 8079,
        "end": 8117
      },
      "text": "འཕགས་པ་རྒྱལ་པོ་ལ་གདམས་པའི་མདོ་ལས། འདི་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 8178,
        "end": 8209
      },
      "text": "ཐམས་ཅད་རྣམ་པ་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 8545,
        "end": 8551
      },
      "text": "སྒོམས་ ༼སྣར། པེ།༽ བསྒོམས་"
    },
    {
      "span": {
        "start": 8617,
        "end": 8625
      },
      "text": "སོ་སོའི་ ༼སྣར། པེ།༽ སོ་སོ་"
    },
    {
      "span": {
        "start": 8645,
        "end": 8652
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 8857,
        "end": 8864
      },
      "text": "རྣམས་ལ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 9149,
        "end": 9155
      },
      "text": "བསྔོས་ ༼སྣར། པེ།༽ སྔོས་"
    },
    {
      "span": {
        "start": 9448,
        "end": 9457
      },
      "text": "སྐྱེས་པར་ ༼སྣར། པེ།༽ སྐྱེ་བར་"
    },
    {
      "span": {
        "start": 9571,
        "end": 9583
      },
      "text": "བྱང་ཆུབ་ཀྱི་ ༼སྣར། པེ།༽ བྱང་ཆུབ་"
    },
    {
      "span": {
        "start": 9915,
        "end": 9923
      },
      "text": "རྒྱས་པར་ ༼སྣར།༽ རྒྱས་པ་"
    },
    {
      "span": {
        "start": 10130,
        "end": 10140
      },
      "text": "སེམས་ཀྱིས་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 10157,
        "end": 10166
      },
      "text": "དེ་དང་དེ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 10388,
        "end": 10398
      },
      "text": "གཉེར་བ་དེ་ ༼སྣར། པེ།༽ གཉེར་བའི་"
    },
    {
      "span": {
        "start": 11578,
        "end": 11587
      },
      "text": "སེམས་དཔས་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 12133,
        "end": 12138
      },
      "text": "བསྡུ་ ༼སྣར། པེ།༽ སྡུ་"
    },
    {
      "span": {
        "start": 12323,
        "end": 12328
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 12415,
        "end": 12435
      },
      "text": "དངོས་པོ་ལ་སོགས་པ་དང་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 12520,
        "end": 12528
      },
      "text": "དག་སེམས་ ༼སྣར། པེ།༽ དང་སེམས་"
    },
    {
      "span": {
        "start": 12968,
        "end": 12976
      },
      "text": "སྤྱོད་པ་ ༼སྡེ།༽ སྦྱོང་བ་"
    },
    {
      "span": {
        "start": 13197,
        "end": 13207
      },
      "text": "ཐམས་ཅད་དུ་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 13354,
        "end": 13363
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 13564,
        "end": 13575
      },
      "text": "སྲས་དེ་ལྟར་ ༼སྣར། པེ།༽ སྲས་"
    },
    {
      "span": {
        "start": 14271,
        "end": 14278
      },
      "text": "ཀུན་ཏུ་ ༼སྣར། པེ།༽ ཀུན་"
    },
    {
      "span": {
        "start": 14329,
        "end": 14338
      },
      "text": "གཡན་སྤྱོ་ ༼སྣར། པེ།༽ གཡེན་སྤྱོ་"
    },
    {
      "span": {
        "start": 14456,
        "end": 14462
      },
      "text": "ཁྱབ་པ་ ༼ཅོ།༽ ཁྱབ་པར་"
    },
    {
      "span": {
        "start": 15018,
        "end": 15023
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 15761,
        "end": 15774
      },
      "text": "སྒྲུབ་པའི་ལམ་ ༼སྣར། པེ།༽ སྒྲུབ་པའི་ལས་"
    },
    {
      "span": {
        "start": 16081,
        "end": 16096
      },
      "text": "ཐམས་ཅད་ཀྱི་དོན་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 16383,
        "end": 16391
      },
      "text": "སྤང་བའི་ ༼སྣར། པེ།༽ སྤོང་པའི་"
    },
    {
      "span": {
        "start": 16416,
        "end": 16431
      },
      "text": "འཇམ་དཔལ་གངགང་ལ་ ༼སྣར། པེ།༽ འཇམ་དཔལ་གངགང་"
    },
    {
      "span": {
        "start": 16542,
        "end": 16548
      },
      "text": "སྤང་བ་ ༼སྣར། པེ།༽ སྤོང་བ་"
    },
    {
      "span": {
        "start": 16952,
        "end": 16965
      },
      "text": "གང་ཡིན་པ་དེས་ ༼སྣར། པེ།༽ གང་ཡིན་"
    },
    {
      "span": {
        "start": 17455,
        "end": 17462
      },
      "text": "ཤེས་རབ་ ༼སྣར།༽ ཤེས་"
    },
    {
      "span": {
        "start": 17655,
        "end": 17659
      },
      "text": "གཉི་ ༼སྣར།༽ གཉིས་"
    },
    {
      "span": {
        "start": 17686,
        "end": 17700
      },
      "text": "སེམས་དཔས་བསྟན་ ༼སྣར། པེ།༽ སེམས་དཔའ་བསྟེན་"
    },
    {
      "span": {
        "start": 17883,
        "end": 17892
      },
      "text": "ཆེན་པོའི་ ༼སྣར། པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 17940,
        "end": 17952
      },
      "text": "འདས་ཡོངས་སུ་ ༼སྣར། པེ།༽ འདས་"
    },
    {
      "span": {
        "start": 18309,
        "end": 18316
      },
      "text": "སྡུད་པ་ ༼སྣར། པེ།༽ བསྡུད་པ་"
    },
    {
      "span": {
        "start": 19005,
        "end": 19012
      },
      "text": "བརྟན་པ་ ༼སྣར། པེ།༽ བསྟེན་པ་"
    },
    {
      "span": {
        "start": 19062,
        "end": 19067
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 19085,
        "end": 19090
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་ཞེས་འབྱུང་བའི་ལོག་པར་མི་བཟུང་"
    },
    {
      "span": {
        "start": 19115,
        "end": 19123
      },
      "text": "བཟུང་བར་ ༼སྡེ།༽ གཟུང་བར་"
    },
    {
      "span": {
        "start": 20123,
        "end": 20131
      },
      "text": "བསྩལ་བས་ ༼སྣར། པེ།༽ བསལ་བས་"
    },
    {
      "span": {
        "start": 20603,
        "end": 20618
      },
      "text": "ནི་དོན་དམ་པར་ན་ ༼སྣར། པེ།༽ དོན་དམ་པར་"
    },
    {
      "span": {
        "start": 21008,
        "end": 21020
      },
      "text": "འཇིག་རྟེན་ལ་ ༼སྣར། པེ།༽ འཇིག་རྟེན་"
    },
    {
      "span": {
        "start": 21131,
        "end": 21140
      },
      "text": "སྐྲག་པའི་ ༼སྣར། པེ།༽ སྐྲག་པ་"
    },
    {
      "span": {
        "start": 21257,
        "end": 21286
      },
      "text": "རྒྱས་ཀྱི་ཆོས་ཡང་དག་པར་སྡུད་པ་ ༼སྣར། པེ།༽ རྒྱས་བགྲོ་བ་"
    },
    {
      "span": {
        "start": 21490,
        "end": 21503
      },
      "text": "དང་སྐྱེ་བ་དང་ ༼སྣར།༽ དང་"
    },
    {
      "span": {
        "start": 21634,
        "end": 21642
      },
      "text": "འབྱེད་པ་ ༼སྡེ།༽ འགྱེད་པ་"
    },
    {
      "span": {
        "start": 22201,
        "end": 22210
      },
      "text": "མེད་པ་ནས་ ༼སྡེ།༽ མེད་པ་ན་"
    },
    {
      "span": {
        "start": 22651,
        "end": 22666
      },
      "text": "བཞིན་དུ་རྟག་ཏུ་ ༼སྣར། པེ།༽ བཞིན་དུ་"
    },
    {
      "span": {
        "start": 22670,
        "end": 22673
      },
      "text": "ཅད་ ༼སྣར། པེ།༽ ཅད་དུ་"
    },
    {
      "span": {
        "start": 22766,
        "end": 22775
      },
      "text": "འབྱུང་བར་ ༼སྣར། པེ།༽ འབྱུང་བའི་"
    },
    {
      "span": {
        "start": 22858,
        "end": 22862
      },
      "text": "བའང་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 23454,
        "end": 23460
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 23538,
        "end": 23552
      },
      "text": "ཐམས་ཅད་ཅིག་ཅར་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 24012,
        "end": 24022
      },
      "text": "ནོ་ཞེས་སོ། ༼སྣར། པེ།༽ ནོ་ཞེའོ།"
    },
    {
      "span": {
        "start": 24460,
        "end": 24464
      },
      "text": "ཆོད་ ༼སྣར། པེ།༽ མཆོད་"
    },
    {
      "span": {
        "start": 24619,
        "end": 24636
      },
      "text": "ཆུད་པས་བསྐལ་པ་ཡང་ ༼ཅོ།༽ ཆུད་པས་"
    },
    {
      "span": {
        "start": 24875,
        "end": 24882
      },
      "text": "ཁོ་ནའོ། ༼སྣར། པེ།༽ ཁོ་ནའི།"
    },
    {
      "span": {
        "start": 25071,
        "end": 25081
      },
      "text": "ཐམས་ཅད་ནི་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 25640,
        "end": 25650
      },
      "text": "ངོ་བོ་ཉིད་ ༼སྣར། པེ།༽ ངོ་བོ་"
    },
    {
      "span": {
        "start": 25765,
        "end": 25787
      },
      "text": "རྣམས་ཀྱང་རྣམ་པར་ཕྱེ་ན་ ༼སྣར། པེ།༽ རྣམས་ཀྱང་"
    },
    {
      "span": {
        "start": 25810,
        "end": 25824
      },
      "text": "ཕྲ་མོ་རྣམས་ནི་ ༼སྣར། པེ།༽ ཕྲ་མོ་"
    },
    {
      "span": {
        "start": 25837,
        "end": 25850
      },
      "text": "ཉིད་ཡིན་པས་ན། ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 26246,
        "end": 26256
      },
      "text": "སོ་ཞེས་སོ། ༼སྣར། པེ།༽ སོ་ཞེའོ།"
    },
    {
      "span": {
        "start": 26478,
        "end": 26482
      },
      "text": "བླང་ ༼སྣར།༽ བླངས་"
    },
    {
      "span": {
        "start": 26768,
        "end": 26784
      },
      "text": "ངོ་བོ་ཉིད་ཁོ་ནར་ ༼སྣར། པེ།༽ ངོ་བོར་"
    },
    {
      "span": {
        "start": 26892,
        "end": 26902
      },
      "text": "ངོ་བོ་ཉིད་ ༼སྣར། པེ།༽ ངོ་བོ་"
    },
    {
      "span": {
        "start": 27270,
        "end": 27278
      },
      "text": "བརྫུན་པ་ ༼སྣར། པེ།༽ བརྫུན་པ་ཉིད་ཡིན་པས་རྣམ་པར་ཤེས་པ་ཐམས་ཅད་ཀྱང་བརྫུན་པ་"
    },
    {
      "span": {
        "start": 27719,
        "end": 27726
      },
      "text": "བྱ་བའི་ ༼སྣར། པེ།༽ བྱ་བའི་ཐ་"
    },
    {
      "span": {
        "start": 27920,
        "end": 27928
      },
      "text": "ཕྱེད་པར་ ༼སྣར། པེ།༽ ཕྱེད་པ་"
    },
    {
      "span": {
        "start": 27937,
        "end": 27946
      },
      "text": "མངོན་སུམ་ ༼སྣར། པེ།༽ མངོན་སུམ་དུ་"
    },
    {
      "span": {
        "start": 27958,
        "end": 27969
      },
      "text": "བསྒོམས་པའི་ ༼སྣར། པེ།༽ བསྒོམ་པའི་"
    },
    {
      "span": {
        "start": 28257,
        "end": 28262
      },
      "text": "ལ་ཡང་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 28347,
        "end": 28356
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 28392,
        "end": 28396
      },
      "text": "དོན་ ༼སྣར། པེ།༽ དོན་ལ་"
    },
    {
      "span": {
        "start": 28415,
        "end": 28426
      },
      "text": "བསྒོམས་པའི་ ༼སྣར།༽ བསྒོམ་པའི་"
    },
    {
      "span": {
        "start": 28521,
        "end": 28531
      },
      "text": "འཛིན་གྱིས་ ༼སྣར། པེ།༽ འཛིན་གྱི་"
    },
    {
      "span": {
        "start": 28674,
        "end": 28689
      },
      "text": "ལ་སེམས་གཞོལ་བར་ ༼སྣར། པེ།༽ ལ་སོགས་གཞོལ་"
    },
    {
      "span": {
        "start": 28994,
        "end": 29010
      },
      "text": "ཇི་ལྟ་བ་བཞིན་དུ་ ༼སྣར། པེ།༽ ཇི་ལྟ་བར་"
    },
    {
      "span": {
        "start": 29125,
        "end": 29143
      },
      "text": "རྙེད་པ་ལ་སོགས་པ་ལ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 29467,
        "end": 29477
      },
      "text": "འོང་བའི་ས་ ༼སྣར། པེ།༽ འོང་བའི་"
    },
    {
      "span": {
        "start": 29692,
        "end": 29706
      },
      "text": "དྲང་པོར་བསྲངས་ ༼སྣར། པེ།༽ དྲང་པོ་སྲང་"
    },
    {
      "span": {
        "start": 29738,
        "end": 29752
      },
      "text": "སྐྱིལ་མོ་ཀྲུང་ ༼སྣར། པེ།༽ དཀྱིལ་མོ་དཀྲུང་"
    },
    {
      "span": {
        "start": 30045,
        "end": 30053
      },
      "text": "བསལ་བའི་ ༼སྣར། པེ།༽ བསམ་པའི་"
    },
    {
      "span": {
        "start": 30137,
        "end": 30145
      },
      "text": "དེའི་ཚེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 30155,
        "end": 30159
      },
      "text": "ཁམས་ ༼པེ།༽ ཁམས་དང་"
    },
    {
      "span": {
        "start": 30170,
        "end": 30174
      },
      "text": "བྱེ་ ༼པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 30178,
        "end": 30182
      },
      "text": "གིས་ ༼སྣར། པེ།༽ གི་"
    },
    {
      "span": {
        "start": 30294,
        "end": 30304
      },
      "text": "ཉིད་རྣམ་པ་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 30400,
        "end": 30417
      },
      "text": "འདས་ཀྱིས་སེམས་ཅན་ ༼སྣར། པེ།༽ འདས་ཀྱིས་"
    },
    {
      "span": {
        "start": 30683,
        "end": 30688
      },
      "text": "བགྲང་ ༼སྣར། པེ།༽ འགྲང་"
    },
    {
      "span": {
        "start": 30920,
        "end": 30930
      },
      "text": "བསྒོམས་པས་ ༼སྣར། པེ།༽ བསྒོམ་པས་"
    },
    {
      "span": {
        "start": 31052,
        "end": 31061
      },
      "text": "མངས་ཀྱིས་ ༼སྣར། པེ།༽ མངས་ཀྱི་"
    },
    {
      "span": {
        "start": 31087,
        "end": 31093
      },
      "text": "ཚེ་དེ་ ༼སྡེ།༽ ཚེ་"
    },
    {
      "span": {
        "start": 31256,
        "end": 31261
      },
      "text": "གཉིད་ ༼པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 31346,
        "end": 31353
      },
      "text": "བསྒོམས་ ༼སྣར། པེ།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 32369,
        "end": 32377
      },
      "text": "འདུལ་བར་ ༼སྣར། པེ།༽ དུལ་བར་"
    },
    {
      "span": {
        "start": 32781,
        "end": 32788
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 33354,
        "end": 33363
      },
      "text": "གཉེན་པོར་ ༼སྣར། པེ།༽ གཉེན་པོ་"
    },
    {
      "span": {
        "start": 33802,
        "end": 33811
      },
      "text": "སྦྱངས་པར་ ༼སྣར། པེ།༽ སྦྱང་བར་"
    },
    {
      "span": {
        "start": 33866,
        "end": 33874
      },
      "text": "སྤང་བའི་ ༼སྣར། པེ།༽ སྤོང་བའི་"
    },
    {
      "span": {
        "start": 34040,
        "end": 34048
      },
      "text": "རབ་ཏུ་མ་ ༼སྣར། པེ།༽ རབ་ཏུ་"
    },
    {
      "span": {
        "start": 34234,
        "end": 34240
      },
      "text": "བསྒོམ་ ༼སྣར། པེ།༽ སྒོམ་"
    },
    {
      "span": {
        "start": 34637,
        "end": 34639
      },
      "text": "ལ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 34766,
        "end": 34774
      },
      "text": "ལྕོགས་པ་ ༼ཅོ།༽ ལྕོག་པ་"
    },
    {
      "span": {
        "start": 34899,
        "end": 34907
      },
      "text": "དཔྱོད་པ་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 35192,
        "end": 35200
      },
      "text": "དེའི་ཚེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 35318,
        "end": 35330
      },
      "text": "ཤེས་བཞིན་དག་ ༼སྣར། པེ།༽ ཤེས་བཞིན་"
    },
    {
      "span": {
        "start": 35347,
        "end": 35355
      },
      "text": "དེའི་ཚེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 35752,
        "end": 35759
      },
      "text": "རྣམ་པར་ ༼སྣར། པེ།༽ རྣམ་པ་"
    },
    {
      "span": {
        "start": 35986,
        "end": 35994
      },
      "text": "སྒོམ་པར་ ༼སྣར། པེ།༽ བསྒོམ་པར་"
    },
    {
      "span": {
        "start": 36184,
        "end": 36194
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ སྒོམ་པའི་"
    },
    {
      "span": {
        "start": 36510,
        "end": 36520
      },
      "text": "བདག་མེད་པ། ༼སྣར། པེ།༽ བདག་མེད་པར།"
    },
    {
      "span": {
        "start": 37233,
        "end": 37239
      },
      "text": "དེ་དག་ ༼སྣར། པེ།༽ དེ་དག་ལ་"
    },
    {
      "span": {
        "start": 37246,
        "end": 37251
      },
      "text": "དཔྱད་ ༼སྣར། པེ།༽ སྤྱད་"
    },
    {
      "span": {
        "start": 37287,
        "end": 37301
      },
      "text": "གཟུགས་ཅན་རྣམས་ ༼སྣར། པེ།༽ གཟུགས་ཅན་"
    },
    {
      "span": {
        "start": 37384,
        "end": 37391
      },
      "text": "གཟུང་བ་ ༼སྣར།༽ གཟུངས་བ་"
    },
    {
      "span": {
        "start": 37455,
        "end": 37461
      },
      "text": "དེ་ལྟ་ ༼ཅོ།༽ དེ་"
    },
    {
      "span": {
        "start": 37577,
        "end": 37595
      },
      "text": "ཉིད་ཀྱི་དམིགས་གནས་ ༼སྣར། པེ།༽ ཉིད་ཀྱིས་དམིགས་"
    },
    {
      "span": {
        "start": 37755,
        "end": 37757
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 37994,
        "end": 38011
      },
      "text": "དངོས་པོར་མངོན་པར་ ༼སྣར། པེ།༽ དངོས་པོར་"
    },
    {
      "span": {
        "start": 38202,
        "end": 38207
      },
      "text": "མཆོག་ ༼སྣར། པེ།༽ ཆོས་"
    },
    {
      "span": {
        "start": 38358,
        "end": 38370
      },
      "text": "མཐོང་བའི་ལམ་ ༼སྣར། པེ།༽ མཐོང་བའི་དམ་པ་"
    },
    {
      "span": {
        "start": 38894,
        "end": 38903
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 39152,
        "end": 39165
      },
      "text": "ནི་དངོས་པོ་ལ་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 39313,
        "end": 39318
      },
      "text": "སྤོང་ ༼སྣར། པེ།༽ སྤང་"
    },
    {
      "span": {
        "start": 39386,
        "end": 39391
      },
      "text": "པ་དེ། ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 39405,
        "end": 39413
      },
      "text": "བྱེད་པར་ ༼སྣར། པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 39788,
        "end": 39795
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་ལོགས་པ་ ༼ཅོ།༽ རྟོག་པ་ལོག་པ་"
    },
    {
      "span": {
        "start": 39977,
        "end": 39988
      },
      "text": "ཤེས་རབ་ཀྱི་ ༼སྣར། པེ།༽ ཤེས་རབ་ཀྱིས་"
    },
    {
      "span": {
        "start": 40095,
        "end": 40097
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 40354,
        "end": 40358
      },
      "text": "ལྟར་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 40558,
        "end": 40563
      },
      "text": "བདེན་ ༼ཅོ།༽ བདེན་པ་"
    },
    {
      "span": {
        "start": 40676,
        "end": 40680
      },
      "text": "ཤེས་ ༼སྣར།༽ ཥེས་"
    },
    {
      "span": {
        "start": 40712,
        "end": 40726
      },
      "text": "ལོག་པར་རྣམ་པར་ ༼སྣར། པེ།༽ ལོག་པར་"
    },
    {
      "span": {
        "start": 40735,
        "end": 40745
      },
      "text": "ས་བོན་གྱི་ ༼སྣར། པེ།༽ ས་བོན་གྱིས་"
    },
    {
      "span": {
        "start": 40835,
        "end": 40843
      },
      "text": "བཞིན་དུ་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 40927,
        "end": 40936
      },
      "text": "སྤོང་བའི་ ༼སྣར། པེ།༽ སྤངས་པའི་"
    },
    {
      "span": {
        "start": 41132,
        "end": 41137
      },
      "text": "འཐོབ་ ༼སྣར། པེ།༽ ཐོབ་"
    },
    {
      "span": {
        "start": 41173,
        "end": 41182
      },
      "text": "བསྒོམ་པར་ ༼སྡེ།༽ སྒོམ་པར་"
    },
    {
      "span": {
        "start": 41189,
        "end": 41201
      },
      "text": "ཤེས་རབ་ཀྱིས་ ༼སྣར།༽ ཤེས་རབ་ཀྱི་"
    },
    {
      "span": {
        "start": 41309,
        "end": 41321
      },
      "text": "ཞི་གནས་ཀྱིས་ ༼ཅོ།༽ ཞི་གནས་ཀྱི་"
    },
    {
      "span": {
        "start": 41336,
        "end": 41344
      },
      "text": "བརྟན་པར་ ༼སྣར། པེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 41737,
        "end": 41751
      },
      "text": "བཞིན་དུ་རབ་ཏུ་ ༼སྣར། པེ།༽ བཞིན་དུ་"
    },
    {
      "span": {
        "start": 41833,
        "end": 41847
      },
      "text": "། །དེ་ལྟ་བས་ན་ ༼སྣར། པེ།༽ དེ་ལྟ་བས་"
    },
    {
      "span": {
        "start": 41913,
        "end": 41923
      },
      "text": "དེ་ཉིད་མི་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 41954,
        "end": 41966
      },
      "text": "རྣམས་ཀྱི་ཞི་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 42041,
        "end": 42048
      },
      "text": "བལྟ་བར་ ༼སྣར།༽ ལྟ་བར་"
    },
    {
      "span": {
        "start": 42273,
        "end": 42282
      },
      "text": "དངོས་པོར་ ༼སྣར། པེ།༽ དངོས་པོ་"
    },
    {
      "span": {
        "start": 42358,
        "end": 42367
      },
      "text": "ཉིད་དེ། ། ༼སྡེ།༽ ཉིད་དོ། །"
    },
    {
      "span": {
        "start": 42440,
        "end": 42447
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 42768,
        "end": 42779
      },
      "text": "བྱེད་པ་མེད་ ༼སྣར།༽ བྱེད་"
    },
    {
      "span": {
        "start": 42933,
        "end": 42961
      },
      "text": "སྒྲིབ་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་ ༼སྣར། པེ།༽ སྒྲིབ་པ་"
    },
    {
      "span": {
        "start": 43130,
        "end": 43138
      },
      "text": "བསྟེན་པ་ ༼སྣར། པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 43821,
        "end": 43831
      },
      "text": "ཡིན་པ་ཉིད་ ༼སྣར། པེ།༽ ཡིན་པ་"
    },
    {
      "span": {
        "start": 44145,
        "end": 44152
      },
      "text": "དོན་དམ་ ༼པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 44365,
        "end": 44372
      },
      "text": "ལྡང་བར་ ༼སྣར། པེ།༽ ལྡང་བ་"
    },
    {
      "span": {
        "start": 44425,
        "end": 44428
      },
      "text": "ལྟ་ ༼སྣར། པེ།༽ ལྟ་བ་ཀུན་ནས་ལྡང་བའི་བར་གྱི་ལྟ་"
    },
    {
      "span": {
        "start": 44531,
        "end": 44538
      },
      "text": "བལྟ་བར་ ༼སྣར། པེ།༽ ལྟ་བར་"
    },
    {
      "span": {
        "start": 44563,
        "end": 44570
      },
      "text": "འདུལ་བ་ ༼སྣར།༽ འབུལ་བ་"
    },
    {
      "span": {
        "start": 44620,
        "end": 44631
      },
      "text": "མེད་པའི་ཡེ་ ༼སྣར། པེ།༽ མེད་པའི་"
    },
    {
      "span": {
        "start": 44631,
        "end": 44635
      },
      "text": "ཤེས་ ༼སྣར། པེ།༽ ཤེས་རབ་"
    },
    {
      "span": {
        "start": 44708,
        "end": 44714
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 45009,
        "end": 45021
      },
      "text": "ཉོན་མོངས་པར་ ༼སྣར། པེ།༽ ཉོན་མོངས་པ་"
    },
    {
      "span": {
        "start": 45037,
        "end": 45046
      },
      "text": "རིགས་གང་། ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 45130,
        "end": 45138
      },
      "text": "མེད་པའི་ ༼སྣར། པེ།༽ མེད་པ་མེད་པའི་"
    },
    {
      "span": {
        "start": 45858,
        "end": 45867
      },
      "text": "ཀུན་རྫོབ་ ༼སྣར། པེ།༽ ཀུན་རྫོབ་པ་"
    },
    {
      "span": {
        "start": 45982,
        "end": 45989
      },
      "text": "སྤོང་བ་ ༼སྣར། པེ།༽ སྤངས་པ་"
    },
    {
      "span": {
        "start": 46020,
        "end": 46037
      },
      "text": "འགྱུར་བའི་ལམ་གྱི་ ༼སྣར། པེ།༽ འགྱུར་བའི་ལམ་"
    },
    {
      "span": {
        "start": 46146,
        "end": 46156
      },
      "text": "ལེགས་པར་མ་ ༼སྣར། པེ།༽ ལེགས་པར་མི་"
    },
    {
      "span": {
        "start": 46206,
        "end": 46213
      },
      "text": "སྩལ་ཏེ། ༼སྣར། པེ།༽ སྩལ་པ་སྟེ།"
    },
    {
      "span": {
        "start": 46993,
        "end": 46998
      },
      "text": "གཉིས་ ༼སྡེ།༽ གཉིས་སུ་"
    },
    {
      "span": {
        "start": 47454,
        "end": 47459
      },
      "text": "པ་ནི་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 48044,
        "end": 48054
      },
      "text": "འདིར་རྒྱུ་ ༼སྣར། པེ།༽ འདིར་"
    },
    {
      "span": {
        "start": 48094,
        "end": 48103
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 48274,
        "end": 48278
      },
      "text": "བལྟ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 48370,
        "end": 48377
      },
      "text": "ཇི་སྟེ་ ༼སྣར། པེ།༽ ཇི་སྙེད་"
    },
    {
      "span": {
        "start": 48586,
        "end": 48593
      },
      "text": "རྣམ་པར་ ༼སྣར། པེ།༽ རྣམ་པའི་"
    },
    {
      "span": {
        "start": 48607,
        "end": 48615
      },
      "text": "ཙམ་གྱིས་ ༼པེ།༽ ཙམ་གྱི་"
    },
    {
      "span": {
        "start": 48816,
        "end": 48827
      },
      "text": "འབྱུང་བ་ནས་ ༼སྣར། པེ།༽ འབྱུང་བ་ན་"
    },
    {
      "span": {
        "start": 49111,
        "end": 49126
      },
      "text": "ཀུན་རྫོབ་ཏུ་ཡང་ ༼སྣར། པེ།༽ ཀུན་རྫོབ་ཏུ་"
    },
