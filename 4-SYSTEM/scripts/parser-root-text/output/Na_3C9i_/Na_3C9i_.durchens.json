{
  "durchens": [
    {
      "span": {
        "start": 76,
        "end": 88
      },
      "text": "རྡོ་རྗེ་ཁྲོ་ ༼སྣར། པེ།༽ ཁྲོ་"
    },
    {
      "span": {
        "start": 328,
        "end": 332
      },
      "text": "གཟའ་ ༼སྣར། པེ།༽ བཟའ་"
    },
    {
      "span": {
        "start": 402,
        "end": 409
      },
      "text": "བསླང་བ་ ༼སྣར། པེ།༽ སླང་བ་"
    },
    {
      "span": {
        "start": 538,
        "end": 544
      },
      "text": "བསྐྱར་ ༼སྣར། པེ།༽ སྐྱར་"
    },
    {
      "span": {
        "start": 604,
        "end": 612
      },
      "text": "བརྐོ་བར་ ༼སྣར། པེ།༽ བསྐོ་བར་"
    },
    {
      "span": {
        "start": 749,
        "end": 753
      },
      "text": "ལ། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 859,
        "end": 866
      },
      "text": "དམ་ཚིག་ ༼སྣར། པེ།༽ དམ་ཚིག་དག་ལས་"
    },
    {
      "span": {
        "start": 1405,
        "end": 1408
      },
      "text": "ལྷ། ༼སྣར། པེ།༽ ལྔ།"
    },
    {
      "span": {
        "start": 1582,
        "end": 1586
      },
      "text": "བྲི་ ༼སྣར། པེ།༽ འདྲི་"
    },
    {
      "span": {
        "start": 1913,
        "end": 1921
      },
      "text": "སོང་ཤིག་ ༼སྣར། པེ།༽ སོང་ཞིག་"
    },
    {
      "span": {
        "start": 2016,
        "end": 2018
      },
      "text": "ཡ་ ༼སྣར། པེ།༽ ཡཱ་"
    },
    {
      "span": {
        "start": 2125,
        "end": 2131
      },
      "text": "ལྟོ་བ་ ༼པེ།༽ ལྟོ་བོ་"
    },
    {
      "span": {
        "start": 2376,
        "end": 2379
      },
      "text": "རི་ ༼སྣར། པེ།༽ ར་"
    },
    {
      "span": {
        "start": 2441,
        "end": 2450
      },
      "text": "གླང་པོའི་ ༼སྣར། པེ།༽ གླང་པོ་"
    },
    {
      "span": {
        "start": 2544,
        "end": 2552
      },
      "text": "ཅན་གྱིས་ ༼སྣར། པེ།༽ ཅན་གྱི་"
    },
    {
      "span": {
        "start": 2710,
        "end": 2716
      },
      "text": "ཁང་། ། ༼སྣར། པེ།༽ དྲག །"
    },
    {
      "span": {
        "start": 3316,
        "end": 3323
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 3427,
        "end": 3437
      },
      "text": "ཆེན་པོ་ཡི། ༼སྣར། པེ།༽ ཆེན་པོ་ཡིས།"
    },
    {
      "span": {
        "start": 4221,
        "end": 4229
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 4290,
        "end": 4301
      },
      "text": "རྡོ་རྗེ་ཡི། ༼སྣར། པེ།༽ རྡོ་རྗེ་ཡིས།"
    },
    {
      "span": {
        "start": 4312,
        "end": 4318
      },
      "text": "ད་ལྟར་ ༼སྣར། པེ།༽ ད་ལྟ་"
    },
    {
      "span": {
        "start": 4741,
        "end": 4748
      },
      "text": "བསྡོམས་ ༼སྣར། པེ།༽ སྡོམས་"
    },
    {
      "span": {
        "start": 5421,
        "end": 5430
      },
      "text": "ཕ་རོལ་ཏུ་ ༼སྣར། པེ།༽ ཕ་རོལ་"
    },
    {
      "span": {
        "start": 5518,
        "end": 5526
      },
      "text": "ཕྱིན་པར་ ༼སྣར། པེ།༽ ཕྱིན་པས་"
    },
    {
      "span": {
        "start": 5569,
        "end": 5574
      },
      "text": "བསླབ་ ༼སྣར། པེ།༽ བརླབ་"
    },
    {
      "span": {
        "start": 5586,
        "end": 5592
      },
      "text": "སྤྱོད། ༼སྣར། པེ།༽ སྤྱད།"
    },
    {
      "span": {
        "start": 5665,
        "end": 5669
      },
      "text": "གསད་ ༼སྣར། པེ།༽ བསད་"
    },
    {
      "span": {
        "start": 5679,
        "end": 5686
      },
      "text": "བྱིན་པ་ ༼སྣར། པེ།༽ བྱིན་པར་"
    },
    {
      "span": {
        "start": 5689,
        "end": 5693
      },
      "text": "བླང་ ༼སྣར། པེ།༽ སླང་"
    },
    {
      "span": {
        "start": 5737,
        "end": 5744
      },
      "text": "ཀྱང་ཡང་ ༼སྣར། པེ།༽ ཀྱང་ཡོང་"
    },
    {
      "span": {
        "start": 5772,
        "end": 5776
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ ཡི།"
    },
    {
      "span": {
        "start": 5869,
        "end": 5874
      },
      "text": "མཉེས་ ༼སྣར། པེ།༽ གཉེར་"
    },
    {
      "span": {
        "start": 6064,
        "end": 6070
      },
      "text": "དམན་ལ་ ༼སྣར། པེ།༽ དམན་པ་"
    },
    {
      "span": {
        "start": 6295,
        "end": 6300
      },
      "text": "མདོར་ ༼པེ།༽ འདོར་"
    },
    {
      "span": {
        "start": 6563,
        "end": 6570
      },
      "text": "དྲི་ཡི་ ༼པེ།༽ དྲི་ཡིས་"
    },
    {
      "span": {
        "start": 6640,
        "end": 6650
      },
      "text": "ཐུགས་ཀྱིས་ ༼སྣར། པེ།༽ ཐུགས་ཀྱི་"
    },
    {
      "span": {
        "start": 6660,
        "end": 6666
      },
      "text": "བརླབས། ༼སྣར། པེ།༽ བརླབ།"
    },
    {
      "span": {
        "start": 7174,
        "end": 7182
      },
      "text": "བརྒྱ་ལམ་ ༼སྣར། པེ།༽ རྒྱ་ལམ་"
    },
    {
      "span": {
        "start": 7273,
        "end": 7275
      },
      "text": "བ་ ༼སྣར། པེ།༽ ཝ་"
    },
    {
      "span": {
        "start": 7296,
        "end": 7301
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 7369,
        "end": 7378
      },
      "text": "ཏུ་བཅིང་། ༼སྣར། པེ།༽ ཏུ་ཅིང་།"
    },
    {
      "span": {
        "start": 7646,
        "end": 7650
      },
      "text": "བསང་ ༼སྣར།༽ གསང་"
    },
    {
      "span": {
        "start": 7781,
        "end": 7791
      },
      "text": "བསྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 8166,
        "end": 8176
      },
      "text": "ཁྱམས་འདོད་ ༼སྣར། པེ།༽ འཁྱམས་འཁོད་"
    },
    {
      "span": {
        "start": 8298,
        "end": 8304
      },
      "text": "བརྫེས་ ༼སྣར། པེ།༽ རྫེས་"
    },
    {
      "span": {
        "start": 8767,
        "end": 8773
      },
      "text": "སྡིགས་ ༼སྣར། པེ།༽ རྫེས་"
    },
    {
      "span": {
        "start": 9047,
        "end": 9053
      },
      "text": "སྡིགས་ ༼སྣར། པེ།༽ སྡིག་"
    },
    {
      "span": {
        "start": 9064,
        "end": 9070
      },
      "text": "གདེངས། ༼སྣར། པེ།༽ གདེང་།"
    },
    {
      "span": {
        "start": 9255,
        "end": 9261
      },
      "text": "བརྫེས་ ༼སྣར།༽ རྫེས་"
    },
    {
      "span": {
        "start": 9323,
        "end": 9329
      },
      "text": "སྡིགས་ ༼སྣར། པེ།༽ སྡིག་"
    },
    {
      "span": {
        "start": 9340,
        "end": 9346
      },
      "text": "གདེངས། ༼སྣར། པེ།༽ གདེང་།"
    },
    {
      "span": {
        "start": 9512,
        "end": 9517
      },
      "text": "བགྲད་ ༼སྣར། པེ།༽ བསྒྲད་"
    },
    {
      "span": {
        "start": 9600,
        "end": 9606
      },
      "text": "སྡིགས་ ༼སྣར། པེ།༽ སྡིག་"
    },
    {
      "span": {
        "start": 9617,
        "end": 9623
      },
      "text": "གདེངས། ༼སྣར། པེ།༽ གདེང་།"
    },
    {
      "span": {
        "start": 9809,
        "end": 9812
      },
      "text": "ཡི་ ༼སྣར། པེ།༽ ཡིད་"
    },
    {
      "span": {
        "start": 9884,
        "end": 9889
      },
      "text": "བསྔོ། ༼པེ།༽ སྔོ།"
    },
    {
      "span": {
        "start": 10031,
        "end": 10036
      },
      "text": "གདོང་ ༼སྣར།༽ གདོངས་"
    },
    {
      "span": {
        "start": 10110,
        "end": 10118
      },
      "text": "ན་མ་སྟེ་ ༼སྣར། པེ།༽ ན་མོ་ཏེ་"
    },
    {
      "span": {
        "start": 10132,
        "end": 10137
      },
      "text": "ན་མོ་ ༼སྣར། པེ།༽ ན་མ་"
    },
    {
      "span": {
        "start": 10139,
        "end": 10141
      },
      "text": "མ་ ༼སྣར། པེ།༽ མོ་"
    },
    {
      "span": {
        "start": 10185,
        "end": 10192
      },
      "text": "བྲི་བར་ ༼སྣར། པེ།༽ དྲི་བར་"
    },
    {
      "span": {
        "start": 10197,
        "end": 10201
      },
      "text": "སྐལ་ ༼སྣར། པེ།༽ བསྐལ་"
    },
    {
      "span": {
        "start": 10426,
        "end": 10431
      },
      "text": "དམ་པ་ ༼སྣར། པེ།༽ དམ་པས་"
    },
    {
      "span": {
        "start": 10455,
        "end": 10463
      },
      "text": "ཆེན་པོར་ ༼པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 10500,
        "end": 10505
      },
      "text": "གསོལ། ༼སྣར། པེ།༽ སྩོལ།"
    },
    {
      "span": {
        "start": 10617,
        "end": 10622
      },
      "text": "བཞིས་ ༼སྣར། པེ།༽ བཞེས་"
    },
    {
      "span": {
        "start": 10842,
        "end": 10854
      },
      "text": "ཤེས་པར་གྱིས། ༼སྣར། པེ།༽ ཤེས་པར་བགྱིས།"
    },
    {
      "span": {
        "start": 10923,
        "end": 10929
      },
      "text": "ནས་ཡང་ ༼སྣར། པེ།༽ ཡིས་ནང་"
    },
    {
      "span": {
        "start": 10986,
        "end": 10990
      },
      "text": "འདའ་ ༼པེ།༽ མདའ་"
    },
    {
      "span": {
        "start": 11023,
        "end": 11033
      },
      "text": "ལུས་ཕུལ་ལ། ༼སྣར། པེ།༽ ལུས་ལ་ཕུལ།"
    },
    {
      "span": {
        "start": 11158,
        "end": 11164
      },
      "text": "དེ་ནས་ ༼སྣར། པེ།༽ དེང་ནས་"
    },
    {
      "span": {
        "start": 11164,
        "end": 11169
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 11173,
        "end": 11181
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 11224,
        "end": 11232
      },
      "text": "དྲིལ་བུ་ ༼སྣར། པེ།༽ དྲིལ་བུའི་"
    },
    {
      "span": {
        "start": 11257,
        "end": 11262
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 11262,
        "end": 11297
      },
      "text": "བར་བགྱི། །སློབ་དཔོན་དག་ཀྱང་གཟུང་བར་ ༼པེ།༽ བར་"
    },
    {
      "span": {
        "start": 11370,
        "end": 11377
      },
      "text": "ནི་དུས་ ༼སྣར། པེ།༽ ནམ་དུས་"
    },
    {
      "span": {
        "start": 11545,
        "end": 11555
      },
      "text": "ཆེན་པོ་ཡི། ༼སྣར། པེ།༽ ཆེན་པོ་ཡིས།"
    },
    {
      "span": {
        "start": 11596,
        "end": 11604
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 11884,
        "end": 11889
      },
      "text": "གྲུབ། ༼སྣར། པེ།༽ བཀྲུ།"
    },
    {
      "span": {
        "start": 11973,
        "end": 11979
      },
      "text": "བཛྲོད་ ༼སྣར། པེ།༽ བཛྲོཏྟ་"
    },
    {
      "span": {
        "start": 12296,
        "end": 12301
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 12386,
        "end": 12391
      },
      "text": "ཞིག ། ༼སྣར། པེ།༽ ཅིག །"
    },
    {
      "span": {
        "start": 12580,
        "end": 12585
      },
      "text": "འབུལ། ༼སྣར། པེ།༽ དབུལ།"
    },
    {
      "span": {
        "start": 12592,
        "end": 12597
      },
      "text": "འདིས་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 12862,
        "end": 12868
      },
      "text": "བཀྲོལ། ༼པེ།༽ དཀྲོལ།"
    },
    {
      "span": {
        "start": 12905,
        "end": 12913
      },
      "text": "ལིང་ཐོག་ ༼སྣར། པེ།༽ ལིང་ཏོག་"
    },
    {
      "span": {
        "start": 13052,
        "end": 13061
      },
      "text": "དགྲོལ་བར་ ༼སྣར། པེ།༽ བཀྲོལ་བར་"
    },
    {
      "span": {
        "start": 13061,
        "end": 13064
      },
      "text": "བྱ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 13157,
        "end": 13166
      },
      "text": "སེམས་དཔས་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 13359,
        "end": 13362
      },
      "text": "དེ། ༼སྣར། པེ།༽ དེས།"
    },
    {
      "span": {
        "start": 13364,
        "end": 13372
      },
      "text": "སྤྱི་བོ་ ༼སྣར། པེ།༽ སྤྱི་བོར་"
    },
    {
      "span": {
        "start": 13396,
        "end": 13408
      },
      "text": "བསྐྱོད་པ་ཡི་ ༼སྣར། པེ།༽ བསྐྱོད་པ་ཡིས་"
    },
    {
      "span": {
        "start": 13466,
        "end": 13471
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ གསུང་"
    },
    {
      "span": {
        "start": 13890,
        "end": 13895
      },
      "text": "བསྡུ་ ༼སྣར། པེ།༽ སྡུ་"
    },
    {
      "span": {
        "start": 13958,
        "end": 13968
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 14154,
        "end": 14159
      },
      "text": "ཚིགས་ ༼སྣར།༽ ཚིག་"
    },
    {
      "span": {
        "start": 14208,
        "end": 14217
      },
      "text": "ལྡན་པ་ཡི། ༼སྣར། པེ།༽ ལྡན་པ་ཡིས།"
    },
    {
      "span": {
        "start": 14503,
        "end": 14507
      },
      "text": "ཆོད་ ༼སྣར། པེ།༽ ཚུགས་"
    },
    {
      "span": {
        "start": 14540,
        "end": 14547
      },
      "text": "སྒྲོགས་ ༼སྣར། པེ།༽ གྲགས་"
    },
    {
      "span": {
        "start": 14558,
        "end": 14561
      },
      "text": "རི་ ༼སྣར། པེ།༽ ཏི་"
    },
    {
      "span": {
        "start": 14801,
        "end": 14805
      },
      "text": "སྐེ་ ༼སྣར། པེ།༽ སྐྱེ་"
    },
    {
      "span": {
        "start": 14807,
        "end": 14812
      },
      "text": "སྐོན། ༼སྣར། པེ།༽ སྐྱོན།"
    },
    {
      "span": {
        "start": 14911,
        "end": 14919
      },
      "text": "འགག་མེད་ ༼སྣར། པེ།༽ འགག་པའི་"
    },
    {
      "span": {
        "start": 14953,
        "end": 14964
      },
      "text": "ཡེ་ཤེས་ཆོས་ ༼སྣར། པེ།༽ ཡེ་ཤེས་"
    },
    {
      "span": {
        "start": 14964,
        "end": 14968
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱི་ཆོས་"
    },
    {
      "span": {
        "start": 15403,
        "end": 15406
      },
      "text": "བུ་ ༼པེ།༽ བུད་"
    },
    {
      "span": {
        "start": 15542,
        "end": 15557
      },
      "text": "སློབ་དཔོན་གྱིས། ༼སྣར།༽ སློབ་དཔོན་བགྱིས།"
    },
    {
      "span": {
        "start": 15672,
        "end": 15679
      },
      "text": "པྲ་པརྟ་ ༼སྣར། པེ།༽ པྲ་པ་ཏུ་"
    },
    {
      "span": {
        "start": 15894,
        "end": 15899
      },
      "text": "ཟླ་བ་ ༼སྣར། པེ།༽ དེ་བ་"
    },
    {
      "span": {
        "start": 16014,
        "end": 16023
      },
      "text": "རྒྱུན་བབ་ ༼སྣར། པེ།༽ རྒྱུ་ཕབ་"
    },
    {
      "span": {
        "start": 16079,
        "end": 16083
      },
      "text": "དཔའ་ ༼སྣར། པེ།༽ དབང་"
    },
    {
      "span": {
        "start": 16295,
        "end": 16303
      },
      "text": "ཀྱི་རོས་ ༼སྣར། པེ།༽ ཀྱིས་རོ་"
    },
    {
      "span": {
        "start": 16445,
        "end": 16448
      },
      "text": "ཁས་ ༼སྣར། པེ།༽ ཀས་"
    },
    {
      "span": {
        "start": 16577,
        "end": 16581
      },
      "text": "རིག་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 16592,
        "end": 16597
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 16920,
        "end": 16925
      },
      "text": "གྲུབ། ༼སྣར། པེ།༽ འགྲུབ།"
    },
    {
      "span": {
        "start": 17587,
        "end": 17592
      },
      "text": "གཏུམ་ ༼སྣར། པེ།༽ གསུམ་"
    },
    {
      "span": {
        "start": 17620,
        "end": 17625
      },
      "text": "དྲངས་ ༼སྣར། པེ།༽ དྲང་"
    },
    {
      "span": {
        "start": 17820,
        "end": 17825
      },
      "text": "གྲོལ་ ༼སྣར། པེ།༽ རོལ་"
    },
    {
      "span": {
        "start": 18189,
        "end": 18196
      },
      "text": "འདས་ལས་ ༼སྣར། པེ།༽ འདས་པ་"
    },
    {
      "span": {
        "start": 18349,
        "end": 18351
      },
      "text": "བ། ༼སྣར། པེ།༽ ཝ།"
    },
    {
      "span": {
        "start": 18417,
        "end": 18421
      },
      "text": "ཀརྨ་ ༼སྣར། པེ།༽ དྷརྨཱ་"
    },
    {
      "span": {
        "start": 18513,
        "end": 18515
      },
      "text": "བ། ༼སྣར། པེ།༽ ཝ།"
    },
    {
      "span": {
        "start": 18714,
        "end": 18726
      },
      "text": "བརྩམས་པ་ཡིས་ ༼སྣར། པེ།༽ བརྩམས་པ་ཡི་"
    },
    {
      "span": {
        "start": 18892,
        "end": 18898
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ གྲུབ་"
    },
    {
      "span": {
        "start": 18923,
        "end": 18928
      },
      "text": "སོ། ། ༼སྣར། པེ།༽ ། །འདི་བྲིས་དགེ་བའི་རྩ་བ་ཡིས། །གོས་སྔོན་གོ་འཕང་མྱུར་ཐོབ་ཤོག །"
    }
  ]
}