{
  "durchens": [
    {
      "span": {
        "start": 56,
        "end": 63
      },
      "text": "ཁྲོ་བོ་ ༼སྣར། པེ།༽ ཁྲོ་བོ་བདག་"
    },
    {
      "span": {
        "start": 277,
        "end": 286
      },
      "text": "ཚོན་གྱིས་ ༼སྣར། པེ།༽ ཚོན་གྱི་"
    },
    {
      "span": {
        "start": 365,
        "end": 373
      },
      "text": "འཁོར་ལོ་ ༼སྣར། པེ།༽ འཁོར་ལོའི་"
    },
    {
      "span": {
        "start": 385,
        "end": 402
      },
      "text": "སེར་པོ་རྩིབས་མཆན་ ༼སྣར། པེ།༽ སེར་པོ་འཆན་"
    },
    {
      "span": {
        "start": 763,
        "end": 766
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 1162,
        "end": 1171
      },
      "text": "བསྐྱེད་ལ་ ༼སྣར། པེ།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 1791,
        "end": 1806
      },
      "text": "གཡས་པས་རྡོ་རྗེ་ ༼སྣར།༽ གཡས་པ་རྡོ་ ༼པེ།༽ གཡས་པ་རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 1833,
        "end": 1841
      },
      "text": "གཡོན་པས་ ༼སྣར། པེ།༽ གཡོན་པ་"
    },
    {
      "span": {
        "start": 1946,
        "end": 1956
      },
      "text": "དབུ་བརྒྱན་ ༼སྣར།༽ དབུ་རྒྱན་"
    },
    {
      "span": {
        "start": 1974,
        "end": 1981
      },
      "text": "བགྲད་པ་ ༼སྣར། པེ།༽ བསྒྲད་པ་"
    },
    {
      "span": {
        "start": 2055,
        "end": 2063
      },
      "text": "གཅན་གཟན་ ༼སྣར། པེ།༽ གཅན་ཟན་"
    },
    {
      "span": {
        "start": 2298,
        "end": 2304
      },
      "text": "འདྲིལ་ ༼སྣར། པེ།༽ འགྲིལ་"
    },
    {
      "span": {
        "start": 2585,
        "end": 2591
      },
      "text": "འདྲིལ་ ༼སྣར། པེ།༽ འགྲིལ་"
    },
    {
      "span": {
        "start": 2651,
        "end": 2657
      },
      "text": "གཡས་ན་ ༼སྣར། པེ།༽ གཡས་"
    },
    {
      "span": {
        "start": 3001,
        "end": 3007
      },
      "text": "ཕུར་པ་ ༼སྣར། པེ།༽ ཕུར་བུ་"
    },
    {
      "span": {
        "start": 3225,
        "end": 3232
      },
      "text": "བུམ་པར་ ༼སྣར། པེ།༽ བུམ་པ་"
    },
    {
      "span": {
        "start": 3296,
        "end": 3301
      },
      "text": "བརྩམ་ ༼སྣར། པེ།༽ ཙམ་"
    },
    {
      "span": {
        "start": 3519,
        "end": 3524
      },
      "text": "གཏོར་ ༼སྣར། པེ།༽ བཏོན་"
    },
    {
      "span": {
        "start": 3837,
        "end": 3842
      },
      "text": "ཐལ་བ་ ༼སྣར། པེ།༽ ཐལ་བས་"
    },
    {
      "span": {
        "start": 3970,
        "end": 3979
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 4017,
        "end": 4020
      },
      "text": "ཐབ་ ༼སྣར། པེ།༽ ཐབས་"
    }
  ]
}