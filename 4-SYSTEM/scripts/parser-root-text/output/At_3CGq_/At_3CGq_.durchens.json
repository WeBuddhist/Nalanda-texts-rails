    {
      "span": {
        "start": 13154,
        "end": 13163
      },
      "text": "ས་བཅུ་ཡི། ༼སྣར། པེ།༽ ས་བཅུ་ཡིས།"
    },
    {
      "span": {
        "start": 13206,
        "end": 13214
      },
      "text": "སྦྱོར་བ་ ༼སྣར། པེ།༽ སྦྱར་བ་"
    },
    {
      "span": {
        "start": 13868,
        "end": 13875
      },
      "text": "གཞག་གི། ༼སྣར། པེ།༽ གཞག་གིས།"
