    {
      "span": {
        "start": 14786,
        "end": 14793
      },
      "text": "གསུང་པ་ ༼སྣར། པེ།༽ གསུངས་པ་"
    },
    {
      "span": {
        "start": 14793,
        "end": 14796
      },
      "text": "ནི། ༼སྣར།༽ ན།"
