{
  "durchens": [
    {
      "span": {
        "start": 53,
        "end": 55
      },
      "text": "བ། ༼སྣར། པེ།༽ པཾ།"
    },
    {
      "span": {
        "start": 150,
        "end": 157
      },
      "text": "ཕྱིན་མ་ ༼སྣར། པེ།༽ ཕྱིན་པ་"
    },
    {
      "span": {
        "start": 558,
        "end": 562
      },
      "text": "ཡུམ་ ༼སྣར། པེ།༽ ཡུལ་"
    },
    {
      "span": {
        "start": 909,
        "end": 911
      },
      "text": "ཆ་ ༼སྣར། པེ།༽ ཆག་"
    },
    {
      "span": {
        "start": 984,
        "end": 991
      },
      "text": "གྱི་ལམ་ ༼སྣར། པེ།༽ གྱི་ལན་"
    },
    {
      "span": {
        "start": 1155,
        "end": 1159
      },
      "text": "ཡུམ་ ༼སྣར། པེ།༽ ཡུལ་"
    },
    {
      "span": {
        "start": 1358,
        "end": 1367
      },
      "text": "གྲངས་ངེས་ ༼སྣར། པེ།༽ གྲངས་མེད་"
    },
    {
      "span": {
        "start": 1439,
        "end": 1451
      },
      "text": "ཐོས་བསམ་ཡུམ་ ༼སྣར། པེ།༽ ཐོས་བསམ་ཡུལ་"
    },
    {
      "span": {
        "start": 1662,
        "end": 1667
      },
      "text": "བརྟན་ ༼པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 2007,
        "end": 2012
      },
      "text": "སྐྱེ། ༼སྣར། པེ།༽ བསྐྱེད།"
    },
    {
      "span": {
        "start": 2014,
        "end": 2021
      },
      "text": "དེ་ལྟར་ ༼སྣར།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 2027,
        "end": 2040
      },
      "text": "གོ་རིམས་སོམོ། ༼སྣར། པེ།༽ གོ་རིམ་མོ།"
    },
    {
      "span": {
        "start": 2225,
        "end": 2236
      },
      "text": "རྣམ་དག་གིས། ༼སྣར། པེ།༽ རྣམ་དག་གི།"
    },
    {
      "span": {
        "start": 2334,
        "end": 2338
      },
      "text": "ཆེད་ ༼ཅོ།༽ ཆེ་ ༼སྣར། པེ།༽ ཕྱེད་"
    },
    {
      "span": {
        "start": 2641,
        "end": 2651
      },
      "text": "འབྲས་བུའི་ ༼སྣར། པེ།༽ འབྲས་བུ་"
    },
    {
      "span": {
        "start": 2813,
        "end": 2824
      },
      "text": "སངས་རྒྱས་ས། ༼སྣར།༽ སངས་རྒྱས་སོ།"
    },
    {
      "span": {
        "start": 3048,
        "end": 3058
      },
      "text": "ཐམས་ཅད་ལམ་ ༼སྣར། པེ།༽ ཐམས་ཅད་ལ་"
    },
    {
      "span": {
        "start": 3075,
        "end": 3081
      },
      "text": "ཤེས་ལ་ ༼སྣར། པེ།༽ ཤེས་པ་"
    },
    {
      "span": {
        "start": 3304,
        "end": 3308
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 3431,
        "end": 3437
      },
      "text": "དེས་ན་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 3476,
        "end": 3481
      },
      "text": "སྨོན་ ༼སྣར། པེ།༽ སྨིན་"
    },
    {
      "span": {
        "start": 3491,
        "end": 3495
      },
      "text": "གཞི་ ༼པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 3555,
        "end": 3559
      },
      "text": "གཞི་ ༼པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 3607,
        "end": 3611
      },
      "text": "གཞི་ ༼པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 3660,
        "end": 3664
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 3743,
        "end": 3747
      },
      "text": "གཞི་ ༼པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 3780,
        "end": 3789
      },
      "text": "ད་ལྟར་ནས། ༼སྣར། པེ།༽ ད་ལྟར་གནས།"
    },
    {
      "span": {
        "start": 3799,
        "end": 3809
      },
      "text": "བརྒྱད་པའི་ ༼སྣར། པེ།༽ བརྒྱད་པོ་"
    },
    {
      "span": {
        "start": 3847,
        "end": 3852
      },
      "text": "སྤོང་ ༼སྣར། པེ།༽ སྤོངས་"
    },
    {
      "span": {
        "start": 3895,
        "end": 3901
      },
      "text": "སྤོང་། ༼སྣར། པེ།༽ སྤོངས།"
    },
    {
      "span": {
        "start": 3976,
        "end": 3985
      },
      "text": "ཡུལ་གྱིས་ ༼སྣར། པེ།༽ ཡུལ་གྱི་"
    },
    {
      "span": {
        "start": 4139,
        "end": 4143
      },
      "text": "ཐུག་ ༼སྣར། པེ།༽ ཐུགས་"
    },
    {
      "span": {
        "start": 4210,
        "end": 4218
      },
      "text": "སྐྱེས་པ་ ༼སྣར། པེ།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 4424,
        "end": 4433
      },
      "text": "གྲོལ་ཆེན་ ༼སྣར། པེ།༽ དྲོད་ཆེན་"
    },
    {
      "span": {
        "start": 4542,
        "end": 4553
      },
      "text": "རྫོགས་པ་ནས། ༼སྣར། པེ།༽ རྫོགས་པས་ན།"
    },
    {
      "span": {
        "start": 4656,
        "end": 4667
      },
      "text": "གྱིས་བསྒོམ་ ༼སྣར། པེ།༽ གྱི་སྒོམ་"
    },
    {
      "span": {
        "start": 4727,
        "end": 4734
      },
      "text": "རྩེ་མོ་ ༼སྣར།༽ རྩེ་མོའི་"
    },
    {
      "span": {
        "start": 4755,
        "end": 4763
      },
      "text": "བརྟན་པར་ ༼པེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 4813,
        "end": 4818
      },
      "text": "བརྟན་ ༼སྣར། པེ།༽ རྟན་"
    },
    {
      "span": {
        "start": 5074,
        "end": 5079
      },
      "text": "བརྟན་ ༼སྣར། པེ།༽ རྟན་"
    },
    {
      "span": {
        "start": 5250,
        "end": 5254
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 5296,
        "end": 5305
      },
      "text": "ས་བཅུ་ཡི། ༼སྣར། པེ།༽ ས་བཅུ་ཡིས།"
    },
    {
      "span": {
        "start": 5391,
        "end": 5410
      },
      "text": "ཆོས་སྐུ་སྐྱེད་པ་པོ། ༼སྣར། པེ།༽ ཆོས་སྐུ་བསྐྱེད་པའོ།"
    },
    {
      "span": {
        "start": 5525,
        "end": 5533
      },
      "text": "དང་པོའི་ ༼སྣར། པེ།༽ དང་པོ་"
    },
    {
      "span": {
        "start": 5564,
        "end": 5570
      },
      "text": "དེ་ཡི་ ༼སྣར། པེ།༽ དེ་ཡིས་"
    },
    {
      "span": {
        "start": 5906,
        "end": 5911
      },
      "text": "མཇུག་ ༼སྣར། པེ།༽ འཇུག་"
    },
    {
      "span": {
        "start": 5932,
        "end": 5941
      },
      "text": "དབང་པོའི་ ༼སྣར། པེ།༽ དབང་པོ་"
    },
    {
      "span": {
        "start": 6191,
        "end": 6194
      },
      "text": "ལྔ་ ༼པེ།༽ སྔ་"
    },
    {
      "span": {
        "start": 6307,
        "end": 6318
      },
      "text": "དམིགས་པ་ཡི། ༼སྣར། པེ།༽ དམིགས་པ་ཡིས།"
    },
    {
      "span": {
        "start": 6320,
        "end": 6328
      },
      "text": "ཡིད་ཀྱི་ ༼སྣར།༽ ཡིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 6414,
        "end": 6419
      },
      "text": "སྤོང་ ༼སྣར། པེ།༽ སྤངས་"
    },
    {
      "span": {
        "start": 6618,
        "end": 6624
      },
      "text": "བརྒྱད་ ༼སྣར། པེ།༽ ཁྱད་"
    },
    {
      "span": {
        "start": 6640,
        "end": 6649
      },
      "text": "ཡུལ་གྱིས་ ༼སྣར། པེ།༽ ཡུལ་གྱི་"
    },
    {
      "span": {
        "start": 6755,
        "end": 6761
      },
      "text": "འདོམས་ ༼སྣར། པེ།༽ འདོན་"
    },
    {
      "span": {
        "start": 6800,
        "end": 6807
      },
      "text": "འདི་ཡི་ ༼སྣར། པེ།༽ འདི་ཡིས་"
    },
    {
      "span": {
        "start": 6859,
        "end": 6866
      },
      "text": "འདི་ཡི་ ༼སྣར། པེ།༽ འདི་ཡིས་"
    },
    {
      "span": {
        "start": 7238,
        "end": 7252
      },
      "text": "མཐོང་ལས་སྐྱེད་ ༼སྣར། པེ།༽ མཐོང་ལམ་བཤད་"
    },
    {
      "span": {
        "start": 7288,
        "end": 7295
      },
      "text": "བསྒོམས་ ༼སྣར། པེ།༽ སྒོམ་"
    },
    {
      "span": {
        "start": 7369,
        "end": 7382
      },
      "text": "ཀུན་རྫོབ་ཀྱི། ༼སྣར། པེ།༽ ཀུན་རྫོབ་ཀྱིས།"
    },
    {
      "span": {
        "start": 7514,
        "end": 7522
      },
      "text": "ཆོས་ཤེས་ ༼པེ།༽ ཆོས་"
    },
    {
      "span": {
        "start": 7675,
        "end": 7681
      },
      "text": "དེ་ཡི་ ༼སྣར། པེ།༽ དེ་ཡིས་"
    },
    {
      "span": {
        "start": 7802,
        "end": 7804
      },
      "text": "པ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 7839,
        "end": 7847
      },
      "text": "གཉེན་པོ་ ༼སྣར། པེ།༽ གཉེན་པོའི་"
    },
    {
      "span": {
        "start": 7863,
        "end": 7865
      },
      "text": "ན། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 7875,
        "end": 7883
      },
      "text": "གཏུགས་པ་ ༼སྣར། པེ།༽ གཏུག་པ་"
    },
    {
      "span": {
        "start": 8035,
        "end": 8041
      },
      "text": "གསུང་། ༼སྣར། པེ།༽ གསུངས།"
    },
    {
      "span": {
        "start": 8180,
        "end": 8186
      },
      "text": "ཁོ་ནར་ ༼སྣར། པེ།༽ ཁོ་ནས་"
    },
    {
      "span": {
        "start": 8376,
        "end": 8384
      },
      "text": "བཟང་པོས་ ༼སྣར། པེ།༽ བཟང་པོའི་"
    },
    {
      "span": {
        "start": 8495,
        "end": 8500
      },
      "text": "འདྲེ། ༼སྣར། པེ།༽ འགྲོ།"
    },
    {
      "span": {
        "start": 8615,
        "end": 8621
      },
      "text": "གསུངས། ༼སྣར། པེ།༽ གསུང་།"
    },
    {
      "span": {
        "start": 8754,
        "end": 8757
      },
      "text": "ནི། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 8811,
        "end": 8818
      },
      "text": "སེམས་པ་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 8986,
        "end": 8988
      },
      "text": "ཀ་ ༼སྣར།༽ ག་"
    },
    {
      "span": {
        "start": 9041,
        "end": 9050
      },
      "text": "དྲུག་བཤད། ༼སྣར། པེ།༽ དྲུག་ཏུ།"
    },
    {
      "span": {
        "start": 9131,
        "end": 9137
      },
      "text": "གསུངས། ༼སྣར། པེ།༽ གསུང་།"
    },
    {
      "span": {
        "start": 9156,
        "end": 9164
      },
      "text": "གྱིས་ནི། ༼སྣར། པེ།༽ གྱིས་སོ།"
    },
    {
      "span": {
        "start": 9173,
        "end": 9178
      },
      "text": "དངོས་ ༼སྣར། པེ།༽ མངོན་"
    },
    {
      "span": {
        "start": 9205,
        "end": 9207
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 9281,
        "end": 9287
      },
      "text": "གསུངས། ༼སྣར། པེ།༽ གསུང་།"
    },
    {
      "span": {
        "start": 9408,
        "end": 9414
      },
      "text": "གཟུངས་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 10217,
        "end": 10222
      },
      "text": "བཅག ། ༼སྣར།༽ གཅིག ༼པེ།༽ གཅག །"
    },
    {
      "span": {
        "start": 10230,
        "end": 10237
      },
      "text": "ཁོ་ནའི་ ༼སྣར། པེ།༽ ཁོ་ན་"
    },
    {
      "span": {
        "start": 10564,
        "end": 10573
      },
      "text": "བསྒོམ་ལམ་ ༼སྣར། པེ།༽ སྒོམ་ལམ་"
    },
    {
      "span": {
        "start": 10576,
        "end": 10580
      },
      "text": "འཐད་ ༼སྣར། པེ།༽ འཆད་"
    },
    {
      "span": {
        "start": 10667,
        "end": 10674
      },
      "text": "སྨོན་པ་ ༼སྣར། པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 10819,
        "end": 10828
      },
      "text": "ཆོས་ཀྱིས་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
