    {
      "span": {
        "start": 11328,
        "end": 11341
      },
      "text": "མི་རིགས་དྲུག་ ༼སྣར། པེ།༽ མི་རིགས་གསུམ་"
    },
    {
      "span": {
        "start": 11347,
        "end": 11352
      },
      "text": "རིགས་ ༼པེ།༽ རིག་"
    },
    {
      "span": {
        "start": 11648,
        "end": 11657
      },
      "text": "སྤངས་ཞེས་ ༼སྣར། པེ།༽ སྤང་ཤེས་"
    },
    {
      "span": {
        "start": 11690,
        "end": 11699
      },
      "text": "སྤངས་ཞེས་ ༼སྣར། པེ།༽ སྤོང་ཤེས་"
    },
    {
      "span": {
        "start": 12157,
        "end": 12164
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 12180,
        "end": 12186
      },
      "text": "གསུང་། ༼སྣར། པེ།༽ གསུངས།"
