    {
      "span": {
        "start": 19245,
        "end": 19254
      },
      "text": "འབྲིང་གི་ ༼སྣར། པེ།༽ འབྲིང་ནི་"
    },
    {
      "span": {
        "start": 19405,
        "end": 19414
      },
      "text": "སྦྱོར་དང་ ༼སྣར། པེ།༽ སྦྱོར་ཏེ་"
    },
    {
      "span": {
        "start": 19515,
        "end": 19521
      },
      "text": "ཐེག་པ་ ༼སྣར།༽ ཐགས་པ་"
    },
    {
      "span": {
        "start": 19586,
        "end": 19593
      },
      "text": "སྐྱེ་ལ་ ༼སྣར། པེ།༽ སྐྱེ་པ་"
    },
    {
      "span": {
        "start": 19669,
        "end": 19677
      },
      "text": "སྐྱེ་བར་ ༼སྣར། པེ།༽ བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 19706,
        "end": 19716
      },
      "text": "ཚོགས་པ་ཡི། ༼སྣར། པེ།༽ ཚོགས་པ་ཡིས།"
    },
    {
      "span": {
        "start": 19781,
        "end": 19786
      },
      "text": "མཐོང་ ༼སྣར། པེ།༽ མཐར་"
    },
    {
      "span": {
        "start": 19789,
        "end": 19798
      },
      "text": "བསྒོམ་ལམ་ ༼སྣར། པེ།༽ སྒོམ་ལམ་"
    },
    {
      "span": {
        "start": 19798,
        "end": 19802
      },
      "text": "གྱི། ༼སྣར། པེ།༽ གྱིས།"
    },
    {
      "span": {
        "start": 19992,
        "end": 20001
      },
      "text": "བསྒོམ་ལམ་ ༼སྣར། པེ།༽ སྒོམ་ལམ་"
    },
    {
      "span": {
        "start": 20036,
        "end": 20044
      },
      "text": "ཕྱིར་མི་ ༼སྣར། པེ།༽ ཕྱི་མའི་"
    },
    {
      "span": {
        "start": 20108,
        "end": 20117
      },
      "text": "ཡོད་པས་ན། ༼སྣར། པེ།༽ ཡོད་པས་ནས།"
    },
    {
      "span": {
        "start": 20190,
        "end": 20197
      },
      "text": "དཔོག་པ་ ༼སྣར། པེ།༽ དཔོགས་པ་"
    },
    {
      "span": {
        "start": 20208,
        "end": 20213
      },
      "text": "དཔོག་ ༼སྣར། པེ།༽ དཔོགས་"
    },
    {
      "span": {
        "start": 20264,
        "end": 20274
      },
      "text": "གྱིས་དཔོག་ ༼སྣར། པེ།༽ གྱི་དཔོགས་"
    },
    {
      "span": {
        "start": 20324,
        "end": 20332
      },
      "text": "དཔག་པའི་ ༼སྣར། པེ།༽ དཔགས་པའི་"
    },
    {
      "span": {
        "start": 20356,
        "end": 20364
      },
      "text": "སྐྱེས་པ་ ༼སྣར། པེ།༽ སྐྱེད་པ་"
    },
    {
      "span": {
        "start": 20380,
        "end": 20388
      },
      "text": "སྤྱི་ཡི་ ༼སྣར།༽ སྤྱི་ཡིས་"
    },
    {
      "span": {
        "start": 20499,
        "end": 20508
      },
      "text": "རྩེ་མོའི་ ༼སྣར། པེ།༽ རྩེ་མོ་"
    },
    {
      "span": {
        "start": 20680,
        "end": 20688
      },
      "text": "སྔར་གྱི་ ༼སྣར། པེ།༽ སྔར་གྱིས་"
    },
    {
      "span": {
        "start": 20707,
        "end": 20716
      },
      "text": "བསྒོམ་ལམ་ ༼སྣར། པེ།༽ སྒོམ་ལམ་"
    },
    {
      "span": {
        "start": 20783,
        "end": 20789
      },
      "text": "དེ་མི་ ༼སྣར། པེ།༽ དེ་ནི་"
    },
    {
      "span": {
        "start": 20877,
        "end": 20881
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 20962,
        "end": 20970
      },
      "text": "བཞེད་དོ། ༼སྣར། པེ།༽ བཞེད།"
    },
    {
      "span": {
        "start": 21048,
        "end": 21053
      },
      "text": "ཟློས། ༼སྣར། པེ།༽ བཟློས།"
    },
    {
      "span": {
        "start": 21090,
        "end": 21094
      },
      "text": "ཆུར་ ༼སྣར། པེ།༽ ཆུས་"
    },
    {
      "span": {
        "start": 21099,
        "end": 21104
      },
      "text": "དཔེས་ ༼སྣར། པེ།༽ དཔེར་"
    },
    {
      "span": {
        "start": 21184,
        "end": 21188
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 21222,
        "end": 21228
      },
      "text": "གསུང་། ༼སྣར། པེ།༽ གསུངས།"
    },
    {
      "span": {
        "start": 21275,
        "end": 21283
      },
      "text": "གསུང་པས་ ༼སྣར། པེ།༽ གསུངས་པས་"
    },
    {
      "span": {
        "start": 21385,
        "end": 21388
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 21412,
        "end": 21416
      },
      "text": "ཐེག་ ༼སྣར།༽ ཐག་"
    },
    {
      "span": {
        "start": 21595,
        "end": 21601
      },
      "text": "གསུང་། ༼སྣར། པེ།༽ གསུངས།"
    },
    {
      "span": {
        "start": 21701,
        "end": 21710
      },
      "text": "གཏན་ཚིགས་ ༼སྣར། པེ།༽ གཏིང་ཚིག་"
    },
    {
      "span": {
        "start": 21805,
        "end": 21816
      },
      "text": "དེ་ཉིད་ཀྱི་ ༼སྣར།༽ དེ་ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 21864,
        "end": 21870
      },
      "text": "དེས་ན་ ༼སྣར།༽ དེ་ནི་ ༼པེ།༽ དེ་ན་"
    },
    {
      "span": {
        "start": 21878,
        "end": 21885
      },
      "text": "ཟློས་པ་ ༼སྣར། པེ།༽ བཟློས་པ་"
    },
    {
      "span": {
        "start": 21899,
        "end": 21908
      },
      "text": "གསུང་སྟེ་ ༼སྣར། པེ།༽ གསུངས་ཏེ་"
    },
    {
      "span": {
        "start": 21974,
        "end": 21978
      },
      "text": "ཐབས་ ༼སྣར། པེ།༽ ཐབས་ལ་"
    },
    {
      "span": {
        "start": 21982,
        "end": 21987
      },
      "text": "པ་ཡི་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 22144,
        "end": 22157
      },
      "text": "རྩེ་མོ་བརྟགས་ ༼སྣར། པེ།༽ རྩེ་མོ་རྟགས་"
    },
    {
      "span": {
        "start": 22388,
        "end": 22401
      },
      "text": "གོ་རིམས་ཀྱང་། ༼སྣར། པེ།༽ གོ་རིམ་ཡང་།"
    },
    {
      "span": {
        "start": 22493,
        "end": 22501
      },
      "text": "རྒྱུད་ལ་ ༼སྣར།༽ རྒྱུ་ལ་"
    },
    {
      "span": {
        "start": 22706,
        "end": 22715
      },
      "text": "གསུམ་གྱི་ ༼པེ།༽ གསུམ་གྱིས་"
    },
    {
      "span": {
        "start": 22926,
        "end": 22936
      },
      "text": "བརྟགས་ཞེས་ ༼སྣར། པེ།༽ བཏགས་ཤེས་"
    },
    {
      "span": {
        "start": 23021,
        "end": 23032
      },
      "text": "ཤཱནྟི་པ་ཡི་ ༼སྣར། པེ།༽ ཤཱནྟི་པ་ཡིས་"
    },
    {
      "span": {
        "start": 23077,
        "end": 23086
      },
      "text": "རང་འབྱུང་ ༼སྣར། པེ།༽ རང་བྱུང་"
    },
    {
      "span": {
        "start": 23305,
        "end": 23309
      },
      "text": "སྤང་ ༼སྣར། པེ།༽ སྤངས་"
    },
    {
      "span": {
        "start": 23319,
        "end": 23327
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ བྱུང་བ་"
    },
    {
      "span": {
        "start": 23606,
        "end": 23613
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 23703,
        "end": 23709
      },
      "text": "འཁྲུལ་ ༼སྣར། པེ།༽ འཕྲུལ་"
    },
    {
      "span": {
        "start": 23725,
        "end": 23730
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 23734,
        "end": 23741
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 23741,
        "end": 23750
      },
      "text": "མེད་པ་ཡི། ༼སྣར། པེ།༽ མེད་པ་ཡིས།"
    },
    {
      "span": {
        "start": 23884,
        "end": 23889
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 23956,
        "end": 23964
      },
      "text": "རྟོག་གི་ ༼སྣར། པེ།༽ རྟོག་གིས་"
    },
    {
      "span": {
        "start": 24059,
        "end": 24064
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 24288,
        "end": 24299
      },
      "text": "རྩེ་མོ་སྟེ། ༼སྣར། པེ།༽ རྩེ་མོ་ནི།"
    },
    {
      "span": {
        "start": 24387,
        "end": 24396
      },
      "text": "རྟོག་པའི་ ༼སྣར། པེ།༽ རྟོགས་པའི་"
    },
    {
      "span": {
        "start": 24882,
        "end": 24888
      },
      "text": "རྟོག ། ༼སྣར། པེ།༽ རྟོགས། །"
    },
    {
      "span": {
        "start": 24897,
        "end": 24901
      },
      "text": "གསལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 24923,
        "end": 24932
      },
      "text": "རྟོག་པའི་ ༼སྣར། པེ།༽ རྟོགས་པའི་"
    },
    {
      "span": {
        "start": 25038,
        "end": 25045
      },
      "text": "སྡུད་པ་ ༼པེ།༽ སྡུས་པ་"
    },
    {
      "span": {
        "start": 25050,
        "end": 25058
      },
      "text": "དཔོག་པར་ ༼སྣར། པེ།༽ ལོག་པར་"
    },
    {
      "span": {
        "start": 25058,
        "end": 25068
      },
      "text": "སྒྲུབ་པའི་ ༼སྣར། པེ།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 25094,
        "end": 25105
      },
      "text": "འདུག་པས་སོ། ༼སྣར། པེ།༽ འདུག་པས་སུ།"
    },
    {
      "span": {
        "start": 25207,
        "end": 25215
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 25244,
        "end": 25246
      },
      "text": "ན། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 25315,
        "end": 25324
      },
      "text": "སྦྱིན་དང་ ༼སྣར།༽ སྦྱིན་པས་"
    },
    {
      "span": {
        "start": 25538,
        "end": 25548
      },
      "text": "ཡིན་པས་སུ། ༼སྣར། པེ།༽ ཡིན་པས་སོ།"
    },
    {
      "span": {
        "start": 25646,
        "end": 25654
      },
      "text": "ཡིན་ཡང་། ༼སྣར།༽ ཡིན་ཡོང་།"
    },
    {
      "span": {
        "start": 25677,
        "end": 25683
      },
      "text": "འདུ། ། ༼སྣར། པེ།༽ འདུག །"
    },
    {
      "span": {
        "start": 25772,
        "end": 25777
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ གསུང་"
    },
    {
      "span": {
        "start": 25792,
        "end": 25798
      },
      "text": "གསུངས། ༼སྣར། པེ།༽ གསུང་།"
    },
    {
      "span": {
        "start": 25846,
        "end": 25855
      },
      "text": "གཉིས་ཀྱི། ༼སྣར། པེ།༽ གཉིས་ཀྱིས།"
    },
    {
      "span": {
        "start": 25995,
        "end": 26007
      },
      "text": "སྐུ་བཞི་ཤེས་ ༼སྣར། པེ།༽ སྐུ་བཞི་ཞེས་"
    },
    {
      "span": {
        "start": 26292,
        "end": 26301
      },
      "text": "འཁོར་གྱི་ ༼སྣར།༽ འཁོར་གྱིས་"
    },
    {
      "span": {
        "start": 26319,
        "end": 26326
      },
      "text": "འཇོག་པ་ ༼པེ།༽ ལྗོག་པ་"
    },
    {
      "span": {
        "start": 26335,
        "end": 26339
      },
      "text": "ཆེད་ ༼སྣར། པེ།༽ མཆེད་"
    },
    {
      "span": {
        "start": 26463,
        "end": 26468
      },
      "text": "ལྔ་ཀ་ ༼སྣར། པེ།༽ ལྔ་པ་"
    },
    {
      "span": {
        "start": 26629,
        "end": 26639
      },
      "text": "སྒྲུབ་པའི་ ༼སྣར། པེ།༽ གྲུབ་པའི་"
    },
    {
      "span": {
        "start": 26908,
        "end": 26917
      },
      "text": "འཁོར་གྱི་ ༼པེ།༽ འཁོར་གྱིས་"
    },
    {
      "span": {
        "start": 27029,
        "end": 27038
      },
      "text": "འགོག་མིན་ ༼སྣར། པེ།༽ འོག་མིན་"
    },
    {
      "span": {
        "start": 27368,
        "end": 27375
      },
      "text": "ཕལ་དུད་ ༼སྣར། པེ།༽ ཕལ་དུ་"
    },
    {
      "span": {
        "start": 27453,
        "end": 27462
      },
      "text": "བརྒྱན་པར་ ༼སྣར། པེ།༽ རྒྱན་པར་"
    },
    {
      "span": {
        "start": 27575,
        "end": 27583
      },
      "text": "བརྗོད་པ་ ༼སྣར། པེ།༽ རྗོད་པ་"
    },
    {
      "span": {
        "start": 27609,
        "end": 27612
      },
      "text": "སུ། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 27634,
        "end": 27660
      },
      "text": "། །དེ་ལྟ་བ་དང་དེ་ལྟ་བུར། ། ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 27667,
        "end": 27681
      },
      "text": "སྤྲུལ་པའི་སྐུ་ ༼སྣར།༽ སྤྲུལ་པའི་མ་"
    },
    {
      "span": {
        "start": 27690,
        "end": 27696
      },
      "text": "དེ་ཡི་ ༼སྣར། པེ།༽ དེ་ཡིས་"
    },
    {
      "span": {
        "start": 27880,
        "end": 27885
      },
      "text": "དགོད་ ༼སྣར། པེ།༽ འགོད་"
    },
    {
      "span": {
        "start": 27985,
        "end": 27989
      },
      "text": "འདས་ ༼སྣར། པེ།༽ ཟླས་"
    },
    {
      "span": {
        "start": 28073,
        "end": 28076
      },
      "text": "ལར་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 28180,
        "end": 28184
      },
      "text": "བྱས། ༼སྣར།༽ བྱ་བ།"
    },
    {
      "span": {
        "start": 28225,
        "end": 28230
      },
      "text": "རྟོག་ ༼པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 28322,
        "end": 28337
      },
      "text": "ཕྱིན་པའི་བསྡུས་ ༼སྣར། པེ།༽ ཕྱིན་པའི་"
    },
    {
      "span": {
        "start": 28337,
        "end": 28341
      },
      "text": "དོན་ ༼སྣར། པེ།༽ དོན་བསྡུས་"
    },
    {
      "span": {
        "start": 28460,
        "end": 28472
      },
      "text": "རྒྱལ་བས།། །། ༼སྣར། པེ།༽ རྒྱལ་བསབས།། །།སླད་ཀྱི་དཔལ་བསམ་ཡས་ལྷུན་གྱི་གྲུབ་པའི་རིག་པ་འབྱུང་བའི་གནས་སུ། དཱི་པཾ་ཀ་ར་ཤྲཱི་ཛྙཱ་ནས་ཉི་ཁྲི་བཤད་པའི་དུས་སུ་འདིར་བཤད་པ་ནས་བཏོན། ཕྱིས་ལོ་པཎ་གཉིས་ཀྱིས་བི་བར་ཏ་ཡིས་གསུངས་པ་དག་པའི་དཔེར་ཚུད་པའོ། །འདི་དཔེ་ཕྱི་མོ་དང་བི་བར་ཏ་དང་རྒྱ་དཔེ་གསུམ་མཆིམས་ཕུ་ན། བཻ་རོ་ཙ་ནས་བསྒྱུར་བའི་འབུམ་ཤ་སྒྲོ་ཅན་གྱིས་ནང་ན་ཡོད་དོ་སྐད། བཀྲ་ཤིས། །"
    }
  ]
}