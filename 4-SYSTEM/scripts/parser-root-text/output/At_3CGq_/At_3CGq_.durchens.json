    {
      "span": {
        "start": 14304,
        "end": 14312
      },
      "text": "གཞི་ཤེས་ ༼སྣར། པེ།༽ བཞི་ཞེས་"
    },
    {
      "span": {
        "start": 14383,
        "end": 14392
      },
      "text": "བསྒོམ་ལམ་ ༼སྣར། པེ།༽ སྒོམ་ལམ་"
    },
    {
      "span": {
        "start": 14526,
        "end": 14532
      },
      "text": "གསུང་། ༼སྣར། པེ།༽ གསུངས།"
    },
    {
      "span": {
        "start": 14683,
        "end": 14687
      },
      "text": "ཡིད། ༼སྣར། པེ།༽ ཡོད།"
