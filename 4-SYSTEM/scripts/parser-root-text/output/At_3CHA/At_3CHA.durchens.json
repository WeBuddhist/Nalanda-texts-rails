{
  "durchens": [
    {
      "span": {
        "start": 427,
        "end": 434
      },
      "text": "ཕུལ་དུ་ ༼སྣར། པེ།༽ ཕུལ་"
    },
    {
      "span": {
        "start": 1699,
        "end": 1707
      },
      "text": "ལས་ཀྱིས་ ༼སྣར། པེ།༽ ལས་ཀྱི་"
    },
    {
      "span": {
        "start": 1888,
        "end": 1895
      },
      "text": "དག་གིས་ ༼སྣར། པེ།༽ དག་གི་"
    },
    {
      "span": {
        "start": 1955,
        "end": 1964
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 2264,
        "end": 2270
      },
      "text": "མྱ་ངམ་ ༼སྣར། པེ།༽ མྱ་ངམ་པ་"
    },
    {
      "span": {
        "start": 3201,
        "end": 3209
      },
      "text": "རྙིངས་པ་ ༼སྣར། པེ།༽ བརྙིངས་པ་"
    },
    {
      "span": {
        "start": 3527,
        "end": 3535
      },
      "text": "འཛུམས་པ་ ༼སྣར། པེ།༽ འཛུམ་པ་"
    },
    {
      "span": {
        "start": 3632,
        "end": 3636
      },
      "text": "དག ། ༼སྣར།༽ དགའ། །"
    },
    {
      "span": {
        "start": 3827,
        "end": 3837
      },
      "text": "ལུགས་ཀྱིས་ ༼སྣར། པེ།༽ ལུགས་ཀྱི་"
    },
    {
      "span": {
        "start": 4232,
        "end": 4238
      },
      "text": "ཐ་མའི་ ༼སྣར། པེ།༽ ཐ་མ་པའི་"
    },
    {
      "span": {
        "start": 4274,
        "end": 4280
      },
      "text": "སྨྲ་བ་ ༼སྣར། པེ།༽ སྨྲ་"
    },
    {
      "span": {
        "start": 4416,
        "end": 4422
      },
      "text": "དེ་དག་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 4441,
        "end": 4447
      },
      "text": "སྒྲོག་ ༼སྣར། པེ།༽ སྒྲོགས་"
    },
    {
      "span": {
        "start": 4616,
        "end": 4626
      },
      "text": "བརྫུན་སྨྲ་ ༼སྣར། པེ།༽ རྫུན་སྨྲ་"
    },
    {
      "span": {
        "start": 4754,
        "end": 4761
      },
      "text": "ཆེན་པོ་ ༼སྣར། པེ།༽ ཆེན་པོ་དང་"
    },
    {
      "span": {
        "start": 4772,
        "end": 4781
      },
      "text": "ཡིད་ཀྱིས་ ༼སྣར། པེ།༽ ཡིད་ཀྱི་"
    },
    {
      "span": {
        "start": 5190,
        "end": 5194
      },
      "text": "ཏོར་ ༼སྣར། པེ།༽ གཏོར་"
    },
    {
      "span": {
        "start": 5369,
        "end": 5377
      },
      "text": "ལུས་ཀྱི་ ༼སྣར། པེ།༽ ལུས་ཀྱིས་"
    },
    {
      "span": {
        "start": 5664,
        "end": 5673
      },
      "text": "གྱི་སྐབས་ ༼སྣར།༽ གྱིས་སླབས་ ༼པེ།༽ གྱིས་སྐབས་"
    },
    {
      "span": {
        "start": 5727,
        "end": 5744
      },
      "text": "འདས་པའི་བརྫུན་དུ་ ༼སྣར། པེ།༽ འདས་པའི་རྫུན་"
    },
    {
      "span": {
        "start": 5834,
        "end": 5839
      },
      "text": "འཕྱས་ ༼སྣར། པེ།༽ འཕྱས་པ་"
    },
    {
      "span": {
        "start": 6187,
        "end": 6197
      },
      "text": "སེམས་ཀྱིས་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 6234,
        "end": 6247
      },
      "text": "སྲོག་འཕྲོག་པ་ ༼སྣར།༽ སྲོག་འཁྲོགས་"
    },
    {
      "span": {
        "start": 6463,
        "end": 6469
      },
      "text": "ཉེས་པ་ ༼སྣར།༽ ཉེས་པར་"
    },
    {
      "span": {
        "start": 6531,
        "end": 6536
      },
      "text": "སེམས་ ༼སྣར། པེ།༽ སེམས་ཅན་"
    },
    {
      "span": {
        "start": 6596,
        "end": 6604
      },
      "text": "འཛིན་པས་ ༼སྣར། པེ།༽ འཛིན་པའི་"
    },
    {
      "span": {
        "start": 6683,
        "end": 6693
      },
      "text": "བསགས་པ་ཡི། ༼སྣར། པེ།༽ བསགས་པ་ཡིས།"
    },
    {
      "span": {
        "start": 7112,
        "end": 7122
      },
      "text": "རྩེད་མོའི་ ༼སྣར།༽ རྩེ་མོའི་"
    },
    {
      "span": {
        "start": 7214,
        "end": 7218
      },
      "text": "ཁོན་ ༼སྣར། པེ།༽ འཁོན་"
    },
    {
      "span": {
        "start": 7277,
        "end": 7287
      },
      "text": "རྒྱལ་པོའི་ ༼སྣར། པེ།༽ རྒྱལ་པོ་ཆེན་པོའི་"
    },
    {
      "span": {
        "start": 7342,
        "end": 7351
      },
      "text": "བགྲུངས་པ་ ༼སྣར། པེ།༽ འགྲུངས་པ་"
    },
    {
      "span": {
        "start": 7362,
        "end": 7366
      },
      "text": "བཅད་ ༼སྣར། པེ།༽ གཅད་"
    },
    {
      "span": {
        "start": 7491,
        "end": 7495
      },
      "text": "གསད་ ༼སྣར།༽ གསོད་"
    },
    {
      "span": {
        "start": 7777,
        "end": 7783
      },
      "text": "སྟིའམ། ༼སྣར། པེ།༽ བསྟིའམ།"
    },
    {
      "span": {
        "start": 7944,
        "end": 7953
      },
      "text": "བགྲུངས་པ་ ༼སྣར། པེ།༽ འགྲུངས་པ་"
    },
    {
      "span": {
        "start": 7962,
        "end": 7966
      },
      "text": "བཅད་ ༼སྣར། པེ།༽ གཅད་"
    },
    {
      "span": {
        "start": 8150,
        "end": 8162
      },
      "text": "བདག་ཉིད་ཀྱི་ ༼སྣར། པེ།༽ བདག་ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 8183,
        "end": 8195
      },
      "text": "བདག་ཉིད་ཀྱི་ ༼སྣར། པེ།༽ བདག་ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 8204,
        "end": 8216
      },
      "text": "བདག་ཉིད་ཀྱི་ ༼སྣར། པེ།༽ བདག་ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 8229,
        "end": 8241
      },
      "text": "བདག་ཉིད་ཀྱི་ ༼སྣར། པེ།༽ བདག་ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 8253,
        "end": 8265
      },
      "text": "བདག་ཉིད་ཀྱི་ ༼སྣར། པེ།༽ བདག་ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 8522,
        "end": 8528
      },
      "text": "སིག་པ་ ༼སྣར། པེ།༽ སིགས་པ་"
    },
    {
      "span": {
        "start": 8889,
        "end": 8900
      },
      "text": "བརྫུན་སྨྲས་ ༼སྣར། པེ།༽ རྫུན་སྨྲས་"
    },
    {
      "span": {
        "start": 8914,
        "end": 8920
      },
      "text": "བརྫུན་ ༼སྣར། པེ།༽ རྫུན་"
    },
    {
      "span": {
        "start": 8987,
        "end": 8993
      },
      "text": "བརྫུན་ ༼སྣར། པེ།༽ རྫུན་"
    },
    {
      "span": {
        "start": 9086,
        "end": 9091
      },
      "text": "མཇུག་ ༼སྣར། པེ།༽ འཇུག་"
    },
    {
      "span": {
        "start": 9242,
        "end": 9247
      },
      "text": "འགྲོ། ༼སྣར།༽ བགྲོད།"
    },
    {
      "span": {
        "start": 9268,
        "end": 9278
      },
      "text": "བརྫུན་ཚིག་ ༼སྣར། པེ།༽ རྫུན་ཚིག་"
    },
    {
      "span": {
        "start": 9293,
        "end": 9303
      },
      "text": "སེམས་ཀྱིས་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 9309,
        "end": 9315
      },
      "text": "འབྱེད། ༼སྣར། པེ།༽ བྱེད།"
    },
    {
      "span": {
        "start": 10079,
        "end": 10088
      },
      "text": "ཆོས་ཀྱིས་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 10110,
        "end": 10120
      },
      "text": "བསྐྱེད་པར་ ༼སྣར། པེ།༽ སྐྱེས་པར་"
    },
    {
      "span": {
        "start": 10140,
        "end": 10147
      },
      "text": "ཡིན་པར་ ༼སྣར། པེ།༽ ཡིན་པ་"
    },
    {
      "span": {
        "start": 10192,
        "end": 10198
      },
      "text": "བརྫུན་ ༼སྣར། པེ།༽ རྫུན་"
    },
    {
      "span": {
        "start": 10290,
        "end": 10296
      },
      "text": "བརྫུན་ ༼སྣར།༽ བརྫུན་རྫུན་"
    },
    {
      "span": {
        "start": 10296,
        "end": 10300
      },
      "text": "གྱི་ ༼པེ།༽ གྱི་རྫུན་གྱིས་"
    },
    {
      "span": {
        "start": 10509,
        "end": 10520
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼པེ།༽ ཐམས་ཅད་ཀྱིས་"
    },
    {
      "span": {
        "start": 10613,
        "end": 10625
      },
      "text": "དབྱེན་དུ་མི་ ༼སྣར། པེ།༽ དབྱེན་དུ་"
    },
    {
      "span": {
        "start": 10635,
        "end": 10642
      },
      "text": "ཚིག་དེ་ ༼སྣར། པེ།༽ ཚིག་"
    },
    {
      "span": {
        "start": 10719,
        "end": 10727
      },
      "text": "སེམས་ཅན་ ༼སྣར། པེ།༽ སེམས་ཅན་གྱི་"
    },
    {
      "span": {
        "start": 10736,
        "end": 10743
      },
      "text": "ཞུགས་པ་ ༼སྣར། པེ།༽ བཞུགས་པ་"
    },
    {
      "span": {
        "start": 10765,
        "end": 10768
      },
      "text": "ལས་ ༼སྣར།༽ རྣས་"
    },
    {
      "span": {
        "start": 11012,
        "end": 11023
      },
      "text": "ལོངས་སྤྱོད་ ༼སྣར།༽ ལོངས་སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 11026,
        "end": 11034
      },
      "text": "གཞན་གྱི་ ༼པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 11262,
        "end": 11272
      },
      "text": "སེམས་དཔའི་ ༼སྣར།༽ སེམས་དཔའི་ས་"
    },
    {
      "span": {
        "start": 11323,
        "end": 11326
      },
      "text": "དག་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 11396,
        "end": 11405
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 11917,
        "end": 11922
      },
      "text": "ལྟ་བ་ ༼པེ།༽ བལྟ་བ་"
    },
    {
      "span": {
        "start": 12118,
        "end": 12126
      },
      "text": "གསང་བའི་ ༼སྣར།༽ གསང་བ་པའི་"
    },
    {
      "span": {
        "start": 12331,
        "end": 12340
      },
      "text": "སྐྱེད་པར་ ༼སྣར། པེ།༽ བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 12430,
        "end": 12439
      },
      "text": "འབྲིང་དང་ ༼སྣར།༽ འབྲིང་བ་"
    },
    {
      "span": {
        "start": 12518,
        "end": 12527
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 12919,
        "end": 12930
      },
      "text": "ལ་དུས་ཀྱིས་ ༼སྣར། པེ།༽ ལ་དུས་ཀྱི་"
    },
    {
      "span": {
        "start": 13101,
        "end": 13111
      },
      "text": "གྲངས་ཀྱིས་ ༼སྣར། པེ།༽ གྲངས་ཀྱི་"
    },
    {
      "span": {
        "start": 13122,
        "end": 13130
      },
      "text": "ལན་གཅིག་ ༼སྣར། པེ།༽ ལན་ཅིག་"
    },
    {
      "span": {
        "start": 13136,
        "end": 13140
      },
      "text": "འདི་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 13395,
        "end": 13404
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 13476,
        "end": 13487
      },
      "text": "འབྲིང་པོའོ། ༼སྣར།༽ འབྲིང་པའོ།"
    },
    {
      "span": {
        "start": 13494,
        "end": 13502
      },
      "text": "གཉེན་པོ་ ༼སྣར། པེ།༽ གཉེན་པོ་མི་"
    },
    {
      "span": {
        "start": 13618,
        "end": 13622
      },
      "text": "གཡམ་ ༼སྣར། པེ།༽ གཡེམ་"
    },
    {
      "span": {
        "start": 13725,
        "end": 13736
      },
      "text": "རྐྱེན་བྱེད་ ༼སྣར། པེ།༽ རྐྱེན་"
    },
    {
      "span": {
        "start": 13891,
        "end": 13900
      },
      "text": "ཆུང་ངུའོ། ༼སྣར།༽ པའི ༼པེ།༽ ཆུང་བའོ།"
    },
    {
      "span": {
        "start": 14138,
        "end": 14145
      },
      "text": "འཕགས་པ་ ༼སྣར། པེ།༽ འཕགས་པ་པ་"
    },
    {
      "span": {
        "start": 14242,
        "end": 14252
      },
      "text": "བསམས་བཞིན་ ༼སྣར། པེ།༽ བསམ་བཞིན་"
    },
    {
      "span": {
        "start": 14424,
        "end": 14434
      },
      "text": "གང་ཡིན་ལས། ༼སྣར།༽ གང་ཡིན་པས།"
    },
    {
      "span": {
        "start": 15027,
        "end": 15036
      },
      "text": "མཐར་གྱིས་ ༼སྣར། པེ།༽ མཐར་གྱི་"
    },
    {
      "span": {
        "start": 15048,
        "end": 15054
      },
      "text": "བསྟེན་ ༼སྣར།༽ བསྟན་"
    },
    {
      "span": {
        "start": 15164,
        "end": 15176
      },
      "text": "ཡེ་ཤེས་ཀྱིས་ ༼པེ།༽ ཡེ་ཤེས་ཀྱི་"
    }
  ]
}