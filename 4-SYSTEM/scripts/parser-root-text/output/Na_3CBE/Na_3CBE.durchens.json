{
  "durchens": [
    {
      "span": {
        "start": 343,
        "end": 351
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 378,
        "end": 384
      },
      "text": "མྱ་ངན་ ༼སྣར།༽ མྱ་ངན་ལ་"
    },
    {
      "span": {
        "start": 458,
        "end": 463
      },
      "text": "སྡུག་ ༼སྣར།༽ བསྡུག་"
    },
    {
      "span": {
        "start": 623,
        "end": 625
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 629,
        "end": 632
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 644,
        "end": 654
      },
      "text": "དེའི་ཕྱིར་ ༼སྣར། པེ།༽ དེ་ཕྱིར་"
    },
    {
      "span": {
        "start": 762,
        "end": 773
      },
      "text": "ཡུན་རིང་བར་ ༼སྣར། པེ།༽ ཡུན་རིང་པོར་"
    },
    {
      "span": {
        "start": 826,
        "end": 834
      },
      "text": "འདི་ལྟར་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 998,
        "end": 1003
      },
      "text": "རྡེག་ ༼སྣར། པེ།༽ བརྡེག་"
    },
    {
      "span": {
        "start": 1734,
        "end": 1738
      },
      "text": "གི ། ༼སྣར། པེ།༽ གིས། །"
    },
    {
      "span": {
        "start": 1780,
        "end": 1789
      },
      "text": "དབང་པོའི་ ༼སྣར། པེ།༽ དང་པོའི་"
    },
    {
      "span": {
        "start": 1796,
        "end": 1804
      },
      "text": "འཐོབ་པར་ ༼སྣར། པེ།༽ ཐོབ་པར་"
    },
    {
      "span": {
        "start": 2158,
        "end": 2163
      },
      "text": "སྒོམ། ༼སྣར། པེ།༽ བསྒོམ།"
    },
    {
      "span": {
        "start": 2548,
        "end": 2557
      },
      "text": "རྣམས་ཀྱི། ༼སྣར། པེ།༽ རྣམས་ཀྱིས།"
    },
    {
      "span": {
        "start": 2567,
        "end": 2574
      },
      "text": "ཇི་ལྟར་ ༼སྣར། པེ།༽ འདི་ལྟར་"
    },
    {
      "span": {
        "start": 2587,
        "end": 2593
      },
      "text": "ཡིན་ལ། ༼སྣར། པེ།༽ ཡིན་པ།"
    },
    {
      "span": {
        "start": 2663,
        "end": 2666
      },
      "text": "ལྟ། ༼སྣར། པེ།༽ བལྟ།"
    },
    {
      "span": {
        "start": 2692,
        "end": 2704
      },
      "text": "བདེ་ཆེན་གྱི། ༼སྣར། པེ།༽ བདེ་ཆེན་གྱིས།"
    },
    {
      "span": {
        "start": 3011,
        "end": 3014
      },
      "text": "བྱ། ༼སྣར། པེ།༽ བྱེད།"
    },
    {
      "span": {
        "start": 3089,
        "end": 3094
      },
      "text": "བརྟན་ ༼སྣར། པེ།༽ ལྡན་"
    },
    {
      "span": {
        "start": 3264,
        "end": 3272
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 3329,
        "end": 3337
      },
      "text": "དབང་གིས་ ༼སྣར། པེ།༽ དབང་པོ་"
    },
    {
      "span": {
        "start": 3365,
        "end": 3370
      },
      "text": "སྒོམ། ༼སྣར། པེ།༽ བསྒོམས།"
    },
    {
      "span": {
        "start": 3515,
        "end": 3524
      },
      "text": "བརྟེན་པས་ ༼སྣར། པེ།༽ རྟེན་པས་"
    },
    {
      "span": {
        "start": 3665,
        "end": 3674
      },
      "text": "བརྟེན་པས་ ༼སྣར། པེ།༽ རྟེན་པས་"
    },
    {
      "span": {
        "start": 3846,
        "end": 3856
      },
      "text": "དེའི་ཕྱིར་ ༼སྣར། པེ།༽ དེ་ཕྱིར་"
    },
    {
      "span": {
        "start": 3880,
        "end": 3888
      },
      "text": "སྟེན་པར་ ༼སྣར། པེ།༽ རྟེན་པར་"
    },
    {
      "span": {
        "start": 3888,
        "end": 3895
      },
      "text": "བྱེད་པ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 3945,
        "end": 3953
      },
      "text": "ཀུན་གྱི་ ༼སྣར། པེ།༽ ཀུན་ནི་"
    },
    {
      "span": {
        "start": 4254,
        "end": 4261
      },
      "text": "ཉིད་ནི་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 4351,
        "end": 4354
      },
      "text": "ནི་ ༼སྣར། པེ།༽ འདི་"
    }
  ]
}