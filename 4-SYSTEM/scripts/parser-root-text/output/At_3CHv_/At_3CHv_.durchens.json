{
  "durchens": [
    {
      "span": {
        "start": 180,
        "end": 188
      },
      "text": "ཀུན་གྱི་ ༼སྣར།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 338,
        "end": 342
      },
      "text": "མེད་ ༼སྣར། པེ།༽ ཕྱེད་"
    },
    {
      "span": {
        "start": 434,
        "end": 441
      },
      "text": "བསྒོམས། ༼སྣར། པེ།༽ བསྒོམ།"
    },
    {
      "span": {
        "start": 656,
        "end": 665
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 754,
        "end": 763
      },
      "text": "འདྲའི་ངོ་ ༼སྣར། པེ།༽ འདྲའི་དྷོ་"
    },
    {
      "span": {
        "start": 993,
        "end": 1174
      },
      "text": "། །ནོར་བུ་ཡིས་ནི་ཤིན་ཏུ་མཛེས། །དབུ་ལ་ཐོད་པ་ལྔས་བསྐོར་ཞིང་། །རློན་པ་བརྒྱ་ཕྱེད་ཕྲེང་བར་ལྡན། །རིན་ཆེན་ཀླུ་དང་རུས་པས་སྤྲས། །ཤིན་ཏུ་ཞི་ཞིང་སྒེག་པ་སྟེ། །སྟག་ལྤགས་བསྣམས་ནས་མེ་དཔུང་དཀྱིལ། ། ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 1569,
        "end": 1577
      },
      "text": "གསུང་གི་ ༼སྣར། པེ།༽ གསུང་ནི་"
    },
    {
      "span": {
        "start": 1659,
        "end": 1664
      },
      "text": "ཁྱོད་ ༼སྣར། པེ།༽ ཁྱེད་"
    },
    {
      "span": {
        "start": 2041,
        "end": 2047
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    }
  ]
}