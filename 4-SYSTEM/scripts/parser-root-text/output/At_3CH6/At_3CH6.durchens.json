{
  "durchens": [
    {
      "span": {
        "start": 336,
        "end": 343
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 433,
        "end": 444
      },
      "text": "ལྡོག་པ་ཡིས། ༼སྣར། པེ།༽ ལྡོག་པ་ཡི།"
    },
    {
      "span": {
        "start": 522,
        "end": 535
      },
      "text": "རྗེས་དྲན་གྱི། ༼སྣར། པེ།༽ རྗེས་དྲན་གྱིས།"
    },
    {
      "span": {
        "start": 573,
        "end": 581
      },
      "text": "འཇིགས་པ་ ༼སྣར། པེ།༽ འཇིག་པ་"
    },
    {
      "span": {
        "start": 677,
        "end": 687
      },
      "text": "སེམས་དཔའི་ ༼སྣར། པེ།༽ སེམས་པའི་"
    },
    {
      "span": {
        "start": 697,
        "end": 702
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 736,
        "end": 746
      },
      "text": "སེམས་དཔའི་ ༼སྣར། པེ།༽ སེམས་པའི་"
    },
    {
      "span": {
        "start": 763,
        "end": 768
      },
      "text": "སྤྱད། ༼སྣར། པེ།༽ སྤྱོད།"
    },
    {
      "span": {
        "start": 868,
        "end": 873
      },
      "text": "གཙུབ་ ༼སྣར། པེ།༽ གཙུབས་"
    },
    {
      "span": {
        "start": 891,
        "end": 895
      },
      "text": "ལྡན་ ༼སྣར། པེ།༽ རླན་"
    },
    {
      "span": {
        "start": 917,
        "end": 923
      },
      "text": "རྒྱུན་ ༼སྣར།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 934,
        "end": 940
      },
      "text": "བསྒོམ། ༼པེ།༽ སྒོམ།"
    }
  ]
}