{
  "durchens": [
    {
      "span": {
        "start": 859,
        "end": 862
      },
      "text": "དང་ ༼སྣར། པེ།༽ ཏང་"
    },
    {
      "span": {
        "start": 1058,
        "end": 1061
      },
      "text": "ཀུ་ ༼སྣར།༽ གུ་"
    },
    {
      "span": {
        "start": 1169,
        "end": 1174
      },
      "text": "བྱེད་ ༼སྣར།༽ བབ་སོན་ེད་ ༼པེ།༽ བས་བོན་ེད་"
    },
    {
      "span": {
        "start": 1390,
        "end": 1397
      },
      "text": "བརྡུངས་ ༼སྣར།༽ གཟུངས་ ༼པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 2056,
        "end": 2064
      },
      "text": "ཡུངས་ཀར་ ༼སྣར།༽ ཡུངས་དཀར་"
    },
    {
      "span": {
        "start": 3382,
        "end": 3392
      },
      "text": "བསྒྲོད་པར་ ༼སྣར། པེ།༽ སྒྲོད་པར་"
    },
    {
      "span": {
        "start": 3459,
        "end": 3464
      },
      "text": "བཟུང་ ༼པེ།༽ ཟུང་"
    },
    {
      "span": {
        "start": 4091,
        "end": 4097
      },
      "text": "བྱུགས་ ༼སྣར།༽ བྱུག་"
    },
    {
      "span": {
        "start": 4313,
        "end": 4320
      },
      "text": "ཕྲོམ་པ་ ༼སྣར། པེ།༽ ཁྲོམ་པ་"
    },
    {
      "span": {
        "start": 4622,
        "end": 4624
      },
      "text": "ང་ ༼སྣར། པེ།༽ ཤྭེ་"
    },
    {
      "span": {
        "start": 4709,
        "end": 4713
      },
      "text": "སོང་ ༼པེ།༽ སོང་དུ་"
    },
    {
      "span": {
        "start": 5282,
        "end": 5284
      },
      "text": "ཏ་ ༼པེ།༽ ཎ་"
    },
    {
      "span": {
        "start": 5329,
        "end": 5338
      },
      "text": "ལ་བཏགས་ན་ ༼སྣར། པེ།༽ ལ་བཏགས་ནས་"
    },
    {
      "span": {
        "start": 5760,
        "end": 5769
      },
      "text": "བསྐོལ་བར་ ༼སྣར། པེ།༽ བཀོལ་བར་"
    },
    {
      "span": {
        "start": 6135,
        "end": 6142
      },
      "text": "བཙན་མོ་ ༼སྣར། པེ།༽ བཙུན་མོ་"
    },
    {
      "span": {
        "start": 6730,
        "end": 6738
      },
      "text": "བྱུགས་པ་ ༼པེ།༽ བྱུག་པ་"
    },
    {
      "span": {
        "start": 6929,
        "end": 6933
      },
      "text": "པའི་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 7452,
        "end": 7457
      },
      "text": "བཟུང་ ༼པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 7561,
        "end": 7569
      },
      "text": "བསྟན་ནོ། ༼པེ།༽ བསྟན་ཏོ།"
    },
    {
      "span": {
        "start": 7700,
        "end": 7705
      },
      "text": "འདིས་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 7723,
        "end": 7728
      },
      "text": "བ་བླ་ ༼སྣར། པེ།༽ བབ་ལ་"
    },
    {
      "span": {
        "start": 8063,
        "end": 8068
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 8163,
        "end": 8168
      },
      "text": "དེའི་ ༼པེ།༽ དེ་དེའི་"
    },
    {
      "span": {
        "start": 8319,
        "end": 8321
      },
      "text": "པ་ ༼པེ།༽ པེ་"
    },
    {
      "span": {
        "start": 8635,
        "end": 8640
      },
      "text": "སྤྱད་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 8774,
        "end": 8785
      },
      "text": "རྒྱ་སྐྱེགས་ ༼སྣར། པེ།༽ རྒྱ་མ་ཚ་"
    },
    {
      "span": {
        "start": 9079,
        "end": 9083
      },
      "text": "ཛིར་ ༼སྣར། པེ།༽ ཛ་"
    },
    {
      "span": {
        "start": 9088,
        "end": 9091
      },
      "text": "སུ་ ༼པེ།༽ སཱུ་"
    },
    {
      "span": {
        "start": 9095,
        "end": 9097
      },
      "text": "ཧ་ ༼པེ།༽ ཏ་"
    },
    {
      "span": {
        "start": 9319,
        "end": 9321
      },
      "text": "ར་ ༼སྣར། པེ།༽ རེ་"
    },
    {
      "span": {
        "start": 9453,
        "end": 9459
      },
      "text": "བརྔྷི་ ༼པེ།༽ བརྡྷྀ་"
    },
    {
      "span": {
        "start": 9573,
        "end": 9576
      },
      "text": "ལྒ་ ༼སྣར།༽ ལྒང་"
    },
    {
      "span": {
        "start": 9908,
        "end": 9914
      },
      "text": "འབུགས་ ༼སྣར། པེ།༽ དབུགས་"
    },
    {
      "span": {
        "start": 10238,
        "end": 10248
      },
      "text": "འཕྲོགས་པར་ ༼སྣར། པེ།༽ འཕྲོག་པར་"
    },
    {
      "span": {
        "start": 10371,
        "end": 10375
      },
      "text": "ཏ་ཡ། ༼པེ།༽ ཏ་ཡེ་"
    },
    {
      "span": {
        "start": 10394,
        "end": 10398
      },
      "text": "གྲི་ ༼པེ།༽ གྲྀ་"
    },
    {
      "span": {
        "start": 10406,
        "end": 10410
      },
      "text": "གྲི་ ༼པེ།༽ ཧྲྀ་"
    },
    {
      "span": {
        "start": 10836,
        "end": 10841
      },
      "text": "དང་མ་ ༼པེ།༽ དང་མར་"
    },
    {
      "span": {
        "start": 10855,
        "end": 10859
      },
      "text": "པ་མ། ༼པེ།༽ པ་ཡ།"
    },
    {
      "span": {
        "start": 11224,
        "end": 11231
      },
      "text": "དགྲ་ཨི་ ༼སྣར།༽ དྲ་ཨ་མི་ ༼པེ།༽ དྲོ་ཨསི་"
    },
    {
      "span": {
        "start": 11450,
        "end": 11456
      },
      "text": "བཏུངས་ ༼པེ།༽ བཏུང་"
    },
    {
      "span": {
        "start": 11522,
        "end": 11525
      },
      "text": "ལུ་ ༼སྣར། པེ།༽ ལི་"
    },
    {
      "span": {
        "start": 11822,
        "end": 11833
      },
      "text": "བྱུག་པ་བྱས་ ༼སྣར། པེ།༽ བྱུགས་པར་བྱིན་"
    },
    {
      "span": {
        "start": 12218,
        "end": 12220
      },
      "text": "བ་ ༼སྣར། པེ།༽ བི་"
    },
    {
      "span": {
        "start": 12242,
        "end": 12246
      },
      "text": "དང་། ༼སྣར།༽ ཡཏེ ༼པེ།༽ ཡེཏ།"
    },
    {
      "span": {
        "start": 12773,
        "end": 12785
      },
      "text": "། །མཁའ་འགྲོ་ ༼སྣར།༽ ། །འགྲོས་ ༼པེ།༽ ། །མཁའ་འགྲོ་མ་"
    },
    {
      "span": {
        "start": 13314,
        "end": 13317
      },
      "text": "ཏང་ ༼སྣར། པེ།༽ དྲ་"
    },
    {
      "span": {
        "start": 13850,
        "end": 13852
      },
      "text": "མ་ ༼པེ།༽ སཱུ་རྱ་"
    },
    {
      "span": {
        "start": 14163,
        "end": 14169
      },
      "text": "མ་གྲག་ ༼སྣར། པེ།༽ མི་སྒྲག་"
    },
    {
      "span": {
        "start": 14337,
        "end": 14343
      },
      "text": "བསྐོལ་ ༼སྣར། པེ།༽ བཀོལ་"
    },
    {
      "span": {
        "start": 14508,
        "end": 14516
      },
      "text": "རྩ་བ་སོ་ ༼སྣར།༽ རྩ་བ་ས་"
    },
    {
      "span": {
        "start": 14531,
        "end": 14535
      },
      "text": "ཐོས་ ༼སྣར། པེ།༽ ཟོས་"
    },
    {
      "span": {
        "start": 15508,
        "end": 15514
      },
      "text": "ཁུ་བར་ ༼སྣར། པེ།༽ ཁུ་བ་དང་"
    },
    {
      "span": {
        "start": 15530,
        "end": 15534
      },
      "text": "བྱས་ ༼སྣར།༽ བྱེས་"
    },
    {
      "span": {
        "start": 15746,
        "end": 15752
      },
      "text": "མར་སར་ ༼སྣར། པེ།༽ མར་གསར་"
    },
    {
      "span": {
        "start": 16031,
        "end": 16033
      },
      "text": "ས་ ༼པེ།༽ སོཾ་"
    },
    {
      "span": {
        "start": 16309,
        "end": 16316
      },
      "text": "ཐིགས་པ་ ༼སྣར། པེ།༽ ཐིག་པ་"
    },
    {
      "span": {
        "start": 16428,
        "end": 16433
      },
      "text": "གཏོར་ ༼སྣར། པེ།༽ གཏོར་བར་"
    },
    {
      "span": {
        "start": 17333,
        "end": 17338
      },
      "text": "བྱིན་ ༼པེ།༽ ཕྱིན་"
    },
    {
      "span": {
        "start": 17506,
        "end": 17512
      },
      "text": "བྱུགས་ ༼པེ།༽ བྱུག་"
    },
    {
      "span": {
        "start": 18133,
        "end": 18139
      },
      "text": "ན་སའི་ ༼པེ།༽ ན་སོའི་"
    },
    {
      "span": {
        "start": 18254,
        "end": 18258
      },
      "text": "ཐའི་ ༼སྣར།༽ ཐཱའི་ ༼པེ།༽ ཋཱའི་"
    },
    {
      "span": {
        "start": 18689,
        "end": 18692
      },
      "text": "དག་ ༼སྣར། པེ།༽ ཐག་"
    },
    {
      "span": {
        "start": 18851,
        "end": 18856
      },
      "text": "རྩེས་ ༼པེ།༽ ཝརྞསེ་"
    },
    {
      "span": {
        "start": 18877,
        "end": 18881
      },
      "text": "བྲི་ ༼པེ།༽ བྲྀ་"
    },
    {
      "span": {
        "start": 18954,
        "end": 18958
      },
      "text": "འབམ་ ༼སྣར།༽ བམ་ ༼པེ།༽ བཾ་"
    },
    {
      "span": {
        "start": 18992,
        "end": 18997
      },
      "text": "ཏྲའི་ ༼པེ།༽ ཧྭའི་"
    },
    {
      "span": {
        "start": 19225,
        "end": 19234
      },
      "text": "དག་བྱུགས་ ༼སྣར།༽ ཐག་བྱུགས་ ༼པེ།༽ ཐག་བྱུང་"
    },
    {
      "span": {
        "start": 19479,
        "end": 19482
      },
      "text": "བྲ་ ༼སྣར། པེ།༽ པཱ་"
    },
    {
      "span": {
        "start": 19960,
        "end": 19963
      },
      "text": "ཛི་ ༼པེ།༽ ཛཾ་"
    },
    {
      "span": {
        "start": 20108,
        "end": 20114
      },
      "text": "རིལ་མ་ ༼སྣར། པེ།༽ རིལ་མར་"
    },
    {
      "span": {
        "start": 20298,
        "end": 20305
      },
      "text": "ཐུབ་པོ་ ༼པེ།༽ ཐུགས་པོ་"
    },
    {
      "span": {
        "start": 20345,
        "end": 20349
      },
      "text": "ཏིལ་ ༼སྣར།༽ ཏིག་"
    },
    {
      "span": {
        "start": 20528,
        "end": 20531
      },
      "text": "ནས། ༼སྣར། པེ།༽ ནས། ཏིལ་གྱིས་"
    },
    {
      "span": {
        "start": 20544,
        "end": 20552
      },
      "text": "སྨིན་པར་ ༼སྣར། པེ།༽ སྨིན་"
    },
    {
      "span": {
        "start": 20636,
        "end": 20641
      },
      "text": "འབྲས་ ༼པེ།༽ འཕྲས་"
    },
    {
      "span": {
        "start": 20732,
        "end": 20744
      },
      "text": "སྐྱིགས་བུའི་ ༼སྣར། པེ།༽ སྐྱེས་བུའི་"
    },
    {
      "span": {
        "start": 21074,
        "end": 21077
      },
      "text": "ཀུ་ ༼སྣར།༽ གུ་"
    },
    {
      "span": {
        "start": 21222,
        "end": 21228
      },
      "text": "ཟོས་ན་ ༼སྣར། པེ།༽ ཟོས་ནས་"
    },
    {
      "span": {
        "start": 21512,
        "end": 21517
      },
      "text": "རྣམས་ ༼སྣར།༽ རྣམ་"
    },
    {
      "span": {
        "start": 21569,
        "end": 21579
      },
      "text": "བཅུག་ཅིང་། ༼སྣར།༽ བཅུག་ཙིབ།"
    },
    {
      "span": {
        "start": 21586,
        "end": 21594
      },
      "text": "བྱུགས་པ་ ༼སྣར། པེ།༽ བྱུགས་"
    },
    {
      "span": {
        "start": 21600,
        "end": 21608
      },
      "text": "གཡུལ་ལས་ ༼སྣར། པེ།༽ གཡུལ་དུ་"
    },
    {
      "span": {
        "start": 21681,
        "end": 21689
      },
      "text": "གཡུལ་ལས་ ༼སྣར།༽ གཡུལ་ ༼པེ།༽ གཡུལ་དུ་"
    },
    {
      "span": {
        "start": 22107,
        "end": 22109
      },
      "text": "པ་ ༼སྣར།༽ ཕ་"
    }
  ]
}