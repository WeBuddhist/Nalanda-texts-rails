{
  "durchens": [
    {
      "span": {
        "start": 25,
        "end": 27
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 41,
        "end": 46
      },
      "text": "ནཱ་མ། ༼སྣར། པེ།༽ ནཱ་ནཱཾ།"
    },
    {
      "span": {
        "start": 229,
        "end": 235
      },
      "text": "སྒྲུབ་ ༼སྣར།༽ སྒྲུབས་"
    },
    {
      "span": {
        "start": 686,
        "end": 693
      },
      "text": "བསྒོམས་ ༼སྣར། པེ།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 876,
        "end": 882
      },
      "text": "བསྔགས་ ༼སྣར། པེ།༽ སྔགས་"
    },
    {
      "span": {
        "start": 990,
        "end": 996
      },
      "text": "བརྐྱང་ ༼སྣར། པེ།༽ བརྐྱང་བ་"
    },
    {
      "span": {
        "start": 1038,
        "end": 1047
      },
      "text": "བསྲུང་བར་ ༼སྣར། པེ།༽ སྲུང་བར་"
    },
    {
      "span": {
        "start": 1233,
        "end": 1236
      },
      "text": "ཁབ་ ༼ཅོ།༽ ཁྱབ་"
    },
    {
      "span": {
        "start": 1466,
        "end": 1477
      },
      "text": "ཐལ་མོ་གྱིས་ ༼སྣར། པེ།༽ ཐལ་མོ་དགྱིས་"
    },
    {
      "span": {
        "start": 1541,
        "end": 1551
      },
      "text": "བསྒོམས་ཏེ་ ༼སྣར། པེ།༽ བསྒོམ་སྟེ་"
    },
    {
      "span": {
        "start": 1599,
        "end": 1607
      },
      "text": "མཐེ་བོང་ ༼སྣར། པེ།༽ མཐེ་བོང་དང་"
    },
    {
      "span": {
        "start": 1679,
        "end": 1685
      },
      "text": "དྲིའོ། ༼སྣར། པེ།༽ དྲིའིའོ།"
    },
    {
      "span": {
        "start": 1732,
        "end": 1741
      },
      "text": "བདུག་པའི་ ༼སྣར། པེ།༽ འདུག་པའི་"
    },
    {
      "span": {
        "start": 1798,
        "end": 1806
      },
      "text": "མར་མེའོ། ༼སྣར། པེ།༽ མར་མེའིའོ།"
    },
    {
      "span": {
        "start": 1946,
        "end": 1950
      },
      "text": "བཞག་ ༼སྡེ།༽ གཞག་"
    },
    {
      "span": {
        "start": 2126,
        "end": 2138
      },
      "text": "སཏྭ་པ་རེ་ཏྲ་ ༼སྣར། པེ།༽ སཏྭ་བ་རི་ཏྲཱ་"
    },
    {
      "span": {
        "start": 2186,
        "end": 2195
      },
      "text": "ཧོ་ཧོ་ཧོ་ ༼ཅོ།༽ ཧོ་ཧོ་"
    },
    {
      "span": {
        "start": 2401,
        "end": 2408
      },
      "text": "རྟག་ཏུ་ ༼ཅོ།༽ རྟག་"
    },
    {
      "span": {
        "start": 2470,
        "end": 2477
      },
      "text": "བསྐྱོད་ ༼སྣར། པེ།༽ བསྐྱོད་པ་"
    },
    {
      "span": {
        "start": 2495,
        "end": 2502
      },
      "text": "མཐའ་ཡས་ ༼སྣར། པེ།༽ མཐའ་"
    },
    {
      "span": {
        "start": 2706,
        "end": 2717
      },
      "text": "མགོན་པོ་ཡི། ༼སྣར། པེ།༽ མགོན་པོ་ཡིས།"
    },
    {
      "span": {
        "start": 2796,
        "end": 2803
      },
      "text": "སྡུད་པ་ ༼སྣར། པེ།༽ བསྡུ་བ་"
    },
    {
      "span": {
        "start": 2821,
        "end": 2826
      },
      "text": "བྱེད་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 3452,
        "end": 3458
      },
      "text": "གཟུང་། ༼སྣར། པེ།༽ བཟུང་།"
    },
    {
      "span": {
        "start": 3561,
        "end": 3569
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 3689,
        "end": 3694
      },
      "text": "དགོད། ༼སྣར། པེ།༽ མགོད།"
    },
    {
      "span": {
        "start": 3751,
        "end": 3757
      },
      "text": "བསྒོམ་ ༼སྣར། པེ།༽ བསྒོམས་"
    },
    {
      "span": {
        "start": 3791,
        "end": 3799
      },
      "text": "སྟོང་པར་ ༼སྣར། པེ།༽ སྟོངས་པར་"
    },
    {
      "span": {
        "start": 4020,
        "end": 4029
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་དཔས་"
    },
    {
      "span": {
        "start": 4123,
        "end": 4130
      },
      "text": "འཚལ་ལོ། ༼སྣར། པེ།༽ འཚལ།"
    },
    {
      "span": {
        "start": 4167,
        "end": 4172
      },
      "text": "ཕྱུང་ ༼སྣར། པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 4649,
        "end": 4655
      },
      "text": "བཞུགས་ ༼སྣར། པེ།༽ ཞུགས་"
    },
    {
      "span": {
        "start": 4685,
        "end": 4694
      },
      "text": "ཝརྟ་ན་མོ་ ༼སྣར། པེ།༽ ཝརྟ་མ་"
    },
    {
      "span": {
        "start": 4696,
        "end": 4699
      },
      "text": "ཧོ་ ༼སྣར། པེ།༽ ཧཾ་"
    },
    {
      "span": {
        "start": 4943,
        "end": 4952
      },
      "text": "གྱི་རྒྱན་ ༼སྣར། པེ།༽ གྱིས་བརྒྱན་"
    },
    {
      "span": {
        "start": 5189,
        "end": 5191
      },
      "text": "ན་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 5446,
        "end": 5451
      },
      "text": "ཡོ་ཨ་ ༼སྣར། པེ།༽ ཡོ་"
    },
    {
      "span": {
        "start": 5907,
        "end": 5916
      },
      "text": "གཉིས་པའི་ ༼སྣར། པེ།༽ གཉིས་ཀའི་"
    },
    {
      "span": {
        "start": 6227,
        "end": 6234
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 6286,
        "end": 6296
      },
      "text": "འབྱུང་ལྡན་ ༼སྣར། པེ།༽ འབྱུང་གནས་"
    },
    {
      "span": {
        "start": 6364,
        "end": 6383
      },
      "text": "སེར་པོ་དང་། དམར་པོ་ ༼སྣར། པེ།༽ སེར་པོ་"
    },
    {
      "span": {
        "start": 6383,
        "end": 6387
      },
      "text": "དང་། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 6507,
        "end": 6521
      },
      "text": "བཞུགས་པ་རིམ་པ་ ༼སྣར། པེ།༽ བཞུགས་པ་"
    },
    {
      "span": {
        "start": 6527,
        "end": 6529
      },
      "text": "བ་ ༼སྣར། པེ།༽ བུ་"
    },
    {
      "span": {
        "start": 6773,
        "end": 6775
      },
      "text": "པ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 6785,
        "end": 6805
      },
      "text": "འཕྲོས་པར་བསྐྱོད་པའི་ ༼སྣར། པེ།༽ འཕྲོས་པས་གསང་བའི་"
    },
    {
      "span": {
        "start": 6871,
        "end": 6876
      },
      "text": "དམ་པ་ ༼སྣར། པེ།༽ དམ་པའི་"
    },
    {
      "span": {
        "start": 7244,
        "end": 7253
      },
      "text": "བརྡབས་པས་ ༼སྣར། པེ།༽ བརྡབས་"
    },
    {
      "span": {
        "start": 7484,
        "end": 7492
      },
      "text": "གིས་མཚན་ ༼སྣར། པེ།༽ གི་རྣམ་"
    },
    {
      "span": {
        "start": 7689,
        "end": 7698
      },
      "text": "འབྱུང་བར་ ༼སྣར། པེ།༽ བྱུང་བར་"
    },
    {
      "span": {
        "start": 7737,
        "end": 7742
      },
      "text": "ཕྱུང་ ༼སྣར། པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 7781,
        "end": 7789
      },
      "text": "འོངས་ཏེ། ༼སྣར། པེ།༽ འོང་སྟེ།"
    },
    {
      "span": {
        "start": 7914,
        "end": 7919
      },
      "text": "གཏུམ་ ༼སྣར། པེ།༽ གསུམ་"
    },
    {
      "span": {
        "start": 7944,
        "end": 7953
      },
      "text": "དབུགས་ལས་ ༼སྣར། པེ།༽ དབུགས་"
    },
    {
      "span": {
        "start": 8115,
        "end": 8123
      },
      "text": "ནག་པོའི་ ༼སྣར། པེ།༽ ནག་པོའི་དང་"
    },
    {
      "span": {
        "start": 8370,
        "end": 8381
      },
      "text": "སྟག་མོ་ལའོ། ༼སྣར། པེ།༽ སྟག་མོ་མའོ།"
    },
    {
      "span": {
        "start": 8778,
        "end": 8784
      },
      "text": "འཕྲོག་ ༼སྣར། པེ།༽ ཕྲོག་"
    },
    {
      "span": {
        "start": 9539,
        "end": 9565
      },
      "text": "བཅིངས་ནས་མཐེ་བོང་དང་དབུ་མ་ ༼སྣར། པེ།༽ བཅིངས་ནས་"
    },
    {
      "span": {
        "start": 9765,
        "end": 9776
      },
      "text": "བརྐྱང་བ་ནི་ ༼ཅོ།༽ བརྐྱང་བ་"
    },
    {
      "span": {
        "start": 9781,
        "end": 9793
      },
      "text": "མོའི་རྩ་བའི་ ༼སྣར། པེ།༽ མོའི་"
    },
    {
      "span": {
        "start": 9865,
        "end": 9868
      },
      "text": "རི་ ༼སྣར། པེ།༽ རྀ་"
    },
    {
      "span": {
        "start": 10013,
        "end": 10021
      },
      "text": "བརྐྱང་བ་ ༼སྣར། པེ།༽ བརྐྱང་བ་ནི་"
    },
    {
      "span": {
        "start": 10255,
        "end": 10263
      },
      "text": "བརྗོད་པ་ ༼སྣར། པེ།༽ རྒོད་པ་"
    },
    {
      "span": {
        "start": 10502,
        "end": 10510
      },
      "text": "རྒྱས་པས་ ༼སྣར། པེ།༽ རྒྱས་པར་"
    },
    {
      "span": {
        "start": 10739,
        "end": 10744
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 10774,
        "end": 10780
      },
      "text": "མཐེའུ་ ༼སྣར། པེ།༽ མཐེ་"
    },
    {
      "span": {
        "start": 10927,
        "end": 10929
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནཱ་"
    },
    {
      "span": {
        "start": 11045,
        "end": 11050
      },
      "text": "གསིལ་ ༼སྣར། པེ།༽ བསིལ་"
    },
    {
      "span": {
        "start": 11335,
        "end": 11341
      },
      "text": "འགྱིང་ ༼སྣར། པེ།༽ བགྱིང་"
    },
    {
      "span": {
        "start": 11817,
        "end": 11823
      },
      "text": "ངོ་བོ་ ༼སྣར། པེ།༽ ངོ་བོར་"
    },
    {
      "span": {
        "start": 12378,
        "end": 12381
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 12493,
        "end": 12500
      },
      "text": "འཕྱར་བ་ ༼སྣར། པེ།༽ ཕྱར་བ་"
    },
    {
      "span": {
        "start": 12654,
        "end": 12660
      },
      "text": "རྣམ་པ་ ༼སྣར། པེ།༽ རྣམ་པར་"
    },
    {
      "span": {
        "start": 12705,
        "end": 12719
      },
      "text": "བསྐོར་བར་བསམས་ ༼སྣར། པེ།༽ བསྐོར་བ་བསམ་"
    },
    {
      "span": {
        "start": 12819,
        "end": 12821
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 13066,
        "end": 13070
      },
      "text": "སྟི་ ༼སྣར། པེ།༽ ཧི་"
    },
    {
      "span": {
        "start": 13338,
        "end": 13344
      },
      "text": "དག་གི་ ༼སྣར། པེ།༽ དག་གིས་"
    },
    {
      "span": {
        "start": 13605,
        "end": 13617
      },
      "text": "ཞེས་རྡོ་རྗེ་ ༼སྣར། པེ།༽ ཞེས་"
    },
    {
      "span": {
        "start": 13822,
        "end": 13826
      },
      "text": "རྩེ་ ༼སྣར། པེ།༽ རྩེགས་"
    },
    {
      "span": {
        "start": 14009,
        "end": 14019
      },
      "text": "གཉིས་ཀྱིས་ ༼སྣར། པེ།༽ གཉིས་ནི་"
    },
    {
      "span": {
        "start": 14501,
        "end": 14519
      },
      "text": "ཁྲོ་བ་དང་། སྒེག་པ་ ༼སྣར།༽ ཁྲོ་བ་"
    },
    {
      "span": {
        "start": 14519,
        "end": 14523
      },
      "text": "དང་། ༼སྣར།༽ །"
    },
    {
      "span": {
        "start": 14762,
        "end": 14769
      },
      "text": "བསྒྲེང་ ༼སྣར། པེ།༽ བསྒྲེངས་"
    },
    {
      "span": {
        "start": 14958,
        "end": 14963
      },
      "text": "ཁྱིམ་ ༼སྣར། པེ།༽ ཁྲིམ་"
    },
    {
      "span": {
        "start": 15052,
        "end": 15061
      },
      "text": "ལྷ་སྦྱིན་ ༼སྣར། པེ།༽ ལྷས་བྱིན་"
    },
    {
      "span": {
        "start": 15088,
        "end": 15094
      },
      "text": "གཙིགས་ ༼སྣར། པེ།༽ ཙིགས་"
    },
    {
      "span": {
        "start": 15114,
        "end": 15120
      },
      "text": "རྒ་ལས་ ༼སྣར། པེ།༽ དགའ་བ་"
    },
    {
      "span": {
        "start": 15146,
        "end": 15153
      },
      "text": "བྱེད་མ་ ༼སྣར། པེ།༽ བྱད་མ་"
    },
    {
      "span": {
        "start": 15185,
        "end": 15191
      },
      "text": "ཨུ་མས་ ༼སྣར། པེ།༽ དབུ་མས་"
    },
    {
      "span": {
        "start": 15377,
        "end": 15383
      },
      "text": "འཇིགས་ ༼སྣར། པེ།༽ འཇིབ་"
    },
    {
      "span": {
        "start": 15494,
        "end": 15504
      },
      "text": "སྦྲུལ་ཆེན་ ༼སྣར། པེ།༽ སྦྲུལ་གྱི་"
    },
    {
      "span": {
        "start": 15786,
        "end": 15794
      },
      "text": "བཀའ་ཡིས། ༼སྣར། པེ།༽ བཀའ་ཡི།"
    },
    {
      "span": {
        "start": 15815,
        "end": 15821
      },
      "text": "སྤྱོན་ ༼ཅོ།༽ སྤྱོད་"
    },
    {
      "span": {
        "start": 15985,
        "end": 15992
      },
      "text": "ལས་ཀྱི་ ༼སྣར། པེ།༽ ལས་ཀྱིས་"
    },
    {
      "span": {
        "start": 16183,
        "end": 16189
      },
      "text": "ཕྲུའི་ ༼སྣར། པེ།༽ ཁྲུའི་"
    },
    {
      "span": {
        "start": 16211,
        "end": 16221
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 16303,
        "end": 16309
      },
      "text": "བྷཱ་བ་ ༼སྣར། པེ།༽ བྷཱ་བ་བ་"
    },
    {
      "span": {
        "start": 16412,
        "end": 16419
      },
      "text": "ཆེན་པོ་ ༼སྣར། པེ།༽ ཆེན་པོའི་"
    },
    {
      "span": {
        "start": 16736,
        "end": 16748
      },
      "text": "ཡེ་ཤེས་ཀྱིས་ ༼སྣར། པེ།༽ ཡེ་ཤེས་ཀྱི་"
    },
    {
      "span": {
        "start": 16760,
        "end": 16768
      },
      "text": "གཤེགས་པ་ ༼སྣར། པེ།༽ གཤེགས་"
    },
    {
      "span": {
        "start": 16773,
        "end": 16780
      },
      "text": "པོ་ཡིས། ༼སྣར། པེ།༽ པོ།"
    },
    {
      "span": {
        "start": 16916,
        "end": 16923
      },
      "text": "ཆེན་པོ་ ༼སྣར། པེ།༽ ཆེན་པོའི་"
    },
    {
      "span": {
        "start": 17347,
        "end": 17359
      },
      "text": "ཁུ་ཚུར་དྲིས་ ༼སྣར། པེ།༽ ཁུ་ཚུར་གྱིས་"
    },
    {
      "span": {
        "start": 17499,
        "end": 17507
      },
      "text": "སྐྱེས་པ་ ༼སྣར། པེ།༽ སྐྱེས་པའི་"
    },
    {
      "span": {
        "start": 17823,
        "end": 17829
      },
      "text": "རློག ། ༼སྣར། པེ།༽ རློགས། །"
    },
    {
      "span": {
        "start": 18201,
        "end": 18210
      },
      "text": "སེམས་ཀྱི་ ༼སྣར། པེ།༽ སེམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 18408,
        "end": 18419
      },
      "text": "འགྲོ་བ་ཡིས། ༼སྣར། པེ།༽ འགྲོ་བ་ཡི།"
    },
    {
      "span": {
        "start": 18455,
        "end": 18463
      },
      "text": "བསྒྲལ་བ་ ༼སྣར། པེ།༽ བརྒལ་བ་"
    },
    {
      "span": {
        "start": 18553,
        "end": 18560
      },
      "text": "གཙུག་ལ་ ༼སྣར། པེ།༽ གཙུག་ལག་"
    },
    {
      "span": {
        "start": 18833,
        "end": 18840
      },
      "text": "ཞེས་པས་ ༼སྣར། པེ།༽ ཞེས་པ་"
    },
    {
      "span": {
        "start": 19101,
        "end": 19106
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུངས་"
    },
    {
      "span": {
        "start": 19131,
        "end": 19135
      },
      "text": "བརླ་ ༼སྣར། པེ།༽ བླ་"
    },
    {
      "span": {
        "start": 19513,
        "end": 19515
      },
      "text": "ཁ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 19524,
        "end": 19532
      },
      "text": "བསྲུང་བ་ ༼སྣར། པེ།༽ དམ་ཚིག་བསྲུང་མ་"
    },
    {
      "span": {
        "start": 19866,
        "end": 19871
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ གཉིས་ཀྱི་"
    },
    {
      "span": {
        "start": 20183,
        "end": 20186
      },
      "text": "སྟ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 20444,
        "end": 20451
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 20664,
        "end": 20671
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 21194,
        "end": 21199
      },
      "text": "བསགས་ ༼སྣར། པེ།༽ བསྔགས་"
    },
    {
      "span": {
        "start": 21232,
        "end": 21239
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 21253,
        "end": 21260
      },
      "text": "མདུད་པ་ ༼སྣར། པེ།༽ འདུད་པ་"
    },
    {
      "span": {
        "start": 21348,
        "end": 21355
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 21493,
        "end": 21496
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 21790,
        "end": 21795
      },
      "text": "ཕྱུང་ ༼སྣར། པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 21845,
        "end": 21853
      },
      "text": "དབྱུག་པ་ ༼སྣར། པེ།༽ བྱུག་པ་"
    },
    {
      "span": {
        "start": 21866,
        "end": 21872
      },
      "text": "བསྣམས་ ༼སྣར། པེ།༽ བསྡཾས་"
    },
    {
      "span": {
        "start": 22002,
        "end": 22015
      },
      "text": "བསྐོར་བ་བྱ་བ་ ༼སྣར། པེ།༽ བསྐོར་བ་"
    },
    {
      "span": {
        "start": 22161,
        "end": 22166
      },
      "text": "བཅངས་ ༼སྣར། པེ།༽ བཅས་"
    },
    {
      "span": {
        "start": 22236,
        "end": 22242
      },
      "text": "རིམ་པ་ ༼སྣར། པེ།༽ རིམ་"
    },
    {
      "span": {
        "start": 22368,
        "end": 22378
      },
      "text": "མར་མེའིའོ། ༼སྣར། པེ།༽ མར་མེའོ།"
    },
    {
      "span": {
        "start": 22500,
        "end": 22508
      },
      "text": "མཛུབ་མོ་ ༼སྣར། པེ།༽ མཛུབ་མོ་མ་"
    },
    {
      "span": {
        "start": 22547,
        "end": 22552
      },
      "text": "བཅངས་ ༼སྣར། པེ།༽ བཅིངས་"
    },
    {
      "span": {
        "start": 22602,
        "end": 22619
      },
      "text": "བསྒྲེང་བ་ནི་བདུག་ ༼སྣར། པེ།༽ བསྒྲེང་བ་འདུག་"
    },
    {
      "span": {
        "start": 22785,
        "end": 22791
      },
      "text": "བྱས་ལ་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 23300,
        "end": 23305
      },
      "text": "བླངས་ ༼སྣར། པེ།༽ བླང་"
    },
    {
      "span": {
        "start": 23374,
        "end": 23383
      },
      "text": "སྒྲེང་བར་ ༼སྡེ།༽ སྦྲེང་བར་"
    },
    {
      "span": {
        "start": 23437,
        "end": 23444
      },
      "text": "པོ་དང་། ༼སྣར། པེ།༽ པོ་"
    },
    {
      "span": {
        "start": 23519,
        "end": 23522
      },
      "text": "རས་ ༼སྣར། པེ།༽ རབ་"
    },
    {
      "span": {
        "start": 23554,
        "end": 23563
      },
      "text": "ཟུང་གཅིག་ ༼སྣར། པེ།༽ ཟུང་ཞིག་"
    },
    {
      "span": {
        "start": 23617,
        "end": 23633
      },
      "text": "ཆོས་གོས་ཀྱི་ཕྱག་ ༼སྡེ།༽ ཆོས་གོས་ཀྱི་"
    },
    {
      "span": {
        "start": 23814,
        "end": 23823
      },
      "text": "བརྡབས་པས་ ༼སྣར། པེ།༽ བརྟབས་པས་"
    },
    {
      "span": {
        "start": 23825,
        "end": 23833
      },
      "text": "སྦྱང་བར་ ༼སྣར། པེ།༽ སྦྱར་བར་"
    },
    {
      "span": {
        "start": 23915,
        "end": 23917
      },
      "text": "ཨ། ༼སྣར། པེ།༽ ཨཿ།"
    },
    {
      "span": {
        "start": 23928,
        "end": 23938
      },
      "text": "བདུན་བདུན་ ༼སྣར། པེ།༽ བདུན་"
    },
    {
      "span": {
        "start": 24108,
        "end": 24116
      },
      "text": "གཞུག་པར་ ༼སྣར། པེ།༽ གཟུགས་པར་"
    },
    {
      "span": {
        "start": 24279,
        "end": 24286
      },
      "text": "རཾ་གྱི་ ༼སྣར། པེ།༽ རཾ་གྱིས་"
    },
    {
      "span": {
        "start": 24359,
        "end": 24366
      },
      "text": "གཉིས་ན་ ༼སྣར། པེ།༽ གཉིས་ནས་"
    },
    {
      "span": {
        "start": 24763,
        "end": 24770
      },
      "text": "རྩེ་མོ་ ༼སྣར། པེ།༽ རྩེ་མོར་"
    },
    {
      "span": {
        "start": 25020,
        "end": 25023
      },
      "text": "ཡེ་ ༼སྣར།༽ ཡཻ་"
    },
    {
      "span": {
        "start": 25113,
        "end": 25115
      },
      "text": "ཡ་ ༼སྣར། པེ།༽ ཡེ་"
    },
    {
      "span": {
        "start": 25127,
        "end": 25129
      },
      "text": "བ་ ༼སྣར། པེ།༽ བཱ་"
    },
    {
      "span": {
        "start": 25509,
        "end": 25512
      },
      "text": "ཡམ་ ༼སྣར། པེ།༽ ཡམས་"
    },
    {
      "span": {
        "start": 25601,
        "end": 25607
      },
      "text": "ཞོ་ཡང་ ༼སྣར། པེ།༽ ཞོ་"
    },
    {
      "span": {
        "start": 25685,
        "end": 25691
      },
      "text": "བར་བར་ ༼སྣར།༽ བར་"
    },
    {
      "span": {
        "start": 25704,
        "end": 25709
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ གསུམ་དུ་"
    },
    {
      "span": {
        "start": 25747,
        "end": 25752
      },
      "text": "དབུལ་ ༼སྣར། པེ།༽ འབུལ་"
    },
    {
      "span": {
        "start": 25838,
        "end": 25842
      },
      "text": "ཞེས་ ༼སྣར། པེ།༽ ཞེས་པས་"
    },
    {
      "span": {
        "start": 25917,
        "end": 25924
      },
      "text": "བསང་བར་ ༼སྣར། པེ།༽ བསམ་པར་"
    },
    {
      "span": {
        "start": 26188,
        "end": 26229
      },
      "text": "རིམ་པས་སྦྱིན་སྲེག་དང་། འབྲས་བུ་ལ་སོགས་པས་ ༼སྣར། པེ།༽ རིམ་པས་"
    },
    {
      "span": {
        "start": 26402,
        "end": 26409
      },
      "text": "སེམས་ལ་ ༼སྣར། པེ།༽ སེམས་པར་"
    },
    {
      "span": {
        "start": 26417,
        "end": 26428
      },
      "text": "དགོང་བླུགས་ ༼ཅོ། སྣར།༽ དགང་བླུགས་"
    },
    {
      "span": {
        "start": 26668,
        "end": 26675
      },
      "text": "རིམ་པར་ ༼སྣར། པེ།༽ རིག་པར་"
    },
    {
      "span": {
        "start": 26686,
        "end": 26691
      },
      "text": "ཁྱེད་ ༼སྣར། པེ།༽ ཁྱོད་"
    },
    {
      "span": {
        "start": 26744,
        "end": 26749
      },
      "text": "སྩོལ། ༼སྣར། པེ།༽ གསོལ།"
    },
    {
      "span": {
        "start": 26936,
        "end": 26945
      },
      "text": "གཏོར་མའི་ ༼སྣར། པེ།༽ གཏོར་མའི་ཚོགས་"
    },
    {
      "span": {
        "start": 27020,
        "end": 27027
      },
      "text": "གཏོར་མ་ ༼སྣར། པེ།༽ གཏོར་མས་"
    },
    {
      "span": {
        "start": 27295,
        "end": 27299
      },
      "text": "གོང་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 27526,
        "end": 27546
      },
      "text": "དབུགས་ཀྱིས་བཀུག་སྟེ། ༼སྣར། པེ།༽ དབུགས་ཀྱི་བཀུགས་ཏེ་"
    },
    {
      "span": {
        "start": 27559,
        "end": 27566
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 27759,
        "end": 27765
      },
      "text": "བྱས་ལ། ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 27907,
        "end": 27913
      },
      "text": "འདབ་མ་ ༼སྣར། པེ།༽ འདབ་མ་ལ་"
    },
    {
      "span": {
        "start": 28117,
        "end": 28124
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 28154,
        "end": 28161
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 28340,
        "end": 28348
      },
      "text": "དབྱེ་བར་ ༼སྣར། པེ།༽ དབྱེ་བས་"
    },
    {
      "span": {
        "start": 28486,
        "end": 28491
      },
      "text": "བརླབ་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 28955,
        "end": 28962
      },
      "text": "བཅིང་བ་ ༼སྣར། པེ།༽ བཅིངས་བ་"
    },
    {
      "span": {
        "start": 29056,
        "end": 29063
      },
      "text": "མཆོད་ལ་ ༼སྣར། པེ།༽ མཆོད་པ་"
    },
    {
      "span": {
        "start": 29103,
        "end": 29111
      },
      "text": "གཡོན་པས་ ༼སྣར། པེ།༽ གཡོན་པ་"
    },
    {
      "span": {
        "start": 29123,
        "end": 29127
      },
      "text": "གཡས་ ༼སྣར། པེ།༽ གཡས་པ་"
    },
    {
      "span": {
        "start": 29543,
        "end": 29549
      },
      "text": "ཞི་བར་ ༼སྣར། པེ།༽ ཞི་བ་"
    },
    {
      "span": {
        "start": 29834,
        "end": 29839
      },
      "text": "དགུག་ ༼སྣར། པེ།༽ དགུགས་"
    },
    {
      "span": {
        "start": 29887,
        "end": 29892
      },
      "text": "བགྲང་ ༼སྣར། པེ།༽ གྲང་"
    },
    {
      "span": {
        "start": 29984,
        "end": 29992
      },
      "text": "དབང་གིས་ ༼སྣར། པེ།༽ དབང་གི་"
    },
    {
      "span": {
        "start": 30075,
        "end": 30082
      },
      "text": "གནས་པར་ ༼སྣར། པེ།༽ གནག་པར་"
    },
    {
      "span": {
        "start": 30095,
        "end": 30111
      },
      "text": "ཡིད་ཀྱིས་དབང་དུ་ ༼སྣར། པེ།༽ ཡིད་ཀྱི་དབང་"
    },
    {
      "span": {
        "start": 30147,
        "end": 30155
      },
      "text": "ནག་པོའི་ ༼སྣར། པེ།༽ ནག་པོ་"
    },
    {
      "span": {
        "start": 30298,
        "end": 30306
      },
      "text": "སྤྱོད་པ་ ༼སྣར། པེ།༽ སྤྱོད་པར་"
    },
    {
      "span": {
        "start": 30495,
        "end": 30498
      },
      "text": "ཏི་ ༼སྣར། པེ།༽ ཏ་"
    }
  ]
}