{
  "durchens": [
    {
      "span": {
        "start": 24,
        "end": 28
      },
      "text": "ཀླག་ ༼སྣར། པེ།༽ བཀླག་"
    },
    {
      "span": {
        "start": 222,
        "end": 230
      },
      "text": "ཁམས་ཀྱི་ ༼སྣར།༽ ཁམས་"
    },
    {
      "span": {
        "start": 380,
        "end": 386
      },
      "text": "ཆོ་གས། ༼སྣར། པེ།༽ ཆོ་ག།"
    },
    {
      "span": {
        "start": 513,
        "end": 517
      },
      "text": "གཞག་ ༼སྣར།༽ བཞག་"
    },
    {
      "span": {
        "start": 714,
        "end": 721
      },
      "text": "ལས་ཀྱི་ ༼སྣར། པེ།༽ ལས་ཀྱིས་"
    },
    {
      "span": {
        "start": 743,
        "end": 754
      },
      "text": "བློ་ཞེན་ཏེ། ༼སྣར། པེ།༽ བློ་ཞན།"
    },
    {
      "span": {
        "start": 877,
        "end": 883
      },
      "text": "གྲག་པ་ ༼སྣར། པེ།༽ གྲགས་པ་"
    },
    {
      "span": {
        "start": 939,
        "end": 948
      },
      "text": "འདས་ཀྱིས་ ༼པེ།༽ འདས་ཀྱི་"
    },
    {
      "span": {
        "start": 1040,
        "end": 1047
      },
      "text": "ལས་ཀྱི་ ༼སྣར། པེ།༽ ལས་ཀྱིས་"
    },
    {
      "span": {
        "start": 1069,
        "end": 1080
      },
      "text": "བློ་ཞེན་ཏེ། ༼སྣར།༽ བློ་ཞན་ཏེ ༼པེ།༽ བློ་ཞན།"
    },
    {
      "span": {
        "start": 1140,
        "end": 1144
      },
      "text": "ཀླག་ ༼སྣར། པེ།༽ བཀླག་"
    },
    {
      "span": {
        "start": 1199,
        "end": 1205
      },
      "text": "གྲག་པ་ ༼སྣར། པེ།༽ གྲགས་པ་"
    },
    {
      "span": {
        "start": 1304,
        "end": 1308
      },
      "text": "ཀླག་ ༼སྣར། པེ།༽ བཀླག་"
    }
  ]
}