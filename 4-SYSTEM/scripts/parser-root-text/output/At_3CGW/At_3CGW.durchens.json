{
  "durchens": [
    {
      "span": {
        "start": 95,
        "end": 105
      },
      "text": "མཛད་པའོ། ། ༼པེ།༽ མཛད་པ་"
    },
    {
      "span": {
        "start": 144,
        "end": 148
      },
      "text": "ལགས་ ༼པེ།༽ ཀྱི་དོན་འཇུག་པ་བཞུགས་"
    },
    {
      "span": {
        "start": 624,
        "end": 635
      },
      "text": "སྐྱོབས་པའི་ ༼པེ།༽ སྐྱོབ་པའི་"
    },
    {
      "span": {
        "start": 851,
        "end": 855
      },
      "text": "པའི་ ༼པེ།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 1268,
        "end": 1273
      },
      "text": "དངོས་ ༼པེ།༽ དང་པོ་"
    },
    {
      "span": {
        "start": 1780,
        "end": 1784
      },
      "text": "གཞི་ ༼པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 1922,
        "end": 1927
      },
      "text": "བསྟན་ ༼པེ།༽ སྟན་"
    },
    {
      "span": {
        "start": 2437,
        "end": 2445
      },
      "text": "བདེ་ཉམས་ ༼པེ།༽ ཉོན་མོངས་"
    },
    {
      "span": {
        "start": 2465,
        "end": 2470
      },
      "text": "སྤྱད་ ༼པེ།༽ སྤྱོད་"
    },
    {
      "span": {
        "start": 2707,
        "end": 2715
      },
      "text": "སྟོན་ཏེ་ ༼པེ།༽ སྟོན་"
    },
    {
      "span": {
        "start": 3057,
        "end": 3062
      },
      "text": "རྒ་བ་ ༼པེ།༽ རྒ་བ་བཞི་"
    },
    {
      "span": {
        "start": 3223,
        "end": 3232
      },
      "text": "དམྱལ་བ་ལ་ ༼པེ།༽ དམྱལ་བ་"
    },
    {
      "span": {
        "start": 3279,
        "end": 3284
      },
      "text": "མཆོད་ ༼པེ།༽ ན་ཆོད་"
    },
    {
      "span": {
        "start": 3643,
        "end": 3648
      },
      "text": "བསྟན་ ༼པེ།༽ སྟན་"
    },
    {
      "span": {
        "start": 4156,
        "end": 4161
      },
      "text": "རིགས་ ༼པེ།༽ རིག་"
    },
    {
      "span": {
        "start": 4501,
        "end": 4506
      },
      "text": "རིམས་ ༼པེ།༽ རིམ་"
    },
    {
      "span": {
        "start": 4851,
        "end": 4859
      },
      "text": "བསྡུད་པ་ ༼པེ།༽ བསྡུས་པ་"
    },
    {
      "span": {
        "start": 5057,
        "end": 5066
      },
      "text": "གཟུང་བའི་ ༼པེ།༽ བཟུང་བའི་"
    },
    {
      "span": {
        "start": 5676,
        "end": 5686
      },
      "text": "རྣོན་པོའི་ ༼པེ།༽ རྣོན་པའི་"
    },
    {
      "span": {
        "start": 5934,
        "end": 5940
      },
      "text": "སྦྱོར་ ༼པེ།༽ སྦྱར་"
    }
  ]
}