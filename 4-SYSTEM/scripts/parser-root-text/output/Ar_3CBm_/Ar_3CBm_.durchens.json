{
  "durchens": [
    {
      "span": {
        "start": 195,
        "end": 202
      },
      "text": "ཁྱད་པར་ ༼སྣར། པེ།༽ ཁྱད་"
    },
    {
      "span": {
        "start": 756,
        "end": 761
      },
      "text": "གཅོད་ ༼སྣར། པེ།༽ སྤྱོད་"
    },
    {
      "span": {
        "start": 817,
        "end": 821
      },
      "text": "སའི་ ༼སྣར། པེ།༽ མའི་"
    },
    {
      "span": {
        "start": 835,
        "end": 840
      },
      "text": "སམྱཀ་ ༼སྣར། པེ།༽ སཾམྱཀ་"
    },
    {
      "span": {
        "start": 1161,
        "end": 1164
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 1262,
        "end": 1271
      },
      "text": "དོན་ཏོ། ། ༼སྣར། པེ།༽ དོན་།། །།"
    },
    {
      "span": {
        "start": 1472,
        "end": 1480
      },
      "text": "མི་ཤིགས་ ༼སྣར། པེ།༽ མི་ཤིག་"
    },
    {
      "span": {
        "start": 2741,
        "end": 2756
      },
      "text": "ཀྱི་སེམས་གཟུངས་ ༼སྣར། པེ།༽ ཀྱང་། །སེམས་གཟུང་"
    },
    {
      "span": {
        "start": 2838,
        "end": 2842
      },
      "text": "ཐུན་ ༼སྣར། པེ།༽ མཐུན་"
    },
    {
      "span": {
        "start": 3384,
        "end": 3390
      },
      "text": "ཆགས་པ་ ༼སྣར། པེ།༽ ཆག་པ་"
    },
    {
      "span": {
        "start": 3714,
        "end": 3731
      },
      "text": "ལྟར་རམ་མུན་པ་ལྟར་ ༼སྣར། པེ།༽ ལྟར་"
    },
    {
      "span": {
        "start": 3992,
        "end": 3999
      },
      "text": "དེ་ཡང་། ༼སྣར། པེ།༽ དེའི།"
    },
    {
      "span": {
        "start": 4211,
        "end": 4216
      },
      "text": "བྱའོ། ༼སྣར། པེ།༽ བྱ་བའོ།"
    },
    {
      "span": {
        "start": 4371,
        "end": 4374
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 4545,
        "end": 4551
      },
      "text": "བཤིགས་ ༼སྣར། པེ།༽ བཤིག་"
    },
    {
      "span": {
        "start": 4652,
        "end": 4660
      },
      "text": "ཆོས་དོན་ ༼སྣར། པེ།༽ ཆོས་"
    },
    {
      "span": {
        "start": 4667,
        "end": 4674
      },
      "text": "བདེན་པ་ ༼སྡེ།༽ བདེན་པའི་བདེན་པ་"
    },
    {
      "span": {
        "start": 5227,
        "end": 5236
      },
      "text": "ལུས་ཀྱིས་ ༼སྣར། པེ།༽ ལུས་ཀྱི་"
    },
    {
      "span": {
        "start": 5472,
        "end": 5481
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབས་པ་"
    },
    {
      "span": {
        "start": 5499,
        "end": 5508
      },
      "text": "ཡིད་ཀྱིས་ ༼སྣར། པེ།༽ ཡིད་ཀྱི་"
    },
    {
      "span": {
        "start": 5694,
        "end": 5703
      },
      "text": "གྲུབ་པའི་ ༼སྣར། པེ།༽ གྲུབ་པ་"
    },
    {
      "span": {
        "start": 5840,
        "end": 5847
      },
      "text": "ཐོགས་པ་ ༼སྣར། པེ།༽ ཐོག་མ་"
    },
    {
      "span": {
        "start": 6477,
        "end": 6483
      },
      "text": "དང་པོ་ ༼སྣར། པེ།༽ དང་པོས་"
    },
    {
      "span": {
        "start": 6740,
        "end": 6747
      },
      "text": "སེམས་པ་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 6753,
        "end": 6760
      },
      "text": "སེམས་པ་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 7273,
        "end": 7285
      },
      "text": "ཆོས་ཀྱི་སྐུ་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 7408,
        "end": 7411
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 7595,
        "end": 7602
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 8044,
        "end": 8051
      },
      "text": "ན་མ་ཏེ་ ༼སྣར། པེ།༽ ན་མ་སྟེ་"
    },
    {
      "span": {
        "start": 8269,
        "end": 8276
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 8319,
        "end": 8327
      },
      "text": "མོས་པའི་ ༼སྣར། པེ།༽ མོས་པ་"
    },
    {
      "span": {
        "start": 8476,
        "end": 8489
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་ཙིནྡྷ་"
    },
    {
      "span": {
        "start": 8542,
        "end": 8546
      },
      "text": "ཡང་། ༼སྣར། པེ།༽ རྣམས་རྒྱན་"
    }
  ]
}