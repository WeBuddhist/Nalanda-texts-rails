{
  "durchens": [
    {
      "span": {
        "start": 332,
        "end": 338
      },
      "text": "བརྗོད་ ༼སྣར། པེ།༽ རྗོད་"
    },
    {
      "span": {
        "start": 768,
        "end": 775
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 1118,
        "end": 1127
      },
      "text": "ཟིན་པ་ཡི། ༼སྣར།༽ ཟིན་པ་ཡིས།"
    },
    {
      "span": {
        "start": 1141,
        "end": 1145
      },
      "text": "བསལ་ ༼སྣར། པེ།༽ གསལ་"
    },
    {
      "span": {
        "start": 1364,
        "end": 1373
      },
      "text": "འདེད་ཅེས་ ༼སྣར། པེ།༽ གྱིས་ཞེས་"
    },
    {
      "span": {
        "start": 2014,
        "end": 2020
      },
      "text": "ལ་ཉེས་ ༼སྣར། པེ།༽ ལས་ཉེས་"
    },
    {
      "span": {
        "start": 2111,
        "end": 2121
      },
      "text": "ལོངས་སྤྱད་ ༼སྣར།༽ ལོངས་སྤྱོད་"
    },
    {
      "span": {
        "start": 2256,
        "end": 2264
      },
      "text": "འབའ་ཞིག་ ༼སྣར། པེ།༽ འགའ་ཞིག་"
    },
    {
      "span": {
        "start": 2467,
        "end": 2473
      },
      "text": "ཤེས་ན། ༼སྣར། པེ།༽ ཤེས་ནས།"
    },
    {
      "span": {
        "start": 2526,
        "end": 2531
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 2698,
        "end": 2709
      },
      "text": "རྩེ་མོ་ཡིས། ༼སྣར། པེ།༽ རྩེ་མོ་ཡི།"
    },
    {
      "span": {
        "start": 2947,
        "end": 2956
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 2970,
        "end": 2979
      },
      "text": "རྟོག་པའི་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 3245,
        "end": 3254
      },
      "text": "སྒྱུར་བར་ ༼སྣར། པེ།༽ བསྒྱུར་བར་"
    },
    {
      "span": {
        "start": 3482,
        "end": 3487
      },
      "text": "སྤྱད། ༼སྣར། པེ།༽ སྤྱོས།"
    },
    {
      "span": {
        "start": 4375,
        "end": 4380
      },
      "text": "ཟུགས་ ༼སྣར། པེ།༽ ཟུག་"
    },
    {
      "span": {
        "start": 4544,
        "end": 4547
      },
      "text": "གོས་ཀྱིས་དྲི་མ་མེད་པར་བྱེད། ། ༼སྣར། པེ།༽ གོས་ཀྱི་"
    },
    {
      "span": {
        "start": 4560,
        "end": 4563
      },
      "text": "བྱ། ༼སྣར། པེ།༽ བྱེད།"
    },
    {
      "span": {
        "start": 4572,
        "end": 4582
      },
      "text": "རྡུལ་གྱིས་ ༼སྣར། པེ།༽ རྡུལ་གྱི་"
    },
    {
      "span": {
        "start": 4989,
        "end": 4995
      },
      "text": "བྱས་ན། ༼སྣར། པེ།༽ བྱས་ནས།"
    },
    {
      "span": {
        "start": 5005,
        "end": 5010
      },
      "text": "ཐར་པ་ ༼སྣར། པེ།༽ ཐར་པར་"
    },
    {
      "span": {
        "start": 5097,
        "end": 5105
      },
      "text": "འཐུངས་ན་ ༼སྣར། པེ།༽ འཐུངས་ནས་"
    },
    {
      "span": {
        "start": 5836,
        "end": 5842
      },
      "text": "དུ་ནི་ ༼སྣར། པེ།༽ དུ་མི་"
    },
    {
      "span": {
        "start": 5882,
        "end": 5892
      },
      "text": "བཅུད་ཀྱིས་ ༼སྣར། པེ།༽ བཅུད་ཀྱི་"
    },
    {
      "span": {
        "start": 6108,
        "end": 6117
      },
      "text": "བྱེད་པའི་ ༼སྣར། པེ།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 6317,
        "end": 6326
      },
      "text": "རྒལ་དཀའི་ ༼སྣར། པེ།༽ བརྒལ་དཀའ་"
    },
    {
      "span": {
        "start": 6644,
        "end": 6652
      },
      "text": "ཅན་གྱིས་ ༼སྣར། པེ།༽ ཅན་གྱི་"
    },
    {
      "span": {
        "start": 6657,
        "end": 6661
      },
      "text": "བྱས་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 6750,
        "end": 6758
      },
      "text": "སྨྱུང་བ་ ༼སྣར། པེ།༽ བསྙུང་བ་"
    },
    {
      "span": {
        "start": 7279,
        "end": 7289
      },
      "text": "ཁྲུས་ཀྱིས་ ༼སྣར། པེ།༽ ཁྲུས་ཀྱི་"
    },
    {
      "span": {
        "start": 7912,
        "end": 7915
      },
      "text": "རབ། ༼སྣར། པེ།༽ བར།"
    },
    {
      "span": {
        "start": 7981,
        "end": 7990
      },
      "text": "རྡོ་རྗེས་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 8081,
        "end": 8091
      },
      "text": "འདུས་པ་ཡི། ༼སྣར། པེ།༽ འདུས་པ་ཡིས།"
    },
    {
      "span": {
        "start": 8218,
        "end": 8225
      },
      "text": "བརྟག་པ་ ༼སྣར། པེ།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 8273,
        "end": 8280
      },
      "text": "རྟག་པར་ ༼སྣར། པེ།༽ རྣམ་པར་"
    },
    {
      "span": {
        "start": 8320,
        "end": 8325
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 8380,
        "end": 8389
      },
      "text": "ཀུན་གྱིས་ ༼སྣར། པེ།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 8396,
        "end": 8402
      },
      "text": "བརྟག ། ༼སྣར། པེ།༽ བརྟགས། །"
    },
    {
      "span": {
        "start": 8425,
        "end": 8430
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 8450,
        "end": 8456
      },
      "text": "བརྟག ། ༼སྣར། པེ།༽ བརྟགས། །"
    },
    {
      "span": {
        "start": 8462,
        "end": 8469
      },
      "text": "ལས་ཀྱི་ ༼སྣར། པེ།༽ ལས་ཀྱིས་"
    },
    {
      "span": {
        "start": 8587,
        "end": 8593
      },
      "text": "བཀྲུས་ ༼སྣར། པེ།༽ བཀྲུ་"
    },
    {
      "span": {
        "start": 8674,
        "end": 8679
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 8688,
        "end": 8693
      },
      "text": "མཚམས་ ༼སྣར། པེ།༽ རྟོག་པ་མེད་པར་སྤྱད་པར་བྱ། །འཚོམ་"
    },
    {
      "span": {
        "start": 9082,
        "end": 9087
      },
      "text": "བརྟན་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 9100,
        "end": 9111
      },
      "text": "རྟོག་པ་ཡིས་ ༼སྣར། པེ།༽ རྟོག་པ་འདིས་"
    },
    {
      "span": {
        "start": 9135,
        "end": 9144
      },
      "text": "འདོད་པའི་ ༼སྣར། པེ།༽ འདོད་པས་"
    },
    {
      "span": {
        "start": 10152,
        "end": 10162
      },
      "text": "མོས་པ་ཡང་། ༼སྣར། པེ།༽ མོས་པ་དང་།"
    },
    {
      "span": {
        "start": 10592,
        "end": 10597
      },
      "text": "དྲ་བ་ ༼སྣར། པེ།༽ དྲ་བས་"
    },
    {
      "span": {
        "start": 10716,
        "end": 10723
      },
      "text": "དྲུད་པ་ ༼སྣར། པེ།༽ བྲུད་པ་"
    },
    {
      "span": {
        "start": 11316,
        "end": 11343
      },
      "text": "།ས་བོན་སྐྱེས་བུ་ལྡན་པ་ལས། ། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 11369,
        "end": 11378
      },
      "text": "འཁྲི་ཤིང་ ༼སྣར། པེ།༽ འཁྲིལ་ཤིང་"
    },
    {
      "span": {
        "start": 11483,
        "end": 11488
      },
      "text": "རེངས། ༼སྣར། པེ།༽ རངས།"
    },
    {
      "span": {
        "start": 11497,
        "end": 11504
      },
      "text": "དགུག་པ་ ༼སྣར། པེ།༽ དགུ་པ་"
    },
    {
      "span": {
        "start": 11589,
        "end": 11594
      },
      "text": "ལྟ་བ་ ༼སྣར། པེ།༽ ལྟ་བུ་"
    },
    {
      "span": {
        "start": 11640,
        "end": 11644
      },
      "text": "སོང་ ༼སྣར། པེ།༽ རྒྱས་"
    },
    {
      "span": {
        "start": 11665,
        "end": 11672
      },
      "text": "བརྟན་པ་ ༼སྣར། པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 11977,
        "end": 11984
      },
      "text": "སྟོབ་པ་ ༼སྣར། པེ།༽ སྟོང་པ་"
    },
    {
      "span": {
        "start": 12087,
        "end": 12095
      },
      "text": "བྲམ་ཟེར་ ༼སྣར། པེ།༽ བྲམ་ཟེ་"
    },
    {
      "span": {
        "start": 12200,
        "end": 12211
      },
      "text": "རྗེའུ་རིགས་ ༼སྣར། པེ།༽ རྗེ་རིགས་"
    },
    {
      "span": {
        "start": 12501,
        "end": 12504
      },
      "text": "ལྟ། ༼སྣར། པེ།༽ བལྟ།"
    },
    {
      "span": {
        "start": 12513,
        "end": 12519
      },
      "text": "ཉན་པར་ ༼ཅོ། སྡེ།༽ ཉིན་པར་"
    },
    {
      "span": {
        "start": 12674,
        "end": 12679
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 13100,
        "end": 13111
      },
      "text": "རབ་དཀའ་ཡང་། ༼སྣར། པེ།༽ རབ་དགའ་བ།"
    },
    {
      "span": {
        "start": 13199,
        "end": 13206
      },
      "text": "གཞག་པས་ ༼སྣར། པེ།༽ བཞག་པས་"
    },
    {
      "span": {
        "start": 13391,
        "end": 13395
      },
      "text": "གོས། ༼སྣར། པེ།༽ དགོས།"
    },
    {
      "span": {
        "start": 13511,
        "end": 13519
      },
      "text": "ཐོག་མེད་ ༼སྣར། པེ།༽ ཐོགས་མེད་"
    },
    {
      "span": {
        "start": 14107,
        "end": 14112
      },
      "text": "སྤངས་ ༼སྣར། པེ།༽ སྤོངས་"
    },
    {
      "span": {
        "start": 14547,
        "end": 14556
      },
      "text": "མཚམས་མེད་ ༼སྣར། པེ།༽ འཚོམ་བྱེད་"
    },
    {
      "span": {
        "start": 14727,
        "end": 14732
      },
      "text": "མཚམས་ ༼སྣར། པེ།༽ འཚོམ་"
    },
    {
      "span": {
        "start": 14826,
        "end": 14835
      },
      "text": "འགྲོས་པར་ ༼སྣར། པེ།༽ འབྲོས་པར་"
    },
    {
      "span": {
        "start": 15094,
        "end": 15105
      },
      "text": "གཟུགས་ཀྱིས་ ༼སྣར། པེ།༽ གཟུགས་ཀྱི་"
    },
    {
      "span": {
        "start": 15216,
        "end": 15229
      },
      "text": "རྣམ་པར་སྦྱང་། ༼སྣར། པེ།༽ རྣམ་པར་བྱང་།"
    },
    {
      "span": {
        "start": 15334,
        "end": 15344
      },
      "text": "བསྐྱེད་པར་ ༼སྣར། པེ།༽ སྐྱེད་པར་"
    },
    {
      "span": {
        "start": 15513,
        "end": 15518
      },
      "text": "བསགས་ ༼སྣར། པེ།༽ ལགས་"
    }
  ]
}