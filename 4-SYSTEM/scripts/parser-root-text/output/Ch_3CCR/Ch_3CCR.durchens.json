{
  "durchens": [
    {
      "span": {
        "start": 246,
        "end": 256
      },
      "text": "རྟོགས་པའི་ ༼སྣར། པེ།༽ རྟོག་པའི་"
    },
    {
      "span": {
        "start": 613,
        "end": 624
      },
      "text": "ཁྱད་པར་གྱི་ ༼སྣར། པེ།༽ ཁྱད་ཀྱི་"
    },
    {
      "span": {
        "start": 624,
        "end": 631
      },
      "text": "ལུང་གི་ ༼སྣར། པེ།༽ ལུང་"
    },
    {
      "span": {
        "start": 731,
        "end": 740
      },
      "text": "ཁ་ཅིག་ནི་ ༼སྣར། པེ།༽ ཁ་ཅིག་"
    },
    {
      "span": {
        "start": 812,
        "end": 821
      },
      "text": "ཁ་ཅིག་ནི་ ༼སྣར། པེ།༽ ཁ་ཅིག་"
    },
    {
      "span": {
        "start": 850,
        "end": 868
      },
      "text": "སེམས་དཔའ་རྫོགས་པར་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 1019,
        "end": 1025
      },
      "text": "རྒྱུད་ ༼སྣར། པེ།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 1167,
        "end": 1175
      },
      "text": "གདུལ་བར་ ༼སྣར། པེ།༽ འདུལ་བར་"
    },
    {
      "span": {
        "start": 1876,
        "end": 1882
      },
      "text": "གཞག་པ་ ༼སྣར། པེ།༽ བཞག་པ་"
    },
    {
      "span": {
        "start": 2017,
        "end": 2021
      },
      "text": "ཨརྒ་ ༼སྣར། པེ།༽ ཨརྒཱ་"
    },
    {
      "span": {
        "start": 2205,
        "end": 2212
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 2266,
        "end": 2276
      },
      "text": "སེམས་དཔའི་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 2456,
        "end": 2463
      },
      "text": "བྱ་བའོ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 2750,
        "end": 2757
      },
      "text": "འབར་བར་ ༼སྣར། པེ།༽ འབར་བས་"
    },
    {
      "span": {
        "start": 2966,
        "end": 2973
      },
      "text": "གནས་པར་ ༼སྣར། པེ།༽ གནས་པ་"
    },
    {
      "span": {
        "start": 3395,
        "end": 3401
      },
      "text": "བཞུགས་ ༼སྣར། པེ།༽ ཞུགས་"
    },
    {
      "span": {
        "start": 3433,
        "end": 3443
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 3443,
        "end": 3450
      },
      "text": "ཏིང་ངེ་ ༼སྣར།༽ ཏིང་"
    },
    {
      "span": {
        "start": 3484,
        "end": 3493
      },
      "text": "བརྗོད་ནས་ ༼སྣར། པེ།༽ བརྗོད་ལ་"
    },
    {
      "span": {
        "start": 3729,
        "end": 3731
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 3929,
        "end": 3940
      },
      "text": "གཟུགས་ཀྱིས་ ༼སྣར། པེ།༽ གཟུགས་ཀྱི་"
    },
    {
      "span": {
        "start": 3975,
        "end": 3984
      },
      "text": "ལེའུ་བཅུ་ ༼སྣར། པེ།༽ ལེའུ་"
    },
    {
      "span": {
        "start": 4008,
        "end": 4012
      },
      "text": "བཞི་ ༼སྣར། པེ།༽ བཞི་བཞི་"
    },
    {
      "span": {
        "start": 4306,
        "end": 4313
      },
      "text": "གཏང་བར་ ༼སྣར། པེ།༽ གཏད་པར་"
    },
    {
      "span": {
        "start": 5377,
        "end": 5386
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 5639,
        "end": 5648
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 5688,
        "end": 5693
      },
      "text": "གཞུག་ ༼ཅོ།༽ གཞུགས་"
    },
    {
      "span": {
        "start": 5772,
        "end": 5780
      },
      "text": "བསྒོམ་པ་ ༼སྣར། པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 6221,
        "end": 6228
      },
      "text": "མཚན་པར་ ༼སྣར། པེ།༽ མཚན་པ་"
    },
    {
      "span": {
        "start": 6263,
        "end": 6266
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 6270,
        "end": 6287
      },
      "text": "དཀྱིལ་འཁོར་འབབ་པ་ ༼སྣར། པེ།༽ དཀྱིལ་འཁོར་འབའ་"
    },
    {
      "span": {
        "start": 6478,
        "end": 6489
      },
      "text": "དཀྱིལ་འཁོར་ ༼སྣར། པེ།༽ དཀྱིལ་འཁོར་བཞི་"
    },
    {
      "span": {
        "start": 7241,
        "end": 7245
      },
      "text": "ལའི་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 8360,
        "end": 8366
      },
      "text": "སྒྱུར་ ༼སྣར། པེ།༽ བསྒྱུར་"
    },
    {
      "span": {
        "start": 8409,
        "end": 8413
      },
      "text": "མདོ་ ༼སྣར། པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 8532,
        "end": 8541
      },
      "text": "འཁྲུགས་པ་ ༼སྣར། པེ།༽ འཁྲུག་པ་"
    },
    {
      "span": {
        "start": 8823,
        "end": 8835
      },
      "text": "རང་བཞིན་གྱི་ ༼སྣར། པེ།༽ རང་བཞིན་གྱིས་"
    },
    {
      "span": {
        "start": 8869,
        "end": 8881
      },
      "text": "རང་བཞིན་གྱི་ ༼སྣར། པེ།༽ རང་བཞིན་གྱིས་"
    },
    {
      "span": {
        "start": 10294,
        "end": 10300
      },
      "text": "བསད་ན། ༼སྣར། པེ།༽ བསད་ནས།"
    },
    {
      "span": {
        "start": 10320,
        "end": 10335
      },
      "text": "འགྲུབ་པར་འགྱུར། ༼སྣར། པེ།༽ འགྲུབ་འགྱུར་རོ།"
    },
    {
      "span": {
        "start": 10651,
        "end": 10656
      },
      "text": "དགོད་ ༼སྣར། པེ།༽ བཀོད་"
    },
    {
      "span": {
        "start": 10712,
        "end": 10717
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 10898,
        "end": 10906
      },
      "text": "བརྟན་པར་ ༼སྣར། པེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 10906,
        "end": 10918
      },
      "text": "བྱའོ་ཞེས་བྱ་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 10935,
        "end": 10950
      },
      "text": "རྣལ་འབྱོར་རོ། ། ༼སྣར། པེ།༽ རྣལ་འབྱོར།། །།"
    },
    {
      "span": {
        "start": 11182,
        "end": 11190
      },
      "text": "དཀར་པོར་ ༼སྣར། པེ།༽ དཀར་པོ་"
    },
    {
      "span": {
        "start": 11539,
        "end": 11546
      },
      "text": "རིམ་པས་ ༼སྣར། པེ།༽ རིམ་པ་"
    },
    {
      "span": {
        "start": 11651,
        "end": 11664
      },
      "text": "སྐྱེ་མཆེད་དང་ ༼སྣར། པེ།༽ སྐྱེ་མཆེད་"
    },
    {
      "span": {
        "start": 12747,
        "end": 12761
      },
      "text": "སྐྱེ་མཆེད་ཀྱི་ ༼སྣར། པེ།༽ སྐྱེ་མཆེད་"
    },
    {
      "span": {
        "start": 13039,
        "end": 13044
      },
      "text": "ཚིགས་ ༼སྣར། པེ།༽ ཚོགས་"
    },
    {
      "span": {
        "start": 13145,
        "end": 13153
      },
      "text": "རིང་པོར་ ༼སྣར། པེ།༽ རིང་པོ་ལས་"
    },
    {
      "span": {
        "start": 13398,
        "end": 13406
      },
      "text": "སྔོན་ཅན། ༼སྣར། པེ།༽ སྔོན།"
    },
    {
      "span": {
        "start": 13456,
        "end": 13465
      },
      "text": "འཁོར་ལོས་ ༼སྣར། པེ།༽ འཁོར་ལོ་"
    },
    {
      "span": {
        "start": 13633,
        "end": 13643
      },
      "text": "སྔགས་ཀྱིས་ ༼སྣར། པེ།༽ སྔགས་ཀྱི་"
    },
    {
      "span": {
        "start": 13800,
        "end": 13803
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 14656,
        "end": 14664
      },
      "text": "དགའ་བའི་ ༼སྣར། པེ།༽ དགའ་བ་"
    },
    {
      "span": {
        "start": 14762,
        "end": 14777
      },
      "text": "སྒོ་ནས་ཞུགས་ནས་ ༼སྣར། པེ།༽ སྒོ་ནས་"
    },
    {
      "span": {
        "start": 14780,
        "end": 14784
      },
      "text": "ཤེས་ ༼སྣར། པེ།༽ ཤེས་ས་"
    },
    {
      "span": {
        "start": 15029,
        "end": 15036
      },
      "text": "དྲུག་པ་ ༼སྣར། པེ།༽ བདུན་པ་"
    },
    {
      "span": {
        "start": 15627,
        "end": 15633
      },
      "text": "བརླབས་ ༼སྣར།༽ བརླབ་"
    },
    {
      "span": {
        "start": 15709,
        "end": 15714
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ གཉིས་སྔར་"
    },
    {
      "span": {
        "start": 15787,
        "end": 15798
      },
      "text": "གཟུགས་ཀྱིས་ ༼སྣར།༽ གཟུགས་ཀྱི་"
    },
    {
      "span": {
        "start": 15814,
        "end": 15820
      },
      "text": "ངག་གི་ ༼སྣར། པེ།༽ ངག་གིས་"
    },
    {
      "span": {
        "start": 16885,
        "end": 16890
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 16944,
        "end": 16949
      },
      "text": "འདིས་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 17171,
        "end": 17179
      },
      "text": "ཆེན་པོར་ ༼སྣར། པེ།༽ ཆེན་པོའི་"
    },
    {
      "span": {
        "start": 17189,
        "end": 17196
      },
      "text": "བརླབ་པ་ ༼སྣར། པེ།༽ བརླབས་པ་"
    },
    {
      "span": {
        "start": 17494,
        "end": 17503
      },
      "text": "ཚུལ་གྱིས་ ༼སྣར། པེ།༽ ཚུལ་"
    },
    {
      "span": {
        "start": 17657,
        "end": 17675
      },
      "text": "ཁ་སྦྱོར་གྱི་སྦྱོར་ ༼སྣར། པེ།༽ ཁ་སྦྱོར་"
    },
    {
      "span": {
        "start": 18763,
        "end": 18771
      },
      "text": "མཁྱེན་པ་ ༼སྣར། པེ།༽ མཁྱེན་པར་"
    },
    {
      "span": {
        "start": 19011,
        "end": 19281
      },
      "text": "དོན་དུ་དེ་ལས་ལེའུ་དང་པོ་ལས་གསུངས་པའི་འདོད་ཆགས་ཆེན་པོའི་ཚུལ་ཞེས་བྱ་པའི་ཏིང་ངེ་འཛིན་དེ་ལ་སྙོམས་པར་ཞུགས་པ་དེ་བཞིན་དུ་སློབ་བཞིན་པའི་རྣལ་འབྱོར་པས་ཀྱང་དང་པོ་སྦྱོར་བ་བྱས་ནས་འདོད་ཆགས་ལ་སྤྱོད་པའི་སེམས་ཅན་རྣམས་འདོད་པས་ཐར་པར་རབ་ཏུ་བསྟན་པའི་ཕྱིར། ལེའུ་བཅུ་བདུན་པ་ལས་གསུངས་པའི་རིམ་པ་ ༼སྣར། པེ།༽ དོན་དུ་"
    },
    {
      "span": {
        "start": 20385,
        "end": 20390
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བས་"
    },
    {
      "span": {
        "start": 20439,
        "end": 20451
      },
      "text": "བྱས་ནས་ད་ནི་ ༼སྣར། པེ།༽ བྱས་ནས་"
    },
    {
      "span": {
        "start": 20516,
        "end": 20519
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ཨཱཿནི་"
    },
    {
      "span": {
        "start": 20600,
        "end": 20612
      },
      "text": "རང་བཞིན་གྱི་ ༼སྣར། པེ།༽ རང་བཞིན་གྱིས་"
    },
    {
      "span": {
        "start": 21180,
        "end": 21189
      },
      "text": "ཕྱིན་གྱི་ ༼སྣར། པེ།༽ ཕྱིན་གྱིས་"
    },
    {
      "span": {
        "start": 21559,
        "end": 21564
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ ཨཿབསམས་"
    },
    {
      "span": {
        "start": 21929,
        "end": 21939
      },
      "text": "སྔགས་ཀྱིས་ ༼སྣར། པེ།༽ སྔགས་ཀྱི་"
    },
    {
      "span": {
        "start": 21962,
        "end": 21969
      },
      "text": "བྱའོ། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 22242,
        "end": 22246
      },
      "text": "བའི་ ༼སྣར། པེ།༽ བའོ། །"
    },
    {
      "span": {
        "start": 22283,
        "end": 22288
      },
      "text": "ལེའི་ ༼སྣར། པེ།༽ ལེའུ་"
    },
    {
      "span": {
        "start": 22294,
        "end": 22299
      },
      "text": "ཀྱིས་ ༼སྣར། པེ།༽ ཀྱི་"
    },
    {
      "span": {
        "start": 22428,
        "end": 22434
      },
      "text": "བཞུགས་ ༼སྣར། པེ།༽ ཞུགས་"
    },
    {
      "span": {
        "start": 22523,
        "end": 22529
      },
      "text": "བརླབས་ ༼སྣར། པེ།༽ བརླབ་"
    },
    {
      "span": {
        "start": 22792,
        "end": 22800
      },
      "text": "བསྐུར་བ་ ༼ཅོ། པེ།༽ སྐུར་བ་"
    },
    {
      "span": {
        "start": 23229,
        "end": 23239
      },
      "text": "འཛིན་གྱིས་ ༼སྣར། པེ།༽ འཛིན་གྱི་"
    },
    {
      "span": {
        "start": 23639,
        "end": 23647
      },
      "text": "ཡིད་བདེ་ ༼པེ།༽ ཡིད་"
    },
    {
      "span": {
        "start": 23924,
        "end": 23933
      },
      "text": "སྡིགས་པར་ ༼སྣར། པེ།༽ བསྡིགས་པར་"
    },
    {
      "span": {
        "start": 23933,
        "end": 23941
      },
      "text": "བྱེད་དོ། ༼སྣར། པེ།༽ བྱེད་དེ།"
    },
    {
      "span": {
        "start": 24145,
        "end": 24151
      },
      "text": "པའོ། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 24154,
        "end": 24158
      },
      "text": "ལྟར་ ༼ཅོ།༽ ལྟར་ཡང་"
    },
    {
      "span": {
        "start": 24540,
        "end": 24557
      },
      "text": "དབང་ཕྱུག་ཁྱོད་ནི་ ༼སྣར། པེ།༽ དབང་ཕྱུག་"
    },
    {
      "span": {
        "start": 24980,
        "end": 24990
      },
      "text": "ཐུགས་བརྩེ་ ༼སྣར། པེ།༽ ཐུགས་རྗེ་"
    },
    {
      "span": {
        "start": 25223,
        "end": 25228
      },
      "text": "གདུང་ ༼སྣར། པེ།༽ མདུང་"
    },
    {
      "span": {
        "start": 25442,
        "end": 25459
      },
      "text": "གཤེགས་པ་རྣམས་ཀྱི་ ༼སྣར། པེ།༽ གཤེགས་པ་"
    },
    {
      "span": {
        "start": 25509,
        "end": 25519
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 25734,
        "end": 25746
      },
      "text": "རང་བཞིན་གྱི་ ༼སྣར། པེ།༽ རང་བཞིན་གྱིས་"
    },
    {
      "span": {
        "start": 25856,
        "end": 25862
      },
      "text": "དག་པས་ ༼སྣར། པེ།༽ དག་པ་"
    },
    {
      "span": {
        "start": 26416,
        "end": 26429
      },
      "text": "གྱུར་པར་བསམས་ ༼སྣར། པེ།༽ གྱུར་པའི་གཟུགས་"
    },
    {
      "span": {
        "start": 26606,
        "end": 26609
      },
      "text": "དག་ ༼སྣར། པེ།༽ རྟག་"
    },
    {
      "span": {
        "start": 26649,
        "end": 26651
      },
      "text": "པ་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 26991,
        "end": 26998
      },
      "text": "ཅན་གྱི་ ༼སྣར། པེ།༽ ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 27305,
        "end": 27310
      },
      "text": "ཟླ་བ་ ༼སྣར། པེ།༽ ཟླ་བའི་"
    },
    {
      "span": {
        "start": 27324,
        "end": 27335
      },
      "text": "རྫོགས། །། ༼པེ།༽ རྫོགསརྫོགས་སྷོ། །།"
    },
    {
      "span": {
        "start": 27383,
        "end": 27389
      },
      "text": "པའོ། ། ༼སྣར། པེ།༽ །། །།"
    }
  ]
}