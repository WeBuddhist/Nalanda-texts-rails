{
  "durchens": [
    {
      "span": {
        "start": 19,
        "end": 33
      },
      "text": "ཚངས་པའི་དབྱངས་ ༼ཅོ།༽ ཚངས་པའི་"
    },
    {
      "span": {
        "start": 680,
        "end": 684
      },
      "text": "ཁོམ་ ༼ཅོ།༽ ཁམ་"
    },
    {
      "span": {
        "start": 737,
        "end": 741
      },
      "text": "ནམས་ ༼ཅོ།༽ ནམ་"
    },
    {
      "span": {
        "start": 1750,
        "end": 1757
      },
      "text": "གོག་ཅི་ ༼ཅོ།༽ གོག་ཅིང་"
    },
    {
      "span": {
        "start": 2440,
        "end": 2444
      },
      "text": "མེད། ༼ཅོ།༽ མེད་དོ།"
    },
    {
      "span": {
        "start": 2995,
        "end": 2998
      },
      "text": "བས་ ༼ཅོ།༽ བུས་"
    },
    {
      "span": {
        "start": 3034,
        "end": 3039
      },
      "text": "ཕྱིན་ ༼ཅོ།༽ ཁྱིམ་"
    },
    {
      "span": {
        "start": 3741,
        "end": 3745
      },
      "text": "ཕྲད་ ༼ཅོ།༽ ཕྲོད་"
    },
    {
      "span": {
        "start": 4630,
        "end": 4633
      },
      "text": "ཚང་ ༼ཅོ།༽ ཚངས་"
    },
    {
      "span": {
        "start": 4649,
        "end": 4652
      },
      "text": "ནང་ ༼ཅོ།༽ ནན་"
    },
    {
      "span": {
        "start": 5048,
        "end": 5052
      },
      "text": "ཐོན་ ༼ཅོ།༽ མཐོན་"
    }
  ]
}