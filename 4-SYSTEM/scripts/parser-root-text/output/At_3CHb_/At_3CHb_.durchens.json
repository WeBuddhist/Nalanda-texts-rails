{
  "durchens": [
    {
      "span": {
        "start": 113,
        "end": 123
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 273,
        "end": 286
      },
      "text": "དེའི་སྟེང་དུ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 329,
        "end": 335
      },
      "text": "ཕྱོགས་ ༼སྣར། པེ།༽ ཚོགས་"
    },
    {
      "span": {
        "start": 883,
        "end": 900
      },
      "text": "འདོད་པའི་སྦྱིན་པ་ ༼སྣར། པེ།༽ འདོད་པ་"
    },
    {
      "span": {
        "start": 1134,
        "end": 1142
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    }
  ]
}