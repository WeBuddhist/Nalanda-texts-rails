{
  "durchens": [
    {
      "span": {
        "start": 391,
        "end": 406
      },
      "text": "བྱེད་ཏིལ་བརྡུང་ ༼སྣར། པེ།༽ བྱེད་སྤྱོད་བརྡུང་ཆང་རྡུང་"
    },
    {
      "span": {
        "start": 409,
        "end": 414
      },
      "text": "འཚོང་ ༼སྣར། པེ།༽ ཚོང་"
    },
    {
      "span": {
        "start": 523,
        "end": 532
      },
      "text": "ངན་ཁྲིམས་ ༼སྣར། པེ།༽ ནང་ཁྲིམས་"
    },
    {
      "span": {
        "start": 615,
        "end": 624
      },
      "text": "ཀླ་ཀློའི་ ༼སྣར། པེ།༽ ཀླ་ཀློ་"
    },
    {
      "span": {
        "start": 698,
        "end": 705
      },
      "text": "ལོག་ལྟ་ ༼སྣར། པེ།༽ ལོག་རྟོག་"
    },
    {
      "span": {
        "start": 738,
        "end": 745
      },
      "text": "ཤན་པའི་ ༼སྣར། པེ།༽ བཤན་པའི་"
    },
    {
      "span": {
        "start": 926,
        "end": 932
      },
      "text": "བར་ཆད་ ༼སྣར། པེ།༽ བར་གཅོད་"
    },
    {
      "span": {
        "start": 1016,
        "end": 1020
      },
      "text": "བསམ་ ༼སྣར། པེ།༽ བསམས་"
    },
    {
      "span": {
        "start": 1043,
        "end": 1052
      },
      "text": "སྦྱངས་ནས། ༼སྣར། པེ།༽ སྦྱངས་ཏེ།"
    },
    {
      "span": {
        "start": 1190,
        "end": 1200
      },
      "text": "བསྐུར་བའི་ ༼སྣར། པེ།༽ བཀུར་བའི་"
    },
    {
      "span": {
        "start": 1223,
        "end": 1229
      },
      "text": "རྫོགས་ ༼སྣར།༽ རྫོག་"
    },
    {
      "span": {
        "start": 1245,
        "end": 1254
      },
      "text": "གཞོན་ནུར་ ༼སྣར། པེ།༽ གཞོན་ནུ་"
    }
  ]
}