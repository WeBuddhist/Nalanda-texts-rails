{
  "durchens": [
    {
      "span": {
        "start": 120,
        "end": 127
      },
      "text": "དཔལ་རུ་ ༼སྣར།༽ དཔལ་དུ་"
    },
    {
      "span": {
        "start": 634,
        "end": 644
      },
      "text": "ད་ལྟར་གྱི་ ༼པེ།༽ ད་ལྟར་བའི་"
    },
    {
      "span": {
        "start": 1194,
        "end": 1199
      },
      "text": "བྱ་བ་ ༼སྣར།༽ བྱ་བ་འགྲུབ་པར་"
    },
    {
      "span": {
        "start": 1254,
        "end": 1265
      },
      "text": "སེང་གེ་ཡིས་ ༼སྣར།༽ སེང་གེ་ཡི་"
    },
    {
      "span": {
        "start": 1267,
        "end": 1271
      },
      "text": "རོལ་ ༼སྣར།༽ རོལ་ཀྱི་དཔུང་"
    },
    {
      "span": {
        "start": 1414,
        "end": 1428
      },
      "text": "དགྲ་མང་ནའང་དེ་ ༼པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 1494,
        "end": 1504
      },
      "text": "ལ་བྱེ་བ་ལ་ ༼པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 1537,
        "end": 1541
      },
      "text": "སོམ་ ༼པེ།༽ སོམས་"
    },
    {
      "span": {
        "start": 1566,
        "end": 1573
      },
      "text": "སེང་གེ་ ༼སྣར།༽ སེང་གེས་"
    },
    {
      "span": {
        "start": 1700,
        "end": 1705
      },
      "text": "ནི་མ་ ༼སྣར།༽ ནི་མི་"
    },
    {
      "span": {
        "start": 1737,
        "end": 1741
      },
      "text": "འཐད་ ༼པེ།༽ ཐད་"
    },
    {
      "span": {
        "start": 1837,
        "end": 1846
      },
      "text": "ཁྱོད་ཀྱི་ ༼པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 1918,
        "end": 1923
      },
      "text": "འདུག། ༼པེ།༽ འཇུག།"
    },
    {
      "span": {
        "start": 1961,
        "end": 1973
      },
      "text": "ཁྱོད་གང་ཞིག་ ༼སྣར།༽ ཁྱོད་གཤེད་"
    },
    {
      "span": {
        "start": 2024,
        "end": 2034
      },
      "text": "དོན་འགྲུབ། ༼པེ།༽ དོན་གྲུབ།"
    },
    {
      "span": {
        "start": 2050,
        "end": 2060
      },
      "text": "འཕེལ་ལོ། ། ༼པེ།༽ འཕེལ་"
    },
    {
      "span": {
        "start": 2388,
        "end": 2390
      },
      "text": "བ་ ༼སྣར།༽ ཐ་"
    },
    {
      "span": {
        "start": 2576,
        "end": 2597
      },
      "text": "བརྟགས་གཞིགས་གྱིས་སྔར་ ༼པེ།༽ རྟོགས་གཞིག་ལ་གྱིས་"
    },
    {
      "span": {
        "start": 2645,
        "end": 2653
      },
      "text": "གྲུབ་བོ་ ༼པེ།༽ འགྲུབ་"
    },
    {
      "span": {
        "start": 2677,
        "end": 2687
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 2791,
        "end": 2813
      },
      "text": "བསྟུན་རྣམ་རྟོག་མ་བྱེད་ ༼པེ།༽ བསྟུན་ན་"
    },
    {
      "span": {
        "start": 2995,
        "end": 2999
      },
      "text": "བསམ་ ༼སྣར།༽ བསམས་ཏེ་"
    },
    {
      "span": {
        "start": 3005,
        "end": 3013
      },
      "text": "འོན་ཀྱང་ ༼སྣར།༽ འོན་ཀྱང་མིང་"
    },
    {
      "span": {
        "start": 3035,
        "end": 3043
      },
      "text": "འབའ་ཞིག་ ༼སྣར།༽ འགའ་ཞིག་"
    },
    {
      "span": {
        "start": 3080,
        "end": 3090
      },
      "text": "ཕྱི་དུས་ལ་ ༼སྣར།༽ ཕྱི་ཤོལ་"
    },
    {
      "span": {
        "start": 3114,
        "end": 3124
      },
      "text": "ཕྱི་དུས་ལ་ ༼སྣར།༽ ཕྱི་ཤོལ་"
    },
    {
      "span": {
        "start": 3146,
        "end": 3155
      },
      "text": "རྩེ་གཉིས་ ༼པེ།༽ རྩེ་གཅིག་"
    },
    {
      "span": {
        "start": 3188,
        "end": 3194
      },
      "text": "དེས་ན་ ༼པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 3241,
        "end": 3249
      },
      "text": "ཞིང་ནོར་ ༼པེ།༽ ཞིང་"
    },
    {
      "span": {
        "start": 3309,
        "end": 3318
      },
      "text": "ཁྱེད་ཀྱི་ ༼པེ།༽ ཁྱེད་ཀྱིས་"
    },
    {
      "span": {
        "start": 3709,
        "end": 3716
      },
      "text": "རྟག་པར་ ༼སྣར།༽ བརྟན་པར་"
    },
    {
      "span": {
        "start": 3814,
        "end": 3820
      },
      "text": "འགོགས་ ༼སྣར།༽ འགོག་"
    },
    {
      "span": {
        "start": 3938,
        "end": 3945
      },
      "text": "མ་གྲུབ་ ༼སྣར།༽ མི་འགྲུབ་"
    },
    {
      "span": {
        "start": 4004,
        "end": 4012
      },
      "text": "ལས་ཀྱིས་ ༼སྣར།༽ ལས་ཀྱི་"
    },
    {
      "span": {
        "start": 4106,
        "end": 4115
      },
      "text": "བསམས་པའི་ ༼པེ།༽ བསམ་པའི་"
    },
    {
      "span": {
        "start": 4140,
        "end": 4156
      },
      "text": "དགའ་བར་གྱིས་ཤིག་ ༼པེ།༽ དགའ་བར་གྱིས་"
    },
    {
      "span": {
        "start": 4197,
        "end": 4206
      },
      "text": "བསམས་པའི་ ༼པེ།༽ བསམ་པའི་"
    },
    {
      "span": {
        "start": 4248,
        "end": 4253
      },
      "text": "བརྟན་ ༼པེ།༽ བརྟན་པར་"
    },
    {
      "span": {
        "start": 4354,
        "end": 4360
      },
      "text": "བསམ་པ་ ༼སྣར།༽ བསམས་པ་"
    },
    {
      "span": {
        "start": 4367,
        "end": 4373
      },
      "text": "ཨ་ཨ་ཝ། ༼པེ།༽ ཨ་ཝ་ཝ། ཉོན་ཅིག་"
    },
    {
      "span": {
        "start": 4380,
        "end": 4391
      },
      "text": "པོ་ཉོན་ཅིག་ ༼པེ།༽ པོ་"
    },
    {
      "span": {
        "start": 4422,
        "end": 4427
      },
      "text": "འཐོབ་ ༼པེ།༽ ཐོབ་"
    },
    {
      "span": {
        "start": 4544,
        "end": 4554
      },
      "text": "འགྲུབ་ཀྱི། ༼པེ།༽ འགྱུར་གྱིས།"
    },
    {
      "span": {
        "start": 4698,
        "end": 4708
      },
      "text": "རྟས་བགྲོད་ ༼པེ།༽ རྟགས་གྲེད་"
    },
    {
      "span": {
        "start": 4731,
        "end": 4736
      },
      "text": "འཐབས་ ༼སྣར།༽ བགྲོད་ཐབས་མེད་"
    },
    {
      "span": {
        "start": 4807,
        "end": 4812
      },
      "text": "སྲིད་ ༼པེ།༽ སྲུན་"
    },
    {
      "span": {
        "start": 4846,
        "end": 4855
      },
      "text": "དགོས་པའི་ ༼པེ།༽ དགོས་"
    },
    {
      "span": {
        "start": 4875,
        "end": 4879
      },
      "text": "འོང་ ༼པེ།༽ འོངས་"
    },
    {
      "span": {
        "start": 4909,
        "end": 4920
      },
      "text": "དབང་གིས་ལན་ ༼པེ།༽ དབང་གིས་"
    },
    {
      "span": {
        "start": 4928,
        "end": 4941
      },
      "text": "གྲོགས་པོ་བཟང་ ༼པེ།༽ གྲོགས་པོ་"
    },
    {
      "span": {
        "start": 5219,
        "end": 5226
      },
      "text": "བྱས་པས་ ༼སྣར།༽ བྱས་པས་ཡོན་ཏན་"
    },
    {
      "span": {
        "start": 5275,
        "end": 5283
      },
      "text": "ཟུང་ཤིག་ ༼པེ།༽ ཟུང་ཞིག་"
    },
    {
      "span": {
        "start": 5318,
        "end": 5327
      },
      "text": "འགྲུབ་པས་ ༼པེ།༽ འགྲུབ་པའི་དོན་འགྲུབ་"
    },
    {
      "span": {
        "start": 5338,
        "end": 5343
      },
      "text": "གྱིས། ༼པེ།༽ བགྱིས།"
    },
    {
      "span": {
        "start": 5431,
        "end": 5439
      },
      "text": "རྒྱལ་བར་ ༼སྣར།༽ རྒྱལ་བར་འགྱུར་"
    },
    {
      "span": {
        "start": 5447,
        "end": 5452
      },
      "text": "བྱ་བ་ ༼པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 5660,
        "end": 5692
      },
      "text": "ས་གཅིག་ཏུ་མ་བྱེད་ཡང་ན་ག་ཤི་ག་དུ་ ༼པེ།༽ ས་ཞིག་"
    },
    {
      "span": {
        "start": 5890,
        "end": 5897
      },
      "text": "རྩོལ་བ་ ༼སྣར།༽ རྩོལ་བར་མྱེད་པ་དང་སེམས་ཁྲལ་"
    },
    {
      "span": {
        "start": 6045,
        "end": 6052
      },
      "text": "འོང་ངོ་ ༼པེ།༽ འོང་"
    },
    {
      "span": {
        "start": 6074,
        "end": 6083
      },
      "text": "གཟུང་ཞིག་ ༼པེ།༽ ཟུང་ཤིག་"
    },
    {
      "span": {
        "start": 6175,
        "end": 6180
      },
      "text": "མཆོག་ ༼པེ།༽ ཆོག་"
    },
    {
      "span": {
        "start": 6263,
        "end": 6265
      },
      "text": "ན་ ༼པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 6806,
        "end": 6811
      },
      "text": "གྲུབ་ ༼སྣར།༽ འགྲུབ་"
    },
    {
      "span": {
        "start": 6932,
        "end": 6936
      },
      "text": "བྱས་ ༼སྣར།༽ བྱས་ནས་"
    },
    {
      "span": {
        "start": 7228,
        "end": 7238
      },
      "text": "གང་ཞིག་གི་ ༼པེ།༽ གང་ཞིག་གིས་"
    },
    {
      "span": {
        "start": 7259,
        "end": 7269
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 7355,
        "end": 7364
      },
      "text": "དགོས་པའི་ ༼པེ།༽ དགོས་"
    },
    {
      "span": {
        "start": 7434,
        "end": 7440
      },
      "text": "ནད་དམ་ ༼སྣར།༽ ནད་"
    },
    {
      "span": {
        "start": 7440,
        "end": 7444
      },
      "text": "དུམ་ ༼སྣར།༽ དུམ་བ་"
    },
    {
      "span": {
        "start": 7487,
        "end": 7495
      },
      "text": "དོན་ཅིང་ ༼སྣར།༽ དོན་ཅུང་"
    },
    {
      "span": {
        "start": 7538,
        "end": 7548
      },
      "text": "སྡུག་བསྔལ་ ༼སྣར།༽ སྡུག་"
    },
    {
      "span": {
        "start": 7557,
        "end": 7567
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 7714,
        "end": 7739
      },
      "text": "བསྒྲུབས་ཞིག་བསྒྲུབས་པ་ཐད་ ༼པེ།༽ བསྒྲུབས་"
    },
    {
      "span": {
        "start": 8286,
        "end": 8290
      },
      "text": "ཡིན་ ༼པེ།༽ ཡིན་ན་"
    },
    {
      "span": {
        "start": 8422,
        "end": 8425
      },
      "text": "ནི་ ༼སྣར།༽ འདི་"
    },
    {
      "span": {
        "start": 8432,
        "end": 8442
      },
      "text": "དཀའ་ལས་ཆེ་ ༼པེ།༽ དཀའ་"
    },
    {
      "span": {
        "start": 8747,
        "end": 8756
      },
      "text": "ཁྱོད་ཀྱི་ ༼པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 8810,
        "end": 8815
      },
      "text": "བསམས་ ༼པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 8867,
        "end": 8877
      },
      "text": "དོན་འགྲུབ་ ༼པེ།༽ དོན་གྲུབ་"
    },
    {
      "span": {
        "start": 8974,
        "end": 8976
      },
      "text": "ལ་ ༼སྣར།༽ ལ་མ་"
    },
    {
      "span": {
        "start": 9007,
        "end": 9012
      },
      "text": "གཏོང་ ༼སྣར།༽ མི་འགྲོ་"
    },
    {
      "span": {
        "start": 9095,
        "end": 9100
      },
      "text": "འཇུག་ ༼པེ།༽ ཞུས་"
    },
    {
      "span": {
        "start": 9323,
        "end": 9332
      },
      "text": "བྱུང་ནའང་ ༼པེ།༽ བྱུང་ནས་"
    },
    {
      "span": {
        "start": 9448,
        "end": 9457
      },
      "text": "དུས་ཀྱིས་ ༼སྣར།༽ དུས་ཀྱི་"
    },
    {
      "span": {
        "start": 9519,
        "end": 9564
      },
      "text": "རྒྱས་ཕྱིད་ཀྱི་ཡོན་ཏན་ཕུན་ཚོགས་སྐྱེ་རྒྱལ་ཞིང་། ༼པེ།༽ རྒྱས་ཤིང་།"
    },
    {
      "span": {
        "start": 9673,
        "end": 9680
      },
      "text": "དགྲ་དང་ ༼པེ།༽ དགྲ་ཡང་"
    },
    {
      "span": {
        "start": 9698,
        "end": 9703
      },
      "text": "གེགས་ ༼པེ།༽ བགེགས་"
    },
    {
      "span": {
        "start": 10575,
        "end": 10577
      },
      "text": "ཝ་ ༼པེ།༽ ད་"
    },
    {
      "span": {
        "start": 10754,
        "end": 10759
      },
      "text": "གྱིས་ ༼སྣར།༽ གྱིས་བྱེད་ཀྱིན་"
    },
    {
      "span": {
        "start": 10832,
        "end": 10837
      },
      "text": "རྣམས་ ༼སྣར།༽ རྣམས་བདེན་རྫུན་"
    },
    {
      "span": {
        "start": 10993,
        "end": 11001
      },
      "text": "གཞན་གྱི་ ༼པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 11038,
        "end": 11043
      },
      "text": "མཐུས་ ༼སྣར།༽ མཐུ་ལས་"
    },
    {
      "span": {
        "start": 11334,
        "end": 11338
      },
      "text": "མེད་ ༼སྣར།༽ བྱེད་"
    },
    {
      "span": {
        "start": 11613,
        "end": 11622
      },
      "text": "འོ་ནའང་ཡ་ ༼པེ།༽ འོ་ནའང་"
    },
    {
      "span": {
        "start": 11626,
        "end": 11629
      },
      "text": "ཏུ་ ༼པེ།༽ ཏུ་ཁོ་"
    },
    {
      "span": {
        "start": 11723,
        "end": 11729
      },
      "text": "ནོར་ལ་ ༼པེ།༽ ནོར་མི་"
    },
    {
      "span": {
        "start": 11886,
        "end": 11891
      },
      "text": "བྱ་བ་ ༼པེ།༽ བྱ་བའི་ལས་"
    },
    {
      "span": {
        "start": 12080,
        "end": 12086
      },
      "text": "གདའ་བ་ ༼པེ།༽ གདའ་"
    },
    {
      "span": {
        "start": 12256,
        "end": 12264
      },
      "text": "སྡོང་རས་ ༼པེ།༽ སྡོངས་རངས་"
    },
    {
      "span": {
        "start": 12293,
        "end": 12302
      },
      "text": "མར་མེ་མི་ ༼པེ།༽ མར་མེའི་མེ་"
    },
    {
      "span": {
        "start": 12308,
        "end": 12316
      },
      "text": "བཞིན་ཏེ། ༼པེ།༽ བཞིན་ཏོ།"
    },
    {
      "span": {
        "start": 12325,
        "end": 12332
      },
      "text": "བསྐྱེད་ ༼སྣར།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 12744,
        "end": 12755
      },
      "text": "འབྱུང་བས་ན་ ༼པེ།༽ འབྱུང་ངན་"
    },
    {
      "span": {
        "start": 12831,
        "end": 12837
      },
      "text": "བསམ་པ་ ༼སྣར།༽ བསམས་པ་"
    },
    {
      "span": {
        "start": 12878,
        "end": 12883
      },
      "text": "འདུག་ ༼པེ།༽ འཇུག་"
    },
    {
      "span": {
        "start": 13206,
        "end": 13209
      },
      "text": "ཡང་ ༼སྣར།༽ ཡང་བཟང་པོར་"
    },
    {
      "span": {
        "start": 13229,
        "end": 13237
      },
      "text": "ཡིད་ཀྱི་ ༼པེ།༽ ཡིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 13307,
        "end": 13312
      },
      "text": "འབྲས་ ༼སྣར།༽ འབྲས་བུའི་"
    },
    {
      "span": {
        "start": 13336,
        "end": 13340
      },
      "text": "ཐོབ་ ༼པེ།༽ འགྲུབ་"
    },
    {
      "span": {
        "start": 13374,
        "end": 13378
      },
      "text": "གཞན་ ༼སྣར།༽ གཞན་ཞིག་"
    },
    {
      "span": {
        "start": 13386,
        "end": 13391
      },
      "text": "དགོས་ ༼པེ།༽ འདོད་"
    },
    {
      "span": {
        "start": 13437,
        "end": 13445
      },
      "text": "འཁོར་དང་ ༼པེ།༽ འཁོར་དུ་"
    },
    {
      "span": {
        "start": 13508,
        "end": 13517
      },
      "text": "སྟོན་པའང་ ༼པེ།༽ ཉོན་མོངས་པ་ཡང་"
    },
    {
      "span": {
        "start": 13774,
        "end": 13787
      },
      "text": "ཁྱོད་གང་འདྲི་ ༼པེ།༽ ཁྱོད་འདྲ་"
    },
    {
      "span": {
        "start": 13836,
        "end": 13840
      },
      "text": "འདྲ་ ༼པེ།༽ འདྲ་སྟེ་"
    },
    {
      "span": {
        "start": 13940,
        "end": 13961
      },
      "text": "དོན་འདི་ནི་འགྲུབ་དོན་ ༼པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 14163,
        "end": 14166
      },
      "text": "དེ་ ༼སྣར།༽ དོན་འདི་"
    },
    {
      "span": {
        "start": 14461,
        "end": 14482
      },
      "text": "བཀྲ་ཤིས་པར་གྱུར་ཅིག ། ༼སྣར།༽ བཀྲ་ཤིས་པརའགྱུར། །"
    },
    {
      "span": {
        "start": 14550,
        "end": 14561
      },
      "text": "ཡོད་པས་གསང་ ༼པེ།༽ ཡོད་པ་བསམས་"
    },
    {
      "span": {
        "start": 14600,
        "end": 14612
      },
      "text": "དགེ་བས་དརྒྲ་ ༼པེ།༽ དགེ་བས་"
    },
    {
      "span": {
        "start": 14703,
        "end": 14716
      },
      "text": "བློ་ཐུབ་ཀྱིན་ ༼པེ།༽ བློ་ཐུབ་ཀྱིས་"
    },
    {
      "span": {
        "start": 14731,
        "end": 14744
      },
      "text": "སེམས་དང་གྲོས་ ༼སྣར།༽ སེམས་དུང་"
    },
    {
      "span": {
        "start": 14824,
        "end": 14856
      },
      "text": "ནི་རྐྱང་བར་འགྲུབ་པ་ནི་དཀར་སྦྱིན་ ༼པེ།༽ ནི་སྐྱངས་པར་དགའ་བྱིན་"
    },
    {
      "span": {
        "start": 14936,
        "end": 14939
      },
      "text": "ནི་ ༼སྣར།༽ ལ་"
    },
    {
      "span": {
        "start": 15093,
        "end": 15098
      },
      "text": "ལག་པ་ ༼སྣར།༽ ལས་པ་"
    },
    {
      "span": {
        "start": 15135,
        "end": 15143
      },
      "text": "བཅད་དྲག་ ༼པེ།༽ བཅད་ནས་"
    },
    {
      "span": {
        "start": 15465,
        "end": 15473
      },
      "text": "དགྲ་བོས་ ༼པེ།༽ དགྲ་བོ་"
    },
    {
      "span": {
        "start": 15530,
        "end": 15538
      },
      "text": "བདག་ཉིད་ ༼སྣར།༽ བདག་ཉིད་དུ་"
    },
    {
      "span": {
        "start": 15544,
        "end": 15559
      },
      "text": "དེ་ཡིས་མྱུར་དུ་ ༼པེ།༽ དེ་ཡིས་"
    },
    {
      "span": {
        "start": 15814,
        "end": 15822
      },
      "text": "ངེས་པའི་ ༼སྣར།༽ ངེས་པར་"
    },
    {
      "span": {
        "start": 16077,
        "end": 16083
      },
      "text": "ཅི་ཡང་ ༼སྣར།༽ ཅི་ལ་"
    },
    {
      "span": {
        "start": 16393,
        "end": 16400
      },
      "text": "ཡངས་པས་ ༼སྣར།༽ བླངས་པས་"
    },
    {
      "span": {
        "start": 16519,
        "end": 16522
      },
      "text": "ངན་ ༼པེ།༽ མངོན་"
    },
    {
      "span": {
        "start": 16554,
        "end": 16561
      },
      "text": "བ་བཞིན་ ༼སྣར།༽ བཞིན་བྱེད་"
    },
    {
      "span": {
        "start": 16564,
        "end": 16568
      },
      "text": "དགའ་ ༼སྣར།༽ གདའ་"
    }
  ]
}