{
  "durchens": [
    {
      "span": {
        "start": 839,
        "end": 846
      },
      "text": "སྡོམ་པ་ ༼སྣར། པེ།༽ བསྡམས་པ་"
    },
    {
      "span": {
        "start": 873,
        "end": 878
      },
      "text": "སྤྱད་ ༼སྣར། པེ།༽ སྤྱོད་"
    },
    {
      "span": {
        "start": 1166,
        "end": 1174
      },
      "text": "མཁྱེན་པ་ ༼སྣར། པེ།༽ མཁྱེན་པར་"
    },
    {
      "span": {
        "start": 1323,
        "end": 1330
      },
      "text": "མེད་པར། ༼སྣར།༽ མེད་པ།"
    },
    {
      "span": {
        "start": 1516,
        "end": 1523
      },
      "text": "དེས་ནི་ ༼སྣར། པེ།༽ དེས་ན་"
    },
    {
      "span": {
        "start": 1816,
        "end": 1826
      },
      "text": "འདོད་པ་ཡི། ༼སྣར། པེ།༽ འདོད་པ་ཡིས།"
    },
    {
      "span": {
        "start": 2141,
        "end": 2146
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 2182,
        "end": 2192
      },
      "text": "ཤེས་རབ་ཏེ། ༼སྣར། པེ།༽ ཤེས་རབ་སྟེ།"
    },
    {
      "span": {
        "start": 2477,
        "end": 2482
      },
      "text": "སེམས་ ༼སྣར། པེ།༽ སེམས་ལས་"
    },
    {
      "span": {
        "start": 3248,
        "end": 3252
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 4163,
        "end": 4165
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 4206,
        "end": 4215
      },
      "text": "སྨན་གྱིས་ ༼སྣར། པེ།༽ སྨན་གྱི་"
    },
    {
      "span": {
        "start": 4280,
        "end": 4287
      },
      "text": "ཆོས་དེ་ ༼སྣར། པེ།༽ ཆོས་"
    },
    {
      "span": {
        "start": 4291,
        "end": 4296
      },
      "text": "ཀྱིས་ ༼སྣར། པེ།༽ ཀྱིས་ནི་"
    },
    {
      "span": {
        "start": 4384,
        "end": 4390
      },
      "text": "བརྗོད་ ༼སྣར། པེ།༽ རྗོད་"
    },
    {
      "span": {
        "start": 4399,
        "end": 4411
      },
      "text": "དེ་ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ དེ་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 4588,
        "end": 4598
      },
      "text": "སྲུན་གདུག་ ༼སྣར། པེ།༽ སུན་འདུག་"
    },
    {
      "span": {
        "start": 4924,
        "end": 4930
      },
      "text": "མྱོང་། ༼སྣར། པེ།༽ མྱང་།"
    },
    {
      "span": {
        "start": 4965,
        "end": 4972
      },
      "text": "སྟུག་པ་ ༼སྣར། པེ།༽ སྟུག་པོ་"
    },
    {
      "span": {
        "start": 5400,
        "end": 5408
      },
      "text": "རྟོག་པས་ ༼སྣར། པེ།༽ རྟོགས་པས་"
    },
    {
      "span": {
        "start": 5408,
        "end": 5416
      },
      "text": "བརྟགས་པ་ ༼སྣར། པེ།༽ རྟགས་པ་"
    },
    {
      "span": {
        "start": 5502,
        "end": 5507
      },
      "text": "སྤྱད། ༼སྣར། པེ།༽ དཔྱད།"
    },
    {
      "span": {
        "start": 5653,
        "end": 5661
      },
      "text": "བཀླག་པར་ ༼སྣར། པེ།༽ ཀླག་པ་"
    },
    {
      "span": {
        "start": 5718,
        "end": 5723
      },
      "text": "བཀླག་ ༼སྣར། པེ།༽ ཀླག་"
    },
    {
      "span": {
        "start": 5737,
        "end": 5745
      },
      "text": "འདུད་པར་ ༼སྣར། པེ།༽ གདུད་པར་"
    },
    {
      "span": {
        "start": 6713,
        "end": 6724
      },
      "text": "དང་འཇོན་མོ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 6869,
        "end": 6872
      },
      "text": "ཟག་ ༼སྣར། པེ།༽ ཟད་"
    },
    {
      "span": {
        "start": 7402,
        "end": 7413
      },
      "text": "བྱུང་བ་སྟེ། ༼སྣར། པེ།༽ བྱུང་བས་ཏེ།"
    }
  ]
}