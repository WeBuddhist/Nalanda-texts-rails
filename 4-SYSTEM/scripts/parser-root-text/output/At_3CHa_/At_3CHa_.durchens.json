{
  "durchens": [
    {
      "span": {
        "start": 277,
        "end": 282
      },
      "text": "གླུད་ ༼སྣར། པེ།༽ བླུད་"
    },
    {
      "span": {
        "start": 416,
        "end": 422
      },
      "text": "དྲང་བ་ ༼སྣར། པེ།༽ དྲངས་པ་"
    },
    {
      "span": {
        "start": 448,
        "end": 453
      },
      "text": "སྟེང་ ༼སྣར། པེ།༽ སྟེངས་པ་"
    },
    {
      "span": {
        "start": 492,
        "end": 500
      },
      "text": "དྲལ་ཤུལ་ ༼སྣར། པེ།༽ དྲག་ཤུལ་"
    },
    {
      "span": {
        "start": 545,
        "end": 551
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 782,
        "end": 788
      },
      "text": "བརྫེས་ ༼སྣར། པེ།༽ རྗེས་"
    },
    {
      "span": {
        "start": 926,
        "end": 931
      },
      "text": "དབུལ། ༼སྣར། པེ།༽ འབུལ།"
    },
    {
      "span": {
        "start": 1223,
        "end": 1232
      },
      "text": "སྒྲོགས། ། ༼སྣར། པེ།༽ སྒྲོག །"
    },
    {
      "span": {
        "start": 1436,
        "end": 1444
      },
      "text": "གཡས་པའི་ ༼སྣར། པེ།༽ གཡས་པ་"
    },
    {
      "span": {
        "start": 1807,
        "end": 1815
      },
      "text": "དབང་ཆེན་ ༼སྣར། པེ།༽ དབང་ཅན་"
    },
    {
      "span": {
        "start": 2011,
        "end": 2015
      },
      "text": "གནན་ ༼སྣར། པེ།༽ མནན་"
    },
    {
      "span": {
        "start": 2094,
        "end": 2103
      },
      "text": "བསྟོད་དེ་ ༼སྣར། པེ།༽ བསྟོད་པ་"
    },
    {
      "span": {
        "start": 2204,
        "end": 2209
      },
      "text": "གདངས་ ༼སྣར། པེ།༽ གདེངས་"
    },
    {
      "span": {
        "start": 2308,
        "end": 2317
      },
      "text": "བརྒྱད་པོ་ ༼སྣར། པེ།༽ བརྒྱད་པ་"
    },
    {
      "span": {
        "start": 2388,
        "end": 2395
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་དང་"
    }
  ]
}