{
  "durchens": [
    {
      "span": {
        "start": 320,
        "end": 326
      },
      "text": "བསྐོར། ༼སྣར། པེ།༽ བསྐོརབ།"
    },
    {
      "span": {
        "start": 422,
        "end": 440
      },
      "text": "ལ་གི་ཝང་གིས་མཚན་མ་ ༼སྣར། པེ།༽ ལ་གྷི་ཧཾ་གི་མཚན་"
    },
    {
      "span": {
        "start": 505,
        "end": 514
      },
      "text": "དཀར་གྱིས་ ༼སྣར། པེ།༽ དཀར་གྱི་"
    },
    {
      "span": {
        "start": 573,
        "end": 575
      },
      "text": "བ་ ༼སྣར། པེ།༽ བཱ་"
    },
    {
      "span": {
        "start": 664,
        "end": 671
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 752,
        "end": 761
      },
      "text": "བཟླས་པའི་ ༼སྣར། པེ།༽ བཟླས་པས་"
    },
    {
      "span": {
        "start": 1195,
        "end": 1204
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་དཔའ་ཅི་"
    },
    {
      "span": {
        "start": 1223,
        "end": 1232
      },
      "text": "བསྐྱེད་ལ་ ༼སྣར། པེ།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 1323,
        "end": 1330
      },
      "text": "བརྗེ་བ་ ༼སྣར། པེ།༽ རྗེ་བ་"
    },
    {
      "span": {
        "start": 1439,
        "end": 1444
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 1461,
        "end": 1471
      },
      "text": "དམ་ཚིག་དང་ ༼སྣར། པེ།༽ དམ་ཚིག་"
    },
    {
      "span": {
        "start": 1543,
        "end": 1548
      },
      "text": "བཀླག་ ༼སྣར། པེ།༽ ཀླག་"
    },
    {
      "span": {
        "start": 1581,
        "end": 1588
      },
      "text": "དབྱུང་། ༼སྣར། པེ།༽ འབྱུང་།"
    },
    {
      "span": {
        "start": 1687,
        "end": 1692
      },
      "text": "བརྗེ། ༼སྣར། པེ།༽ རྗེ།"
    }
  ]
}