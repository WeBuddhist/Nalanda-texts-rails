{
  "durchens": [
    {
      "span": {
        "start": 75,
        "end": 85
      },
      "text": "སྒྲུབ་པའི་ ༼སྣར།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 95,
        "end": 105
      },
      "text": "རིགས་བྱེད་ ༼སྣར།༽ རིག་བྱེད་"
    },
    {
      "span": {
        "start": 153,
        "end": 163
      },
      "text": "རིགས་བྱེད་ ༼སྣར།༽ རིག་བྱེད་"
    },
    {
      "span": {
        "start": 167,
        "end": 176
      },
      "text": "གཟུགས་སུ་ ༼སྣར།༽ གཟུགས་"
    },
    {
      "span": {
        "start": 203,
        "end": 216
      },
      "text": "དུ་བྱ་བ་བརྩམ་ ༼སྣར།༽ དུ་བརྩམས་"
    },
    {
      "span": {
        "start": 404,
        "end": 435
      },
      "text": "ལ་སོགས་པས་སྡིག་པ་བཤགས་པ་ལ་སོགས་ ༼སྣར།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 451,
        "end": 459
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 582,
        "end": 592
      },
      "text": "རིགས་བྱེད་ ༼སྣར། པེ།༽ རིག་བྱེད་"
    },
    {
      "span": {
        "start": 789,
        "end": 796
      },
      "text": "ཅན་གྱི་ ༼སྣར།༽ ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 800,
        "end": 812
      },
      "text": "པར་བསྒོམ་པར་ ༼སྣར།༽ པར་"
    },
    {
      "span": {
        "start": 862,
        "end": 866
      },
      "text": "ཕྱི་ ༼སྣར།༽ ཕྱིན་"
    },
    {
      "span": {
        "start": 934,
        "end": 944
      },
      "text": "རིགས་བྱེད་ ༼པེ།༽ རིག་བྱེད་"
    }
  ]
}