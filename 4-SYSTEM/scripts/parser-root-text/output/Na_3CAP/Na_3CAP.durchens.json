{
  "durchens": [
    {
      "span": {
        "start": 241,
        "end": 251
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ སྒོམ་པའི་"
    },
    {
      "span": {
        "start": 723,
        "end": 731
      },
      "text": "བརྟེན་པ་ ༼སྣར། པེ།༽ བསྟེན་པ་"
    },
    {
      "span": {
        "start": 861,
        "end": 870
      },
      "text": "བསྒོམ་པར་ ༼སྣར། པེ།༽ སྒོམ་"
    },
    {
      "span": {
        "start": 1507,
        "end": 1512
      },
      "text": "རྒྱན་ ༼སྣར།༽ བརྒྱན་"
    },
    {
      "span": {
        "start": 1620,
        "end": 1627
      },
      "text": "ཁུང་བུ་ ༼སྣར། པེ།༽ ཁུང་"
    },
    {
      "span": {
        "start": 1699,
        "end": 1709
      },
      "text": "བསྒོམ་པ་ལ་ ༼སྣར། པེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 1835,
        "end": 1843
      },
      "text": "བསམས་ནས། ༼སྣར། པེ།༽ བསམས་ལ།"
    },
    {
      "span": {
        "start": 1948,
        "end": 1953
      },
      "text": "འདིས་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 2490,
        "end": 2500
      },
      "text": "ཚོགས་ཀྱིས་ ༼སྣར། པེ།༽ ཐུགས་ནི་"
    },
    {
      "span": {
        "start": 2560,
        "end": 2568
      },
      "text": "མངོན་དུ་ ༼སྣར། པེ།༽ མངོན་སུམ་"
    },
    {
      "span": {
        "start": 2623,
        "end": 2629
      },
      "text": "སྒྲུབ་ ༼སྣར།༽ གྲུབ་"
    }
  ]
}