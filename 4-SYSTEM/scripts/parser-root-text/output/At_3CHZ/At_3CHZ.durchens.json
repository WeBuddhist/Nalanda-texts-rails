{
  "durchens": [
    {
      "span": {
        "start": 216,
        "end": 225
      },
      "text": "གང་བ་ཅིག་ ༼སྣར། པེ།༽ གང་བ་གཅིག་"
    },
    {
      "span": {
        "start": 283,
        "end": 289
      },
      "text": "མཐའ་མ་ ༼སྣར། པེ།༽ ཐ་མ་"
    },
    {
      "span": {
        "start": 352,
        "end": 355
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 468,
        "end": 473
      },
      "text": "རྙེད་ ༼སྣར། པེ།༽ རྙེད་པ་"
    },
    {
      "span": {
        "start": 620,
        "end": 624
      },
      "text": "དུག་ ༼སྣར། པེ།༽ དུར་"
    },
    {
      "span": {
        "start": 691,
        "end": 698
      },
      "text": "བསྒྲིལ་ ༼སྣར། པེ།༽ སྒྲིལ་"
    },
    {
      "span": {
        "start": 762,
        "end": 772
      },
      "text": "གཏིག་གོ། ། ༼སྣར། པེ།༽ བཏིག །"
    },
    {
      "span": {
        "start": 805,
        "end": 809
      },
      "text": "དང་། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 810,
        "end": 828
      },
      "text": "ཡུངས་ཀར་དང་། ཡུངས་ ༼སྣར། པེ།༽ ཡུངས་"
    },
    {
      "span": {
        "start": 966,
        "end": 970
      },
      "text": "གདབ་ ༼སྣར། པེ།༽ བཏབ་"
    },
    {
      "span": {
        "start": 1274,
        "end": 1279
      },
      "text": "དམངས་ ༼སྣར། པེ།༽ རྨང་"
    },
    {
      "span": {
        "start": 1306,
        "end": 1313
      },
      "text": "གདོལ་པ་ ༼སྣར། པེ།༽ རྡོལ་པ་"
    },
    {
      "span": {
        "start": 1337,
        "end": 1342
      },
      "text": "གླུད་ ༼སྣར། པེ།༽ བླུད་"
    },
    {
      "span": {
        "start": 1362,
        "end": 1367
      },
      "text": "གཏོང་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 1373,
        "end": 1387
      },
      "text": "བསྒྲུབ་བྱ་ཀླུ་ ༼སྣར། པེ།༽ བསྒྲུབ་བྱ་"
    }
  ]
}