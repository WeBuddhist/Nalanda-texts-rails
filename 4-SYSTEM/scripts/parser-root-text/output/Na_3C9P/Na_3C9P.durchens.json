{
  "durchens": [
    {
      "span": {
        "start": 116,
        "end": 127
      },
      "text": "པ་ཞེས་བྱ་བ། ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 181,
        "end": 194
      },
      "text": "འཇིགས་བྱེད་པ། ༼སྣར། པེ།༽ འཇིགས་བྱེད་པས།"
    },
    {
      "span": {
        "start": 285,
        "end": 290
      },
      "text": "བརྙས་ ༼སྣར། པེ།༽ རྙས་"
    },
    {
      "span": {
        "start": 344,
        "end": 350
      },
      "text": "བསྒྲལ་ ༼སྣར། པེ།༽ སྒྲལ་"
    },
    {
      "span": {
        "start": 444,
        "end": 452
      },
      "text": "རིའམ་ཚང་ ༼སྣར། པེ།༽ མ་ཚང་"
    },
    {
      "span": {
        "start": 460,
        "end": 466
      },
      "text": "དག་གམ། ༼སྣར།༽ དག་གིསགིས ༼པེ།༽ གི།"
    },
    {
      "span": {
        "start": 1028,
        "end": 1033
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 1035,
        "end": 1039
      },
      "text": "ལུས་ ༼སྣར། པེ།༽ འདུས་"
    },
    {
      "span": {
        "start": 1064,
        "end": 1070
      },
      "text": "རྡེབས་ ༼སྣར། པེ།༽ རྡེབ་"
    },
    {
      "span": {
        "start": 1355,
        "end": 1362
      },
      "text": "པགས་པས་ ༼སྣར།༽ པགས་པ་"
    },
    {
      "span": {
        "start": 1647,
        "end": 1655
      },
      "text": "དྲངས་ཏེ། ༼སྣར། པེ།༽ དྲང་སྟེ།"
    },
    {
      "span": {
        "start": 1782,
        "end": 1788
      },
      "text": "ནག་པོ་ ༼སྣར། པེ།༽ ན་ག་"
    },
    {
      "span": {
        "start": 1831,
        "end": 1837
      },
      "text": "ཀླད་པ་ ༼སྣར། པེ།༽ གླ་བ་"
    },
    {
      "span": {
        "start": 1961,
        "end": 1969
      },
      "text": "མེ་སོགས་ ༼སྣར། པེ།༽ མེ་ཏོག་"
    },
    {
      "span": {
        "start": 2044,
        "end": 2047
      },
      "text": "དང་ ༼སྣར། པེ།༽ ཧྲི་དང་"
    },
    {
      "span": {
        "start": 2082,
        "end": 2086
      },
      "text": "བྱས། ༼སྣར། པེ།༽ བྱ།"
    },
    {
      "span": {
        "start": 2402,
        "end": 2443
      },
      "text": "གདུག་པ་ཅན། །ཚར་གཅོད་བྱང་ཆུབ་སེམས་དཔའ་སྟེ། ༼སྣར། པེ།༽ གདུག་པ་ཅན།"
    },
    {
      "span": {
        "start": 2466,
        "end": 2471
      },
      "text": "འཇིག་ ༼སྣར། པེ།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 2490,
        "end": 2495
      },
      "text": "ཁྱེད་ ༼སྣར། པེ།༽ ཁྱོད་"
    },
    {
      "span": {
        "start": 2617,
        "end": 2624
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབས་"
    },
    {
      "span": {
        "start": 3180,
        "end": 3186
      },
      "text": "གཏུབས་ ༼སྣར། པེ།༽ བཏུབས་"
    },
    {
      "span": {
        "start": 3298,
        "end": 3306
      },
      "text": "གསད་པའི་ ༼སྣར། པེ།༽ གསང་བའི་"
    },
    {
      "span": {
        "start": 3424,
        "end": 3429
      },
      "text": "མདུང་ ༼སྣར།༽ གདུང་"
    },
    {
      "span": {
        "start": 3594,
        "end": 3600
      },
      "text": "སྦྲུས་ ༼སྣར། པེ།༽ བྲུས་"
    },
    {
      "span": {
        "start": 3770,
        "end": 3777
      },
      "text": "བྲི་བར་ ༼སྣར། པེ།༽ བྲིས་པར་"
    },
    {
      "span": {
        "start": 3804,
        "end": 3808
      },
      "text": "བྲི། ༼སྣར། པེ།༽ བྲིས།"
    },
    {
      "span": {
        "start": 4000,
        "end": 4005
      },
      "text": "གཙུག་ ༼སྣར། པེ།༽ རྩུག་"
    },
    {
      "span": {
        "start": 4019,
        "end": 4028
      },
      "text": "གསོད་པའི་ ༼སྣར། པེ།༽ གསེད་པའི་"
    },
    {
      "span": {
        "start": 4088,
        "end": 4093
      },
      "text": "མྱོས་ ༼སྣར།༽ སྙོས་ ༼པེ།༽ སྙོམ་"
    },
    {
      "span": {
        "start": 4468,
        "end": 4476
      },
      "text": "འགྱུར་བ་ ༼སྣར།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 4507,
        "end": 4521
      },
      "text": "གུར་ཀུམ་གི་ཝང་ ༼སྣར། པེ།༽ གུར་གུམ་གྷི་ཧང་"
    },
    {
      "span": {
        "start": 4539,
        "end": 4543
      },
      "text": "ཁྲག་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 4589,
        "end": 4597
      },
      "text": "སྤྲ་ཚིལ་ ༼སྣར། པེ།༽ པྲ་ཚིལ་"
    },
    {
      "span": {
        "start": 4633,
        "end": 4639
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 4669,
        "end": 4683
      },
      "text": "བརྒྱ་བྱིན་ཀྱང་ ༼སྣར། པེ།༽ བརྒྱ་བྱིན་ཡང་"
    },
    {
      "span": {
        "start": 4701,
        "end": 4706
      },
      "text": "ད་དུ་ ༼སྣར། པེ།༽ དྷ་དྷུ་"
    },
    {
      "span": {
        "start": 4732,
        "end": 4740
      },
      "text": "ཟོས་པའི་ ༼སྣར། པེ།༽ བྲོས་པའི་"
    },
    {
      "span": {
        "start": 4894,
        "end": 4899
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ རྟན་"
    },
    {
      "span": {
        "start": 5032,
        "end": 5037
      },
      "text": "སེམས་ ༼སྣར། པེ།༽ གི་སེམས་ལ་"
    },
    {
      "span": {
        "start": 5089,
        "end": 5095
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 5127,
        "end": 5133
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 5141,
        "end": 5147
      },
      "text": "དང་། ། ༼སྣར། པེ།༽ དག །"
    }
  ]
}