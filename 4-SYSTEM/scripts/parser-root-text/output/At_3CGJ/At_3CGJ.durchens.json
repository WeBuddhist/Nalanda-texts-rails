{
  "durchens": [
    {
      "span": {
        "start": 90,
        "end": 96
      },
      "text": "སྒྲུབ་ ༼སྣར།༽ སྒྲུབས་"
    },
    {
      "span": {
        "start": 218,
        "end": 237
      },
      "text": "སྙིང་རྗེའི་རྡོ་རྗེ་ ༼སྣར། པེ།༽ སྙིང་རྗེའི་"
    },
    {
      "span": {
        "start": 248,
        "end": 260
      },
      "text": "། །རྗེ་བཙུན་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 1542,
        "end": 1550
      },
      "text": "མཉེས་པས་ ༼སྣར།༽ མཉམས་ ༼པེ།༽ མཉམ་པས་"
    },
    {
      "span": {
        "start": 1562,
        "end": 1567
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 1582,
        "end": 1587
      },
      "text": "འཐོན། ༼སྣར། པེ།༽ ཐོན།"
    },
    {
      "span": {
        "start": 1643,
        "end": 1647
      },
      "text": "བསམ། ༼སྣར། པེ།༽ བསམས།"
    },
    {
      "span": {
        "start": 2258,
        "end": 2263
      },
      "text": "འདུན། ༼སྣར། པེ།༽ གདུང་།"
    },
    {
      "span": {
        "start": 2741,
        "end": 2747
      },
      "text": "བསྟོད། ༼སྣར། པེ།༽ ལོ།"
    },
    {
      "span": {
        "start": 2775,
        "end": 2782
      },
      "text": "ལས་ཀྱི་ ༼སྣར། པེ།༽ ལས་ཀྱིས་"
    },
    {
      "span": {
        "start": 2861,
        "end": 2867
      },
      "text": "བསྟོད། ༼སྣར། པེ།༽ ལོ།"
    },
    {
      "span": {
        "start": 2986,
        "end": 2992
      },
      "text": "བསྟོད། ༼སྣར། པེ།༽ ལོ།"
    },
    {
      "span": {
        "start": 3092,
        "end": 3098
      },
      "text": "བསྒོམ། ༼སྣར། པེ།༽ སྒོམ།"
    },
    {
      "span": {
        "start": 3180,
        "end": 3185
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 3209,
        "end": 3218
      },
      "text": "འགྲུབ་པར་ ༼སྣར། པེ།༽ གྲུབ་པར་"
    }
  ]
}