{
  "durchens": [
    {
      "span": {
        "start": 66,
        "end": 74
      },
      "text": "བསྒོམ་པ་ ༼སྣར། པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 215,
        "end": 224
      },
      "text": "བསྐྱེད་པ་ ༼པེ།༽ སྐྱེད་པ་"
    },
    {
      "span": {
        "start": 429,
        "end": 438
      },
      "text": "བསྐྱེད་པ་ ༼སྣར། པེ།༽ སྐྱེད་པ་"
    },
    {
      "span": {
        "start": 721,
        "end": 724
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 1040,
        "end": 1050
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 1092,
        "end": 1105
      },
      "text": "སྐུ་ལུས་ཀྱིས། ༼སྣར། པེ།༽ སྐུ་ལུས་ཀྱི།"
    },
    {
      "span": {
        "start": 1346,
        "end": 1353
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 1364,
        "end": 1376
      },
      "text": "དང་སེམས་ཀྱི་ ༼སྣར། པེ།༽ དང་སེམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 1543,
        "end": 1551
      },
      "text": "མཐོང་བར་ ༼སྣར།༽ མཐོ་བར་"
    },
    {
      "span": {
        "start": 1706,
        "end": 1714
      },
      "text": "འདོད་པས་ ༼སྣར། པེ།༽ འདོད་པ་"
    },
    {
      "span": {
        "start": 1854,
        "end": 1861
      },
      "text": "བྱ་སྟེ། ༼སྣར།༽ བྱས་ཏེ།"
    },
    {
      "span": {
        "start": 1875,
        "end": 1887
      },
      "text": "ལྷག་མཐོང་ནི་ ༼སྣར། པེ།༽ ལྷག་མཐོང་གི་"
    },
    {
      "span": {
        "start": 2048,
        "end": 2056
      },
      "text": "བསམས་པས་ ༼སྣར། པེ།༽ བསམ་པས་"
    },
    {
      "span": {
        "start": 2126,
        "end": 2138
      },
      "text": "བཅིངས་པས་དེ་ ༼སྣར། པེ།༽ བཅིངས་པ་དེས་"
    },
    {
      "span": {
        "start": 2141,
        "end": 2150
      },
      "text": "ལམ་ཁ་བྲག་ ༼སྣར། པེ།༽ ལམ་ཁ་དབྲག་"
    },
    {
      "span": {
        "start": 2167,
        "end": 2176
      },
      "text": "འགྲོན་པོ་ ༼སྣར། པེ།༽ འདྲོན་པོ་"
    },
    {
      "span": {
        "start": 2189,
        "end": 2195
      },
      "text": "ངེས་པ་ ༼སྣར། པེ།༽ ངེས་པར་"
    },
    {
      "span": {
        "start": 2234,
        "end": 2240
      },
      "text": "དེ་ནས་ ༼སྣར། པེ།༽ དེ་ནས་གནས་"
    },
    {
      "span": {
        "start": 2333,
        "end": 2338
      },
      "text": "མཆིལ་ ༼སྣར། པེ།༽ འཆིལ་ལམ་"
    },
    {
      "span": {
        "start": 2426,
        "end": 2439
      },
      "text": "དུས་གསུམ་གྱི་ ༼སྣར། པེ།༽ དང་དུས་སུམ་གྱིས་"
    },
    {
      "span": {
        "start": 2493,
        "end": 2500
      },
      "text": "བྱ་སྟེ། ༼སྣར། པེ།༽ བྱས་ཏེ།"
    },
    {
      "span": {
        "start": 2515,
        "end": 2520
      },
      "text": "ཀློད་ ༼སྣར། པེ།༽ གློད་"
    },
    {
      "span": {
        "start": 2590,
        "end": 2596
      },
      "text": "སྒུ་བ་ ༼སྣར། པེ།༽ དགུ་པ་"
    },
    {
      "span": {
        "start": 2741,
        "end": 2747
      },
      "text": "བཞུགས་ ༼སྣར། པེ།༽ ཞུགས་"
    },
    {
      "span": {
        "start": 2933,
        "end": 2940
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 2954,
        "end": 2962
      },
      "text": "བཞུགས་པ་ ༼པེ།༽ བཞུགས་པར་"
    },
    {
      "span": {
        "start": 2997,
        "end": 3007
      },
      "text": "ལ་སོགས་པར་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 3137,
        "end": 3145
      },
      "text": "བརྟགས་པ་ ༼པེ།༽ བརྟག་པ་"
    },
    {
      "span": {
        "start": 3484,
        "end": 3491
      },
      "text": "ངང་གིས་ ༼སྣར། པེ།༽ ངང་གི་"
    },
    {
      "span": {
        "start": 3563,
        "end": 3567
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 3612,
        "end": 3620
      },
      "text": "གཡེང་བར་ ༼སྣར། པེ།༽ ཡེངས་པར་"
    },
    {
      "span": {
        "start": 3651,
        "end": 3658
      },
      "text": "གཟུང་བ་ ༼སྣར། པེ།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 3670,
        "end": 3679
      },
      "text": "གཟུང་བའི་ ༼སྣར། པེ།༽ བཟུང་བའི་"
    },
    {
      "span": {
        "start": 3692,
        "end": 3698
      },
      "text": "ཕྲ་རབ་ ༼སྣར། པེ།༽ ཕྲ་རབ་རབ་"
    },
    {
      "span": {
        "start": 3779,
        "end": 3786
      },
      "text": "མེད་དོ། ༼སྣར། པེ།༽ མེད་དེ།"
    },
    {
      "span": {
        "start": 3800,
        "end": 3808
      },
      "text": "སྣང་བའི་ ༼སྣར། པེ།༽ རྟོག་པའི་"
    },
    {
      "span": {
        "start": 3818,
        "end": 3822
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 3950,
        "end": 3961
      },
      "text": "བྱ། གཡེང་བ་ ༼སྣར། པེ།༽ བྱའོ། །གཡེངས་པ་"
    },
    {
      "span": {
        "start": 3967,
        "end": 3970
      },
      "text": "པར་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 4013,
        "end": 4023
      },
      "text": "གཉིད་ཀྱིས་ ༼སྣར། པེ།༽ གཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 4295,
        "end": 4301
      },
      "text": "བྱས་ལ་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 4305,
        "end": 4307
      },
      "text": "མ་ ༼སྣར། པེ།༽ ལམ་"
    },
    {
      "span": {
        "start": 4313,
        "end": 4326
      },
      "text": "བཏང་སྙོམས་སུ་ ༼སྣར། པེ།༽ བཏང་སྙོམས་"
    },
    {
      "span": {
        "start": 4439,
        "end": 4449
      },
      "text": "དོན་དམ་པར་ ༼སྣར། པེ།༽ དོན་དམ་པ་"
    },
    {
      "span": {
        "start": 4455,
        "end": 4460
      },
      "text": "བ་ཡང་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 4527,
        "end": 4534
      },
      "text": "ཡོད་དོ་ ༼སྣར། པེ།༽ ཡོད་"
    },
    {
      "span": {
        "start": 4541,
        "end": 4546
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 4673,
        "end": 4677
      },
      "text": "རྟག་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 4800,
        "end": 4812
      },
      "text": "དྲུག་དག་གིས་ ༼སྣར། པེ།༽ དྲུག་"
    },
    {
      "span": {
        "start": 4887,
        "end": 4894
      },
      "text": "ཉམས་པར་ ༼སྣར། པེ།༽ མཉམ་པར་"
    },
    {
      "span": {
        "start": 4975,
        "end": 4981
      },
      "text": "བལྟའོ། ༼སྣར། པེ།༽ ལྟའོ།"
    },
    {
      "span": {
        "start": 5265,
        "end": 5273
      },
      "text": "བསྒྲུབས་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 5374,
        "end": 5382
      },
      "text": "བསྒོམ་པ་ ༼སྣར། པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 5550,
        "end": 5555
      },
      "text": "ཕབ་པ། ༼སྣར། པེ།༽ ཕབ་པོ།"
    }
  ]
}