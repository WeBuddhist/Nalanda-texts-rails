{
  "durchens": [
    {
      "span": {
        "start": 286,
        "end": 295
      },
      "text": "བརྒྱད་དང་ ༼སྣར།༽ བརྒྱད་པ་"
    },
    {
      "span": {
        "start": 665,
        "end": 671
      },
      "text": "ཁ་ཐོན་ ༼སྣར། པེ།༽ ཁ་ཏོན་"
    },
    {
      "span": {
        "start": 684,
        "end": 688
      },
      "text": "རྒྱ། ༼སྣར། པེ།༽ བརྒྱ།"
    },
    {
      "span": {
        "start": 791,
        "end": 796
      },
      "text": "དངོས་ ༼སྣར།༽ དངོས་ལ་"
    },
    {
      "span": {
        "start": 804,
        "end": 810
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 893,
        "end": 897
      },
      "text": "གསལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 912,
        "end": 919
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    }
  ]
}