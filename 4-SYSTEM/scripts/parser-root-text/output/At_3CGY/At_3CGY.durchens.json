{
  "durchens": [
    {
      "span": {
        "start": 65,
        "end": 71
      },
      "text": "སྲུངས་ ༼པེ།༽ སྲུང་"
    },
    {
      "span": {
        "start": 155,
        "end": 162
      },
      "text": "བསྟན་པ་ ༼པེ།༽ སྟན་པ་"
    },
    {
      "span": {
        "start": 610,
        "end": 619
      },
      "text": "བགྲང་བའི་ ༼པེ།༽ འགྲང་བའི་"
    },
    {
      "span": {
        "start": 1269,
        "end": 1278
      },
      "text": "སྟོགས་པར་ ༼པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 1616,
        "end": 1626
      },
      "text": "འདོད་ལྷའི་ ༼པེ།༽ འདོད་པ་"
    },
    {
      "span": {
        "start": 1768,
        "end": 1774
      },
      "text": "བསྐུར་ ༼པེ།༽ བཀུར་"
    },
    {
      "span": {
        "start": 1971,
        "end": 1977
      },
      "text": "དང་། ། ༼པེ།༽ ། །རྟགས་མཐོང་བའི་མངོན་ཤེས་བློ་སྒྱུར་ཏེ་"
    },
    {
      "span": {
        "start": 2003,
        "end": 2009
      },
      "text": "ཆེ་པོ་ ༼པེ།༽ ཆེ་པོ་བརྒྱ་འཆེ་"
    },
    {
      "span": {
        "start": 2039,
        "end": 2042
      },
      "text": "ཆེ་ ༼པེ།༽ ཆེ་ཟབ་པའི་སྡོད་ཡིན་"
    },
    {
      "span": {
        "start": 2211,
        "end": 2250
      },
      "text": "། །རྟགས་མཐོང་བའི་མངོན་ཤེས་བློ་སྒྱུར་ཏེ། ༼པེ།༽ ། །"
    },
    {
      "span": {
        "start": 2277,
        "end": 2285
      },
      "text": "རྗོད་དང་ ༼པེ།༽ རྗོད་"
    }
  ]
}