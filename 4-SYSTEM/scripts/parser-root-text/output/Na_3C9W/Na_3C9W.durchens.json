{
  "durchens": [
    {
      "span": {
        "start": 220,
        "end": 234
      },
      "text": "ལི་ཞེས་སྒྲོགས་ ༼སྣར། པེ།༽ ལི་ཞེས་"
    },
    {
      "span": {
        "start": 277,
        "end": 284
      },
      "text": "བཀླུབས་ ༼སྣར། པེ།༽ ཀླུབས་"
    },
    {
      "span": {
        "start": 370,
        "end": 374
      },
      "text": "ཕྱག་ ༼སྣར། པེ།༽ ཕྱག་བཅས་ཕྱག་"
    },
    {
      "span": {
        "start": 396,
        "end": 408
      },
      "text": "། །སྤྱན་དམར་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 439,
        "end": 443
      },
      "text": "གནས་ ༼སྣར། པེ།༽ གདན་"
    },
    {
      "span": {
        "start": 445,
        "end": 455
      },
      "text": "དགྱེས་པའི་ ༼སྣར། པེ།༽ སྐྱེས་པའི་"
    },
    {
      "span": {
        "start": 475,
        "end": 481
      },
      "text": "སྲུངས། ༼སྣར། པེ།༽ ཞིང་སྐྱོང་མཛོད།"
    },
    {
      "span": {
        "start": 525,
        "end": 536
      },
      "text": "བསྐྱོད་པའི་ ༼སྣར། པེ།༽ སྐྱེས་པ་"
    },
    {
      "span": {
        "start": 565,
        "end": 572
      },
      "text": "མགོ་བོ་ ༼སྣར། པེ།༽ མགོ་ཡི་"
    },
    {
      "span": {
        "start": 615,
        "end": 620
      },
      "text": "སྐུར་ ༼སྣར། པེ།༽ སྐུ་"
    },
    {
      "span": {
        "start": 663,
        "end": 672
      },
      "text": "གི་དང་པོ་ ༼སྣར། པེ།༽ གིས་བསད་པ་"
    },
    {
      "span": {
        "start": 677,
        "end": 682
      },
      "text": "ཀྱིས་ ༼སྣར། པེ།༽ ཀྱི་"
    },
    {
      "span": {
        "start": 685,
        "end": 689
      },
      "text": "མགོ་ ༼སྣར། པེ།༽ མགོའི་"
    },
    {
      "span": {
        "start": 715,
        "end": 720
      },
      "text": "བབ་པ་ ༼སྣར། པེ།༽ འབབ་པ་"
    },
    {
      "span": {
        "start": 744,
        "end": 751
      },
      "text": "ཞིང་མེ་ ༼སྣར། པེ།༽ ཅིང་མི་"
    },
    {
      "span": {
        "start": 819,
        "end": 828
      },
      "text": "བཟོད་པའི་ ༼སྣར། པེ།༽ བརྗོད་པའི་"
    },
    {
      "span": {
        "start": 871,
        "end": 880
      },
      "text": "བཟུང་སྟེ། ༼སྣར། པེ།༽ བཟུང་ཏེ།"
    },
    {
      "span": {
        "start": 890,
        "end": 895
      },
      "text": "གནོན་ ༼སྣར། པེ།༽ སྣོད་མནན་"
    },
    {
      "span": {
        "start": 899,
        "end": 908
      },
      "text": "མནན་ནས་ཀ་ ༼སྣར། པེ།༽ མནན་ནས་"
    },
    {
      "span": {
        "start": 941,
        "end": 947
      },
      "text": "ཡི་ནི་ ༼སྣར། པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 996,
        "end": 1000
      },
      "text": "ཙའི་ ༼སྣར། པེ།༽ ཙ་"
    },
    {
      "span": {
        "start": 1026,
        "end": 1032
      },
      "text": "སྲེག ། ༼སྣར། པེ།༽ བསྲེགས། །"
    },
    {
      "span": {
        "start": 1124,
        "end": 1133
      },
      "text": "དུས་རྣམས་ ༼སྣར། པེ།༽ དུས་"
    },
    {
      "span": {
        "start": 1191,
        "end": 1197
      },
      "text": "ཕྱུགས་ ༼སྣར། པེ།༽ ཕྱུག་"
    },
    {
      "span": {
        "start": 1202,
        "end": 1206
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱིས་"
    },
    {
      "span": {
        "start": 1209,
        "end": 1214
      },
      "text": "སྔགས་ ༼སྣར། པེ།༽ སྡིག་"
    },
    {
      "span": {
        "start": 1217,
        "end": 1223
      },
      "text": "བགེགས་ ༼པེ།༽ བགེག་"
    },
    {
      "span": {
        "start": 1247,
        "end": 1255
      },
      "text": "བརྙེས་པ་ ༼སྣར། པེ།༽ མཉེས་པ་"
    },
    {
      "span": {
        "start": 1364,
        "end": 1367
      },
      "text": "སྨ་ ༼སྣར། པེ།༽ རྨ་"
    },
    {
      "span": {
        "start": 1369,
        "end": 1377
      },
      "text": "སེར་ཞིང་ ༼སྣར། པེ།༽ ཆེར་སེར་"
    },
    {
      "span": {
        "start": 1413,
        "end": 1421
      },
      "text": "སྲུང་བར་ ༼སྣར། པེ།༽ བསྲུང་བར་"
    },
    {
      "span": {
        "start": 1471,
        "end": 1478
      },
      "text": "རྣམས་ལ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 1495,
        "end": 1500
      },
      "text": "དགེས། ༼སྣར། པེ།༽ དགྱེས།"
    },
    {
      "span": {
        "start": 1520,
        "end": 1524
      },
      "text": "དམར་ ༼སྣར། པེ།༽ ནམ་"
    },
    {
      "span": {
        "start": 1552,
        "end": 1558
      },
      "text": "བརྒྱན་ ༼སྣར།༽ རྒྱན་"
    },
    {
      "span": {
        "start": 1562,
        "end": 1567
      },
      "text": "གཏུམ་ ༼སྣར། པེ།༽ སྟུྃ་"
    },
    {
      "span": {
        "start": 1611,
        "end": 1616
      },
      "text": "གྱིས་ ༼སྣར། པེ།༽ ནི་བྱས་"
    },
    {
      "span": {
        "start": 1629,
        "end": 1633
      },
      "text": "ཅིང་ ༼སྣར། པེ།༽ མཛོད་ཅིག་"
    },
    {
      "span": {
        "start": 1644,
        "end": 1654
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 1699,
        "end": 1711
      },
      "text": "རྔམ་དང་གཏུམ་ ༼སྣར། པེ།༽ རྔམ་ཏུ་"
    },
    {
      "span": {
        "start": 1849,
        "end": 1857
      },
      "text": "ཕྲེང་བས་ ༼སྣར། པེ།༽ ཕྲེང་"
    },
    {
      "span": {
        "start": 1880,
        "end": 1884
      },
      "text": "མཐུ་ ༼སྣར། པེ།༽ མཆུ་"
    },
    {
      "span": {
        "start": 1940,
        "end": 1947
      },
      "text": "རྨད་དུ་ ༼སྣར། པེ།༽ རྨད་"
    },
    {
      "span": {
        "start": 1952,
        "end": 1955
      },
      "text": "བས་ ༼སྣར། པེ།༽ བའི་"
    },
    {
      "span": {
        "start": 1993,
        "end": 2002
      },
      "text": "ཚོགས་པའི་ ༼སྣར། པེ།༽ འཚོགས་པའི་"
    },
    {
      "span": {
        "start": 2002,
        "end": 2017
      },
      "text": "བདག་ཉིད་དམ་ཚིག་ ༼སྣར། པེ།༽ བདག་གི་དགྲ་"
    },
    {
      "span": {
        "start": 2071,
        "end": 2083
      },
      "text": "ཞེས་སྣ་ཚོགས་ ༼སྣར། པེ།༽ ཞེས་སྣོད་"
    },
    {
      "span": {
        "start": 2280,
        "end": 2287
      },
      "text": "ཁ་གདངས་ ༼སྣར། པེ།༽ ཁྭ་"
    },
    {
      "span": {
        "start": 2407,
        "end": 2418
      },
      "text": "གཟུགས་ཀྱིས་ ༼སྣར། པེ།༽ གཟུགས་ཀྱི་"
    },
    {
      "span": {
        "start": 2453,
        "end": 2458
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ པར་མཛད་"
    },
    {
      "span": {
        "start": 2524,
        "end": 2532
      },
      "text": "གདུལ་བྱ་ ༼པེ།༽ གདུལ་བ་"
    },
    {
      "span": {
        "start": 2572,
        "end": 2579
      },
      "text": "བློ་ཡི་ ༼སྣར། པེ།༽ བློ་ཡིས་"
    },
    {
      "span": {
        "start": 2636,
        "end": 2644
      },
      "text": "སྲུང་བར་ ༼སྣར། པེ།༽ སྐྱོང་བར་"
    },
    {
      "span": {
        "start": 2708,
        "end": 2716
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 2732,
        "end": 2763
      },
      "text": "བློ་ལྡན་དམ་ཚིག་ཐོས་འཛིན་གང་ཞིག་ ༼སྣར། པེ།༽ བློ་ལྡན་བདག་གིས་ཐོས་འཛིན་གཞི་"
    },
    {
      "span": {
        "start": 2785,
        "end": 2793
      },
      "text": "གཉིས་སུ་ ༼སྣར། པེ།༽ གསུམ་དུ་"
    },
    {
      "span": {
        "start": 2908,
        "end": 2920
      },
      "text": "རྣམས་རྟག་ཏུ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 2969,
        "end": 2975
      },
      "text": "སྟེངས་ ༼སྣར། པེ།༽ སྟོབས་"
    },
    {
      "span": {
        "start": 3040,
        "end": 3048
      },
      "text": "བསྟོད་པ་ ༼སྣར། པེ།༽ བསྟོད་པ་སྔགས་"
    },
    {
      "span": {
        "start": 3089,
        "end": 3104
      },
      "text": "ཀླུ་སྒྲུབ་ཀྱིས་ ༼པེ།༽ ཀླུ་སྒྲུབ་ཀྱི་"
    }
  ]
}