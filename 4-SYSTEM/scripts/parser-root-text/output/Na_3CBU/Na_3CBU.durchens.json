{
  "durchens": [
    {
      "span": {
        "start": 339,
        "end": 345
      },
      "text": "གཟུང་། ༼སྣར། པེ།༽ བཟུང་།"
    },
    {
      "span": {
        "start": 533,
        "end": 542
      },
      "text": "བགྱི་བའི་ ༼སྣར། པེ།༽ བགྱིས་པའི་"
    },
    {
      "span": {
        "start": 735,
        "end": 741
      },
      "text": "ཚོར་བ་ ༼སྣར། པེ།༽ འཚོ་བ་"
    },
    {
      "span": {
        "start": 792,
        "end": 796
      },
      "text": "རིན་ ༼སྣར།༽ རིག་"
    },
    {
      "span": {
        "start": 808,
        "end": 813
      },
      "text": "ཞིང་། ༼སྣར། པེ།༽ བཞིན།"
    },
    {
      "span": {
        "start": 912,
        "end": 920
      },
      "text": "གྱུར་པར་ ༼སྣར། པེ།༽ འགྱུར་བར་"
    },
    {
      "span": {
        "start": 1167,
        "end": 1170
      },
      "text": "བྱ། ༼སྣར། པེ།༽ བྱེད།"
    },
    {
      "span": {
        "start": 1319,
        "end": 1325
      },
      "text": "བརྒྱན་ ༼སྣར། པེ།༽ རྒྱན་"
    },
    {
      "span": {
        "start": 1332,
        "end": 1337
      },
      "text": "ཚོགས་ ༼སྣར། པེ།༽ མཆོག་"
    },
    {
      "span": {
        "start": 1349,
        "end": 1354
      },
      "text": "ཡོངས་ ༼སྣར།༽ འོངས་"
    },
    {
      "span": {
        "start": 1658,
        "end": 1662
      },
      "text": "བསལ་ ༼སྣར། པེ།༽ སལ་"
    },
    {
      "span": {
        "start": 1724,
        "end": 1735
      },
      "text": "སྐྱོ་བ་སྟེ། ༼སྣར། པེ།༽ སྐྱོ་བ་དེ།"
    },
    {
      "span": {
        "start": 1819,
        "end": 1826
      },
      "text": "མི་གཙང་ ༼སྣར། པེ།༽ མིང་ཙམ་"
    },
    {
      "span": {
        "start": 2028,
        "end": 2042
      },
      "text": "ཀུན་ན་སྐྱེ་བོ་ ༼སྣར།༽ ཀུན་སྐྱེས་པོ་"
    },
    {
      "span": {
        "start": 2053,
        "end": 2061
      },
      "text": "བྱེད་པར་ ༼སྣར། པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 2201,
        "end": 2213
      },
      "text": "ཐམས་ཅད་ཀྱིས། ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི།"
    },
    {
      "span": {
        "start": 2259,
        "end": 2269
      },
      "text": "སྲོག་བཞིན་ ༼སྣར། པེ།༽ སྲོག་སྦྱིན་"
    },
    {
      "span": {
        "start": 2542,
        "end": 2552
      },
      "text": "སྙེད་ཀྱིས་ ༼སྣར། པེ།༽ སྙེད་ཀྱི་"
    },
    {
      "span": {
        "start": 2660,
        "end": 2667
      },
      "text": "ཕྲེང་བ་ ༼སྣར། པེ།༽ ཕྲེང་བ་ཞེས་བྱ་བ་"
    },
    {
      "span": {
        "start": 2670,
        "end": 2679
      },
      "text": "བྱུང་བའི་ ༼སྣར། པེ།༽ འབྱུང་བའི་"
    }
  ]
}