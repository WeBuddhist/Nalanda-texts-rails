{
  "durchens": [
    {
      "span": {
        "start": 76,
        "end": 97
      },
      "text": "ནག་པོ་ཆེན་པོའི་བསྟོད་ ༼སྣར།༽ ནག་པོའི་བསྟོད་ ༼པེ།༽ ནག་པོའི་སྟོད་"
    },
    {
      "span": {
        "start": 202,
        "end": 210
      },
      "text": "སྒྲ་ཡིས་ ༼སྣར། པེ།༽ སྒྲ་ཡི་"
    },
    {
      "span": {
        "start": 292,
        "end": 304
      },
      "text": "ནི་བདུད་སྡེ་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 341,
        "end": 345
      },
      "text": "ཐོད་ ༼སྣར། པེ།༽ པོད་"
    },
    {
      "span": {
        "start": 484,
        "end": 488
      },
      "text": "དབུ་ ༼པེ།༽ དབུས་"
    },
    {
      "span": {
        "start": 547,
        "end": 555
      },
      "text": "སྲུང་བར་ ༼སྣར། པེ།༽ བསྲུང་བར་"
    },
    {
      "span": {
        "start": 594,
        "end": 601
      },
      "text": "བསྒྱུར་ ༼སྣར། པེ།༽ སྒྱུར་"
    },
    {
      "span": {
        "start": 900,
        "end": 910
      },
      "text": "གཏུམ་མོའི་ ༼སྣར། པེ།༽ གཏུམ་པོའི་"
    },
    {
      "span": {
        "start": 1031,
        "end": 1037
      },
      "text": "སྲུངས། ༼སྣར། པེ།༽ བསྲུངས།"
    },
    {
      "span": {
        "start": 1134,
        "end": 1152
      },
      "text": "ཞེས་བཟོད་པའི་ཤུགས་ ༼སྣར། པེ།༽ ཞེས་གཟུགས་"
    },
    {
      "span": {
        "start": 1226,
        "end": 1230
      },
      "text": "ཀ་ཀ་ ༼སྣར། པེ།༽ ཀ་"
    },
    {
      "span": {
        "start": 1230,
        "end": 1232
      },
      "text": "ཧ་ ༼སྣར། པེ།༽ ཧ་ཀ་"
    },
    {
      "span": {
        "start": 1292,
        "end": 1319
      },
      "text": "རྒྱུ་མས་བྲེལ་པའི་རྒྱན་གྱིས་ ༼སྣར། པེ།༽ རྒྱུ་མས་འབྲེལ་བས་"
    },
    {
      "span": {
        "start": 1386,
        "end": 1391
      },
      "text": "སྡུག་ ༼སྣར། པེ།༽ གདུག་"
    },
    {
      "span": {
        "start": 1436,
        "end": 1441
      },
      "text": "བཟུང་ ༼པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 1534,
        "end": 1540
      },
      "text": "གསུངས་ ༼སྣར། པེ།༽ གསུང་"
    },
    {
      "span": {
        "start": 1580,
        "end": 1587
      },
      "text": "བསྲེགས། ༼སྣར། པེ།༽ བསྲེག།"
    },
    {
      "span": {
        "start": 1602,
        "end": 1610
      },
      "text": "སེལ་ཞིང་ ༼སྣར། པེ།༽ སེལ་ཅིང་"
    },
    {
      "span": {
        "start": 1761,
        "end": 1769
      },
      "text": "སྲུང་བར་ ༼སྣར། པེ།༽ སྐྲོད་པར་"
    },
    {
      "span": {
        "start": 1777,
        "end": 1785
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 1869,
        "end": 1874
      },
      "text": "སྡིག་ ༼སྣར། པེ།༽ སྡིགས་"
    },
    {
      "span": {
        "start": 1888,
        "end": 1896
      },
      "text": "བརྙེས་པ་ ༼སྣར། པེ།༽ བསྙེམས་པ་"
    },
    {
      "span": {
        "start": 2586,
        "end": 2596
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 2858,
        "end": 2866
      },
      "text": "ས་སྟེངས་ ༼སྣར། པེ།༽ ས་སྟེང་"
    }
  ]
}