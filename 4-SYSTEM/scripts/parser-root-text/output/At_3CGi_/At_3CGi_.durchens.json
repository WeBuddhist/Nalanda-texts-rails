{
  "durchens": [
    {
      "span": {
        "start": 703,
        "end": 718
      },
      "text": "གསེར་འགྱུར་གྱི་ ༼པེ།༽ གསེར་འགྱུར་"
    },
    {
      "span": {
        "start": 1340,
        "end": 1343
      },
      "text": "ཛྲ་ ༼པེ།༽ ཛ་"
    },
    {
      "span": {
        "start": 1687,
        "end": 1700
      },
      "text": "ཚུལ་གྱིས་སྐུ་ ༼པེ།༽ ཚུལ་གྱིས་"
    },
    {
      "span": {
        "start": 2318,
        "end": 2330
      },
      "text": "ཡེ་ཤེས་ཀྱིས་ ༼པེ།༽ ཡེ་ཤེས་ཀྱི་"
    },
    {
      "span": {
        "start": 2879,
        "end": 2890
      },
      "text": "ཐོབ་པར་ཤོག་ ༼པེ།༽ ཐོབ་པར་ཤོག་མངྒཱ་ལཾ་"
    }
  ]
}