{
  "durchens": [
    {
      "span": {
        "start": 129,
        "end": 136
      },
      "text": "རྣམ་པར་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 396,
        "end": 403
      },
      "text": "འབད་པར་ ༼སྣར། པེ།༽ འབད་པ་"
    },
    {
      "span": {
        "start": 423,
        "end": 428
      },
      "text": "སྲེག་ ༼སྣར། པེ།༽ བསྲེག་"
    },
    {
      "span": {
        "start": 519,
        "end": 524
      },
      "text": "གཞུག་ ༼སྣར། པེ།༽ བཞུག་"
    },
    {
      "span": {
        "start": 544,
        "end": 549
      },
      "text": "གདོལ་ ༼སྣར།༽ རྡོལ་ ༼པེ།༽ རྡོབ་"
    },
    {
      "span": {
        "start": 870,
        "end": 873
      },
      "text": "ཙི་ ༼སྣར། པེ།༽ རྩི་"
    },
    {
      "span": {
        "start": 961,
        "end": 967
      },
      "text": "བསྔགས་ ༼སྣར། པེ།༽ སྔགས་"
    },
    {
      "span": {
        "start": 1055,
        "end": 1061
      },
      "text": "བསྔགས་ ༼སྣར། པེ།༽ སྔགས་"
    },
    {
      "span": {
        "start": 1131,
        "end": 1137
      },
      "text": "བསྔགས་ ༼སྣར། པེ།༽ སྔགས་"
    },
    {
      "span": {
        "start": 1167,
        "end": 1175
      },
      "text": "ཟིན་པ་ལ་ ༼སྣར། པེ།༽ ཟིན་པ་"
    },
    {
      "span": {
        "start": 1195,
        "end": 1201
      },
      "text": "བསྔགས་ ༼སྣར། པེ།༽ སྔགས་"
    },
    {
      "span": {
        "start": 1216,
        "end": 1227
      },
      "text": "ལྟོར་གཏོང་། ༼སྣར། པེ།༽ གཏོར་བཏང་།"
    },
    {
      "span": {
        "start": 1233,
        "end": 1238
      },
      "text": "ཟློས་ ༼སྣར། པེ།༽ བཟློས་"
    },
    {
      "span": {
        "start": 1282,
        "end": 1285
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 1520,
        "end": 1527
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 1633,
        "end": 1641
      },
      "text": "གཅད་པའི་ ༼སྣར། པེ།༽ བཅད་པའི་"
    },
    {
      "span": {
        "start": 1795,
        "end": 1800
      },
      "text": "རྩུབ་ ༼སྣར། པེ།༽ གཙུབ་"
    },
    {
      "span": {
        "start": 1808,
        "end": 1812
      },
      "text": "བཅད། ༼སྣར། པེ།༽ གཅད།"
    },
    {
      "span": {
        "start": 2047,
        "end": 2055
      },
      "text": "སྲེག་པར་ ༼སྣར། པེ།༽ བསྲེག་པར་"
    },
    {
      "span": {
        "start": 2126,
        "end": 2131
      },
      "text": "སྐྲག་ ༼སྣར། པེ།༽ བསྐྲག་"
    },
    {
      "span": {
        "start": 2316,
        "end": 2325
      },
      "text": "རྡོ་རྗེར་ ༼སྣར། པེ།༽ རྡོ་རྗེས་"
    },
    {
      "span": {
        "start": 2348,
        "end": 2356
      },
      "text": "སྨོས་ནས། ༼སྣར། པེ།༽ སྨོས་ནསཞེས།"
    },
    {
      "span": {
        "start": 2431,
        "end": 2439
      },
      "text": "སྲུང་བར་ ༼སྣར། པེ།༽ བསྲུང་བར་"
    },
    {
      "span": {
        "start": 2766,
        "end": 2771
      },
      "text": "སྲེག་ ༼སྣར། པེ།༽ བསྲེག་"
    },
    {
      "span": {
        "start": 2953,
        "end": 2959
      },
      "text": "དུག་པ་ ༼སྣར། པེ།༽ དུག་པ་པ་"
    }
  ]
}