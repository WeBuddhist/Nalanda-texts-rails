{
  "durchens": [
    {
      "span": {
        "start": 840,
        "end": 847
      },
      "text": "བཤམས་པ་ ༼སྣར། པེ།༽ བཤམ་པ་"
    },
    {
      "span": {
        "start": 887,
        "end": 892
      },
      "text": "ཟླ་བ་ ༼སྣར། པེ།༽ ཟླ་"
    },
    {
      "span": {
        "start": 1154,
        "end": 1158
      },
      "text": "གྲྭ་ ༼སྣར། པེ།༽ གྲ་"
    },
    {
      "span": {
        "start": 1337,
        "end": 1362
      },
      "text": "གང་བྱུང་ཞིག་བཏོན་པའི་འོག་ ༼སྣར། པེ།༽ གང་བྱུང་ཞིག་"
    },
    {
      "span": {
        "start": 1417,
        "end": 1422
      },
      "text": "བཤམས། ༼སྣར། པེ།༽ བཤམ།"
    },
    {
      "span": {
        "start": 1766,
        "end": 1770
      },
      "text": "གདན་ ༼སྣར། པེ།༽ ཨན་"
    },
    {
      "span": {
        "start": 1882,
        "end": 1887
      },
      "text": "བཤམས་ ༼སྣར། པེ།༽ བཤམ་"
    },
    {
      "span": {
        "start": 2078,
        "end": 2082
      },
      "text": "བཤམ་ ༼སྣར། པེ།༽ བཤོམ་"
    },
    {
      "span": {
        "start": 2279,
        "end": 2287
      },
      "text": "རྒྱས་པར་ ༼སྣར། པེ།༽ རྒྱས་པ་"
    },
    {
      "span": {
        "start": 2815,
        "end": 2820
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 2855,
        "end": 2864
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 3123,
        "end": 3138
      },
      "text": "གཉེན་བཤེས་དམ་པ་ ༼སྣར། པེ།༽ གཉེན་བཤེས་"
    },
    {
      "span": {
        "start": 3191,
        "end": 3198
      },
      "text": "དང་པོར་ ༼སྣར། པེ།༽ དང་པོ་"
    },
    {
      "span": {
        "start": 3365,
        "end": 3367
      },
      "text": "བ་ ༼སྣར། པེ།༽ བར་"
    },
    {
      "span": {
        "start": 3401,
        "end": 3417
      },
      "text": "སྡུག་བསྔལ་ལས་ནི་ ༼སྣར། པེ།༽ སྡུག་བསྔལ་ནས་"
    },
    {
      "span": {
        "start": 3551,
        "end": 3559
      },
      "text": "བསམ་སྟེ། ༼སྣར། པེ།༽ བསམས་ཏེ།"
    },
    {
      "span": {
        "start": 4005,
        "end": 4012
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ བརྟན་པ་"
    },
    {
      "span": {
        "start": 4037,
        "end": 4044
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ ད་ལྟར་"
    },
    {
      "span": {
        "start": 4068,
        "end": 4077
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 4111,
        "end": 4115
      },
      "text": "བྱས་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 4149,
        "end": 4156
      },
      "text": "ལྟོས་པ་ ༼སྣར། པེ།༽ བལྟོས་པ་"
    },
    {
      "span": {
        "start": 4323,
        "end": 4326
      },
      "text": "ཏུ་ ༼སྣར། པེ།༽ ཏུ་ཚ་ཚ་ཐེབས་ནས་བྱ་བའི་རིམ་པ་ལ། དང་པོར་བདེན་པ་བདར་ཞིང་གནས་བྱིན་གྱིས་བརླབ། དེ་ནས་སྤྱན་དྲང་། དེ་ནས་བསྟོད་ཕྱག་བྱ། དེ་ནས་བསུ་ཨརྒྷ་གསོལ། དེ་ནས་གདན་ལ་བཞུགས་སུ་གསོལ། དེ་ནས་སྐུ་ཁྲུས་གསོལ། ཁྲུས་ཀྱི་སྨོན་ལམ་བྱ། དེ་ནས་མཆོད་པ་དབུལ། དེ་ནས་ཡོན་ཆབ་གསོལ། དེ་ནས་རང་བྱུང་དཔའ་བོས་བསྟོད། གཏོར་མ་བསྔོ་བ་ཞར་ལ་བྱ། དེ་ནས་སྡིག་བཤགས། དེ་ནས་དགེ་བའི་རྩ་བ་ཀུན་ལ་རྗེས་སུ་ཡི་རང་བར་བྱ། ཆོས་ཀྱི་འཁོར་ལོ་བསྐོར་བར་བསྐུལ་བ་གདབ། མྱ་ངན་ལས་མི་འདའ་བར་བཞུགས་པར་གསོལ་བ་གདབ། བླ་ན་མེད་པའི་བྱང་ཆུབ་ཏུ་སེམས་བསྐྱེད་པ། ཤིས་པ་བརྗོད་པ། སེམས་ཅན་དང་འཕགས་པའི་ཚོགས་ལ་བསོད་ནམས་བསྟབ་པ། དགེ་བའི་རྩ་བ་དེ་དག་བླ་ན་མེད་པའི་བྱང་ཆུབ་ཏུ་བསྔོ་བས་སྐབས་འདིར་མཆོད་རྟེན་གྱི་སྐོར་བའི་ཚིགས་སུ་བཅད་པ་དང་། དེའི་ཕན་ཡོན་དང་། སྨོན་ལམ་ལ་སོགས་པ་ཅི་ནུས་ཀྱིས་རྒྱ་ཆེར་བཀླག །དེ་ནས་བསྐོར་བ་བདུན་ཡན་ཆད་བསྐོར་བར་བགྱི། དེ་ནས་བཤགས་ཤིང་བཟོད་པར་གསོལ། དེ་ནས་གཤེགས་སུ་གསོལ་བ་བགྱི་"
    },
    {
      "span": {
        "start": 4515,
        "end": 4524
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 5453,
        "end": 5456
      },
      "text": "དང་ ༼སྣར། པེ།༽ དང་དངུལ་དང་"
    },
    {
      "span": {
        "start": 5470,
        "end": 5474
      },
      "text": "གདལ་ ༼སྣར། པེ།༽ བརྡལ་"
    },
    {
      "span": {
        "start": 5769,
        "end": 5777
      },
      "text": "དཔྱངས་པ་ ༼སྣར། པེ།༽ སྤྱངས་པ་"
    },
    {
      "span": {
        "start": 5924,
        "end": 5935
      },
      "text": "བསྒྲེངས་པས་ ༼སྣར།༽ བསྒྲངས་པས་"
    },
    {
      "span": {
        "start": 6592,
        "end": 6598
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 6642,
        "end": 6649
      },
      "text": "བྱེད་པ་ ༼སྣར། པེ།༽ བྱེད་པར་"
    },
    {
      "span": {
        "start": 6671,
        "end": 6683
      },
      "text": "པའི་དྲི་མའི་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 6868,
        "end": 6877
      },
      "text": "ཆེན་པོའི་ ༼སྣར། པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 7424,
        "end": 7427
      },
      "text": "མེ་ ༼པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 7526,
        "end": 7551
      },
      "text": "བྱང་ཆུབ་སེམས་དཔའ་དང་འཕགས་ ༼སྣར། པེ།༽ འཕགས་"
    },
    {
      "span": {
        "start": 7689,
        "end": 7692
      },
      "text": "ཆོ་ ༼སྣར། པེ།༽ ཡང་ཆ་"
    },
    {
      "span": {
        "start": 7856,
        "end": 7875
      },
      "text": "འབྱུང་བའི་མཆོད་པའི་ ༼སྣར། པེ།༽ འབྱུང་བའི་"
    },
    {
      "span": {
        "start": 8136,
        "end": 8145
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 8285,
        "end": 8293
      },
      "text": "གསུམ་དུ་ ༼སྣར། པེ།༽ གསུམ་"
    },
    {
      "span": {
        "start": 9217,
        "end": 9220
      },
      "text": "ཆེ་ ༼པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 9519,
        "end": 9523
      },
      "text": "པའི་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 9992,
        "end": 9996
      },
      "text": "བདག་ ༼སྣར། པེ།༽ བདག་ཅག་"
    },
    {
      "span": {
        "start": 10130,
        "end": 10137
      },
      "text": "ས་བླའི་ ༼སྣར། པེ།༽ ས་བླའི་ལྷའི་"
    },
    {
      "span": {
        "start": 10485,
        "end": 10495
      },
      "text": "སྨྱུང་བའི་ ༼སྣར། པེ།༽ བསྙུང་བའི་"
    },
    {
      "span": {
        "start": 10836,
        "end": 10842
      },
      "text": "གང་ཡང་ ༼སྣར། པེ།༽ གང་དག་"
    },
    {
      "span": {
        "start": 10941,
        "end": 10945
      },
      "text": "བསལ་ ༼སྣར། པེ།༽ གསལ་"
    },
    {
      "span": {
        "start": 11287,
        "end": 11293
      },
      "text": "བསལ་བ། ༼ཅོ།༽ བསལ་བས་"
    },
    {
      "span": {
        "start": 11300,
        "end": 11304
      },
      "text": "གསལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 11824,
        "end": 11827
      },
      "text": "ནད་ ༼སྣར། པེ།༽ ངས་"
    },
    {
      "span": {
        "start": 11855,
        "end": 11864
      },
      "text": "ལྟས་ངན་པ་ ༼སྡེ།༽ ལྟས་ངན་"
    },
    {
      "span": {
        "start": 12428,
        "end": 12435
      },
      "text": "བསྲུངས་ ༼སྣར། པེ།༽ སྲུངས་"
    },
    {
      "span": {
        "start": 13156,
        "end": 13162
      },
      "text": "ཚངས་པ་ ༼སྣར། པེ།༽ ཚངས་"
    },
    {
      "span": {
        "start": 13287,
        "end": 13294
      },
      "text": "གླང་པོ་ ༼སྣར། པེ།༽ གླང་པོ་ཆེ་"
    },
    {
      "span": {
        "start": 13642,
        "end": 13653
      },
      "text": "མགྲིན་བཟངས་ ༼སྣར། པེ།༽ མགྲིན་བཟང་"
    },
    {
      "span": {
        "start": 13837,
        "end": 13840
      },
      "text": "གང་ ༼སྣར། པེ།༽ གངས་"
    },
    {
      "span": {
        "start": 13853,
        "end": 13856
      },
      "text": "རི་ ༼ཅོ།༽ རེ་"
    },
    {
      "span": {
        "start": 14406,
        "end": 14410
      },
      "text": "ཐ་ལ་ ༼སྣར། པེ།༽ ཏ་ལ་"
    },
    {
      "span": {
        "start": 14719,
        "end": 14734
      },
      "text": "གནོད་སྦྱིན་ཆེན་ ༼སྣར། པེ།༽ གནོད་སྦྱིན་"
    },
    {
      "span": {
        "start": 15113,
        "end": 15120
      },
      "text": "བཟོ་བོ་ ༼སྣར། པེ།༽ གཟོ་བོ་"
    },
    {
      "span": {
        "start": 15301,
        "end": 15306
      },
      "text": "མནོས་ ༼སྣར། པེ།༽ གནོད་"
    },
    {
      "span": {
        "start": 15580,
        "end": 15587
      },
      "text": "ཐམས་ཅད་ ༼སྣར། པེ།༽ ཐམས་ཅད་ན་བཞུགས་པ་ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 15629,
        "end": 15640
      },
      "text": "དཔལ་ལྷ་བཙན་ ༼སྣར། པེ།༽ དཔལ་ལྷ་མོ་ཙན་"
    },
    {
      "span": {
        "start": 15892,
        "end": 15906
      },
      "text": "ལ་སོགས་པར་གནས་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 15992,
        "end": 15998
      },
      "text": "ཇི་ལྟ་ ༼སྣར། པེ།༽ ཇི་ལྟ་བ་"
    },
    {
      "span": {
        "start": 16037,
        "end": 16041
      },
      "text": "བཙལ་ ༼སྣར། པེ།༽ འཚལ་"
    },
    {
      "span": {
        "start": 16593,
        "end": 16598
      },
      "text": "སྒྱུ་ ༼སྣར།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 16917,
        "end": 16922
      },
      "text": "རྒྱན་ ༼སྣར། པེ།༽ བརྒྱན་"
    },
    {
      "span": {
        "start": 17030,
        "end": 17037
      },
      "text": "གསོལ་བ། ༼སྣར།༽ གསོལ་"
    },
    {
      "span": {
        "start": 18230,
        "end": 18238
      },
      "text": "རྒྱ་ཆེན་ ༼སྣར། པེ།༽ རྒྱས་ཆེད་"
    },
    {
      "span": {
        "start": 18482,
        "end": 18493
      },
      "text": "བྱིན་བརླབས་ ༼སྣར།༽ བྱིན་རླབས་"
    },
    {
      "span": {
        "start": 18651,
        "end": 18664
      },
      "text": "གནས་ཚུལ་གྱིས་ ༼སྣར། པེ།༽ གནས་ཚུལ་གྱི་"
    },
    {
      "span": {
        "start": 18817,
        "end": 18821
      },
      "text": "གདན་ ༼སྣར། པེ།༽ གནས་"
    },
    {
      "span": {
        "start": 18928,
        "end": 18935
      },
      "text": "དོགས་པ་ ༼སྣར། པེ།༽ དོག་པ་"
    },
    {
      "span": {
        "start": 19162,
        "end": 19165
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 19319,
        "end": 19329
      },
      "text": "ཁྲུས་གསོལ། ༼སྣར། པེ།༽ ཁྲུས་གསོལ་ན།"
    },
    {
      "span": {
        "start": 19838,
        "end": 19843
      },
      "text": "རྨོང་ ༼སྣར། པེ།༽ རྨང་"
    },
    {
      "span": {
        "start": 19971,
        "end": 19979
      },
      "text": "ཟླུམ་པོ་ ༼སྣར།༽ ཟླུམ་པ་"
    },
    {
      "span": {
        "start": 20922,
        "end": 20928
      },
      "text": "འགྲུབ་ ༼སྣར། པེ།༽ གྲུབ་"
    },
    {
      "span": {
        "start": 21012,
        "end": 21018
      },
      "text": "ཆུ་བོ་ ༼སྣར། པེ།༽ ཆུ་"
    },
    {
      "span": {
        "start": 21058,
        "end": 21065
      },
      "text": "བལྟ་བས་ ༼སྣར། པེ།༽ ལྟ་བས་"
    },
    {
      "span": {
        "start": 21416,
        "end": 21421
      },
      "text": "སརྦྦ་ ༼སྣར། པེ།༽ སརྦ་"
    },
    {
      "span": {
        "start": 21498,
        "end": 21503
      },
      "text": "ཚིགས་ ༼སྣར། པེ།༽ ཚིག་"
    },
    {
      "span": {
        "start": 21525,
        "end": 21536
      },
      "text": "བདེར་གཤེགས་ ༼སྣར། པེ།༽ བདེ་གཤེགས་"
    },
    {
      "span": {
        "start": 22996,
        "end": 23009
      },
      "text": "བཀྲེས་སྐྱེམས་ ༼སྣར། པེ།༽ སྦྲེབས་སྐྱེམ་"
    },
    {
      "span": {
        "start": 23242,
        "end": 23245
      },
      "text": "ཆེ་ ༼སྣར། པེ།༽ ཆེ་སྣ་"
    },
    {
      "span": {
        "start": 23738,
        "end": 23742
      },
      "text": "བཅད་ ༼སྣར།༽ གཅད་"
    },
    {
      "span": {
        "start": 23975,
        "end": 23984
      },
      "text": "རྒྱལ་སྲས་ ༼སྣར། པེ།༽ རྒྱལ་བ་"
    },
    {
      "span": {
        "start": 24562,
        "end": 24571
      },
      "text": "དུག་གསུམ་ ༼སྣར། པེ།༽ དུས་གསུམ་"
    },
    {
      "span": {
        "start": 24846,
        "end": 24851
      },
      "text": "ཆུའི་ ༼སྣར། པེ།༽ ཆུ་ཡིས་"
    },
    {
      "span": {
        "start": 25117,
        "end": 25123
      },
      "text": "མར་མེ་ ༼ཅོ།༽ མར་མེའི་"
    },
    {
      "span": {
        "start": 25632,
        "end": 25641
      },
      "text": "དུག་གསུམ་ ༼སྣར། པེ།༽ དུས་གསུམ་"
    },
    {
      "span": {
        "start": 25762,
        "end": 25768
      },
      "text": "བསྐངས་ ༼སྣར། པེ།༽ བསྐོངས་"
    },
    {
      "span": {
        "start": 25848,
        "end": 25866
      },
      "text": "ཐམས་ཅད་ཆོས་ཐམས་ཅད་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 26574,
        "end": 26580
      },
      "text": "བསྐོར་ ༼སྣར། པེ།༽ སྐོར་"
    },
    {
      "span": {
        "start": 26642,
        "end": 26647
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 26677,
        "end": 26692
      },
      "text": "བདག་ཅག་ཡོན་བདག་ ༼སྣར། པེ།༽ བདག་ཅག་"
    },
    {
      "span": {
        "start": 27142,
        "end": 27153
      },
      "text": "གཟུགས་སྐུར་ ༼སྣར། པེ།༽ གཟུགས་སྐུ་"
    },
    {
      "span": {
        "start": 27900,
        "end": 27905
      },
      "text": "ཁེབས་ ༼སྣར། པེ།༽ ཁབས་"
    },
    {
      "span": {
        "start": 28172,
        "end": 28178
      },
      "text": "ནང་གི་ ༼སྣར། པེ།༽ རྨད་ཀྱི་"
    },
    {
      "span": {
        "start": 29292,
        "end": 29297
      },
      "text": "སྐུར་ ༼སྣར། པེ།༽ བསྐུར་"
    },
    {
      "span": {
        "start": 30005,
        "end": 30010
      },
      "text": "འབུལ། ༼སྣར། པེ།༽ དབུལ།"
    },
    {
      "span": {
        "start": 30270,
        "end": 30277
      },
      "text": "བསྒྱུར་ ༼སྣར། པེ།༽ སྒྱུར་"
    },
    {
      "span": {
        "start": 30338,
        "end": 30348
      },
      "text": "འདེབས་པའི་ ༼སྣར། པེ།༽ འདེགས་པའི་"
    },
    {
      "span": {
        "start": 30441,
        "end": 30445
      },
      "text": "ནོན། ༼སྣར། པེ།༽ གནོན།"
    },
    {
      "span": {
        "start": 30521,
        "end": 30525
      },
      "text": "བྲན་ ༼སྣར། པེ།༽ དྲན་"
    },
    {
      "span": {
        "start": 31095,
        "end": 31106
      },
      "text": "ཁེབས་སྐྱབས་ ༼སྣར། པེ།༽ ཁབས་སྐྱབ་"
    },
    {
      "span": {
        "start": 31224,
        "end": 31232
      },
      "text": "ཡུན་རིང་ ༼སྣར། པེ།༽ ཡུན་རིངས་"
    },
    {
      "span": {
        "start": 31415,
        "end": 31424
      },
      "text": "སྐུ་གསུང་ ༼སྣར། པེ།༽ སྐུ་གདུང་"
    },
    {
      "span": {
        "start": 31429,
        "end": 31432
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 31577,
        "end": 31600
      },
      "text": "རྣམ་གྲོལ་ཐར་ལམ་མགོན་དུ་ ༼སྣར། པེ།༽ ཐར་ལམ་མཆོག་ཏུ་"
    },
    {
      "span": {
        "start": 31617,
        "end": 31623
      },
      "text": "བཞི་ཡ་ ༼སྡེ།༽ བཞི་ཡང་"
    },
    {
      "span": {
        "start": 31897,
        "end": 31906
      },
      "text": "རྡོ་རིངས་ ༼སྣར། པེ།༽ རྡོ་རིང་"
    },
    {
      "span": {
        "start": 32384,
        "end": 32391
      },
      "text": "གྲོལ་བ་ ༼སྣར། པེ།༽ དྲང་བ་"
    },
    {
      "span": {
        "start": 32542,
        "end": 32547
      },
      "text": "བླ་མ་ ༼སྣར། པེ།༽ བླ་མའི་"
    },
    {
      "span": {
        "start": 32583,
        "end": 32593
      },
      "text": "བསྐུར་བའི་ ༼སྣར། པེ།༽ བཀུར་བའི་"
    },
    {
      "span": {
        "start": 32702,
        "end": 32712
      },
      "text": "མཆོད་རྟེན་ ༼སྣར། པེ།༽ མཆོད་ཡོན་"
    },
    {
      "span": {
        "start": 32722,
        "end": 32724
      },
      "text": "བ། ༼སྣར། པེ།༽ བ་ནི་"
    },
    {
      "span": {
        "start": 32831,
        "end": 32840
      },
      "text": "སྟེངས་སུ། ༼སྣར། པེ།༽ སྟེང་དུ།"
    },
    {
      "span": {
        "start": 32848,
        "end": 32856
      },
      "text": "ཟླུམ་པོ་ ༼སྣར། པེ།༽ ཟླུམ་པོས་"
    },
    {
      "span": {
        "start": 33518,
        "end": 33523
      },
      "text": "བཞེས་ ༼པེ།༽ གཞེས་"
    },
    {
      "span": {
        "start": 33727,
        "end": 33732
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 34277,
        "end": 34283
      },
      "text": "མཇིང་། ༼སྣར། པེ།༽ འཇིང་།"
    },
    {
      "span": {
        "start": 35219,
        "end": 35224
      },
      "text": "རུངས་ ༼སྣར། པེ།༽ རུང་"
    },
    {
      "span": {
        "start": 35293,
        "end": 35303
      },
      "text": "རྒྱུ་སྲོང་ ༼སྣར།༽ རྒྱུན་སྲེང་ ༼པེ།༽ རྒྱུན་སྲང་"
    },
    {
      "span": {
        "start": 35696,
        "end": 35701
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 35908,
        "end": 35913
      },
      "text": "བརྟན་ ༼ཅོ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 35943,
        "end": 35953
      },
      "text": "འགེགས་པའི་ ༼སྣར། པེ།༽ འགེབས་པའི་"
    },
    {
      "span": {
        "start": 35983,
        "end": 35988
      },
      "text": "ཁེབས་ ༼སྣར། པེ།༽ ཁབས་"
    },
    {
      "span": {
        "start": 36017,
        "end": 36024
      },
      "text": "ཅོད་ཕན་ ༼སྣར། པེ།༽ ཅོད་པན་"
    },
    {
      "span": {
        "start": 36126,
        "end": 36131
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 36189,
        "end": 36194
      },
      "text": "ཁྱོད། ༼སྣར། པེ།༽ ཁྱེད།"
    },
    {
      "span": {
        "start": 36358,
        "end": 36365
      },
      "text": "ནང་བཞི་ ༼སྣར། པེ།༽ རྐང་བཞི་"
    },
    {
      "span": {
        "start": 36608,
        "end": 36613
      },
      "text": "ཁེབས་ ༼སྣར། པེ།༽ ཁབས་"
    },
    {
      "span": {
        "start": 36689,
        "end": 36693
      },
      "text": "གསལ། ༼སྣར། པེ།༽ བསལ།"
    },
    {
      "span": {
        "start": 36711,
        "end": 36721
      },
      "text": "དྲིལ་བུའི་ ༼སྣར། པེ།༽ དྲིལ་བུ་"
    },
    {
      "span": {
        "start": 36997,
        "end": 37006
      },
      "text": "རྡོ་རིངས་ ༼སྣར། པེ།༽ རྡོ་རིང་"
    },
    {
      "span": {
        "start": 37343,
        "end": 37351
      },
      "text": "སྤྲུལ་པ་ ༼སྣར། པེ།༽ སྤྲུལ་པའི་"
    },
    {
      "span": {
        "start": 37753,
        "end": 37759
      },
      "text": "བརྒྱན། ༼སྣར། པེ།༽ རྒྱན།"
    },
    {
      "span": {
        "start": 37783,
        "end": 37791
      },
      "text": "མཆོད་པར་ ༼སྣར། པེ།༽ མཆོད་པ་"
    },
    {
      "span": {
        "start": 37859,
        "end": 37865
      },
      "text": "སྲུང་། ༼སྣར། པེ།༽ བསྲུང་།"
    },
    {
      "span": {
        "start": 38529,
        "end": 38537
      },
      "text": "གཡོག་དང་ ༼སྣར། པེ།༽ གཡོག་ཏུ་"
    },
    {
      "span": {
        "start": 38876,
        "end": 38884
      },
      "text": "སྲུང་བར་ ༼སྣར། པེ།༽ བསྲུང་བར་"
    },
    {
      "span": {
        "start": 38935,
        "end": 38942
      },
      "text": "གཟུང་བ་ ༼སྣར། པེ།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 39006,
        "end": 39012
      },
      "text": "སྤང་བ་ ༼སྣར། པེ།༽ སྤངས་པ་"
    },
    {
      "span": {
        "start": 39024,
        "end": 39030
      },
      "text": "སྤང་བ་ ༼སྣར། པེ།༽ སྤངས་པ་"
    },
    {
      "span": {
        "start": 39321,
        "end": 39327
      },
      "text": "བསྲེག་ ༼སྣར། པེ།༽ སྲེག་"
    },
    {
      "span": {
        "start": 39957,
        "end": 39962
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 40689,
        "end": 40694
      },
      "text": "མཆོད་ ༼སྣར། པེ།༽ མཛད་"
    },
    {
      "span": {
        "start": 40973,
        "end": 40981
      },
      "text": "སྲུང་བར་ ༼སྣར། པེ།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 41031,
        "end": 41038
      },
      "text": "གཟུང་བ་ ༼སྣར། པེ།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 41102,
        "end": 41108
      },
      "text": "སྤང་བ་ ༼སྣར། པེ།༽ སྤངས་པ་"
    },
    {
      "span": {
        "start": 41120,
        "end": 41126
      },
      "text": "སྤང་བ་ ༼སྣར། པེ།༽ སྤངས་པ་"
    },
    {
      "span": {
        "start": 41151,
        "end": 41157
      },
      "text": "གསད་པ་ ༼སྣར། པེ།༽ བསད་པ་"
    },
    {
      "span": {
        "start": 41167,
        "end": 41173
      },
      "text": "གཅད་པ་ ༼སྣར། པེ།༽ བཅད་པ་"
    },
    {
      "span": {
        "start": 41512,
        "end": 41519
      },
      "text": "གུས་པས་ ༼སྣར། པེ།༽ གུས་པ་"
    },
    {
      "span": {
        "start": 41825,
        "end": 41828
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 41909,
        "end": 41913
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིར་"
    },
    {
      "span": {
        "start": 41916,
        "end": 41924
      },
      "text": "བདེན་པར་ ༼སྣར། པེ།༽ བདེ་བར་"
    },
    {
      "span": {
        "start": 42225,
        "end": 42231
      },
      "text": "རྒྱུད་ ༼སྣར། པེ།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 42656,
        "end": 42660
      },
      "text": "ཆགས་ ༼སྣར།༽ ཕྱགས་"
    },
    {
      "span": {
        "start": 43101,
        "end": 43107
      },
      "text": "འཁྲུང་ ༼སྣར། པེ།༽ འཁྲུངས་"
    },
    {
      "span": {
        "start": 43200,
        "end": 43207
      },
      "text": "བཞེས་པ་ ༼སྣར། པེ།༽ གཞེས་པ་"
    },
    {
      "span": {
        "start": 43256,
        "end": 43261
      },
      "text": "བཞེས་ ༼སྣར། པེ།༽ གཞེས་"
    },
    {
      "span": {
        "start": 43292,
        "end": 43294
      },
      "text": "ལ། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 43416,
        "end": 43422
      },
      "text": "གུས་པ་ ༼སྣར། པེ།༽ གུས་པས་"
    },
    {
      "span": {
        "start": 43537,
        "end": 43542
      },
      "text": "གསོལ། ༼སྣར། པེ།༽ གསོལ་བ།"
    },
    {
      "span": {
        "start": 43566,
        "end": 43574
      },
      "text": "རབ་འབྱམ་ ༼སྣར། པེ།༽ རབ་འབྱམས་"
    },
    {
      "span": {
        "start": 43684,
        "end": 43693
      },
      "text": "གཞན་རྣམས་ ༼སྣར། པེ།༽ གཞན་དག་"
    },
    {
      "span": {
        "start": 44023,
        "end": 44026
      },
      "text": "པར་ ༼སྣར། པེ།༽ སུ་"
    },
    {
      "span": {
        "start": 44040,
        "end": 44051
      },
      "text": "བྱང་ཆུབ་ཏུ་ ༼སྣར། པེ།༽ བྱང་ཆུབ་"
    },
    {
      "span": {
        "start": 44123,
        "end": 44129
      },
      "text": "འགྱུར། ༼སྣར། པེ།༽ གྱུར།"
    },
    {
      "span": {
        "start": 44292,
        "end": 44307
      },
      "text": "བཞུགས་བཞུགས་སུ། ༼སྣར། པེ།༽ བཞུགས་སུ་གསོལ།"
    },
    {
      "span": {
        "start": 44381,
        "end": 44386
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 44411,
        "end": 44424
      },
      "text": "བདག་ཉིད་ཀྱིས། ༼སྣར། པེ།༽ བདག་ཉིད་ཀྱི།"
    },
    {
      "span": {
        "start": 44574,
        "end": 44579
      },
      "text": "བྱིན་ ༼སྣར། པེ།༽ བྱིན་གྱིས་"
    },
    {
      "span": {
        "start": 44600,
        "end": 44607
      },
      "text": "ཐམས་ཅད་ ༼སྣར། པེ།༽ ཐམས་ཅད་ལ་"
    },
    {
      "span": {
        "start": 44614,
        "end": 44620
      },
      "text": "བརྗོད། ༼སྣར། པེ།༽ བརྗོད་པ།"
    },
    {
      "span": {
        "start": 44641,
        "end": 44652
      },
      "text": "བྱིན་བརླབས་ ༼སྣར།༽ བྱིན་རླབས་"
    },
    {
      "span": {
        "start": 44771,
        "end": 44780
      },
      "text": "གཟུགས་དང་ ༼སྣར། པེ།༽ གཟུགས་ཅན་"
    },
    {
      "span": {
        "start": 44809,
        "end": 44813
      },
      "text": "མེད་ ༼སྣར། པེ།༽ མེ་"
    },
    {
      "span": {
        "start": 45088,
        "end": 45100
      },
      "text": "གྱུར་ཅིང་། །༼སྡེ།༽ གྱུར་ཅིག །"
    },
    {
      "span": {
        "start": 45743,
        "end": 45750
      },
      "text": "བཤགས་པ་ ༼སྣར། པེ།༽ གཤེགས་པ་"
    }
  ]
}