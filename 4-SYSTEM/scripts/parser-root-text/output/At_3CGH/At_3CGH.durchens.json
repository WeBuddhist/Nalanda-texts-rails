{
  "durchens": [
    {
      "span": {
        "start": 224,
        "end": 232
      },
      "text": "གཞུག་པར་ ༼སྣར། པེ།༽ བཞུགས་པར་"
    },
    {
      "span": {
        "start": 339,
        "end": 344
      },
      "text": "དཔྱང་ ༼སྣར། པེ།༽ སྤྱང་"
    },
    {
      "span": {
        "start": 423,
        "end": 426
      },
      "text": "ཏུ་ ༼སྣར། པེ།༽ དུ་"
    },
    {
      "span": {
        "start": 429,
        "end": 432
      },
      "text": "སྐ་ ༼སྣར། པེ།༽ ཀ་"
    },
    {
      "span": {
        "start": 935,
        "end": 941
      },
      "text": "སྒྲིབ་ ༼སྣར། པེ།༽ སྒྲིབ་པ་དང་བྲལ་ནས་སྒྲིབ་"
    },
    {
      "span": {
        "start": 973,
        "end": 990
      },
      "text": "འཇུག་པའི་འོད་ཟེར་ ༼སྣར། པེ།༽ འཇུག་པའི་"
    },
    {
      "span": {
        "start": 1170,
        "end": 1175
      },
      "text": "རུང་། ༼སྣར། པེ།༽ རུང་སྟེ།"
    },
    {
      "span": {
        "start": 1377,
        "end": 1384
      },
      "text": "ཉི་མ་ལ་ ༼སྣར། པེ།༽ ཉི་མ་"
    },
    {
      "span": {
        "start": 1425,
        "end": 1435
      },
      "text": "ཏུ་རུསྐའི་ ༼སྣར། པེ།༽ དུ་རུ་ཀའི་"
    }
  ]
}