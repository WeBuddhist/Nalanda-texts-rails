{
  "durchens": [
    {
      "span": {
        "start": 257,
        "end": 264
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 448,
        "end": 456
      },
      "text": "བསྡམ་པར་ ༼སྣར། པེ།༽ བསྡམས་པར་"
    },
    {
      "span": {
        "start": 897,
        "end": 905
      },
      "text": "བཟློག་པ་ ༼སྣར། པེ།༽ ལྡོག་པ་"
    },
    {
      "span": {
        "start": 986,
        "end": 993
      },
      "text": "བརླང་བ་ ༼སྣར། པེ།༽ བླང་བ་"
    },
    {
      "span": {
        "start": 1018,
        "end": 1025
      },
      "text": "འཚམས་པ་ ༼སྣར། པེ།༽ འཚམ་པ་"
    },
    {
      "span": {
        "start": 1284,
        "end": 1295
      },
      "text": "སྣ་ཚོགས་སུ་ ༼སྣར། པེ།༽ སྣ་ཚོགས་"
    },
    {
      "span": {
        "start": 1445,
        "end": 1456
      },
      "text": "ཁོང་ཁྲོ་བས་ ༼སྣར། པེ།༽ ཁོང་ཁྲོ་བ་"
    },
    {
      "span": {
        "start": 1581,
        "end": 1586
      },
      "text": "མཉེན་ ༼སྣར། པེ།༽ གཉེན་"
    },
    {
      "span": {
        "start": 1602,
        "end": 1607
      },
      "text": "འཚམས། ༼སྣར། པེ།༽ འཚམ།"
    },
    {
      "span": {
        "start": 1795,
        "end": 1800
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ གཞིན་"
    },
    {
      "span": {
        "start": 2104,
        "end": 2111
      },
      "text": "སེམས་པ་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 2359,
        "end": 2368
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 2409,
        "end": 2413
      },
      "text": "གཞན་ ༼སྣར། པེ།༽ གཞན་གྱིས་ཕྲོགས་གཞན་"
    },
    {
      "span": {
        "start": 2454,
        "end": 2461
      },
      "text": "རྒྱུའོ། ༼སྣར། པེ།༽ རྒྱུ་བའོ།"
    },
    {
      "span": {
        "start": 3005,
        "end": 3009
      },
      "text": "སྟི་ ༼སྣར། པེ།༽ བསྟི་"
    },
    {
      "span": {
        "start": 3059,
        "end": 3071
      },
      "text": "ཡིད་འབྱུང་བ་ ༼ཅོ།༽ ཡིད་འབྱུང་བར་"
    },
    {
      "span": {
        "start": 3436,
        "end": 3444
      },
      "text": "གདམས་པར་ ༼པེ།༽ བདམས་པར་"
    },
    {
      "span": {
        "start": 3465,
        "end": 3472
      },
      "text": "བསྲེགས་ ༼སྣར། པེ།༽ སྲེག་"
    },
    {
      "span": {
        "start": 3569,
        "end": 3574
      },
      "text": "ཡོངས་ ༼སྣར། པེ།༽ དངོས་"
    },
    {
      "span": {
        "start": 3587,
        "end": 3596
      },
      "text": "བསམ་གྱིས་ ༼སྣར། པེ།༽ བསམ་གྱི་"
    },
    {
      "span": {
        "start": 3774,
        "end": 3782
      },
      "text": "དན་རྟགས་ ༼ཅོ།༽ དོན་ ༼སྣར། པེ།༽ ངན་རྟགས་"
    },
    {
      "span": {
        "start": 3804,
        "end": 3811
      },
      "text": "སྤང་བར་ ༼སྣར། པེ།༽ སྤངས་པར་"
    },
    {
      "span": {
        "start": 3965,
        "end": 3997
      },
      "text": "དང་། གཉིད་བསམ་གྱིས་མི་ཁྱབ་པ་དང་། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 4122,
        "end": 4130
      },
      "text": "གྱིས་མི་ ༼སྣར།༽ གྱིས་མ་"
    },
    {
      "span": {
        "start": 4160,
        "end": 4166
      },
      "text": "འཁྱེར་ ༼སྣར། པེ།༽ ཁྱེར་"
    },
    {
      "span": {
        "start": 4228,
        "end": 4232
      },
      "text": "མོད་ ༼སྣར། པེ།༽ མོས་"
    },
    {
      "span": {
        "start": 4428,
        "end": 4434
      },
      "text": "གཟུགས་ ༼ཅོ།༽ ཐུགས་"
    },
    {
      "span": {
        "start": 4997,
        "end": 5001
      },
      "text": "བྱས་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 5092,
        "end": 5095
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དི་"
    },
    {
      "span": {
        "start": 5127,
        "end": 5135
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 5236,
        "end": 5243
      },
      "text": "ཐོབ་པར་ ༼སྣར། པེ།༽ འཐོབ་པར་"
    },
    {
      "span": {
        "start": 5287,
        "end": 5295
      },
      "text": "ཤོག་ཤིག་ ༼སྣར། པེ།༽ ཤོག་ཅིག་"
    },
    {
      "span": {
        "start": 5597,
        "end": 5605
      },
      "text": "དུག་གིས་ ༼སྣར། པེ།༽ དུག་གི་"
    },
    {
      "span": {
        "start": 5608,
        "end": 5613
      },
      "text": "ཚུགས་ ༼སྣར། པེ།༽ ཚུག་"
    },
    {
      "span": {
        "start": 5713,
        "end": 5723
      },
      "text": "གང་ཟག་གིས་ ༼སྣར། པེ།༽ གང་ཟག་གི་"
    },
    {
      "span": {
        "start": 5730,
        "end": 5733
      },
      "text": "ཡི་ ༼སྣར། པེ།༽ ཡིད་"
    },
    {
      "span": {
        "start": 5815,
        "end": 5818
      },
      "text": "ཞད་ ༼སྣར། པེ།༽ ཞང་"
    },
    {
      "span": {
        "start": 5975,
        "end": 5984
      },
      "text": "རིམ་གྱིས་ ༼སྣར། པེ།༽ རིམ་གྱི་"
    },
    {
      "span": {
        "start": 6028,
        "end": 6038
      },
      "text": "གང་ཟག་གིས་ ༼སྣར། པེ།༽ གང་ཟག་གི་"
    },
    {
      "span": {
        "start": 6055,
        "end": 6060
      },
      "text": "གདམས་ ༼སྣར། པེ།༽ གདིས་"
    },
    {
      "span": {
        "start": 6278,
        "end": 6283
      },
      "text": "ལྔའི་ ༼སྣར། པེ།༽ ལྔས་"
    },
    {
      "span": {
        "start": 6291,
        "end": 6296
      },
      "text": "བཏུལ་ ༼སྣར། པེ།༽ བརྟུལ་"
    },
    {
      "span": {
        "start": 6312,
        "end": 6319
      },
      "text": "ཞུགས་པ་ ༼སྣར། པེ།༽ ཞུག་པ་"
    },
    {
      "span": {
        "start": 6684,
        "end": 6689
      },
      "text": "རྟོག་ ༼ཅོ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 6832,
        "end": 6837
      },
      "text": "མཐུག་ ༼སྣར། པེ།༽ འཐུག་"
    },
    {
      "span": {
        "start": 7635,
        "end": 7642
      },
      "text": "བླ་མའི་ ༼སྣར།༽ བླ་བའི་"
    },
    {
      "span": {
        "start": 7932,
        "end": 7940
      },
      "text": "ལས་ཀྱིས་ ༼ཅོ།༽ ལས་ཀྱི་"
    },
    {
      "span": {
        "start": 7959,
        "end": 7973
      },
      "text": "འདོད་ན་མི་ཕྲད་ ༼སྣར། པེ།༽ འདོད་དང་"
    },
    {
      "span": {
        "start": 7984,
        "end": 7990
      },
      "text": "ཕྲད་ན་ ༼སྣར། པེ།༽ ཕྲད་ཀྱང་"
    },
    {
      "span": {
        "start": 8087,
        "end": 8094
      },
      "text": "སྐྱོའོ་ ༼སྣར། པེ།༽ སྐྱེ་བོ་"
    },
    {
      "span": {
        "start": 8189,
        "end": 8198
      },
      "text": "བསམ་གྱིས་ ༼སྣར། པེ།༽ བསམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 8259,
        "end": 8266
      },
      "text": "སྐུ་དང་ ༼སྣར། པེ།༽ སྐུ་ཡང་"
    },
    {
      "span": {
        "start": 8339,
        "end": 8344
      },
      "text": "སྤོང་ ༼སྣར། པེ།༽ འབྲི་"
    },
    {
      "span": {
        "start": 8377,
        "end": 8383
      },
      "text": "སྤྱོད་ ༼སྣར།༽ སྤྱད་"
    },
    {
      "span": {
        "start": 8753,
        "end": 8758
      },
      "text": "གསེབ་ ༼སྣར། པེ།༽ བསེབ་"
    },
    {
      "span": {
        "start": 8777,
        "end": 8784
      },
      "text": "ལ་སོགས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 8960,
        "end": 8963
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    }
  ]
}