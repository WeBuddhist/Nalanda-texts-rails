{
  "durchens": [
    {
      "span": {
        "start": 273,
        "end": 283
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 314,
        "end": 319
      },
      "text": "མཆོག་ ༼སྣར། པེ།༽ མཆོད་"
    },
    {
      "span": {
        "start": 391,
        "end": 401
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 431,
        "end": 435
      },
      "text": "འཆག་ ༼སྣར། པེ།༽ འཆགས་"
    },
    {
      "span": {
        "start": 862,
        "end": 870
      },
      "text": "སྐུལ་བར་ ༼སྣར། པེ།༽ བསྐུལ་བར་"
    },
    {
      "span": {
        "start": 1014,
        "end": 1019
      },
      "text": "རིག ། ༼སྣར། པེ།༽ རིགས། །"
    },
    {
      "span": {
        "start": 1029,
        "end": 1035
      },
      "text": "འདས་པ་ ༼ཅོ།༽ འདས་པར་"
    },
    {
      "span": {
        "start": 1301,
        "end": 1311
      },
      "text": "ཡོངས་བསྔོ་ ༼སྣར། པེ།༽ ཡོངས་བསྔོས་"
    },
    {
      "span": {
        "start": 1365,
        "end": 1371
      },
      "text": "བསྔགས། ༼ཅོ།༽ སྔགས།"
    },
    {
      "span": {
        "start": 1524,
        "end": 1529
      },
      "text": "སོ། ། ༼སྣར། པེ།༽ ། །པཎྜི་ཏ་དེ་ཉིད་དང་ལོ་ཙཱ་བ་ཤཱཀྱ་བློ་གྲོས་ཀྱིས་བསྒྱུར་རོ། །"
    }
  ]
}