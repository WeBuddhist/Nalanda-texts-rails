{
  "durchens": [
    {
      "span": {
        "start": 119,
        "end": 127
      },
      "text": "འབྲངས་པ་ ༼སྣར། པེ།༽ འབྲང་བ་"
    },
    {
      "span": {
        "start": 195,
        "end": 203
      },
      "text": "ཆགས་པའི་ ༼སྣར།༽ ཆགས་པ་"
    },
    {
      "span": {
        "start": 350,
        "end": 357
      },
      "text": "མཛའ་བོ་ ༼སྣར། པེ།༽ མཛའོ་"
    },
    {
      "span": {
        "start": 401,
        "end": 405
      },
      "text": "བཀའ་ ༼སྣར། པེ།༽ དཀའ་"
    },
    {
      "span": {
        "start": 548,
        "end": 552
      },
      "text": "ཐོབ་ ༼སྣར། པེ།༽ འཐོབ་"
    },
    {
      "span": {
        "start": 671,
        "end": 679
      },
      "text": "འཁྲུག་པ་ ༼སྣར། པེ།༽ འཁྲུགས་པ་"
    },
    {
      "span": {
        "start": 738,
        "end": 745
      },
      "text": "འགྲོ་བ་ ༼སྣར། པེ།༽ འགྲོ་བར་"
    },
    {
      "span": {
        "start": 834,
        "end": 845
      },
      "text": "ཀྱི་འཇུག་པ་ ༼སྣར། པེ།༽ ཀྱི་འཇུགས་"
    },
    {
      "span": {
        "start": 866,
        "end": 873
      },
      "text": "བགྲང་བ་ ༼སྣར། པེ།༽ བགྲངས་པ་"
    },
    {
      "span": {
        "start": 894,
        "end": 899
      },
      "text": "ཏེ་བ་ ༼སྣར། པེ།༽ ཏེ་མ་"
    },
    {
      "span": {
        "start": 1077,
        "end": 1084
      },
      "text": "འཁྱམ་པ་ ༼སྣར། པེ།༽ འཁྱམས་པ་"
    },
    {
      "span": {
        "start": 1328,
        "end": 1332
      },
      "text": "བདེ་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 1425,
        "end": 1434
      },
      "text": "ཕྱིན་པའི་ ༼སྣར། པེ།༽ སྦྱིན་པའི་"
    },
    {
      "span": {
        "start": 1588,
        "end": 1595
      },
      "text": "འབྱུང་། ༼སྣར། པེ།༽ བྱུང་།"
    },
    {
      "span": {
        "start": 1726,
        "end": 1728
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 1924,
        "end": 1934
      },
      "text": "དེའི་ཕྱིར་ ༼སྣར། པེ།༽ དེ་ཕྱིར་"
    },
    {
      "span": {
        "start": 2036,
        "end": 2040
      },
      "text": "འདི་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 2160,
        "end": 2162
      },
      "text": "། །འཇིག་རྟེན་ ༼སྣར། པེ།༽ ། ། ༼སྣར། པེ།༽ བདེ་བ་"
    }
  ]
}