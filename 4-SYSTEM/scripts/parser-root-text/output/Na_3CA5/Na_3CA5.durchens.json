{
  "durchens": [
    {
      "span": {
        "start": 91,
        "end": 98
      },
      "text": "འཕེལ་བ་ ༼སྣར། པེ།༽ འཕེལ་"
    },
    {
      "span": {
        "start": 124,
        "end": 128
      },
      "text": "པའི་ ༼སྣར།༽ དཔལ་"
    },
    {
      "span": {
        "start": 243,
        "end": 252
      },
      "text": "གང་བ་ཅིག་ ༼སྣར།༽ གང་པ་ཞིག་ ༼པེ།༽ གང་པ་གཅིག་"
    },
    {
      "span": {
        "start": 383,
        "end": 385
      },
      "text": "པ། ༼སྣར།༽ ན།"
    },
    {
      "span": {
        "start": 438,
        "end": 447
      },
      "text": "དམར་པོའི་ ༼སྣར། པེ།༽ དམར་མོའི་"
    },
    {
      "span": {
        "start": 541,
        "end": 550
      },
      "text": "ཀ་ལི་ཅིག་ ༼སྣར། པེ།༽ ཀ་ལི་གཅིག་"
    },
    {
      "span": {
        "start": 576,
        "end": 579
      },
      "text": "སྭ་ ༼སྣར། པེ།༽ སྭཱ་"
    },
    {
      "span": {
        "start": 709,
        "end": 721
      },
      "text": "བརྒྱད་པ་ཅིག་ ༼སྣར།༽ བརྒྱད་པ་ཞིག་ ༼པེ།༽ བརྒྱད་པ་གཅིག་"
    },
    {
      "span": {
        "start": 803,
        "end": 810
      },
      "text": "ཅན་ཅིག་ ༼སྣར།༽ ཅན་ཞིག་ ༼པེ།༽ ཅན་གཅིག་"
    },
    {
      "span": {
        "start": 1046,
        "end": 1050
      },
      "text": "དཀར་ ༼པེ།༽ ཧྲི་དཀར་"
    },
    {
      "span": {
        "start": 1094,
        "end": 1105
      },
      "text": "དབྱངས་ཅན་མ་ ༼ཅོ།༽ དབྱངས་ཅན་"
    },
    {
      "span": {
        "start": 1313,
        "end": 1316
      },
      "text": "ཡང་ ༼སྣར།༽ ཡང་ན་"
    },
    {
      "span": {
        "start": 1589,
        "end": 1595
      },
      "text": "ཞལ་དུ། ༼པེ།༽ ཞལ་"
    },
    {
      "span": {
        "start": 1999,
        "end": 2007
      },
      "text": "བསྒྲུབས་ ༼སྣར།༽ སྒྲུབས་ ༼པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 2046,
        "end": 2096
      },
      "text": "ཉི་མ་གསུམ་བསྒྲུབས་ན་སྐྱེ་བ་དྲན་པར་འགྱུར་རོ། །ཉི་མ་ ༼པེ།༽ ཉི་མ་"
    },
    {
      "span": {
        "start": 2130,
        "end": 2141
      },
      "text": "འགྱུར་རོ། ། ༼སྣར།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 2410,
        "end": 2417
      },
      "text": "ཟོས་པས། ༼པེ།༽ ཟོས་པ།"
    },
    {
      "span": {
        "start": 2593,
        "end": 2599
      },
      "text": "ལྟ་བུ་ ༼སྣར། པེ།༽ ལྟ་བུར་"
    },
    {
      "span": {
        "start": 2731,
        "end": 2736
      },
      "text": "ཟུངས་ ༼སྣར།༽ ཟུང་ ༼པེ།༽ གཟུངས་"
    },
    {
      "span": {
        "start": 2823,
        "end": 2830
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 2925,
        "end": 2941
      },
      "text": "འཕེལ་བ་ཞེས་བྱ་བ་ ༼པེ།༽ འཕེལ་"
    },
    {
      "span": {
        "start": 3000,
        "end": 3009
      },
      "text": "རྫོགས་སོ། ༼པེ།༽ རྫོགས་སྷོ།"
    }
  ]
}