{
  "durchens": [
    {
      "span": {
        "start": 475,
        "end": 482
      },
      "text": "རྩོད་པ་ ༼སྣར། པེ།༽ བརྩད་པ་"
    },
    {
      "span": {
        "start": 1064,
        "end": 1071
      },
      "text": "རྩོད་པ་ ༼སྣར། པེ།༽ བརྩོད་པ་"
    },
    {
      "span": {
        "start": 1260,
        "end": 1264
      },
      "text": "ཞིང་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 1314,
        "end": 1320
      },
      "text": "རྟོགས་ ༼སྣར། པེ།༽ རྟོག་"
    },
    {
      "span": {
        "start": 1392,
        "end": 1397
      },
      "text": "བརྟན་ ༼སྣར། པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 1511,
        "end": 1518
      },
      "text": "ཡོད་དང་ ༼སྣར། པེ།༽ ཡོད་དམ་"
    },
    {
      "span": {
        "start": 1609,
        "end": 1617
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 2009,
        "end": 2012
      },
      "text": "དེ་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 2099,
        "end": 2110
      },
      "text": "འདོད་པ་ཡིན། ༼སྣར། པེ།༽ འདོད་པ་ཡིས།"
    },
    {
      "span": {
        "start": 2261,
        "end": 2269
      },
      "text": "བསྒྲུབས་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 2754,
        "end": 2759
      },
      "text": "དངོས་ ༼སྣར། པེ།༽ གིས་ངོས་"
    },
    {
      "span": {
        "start": 2854,
        "end": 2862
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ དངོས་པོས་"
    },
    {
      "span": {
        "start": 2865,
        "end": 2868
      },
      "text": "མས་ ༼སྣར། པེ།༽ མ་"
    },
    {
      "span": {
        "start": 2898,
        "end": 2906
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ དངོས་པོས་"
    },
    {
      "span": {
        "start": 3485,
        "end": 3488
      },
      "text": "ཏུ་ ༼སྣར།༽ ཏུ་དང་"
    },
    {
      "span": {
        "start": 3488,
        "end": 3494
      },
      "text": "འགལ་བ་ ༼སྣར།༽ འགལ་"
    },
    {
      "span": {
        "start": 3814,
        "end": 3821
      },
      "text": "ལ་ཚད་མ་ ༼སྣར།༽ ལ་ཚད་མཚན་"
    },
    {
      "span": {
        "start": 4107,
        "end": 4118
      },
      "text": "འགལ་བ་པ་ཡི་ ༼སྣར། པེ།༽ འགལ་བའི་"
    },
    {
      "span": {
        "start": 4118,
        "end": 4123
      },
      "text": "ཕྱིར་ ༼སྣར། པེ།༽ ཕྱིར་རོ་"
    },
    {
      "span": {
        "start": 4126,
        "end": 4128
      },
      "text": "ན། ༼སྣར། པེ།༽ ན་ནི།"
    },
    {
      "span": {
        "start": 4237,
        "end": 4244
      },
      "text": "དག་གིས་ ༼སྣར། པེ།༽ དག་གི་"
    },
    {
      "span": {
        "start": 4288,
        "end": 4302
      },
      "text": "སངས་རྒྱས་ཀྱིས་ ༼སྣར། པེ།༽ སངས་རྒྱས་ཀྱི་"
    },
    {
      "span": {
        "start": 4357,
        "end": 4366
      },
      "text": "དེ་དག་གི། ༼སྣར། པེ།༽ དེ་དག་གིས།"
    },
    {
      "span": {
        "start": 4669,
        "end": 4675
      },
      "text": "འཁྲུལ་ ༼སྣར། པེ།༽ འཕྲུལ་"
    },
    {
      "span": {
        "start": 4709,
        "end": 4715
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ ཤེས་པ་"
    },
    {
      "span": {
        "start": 5282,
        "end": 5287
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 5435,
        "end": 5440
      },
      "text": "སྟོན་ ༼སྣར། པེ།༽ བསྟོད་"
    },
    {
      "span": {
        "start": 5648,
        "end": 5655
      },
      "text": "ཡུལ་དང་ ༼སྣར། པེ།༽ ཡུལ་དུ་"
    },
    {
      "span": {
        "start": 5771,
        "end": 5776
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 5914,
        "end": 5920
      },
      "text": "འཁྱམས་ ༼སྣར། པེ།༽ འཁྱམ་"
    },
    {
      "span": {
        "start": 5988,
        "end": 5990
      },
      "text": "བ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 5995,
        "end": 5997
      },
      "text": "ལ་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 6021,
        "end": 6027
      },
      "text": "ཐར་པར་ ༼པེ།༽ ཐལ་བར་"
    },
    {
      "span": {
        "start": 6674,
        "end": 6680
      },
      "text": "བརྗོད་ ༼སྣར། པེ།༽ རྗོད་"
    },
    {
      "span": {
        "start": 6744,
        "end": 6752
      },
      "text": "སྤྱི་དེ་ ༼སྣར། པེ།༽ སྤྱི་སྟེ་"
    },
    {
      "span": {
        "start": 8578,
        "end": 8585
      },
      "text": "ཡིན་གང་ ༼སྣར། པེ།༽ ཡིན་ཡང་"
    },
    {
      "span": {
        "start": 8638,
        "end": 8643
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 8812,
        "end": 8819
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 8848,
        "end": 8854
      },
      "text": "རྟོགས་ ༼སྣར། པེ།༽ རྟོག་"
    },
    {
      "span": {
        "start": 8858,
        "end": 8863
      },
      "text": "ཀྱིས། ༼སྣར། པེ།༽ ཀྱི།"
    },
    {
      "span": {
        "start": 8974,
        "end": 8982
      },
      "text": "གཏུགས་པ་ ༼སྣར། པེ།༽ གཏུབས་པ་"
    },
    {
      "span": {
        "start": 9333,
        "end": 9339
      },
      "text": "ཚད་མས་ ༼སྣར། པེ།༽ ཚད་མ་"
    },
    {
      "span": {
        "start": 9379,
        "end": 9385
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ དེ་མི་"
    },
    {
      "span": {
        "start": 9412,
        "end": 9421
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 9732,
        "end": 9740
      },
      "text": "རྣམ་གཅད་ ༼སྣར། པེ།༽ རྣམ་བཅད་"
    },
    {
      "span": {
        "start": 10301,
        "end": 10306
      },
      "text": "བྱའི་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 10458,
        "end": 10466
      },
      "text": "མེ་སོགས་ ༼སྣར། པེ།༽ མེ་"
    },
    {
      "span": {
        "start": 10472,
        "end": 10476
      },
      "text": "ངེས་ ༼སྣར། པེ།༽ ངེས་མི་"
    },
    {
      "span": {
        "start": 10991,
        "end": 10998
      },
      "text": "རྩོད་པ་ ༼སྣར། པེ།༽ བརྩོད་པ་"
    },
    {
      "span": {
        "start": 11339,
        "end": 11346
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 11612,
        "end": 11620
      },
      "text": "རིགས་པར་ ༼སྣར། པེ།༽ རིག་པར་"
    },
    {
      "span": {
        "start": 11742,
        "end": 11750
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 11801,
        "end": 11811
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 11874,
        "end": 11880
      },
      "text": "འབྲངས་ ༼སྣར། པེ།༽ འབྲེངས་"
    },
    {
      "span": {
        "start": 12228,
        "end": 12236
      },
      "text": "རིགས་པར་ ༼སྣར། པེ།༽ རིག་པར་"
    },
    {
      "span": {
        "start": 13102,
        "end": 13112
      },
      "text": "སེམས་ཀྱིས་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 13167,
        "end": 13175
      },
      "text": "བླངས་སུ། ༼སྣར། པེ།༽ བླངས་དུ།"
    },
    {
      "span": {
        "start": 13251,
        "end": 13255
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ ཡི།"
    },
    {
      "span": {
        "start": 13510,
        "end": 13514
      },
      "text": "ཡུལ་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 13752,
        "end": 13760
      },
      "text": "རགས་པའི་ ༼སྣར། པེ།༽ རག་པའི་"
    },
    {
      "span": {
        "start": 13853,
        "end": 13856
      },
      "text": "ཕྲ་ ༼སྣར། པེ།༽ འཕྲ་"
    },
    {
      "span": {
        "start": 13878,
        "end": 13880
      },
      "text": "པ་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 14285,
        "end": 14291
      },
      "text": "འགྱུར། ༼སྣར། པེ།༽ གྱུར།"
    },
    {
      "span": {
        "start": 14328,
        "end": 14335
      },
      "text": "བྱེད་པ་ ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 14335,
        "end": 14338
      },
      "text": "ནས་ ༼སྣར། པེ།༽ ནས་དེ་"
    },
    {
      "span": {
        "start": 14354,
        "end": 14360
      },
      "text": "རྣམ་པ་ ༼སྣར། པེ།༽ རྣམ་པར་"
    },
    {
      "span": {
        "start": 14468,
        "end": 14474
      },
      "text": "རྟོགས། ༼སྣར།༽ རྟགས།"
    },
    {
      "span": {
        "start": 14953,
        "end": 14960
      },
      "text": "ཆ་གཅིག་ ༼སྣར། པེ།༽ ཆ་ཅིག་"
    },
    {
      "span": {
        "start": 14981,
        "end": 14984
      },
      "text": "ཤས་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 15225,
        "end": 15231
      },
      "text": "ཤེས་པ་ ༼སྣར། པེ།༽ ཤེས་པས་"
    },
    {
      "span": {
        "start": 15615,
        "end": 15623
      },
      "text": "འགྲུབ་པ་ ༼སྡེ།༽ གྲུབ་པ་"
    },
    {
      "span": {
        "start": 15926,
        "end": 15931
      },
      "text": "གྲུབ་ ༼སྣར། པེ།༽ འགྲུབ་"
    },
    {
      "span": {
        "start": 16568,
        "end": 16572
      },
      "text": "ཅིས་ ༼སྣར། པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 17239,
        "end": 17245
      },
      "text": "སྤྱོད་ ༼སྣར། པེ།༽ དཔྱོད་"
    },
    {
      "span": {
        "start": 17520,
        "end": 17523
      },
      "text": "ནི། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 17619,
        "end": 17629
      },
      "text": "ཤེས་པ་ཡིས། ༼སྣར། པེ།༽ ཤེས་པ་ཡི།"
    },
    {
      "span": {
        "start": 18105,
        "end": 18115
      },
      "text": "དངོས་ཀྱིས་ ༼སྣར། པེ།༽ དངོས་ཀྱི་"
    },
    {
      "span": {
        "start": 18618,
        "end": 18623
      },
      "text": "བདེན་ ༼སྡེ།༽ འདྲེན་"
    },
    {
      "span": {
        "start": 18648,
        "end": 18653
      },
      "text": "བྱའི་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 18653,
        "end": 18660
      },
      "text": "ཕྱིར། ། ༼སྣར། པེ།༽ ། །གང་ཕྱིར་གྲགས་པའི་དོན་ཉིད་ལ། །"
    },
    {
      "span": {
        "start": 18716,
        "end": 18726
      },
      "text": "བརྫུན་པའམ་ ༼སྣར། པེ།༽ བརྫུན་པའང་"
    },
    {
      "span": {
        "start": 18814,
        "end": 18819
      },
      "text": "ལྡོག་ ༼སྣར། པེ།༽ ལོག་"
    },
    {
      "span": {
        "start": 18846,
        "end": 18852
      },
      "text": "དེ་ཡི་ ༼སྣར། པེ།༽ དེ་ཡིས་"
    },
    {
      "span": {
        "start": 19325,
        "end": 19331
      },
      "text": "དེ་ནས་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 19597,
        "end": 19601
      },
      "text": "དུས་ ༼སྣར།༽ དུ་མ་"
    },
    {
      "span": {
        "start": 19605,
        "end": 19608
      },
      "text": "དུ། ༼སྣར།༽ ཏུ།"
    },
    {
      "span": {
        "start": 19796,
        "end": 19800
      },
      "text": "མེད། ༼སྣར།༽ མོད།"
    },
    {
      "span": {
        "start": 20216,
        "end": 20220
      },
      "text": "མེད། ༼སྣར། པེ།༽ དེ།"
    },
    {
      "span": {
        "start": 20308,
        "end": 20314
      },
      "text": "རང་གི་ ༼སྣར། པེ།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 20704,
        "end": 20711
      },
      "text": "ཆུང་ཟད་ ༼སྣར། པེ།༽ ཅུང་ཟད་"
    },
    {
      "span": {
        "start": 20807,
        "end": 20813
      },
      "text": "འོག་མ་ ༼སྣར། པེ།༽ ཐོག་མ་"
    },
    {
      "span": {
        "start": 21168,
        "end": 21175
      },
      "text": "མིན་གང་ ༼སྣར། པེ།༽ མིན་ཡང་"
    },
    {
      "span": {
        "start": 21233,
        "end": 21240
      },
      "text": "གྲུབ་པ་ ༼སྣར། པེ།༽ འགྲུབ་པ་"
    },
    {
      "span": {
        "start": 21811,
        "end": 21817
      },
      "text": "འགྱུར། ༼སྣར། པེ།༽ གྱུར།"
    },
    {
      "span": {
        "start": 22384,
        "end": 22390
      },
      "text": "བརྫུན་ ༼སྣར།༽ རྫུན་"
    },
    {
      "span": {
        "start": 22549,
        "end": 22555
      },
      "text": "སྤྱོད་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 23245,
        "end": 23249
      },
      "text": "བཏང་ ༼སྣར། པེ།༽ གཏང་"
    },
    {
      "span": {
        "start": 23496,
        "end": 23503
      },
      "text": "ཟློག་པ་ ༼སྣར། པེ།༽ བཟློག་པ་"
    },
    {
      "span": {
        "start": 23595,
        "end": 23598
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 23673,
        "end": 23679
      },
      "text": "རྒྱུད་ ༼སྣར། པེ།༽ རྒྱུར་"
    },
    {
      "span": {
        "start": 23788,
        "end": 23804
      },
      "text": "ཀུན་ཀྱང་གཏོང་བར་ ༼ཅོ། པེ།༽ ཀུན་འབྱུང་གཏོང་བར་ ༼སྣར།༽ ཀུན་འབྱུང་གཉིས་པ་"
    },
    {
      "span": {
        "start": 24134,
        "end": 24141
      },
      "text": "སྒྱུ་མ་ ༼སྣར། པེ།༽ སྒྱུ་མ་ལ་"
    },
    {
      "span": {
        "start": 24141,
        "end": 24148
      },
      "text": "སོགས་པ་ ༼སྣར། པེ།༽ སོགས་"
    },
    {
      "span": {
        "start": 24693,
        "end": 24700
      },
      "text": "དག་གིས་ ༼སྣར། པེ།༽ དག་གི་"
    },
    {
      "span": {
        "start": 25023,
        "end": 25025
      },
      "text": "མ་ ༼སྣར། པེ།༽ མེ་"
    },
    {
      "span": {
        "start": 25048,
        "end": 25051
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེར་"
    },
    {
      "span": {
        "start": 25590,
        "end": 25600
      },
      "text": "རྣམ་པ་གཞན་ ༼སྣར། པེ།༽ རྣམ་པ་ཡང་"
    },
    {
      "span": {
        "start": 26727,
        "end": 26733
      },
      "text": "སྐལ་བ་ ༼སྣར། པེ།༽ བསྐལ་པ་"
    },
    {
      "span": {
        "start": 26868,
        "end": 26874
      },
      "text": "གནང་བ་ ༼སྣར། པེ།༽ སྣང་བ་"
    },
    {
      "span": {
        "start": 26989,
        "end": 26997
      },
      "text": "ཐབས་ཀྱི་ ༼སྣར། པེ།༽ ཐབས་ཀྱིས་"
    },
    {
      "span": {
        "start": 27323,
        "end": 27332
      },
      "text": "དེ་ལ་སུན་ ༼སྣར།༽ ལ་སུ་ ༼པེ།༽ དེ་ལས་སུ་"
    },
    {
      "span": {
        "start": 27569,
        "end": 27571
      },
      "text": "བ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 27991,
        "end": 27997
      },
      "text": "འགྲུབ་ ༼སྣར། པེ།༽ གྲུབ་"
    },
    {
      "span": {
        "start": 28102,
        "end": 28110
      },
      "text": "རྟོགས་པ་ ༼པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 28737,
        "end": 28748
      },
      "text": "རྒྱུ་རྐྱེན་ ༼སྣར། པེ།༽ རྒྱུད་ཅན་"
    },
    {
      "span": {
        "start": 29306,
        "end": 29310
      },
      "text": "ཡིན་ ༼སྣར། པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 29386,
        "end": 29394
      },
      "text": "འབྱུང་བ་ ༼སྣར།༽ འབྱུང་བར་"
    },
    {
      "span": {
        "start": 29920,
        "end": 29922
      },
      "text": "པ་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 29979,
        "end": 29989
      },
      "text": "འགྱུར་བའི་ ༼སྣར། པེ།༽ གྱུར་པའི་"
    },
    {
      "span": {
        "start": 30120,
        "end": 30128
      },
      "text": "མེད་པའང་ ༼སྣར། པེ།༽ ངེས་པའང་"
    },
    {
      "span": {
        "start": 30477,
        "end": 30481
      },
      "text": "གང་། ༼སྣར། པེ།༽ གྲང་།"
    },
    {
      "span": {
        "start": 30866,
        "end": 30870
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 30926,
        "end": 30931
      },
      "text": "བྱའི་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 31481,
        "end": 31486
      },
      "text": "བྱའི་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 31856,
        "end": 31861
      },
      "text": "བྱའི་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 32056,
        "end": 32060
      },
      "text": "མིན་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 32335,
        "end": 32342
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 32580,
        "end": 32589
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 32937,
        "end": 32945
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 32999,
        "end": 33006
      },
      "text": "སྤྱད་པ་ ༼སྣར། པེ།༽ དཔྱད་པ་"
    },
    {
      "span": {
        "start": 33840,
        "end": 33847
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ བསྣན་པ་"
    },
    {
      "span": {
        "start": 33892,
        "end": 33901
      },
      "text": "གང་ན་ཡོད། ༼སྣར། པེ།༽ གང་ཡོད་ན།"
    },
    {
      "span": {
        "start": 33990,
        "end": 33998
      },
      "text": "བརྗོད་པ་ ༼སྣར། པེ།༽ རྗོད་པ་"
    },
    {
      "span": {
        "start": 34250,
        "end": 34254
      },
      "text": "འབབ་ ༼སྣར། པེ།༽ འབབས་"
    },
    {
      "span": {
        "start": 34381,
        "end": 34386
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 34562,
        "end": 34566
      },
      "text": "འོན་ ༼སྣར། པེ།༽ ལོག་"
    },
    {
      "span": {
        "start": 34787,
        "end": 34794
      },
      "text": "ཡིན་པར་ ༼སྣར། པེ།༽ ཡིན་ཞེས་"
    },
    {
      "span": {
        "start": 35139,
        "end": 35147
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 35308,
        "end": 35313
      },
      "text": "བྱའི་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 35336,
        "end": 35342
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 35662,
        "end": 35672
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 35746,
        "end": 35752
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 36261,
        "end": 36269
      },
      "text": "ཉིད་ཀྱི། ༼སྣར། པེ།༽ ཉིད་ཀྱིས།"
    },
    {
      "span": {
        "start": 37168,
        "end": 37175
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 37538,
        "end": 37545
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 37850,
        "end": 37857
      },
      "text": "གྱུར་པ། ༼སྣར། པེ།༽ འགྱུར་བ།"
    },
    {
      "span": {
        "start": 38242,
        "end": 38249
      },
      "text": "རིག་པར་ ༼པེ།༽ རིགས་པར་"
    },
    {
      "span": {
        "start": 38413,
        "end": 38423
      },
      "text": "རྟགས་ཀྱིས་ ༼སྣར། པེ།༽ རྟགས་ཀྱི་"
    },
    {
      "span": {
        "start": 39345,
        "end": 39355
      },
      "text": "མེད་པར་དེ་ ༼སྣར། པེ།༽ མེད་པར་ཡང་"
    },
    {
      "span": {
        "start": 39846,
        "end": 39852
      },
      "text": "འགྲུབ། ༼སྣར། པེ།༽ གྲུབ།"
    },
    {
      "span": {
        "start": 40072,
        "end": 40085
      },
      "text": "གྲང་དྲོའི་རག་ ༼ཅོ།༽ གྲང་དྲོའི་རེག་ ༼སྣར།༽ དྲིའི་རེག་"
    },
    {
      "span": {
        "start": 40229,
        "end": 40236
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 40333,
        "end": 40342
      },
      "text": "གྲུབ་པའི་ ༼སྣར། པེ།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 40656,
        "end": 40668
      },
      "text": "དེ་ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ དེ་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 41366,
        "end": 41375
      },
      "text": "གཉིས་ཀྱི་ ༼པེ།༽ གཉིས་ཀྱིས་"
    },
    {
      "span": {
        "start": 41400,
        "end": 41403
      },
      "text": "རང་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 41407,
        "end": 41412
      },
      "text": "བ་ཡི་ ༼སྣར། པེ།༽ བའི་"
    },
    {
      "span": {
        "start": 41678,
        "end": 41686
      },
      "text": "ཇི་བཞིན་ ༼སྣར། པེ།༽ ཇི་ཞིག་"
    },
    {
      "span": {
        "start": 41703,
        "end": 41705
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 42011,
        "end": 42015
      },
      "text": "ཅིས་ ༼སྣར། པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 42175,
        "end": 42185
      },
      "text": "ཡོད་མ་ཡིན། ༼སྣར། པེ།༽ ཡོད་པ་མིན།"
    },
    {
      "span": {
        "start": 42625,
        "end": 42634
      },
      "text": "ཀུན་གྱིས་ ༼སྣར། པེ།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 42967,
        "end": 42976
      },
      "text": "གཉིས་ཀྱི་ ༼སྣར། པེ།༽ གཉིས་ཀྱིས་"
    },
    {
      "span": {
        "start": 44074,
        "end": 44081
      },
      "text": "འགལ་བར་ ༼སྣར། པེ།༽ དགག་པར་"
    },
    {
      "span": {
        "start": 44129,
        "end": 44141
      },
      "text": "ཐམས་ཅད་ཀྱིས། ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི།"
    },
    {
      "span": {
        "start": 44806,
        "end": 44808
      },
      "text": "ད་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 45151,
        "end": 45156
      },
      "text": "རྗོད་ ༼པེ།༽ བརྗོད་"
    },
    {
      "span": {
        "start": 45161,
        "end": 45165
      },
      "text": "ཀྱི། ༼པེ།༽ ཅི།"
    },
    {
      "span": {
        "start": 45343,
        "end": 45350
      },
      "text": "ཤེས་རབ་ ༼པེ།༽ ཤེས་རབ་ཏུ་"
    },
    {
      "span": {
        "start": 45653,
        "end": 45663
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 45847,
        "end": 45855
      },
      "text": "ངེས་མེད་ ༼སྣར། པེ།༽ དངོས་མེད་"
    },
    {
      "span": {
        "start": 45869,
        "end": 45878
      },
      "text": "གཅིག་གིས་ ༼སྣར། པེ།༽ གཅིག་གི་"
    },
    {
      "span": {
        "start": 46064,
        "end": 46073
      },
      "text": "གཅིག་གིས་ ༼སྣར། པེ།༽ གཅིག་གི་"
    },
    {
      "span": {
        "start": 46125,
        "end": 46132
      },
      "text": "སྤངས་པ་ ༼སྣར། པེ།༽ སྤང་བ་"
    },
    {
      "span": {
        "start": 46138,
        "end": 46144
      },
      "text": "གསུངས། ༼སྣར། པེ།༽ གསུང་།"
    },
    {
      "span": {
        "start": 46265,
        "end": 46269
      },
      "text": "ཡིས་ ༼སྣར། པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 46923,
        "end": 46933
      },
      "text": "ཁྱེད་ཀྱིས་ ༼སྣར།༽ ཁྱེད་ཀྱི་"
    },
    {
      "span": {
        "start": 46964,
        "end": 46973
      },
      "text": "ངེད་ཀྱིས་ ༼སྣར། པེ།༽ ངེས་ཀྱི་"
    },
    {
      "span": {
        "start": 47194,
        "end": 47200
      },
      "text": "རྣམ་པ་ ༼སྣར། པེ།༽ རྣམ་པར་"
    },
    {
      "span": {
        "start": 47340,
        "end": 47348
      },
      "text": "འདི་ལྟར་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 47436,
        "end": 47441
      },
      "text": "བྱའི་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 47448,
        "end": 47455
      },
      "text": "མཁས་པས་ ༼སྣར། པེ།༽ མཁས་པར་"
    },
    {
      "span": {
        "start": 47748,
        "end": 47753
      },
      "text": "འགོག་ ༼ཅོ།༽ འགོག་པ་"
    },
    {
      "span": {
        "start": 47965,
        "end": 47972
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 48170,
        "end": 48175
      },
      "text": "བླངས་ ༼སྣར། པེ།༽ བླང་"
    },
    {
      "span": {
        "start": 48494,
        "end": 48502
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 48670,
        "end": 48678
      },
      "text": "རྟེན་པར་ ༼སྣར། པེ།༽ བརྟེན་པར་"
    },
    {
      "span": {
        "start": 48794,
        "end": 48802
      },
      "text": "འཁྲུག་པ་ ༼སྣར། པེ།༽ འཁྲུལ་བ་"
    },
    {
      "span": {
        "start": 49508,
        "end": 49516
      },
      "text": "རྟོག་པར་ ༼སྣར། པེ།༽ རྟོགས་པར་"
    },
    {
      "span": {
        "start": 49557,
        "end": 49562
      },
      "text": "བྱའི་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 49671,
        "end": 49673
      },
      "text": "པ། ༼སྣར། པེ།༽ པར།"
    },
    {
      "span": {
        "start": 49711,
        "end": 49719
      },
      "text": "དངོས་པོ་ ༼སྣར།༽ དངོས་པོར་"
    },
    {
      "span": {
        "start": 49725,
        "end": 49728
      },
      "text": "ནི། ༼སྣར།༽ ཉིད།"
    },
    {
      "span": {
        "start": 49751,
        "end": 49757
      },
      "text": "སྒྲུབ། ༼སྣར། པེ།༽ བསྒྲུབ།"
    },
    {
      "span": {
        "start": 49826,
        "end": 49838
      },
      "text": "བསྒྲུབ་བྱ་བ། ༼པེ།༽ བསྒྲུབ་བྱ།"
    },
    {
      "span": {
        "start": 49915,
        "end": 49923
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 49976,
        "end": 49984
      },
      "text": "དགག་པ་ལ། ༼སྣར།༽ དགག་པ་པ།"
    },
    {
      "span": {
        "start": 50397,
        "end": 50405
      },
      "text": "ཙམ་གྱིས་ ༼སྣར། པེ།༽ ཙམ་གྱི་"
    },
    {
      "span": {
        "start": 50635,
        "end": 50640
      },
      "text": "བྱའི་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 50816,
        "end": 50832
      },
      "text": "བརྟགས་པའི་རྟག་པ་ ༼པེ།༽ བརྟག་པ་"
    },
    {
      "span": {
        "start": 51105,
        "end": 51109
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ མིན།"
    },
    {
      "span": {
        "start": 51450,
        "end": 51454
      },
      "text": "ཕུལ་ ༼སྣར། པེ།༽ ཡུལ་"
    },
    {
      "span": {
        "start": 51650,
        "end": 51656
      },
      "text": "དང་དུ་ ༼པེ།༽ དང་"
    },
    {
      "span": {
        "start": 51803,
        "end": 51807
      },
      "text": "ཅིས་ ༼སྣར། པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 51919,
        "end": 51925
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 52571,
        "end": 52576
      },
      "text": "བྱའི་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 52986,
        "end": 52997
      },
      "text": "འདོད་པ་ཡིན། ༼སྣར། པེ།༽ འདོད་པ་ཡིས།"
    },
    {
      "span": {
        "start": 53077,
        "end": 53082
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 53354,
        "end": 53364
      },
      "text": "འབྲས་བུའང་ ༼སྣར། པེ།༽ འབྲས་བུའམ་"
    },
    {
      "span": {
        "start": 53440,
        "end": 53452
      },
      "text": "རང་བཞིན་གྱི་ ༼སྣར། པེ།༽ རང་བཞིན་གྱིས་"
    },
    {
      "span": {
        "start": 53550,
        "end": 53552
      },
      "text": "ན། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 54027,
        "end": 54036
      },
      "text": "སྒྲུབ་པར་ ༼སྣར། པེ།༽ བསྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 54288,
        "end": 54296
      },
      "text": "ཅན་གྱིས་ ༼སྣར། པེ།༽ ཅན་གྱི་"
    },
    {
      "span": {
        "start": 54730,
        "end": 54735
      },
      "text": "བྱའི་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 54753,
        "end": 54758
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 55014,
        "end": 55019
      },
      "text": "བྱའི་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 55342,
        "end": 55348
      },
      "text": "སླུའི་ ༼སྣར། པེ།༽ བསླུའི་"
    },
    {
      "span": {
        "start": 55627,
        "end": 55632
      },
      "text": "རྗེས་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 55727,
        "end": 55736
      },
      "text": "རྨོངས་པས་ ༼སྣར། པེ།༽ རྨོངས་པ་"
    },
    {
      "span": {
        "start": 56043,
        "end": 56049
      },
      "text": "འབྱེར་ ༼སྣར། པེ།༽ འབྱེད་"
    },
    {
      "span": {
        "start": 56053,
        "end": 56055
      },
      "text": "བ་ ༼སྣར། པེ།༽ བར་"
    },
    {
      "span": {
        "start": 56111,
        "end": 56117
      },
      "text": "རུལ་པ་ ༼ཅོ།༽ དྲུང་པ་"
    },
    {
      "span": {
        "start": 56592,
        "end": 56599
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 56835,
        "end": 56840
      },
      "text": "སྙེད། ༼སྣར། པེ།༽ རྙེད།"
    },
    {
      "span": {
        "start": 56968,
        "end": 56980
      },
      "text": "བསྒྲུབ་བྱའི་ ༼སྣར། པེ།༽ བསྒྲུབ་བྱ་"
    },
    {
      "span": {
        "start": 57161,
        "end": 57168
      },
      "text": "གྲུབ་པ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 57403,
        "end": 57412
      },
      "text": "ཕྱོགས་སུ་ ༼སྣར། པེ།༽ ཕྱོགས་"
    },
    {
      "span": {
        "start": 57417,
        "end": 57421
      },
      "text": "པའི་ ༼སྣར། པེ།༽ པ་ཡི་"
    },
    {
      "span": {
        "start": 57905,
        "end": 57914
      },
      "text": "བརྫུན་དེ་ ༼སྣར། པེ།༽ བརྫུན་ཏེ་"
    },
    {
      "span": {
        "start": 58122,
        "end": 58124
      },
      "text": "ན། ༼པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 58174,
        "end": 58178
      },
      "text": "ག་ལ་ ༼སྣར། པེ།༽ ག་ལས་"
    },
    {
      "span": {
        "start": 58277,
        "end": 58283
      },
      "text": "མཚན་མ་ ༼སྣར། པེ།༽ མཚན་"
    },
    {
      "span": {
        "start": 58287,
        "end": 58291
      },
      "text": "གཞན་ ༼སྣར། པེ།༽ གཞན་དུ་"
    },
    {
      "span": {
        "start": 58476,
        "end": 58479
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 58624,
        "end": 58633
      },
      "text": "ངེད་ཀྱིས་ ༼སྣར། པེ།༽ ངེད་ཀྱི་"
    },
    {
      "span": {
        "start": 58728,
        "end": 58732
      },
      "text": "གཉི་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 59081,
        "end": 59084
      },
      "text": "ལས། ༼པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 59174,
        "end": 59184
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 59417,
        "end": 59423
      },
      "text": "ལོག་པ་ ༼སྣར། པེ།༽ ལྡོག་པ་"
    },
    {
      "span": {
        "start": 59494,
        "end": 59498
      },
      "text": "མིག་ ༼སྣར། པེ།༽ མིན་"
    },
    {
      "span": {
        "start": 59574,
        "end": 59580
      },
      "text": "གསལ་བ་ ༼སྣར། པེ།༽ བསལ་བ་"
    },
    {
      "span": {
        "start": 59714,
        "end": 59720
      },
      "text": "ལྟ་བུ་ ༼པེ།༽ ལྟ་བུ་ལྟ་བུ་"
    },
    {
      "span": {
        "start": 59989,
        "end": 60000
      },
      "text": "རང་ཉིད་མེད་ ༼པེ།༽ རང་ཉིད་"
    },
    {
      "span": {
        "start": 60138,
        "end": 60150
      },
      "text": "བྱེད་དེ་མེད། ༼སྣར། པེ།༽ བྱེད་མེད་དེ།"
    },
    {
      "span": {
        "start": 60365,
        "end": 60369
      },
      "text": "ཅིར་ ༼སྣར། པེ།༽ ཅིན་"
    },
    {
      "span": {
        "start": 60711,
        "end": 60720
      },
      "text": "བསླབ་སྟེ། ༼སྣར།༽ བསླས་ཏེ ༼པེ།༽ བསླངས་ཏེ།"
    },
    {
      "span": {
        "start": 61043,
        "end": 61050
      },
      "text": "དེ་ཡིད་ ༼སྣར། པེ།༽ དེ་ཡིས་"
    },
    {
      "span": {
        "start": 61446,
        "end": 61450
      },
      "text": "ཡོད་ ༼སྣར། པེ།༽ འདོད་"
    },
    {
      "span": {
        "start": 61458,
        "end": 61463
      },
      "text": "གཅིག་ ༼སྣར།༽ གཉི་ག་"
    },
    {
      "span": {
        "start": 61616,
        "end": 61624
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ དངོས་པོར་"
    },
    {
      "span": {
        "start": 61668,
        "end": 61674
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 61678,
        "end": 61680
      },
      "text": "བ་ ༼སྣར། པེ།༽ བ་དང་"
    },
    {
      "span": {
        "start": 62429,
        "end": 62431
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 62562,
        "end": 62578
      },
      "text": "དངོས་པོ་མ་བརྟགས་ ༼སྣར། པེ།༽ དངོས་པོ་མི་རྟག་"
    },
    {
      "span": {
        "start": 62741,
        "end": 62749
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 62805,
        "end": 62813
      },
      "text": "གྱུར་པར། ༼སྣར། པེ།༽ གྱུར་པ།"
    },
    {
      "span": {
        "start": 63064,
        "end": 63070
      },
      "text": "སྒྲིབ་ ༼སྣར། པེ།༽ བསྒྲིབས་"
    },
    {
      "span": {
        "start": 63307,
        "end": 63314
      },
      "text": "བརྟག་པ་ ༼སྣར། པེ།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 63537,
        "end": 63542
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 63827,
        "end": 63833
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 64234,
        "end": 64242
      },
      "text": "རྣམས་ཡང་ ༼སྣར། པེ།༽ ནམ་ཡང་"
    },
    {
      "span": {
        "start": 64375,
        "end": 64382
      },
      "text": "བྱིས་པ་ ༼སྣར། པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 64519,
        "end": 64524
      },
      "text": "རྟོག་ ༼སྣར།༽ རྟག་"
    },
    {
      "span": {
        "start": 64631,
        "end": 64645
      },
      "text": "མི་གཉིས་འགྲུབ། ༼སྣར། པེ།༽ མི་འགྲུབ་བོ།"
    },
    {
      "span": {
        "start": 64791,
        "end": 64799
      },
      "text": "བརྟག་པར་ ༼སྣར། པེ།༽ བརྟགས་པར་"
    },
    {
      "span": {
        "start": 65042,
        "end": 65049
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ ད་ལྟར་"
    },
    {
      "span": {
        "start": 65201,
        "end": 65204
      },
      "text": "ནས་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 65627,
        "end": 65631
      },
      "text": "མཐོ་ ༼སྣར། པེ།༽ མཐོན་"
    },
    {
      "span": {
        "start": 65721,
        "end": 65730
      },
      "text": "དྲག་པོའི་ ༼སྣར། པེ།༽ དྲག་པའི་"
    },
    {
      "span": {
        "start": 65808,
        "end": 65812
      },
      "text": "བུས་ ༼སྣར། པེ།༽ དུས་"
    },
    {
      "span": {
        "start": 66569,
        "end": 66573
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 66969,
        "end": 66974
      },
      "text": "དབུས་ ༼སྣར། པེ།༽ ཀྱི་བུས་"
    },
    {
      "span": {
        "start": 67002,
        "end": 67009
      },
      "text": "གཅིག་ལ། ༼སྣར། པེ།༽ གཅིག་པ།"
    },
    {
      "span": {
        "start": 67040,
        "end": 67049
      },
      "text": "གཞན་གྱིས་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 67107,
        "end": 67112
      },
      "text": "ཕྱིར་ ༼སྣར། པེ།༽ ཚེ་"
    },
    {
      "span": {
        "start": 67417,
        "end": 67425
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 67602,
        "end": 67606
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 67876,
        "end": 67886
      },
      "text": "འབྲས་བུའི་ ༼སྣར། པེ།༽ འབྲས་བུ་"
    },
    {
      "span": {
        "start": 68365,
        "end": 68380
      },
      "text": "འབྲས་བུ་བསྐྱེད་ ༼སྣར། པེ།༽ འབྲས་བུ་སྐྱེད་"
    },
    {
      "span": {
        "start": 68982,
        "end": 68988
      },
      "text": "དྲི་མ་ ༼སྣར། པེ།༽ གྲིབ་མ་"
    },
    {
      "span": {
        "start": 69090,
        "end": 69094
      },
      "text": "ཉིད་ ༼སྣར།༽ འདི་"
    },
    {
      "span": {
        "start": 69719,
        "end": 69729
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 70533,
        "end": 70540
      },
      "text": "མཁས་པར། ༼སྣར། པེ།༽ མཁས་པའོ།"
    },
    {
      "span": {
        "start": 70548,
        "end": 70556
      },
      "text": "རེས་འགའ་ ༼སྣར། པེ།༽ རེ་འགའ་"
    },
    {
      "span": {
        "start": 71111,
        "end": 71119
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་བར་"
    },
    {
      "span": {
        "start": 71285,
        "end": 71292
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 71933,
        "end": 71941
      },
      "text": "ཕྱིར་ནི་ ༼པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 72026,
        "end": 72028
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནའང་"
    },
    {
      "span": {
        "start": 72612,
        "end": 72622
      },
      "text": "དཔག་པ་ཡིས། ༼སྣར། པེ།༽ དཔག་པ་ཡིན།"
    },
    {
      "span": {
        "start": 73340,
        "end": 73346
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 73349,
        "end": 73354
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིགས་ཏེ་"
    },
    {
      "span": {
        "start": 73359,
        "end": 73363
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ ཡིས།"
    },
    {
      "span": {
        "start": 74092,
        "end": 74096
      },
      "text": "མགལ་ ༼སྣར། པེ།༽ འགལ་"
    },
    {
      "span": {
        "start": 74615,
        "end": 74622
      },
      "text": "སྦྱར་བ་ ༼སྣར། པེ།༽ སྦྱར་བས་"
    },
    {
      "span": {
        "start": 74861,
        "end": 74870
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 75135,
        "end": 75143
      },
      "text": "བརྫུན་པ་ ༼སྣར།༽ བརྫུན་པར་"
    },
    {
      "span": {
        "start": 75310,
        "end": 75315
      },
      "text": "རྟགས་ ༼སྣར། པེ།༽ རྟག་"
    },
    {
      "span": {
        "start": 75339,
        "end": 75348
      },
      "text": "ལ་སོགས་ལ་ ༼སྣར།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 75496,
        "end": 75501
      },
      "text": "བྱའི་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 76077,
        "end": 76082
      },
      "text": "སྤངས། ༼སྣར། པེ།༽ སྤང་།"
    },
    {
      "span": {
        "start": 76515,
        "end": 76523
      },
      "text": "འདིར་ནི་ ༼སྣར། པེ།༽ འདིར་མི་"
    },
    {
      "span": {
        "start": 77074,
        "end": 77077
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 77255,
        "end": 77262
      },
      "text": "བྱས་པས་ ༼སྣར། པེ།༽ བཅས་པར་"
    },
    {
      "span": {
        "start": 77351,
        "end": 77357
      },
      "text": "དང་། ། ༼སྣར། པེ།༽ དག །"
    },
    {
      "span": {
        "start": 77512,
        "end": 77520
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 77942,
        "end": 77946
      },
      "text": "མིན། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 78278,
        "end": 78287
      },
      "text": "ཀུན་གྱིས་ ༼སྣར། པེ།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 78601,
        "end": 78605
      },
      "text": "འགར། ༼པེ།༽ འགལ།"
    },
    {
      "span": {
        "start": 79463,
        "end": 79470
      },
      "text": "མཚན་མས་ ༼སྣར། པེ།༽ ཚད་མས་"
    },
    {
      "span": {
        "start": 79687,
        "end": 79695
      },
      "text": "སྐྱེད་པ་ ༼སྣར། པེ།༽ སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 80012,
        "end": 80016
      },
      "text": "མིན་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 80739,
        "end": 80748
      },
      "text": "དེ་བརྒྱལ་ ༼སྣར། པེ།༽ ཏེ་རྒྱལ་"
    },
    {
      "span": {
        "start": 80966,
        "end": 80973
      },
      "text": "འབྲལ་བ་ ༼སྣར། པེ།༽ འབྲེལ་བ་"
    },
    {
      "span": {
        "start": 80987,
        "end": 80996
      },
      "text": "མེད་པ་ཡི་ ༼སྣར། པེ།༽ མེད་པ་ཡིས་"
    },
    {
      "span": {
        "start": 81058,
        "end": 81068
      },
      "text": "རྣམས་ཀྱིས། ༼སྣར། པེ།༽ རྣམས་ཀྱི།"
    },
    {
      "span": {
        "start": 81138,
        "end": 81140
      },
      "text": "ལ་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 81508,
        "end": 81519
      },
      "text": "སྒྲ་དོན་ཅི་ ༼སྣར། པེ།༽ སྒྲ་དོན་སྤྱི་"
    },
    {
      "span": {
        "start": 81527,
        "end": 81534
      },
      "text": "ཁྱབ་པར་ ༼སྣར། པེ།༽ ཁྱད་པར་"
    },
    {
      "span": {
        "start": 81610,
        "end": 81617
      },
      "text": "སོ་སོར་ ༼སྣར། པེ།༽ སོ་སོ་"
    },
    {
      "span": {
        "start": 82269,
        "end": 82279
      },
      "text": "མེད་འགལ་བ། ༼སྣར། པེ།༽ མེད་ན་འགལ།"
    },
    {
      "span": {
        "start": 82379,
        "end": 82386
      },
      "text": "དག་པའི་ ༼སྣར། པེ།༽ གཡོ་བའི་"
    },
    {
      "span": {
        "start": 82434,
        "end": 82441
      },
      "text": "མེད་དོ། ༼སྣར། པེ།༽ མེད་དེ།"
    },
    {
      "span": {
        "start": 82577,
        "end": 82579
      },
      "text": "ལ་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 82798,
        "end": 82802
      },
      "text": "ལ་མ་ ༼སྣར།༽ ལས་མ་"
    },
    {
      "span": {
        "start": 82981,
        "end": 82988
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 83234,
        "end": 83240
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 83339,
        "end": 83347
      },
      "text": "ཅན་གྱིས་ ༼སྣར། པེ།༽ ཅན་གྱི་"
    },
    {
      "span": {
        "start": 83759,
        "end": 83763
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 83847,
        "end": 83851
      },
      "text": "བཞག་ ༼ཅོ།༽ གཞག་"
    },
    {
      "span": {
        "start": 84186,
        "end": 84195
      },
      "text": "རྟོག་པའི་ ༼སྣར། པེ།༽ བལྟོས་པའི་"
    },
    {
      "span": {
        "start": 84596,
        "end": 84601
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 84747,
        "end": 84758
      },
      "text": "བརྫུན་པ་དེ་ ༼སྣར། པེ།༽ བརྫུན་པ་"
    },
    {
      "span": {
        "start": 84761,
        "end": 84766
      },
      "text": "ཀྱང་། ༼སྣར། པེ།༽ ཀྱང་ནི།"
    },
    {
      "span": {
        "start": 85111,
        "end": 85116
      },
      "text": "འདོད་ ༼སྣར། པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 85131,
        "end": 85133
      },
      "text": "བ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 85391,
        "end": 85397
      },
      "text": "ཉེ་བར་ ༼སྣར། པེ།༽ ཉེས་པར་"
    },
    {
      "span": {
        "start": 86013,
        "end": 86018
      },
      "text": "སྔ་མ་ ༼སྣར། པེ།༽ སྔ་ན་"
    },
    {
      "span": {
        "start": 86500,
        "end": 86509
      },
      "text": "འགྱུར་བར་ ༼པེ།༽ གྱུར་པར་"
    },
    {
      "span": {
        "start": 86582,
        "end": 86589
      },
      "text": "ཞེ་སྣང་ ༼སྣར། པེ།༽ ཞེ་སྡང་"
    },
    {
      "span": {
        "start": 86810,
        "end": 86817
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 87073,
        "end": 87079
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ བདེན་པ་"
    },
    {
      "span": {
        "start": 87541,
        "end": 87546
      },
      "text": "སྨྲས་ ༼སྣར། པེ།༽ སྨྲ་"
    },
    {
      "span": {
        "start": 87649,
        "end": 87653
      },
      "text": "གཞན་ ༼སྣར། པེ།༽ གཞན་ཕྱིར་"
    },
    {
      "span": {
        "start": 88227,
        "end": 88233
      },
      "text": "བརྟེན་ ༼སྡེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 88719,
        "end": 88726
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 88811,
        "end": 88819
      },
      "text": "སྒོམ་པར་ ༼སྣར། པེ།༽ བསྒོམ་པར་"
    },
    {
      "span": {
        "start": 88819,
        "end": 88830
      },
      "text": "བྱེད་པ་ཡིན། ༼སྣར། པེ།༽ བྱེད་པ་ཡིས།"
    },
    {
      "span": {
        "start": 89096,
        "end": 89106
      },
      "text": "ཡིན་པར་ངོ་ ༼སྣར། པེ།༽ ཡིན་པར་དོན་"
    },
    {
      "span": {
        "start": 89129,
        "end": 89138
      },
      "text": "སྒྲུབ་པར་ ༼སྣར། པེ།༽ བསྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 89339,
        "end": 89343
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིར་"
    },
    {
      "span": {
        "start": 89804,
        "end": 89807
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་ན་"
    }
  ]
}