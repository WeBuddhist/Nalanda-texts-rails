{
  "durchens": [
    {
      "span": {
        "start": 64,
        "end": 69
      },
      "text": "སྲེག་ ༼པེ།༽ བསྲེག་"
    },
    {
      "span": {
        "start": 422,
        "end": 427
      },
      "text": "བསྟན་ ༼པེ།༽ སྟན་"
    },
    {
      "span": {
        "start": 618,
        "end": 620
      },
      "text": "གཉིས་བཅིག་པ། ༼པེ།༽ གཉིས་བཙིགཔ།"
    },
    {
      "span": {
        "start": 2257,
        "end": 2264
      },
      "text": "མེད་པར་ ༼པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 2396,
        "end": 2410
      },
      "text": "འོད་ཀྱི་ཏུ་བར་ ༼པེ།༽ འོད་དུ་འབར་"
    },
    {
      "span": {
        "start": 2869,
        "end": 2881
      },
      "text": "དུ་སུ་རྩིའི་ ༼པེ།༽ དུ་པུཙའི་"
    }
  ]
}