{
  "durchens": [
    {
      "span": {
        "start": 2237,
        "end": 2241
      },
      "text": "ཞེན་ ༼ཅོ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 2917,
        "end": 2921
      },
      "text": "རྫས་ ༼ཅོ།༽ བརྫས་"
    },
    {
      "span": {
        "start": 4467,
        "end": 4473
      },
      "text": "དྲན་པ་ ༼ཅོ།༽ དྲན་པར་"
    },
    {
      "span": {
        "start": 8868,
        "end": 8875
      },
      "text": "བརྩད་པ་ ༼ཅོ།༽ བརྩོད་པ་"
    },
    {
      "span": {
        "start": 24665,
        "end": 24669
      },
      "text": "ཚིག་ ༼ཅོ།༽ ཚིགས་"
    },
    {
      "span": {
        "start": 25865,
        "end": 25868
      },
      "text": "རང་ ༼ཅོ།༽ དད་"
    },
    {
      "span": {
        "start": 30423,
        "end": 30431
      },
      "text": "འདྲེས་པ་ ༼ཅོ།༽ འདས་པ་"
    }
  ]
