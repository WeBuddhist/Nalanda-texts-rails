{
  "durchens": [
    {
      "span": {
        "start": 225,
        "end": 231
      },
      "text": "ཡོད་ན། ༼སྣར། པེ།༽ ཡོད་ཀྱིས།"
    },
    {
      "span": {
        "start": 343,
        "end": 350
      },
      "text": "བྱ་སྟེ། ༼སྣར། པེ།༽ བྱས་ཏེ།"
    },
    {
      "span": {
        "start": 456,
        "end": 466
      },
      "text": "འགྱུར་བའི། ༼སྣར། པེ།༽ འགྱུར་བ།"
    },
    {
      "span": {
        "start": 650,
        "end": 660
      },
      "text": "ལ་སོགས་པས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 755,
        "end": 761
      },
      "text": "སྤྱོད་ ༼སྣར། པེ།༽ སྤྱད་"
    },
    {
      "span": {
        "start": 789,
        "end": 794
      },
      "text": "གཏོང་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 1078,
        "end": 1086
      },
      "text": "མཉམ་གཞག་ ༼ཅོ།༽ མཉམ་བཞག་"
    },
    {
      "span": {
        "start": 1151,
        "end": 1163
      },
      "text": "བཟློག་པ་ཡིས། ༼ཅོ།༽ བཟློག་པ་ཡི།"
    },
    {
      "span": {
        "start": 1186,
        "end": 1191
      },
      "text": "ཞིང་། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 1508,
        "end": 1512
      },
      "text": "སྤང་ ༼སྣར། པེ།༽ སྤངས་"
    },
    {
      "span": {
        "start": 2103,
        "end": 2109
      },
      "text": "གཟེགས་ ༼པེ།༽ གཟུགས་"
    },
    {
      "span": {
        "start": 2354,
        "end": 2363
      },
      "text": "ངན་འགྲོར་ ༼སྣར། པེ།༽ ངན་སོང་"
    },
    {
      "span": {
        "start": 2428,
        "end": 2432
      },
      "text": "གཞག་ ༼སྣར། པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 2565,
        "end": 2575
      },
      "text": "བསྐྱེད་པས་ ༼སྣར། པེ།༽ བསྐྱོད་པས་"
    },
    {
      "span": {
        "start": 2700,
        "end": 2708
      },
      "text": "། །དེ་ལ་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 2712,
        "end": 2717
      },
      "text": "འཕེལ་ ༼སྣར། པེ།༽ འཕེལ་བྱ་བ་"
    },
    {
      "span": {
        "start": 2841,
        "end": 2849
      },
      "text": "བརྟན་པར་ ༼པེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 2903,
        "end": 2906
      },
      "text": "ནི། ༼སྣར། པེ།༽ སུ།"
    },
    {
      "span": {
        "start": 3260,
        "end": 3269
      },
      "text": "སེམས་པའོ། ༼སྣར། པེ།༽ སེམས་པས་སོ།"
    },
    {
      "span": {
        "start": 3304,
        "end": 3310
      },
      "text": "བྱས་པ། ༼སྣར། པེ།༽ བྱས་པ་ཞེས་བྱ་བ།"
    }
  ]
}