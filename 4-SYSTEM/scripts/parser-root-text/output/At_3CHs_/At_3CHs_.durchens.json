{
  "durchens": [
    {
      "span": {
        "start": 212,
        "end": 219
      },
      "text": "།མར་གད་ ༼སྣར། པེ།༽ །མརྒཏ་"
    },
    {
      "span": {
        "start": 347,
        "end": 353
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 937,
        "end": 946
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 1007,
        "end": 1012
      },
      "text": "གྱུར། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 1085,
        "end": 1088
      },
      "text": "གད་ ༼སྣར། པེ།༽ གཏ་"
    },
    {
      "span": {
        "start": 1308,
        "end": 1314
      },
      "text": "དཔྱངས། ༼སྣར། པེ།༽ བཅངས།"
    },
    {
      "span": {
        "start": 1316,
        "end": 1320
      },
      "text": "གླུ་ ༼སྣར། པེ།༽ ཀླུ་"
    },
    {
      "span": {
        "start": 1482,
        "end": 1491
      },
      "text": "སྔགས་ཀྱི་ ༼སྣར། པེ།༽ སྔགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 1705,
        "end": 1710
      },
      "text": "བརླབ། ༼སྣར།༽ བརླབས།"
    }
  ]
}