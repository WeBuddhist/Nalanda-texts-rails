{
  "durchens": [
    {
      "span": {
        "start": 494,
        "end": 501
      },
      "text": "དམར་མོ་ ༼སྣར། པེ།༽ དམར་པོ་"
    },
    {
      "span": {
        "start": 508,
        "end": 513
      },
      "text": "སྡོམ་ ༼སྣར། པེ།༽ རྡོམ་"
    },
    {
      "span": {
        "start": 604,
        "end": 612
      },
      "text": "སྔོན་པོ་ ༼སྣར། པེ།༽ སྔོན་སྔོ་སྐྱ་"
    },
    {
      "span": {
        "start": 622,
        "end": 630
      },
      "text": "སྨུག་པོ་ ༼སྣར།༽ སྨུག་མོ་"
    },
    {
      "span": {
        "start": 652,
        "end": 663
      },
      "text": "སྟག་སྐྱ་བོ། ༼སྣར། པེ།༽ སྟག།"
    },
    {
      "span": {
        "start": 669,
        "end": 678
      },
      "text": "སེང་གེའི་ ༼སྣར། པེ།༽ སེང་གེ་"
    },
    {
      "span": {
        "start": 1097,
        "end": 1104
      },
      "text": "མངར་སྣ་ ༼སྣར། པེ།༽ མངར་"
    },
    {
      "span": {
        "start": 1303,
        "end": 1308
      },
      "text": "སོབས་ ༼ཅོ།༽ སྐབས་ ༼སྣར། པེ།༽ སོགས་"
    },
    {
      "span": {
        "start": 1311,
        "end": 1316
      },
      "text": "འབུལ་ ༼སྣར། པེ།༽ དབུལ་"
    },
    {
      "span": {
        "start": 1699,
        "end": 1710
      },
      "text": "ཀླུ་ཆེན་པོ་ ༼སྣར། པེ།༽ ཀླུ་ཆེན་"
    },
    {
      "span": {
        "start": 1910,
        "end": 1918
      },
      "text": "སྲེག་པར་ ༼སྣར། པེ།༽ བསྲེག་པར་"
    },
    {
      "span": {
        "start": 1963,
        "end": 1966
      },
      "text": "ནད་ ༼སྣར། པེ།༽ ནད་པའི་ནད་"
    },
    {
      "span": {
        "start": 2082,
        "end": 2086
      },
      "text": "ལྦུ་ ༼སྣར། པེ།༽ སྦུ་"
    },
    {
      "span": {
        "start": 2201,
        "end": 2204
      },
      "text": "ཙེ་ ༼སྣར། པེ།༽ རྩེ་"
    },
    {
      "span": {
        "start": 2281,
        "end": 2284
      },
      "text": "ཅུ་ ༼སྣར། པེ།༽ བཅུ་"
    },
    {
      "span": {
        "start": 2342,
        "end": 2346
      },
      "text": "འོམ་ ༼སྣར། པེ།༽ འུན་"
    },
    {
      "span": {
        "start": 2677,
        "end": 2681
      },
      "text": "གློ་ ༼སྣར། པེ།༽ ཀླད་ནད་སོགས་གྱུར་ཅིག་ཀླུ་ཡི་ཀློ་"
    },
    {
      "span": {
        "start": 2703,
        "end": 2707
      },
      "text": "བུས་ ༼སྣར། པེ།༽ སྦུས་"
    },
    {
      "span": {
        "start": 2761,
        "end": 2765
      },
      "text": "ལྦུ་ ༼སྣར། པེ།༽ སྦུ་"
    },
    {
      "span": {
        "start": 2978,
        "end": 2981
      },
      "text": "པུ་ ༼སྣར། པེ།༽ སྦུ་"
    },
    {
      "span": {
        "start": 2985,
        "end": 2988
      },
      "text": "ཙེ་ ༼སྣར། པེ།༽ རྩེ་"
    },
    {
      "span": {
        "start": 3011,
        "end": 3015
      },
      "text": "སྐྲ་ ༼སྣར། པེ།༽ སྐྲངས་"
    },
    {
      "span": {
        "start": 3139,
        "end": 3142
      },
      "text": "ཅུ་ ༼སྣར། པེ།༽ བཅུ་"
    },
    {
      "span": {
        "start": 3710,
        "end": 3714
      },
      "text": "དུག་ ༼སྣར། པེ།༽ སྐྲག་"
    },
    {
      "span": {
        "start": 3783,
        "end": 3790
      },
      "text": "འབུལ་བ་ ༼སྣར། པེ།༽ དབུལ་བ་"
    },
    {
      "span": {
        "start": 4133,
        "end": 4138
      },
      "text": "ཕྱུང་ ༼སྣར། པེ།༽ ཕྱུངས་"
    },
    {
      "span": {
        "start": 4191,
        "end": 4196
      },
      "text": "ཕྱུང་ ༼སྣར། པེ།༽ ཕྱུངས་"
    },
    {
      "span": {
        "start": 4222,
        "end": 4227
      },
      "text": "ཕྱུང་ ༼སྣར། པེ།༽ ཕྱུངས་"
    },
    {
      "span": {
        "start": 4366,
        "end": 4372
      },
      "text": "འབྱུང་ ༼སྣར། པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 4537,
        "end": 4546
      },
      "text": "མགོ་མཇུག་ ༼སྣར། པེ།༽ མགོ་གཞུག་"
    },
    {
      "span": {
        "start": 4549,
        "end": 4557
      },
      "text": "སྨྱག་ཤད་ ༼སྣར། པེ།༽ སྨག་ཤད་"
    },
    {
      "span": {
        "start": 4674,
        "end": 4678
      },
      "text": "གཏང་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 4722,
        "end": 4726
      },
      "text": "གཏང་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 4900,
        "end": 4905
      },
      "text": "ཟློས་ ༼སྣར། པེ།༽ བཟློས་"
    },
    {
      "span": {
        "start": 4908,
        "end": 4916
      },
      "text": "གཞུག་གོ། ༼སྣར། པེ།༽ གཞུག།"
    },
    {
      "span": {
        "start": 4939,
        "end": 4948
      },
      "text": "རྡོ་རྗེར་ ༼སྣར། པེ།༽ རྡོ་རྗེས་"
    }
  ]
}