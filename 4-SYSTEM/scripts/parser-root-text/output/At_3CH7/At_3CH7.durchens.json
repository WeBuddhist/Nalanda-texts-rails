{
  "durchens": [
    {
      "span": {
        "start": 120,
        "end": 129
      },
      "text": "མེད་པ་ནས། ༼སྣར། པེ།༽ མེད་པ་ན།"
    },
    {
      "span": {
        "start": 375,
        "end": 382
      },
      "text": "བྱས་ནས། ༼སྣར། པེ།༽ བྱས་ན།"
    },
    {
      "span": {
        "start": 648,
        "end": 662
      },
      "text": "གསུངས་པས་སྤང་། ༼སྣར། པེ།༽ གསུངས་པ་སྤངས།"
    },
    {
      "span": {
        "start": 726,
        "end": 732
      },
      "text": "རང་གི་ ༼སྣར། པེ།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 818,
        "end": 823
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 1035,
        "end": 1044
      },
      "text": "འབྲིང་གི་ ༼སྣར། པེ།༽ འབྲིང་གིས་"
    },
    {
      "span": {
        "start": 1434,
        "end": 1442
      },
      "text": "ཇི་སྲིད་ ༼སྣར། པེ།༽ དེ་སྲིད་"
    },
    {
      "span": {
        "start": 1442,
        "end": 1450
      },
      "text": "སྐྱེ་ཤི་ ༼སྣར། པེ།༽ སྐྱེ་ཤིང་"
    },
    {
      "span": {
        "start": 1683,
        "end": 1689
      },
      "text": "ངེས་པ་ ༼སྣར། པེ།༽ ངེས་པར་"
    },
    {
      "span": {
        "start": 1782,
        "end": 1789
      },
      "text": "བསྒྲུབ། ༼སྣར། པེ།༽ བསྒྲུབས།"
    },
    {
      "span": {
        "start": 1833,
        "end": 1841
      },
      "text": "རིག་མེད་ ༼པེ།༽ རིགས་མེད་"
    },
    {
      "span": {
        "start": 1912,
        "end": 1919
      },
      "text": "དག་ལའང་ ༼སྣར།༽ དག་པའང་"
    },
    {
      "span": {
        "start": 2421,
        "end": 2427
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 2683,
        "end": 2689
      },
      "text": "སྐྱེད། ༼སྣར། པེ།༽ བསྐྱེད།"
    }
  ]
}