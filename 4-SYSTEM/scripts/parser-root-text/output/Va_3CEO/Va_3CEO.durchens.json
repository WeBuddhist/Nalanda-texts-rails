{
  "durchens": [
    {
      "span": {
        "start": 114,
        "end": 116
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་ཕྱག་"
    },
    {
      "span": {
        "start": 203,
        "end": 212
      },
      "text": "རྣམས་ཀྱི། ༼སྣར། པེ།༽ རྣམས་ཀྱིས།"
    },
    {
      "span": {
        "start": 469,
        "end": 475
      },
      "text": "དེ་དག་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 542,
        "end": 544
      },
      "text": "པ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 603,
        "end": 609
      },
      "text": "དེ་ཡི་ ༼སྣར། པེ།༽ དེ་ཡིས་"
    },
    {
      "span": {
        "start": 663,
        "end": 677
      },
      "text": "ཀུན་རྟོགས་ཞེས་ ༼སྣར། པེ།༽ ཀུན་རྟོག་ཅེས་"
    },
    {
      "span": {
        "start": 989,
        "end": 992
      },
      "text": "ཡི། ༼སྣར།༽ ཡིན།"
    },
    {
      "span": {
        "start": 1127,
        "end": 1135
      },
      "text": "རྟོག་པས་ ༼སྣར། པེ།༽ རྟོགས་པས་"
    },
    {
      "span": {
        "start": 1152,
        "end": 1154
      },
      "text": "པ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 1196,
        "end": 1209
      },
      "text": "མཚན་ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ མཚན་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 1259,
        "end": 1266
      },
      "text": "བཟུང་བ་ ༼པེ།༽ གཟུང་བ་"
    },
    {
      "span": {
        "start": 1309,
        "end": 1315
      },
      "text": "བརྟགས་ ༼སྣར།༽ རྟགས་"
    },
    {
      "span": {
        "start": 1484,
        "end": 1489
      },
      "text": "གཉིས་ ༼སྣར།༽ གཉིས་པ་མང་"
    },
    {
      "span": {
        "start": 1590,
        "end": 1599
      },
      "text": "བརྟག་པའི་ ༼སྣར། པེ།༽ བརྟགས་པའི་"
    },
    {
      "span": {
        "start": 1628,
        "end": 1634
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 1653,
        "end": 1660
      },
      "text": "བྱིས་པ་ ༼སྣར། པེ།༽ བྱིས་པས་"
    },
    {
      "span": {
        "start": 1715,
        "end": 1720
      },
      "text": "ཆ་ཡི་ ༼སྣར། པེ།༽ ཆ་ཡིས་"
    },
    {
      "span": {
        "start": 1825,
        "end": 1834
      },
      "text": "གཉིས་ཀྱི་ ༼སྣར། པེ།༽ གཉིས་ཀྱིས་"
    },
    {
      "span": {
        "start": 2077,
        "end": 2088
      },
      "text": "རང་བཞིན་ཏེ། ༼སྣར། པེ།༽ རང་བཞིན་དེ།"
    },
    {
      "span": {
        "start": 2130,
        "end": 2142
      },
      "text": "རང་བཞིན་ཞེས་ ༼སྣར། པེ།༽ རང་བཞིན་ཤེས་"
    },
    {
      "span": {
        "start": 2207,
        "end": 2216
      },
      "text": "གཉིས་པོས་ ༼སྣར། པེ།༽ གཉིས་པོ་"
    },
    {
      "span": {
        "start": 2320,
        "end": 2351
      },
      "text": "། །དེ་ལྟར་མེད་པའི་རང་བཞིན་པས། ། ༼པེ།༽ ། །"
    },
    {
      "span": {
        "start": 2533,
        "end": 2540
      },
      "text": "ལྟོས་པ་ ༼སྣར། པེ།༽ བལྟོས་པ་"
    },
    {
      "span": {
        "start": 2831,
        "end": 2836
      },
      "text": "རྟགས་ ༼སྣར། པེ།༽ བརྟགས་"
    },
    {
      "span": {
        "start": 3657,
        "end": 3665
      },
      "text": "ཡོང་ཤེས་ ༼སྣར། པེ།༽ ཡོངས་ཤེས་"
    },
    {
      "span": {
        "start": 3935,
        "end": 3945
      },
      "text": "ཡོངས་གྲུབ་ ༼སྣར།༽ སྒྲུབ་ ༼པེ།༽ ཡོངས་སུ་སྒྲུབ་"
    },
    {
      "span": {
        "start": 3965,
        "end": 3973
      },
      "text": "རྟོག་པར་ ༼སྣར། པེ།༽ རྟོགས་པར་"
    },
    {
      "span": {
        "start": 3989,
        "end": 3996
      },
      "text": "བློ་ཡི་ ༼སྣར། པེ།༽ བློ་ཡིས་"
    },
    {
      "span": {
        "start": 4335,
        "end": 4339
      },
      "text": "ཉེར་ ༼པེ།༽ ཉེ་"
    },
    {
      "span": {
        "start": 4604,
        "end": 4608
      },
      "text": "ལྷས་ ༼སྣར། པེ།༽ ལྷ་"
    }
  ]
}