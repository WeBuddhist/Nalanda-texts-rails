{
  "durchens": [
    {
      "span": {
        "start": 81,
        "end": 85
      },
      "text": "གདབ་ ༼སྣར། པེ།༽ བཏབ་"
    },
    {
      "span": {
        "start": 280,
        "end": 285
      },
      "text": "ལྔའི་ ༼སྣར། པེ།༽ ལྔ་"
    },
    {
      "span": {
        "start": 320,
        "end": 328
      },
      "text": "བཞི་ཡང་། ༼སྣར། པེ།༽ བཞི་དང་།"
    },
    {
      "span": {
        "start": 782,
        "end": 785
      },
      "text": "པར་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 1022,
        "end": 1031
      },
      "text": "རྡོ་རྗེར་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 1571,
        "end": 1577
      },
      "text": "བུམ་པ་ ༼སྣར། པེ།༽ བུམ་པའི་"
    }
  ]
}