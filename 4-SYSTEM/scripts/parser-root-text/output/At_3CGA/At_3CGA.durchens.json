{
  "durchens": [
    {
      "span": {
        "start": 455,
        "end": 461
      },
      "text": "བརྫེས་ ༼པེ།༽ རྫེས་"
    },
    {
      "span": {
        "start": 892,
        "end": 898
      },
      "text": "འཆང་བ་ ༼པེ།༽ འཕྱང་བ་"
    },
    {
      "span": {
        "start": 1091,
        "end": 1095
      },
      "text": "བཟང་ ༼པེ།༽ བཟངས་"
    },
    {
      "span": {
        "start": 1110,
        "end": 1114
      },
      "text": "རྣམ་ ༼སྣར།༽ རྣམས་"
    },
    {
      "span": {
        "start": 1357,
        "end": 1360
      },
      "text": "ནི། ༼སྣར།༽ འདི།"
    },
    {
      "span": {
        "start": 1558,
        "end": 1564
      },
      "text": "སྡིགས་ ༼པེ།༽ སྡིག་"
    },
    {
      "span": {
        "start": 1888,
        "end": 1892
      },
      "text": "རྒྱ་ ༼སྣར། པེ།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 1936,
        "end": 1945
      },
      "text": "སྲེག་པའི་ ༼སྣར།༽ བསྲེག་པའི་ ༼པེ།༽ སྲེགས་"
    },
    {
      "span": {
        "start": 2615,
        "end": 2625
      },
      "text": "སྐྱོང་བའི་ ༼སྣར། པེ།༽ སྐྱོབ་པའི་"
    },
    {
      "span": {
        "start": 2935,
        "end": 2939
      },
      "text": "བཟང་ ༼སྣར། པེ།༽ བཟངས་"
    },
    {
      "span": {
        "start": 3136,
        "end": 3140
      },
      "text": "ཟུང་ ༼སྣར།༽ བཟུང་"
    },
    {
      "span": {
        "start": 3277,
        "end": 3285
      },
      "text": "ཐབས་ཀྱི་ ༼སྣར།༽ ཐབས་དང་"
    },
    {
      "span": {
        "start": 3344,
        "end": 3348
      },
      "text": "སྐུ་ ༼སྣར། པེ།༽ སྐུར་"
    }
  ]
}