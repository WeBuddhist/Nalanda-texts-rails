{
  "durchens": [
    {
      "span": {
        "start": 372,
        "end": 376
      },
      "text": "དགུ་ ༼པེ།༽ དགུག་"
    },
    {
      "span": {
        "start": 502,
        "end": 512
      },
      "text": "འཇིག་བྱེད་ ༼སྣར། པེ།༽ འཇིགས་བྱེད་"
    },
    {
      "span": {
        "start": 519,
        "end": 528
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 1605,
        "end": 1612
      },
      "text": "ངལ་བསོ་ ༼སྣར། པེ།༽ ངལ་སོ་"
    },
    {
      "span": {
        "start": 1785,
        "end": 1791
      },
      "text": "བསྐུལ་ ༼སྣར།༽ སྐུལ་"
    },
    {
      "span": {
        "start": 1854,
        "end": 1859
      },
      "text": "ཐོ་བ་ ༼སྣར།༽ ཐོ་"
    }
  ]
}