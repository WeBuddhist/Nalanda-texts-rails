{
  "durchens": [
    {
      "span": {
        "start": 215,
        "end": 221
      },
      "text": "བསམ་པ་ ༼སྣར། པེ།༽ བསམས་པ་"
    },
    {
      "span": {
        "start": 568,
        "end": 574
      },
      "text": "སུ་ནི་ ༼སྣར། པེ།༽ སུས་སྐྱེ་"
    },
    {
      "span": {
        "start": 724,
        "end": 728
      },
      "text": "མིང་ ༼སྣར། པེ།༽ མིན་"
    },
    {
      "span": {
        "start": 733,
        "end": 735
      },
      "text": "པ། ༼སྣར། པེ།༽ པས།"
    },
    {
      "span": {
        "start": 828,
        "end": 835
      },
      "text": "འབྱུང་། ༼སྣར།༽ བྱུང་།"
    },
    {
      "span": {
        "start": 985,
        "end": 992
      },
      "text": "བརྟག་པ་ ༼སྣར། པེ།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 1123,
        "end": 1130
      },
      "text": "ལུས་དང་ ༼སྣར། པེ།༽ ལུས་ཀྱང་"
    },
    {
      "span": {
        "start": 1160,
        "end": 1167
      },
      "text": "ལམ་གྱི་ ༼སྣར། པེ།༽ ལམ་གྱིས་"
    },
    {
      "span": {
        "start": 1447,
        "end": 1452
      },
      "text": "འདུས་ ༼སྣར། པེ།༽ དུས་"
    },
    {
      "span": {
        "start": 1700,
        "end": 1706
      },
      "text": "དེ་ཡང་ ༼སྣར། པེ།༽ དེ་མང་"
    },
    {
      "span": {
        "start": 1710,
        "end": 1717
      },
      "text": "དུ་ཡང་། ༼སྣར། པེ།༽ དུ་ལ།"
    },
    {
      "span": {
        "start": 1723,
        "end": 1726
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 1955,
        "end": 1959
      },
      "text": "གསལ། ༼སྣར། པེ།༽ བསལ།"
    },
    {
      "span": {
        "start": 1961,
        "end": 1968
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ ད་ལྟར་"
    },
    {
      "span": {
        "start": 2118,
        "end": 2125
      },
      "text": "སེམས་པ་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    }
  ]
}