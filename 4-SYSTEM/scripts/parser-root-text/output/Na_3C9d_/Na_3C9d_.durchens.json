{
  "durchens": [
    {
      "span": {
        "start": 26,
        "end": 32
      },
      "text": "ཙ་ཏུར་ ༼སྣར། པེ།༽ ཙ་ཏུ་"
    },
    {
      "span": {
        "start": 92,
        "end": 101
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་པ་"
    },
    {
      "span": {
        "start": 131,
        "end": 137
      },
      "text": "གཟིགས་ ༼སྣར། པེ།༽ གཟིགས་ཀྱི་"
    },
    {
      "span": {
        "start": 793,
        "end": 797
      },
      "text": "འབད་ ༼སྣར། པེ།༽ འབོད་"
    },
    {
      "span": {
        "start": 1237,
        "end": 1246
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 2356,
        "end": 2360
      },
      "text": "མདོ་ ༼སྣར། པེ།༽ མགོ་"
    },
    {
      "span": {
        "start": 2394,
        "end": 2401
      },
      "text": "བསྲུང་། ༼སྣར། པེ།༽ བསྲུངས།"
    },
    {
      "span": {
        "start": 2657,
        "end": 2662
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 2901,
        "end": 2905
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 3008,
        "end": 3016
      },
      "text": "འདི་ཡིས་ ༼སྣར། པེ།༽ འདི་ཡི་"
    },
    {
      "span": {
        "start": 3219,
        "end": 3228
      },
      "text": "གཞན་གྱིས་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 3401,
        "end": 3409
      },
      "text": "འཁྱུད་པ་ ༼སྣར། པེ།༽ འཁྱུད་པའི་"
    },
    {
      "span": {
        "start": 3572,
        "end": 3581
      },
      "text": "ཆེན་པོའི་ ༼སྣར། པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 3943,
        "end": 3952
      },
      "text": "བརྗོད་དེ། ༼སྡེ།༽ བརྗོད་དོ།"
    },
    {
      "span": {
        "start": 4369,
        "end": 4376
      },
      "text": "དགྱེ་བ་ ༼སྣར།༽ སྒྱེ་བ་ ༼པེ།༽ སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 4647,
        "end": 4652
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 4815,
        "end": 4820
      },
      "text": "འཐོར་ ༼སྣར། པེ།༽ མཐོར་"
    },
    {
      "span": {
        "start": 4838,
        "end": 4843
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 4982,
        "end": 4987
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 5089,
        "end": 5094
      },
      "text": "གཞག ། ༼སྣར། པེ།༽ བཞག །"
    },
    {
      "span": {
        "start": 5118,
        "end": 5124
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 5330,
        "end": 5337
      },
      "text": "སྲུང་བ་ ༼སྣར། པེ།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 5544,
        "end": 5552
      },
      "text": "བརྟན་པར་ ༼སྣར། པེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 5819,
        "end": 5824
      },
      "text": "དཔྱང་ ༼སྣར།༽ སྤྱད་ ༼པེ།༽ སྦྱང་"
    },
    {
      "span": {
        "start": 5899,
        "end": 5904
      },
      "text": "ལྟོས། ༼སྣར། པེ།༽ བལྟོས།"
    },
    {
      "span": {
        "start": 6015,
        "end": 6023
      },
      "text": "དིག་པའི་ ༼སྣར། པེ།༽ དིག་མའི་"
    },
    {
      "span": {
        "start": 6182,
        "end": 6189
      },
      "text": "བསྲུང་། ༼སྣར། པེ།༽ བསྲུངས།"
    },
    {
      "span": {
        "start": 6409,
        "end": 6411
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནས་འདུན་"
    },
    {
      "span": {
        "start": 6474,
        "end": 6479
      },
      "text": "མངོན་ ༼སྣར། པེ།༽ སྔོན་"
    },
    {
      "span": {
        "start": 6530,
        "end": 6534
      },
      "text": "ཡིད་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 6856,
        "end": 6861
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 6866,
        "end": 6871
      },
      "text": "བླ་མ་ ༼སྣར། པེ།༽ བླ་མའི་"
    },
    {
      "span": {
        "start": 7459,
        "end": 7463
      },
      "text": "དོན་ ༼སྣར། པེ།༽ ཀུན་"
    },
    {
      "span": {
        "start": 7982,
        "end": 7986
      },
      "text": "རིག་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 8199,
        "end": 8206
      },
      "text": "སྤང་བྱ་ ༼སྣར། པེ།༽ སྦྱང་བྱ་"
    },
    {
      "span": {
        "start": 8216,
        "end": 8220
      },
      "text": "རིག་ ༼སྣར།༽ རིགས་"
    },
    {
      "span": {
        "start": 8249,
        "end": 8255
      },
      "text": "བཞིའོ། ༼སྣར། པེ།༽ བཞི་པོ།"
    },
    {
      "span": {
        "start": 8837,
        "end": 8848
      },
      "text": "ཡེ་ཤེས་ཀྱི། ༼སྣར། པེ།༽ ཡེ་ཤེས་ཀྱིས།"
    }
  ]
}