{
  "durchens": [
    {
      "span": {
        "start": 396,
        "end": 407
      },
      "text": "དུ་བརྫེས་པ། ༼སྣར། པེ།༽ དུ་"
    },
    {
      "span": {
        "start": 429,
        "end": 435
      },
      "text": "གཙིགས་ ༼སྣར། པེ།༽ འགྲེང་བ་"
    },
    {
      "span": {
        "start": 510,
        "end": 515
      },
      "text": "འཛགས་ ༼སྣར།༽ བཙིགས་ ༼པེ།༽ དང་"
    },
    {
      "span": {
        "start": 590,
        "end": 593
      },
      "text": "ལྟ་ ༼སྣར། པེ།༽ འཛག་"
    },
    {
      "span": {
        "start": 647,
        "end": 650
      },
      "text": "དང་ ༼པེ།༽ ལྟར་"
    },
    {
      "span": {
        "start": 765,
        "end": 768
      },
      "text": "ལྔ། ༼སྣར། པེ།༽ ལྔས།"
    },
    {
      "span": {
        "start": 851,
        "end": 853
      },
      "text": "ར་ ༼སྣར། པེ།༽ རཱ་"
    },
    {
      "span": {
        "start": 1008,
        "end": 1010
      },
      "text": "ར་ ༼སྣར། པེ།༽ རཱ་"
    },
    {
      "span": {
        "start": 1012,
        "end": 1014
      },
      "text": "ར། ༼སྣར། པེ།༽ རཱ།"
    },
    {
      "span": {
        "start": 1139,
        "end": 1141
      },
      "text": "ཙ་ ༼སྣར། པེ།༽ ཙོ་"
    },
    {
      "span": {
        "start": 1146,
        "end": 1148
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལིཾ་"
    },
    {
      "span": {
        "start": 1263,
        "end": 1269
      },
      "text": "བསྒྲལ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 1307,
        "end": 1316
      },
      "text": "སྐེ་ཚེ་མ་ ༼སྣར། པེ།༽ སྐེ་ཚེ་"
    },
    {
      "span": {
        "start": 1341,
        "end": 1347
      },
      "text": "བསྐུས་ ༼སྣར། པེ།༽ བསྐུལ་"
    },
    {
      "span": {
        "start": 1669,
        "end": 1678
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 1704,
        "end": 1710
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    }
  ]
}