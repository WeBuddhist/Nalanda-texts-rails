{
  "durchens": [
    {
      "span": {
        "start": 226,
        "end": 228
      },
      "text": "པ་ ༼སྣར། པེ།༽ པས་"
    },
    {
      "span": {
        "start": 456,
        "end": 464
      },
      "text": "བསྒྲལ་བ་ ༼པེ།༽ སྒྲལ་བ་"
    },
    {
      "span": {
        "start": 1046,
        "end": 1051
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 1269,
        "end": 1282
      },
      "text": "སངས་རྒྱས་ཀྱི། ༼སྣར། པེ།༽ སངས་རྒྱས་ཀྱིས།"
    },
    {
      "span": {
        "start": 1308,
        "end": 1314
      },
      "text": "བསྒོམ། ༼སྣར། པེ།༽ བསྒོམས།"
    },
    {
      "span": {
        "start": 1353,
        "end": 1361
      },
      "text": "རིགས་པས་ ༼སྣར། པེ།༽ རིག་པས་"
    },
    {
      "span": {
        "start": 1399,
        "end": 1402
      },
      "text": "ནི། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 1660,
        "end": 1666
      },
      "text": "རྟག་པ་ ༼སྣར། པེ།༽ རྟག་པས་"
    },
    {
      "span": {
        "start": 2248,
        "end": 2253
      },
      "text": "འདྲར་ ༼སྣར། པེ།༽ འདྲ་"
    },
    {
      "span": {
        "start": 3851,
        "end": 3861
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 4004,
        "end": 4011
      },
      "text": "བརྟག་པ་ ༼སྣར། པེ།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 4227,
        "end": 4233
      },
      "text": "སོ་སོ་ ༼སྣར། པེ།༽ སོ་སོར་"
    },
    {
      "span": {
        "start": 4236,
        "end": 4240
      },
      "text": "རིག་ ༼སྣར། པེ།༽ གི་"
    },
    {
      "span": {
        "start": 4404,
        "end": 4408
      },
      "text": "མིན། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 4587,
        "end": 4597
      },
      "text": "ཀུན་གཞིའི་ ༼སྣར། པེ།༽ ཀུན་གཞི་"
    },
    {
      "span": {
        "start": 4645,
        "end": 4650
      },
      "text": "འགྲོ་ ༼སྣར། པེ།༽ སྒྲ་"
    },
    {
      "span": {
        "start": 4764,
        "end": 4774
      },
      "text": "ཀུན་གཞིའི་ ༼སྣར། པེ།༽ ཀུན་གཞི་"
    },
    {
      "span": {
        "start": 5045,
        "end": 5054
      },
      "text": "ངེས་བཞིན་ ༼སྣར། པེ།༽ དེ་བཞིན་"
    },
    {
      "span": {
        "start": 5301,
        "end": 5305
      },
      "text": "འགའ་ ༼སྣར། པེ།༽ དགའ་"
    },
    {
      "span": {
        "start": 5427,
        "end": 5437
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 5489,
        "end": 5500
      },
      "text": "དབྱིབས་ཀྱི་ ༼སྣར། པེ།༽ དབྱིབས་ཀྱིས་"
    },
    {
      "span": {
        "start": 5824,
        "end": 5829
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 5832,
        "end": 5837
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 5896,
        "end": 5901
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 5904,
        "end": 5909
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 6605,
        "end": 6613
      },
      "text": "བསྒོམ་པ་ ༼སྣར། པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 6625,
        "end": 6634
      },
      "text": "བསྒོམ་པར་ ༼སྣར། པེ།༽ སྒོམ་པར་"
    },
    {
      "span": {
        "start": 6761,
        "end": 6767
      },
      "text": "གང་གི་ ༼ཅོ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 7437,
        "end": 7442
      },
      "text": "རྒ་བ་ ༼སྣར། པེ།༽ དགའ་བ་"
    },
    {
      "span": {
        "start": 7442,
        "end": 7445
      },
      "text": "ཡི། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 8777,
        "end": 8786
      },
      "text": "རྟོགས་པས་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 9122,
        "end": 9131
      },
      "text": "འགྱུར་བར་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 9208,
        "end": 9218
      },
      "text": "གྱུར་པ་ཡི། ༼སྣར། པེ།༽ གྱུར་པ་ཡིས།"
    },
    {
      "span": {
        "start": 9529,
        "end": 9542
      },
      "text": "སངས་རྒྱས་ཀྱི། ༼སྣར། པེ།༽ སངས་རྒྱས་ཀྱིས།"
    },
    {
      "span": {
        "start": 9647,
        "end": 9653
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 9882,
        "end": 9889
      },
      "text": "རྡེག་པ་ ༼སྣར། པེ།༽ བདེག་པ་"
    },
    {
      "span": {
        "start": 10053,
        "end": 10056
      },
      "text": "དག་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 10118,
        "end": 10124
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 10415,
        "end": 10426
      },
      "text": "རང་དོན་ཆགས་ ༼སྣར། པེ།༽ རང་དོན་གནས་"
    },
    {
      "span": {
        "start": 10571,
        "end": 10581
      },
      "text": "བསྒོམས་པས་ ༼སྣར། པེ།༽ བསྒོམ་པས་"
    },
    {
      "span": {
        "start": 10654,
        "end": 10665
      },
      "text": "མནར་མེད་པར་ ༼སྣར། པེ།༽ མནར་མེད་པ་"
    },
    {
      "span": {
        "start": 11085,
        "end": 11092
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ དེ་ལྟའང་"
    },
    {
      "span": {
        "start": 11160,
        "end": 11166
      },
      "text": "བལྟམས་ ༼སྣར། པེ།༽ བལྟམ་"
    },
    {
      "span": {
        "start": 11257,
        "end": 11263
      },
      "text": "བསྐོར་ ༼སྣར། པེ།༽ སྐོར་"
    },
    {
      "span": {
        "start": 11279,
        "end": 11285
      },
      "text": "ཀུན་ལ་ ༼སྣར། པེ།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 11789,
        "end": 11796
      },
      "text": "བསགས་ན། ༼སྣར། པེ།༽ བསགས་ནས།"
    },
    {
      "span": {
        "start": 11830,
        "end": 11839
      },
      "text": "གཉིས་ཀྱི་ ༼སྣར། པེ།༽ གཉིས་ཀྱིས་"
    },
    {
      "span": {
        "start": 12306,
        "end": 12313
      },
      "text": "རྟག་པར་ ༼སྣར། པེ།༽ བརྟགས་པར་"
    },
    {
      "span": {
        "start": 12435,
        "end": 12441
      },
      "text": "ཆེ་དེ་ ༼སྣར། པེ།༽ ཆེ་སྟེ་"
    },
    {
      "span": {
        "start": 12589,
        "end": 12596
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 12946,
        "end": 12957
      },
      "text": "མ་གཏོགས་པར། ༼སྣར། པེ།༽ མ་གཏོགས་པས།"
    },
    {
      "span": {
        "start": 13323,
        "end": 13332
      },
      "text": "འཕྲོག་པར་ ༼སྣར། པེ།༽ ཕྲོགས་པར་"
    },
    {
      "span": {
        "start": 13509,
        "end": 13517
      },
      "text": "འབད་ཀྱི། ༼སྣར། པེ།༽ འབད་ཀྱིས།"
    },
    {
      "span": {
        "start": 14045,
        "end": 14051
      },
      "text": "བཅོས་། ༼སྣར། པེ།༽ བཅོས་པ།"
    }
  ]
}