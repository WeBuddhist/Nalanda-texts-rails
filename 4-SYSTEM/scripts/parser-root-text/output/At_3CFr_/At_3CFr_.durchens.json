{
  "durchens": [
    {
      "span": {
        "start": 386,
        "end": 389
      },
      "text": "ལྟ་ ༼སྣར། པེ།༽ བལྟ་"
    },
    {
      "span": {
        "start": 496,
        "end": 500
      },
      "text": "བའོ། ༼སྣར། པེ།༽ ལོ།"
    },
    {
      "span": {
        "start": 645,
        "end": 655
      },
      "text": "སྤྱི་བོའི་ ༼སྣར། པེ།༽ སྤྱི་བོ་"
    },
    {
      "span": {
        "start": 725,
        "end": 734
      },
      "text": "གྱིས་ཆོད་ ༼སྣར།༽ གྱི་ཆོད་ ༼པེ།༽ གྱི་ཚོད་"
    },
    {
      "span": {
        "start": 918,
        "end": 926
      },
      "text": "ལྷང་ངེར་ ༼སྣར། པེ།༽ ལྷང་ངེ་"
    },
    {
      "span": {
        "start": 966,
        "end": 976
      },
      "text": "ཡུངས་འབྲུ་ ༼སྣར། པེ།༽ ཡུངས་འབྲུ་ཙམ་"
    },
    {
      "span": {
        "start": 1425,
        "end": 1431
      },
      "text": "ས་ལེར་ ༼སྣར། པེ།༽ ས་ལེ་"
    }
  ]
}