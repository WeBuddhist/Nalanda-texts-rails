{
  "durchens": [
    {
      "span": {
        "start": 46,
        "end": 48
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནཾ་"
    },
    {
      "span": {
        "start": 197,
        "end": 206
      },
      "text": "འཁོར་ལོར་ ༼སྣར། པེ།༽ འཁོར་ལོས་"
    },
    {
      "span": {
        "start": 534,
        "end": 537
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེར་"
    },
    {
      "span": {
        "start": 558,
        "end": 564
      },
      "text": "བསྒོམ། ༼སྣར། པེ།༽ བསྒོམས།"
    },
    {
      "span": {
        "start": 566,
        "end": 574
      },
      "text": "ཀུན་ཀྱང་ ༼སྣར། པེ།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 698,
        "end": 703
      },
      "text": "བསྟན། ༼སྣར། པེ།༽ བརྟན།"
    },
    {
      "span": {
        "start": 905,
        "end": 911
      },
      "text": "བསྒོམ། ༼སྣར། པེ།༽ བསྒོམས།"
    },
    {
      "span": {
        "start": 1017,
        "end": 1025
      },
      "text": "བསམས་ཏེ། ༼སྣར། པེ།༽ བསམ་སྟེ།"
    },
    {
      "span": {
        "start": 1120,
        "end": 1129
      },
      "text": "གཞན་གྱིས་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 1342,
        "end": 1348
      },
      "text": "བརླབས། ༼སྣར། པེ།༽ བརླབ།"
    },
    {
      "span": {
        "start": 1491,
        "end": 1499
      },
      "text": "བགོས་ཏེ་ ༼སྣར། པེ།༽ བགོ་སྟེ་"
    },
    {
      "span": {
        "start": 1849,
        "end": 1853
      },
      "text": "དངས་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 1893,
        "end": 1898
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 1911,
        "end": 1916
      },
      "text": "སྐྱོ་ ༼སྣར།༽ སྐྱེད་ ༼པེ།༽ སྐྱོད་"
    },
    {
      "span": {
        "start": 1989,
        "end": 1992
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 2028,
        "end": 2033
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིས་"
    }
  ]
}