{
  "durchens": [
    {
      "span": {
        "start": 271,
        "end": 281
      },
      "text": "ཕུང་པོ་ནི་ ༼སྣར། པེ།༽ ཕུང་པོ་"
    },
    {
      "span": {
        "start": 532,
        "end": 537
      },
      "text": "ལ་ནི་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 1827,
        "end": 1829
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལཱ་"
    },
    {
      "span": {
        "start": 2233,
        "end": 2240
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 2473,
        "end": 2482
      },
      "text": "དཀར་པོའོ། ༼སྣར། པེ།༽ དཀར་པོ།"
    },
    {
      "span": {
        "start": 3455,
        "end": 3471
      },
      "text": "བརྒྱན་པའི་ཐོད་པ། ༼སྣར།༽ བརྒྱན་པ།"
    },
    {
      "span": {
        "start": 3540,
        "end": 3548
      },
      "text": "མཚན་པའི་ ༼སྣར། པེ།༽ མཚན་མའི་"
    },
    {
      "span": {
        "start": 4469,
        "end": 4477
      },
      "text": "གུག་དང་། ༼སྣར། པེ།༽ གུག་"
    },
    {
      "span": {
        "start": 4743,
        "end": 4764
      },
      "text": "པ་དང་། ནུ་མའི་བར་དང་། ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 4954,
        "end": 4956
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 4992,
        "end": 4997
      },
      "text": "སརྦྦ་ ༼སྣར། པེ།༽ སརྦ་"
    },
    {
      "span": {
        "start": 5400,
        "end": 5405
      },
      "text": "ཡ་མི་ ༼སྣར། པེ།༽ ཡ་མ་"
    },
    {
      "span": {
        "start": 5736,
        "end": 5740
      },
      "text": "སརྦ་ ༼སྣར། པེ།༽ ཤུདྷཿ་སརྦ་"
    },
    {
      "span": {
        "start": 5961,
        "end": 5970
      },
      "text": "རྡོ་རྗེས་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 6112,
        "end": 6119
      },
      "text": "བསྐྱོད་ ༼སྣར། པེ།༽ བསྐྱོད་པ་"
    },
    {
      "span": {
        "start": 6556,
        "end": 6568
      },
      "text": "རྫོགས་ནས་ནང་ ༼སྣར། པེ།༽ རྫོགས་ནས་"
    },
    {
      "span": {
        "start": 6767,
        "end": 6770
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ནཱི་"
    },
    {
      "span": {
        "start": 6779,
        "end": 6781
      },
      "text": "ར་ ༼སྣར། པེ།༽ རཾ་"
    },
    {
      "span": {
        "start": 6810,
        "end": 6812
      },
      "text": "ཧ་ ༼སྣར། པེ།༽ ཧྲིཿཧ་"
    },
    {
      "span": {
        "start": 6926,
        "end": 6938
      },
      "text": "སྙིང་པོའོ། ། ༼སྣར། པེ།༽ སྙིང་། །ཨོཾ་"
    },
    {
      "span": {
        "start": 7718,
        "end": 7724
      },
      "text": "མཛད་པ། ༼སྣར། པེ།༽ མཛད་"
    }
  ]
}