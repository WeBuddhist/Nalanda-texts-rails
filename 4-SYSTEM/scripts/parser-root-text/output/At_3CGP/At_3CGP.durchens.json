{
  "durchens": [
    {
      "span": {
        "start": 23,
        "end": 30
      },
      "text": "མྲྀ་ཏོ་ ༼སྣར། པེ།༽ མྲྀ་ཏ་"
    },
    {
      "span": {
        "start": 219,
        "end": 225
      },
      "text": "སྤྱོད་ ༼སྣར། པེ།༽ མུན་"
    },
    {
      "span": {
        "start": 234,
        "end": 244
      },
      "text": "དེ་ཡི་དབང་ ༼སྣར། པེ།༽ ཤང་དེའི་ཤ་"
    },
    {
      "span": {
        "start": 256,
        "end": 264
      },
      "text": "དང་པོའི་ ༼སྣར། པེ།༽ དང་བའི་"
    },
    {
      "span": {
        "start": 297,
        "end": 304
      },
      "text": "ལ་སོགས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 375,
        "end": 381
      },
      "text": "ཆུ་ཡི་ ༼སྣར། པེ།༽ ཆུ་ཡིས་"
    },
    {
      "span": {
        "start": 424,
        "end": 430
      },
      "text": "བརྙེས་ ༼སྣར། པེ།༽ སྙེམས་"
    },
    {
      "span": {
        "start": 433,
        "end": 436
      },
      "text": "ཏུ་ ༼སྣར། པེ།༽ བཏུད་"
    },
    {
      "span": {
        "start": 677,
        "end": 686
      },
      "text": "ཇི་ལྟ་བུ་ ༼སྣར། པེ།༽ ཇི་ལྟ་"
    },
    {
      "span": {
        "start": 1349,
        "end": 1363
      },
      "text": "སེམས་བསྐྱེད་པ་ ༼སྣར། པེ།༽ སེམས་བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 1366,
        "end": 1375
      },
      "text": "བསྒུལ་བར་ ༼སྣར། པེ།༽ སྒུལ་བར་"
    },
    {
      "span": {
        "start": 1484,
        "end": 1489
      },
      "text": "བསྟན་ ༼སྣར། པེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 1493,
        "end": 1500
      },
      "text": "རླན་པར་ ༼སྣར། པེ།༽ བརྙན་པར་"
    },
    {
      "span": {
        "start": 1775,
        "end": 1780
      },
      "text": "བསྡུ་ ༼སྣར། པེ།༽ སྡུ་"
    },
    {
      "span": {
        "start": 2238,
        "end": 2257
      },
      "text": "སྨྲ་བའི་སེང་གེ་འདི་ ༼སྣར། པེ།༽ སྨྲ་བའི་སེངྒེས་དེ་"
    },
    {
      "span": {
        "start": 2360,
        "end": 2365
      },
      "text": "དཔྱད་ ༼སྣར།༽ སྤྱད་"
    },
    {
      "span": {
        "start": 2443,
        "end": 2451
      },
      "text": "སྔོན་དུ་ ༼སྣར། པེ།༽ མངོན་དུ་"
    },
    {
      "span": {
        "start": 2545,
        "end": 2555
      },
      "text": "ཅི་ཞིག་བྱ་ ༼སྣར། པེ།༽ ཅི་ཞིག་པ་"
    },
    {
      "span": {
        "start": 2747,
        "end": 2749
      },
      "text": "ཟ་ ༼སྣར། པེ།༽ ཟླ་"
    },
    {
      "span": {
        "start": 2835,
        "end": 2843
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 3330,
        "end": 3346
      },
      "text": "ཞེས་པ་ནི་མཆོད་པ་ ༼སྣར། པེ།༽ ཞེས་བྱ་བ་"
    },
    {
      "span": {
        "start": 3365,
        "end": 3373
      },
      "text": "དབུལ་བར་ ༼སྣར།༽ འབུལ་བར་"
    },
    {
      "span": {
        "start": 3423,
        "end": 3427
      },
      "text": "པའི་ ༼སྣར། པེ།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 3474,
        "end": 3478
      },
      "text": "གཏང་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 3514,
        "end": 3523
      },
      "text": "བྱའོ་ཞེས་ ༼སྣར། པེ།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 3620,
        "end": 3627
      },
      "text": "དེ་སྐད་ ༼སྣར། པེ།༽ འདི་སྐད་"
    },
    {
      "span": {
        "start": 3796,
        "end": 3807
      },
      "text": "གཏོར་མ་ཞེས་ ༼སྣར། པེ།༽ གཏོར་མ་བྱ་བ་"
    },
    {
      "span": {
        "start": 3967,
        "end": 3974
      },
      "text": "བརླབ་པ་ ༼སྣར། པེ།༽ བརླབས་པ་"
    },
    {
      "span": {
        "start": 4159,
        "end": 4166
      },
      "text": "བཅས་པས་ ༼སྣར། པེ།༽ བཅས་པ་"
    },
    {
      "span": {
        "start": 4522,
        "end": 4532
      },
      "text": "ཡིན་པ་སྟེ་ ༼སྣར། པེ།༽ ཡིན་པ་ཏེ་"
    },
    {
      "span": {
        "start": 4678,
        "end": 4684
      },
      "text": "དེ་ཡང་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 4882,
        "end": 4889
      },
      "text": "སྲུང་བ་ ༼སྣར། པེ།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 4901,
        "end": 4907
      },
      "text": "ལྷ་ཡི་ ༼སྣར། པེ།༽ ལྷ་ཡིས་"
    },
    {
      "span": {
        "start": 4982,
        "end": 4991
      },
      "text": "མངོན་སུམ་ ༼སྣར། པེ།༽ མངོན་"
    },
    {
      "span": {
        "start": 5024,
        "end": 5032
      },
      "text": "བདུན་པོ་ ༼སྣར། པེ།༽ བདུན་པོ་དེ་"
    },
    {
      "span": {
        "start": 5153,
        "end": 5160
      },
      "text": "ཉིད་དུ་ ༼པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 5182,
        "end": 5191
      },
      "text": "གཟུང་བའི་ ༼སྣར། པེ།༽ བཟུང་བའི་"
    },
    {
      "span": {
        "start": 5272,
        "end": 5279
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 5338,
        "end": 5346
      },
      "text": "ཆོས་ཞེས་ ༼སྣར། པེ།༽ ཆོས་ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 5369,
        "end": 5371
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 5819,
        "end": 5826
      },
      "text": "བརླབ་པ་ ༼སྣར། པེ།༽ བརླབས་པ་"
    },
    {
      "span": {
        "start": 5966,
        "end": 5977
      },
      "text": "མཆོད་སྦྱིན་ ༼སྣར། པེ།༽ མཆོག་སྦྱིན་"
    },
    {
      "span": {
        "start": 6003,
        "end": 6012
      },
      "text": "འགྲུབ་པར་ ༼སྣར། པེ།༽ བསྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 6166,
        "end": 6173
      },
      "text": "རླན་པར་ ༼སྣར། པེ།༽ བརླན་པར་"
    },
    {
      "span": {
        "start": 6234,
        "end": 6242
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 6425,
        "end": 6430
      },
      "text": "གཟུང་ ༼སྣར།༽ བཟུང་"
    },
    {
      "span": {
        "start": 6453,
        "end": 6458
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གསུངས་"
    },
    {
      "span": {
        "start": 6701,
        "end": 6710
      },
      "text": "གསང་སྔགས་ ༼སྣར།༽ གསང་སྔགས་པ་"
    },
    {
      "span": {
        "start": 6723,
        "end": 6729
      },
      "text": "སྦྱངས་ ༼སྣར། པེ།༽ སྦྱར་"
    },
    {
      "span": {
        "start": 7180,
        "end": 7183
      },
      "text": "དེ་ ༼སྣར། པེ།༽ ཇི་"
    },
    {
      "span": {
        "start": 7260,
        "end": 7269
      },
      "text": "གསུངས་སོ། ༼སྣར། པེ།༽ གསུངས་པའོ།"
    },
    {
      "span": {
        "start": 7312,
        "end": 7321
      },
      "text": "བདུན་པའི་ ༼སྣར། པེ།༽ བདུན་པ་"
    },
    {
      "span": {
        "start": 7388,
        "end": 7396
      },
      "text": "བསམས་ཏེ་ ༼སྣར། པེ།༽ བསམ་སྟེ་"
    },
    {
      "span": {
        "start": 7632,
        "end": 7636
      },
      "text": "ང་བ་ ༼པེ།༽ ང་"
    },
    {
      "span": {
        "start": 7699,
        "end": 7708
      },
      "text": "སྦྱང་བའི་ ༼སྡེ།༽ སྦྱོང་བའི་"
    },
    {
      "span": {
        "start": 7747,
        "end": 7756
      },
      "text": "ལ་སོགས་པ་ ༼པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 7923,
        "end": 7928
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 7975,
        "end": 7984
      },
      "text": "འབྱུང་བས་ ༼སྣར། པེ།༽ བྱུང་བས་"
    },
    {
      "span": {
        "start": 8081,
        "end": 8088
      },
      "text": "ལྷག་མར་ ༼སྣར། པེ།༽ ལྷག་པར་"
    },
    {
      "span": {
        "start": 8162,
        "end": 8171
      },
      "text": "ཞེས་པ་དེ་ ༼སྣར། པེ།༽ ཞེས་པ་"
    },
    {
      "span": {
        "start": 8509,
        "end": 8519
      },
      "text": "འོག་ཏུ་དེ་ ༼སྣར། པེ།༽ འོག་ཏུ་"
    },
    {
      "span": {
        "start": 8629,
        "end": 8638
      },
      "text": "སྦྱང་བའི་ ༼སྣར། པེ།༽ སྦྱངས་པའི་"
    },
    {
      "span": {
        "start": 8938,
        "end": 8947
      },
      "text": "ཞེས་པ་ནི་ ༼སྣར། པེ།༽ ཞེས་པ་སྟེ་"
    },
    {
      "span": {
        "start": 9105,
        "end": 9110
      },
      "text": "མཐུན་ ༼སྣར། པེ།༽ འཐུན་"
    },
    {
      "span": {
        "start": 9360,
        "end": 9369
      },
      "text": "ཞེས་པ་ནི་ ༼སྣར།༽ ཞེས་པ་འགྲོ་བ་ ༼པེ།༽ ཞེས་པ་འགྲོ་བ་ནི་"
    },
    {
      "span": {
        "start": 9856,
        "end": 9862
      },
      "text": "ཞེས་པ་ ༼སྣར། པེ།༽ ཞེས་པ་ནི་"
    },
    {
      "span": {
        "start": 10462,
        "end": 10471
      },
      "text": "དེ་དག་ནི་ ༼སྣར། པེ།༽ དེ་དག་གི་"
    },
    {
      "span": {
        "start": 10535,
        "end": 10543
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ བྱུང་བ་"
    },
    {
      "span": {
        "start": 10756,
        "end": 10764
      },
      "text": "གནས་ཀྱི་ ༼སྣར། པེ།༽ གནས་ཀྱིས་"
    },
    {
      "span": {
        "start": 10773,
        "end": 10777
      },
      "text": "ཕུལ་ ༼སྣར།༽ ཕྲུལ་"
    },
    {
      "span": {
        "start": 10922,
        "end": 10925
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 10949,
        "end": 10953
      },
      "text": "གནས། ༼སྣར། པེ།༽ སུ།"
    },
    {
      "span": {
        "start": 10974,
        "end": 10981
      },
      "text": "གནས་ཏེ་ ༼སྣར། པེ།༽ གནས་དེ་"
    },
    {
      "span": {
        "start": 11019,
        "end": 11023
      },
      "text": "བསམ་ ༼སྣར། པེ།༽ བསམ་པ་"
    },
    {
      "span": {
        "start": 11066,
        "end": 11072
      },
      "text": "བསྒོམ་ ༼སྣར། པེ།༽ སྒོམ་"
    },
    {
      "span": {
        "start": 11139,
        "end": 11149
      },
      "text": "སྤྲིན་གྱི་ ༼སྣར། པེ།༽ སྤྲིན་གྱིས་"
    },
    {
      "span": {
        "start": 11158,
        "end": 11163
      },
      "text": "བསྔོ། ༼སྣར། པེ།༽ སྔོ།"
    },
    {
      "span": {
        "start": 11299,
        "end": 11307
      },
      "text": "བསམ་སྟེ་ ༼སྣར། པེ།༽ བསམས་ཏེ་"
    },
    {
      "span": {
        "start": 11535,
        "end": 11541
      },
      "text": "མཐེའུ་ ༼སྣར། པེ།༽ མཐེ་"
    },
    {
      "span": {
        "start": 11674,
        "end": 11681
      },
      "text": "རེག་པས་ ༼སྣར། པེ།༽ རེག་པས་ཏེ་"
    },
    {
      "span": {
        "start": 11755,
        "end": 11759
      },
      "text": "ཕུབ་ ༼སྣར། པེ།༽ ཕུལ་"
    },
    {
      "span": {
        "start": 11805,
        "end": 11815
      },
      "text": "རིན་པོ་ཆེ་ ༼པེ།༽ རིན་པོ་"
    },
    {
      "span": {
        "start": 11954,
        "end": 11962
      },
      "text": "རྡོ་རྗེ་ ༼སྣར། པེ།༽ རྡོ་རྗེའི་"
    },
    {
      "span": {
        "start": 11990,
        "end": 11997
      },
      "text": "སྦྱར་བ་ ༼སྣར། པེ།༽ སྦྱར་"
    },
    {
      "span": {
        "start": 12036,
        "end": 12044
      },
      "text": "སྟོན་ཏེ། ༼སྣར། པེ།༽ སྟོན་ཏོ།"
    },
    {
      "span": {
        "start": 12123,
        "end": 12132
      },
      "text": "ཡིན་པས་ན་ ༼སྣར། པེ།༽ ཡིན་པ་ནི་"
    },
    {
      "span": {
        "start": 12139,
        "end": 12146
      },
      "text": "ཤེས་རབ་ ༼སྣར། པེ།༽ ཤེས་"
    },
    {
      "span": {
        "start": 12382,
        "end": 12390
      },
      "text": "ཤིས་པའི་ ༼སྣར། པེ།༽ ཤེས་པའི་"
    },
    {
      "span": {
        "start": 12465,
        "end": 12476
      },
      "text": "གཏོར་མ་སྟེ་ ༼སྣར། པེ།༽ གཏོར་མ་ཏེ་"
    },
    {
      "span": {
        "start": 12536,
        "end": 12539
      },
      "text": "ཏི་ ༼སྣར། པེ།༽ ཏ་"
    },
    {
      "span": {
        "start": 12646,
        "end": 12649
      },
      "text": "དེ་ ༼པེ།༽ དེ་ལ་སྔགས་བསྟན་པའི་ཕྱིར་དེ་"
    },
    {
      "span": {
        "start": 12872,
        "end": 12881
      },
      "text": "བདུད་རྩི་ ༼སྣར། པེ།༽ བདུད་རྩིར་"
    },
    {
      "span": {
        "start": 13827,
        "end": 13834
      },
      "text": "གཉམ་པར་ ༼སྣར། པེ།༽ མཉམ་པར་"
    },
    {
      "span": {
        "start": 14146,
        "end": 14155
      },
      "text": "རྣམས་ཞེས་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 14747,
        "end": 14752
      },
      "text": "སྤངས། ༼སྣར། པེ།༽ སྤང་།"
    },
    {
      "span": {
        "start": 15063,
        "end": 15071
      },
      "text": "རེངས་པར་ ༼སྣར། པེ།༽ རེང་བར་"
    },
    {
      "span": {
        "start": 15126,
        "end": 15128
      },
      "text": "པ་ ༼སྣར། པེ།༽ པས་"
    },
    {
      "span": {
        "start": 15147,
        "end": 15154
      },
      "text": "གཟུང་བ་ ༼སྣར། པེ།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 15158,
        "end": 15170
      },
      "text": "དེ་ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ དེ་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 15206,
        "end": 15215
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 15858,
        "end": 15870
      },
      "text": "དེ་རྣམ་པ་དུ་ ༼སྣར། པེ།༽ དེ་རྣམས་"
    },
    {
      "span": {
        "start": 15997,
        "end": 16000
      },
      "text": "དང་ ༼སྣར།༽ དང་འཇིག་རྟེན་ལས་"
    },
    {
      "span": {
        "start": 16540,
        "end": 16560
      },
      "text": "ལོངས་སྤྱོད་ཅེས་བྱ་བ་ ༼སྣར། པེ།༽ ལོངས་སྤྱོད་ཅེས་པ་"
    },
    {
      "span": {
        "start": 17011,
        "end": 17016
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམས་ལ་"
    },
    {
      "span": {
        "start": 17116,
        "end": 17127
      },
      "text": "དེ་སྐད་ཅེས་ ༼སྣར།༽ དེ་སྐད་"
    },
    {
      "span": {
        "start": 17168,
        "end": 17173
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 17368,
        "end": 17373
      },
      "text": "ཕྱིར། ༼སྣར། པེ།༽ ཕྱིར་རོ།"
    },
    {
      "span": {
        "start": 17867,
        "end": 17875
      },
      "text": "བྱས་ཀྱི་ ༼སྣར། པེ།༽ བྱས་ཀྱིས་"
    },
    {
      "span": {
        "start": 17980,
        "end": 17984
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 17989,
        "end": 17993
      },
      "text": "སྟེ། ༼སྣར། པེ།༽ ཏེ།"
    },
    {
      "span": {
        "start": 18066,
        "end": 18075
      },
      "text": "སྲེད་པའི་ ༼སྣར། པེ།༽ སྲིད་པའི་"
    },
    {
      "span": {
        "start": 18101,
        "end": 18110
      },
      "text": "སྒོམ་པའི་ ༼སྣར། པེ།༽ བསྒོམ་པའི་"
    },
    {
      "span": {
        "start": 18382,
        "end": 18384
      },
      "text": "པ་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 18466,
        "end": 18471
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 18504,
        "end": 18507
      },
      "text": "དང་ ༼སྣར། པེ།༽ དང་ཞེས་བྱ་བ་དང་སྦྱར་རོ། །གསང་སྔགས་དང་"
    },
    {
      "span": {
        "start": 18745,
        "end": 18754
      },
      "text": "རྒྱུ་སྟེ་ ༼སྣར། པེ།༽ རྒྱུ་དེ་"
    },
    {
      "span": {
        "start": 18809,
        "end": 18818
      },
      "text": "དོན་གྱིས་ ༼སྣར། པེ།༽ དོན་གྱི་"
    },
    {
      "span": {
        "start": 18865,
        "end": 18872
      },
      "text": "ཤིགས་པ་ ༼སྣར།༽ བཤིགས་པ་"
    },
    {
      "span": {
        "start": 19667,
        "end": 19676
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 19714,
        "end": 19723
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 19833,
        "end": 19843
      },
      "text": "ཟང་ཟིང་གི་ ༼པེ།༽ ཟང་ཟིང་"
    },
    {
      "span": {
        "start": 19873,
        "end": 19878
      },
      "text": "ལྔའོ། ༼སྣར།༽ ལྟའོ།"
    },
    {
      "span": {
        "start": 20136,
        "end": 20142
      },
      "text": "རིག་པ་ ༼སྣར། པེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 20170,
        "end": 20173
      },
      "text": "ཟད་ ༼སྣར། པེ།༽ ཟས་"
    },
    {
      "span": {
        "start": 20272,
        "end": 20277
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམས་དང་"
    },
    {
      "span": {
        "start": 20413,
        "end": 20435
      },
      "text": "བྱིན་གྱི་རླབས་ཀྱིས་ཏེ། ༼སྣར། པེ།༽ བྱིན་གྱིས་བརླབས།"
    },
    {
      "span": {
        "start": 20735,
        "end": 20738
      },
      "text": "དང་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 21162,
        "end": 21166
      },
      "text": "གཞན་ ༼པེ།༽ བཞན་"
    },
    {
      "span": {
        "start": 21173,
        "end": 21187
      },
      "text": "བྱ་བ་ལ་སོགས་པ་ ༼སྣར། པེ།༽ བྱ་བ་སོགས་"
    },
    {
      "span": {
        "start": 22176,
        "end": 22182
      },
      "text": "གཞག་པ་ ༼སྣར། པེ།༽ གཞག་པ་རྣམས་"
    },
    {
      "span": {
        "start": 22189,
        "end": 22191
      },
      "text": "པ་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 22250,
        "end": 22252
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 22375,
        "end": 22382
      },
      "text": "བསྟན་པ་ ༼སྣར།༽ བརྟན་པ་"
    },
    {
      "span": {
        "start": 22491,
        "end": 22500
      },
      "text": "སྒོམ་པའི་ ༼སྣར། པེ།༽ བསྒོམ་པའི་"
    },
    {
      "span": {
        "start": 22663,
        "end": 22669
      },
      "text": "ཅེས་པ་ ༼སྣར། པེ།༽ ཅེས་པས་"
    },
    {
      "span": {
        "start": 22901,
        "end": 22923
      },
      "text": "གྱུར་པ་དང་བག་ལ་ཉལ་གྱི་ ༼སྣར།༽ གྱུར་བག་ལ་ཉལ་ ༼པེ།༽ གྱུར་བག་ལ་"
    },
    {
      "span": {
        "start": 23227,
        "end": 23234
      },
      "text": "གཟུང་བ་ ༼སྣར། པེ།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 23807,
        "end": 23814
      },
      "text": "གིས་མི་ ༼སྣར། པེ།༽ མིང་གི་"
    },
    {
      "span": {
        "start": 23942,
        "end": 23951
      },
      "text": "རིམ་གྱིས་ ༼སྣར། པེ།༽ རིམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 24070,
        "end": 24083
      },
      "text": "མཚན་ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ མཚན་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 24598,
        "end": 24607
      },
      "text": "སྤངས་ཤིང་ ༼སྣར། པེ།༽ སྤངས་"
    },
    {
      "span": {
        "start": 24690,
        "end": 24694
      },
      "text": "འཕང་ ༼སྣར། པེ།༽ འཕངས་"
    },
    {
      "span": {
        "start": 25151,
        "end": 25158
      },
      "text": "རྣམས་ལ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 25247,
        "end": 25255
      },
      "text": "སྨོས་ཏེ། ༼སྣར། པེ།༽ སྨོས་པ།"
    },
    {
      "span": {
        "start": 25542,
        "end": 25550
      },
      "text": "ལ་མར་མེ་ ༼སྣར། པེ།༽ ལ་མར་མེ་མཛད་"
    },
    {
      "span": {
        "start": 25558,
        "end": 25562
      },
      "text": "མཛད། ༼སྣར། པེ།༽ མཛད་པ།"
    },
    {
      "span": {
        "start": 25597,
        "end": 25606
      },
      "text": "འབྱུང་། ། ༼སྣར། པེ།༽ ། །ཡེ་"
    },
    {
      "span": {
        "start": 25613,
        "end": 25620
      },
      "text": "རྣམས་ལ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 25677,
        "end": 25682
      },
      "text": "རླབས། ༼སྣར།༽ དབང་རླབས་ནས་རླབས་བསྐྱེད་པས ༼པེ།༽ དབའ་རླབས་ནས་རླབས་བསྐྱེད་པས།"
    },
    {
      "span": {
        "start": 25697,
        "end": 25700
      },
      "text": "དུ་ ༼སྣར། པེ།༽ དུ་དྲན་ནས་"
    },
    {
      "span": {
        "start": 25778,
        "end": 25784
      },
      "text": "རྩིའི་ ༼སྣར། པེ།༽ རྩི་"
    },
    {
      "span": {
        "start": 25787,
        "end": 25791
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིས་"
    },
    {
      "span": {
        "start": 25823,
        "end": 25828
      },
      "text": "སྐྱེ་ ༼སྣར། པེ།༽ སྐྱེས་"
    },
    {
      "span": {
        "start": 25875,
        "end": 25878
      },
      "text": "ཆད་ ༼སྣར། པེ།༽ བཅད་"
    },
    {
      "span": {
        "start": 25980,
