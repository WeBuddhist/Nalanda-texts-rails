{
  "durchens": [
    {
      "span": {
        "start": 26,
        "end": 30
      },
      "text": "ཙཀྲ་ ༼སྣར། པེ།༽ ཙཀྲཱ་"
    },
    {
      "span": {
        "start": 258,
        "end": 267
      },
      "text": "རིམ་གྱིས་ ༼སྣར། པེ།༽ རིམས་ཀྱི་"
    },
    {
      "span": {
        "start": 324,
        "end": 334
      },
      "text": "ཕུང་པོ་ནི་ ༼སྣར། པེ།༽ ཕུང་པོ་"
    },
    {
      "span": {
        "start": 525,
        "end": 535
      },
      "text": "དེ་ཐམས་ཅད་ ༼སྣར། པེ།༽ དེ་ཐབས་"
    },
    {
      "span": {
        "start": 1280,
        "end": 1283
      },
      "text": "རོ་ ༼སྣར། པེ།༽ ར་"
    },
    {
      "span": {
        "start": 1298,
        "end": 1303
      },
      "text": "སརྦྦ་ ༼སྣར། པེ།༽ སརྦ་"
    },
    {
      "span": {
        "start": 1374,
        "end": 1376
      },
      "text": "ཨ་ ༼སྣར། པེ།༽ ཨཱ་"
    },
    {
      "span": {
        "start": 1383,
        "end": 1385
      },
      "text": "ཨ་ ༼སྣར། པེ།༽ ཨཱ་"
    },
    {
      "span": {
        "start": 1610,
        "end": 1617
      },
      "text": "ཙམ་བསམ་ ༼སྣར། པེ།༽ ཙམ་"
    },
    {
      "span": {
        "start": 4458,
        "end": 4466
      },
      "text": "བརྟན་པར་ ༼སྣར། པེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 4612,
        "end": 4616
      },
      "text": "དམར་ ༼སྣར། པེ།༽ དཀར་"
    },
    {
      "span": {
        "start": 5010,
        "end": 5017
      },
      "text": "གཡོན་པ་ ༼སྣར། པེ།༽ གཡོན་"
    },
    {
      "span": {
        "start": 5381,
        "end": 5386
      },
      "text": "སྩོལ་ ༼སྣར། པེ།༽ གསོལ་"
    },
    {
      "span": {
        "start": 6113,
        "end": 6116
      },
      "text": "ནི་ ༼སྣར།༽ ནཱི་"
    },
    {
      "span": {
        "start": 6332,
        "end": 6335
      },
      "text": "ལུ་ ༼སྣར། པེ།༽ ལཱུ་"
    },
    {
      "span": {
        "start": 6359,
        "end": 6362
      },
      "text": "ཤྭ་ ༼སྣར། པེ།༽ ཤྭཱ་"
    },
    {
      "span": {
        "start": 6481,
        "end": 6488
      },
      "text": "ཡ་མ་དུ་ ༼སྣར། པེ།༽ ཡ་མ་དཱུ་"
    },
    {
      "span": {
        "start": 6518,
        "end": 6520
      },
      "text": "ཐ་ ༼སྣར། པེ།༽ ཐཱ་"
    },
    {
      "span": {
        "start": 6617,
        "end": 6624
      },
      "text": "རྩ་བའི་ ༼སྣར། པེ།༽ རྩ་བའི་ཕྱག་"
    },
    {
      "span": {
        "start": 6886,
        "end": 6896
      },
      "text": "སེམས་དཔའི་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    }
  ]
}