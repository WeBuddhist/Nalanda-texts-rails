{
  "durchens": [
    {
      "span": {
        "start": 20,
        "end": 26
      },
      "text": "བི་གྲ་ ༼སྣར། པེ།༽ ལྱེ་ཀྲ་"
    },
    {
      "span": {
        "start": 613,
        "end": 627
      },
      "text": "མངོན་སུམ་གྱིས། ༼སྣར། པེ།༽ མངོན་སུམ་གྱི།"
    },
    {
      "span": {
        "start": 648,
        "end": 653
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 738,
        "end": 743
      },
      "text": "དཔེར་ ༼སྣར། པེ།༽ ཉེར་"
    },
    {
      "span": {
        "start": 838,
        "end": 845
      },
      "text": "བཏབ་པོ། ༼སྣར།༽ བཏབ་པ།"
    },
    {
      "span": {
        "start": 1133,
        "end": 1137
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ ཡི།"
    },
    {
      "span": {
        "start": 1158,
        "end": 1169
      },
      "text": "འགྱུར་ཞིང་། ༼སྣར། པེ།༽ འགྱུར་ཏེ།"
    },
    {
      "span": {
        "start": 1601,
        "end": 1611
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 1711,
        "end": 1719
      },
      "text": "འགོག་བྱ་ ༼སྣར། པེ།༽ དགག་བྱ་"
    },
    {
      "span": {
        "start": 2037,
        "end": 2043
      },
      "text": "གལ་ཏེ་ ༼སྣར། པེ།༽ ག་ལ་"
    },
    {
      "span": {
        "start": 2323,
        "end": 2325
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 2383,
        "end": 2387
      },
      "text": "ཕྱི་ ༼སྣར། པེ།༽ འཕྱི་"
    },
    {
      "span": {
        "start": 2430,
        "end": 2444
      },
      "text": "གལ་ཏེ་ངའི་ཚིག་ ༼སྣར། པེ།༽ ང་ཡི་ཚིག་ནི་"
    },
    {
      "span": {
        "start": 2545,
        "end": 2555
      },
      "text": "རྟེན་རྣམས་ ༼སྣར། པེ།༽ རྟེན་ནས་"
    },
    {
      "span": {
        "start": 2618,
        "end": 2623
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 2789,
        "end": 2793
      },
      "text": "ཚིག་ ༼སྣར། པེ།༽ ཚིག་ནི་"
    },
    {
      "span": {
        "start": 2793,
        "end": 2799
      },
      "text": "དེ་རང་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 2820,
        "end": 2833
      },
      "text": "ཡི་ཕྱོགས་མཉམ་ ༼སྣར། པེ།༽ ཕྱོགས་མ་ཉམས་"
    },
    {
      "span": {
        "start": 2893,
        "end": 2899
      },
      "text": "སྒྲ་མ་ ༼སྣར། པེ།༽ སྒྲ་མི་"
    },
    {
      "span": {
        "start": 3107,
        "end": 3113
      },
      "text": "འགྲུབ་ ༼སྣར། པེ།༽ གྲུབ་"
    },
    {
      "span": {
        "start": 3189,
        "end": 3201
      },
      "text": "སྤྲུལ་པ་ཡིས། ༼སྣར། པེ།༽ སྤྲུལ་པ་ཡི།"
    },
    {
      "span": {
        "start": 3588,
        "end": 3597
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 3600,
        "end": 3608
      },
      "text": "བསྒྲུབས་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 3612,
        "end": 3622
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 3808,
        "end": 3813
      },
      "text": "གྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 4057,
        "end": 4065
      },
      "text": "དམིགས་མ་ ༼པེ།༽ དམིགས་"
    },
    {
      "span": {
        "start": 4070,
        "end": 4073
      },
      "text": "བས། ༼པེ།༽ བས་ན།"
    },
    {
      "span": {
        "start": 4222,
        "end": 4231
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 4679,
        "end": 4683
      },
      "text": "ལ་མ་ ༼སྣར། པེ།༽ ལས་མ་"
    },
    {
      "span": {
        "start": 4736,
        "end": 4738
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 4984,
        "end": 4988
      },
      "text": "ཡོང་ ༼སྣར། པེ།༽ ཡོངས་"
    },
    {
      "span": {
        "start": 4991,
        "end": 5000
      },
      "text": "གཞལ་བྱ་ལ། ༼སྣར། པེ།༽ གཞལ་བྱ་ལས།"
    },
    {
      "span": {
        "start": 5015,
        "end": 5021
      },
      "text": "འགྲུབ་ ༼པེ།༽ གྲུབ་"
    },
    {
      "span": {
        "start": 5053,
        "end": 5060
      },
      "text": "གཞལ་བར་ ༼སྣར། པེ།༽ གཞལ་བྱར་"
    },
    {
      "span": {
        "start": 5174,
        "end": 5183
      },
      "text": "འགྲུབ་པས་ ༼སྣར། པེ།༽ གྲུབ་པས་"
    },
    {
      "span": {
        "start": 5310,
        "end": 5320
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 5379,
        "end": 5387
      },
      "text": "བསྒྲུབས་ ༼སྣར།༽ གྲུབ་ ༼པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 5523,
        "end": 5533
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 5560,
        "end": 5565
      },
      "text": "གྲུབ། ༼སྣར། པེ།༽ འགྲུབ།"
    },
    {
      "span": {
        "start": 5572,
        "end": 5578
      },
      "text": "དེ་དག་ ༼པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 5578,
        "end": 5583
      },
      "text": "རྣམས་ ༼པེ།༽ རྣམས་སྒྲུབ་"
    },
    {
      "span": {
        "start": 5601,
        "end": 5611
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 5635,
        "end": 5645
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 5757,
        "end": 5763
      },
      "text": "སྨྲོས། ༼སྣར། པེ།༽ སྨོས།"
    },
    {
      "span": {
        "start": 5839,
        "end": 5844
      },
      "text": "གྱུར། ༼པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 5876,
        "end": 5884
      },
      "text": "རྣམས་ནི་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 6028,
        "end": 6037
      },
      "text": "རྣམས་ཀྱི། ༼སྣར། པེ།༽ རྣམས་ཀྱིས།"
    },
    {
      "span": {
        "start": 6039,
        "end": 6056
      },
      "text": "དགེ་བའི་ཆོས་རྣམས་ ༼སྣར། པེ།༽ དགེ་བའི་"
    },
    {
      "span": {
        "start": 6059,
        "end": 6064
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ བཞིན་ཆོས་རྣམས་"
    },
    {
      "span": {
        "start": 6230,
        "end": 6240
      },
      "text": "རྣམས་ཀྱིས། ༼སྣར། པེ།༽ རྣམས་ཀྱི།"
    },
    {
      "span": {
        "start": 6371,
        "end": 6375
      },
      "text": "རྟག་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 6586,
        "end": 6592
      },
      "text": "མི་དེ་ ༼སྣར། པེ།༽ མིང་ནི་"
    },
    {
      "span": {
        "start": 6629,
        "end": 6637
      },
      "text": "བཏབ་ཀྱི། ༼སྣར། པེ།༽ བཏབ་ཀྱིས།"
    },
    {
      "span": {
        "start": 7012,
        "end": 7017
      },
      "text": "འགོག་ ༼སྣར།༽ དགོག་"
    },
    {
      "span": {
        "start": 7421,
        "end": 7426
      },
      "text": "སྐྱེ་ ༼སྣར། པེ།༽ སྐྱེས་"
    },
    {
      "span": {
        "start": 7496,
        "end": 7499
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེར་"
    },
    {
      "span": {
        "start": 7575,
        "end": 7581
      },
      "text": "བརྟེན་ ༼པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 7811,
        "end": 7815
      },
      "text": "སྔར་ ༼པེ།༽ ། །"
    },
    {
      "span": {
        "start": 7820,
        "end": 7827
      },
      "text": "གང་ཡིན་ ༼པེ།༽ གང་ཡིན་པ་"
    },
    {
      "span": {
        "start": 7913,
        "end": 7924
      },
      "text": "གང་ཡིན་སྔར། ༼པེ།༽ གང་ཡིན་པ།"
    },
    {
      "span": {
        "start": 7965,
        "end": 7969
      },
      "text": "ཆེད་ ༼པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 8233,
        "end": 8240
      },
      "text": "རྩོད་པ་ ༼སྣར། པེ།༽ བརྩོད་པ་"
    },
    {
      "span": {
        "start": 8412,
        "end": 8414
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལས།"
    },
    {
      "span": {
        "start": 8442,
        "end": 8444
      },
      "text": "ཨ་ ༼སྣར། པེ།༽ ཨཱ་"
    }
  ]
}