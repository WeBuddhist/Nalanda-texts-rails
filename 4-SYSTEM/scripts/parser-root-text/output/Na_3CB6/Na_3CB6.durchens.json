{
  "durchens": [
    {
      "span": {
        "start": 225,
        "end": 231
      },
      "text": "བྱས་པ་ ༼སྣར། པེ།༽ བཅས་པ་"
    },
    {
      "span": {
        "start": 297,
        "end": 309
      },
      "text": "དགེ་སློང་མང་ ༼སྣར།༽ དགེ་སློང་མ་"
    },
    {
      "span": {
        "start": 341,
        "end": 349
      },
      "text": "ཐབས་ཅིག་ ༼སྣར། པེ།༽ ཐབས་གཅིག་"
    },
    {
      "span": {
        "start": 551,
        "end": 555
      },
      "text": "འདི་ ༼སྣར།༽ འོད་"
    },
    {
      "span": {
        "start": 737,
        "end": 744
      },
      "text": "གྱུར་ན། ༼སྣར། པེ།༽ གྱུར་ནས།"
    },
    {
      "span": {
        "start": 909,
        "end": 925
      },
      "text": "འདིར་སྨོས་ཞེས། ། ༼སྣར། པེ།༽ འདི་སྨྲོས་ཤིག །"
    },
    {
      "span": {
        "start": 966,
        "end": 976
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ བསྒོམས་པའི་"
    },
    {
      "span": {
        "start": 1323,
        "end": 1326
      },
      "text": "ཞི་ ༼སྣར།༽ བཞི་"
    },
    {
      "span": {
        "start": 1728,
        "end": 1734
      },
      "text": "ཐུག་པ་ ༼སྣར། པེ།༽ ཐུགས་པ་"
    },
    {
      "span": {
        "start": 1756,
        "end": 1760
      },
      "text": "རླན་ ༼སྣར། པེ།༽ བརླན་"
    },
    {
      "span": {
        "start": 1763,
        "end": 1770
      },
      "text": "སྨིན་པ་ ༼སྣར། པེ།༽ སྨན་པ་"
    },
    {
      "span": {
        "start": 2130,
        "end": 2137
      },
      "text": "དུས་ལས་ ༼སྣར།༽ དུས་ཀྱིས་ ༼པེ།༽ དུས་ཀྱི་"
    },
    {
      "span": {
        "start": 2224,
        "end": 2235
      },
      "text": "འཇུག་པ་ཡང་། ༼པེ།༽ འཇུག་པ་དང་།"
    },
    {
      "span": {
        "start": 2280,
        "end": 2292
      },
      "text": "ཕྱི་རོལ་གྱི། ༼སྣར། པེ།༽ ཕྱི་རོལ་གྱིས།"
    },
    {
      "span": {
        "start": 2328,
        "end": 2332
      },
      "text": "རྟག་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 2618,
        "end": 2624
      },
      "text": "འདིའི་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 3314,
        "end": 3321
      },
      "text": "སྐྱེ་བ་ ༼སྣར། པེ།༽ སྐྱེ་བར་"
    },
    {
      "span": {
        "start": 3409,
        "end": 3415
      },
      "text": "ལྡན་ལ། ༼སྣར། པེ།༽ ལྡན་པ།"
    },
    {
      "span": {
        "start": 3424,
        "end": 3429
      },
      "text": "སུའི་ ༼སྣར། པེ།༽ སུ་"
    },
    {
      "span": {
        "start": 3595,
        "end": 3603
      },
      "text": "རིག་པའི་ ༼སྣར། པེ།༽ རིག་པས་"
    },
    {
      "span": {
        "start": 3677,
        "end": 3681
      },
      "text": "མིང་ ༼སྣར། པེ།༽ ཤེས་"
    },
    {
      "span": {
        "start": 3799,
        "end": 3804
      },
      "text": "བྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 3836,
        "end": 3846
      },
      "text": "བྱུང་སྲིད་ ༼སྣར། པེ།༽ འབྱུང་སྲེད་"
    },
    {
      "span": {
        "start": 3916,
        "end": 3920
      },
      "text": "ཕུང་ ༼སྣར།༽ ཕུབ་"
    },
    {
      "span": {
        "start": 4028,
        "end": 4032
      },
      "text": "འཆི་ ༼སྣར།༽ མཆི་"
    },
    {
      "span": {
        "start": 4046,
        "end": 4051
      },
      "text": "སྲིད་ ༼སྣར། པེ།༽ སྲེད་"
    },
    {
      "span": {
        "start": 4112,
        "end": 4117
      },
      "text": "སྔགས་ ༼སྣར། པེ།༽ བསྔགས་"
    },
    {
      "span": {
        "start": 4136,
        "end": 4141
      },
      "text": "སྔགས་ ༼སྣར། པེ།༽ བསྔགས་"
    },
    {
      "span": {
        "start": 4178,
        "end": 4184
      },
      "text": "ལྔ་ཡི། ༼སྣར། པེ།༽ ལྔ་ཡིས།"
    },
    {
      "span": {
        "start": 4375,
        "end": 4382
      },
      "text": "དང་མིང་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 4382,
        "end": 4388
      },
      "text": "གཟུགས་ ༼སྣར། པེ།༽ གཟུགས་དང་"
    },
    {
      "span": {
        "start": 4448,
        "end": 4453
      },
      "text": "སྐྱེ་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 4564,
        "end": 4568
      },
      "text": "མིང་ ༼པེ།༽ མིན་"
    },
    {
      "span": {
        "start": 4692,
        "end": 4704
      },
      "text": "ཡང་བརྗོད་དོ། ༼སྣར། པེ།༽ ཡང་དག་བརྗོད།"
    },
    {
      "span": {
        "start": 4742,
        "end": 4746
      },
      "text": "རྟག་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 4757,
        "end": 4763
      },
      "text": "སྐྱེད། ༼སྣར། པེ།༽ སྐྱེ།"
    },
    {
      "span": {
        "start": 4934,
        "end": 4942
      },
      "text": "རྒྱུ་ལས་ ༼སྣར། པེ།༽ རྒྱུ་ལ་"
    },
    {
      "span": {
        "start": 5016,
        "end": 5024
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ ངོ་བོས་"
    },
    {
      "span": {
        "start": 5086,
        "end": 5093
      },
      "text": "རྣམ་པར་ ༼སྣར། པེ།༽ ཉེ་བར་"
    },
    {
      "span": {
        "start": 5170,
        "end": 5176
      },
      "text": "བྱ་ཡི། ༼སྣར། པེ།༽ བྱ་བའི།"
    },
    {
      "span": {
        "start": 5192,
        "end": 5196
      },
      "text": "རླན་ ༼སྣར། པེ།༽ བརླན་"
    },
    {
      "span": {
        "start": 5236,
        "end": 5244
      },
      "text": "བསྟེན་པ་ ༼སྣར། པེ།༽ བསྟེན་པས་"
    },
    {
      "span": {
        "start": 5326,
        "end": 5328
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 5444,
        "end": 5450
      },
      "text": "བརྗོད། ༼སྣར། པེ།༽ རྗོད།"
    },
    {
      "span": {
        "start": 5516,
        "end": 5520
      },
      "text": "མིང་ ༼སྣར། པེ།༽ ཤེས་"
    },
    {
      "span": {
        "start": 5569,
        "end": 5577
      },
      "text": "རང་བཞིན་ ༼སྣར། པེ།༽ རང་གཞན་"
    },
    {
      "span": {
        "start": 5596,
        "end": 5600
      },
      "text": "མིང་ ༼སྣར། པེ།༽ ཤེས་"
    },
    {
      "span": {
        "start": 5619,
        "end": 5623
      },
      "text": "ཡིན་ ༼སྣར། པེ།༽ མིན་"
    },
    {
      "span": {
        "start": 5636,
        "end": 5639
      },
      "text": "ནི་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 5716,
        "end": 5719
      },
      "text": "པར་ ༼སྣར།༽ དང་"
    },
    {
      "span": {
        "start": 5762,
        "end": 5766
      },
      "text": "མིང་ ༼སྣར། པེ།༽ ཤེས་"
    },
    {
      "span": {
        "start": 5823,
        "end": 5829
      },
      "text": "རྒྱུན་ ༼སྣར། པེ།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 5893,
        "end": 5899
      },
      "text": "ཡོད་མ་ ༼སྣར། པེ།༽ ཡོད་པ་"
    },
    {
      "span": {
        "start": 6007,
        "end": 6011
      },
      "text": "ཡིད་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 6081,
        "end": 6100
      },
      "text": "གིས་དེ་བསྐྱེད་ཅིང་། ༼སྣར། པེ།༽ དང་བདག་གིས་ཞེས།"
    },
    {
      "span": {
        "start": 6196,
        "end": 6206
      },
      "text": "རྐྱེན་གྱི་ ༼སྣར། པེ།༽ རྐྱེན་ནི་"
    },
    {
      "span": {
        "start": 6497,
        "end": 6502
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 6626,
        "end": 6632
      },
      "text": "དག་ལས་ ༼སྣར། པེ།༽ དང་ལས་"
    },
    {
      "span": {
        "start": 6652,
        "end": 6660
      },
      "text": "སྐྱེ་བར་ ༼སྣར། པེ།༽ སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 6760,
        "end": 6767
      },
      "text": "འཕོས་པ་ ༼སྣར། པེ།༽ འཕོས་པའང་"
    },
    {
      "span": {
        "start": 6844,
        "end": 6853
      },
      "text": "སྐྱེ་བའང་ ༼སྣར། པེ།༽ སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 6940,
        "end": 6943
      },
      "text": "ལས། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 7521,
        "end": 7524
      },
      "text": "མེ་ ༼སྣར། པེ།༽ མ་"
    },
    {
      "span": {
        "start": 7542,
        "end": 7546
      },
      "text": "མིན། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 7950,
        "end": 7956
      },
      "text": "ཏེ་ལྷ་ ༼སྣར།༽ ནས་ལྷ་ ༼པེ།༽ ནས་ལྷག་"
    },
    {
      "span": {
        "start": 7979,
        "end": 7983
      },
      "text": "རངས་ ༼སྣར། པེ།༽ རང་"
    },
    {
      "span": {
        "start": 8092,
        "end": 8098
      },
      "text": "བྱས་པ་ ༼སྣར། པེ།༽ བྱ་བ་"
    }
  ]
}