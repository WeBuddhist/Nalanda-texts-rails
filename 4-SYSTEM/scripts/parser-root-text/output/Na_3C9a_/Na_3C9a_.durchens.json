{
  "durchens": [
    {
      "span": {
        "start": 333,
        "end": 338
      },
      "text": "རྟོག་ ༼སྣར།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 391,
        "end": 402
      },
      "text": "མདོར་བསྡུས་ ༼སྣར། པེ།༽ དོན་བསྡུས་"
    },
    {
      "span": {
        "start": 442,
        "end": 449
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 847,
        "end": 854
      },
      "text": "དགོན་པ་ ༼སྣར། པེ།༽ མགོན་པོ་"
    },
    {
      "span": {
        "start": 1004,
        "end": 1010
      },
      "text": "སྐྱིལ་ ༼སྣར། པེ།༽ དཀྱིལ་"
    },
    {
      "span": {
        "start": 2021,
        "end": 2023
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལཱ་"
    },
    {
      "span": {
        "start": 2081,
        "end": 2089
      },
      "text": "བཛྲ་ཀཱི་ ༼སྣར། པེ།༽ ཀཱི་"
    },
    {
      "span": {
        "start": 2265,
        "end": 2273
      },
      "text": "གྱུར་པར་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 2292,
        "end": 2297
      },
      "text": "བཅུར་ ༼སྣར། པེ།༽ བཅུ་"
    },
    {
      "span": {
        "start": 3078,
        "end": 3085
      },
      "text": "ཉིད་དང་ ༼སྣར།༽ ཉིད་ཀྱང་"
    },
    {
      "span": {
        "start": 3482,
        "end": 3489
      },
      "text": "སྤྲས། ། ༼སྣར། པེ།༽ ། །ཕྱི་ཡི་དཀྱིལ་འཁོར་ཐིག་གདབ་བྱ། །"
    },
    {
      "span": {
        "start": 3518,
        "end": 3526
      },
      "text": "ཕྲེང་བར་ ༼སྣར། པེ།༽ བྱ་ནི་"
    },
    {
      "span": {
        "start": 3546,
        "end": 3555
      },
      "text": "དྲིལ་བུས་ ༼སྣར། པེ།༽ དྲིལ་བུ་"
    },
    {
      "span": {
        "start": 4153,
        "end": 4161
      },
      "text": "ཅན་གྱིས་ ༼སྣར། པེ།༽ ཅན་གྱི་"
    },
    {
      "span": {
        "start": 4599,
        "end": 4608
      },
      "text": "འཁོར་ལོས་ ༼སྣར། པེ།༽ འཁོར་ལོ་"
    },
    {
      "span": {
        "start": 4702,
        "end": 4707
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 5009,
        "end": 5014
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ གཏོགས་"
    },
    {
      "span": {
        "start": 5945,
        "end": 5950
      },
      "text": "མཁའི་ ༼སྣར། པེ།༽ མཁའ་"
    },
    {
      "span": {
        "start": 6251,
        "end": 6257
      },
      "text": "འགྱུར། ༼སྣར། པེ།༽ གྱུར།"
    },
    {
      "span": {
        "start": 6509,
        "end": 6513
      },
      "text": "ཡིས་ ༼སྣར། པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 6669,
        "end": 6678
      },
      "text": "བསྐྱོད་པ་ ༼སྣར།༽ སྐྱོད་པས་ ༼པེ།༽ བསྐྱོད་པས་"
    },
    {
      "span": {
        "start": 7014,
        "end": 7022
      },
      "text": "མཛད་ཀྱི་ ༼སྣར། པེ།༽ མཛད་འདི་"
    },
    {
      "span": {
        "start": 7236,
        "end": 7245
      },
      "text": "བསྐྱོད་པ་ ༼སྣར།༽ སྐྱོད་པ་"
    },
    {
      "span": {
        "start": 7276,
        "end": 7285
      },
      "text": "མཐིང་ཤུན་ ༼སྣར། པེ།༽ མཐིང་ཤིང་"
    },
    {
      "span": {
        "start": 7911,
        "end": 7916
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 8066,
        "end": 8071
      },
      "text": "ཚིགས་ ༼སྣར། པེ།༽ ཚིག་"
    },
    {
      "span": {
        "start": 8387,
        "end": 8396
      },
      "text": "འཁོར་ལོས་ ༼སྣར། པེ།༽ འཁོར་ལོ་"
    },
    {
      "span": {
        "start": 8638,
        "end": 8642
      },
      "text": "དེར་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 8733,
        "end": 8743
      },
      "text": "སྦྱོར་བའི། ༼སྣར། པེ།༽ སྦྱོར་བ།"
    },
    {
      "span": {
        "start": 8758,
        "end": 8762
      },
      "text": "བསམ་ ༼སྡེ།༽ བསམས་"
    },
    {
      "span": {
        "start": 8896,
        "end": 8900
      },
      "text": "འཆང་ ༼སྣར།༽ ཆང་"
    },
    {
      "span": {
        "start": 9076,
        "end": 9083
      },
      "text": "བསྒོམས་ ༼སྣར།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 9259,
        "end": 9263
      },
      "text": "སྐུ་ ༼སྣར། པེ།༽ སྐུར་"
    },
    {
      "span": {
        "start": 9405,
        "end": 9413
      },
      "text": "ཀུན་གྱི་ ༼སྣར། པེ།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 9566,
        "end": 9573
      },
      "text": "ལྡན་པས། ༼སྣར། པེ།༽ ལྡན་པ།"
    },
    {
      "span": {
        "start": 9669,
        "end": 9679
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 9827,
        "end": 9834
      },
      "text": "བསྒོམས་ ༼སྣར། པེ།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 10114,
        "end": 10122
      },
      "text": "གསུང་གི་ ༼སྣར། པེ།༽ གསུང་གིས་"
    },
    {
      "span": {
        "start": 10370,
        "end": 10379
      },
      "text": "མཐིང་ཤུན་ ༼སྣར། པེ།༽ མཐིང་ཤིང་"
    },
    {
      "span": {
        "start": 10583,
        "end": 10590
      },
      "text": "བསྒོམས་ ༼སྣར། པེ།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 10887,
        "end": 10894
      },
      "text": "བརླབ་པ་ ༼སྣར། པེ།༽ བརླབས་པ་"
    },
    {
      "span": {
        "start": 11483,
        "end": 11492
      },
      "text": "གསུམ་གྱི་ ༼སྣར། པེ།༽ གསུམ་གྱིས་"
    },
    {
      "span": {
        "start": 11788,
        "end": 11791
      },
      "text": "ནི་ ༼ཅོ། སྡེ།༽ ཨཱཿནི་"
    },
    {
      "span": {
        "start": 11919,
        "end": 11930
      },
      "text": "སྒྲོལ་མ་ཡང་ ༼སྣར། པེ།༽ སྒྲོལ་མ་དང་"
    },
    {
      "span": {
        "start": 12359,
        "end": 12361
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 12442,
        "end": 12449
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 12549,
        "end": 12555
      },
      "text": "མངའ་བ་ ༼སྣར། པེ།༽ ལྔ་བ་"
    },
    {
      "span": {
        "start": 12686,
        "end": 12691
      },
      "text": "བསམས་ ༼སྣར།༽ བསམ་"
    },
    {
      "span": {
        "start": 12698,
        "end": 12702
      },
      "text": "འོག་ ༼སྣར། པེ།༽ འོད་"
    },
    {
      "span": {
        "start": 12898,
        "end": 12905
      },
      "text": "ཕཊ་ཀྱི་ ༼སྣར། པེ།༽ ཕཊ་ཀྱིས་"
    },
    {
      "span": {
        "start": 13261,
        "end": 13269
      },
      "text": "རྡོ་རྗེ་ ༼སྣར། པེ།༽ རྡོ་རྗེར་"
    },
    {
      "span": {
        "start": 13328,
        "end": 13333
      },
      "text": "རྒྱན་ ༼སྣར། པེ།༽ བརྒྱན་"
    },
    {
      "span": {
        "start": 13344,
        "end": 13352
      },
      "text": "ཤུན་བཟང་ ༼སྣར། པེ།༽ ཞིང་བཟང་"
    },
    {
      "span": {
        "start": 13768,
        "end": 13771
      },
      "text": "ཡི། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 13795,
        "end": 13801
      },
      "text": "འགྱུར། ༼སྣར། པེ།༽ གྱུར།"
    },
    {
      "span": {
        "start": 13851,
        "end": 13858
      },
      "text": "བསྒོམས་ ༼སྣར། པེ།༽ སྒོམ་"
    },
    {
      "span": {
        "start": 13972,
        "end": 13975
      },
      "text": "སུ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 14326,
        "end": 14329
      },
      "text": "ནག་ ༼སྣར། པེ།༽ གནག་"
    },
    {
      "span": {
        "start": 14473,
        "end": 14479
      },
      "text": "བསྒོམ། ༼སྣར། པེ།༽ སྒོམ།"
    },
    {
      "span": {
        "start": 14718,
        "end": 14724
      },
      "text": "བྱས། ། ༼སྣར། པེ།༽ ། །མགོན་པོ་རལ་པའི་ཐོར་ཚུགས་ཅན། །"
    },
    {
      "span": {
        "start": 15081,
        "end": 15089
      },
      "text": "གའི་འོད། ༼སྣར། པེ།༽ གའི་འོ།"
    },
    {
      "span": {
        "start": 15111,
        "end": 15116
      },
      "text": "རྒྱན་ ༼པེ།༽ བརྒྱན་"
    },
    {
      "span": {
        "start": 15130,
        "end": 15135
      },
      "text": "རལ་པ་ ༼སྣར། པེ།༽ རལ་པའི་"
    },
    {
      "span": {
        "start": 15243,
        "end": 15251
      },
      "text": "ཕྱག་གིས་ ༼སྣར། པེ།༽ ཕྱག་གི་"
    },
    {
      "span": {
        "start": 15366,
        "end": 15371
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 15488,
        "end": 15496
      },
      "text": "དབྱུང་བ། ༼སྣར། པེ།༽ དབྱུང་།"
    },
    {
      "span": {
        "start": 15544,
        "end": 15552
      },
      "text": "ལྗང་གུར་ ༼སྣར། པེ།༽ ལྗང་ཁུར་"
    },
    {
      "span": {
        "start": 15725,
        "end": 15734
      },
      "text": "བསྒོམ་པར་ ༼སྣར། པེ།༽ བསྒོམས་པར་"
    },
    {
      "span": {
        "start": 16012,
        "end": 16018
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 16053,
        "end": 16064
      },
      "text": "ལྷ་མོ་སྤྱན་ ༼སྣར། པེ།༽ ལྷ་མོ་ཅན་"
    },
    {
      "span": {
        "start": 16485,
        "end": 16490
      },
      "text": "གྱུར། ༼སྣར། པེ།༽ བྱ།"
    },
    {
      "span": {
        "start": 16500,
        "end": 16505
      },
      "text": "ཏིའི་ ༼སྣར། པེ།༽ ཏའི་"
    },
    {
      "span": {
        "start": 16829,
        "end": 16837
      },
      "text": "སྲུང་བར་ ༼སྣར། པེ།༽ བསྲུང་བར་"
    },
    {
      "span": {
        "start": 16908,
        "end": 16913
      },
      "text": "ཏིའི་ ༼སྣར། པེ།༽ ཏའི་"
    },
    {
      "span": {
        "start": 17818,
        "end": 17825
      },
      "text": "དབྱུང་། ༼སྣར། པེ།༽ བྱུང་།"
    },
    {
      "span": {
        "start": 17986,
        "end": 17989
      },
      "text": "དག་ ༼སྣར། པེ།༽ དགའ་"
    },
    {
      "span": {
        "start": 18039,
        "end": 18047
      },
      "text": "སྒྲ་སྟེ་ ༼སྣར། པེ།༽ དགྲ་སྟ་"
    },
    {
      "span": {
        "start": 18051,
        "end": 18058
      },
      "text": "དྲུག་མ། ༼སྣར། པེ།༽ དྲུག་པ།"
    },
    {
      "span": {
        "start": 18230,
        "end": 18237
      },
      "text": "དྲུག་མ། ༼སྣར། པེ།༽ དྲུག་པ།"
    },
    {
      "span": {
        "start": 18407,
        "end": 18414
      },
      "text": "དྲུག་མ། ༼སྣར། པེ།༽ དྲུག་པ།"
    },
    {
      "span": {
        "start": 18561,
        "end": 18571
      },
      "text": "འཁོར་ལོའི་ ༼སྣར། པེ།༽ འཁོར་ལོ་"
    },
    {
      "span": {
        "start": 18909,
        "end": 18916
      },
      "text": "དབང་པོ་ ༼སྣར། པེ།༽ དབང་ཕྱུག་"
    },
    {
      "span": {
        "start": 19033,
        "end": 19041
      },
      "text": "དབང་པོར་ ༼སྣར། པེ།༽ བཟང་པོར་"
    },
    {
      "span": {
        "start": 19236,
        "end": 19247
      },
      "text": "སྦྱངས་ཤིང་། ༼སྣར། པེ།༽ སྦྱོང་ཞིང་།"
    },
    {
      "span": {
        "start": 19529,
        "end": 19538
      },
      "text": "བསྣམས་པར་ ༼སྣར། པེ།༽ རྣམ་པར་"
    },
    {
      "span": {
        "start": 19552,
        "end": 19558
      },
      "text": "སྡིགས་ ༼སྣར། པེ།༽ སྡིག་"
    },
    {
      "span": {
        "start": 19597,
        "end": 19627
      },
      "text": "ན། །གཡོན་བརྐྱང་པ་ཡི་གནས་པ་ཡིས། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 19761,
        "end": 19766
      },
      "text": "ཀྱིས་ ༼སྣར། པེ།༽ ཀྱི་"
    },
    {
      "span": {
        "start": 20059,
        "end": 20065
      },
      "text": "སྡིགས་ ༼སྣར། པེ།༽ སྡིག་"
    },
    {
      "span": {
        "start": 20113,
        "end": 20124
      },
      "text": "བརྐྱང་པ་ཡི་ ༼སྣར། པེ།༽ བརྐྱང་པ་ཡིས་"
    },
    {
      "span": {
        "start": 20130,
        "end": 20134
      },
      "text": "ཡིས། ༼སྣར། པེ།༽ ཡི།"
    },
    {
      "span": {
        "start": 20258,
        "end": 20266
      },
      "text": "ཅན་གྱིས་ ༼སྣར། པེ།༽ ཅན་གྱི་"
    },
    {
      "span": {
        "start": 20763,
        "end": 20768
      },
      "text": "ལྗང་། ༼སྣར།༽ སྔོ།"
    },
    {
      "span": {
        "start": 21038,
        "end": 21049
      },
      "text": "བརྐྱང་བ་ཡི་ ༼སྣར། པེ།༽ རྐྱང་པ་ཡིས་"
    },
    {
      "span": {
        "start": 21285,
        "end": 21292
      },
      "text": "མི་བཟད་ ༼སྣར། པེ།༽ མི་ཟད་"
    },
    {
      "span": {
        "start": 21500,
        "end": 21511
      },
      "text": "བརྐྱང་པ་ཡི་ ༼སྣར། པེ།༽ བརྐྱང་པ་ཡིས་"
    },
    {
      "span": {
        "start": 21590,
        "end": 21602
      },
      "text": "བསྐྱེད་པ་ཡི། ༼སྣར། པེ།༽ བསྐྱེད་པ་ཡིས།"
    },
    {
      "span": {
        "start": 21781,
        "end": 21789
      },
      "text": "མཛད་ཀྱི། ༼སྣར། པེ།༽ མཛད་ཀྱིས།"
    },
    {
      "span": {
        "start": 21949,
        "end": 21961
      },
      "text": "བསྐྱེད་པ་ཡི། ༼སྣར། པེ།༽ བསྐྱེད་པ་ཡིས།"
    },
    {
      "span": {
        "start": 22345,
        "end": 22350
      },
      "text": "གྱུར། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 22368,
        "end": 22380
      },
      "text": "བསྐྱེད་པ་ཡི། ༼སྣར། པེ།༽ བསྐྱེད་པ་ཡིས།"
    },
    {
      "span": {
        "start": 22382,
        "end": 22393
      },
      "text": "རྔ་སྒྲ་ཡིས་ ༼སྣར། པེ།༽ རྔ་སྒྲ་ཡི་"
    },
    {
      "span": {
        "start": 22517,
        "end": 22521
      },
      "text": "སྒྲ་ ༼སྣར། པེ།༽ དགྲ་"
    },
    {
      "span": {
        "start": 22671,
        "end": 22677
      },
      "text": "ཞགས་པ་ ༼སྣར། པེ།༽ རལ་གྲི་"
    },
    {
      "span": {
        "start": 22683,
        "end": 22698
      },
      "text": "དགྲ་སྟ་རྣམས་ནི་ ༼སྣར། པེ།༽ ཞགས་པ་དགྲ་སྟ་"
    },
    {
      "span": {
        "start": 22863,
        "end": 22878
      },
      "text": "འཁོར་ལོས་སྒྱུར་ ༼སྣར། པེ།༽ འཁོར་ལོ་བསྒྱུར་"
    },
    {
      "span": {
        "start": 23147,
        "end": 23156
      },
      "text": "འཇིགས་ཅན། ༼སྣར། པེ།༽ འཇིག་ཅིང་།"
    },
    {
      "span": {
        "start": 23654,
        "end": 23658
      },
      "text": "བཀའ་ ༼སྣར། པེ།༽ ཀ་"
    },
    {
      "span": {
        "start": 24246,
        "end": 24254
      },
      "text": "བསླངས་པ་ ༼སྣར། པེ།༽ སླངས་པ་"
    },
    {
      "span": {
        "start": 24254,
        "end": 24258
      },
      "text": "ལའང་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 24302,
        "end": 24311
      },
      "text": "སྔགས་ཀྱི་ ༼སྣར། པེ།༽ སྔགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 24323,
        "end": 24327
      },
      "text": "འདས། ༼སྡེ། ཅོ།༽ བཟླས།"
    },
    {
      "span": {
        "start": 24651,
        "end": 24659
      },
      "text": "སྐུལ་བར་ ༼སྣར། པེ།༽ བསྐུལ་བར་"
    },
    {
      "span": {
        "start": 24855,
        "end": 24861
      },
      "text": "དགྱེས་ ༼སྣར། པེ།༽ བགྱེས་"
    },
    {
      "span": {
        "start": 25155,
        "end": 25164
      },
      "text": "དགོས་པའི་ ༼སྣར། པེ།༽ དགོངས་པའི་"
    },
    {
      "span": {
        "start": 25973,
        "end": 25977
      },
      "text": "འཆི་ ༼སྣར། པེ།༽ མཆི་"
    },
    {
      "span": {
        "start": 25994,
        "end": 25999
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 26636,
        "end": 26643
      },
      "text": "དཔགས་པ་ ༼སྣར། པེ།༽ སྤགས་པ་"
    },
    {
      "span": {
        "start": 26902,
        "end": 26905
      },
      "text": "པར་ ༼སྣར། པེ།༽ སྦར་"
    },
    {
      "span": {
        "start": 27013,
        "end": 27017
      },
      "text": "ཡིས་ ༼སྣར། པེ།༽ ཨ་ཡིས་"
    },
    {
      "span": {
        "start": 27213,
        "end": 27224
      },
      "text": "རྡོ་རྗེ་ཆེ། ༼སྣར། པེ།༽ རྡོ་རྗེ།"
    },
    {
      "span": {
        "start": 27226,
        "end": 27242
      },
      "text": "རྩེ་མོ་ལྔ་པ་རྣམ་ ༼སྣར།༽ རྩེ་ལྔ་པ་རྣམ་ ༼པེ།༽ རྩེ་ལྔ་"
    },
    {
      "span": {
        "start": 27258,
        "end": 27267
      },
      "text": "དབུས་མའི་ ༼སྣར། པེ།༽ དབུ་མའི་"
    },
    {
      "span": {
        "start": 27377,
        "end": 27385
      },
      "text": "བསྲེག་པ་ ༼སྣར། པེ།༽ སྲེག་པ་"
    },
    {
      "span": {
        "start": 27555,
        "end": 27561
      },
      "text": "གང་ཅི་ ༼སྣར། པེ།༽ གང་ཅི་ཡང་"
    },
    {
      "span": {
        "start": 27561,
        "end": 27572
      },
      "text": "རུང་བ་ཆུའི་ ༼སྣར།༽ རུང་བ་ཆུ་ ༼པེ།༽ རུང་ཆུ་"
    },
    {
      "span": {
        "start": 27625,
        "end": 27631
      },
      "text": "གཞུག ། ༼སྣར།༽ བཞག །"
    },
    {
      "span": {
        "start": 27676,
        "end": 27688
      },
      "text": "སྦྱོར་བ་ཡིས། ༼སྣར། པེ།༽ སྦྱོར་བ་ཡི།"
    },
    {
      "span": {
        "start": 27735,
        "end": 27741
      },
      "text": "བརྟག ། ༼པེ།༽ བརྟགས། །"
    },
    {
      "span": {
        "start": 27918,
        "end": 27927
      },
      "text": "བསྲུབས་པ་ ༼སྣར། པེ།༽ བསྲུབ་པ་"
    },
    {
      "span": {
        "start": 27970,
        "end": 27975
      },
      "text": "འཇིག་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 28043,
        "end": 28050
      },
      "text": "ཆེན་པོ་ ༼སྣར། པེ།༽ ཆེན་"
    },
    {
      "span": {
        "start": 28130,
        "end": 28133
      },
      "text": "ཞུ་ ༼སྣར། པེ།༽ ཞུས་"
    }
  ]
}