{
  "durchens": [
    {
      "span": {
        "start": 144,
        "end": 150
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 254,
        "end": 270
      },
      "text": "གང་གིས་བློ་གྲོས་ ༼སྣར། པེ།༽ གང་དག་གི་བློ་"
    },
    {
      "span": {
        "start": 432,
        "end": 441
      },
      "text": "རིགས་པའི་ ༼སྣར། པེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 479,
        "end": 486
      },
      "text": "མཉན་པར་ ༼པེ།༽ མཉམ་པར་"
    },
    {
      "span": {
        "start": 512,
        "end": 518
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 544,
        "end": 550
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 929,
        "end": 937
      },
      "text": "འདས་ཤེས་ ༼སྣར། པེ།༽ འདས་ཞེས་"
    },
    {
      "span": {
        "start": 991,
        "end": 999
      },
      "text": "བརྟགས་པ་ ༼པེ།༽ བརྟག་པ་"
    },
    {
      "span": {
        "start": 1043,
        "end": 1052
      },
      "text": "བྱས་ལྟའི་ ༼སྣར། པེ།༽ བྱས་པའི་"
    },
    {
      "span": {
        "start": 1341,
        "end": 1350
      },
      "text": "གཟིགས་ནས། ༼སྣར། པེ།༽ གཟིགས་ན།"
    },
    {
      "span": {
        "start": 1433,
        "end": 1437
      },
      "text": "འདས། ༼སྣར། པེ།༽ ལས།"
    },
    {
      "span": {
        "start": 1480,
        "end": 1485
      },
      "text": "མཇུག་ ༼པེ།༽ འཇུག་"
    },
    {
      "span": {
        "start": 1590,
        "end": 1596
      },
      "text": "དེ་ཡི་ ༼སྣར། པེ།༽ དེ་ཡིས་"
    },
    {
      "span": {
        "start": 1749,
        "end": 1756
      },
      "text": "རྩོམ་པ་ ༼སྣར། པེ།༽ རྩོན་པ་"
    },
    {
      "span": {
        "start": 1944,
        "end": 1951
      },
      "text": "འགྲོ་བ་ ༼སྣར། པེ།༽ གྲོལ་བ་"
    },
    {
      "span": {
        "start": 2286,
        "end": 2299
      },
      "text": "། །འཁོར་ལོའི་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 2306,
        "end": 2319
      },
      "text": "རྣམ་མི་རྟོག ། ༼སྣར། པེ།༽ རྣམ་པར་མི་ཤེས་སོ། །"
    },
    {
      "span": {
        "start": 2334,
        "end": 2343
      },
      "text": "གང་འབྱུང་ ༼སྣར། པེ།༽ གང་བྱུང་"
    },
    {
      "span": {
        "start": 2383,
        "end": 2391
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ དངོས་པོར་"
    },
    {
      "span": {
        "start": 2469,
        "end": 2476
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 2738,
        "end": 2746
      },
      "text": "རྟོག་པར་ ༼སྣར། པེ།༽ རྟོགས་པར་"
    },
    {
      "span": {
        "start": 2872,
        "end": 2880
      },
      "text": "སོ་སོའི་ ༼སྣར། པེ།༽ སོ་སོ་"
    },
    {
      "span": {
        "start": 3279,
        "end": 3285
      },
      "text": "རྨོངས་ ༼སྣར། པེ།༽ སྨོངས་"
    },
    {
      "span": {
        "start": 3299,
        "end": 3306
      },
      "text": "མི་བཟད་ ༼སྣར། པེ།༽ མི་ཟད་"
    },
    {
      "span": {
        "start": 3491,
        "end": 3502
      },
      "text": "རྒྱུན་གྱིས་ ༼སྣར། པེ།༽ རྒྱུན་གྱི་"
    },
    {
      "span": {
        "start": 3507,
        "end": 3512
      },
      "text": "འབྲང་ ༼སྣར། པེ།༽ འབྲངས་"
    },
    {
      "span": {
        "start": 3651,
        "end": 3656
      },
      "text": "ཕྱིས་ ༼སྣར། པེ།༽ འཕྱིས་"
    },
    {
      "span": {
        "start": 3942,
        "end": 3948
      },
      "text": "གསུངས་ ༼པེ།༽ གསུངས་པ་"
    },
    {
      "span": {
        "start": 4098,
        "end": 4105
      },
      "text": "ལོག་པར་ ༼སྣར། པེ།༽ ལོག་པས་"
    },
    {
      "span": {
        "start": 4283,
        "end": 4296
      },
      "text": "སྤྱོད་ཡུལ་དེ། ༼སྣར། པེ།༽ སྤྱོད་ཡུལ་ཏེ།"
    },
    {
      "span": {
        "start": 4548,
        "end": 4558
      },
      "text": "ཇི་ལྟ་བུར་ ༼སྣར། པེ།༽ ཇི་ལྟ་བུ་"
    },
    {
      "span": {
        "start": 4854,
        "end": 4859
      },
      "text": "རྩོད་ ༼པེ།༽ བརྩོད་"
    },
    {
      "span": {
        "start": 4877,
        "end": 4882
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 5081,
        "end": 5087
      },
      "text": "ཀྱེ་མ་ ༼སྣར། པེ།༽ སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 5334,
        "end": 5338
      },
      "text": "ལྟས་ ༼སྣར། པེ།༽ བལྟས་"
    },
    {
      "span": {
        "start": 5341,
        "end": 5350
      },
      "text": "འཕྲོགས། ། ༼སྣར། པེ།༽ འཕྲོག །"
    },
    {
      "span": {
        "start": 5401,
        "end": 5404
      },
      "text": "ཡི། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 5411,
        "end": 5418
      },
      "text": "མི་བཟད་ ༼སྣར། པེ།༽ མི་ཟད་"
    },
    {
      "span": {
        "start": 5449,
        "end": 5458
      },
      "text": "སྤྱོད་པར་ ༼སྣར། པེ།༽ རྩོད་པར་"
    },
    {
      "span": {
        "start": 5577,
        "end": 5607
      },
      "text": "། །དངོས་པོར་ཁས་ལེན་ཡོད་ན་ནི། ། ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 5682,
        "end": 5691
      },
      "text": "སྐྱེས་པས། ༼སྣར། པེ།༽ སྐྱེས་པར།"
    },
    {
      "span": {
        "start": 5765,
        "end": 5775
      },
      "text": "བདེན་རྫུན་ ༼སྣར། པེ།༽ བདེན་འཛིན་"
    },
    {
      "span": {
        "start": 6019,
        "end": 6025
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 6123,
        "end": 6129
      },
      "text": "འགྱུར། ༼སྣར། པེ།༽ འབྱུང་།"
    },
    {
      "span": {
        "start": 6334,
        "end": 6345
      },
      "text": "ཡེ་ཤེས་ཀྱི། ༼སྣར།༽ ཡེ་ཤེས་ཀྱིས།"
    },
    {
      "span": {
        "start": 6687,
        "end": 6697
      },
      "text": "གང་ཡིན་དེ། ༼སྣར། པེ།༽ གང་ཡིན་ཏེ།"
    },
    {
      "span": {
        "start": 7117,
        "end": 7129
      },
      "text": "དྲུག་ཅུ་པའི་ ༼སྣར། པེ།༽ དྲུག་ཅུའི་"
    },
    {
      "span": {
        "start": 7285,
        "end": 7295
      },
      "text": "གྲགས་ཀྱིས་ ༼སྣར། པེ།༽ གྲགས་ཀྱི་"
    }
  ]
}