{
  "durchens": [
    {
      "span": {
        "start": 325,
        "end": 332
      },
      "text": "སེར་སྣ་ ༼སྣར། པེ།༽ སེམས་ཅན་"
    },
    {
      "span": {
        "start": 707,
        "end": 714
      },
      "text": "བསག་པར་ ༼པེ།༽ བསམ་པར་"
    },
    {
      "span": {
        "start": 747,
        "end": 756
      },
      "text": "སྲུང་བའི་ ༼པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 937,
        "end": 941
      },
      "text": "མངའ་ ༼སྣར། པེ།༽ མཉམ་"
    },
    {
      "span": {
        "start": 1047,
        "end": 1054
      },
      "text": "ཐོགས་པ་ ༼སྣར། པེ།༽ ཐོད་པ་"
    },
    {
      "span": {
        "start": 1203,
        "end": 1206
      },
      "text": "དང་ ༼སྣར། པེ།༽ མནན་"
    },
    {
      "span": {
        "start": 1521,
        "end": 1526
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 1738,
        "end": 1743
      },
      "text": "བརླག་ ༼སྣར།༽ རླག་"
    },
    {
      "span": {
        "start": 1849,
        "end": 1854
      },
      "text": "གདོས་ ༼སྣར། པེ།༽ རྡོས་"
    },
    {
      "span": {
        "start": 1908,
        "end": 1915
      },
      "text": "ལ་སོགས་ ༼སྣར། པེ།༽ ལས་སྦྱར་"
    },
    {
      "span": {
        "start": 1950,
        "end": 1957
      },
      "text": "འགའ་ཙམ་ ༼སྣར། པེ།༽ བག་ཙམ་"
    }
  ]
}