{
  "durchens": [
    {
      "span": {
        "start": 68,
        "end": 76
      },
      "text": "བརྟན་པར་ ༼སྣར། པེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 106,
        "end": 110
      },
      "text": "སྤང་ ༼སྣར། པེ།༽ སྤོང་"
    },
    {
      "span": {
        "start": 373,
        "end": 381
      },
      "text": "བྱུང་བས། ༼པེ།༽ བྱུང་བའི།"
    },
    {
      "span": {
        "start": 1299,
        "end": 1305
      },
      "text": "བསྲུང་ ༼སྣར། པེ།༽ བསྲུངས་"
    },
    {
      "span": {
        "start": 1344,
        "end": 1351
      },
      "text": "རྟག་པས་ ༼སྣར། པེ།༽ བརྟགས་པས་"
    },
    {
      "span": {
        "start": 1351,
        "end": 1355
      },
      "text": "གཅམ་ ༼སྣར། པེ།༽ བཅམ་བུ་དོན་མེད་གླེན་པ་ཡིན། །དེ་བས་ནོར་མེད་དབུལ་ལོ་བསྙེན་དགའ་དང་། །བྲམ་ཟེ་ལྡན་པ་ཕུལ་བ་དག་ལ་སྤྱོད། །དེ་ནི་འཇིག་རྟེན་འདི་ཡི་གཏེར་བསྲུངས་ཡིན། །ཤེས་པས་དམ་པའི་ཆོས་ལ་མི་སྤྱོད་ན། །བརྟགས་པས་བཅམ་"
    },
    {
      "span": {
        "start": 1491,
        "end": 1496
      },
      "text": "བཤེས་ ༼སྣར། པེ།༽ ཤེས་"
    },
    {
      "span": {
        "start": 1537,
        "end": 1544
      },
      "text": "འགའ་ཡི་ ༼སྣར། པེ།༽ འགའ་ཡང་"
    },
    {
      "span": {
        "start": 1863,
        "end": 1869
      },
      "text": "བསྡོས་ ༼སྣར། པེ།༽ སྡོས་"
    },
    {
      "span": {
        "start": 1869,
        "end": 1882
      },
      "text": "ནས་ཟས་དང་ནོར་ ༼པེ།༽ ནས་"
    },
    {
      "span": {
        "start": 2225,
        "end": 2231
      },
      "text": "དང་། ། ༼སྣར། པེ།༽ ། །དྲི་མེད་"
    },
    {
      "span": {
        "start": 2465,
        "end": 2473
      },
      "text": "ཕངས་པའི་ ༼སྣར། པེ།༽ འཕངས་པའི་"
    },
    {
      "span": {
        "start": 2757,
        "end": 2760
      },
      "text": "ཟད་ ༼པེ།༽ བྲས་"
    },
    {
      "span": {
        "start": 2912,
        "end": 2916
      },
      "text": "ནུབ་ ༼སྣར། པེ།༽ ནོད་"
    },
    {
      "span": {
        "start": 2920,
        "end": 2932
      },
      "text": "འམ་གཏོལ་མེད་ ༼སྣར། པེ།༽ འམ་རྟོལ་"
    },
    {
      "span": {
        "start": 3260,
        "end": 3268
      },
      "text": "རིང་པོར་ ༼སྣར། པེ།༽ རིང་པོ་"
    },
    {
      "span": {
        "start": 3320,
        "end": 3325
      },
      "text": "སྟེག་ ༼སྣར། པེ།༽ སྐེག་"
    },
    {
      "span": {
        "start": 3378,
        "end": 3385
      },
      "text": "སྒྱུ་མ་ ༼སྣར། པེ།༽ སྒྱུ་མར་"
    },
    {
      "span": {
        "start": 3510,
        "end": 3514
      },
      "text": "ཚོན་ ༼པེ།༽ མཚོན་"
    },
    {
      "span": {
        "start": 3586,
        "end": 3590
      },
      "text": "རྟག་ ༼པེ།༽ རྟགས་"
    },
    {
      "span": {
        "start": 4007,
        "end": 4013
      },
      "text": "སྐྱིད་ ༼སྣར།༽ བསྐྱིད་"
    },
    {
      "span": {
        "start": 4254,
        "end": 4267
      },
      "text": "ཆེན་པོ་འཐིབས་ ༼སྣར། པེ།༽ ཆེན་པོའི་ཐིབས་"
    },
    {
      "span": {
        "start": 4539,
        "end": 4544
      },
      "text": "གཏོལ་ ༼སྣར། པེ།༽ རྟོལ་"
    },
    {
      "span": {
        "start": 5075,
        "end": 5080
      },
      "text": "འཛེག་ ༼སྣར། པེ།༽ གཟིགས་"
    },
    {
      "span": {
        "start": 5174,
        "end": 5180
      },
      "text": "སྤོང་། ༼སྣར། པེ།༽ སྤོངས།"
    },
    {
      "span": {
        "start": 5345,
        "end": 5349
      },
      "text": "རླག་ ༼སྣར། པེ།༽ བརླག་"
    },
    {
      "span": {
        "start": 5478,
        "end": 5483
      },
      "text": "རིང་། ༼སྣར། པེ།༽ ཞིང་།"
    },
    {
      "span": {
        "start": 5506,
        "end": 5512
      },
      "text": "བསྙེན་ ༼སྣར། པེ།༽ བརྙན་"
    },
    {
      "span": {
        "start": 5663,
        "end": 5669
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 5697,
        "end": 5702
      },
      "text": "སྐུར་ ༼སྣར། པེ།༽ བསྐུལ་"
    },
    {
      "span": {
        "start": 5835,
        "end": 5839
      },
      "text": "བདག་ ༼སྣར། པེ།༽ གདབ་"
    },
    {
      "span": {
        "start": 5998,
        "end": 6003
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིག་"
    },
    {
      "span": {
        "start": 6081,
        "end": 6085
      },
      "text": "བཅད་ ༼སྣར། པེ།༽ གཅད་"
    },
    {
      "span": {
        "start": 6145,
        "end": 6149
      },
      "text": "ཅིས་ ༼པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 6297,
        "end": 6302
      },
      "text": "ཀྱིས་ ༼པེ།༽ ཀྱིས་ཀྱིས་"
    },
    {
      "span": {
        "start": 6707,
        "end": 6709
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལས།"
    },
    {
      "span": {
        "start": 6726,
        "end": 6733
      },
      "text": "སྒོ་ནས་ ༼པེ།༽ སྒོ་ན་"
    },
    {
      "span": {
        "start": 6767,
        "end": 6776
      },
      "text": "ལྟ་བུ་དེ། ༼སྣར། པེ།༽ ལྟ་བུ་སྟེ།"
    },
    {
      "span": {
        "start": 6969,
        "end": 6979
      },
      "text": "ཤེས་རྐྱེན་ ༼སྣར། པེ།༽ ཤེས་བྱེད་རྐྱེན་ནི་"
    },
    {
      "span": {
        "start": 7120,
        "end": 7128
      },
      "text": "དུས་ཀྱི་ ༼སྣར། པེ།༽ དུས་ཀྱིས་"
    },
    {
      "span": {
        "start": 7249,
        "end": 7258
      },
      "text": "ཆོས་ཀྱིས་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 7521,
        "end": 7527
      },
      "text": "ཕན་ཏེ། ༼པེ།༽ ཕན་སྟེ།"
    },
    {
      "span": {
        "start": 7611,
        "end": 7618
      },
      "text": "བརྒྱགས་ ༼སྣར། པེ།༽ རྒྱགས་"
    },
    {
      "span": {
        "start": 8031,
        "end": 8039
      },
      "text": "སྤྲང་པོ་ ༼སྣར། པེ།༽ སྤྲང་བ་"
    },
    {
      "span": {
        "start": 8073,
        "end": 8083
      },
      "text": "ལ་མི་གཏོང་ ༼སྣར། པེ།༽ ལ་མ་བཏང་"
    },
    {
      "span": {
        "start": 8098,
        "end": 8108
      },
      "text": "ཕྱུག་པོའི་ ༼སྣར། པེ།༽ ཕྱུག་པའི་"
    },
    {
      "span": {
        "start": 8245,
        "end": 8253
      },
      "text": "ལས་ཀྱིས་ ༼སྣར། པེ།༽ ལས་ཀྱི་"
    },
    {
      "span": {
        "start": 8291,
        "end": 8295
      },
      "text": "གཅུ་ ༼སྣར། པེ།༽ བཅུད་"
    },
    {
      "span": {
        "start": 8351,
        "end": 8354
      },
      "text": "ཉམ་ ༼སྣར། པེ།༽ ཉམས་"
    },
    {
      "span": {
        "start": 8375,
        "end": 8381
      },
      "text": "དང་། ། ༼སྣར། པེ།༽ དག །"
    },
    {
      "span": {
        "start": 8424,
        "end": 8432
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 8462,
        "end": 8469
      },
      "text": "བཙོན་ར་ ༼སྣར། པེ།༽ བཙོན་རར་"
    },
    {
      "span": {
        "start": 8506,
        "end": 8513
      },
      "text": "བསལ་བར་ ༼སྣར།༽ གསལ་བར་"
    },
    {
      "span": {
        "start": 8551,
        "end": 8555
      },
      "text": "གཏང་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 8599,
        "end": 8609
      },
      "text": "བདེ་གཤེགས་ ༼སྣར། པེ།༽ བདེར་གཤེགས་"
    },
    {
      "span": {
        "start": 8646,
        "end": 8653
      },
      "text": "འགོད་པ་ ༼སྣར། པེ།༽ དགོངས་པ་"
    },
    {
      "span": {
        "start": 8703,
        "end": 8708
      },
      "text": "དགོས་ ༼སྣར། པེ།༽ དགོངས་"
    },
    {
      "span": {
        "start": 8962,
        "end": 8970
      },
      "text": "སྦྱིན་པ་ ༼སྣར། པེ།༽ སྦྱིན་པར་"
    },
    {
      "span": {
        "start": 8978,
        "end": 8982
      },
      "text": "གཏང་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 9032,
        "end": 9038
      },
      "text": "བཏང་བ་ ༼སྣར། པེ།༽ གཏོང་བ་"
    },
    {
      "span": {
        "start": 9049,
        "end": 9053
      },
      "text": "འོད་ ༼སྣར།༽ ཡོད་"
    },
    {
      "span": {
        "start": 9592,
        "end": 9598
      },
      "text": "ཕ་རོལ་ ༼སྣར།༽ ཕ་རོལ་ཏུ་"
    },
    {
      "span": {
        "start": 10330,
        "end": 10335
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 10575,
        "end": 10579
      },
      "text": "བཀའ་ ༼སྣར།༽ དཀའ་ ༼པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 10767,
        "end": 10772
      },
      "text": "སྔོན་ ༼སྣར། པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 10808,
        "end": 10812
      },
      "text": "འཛི་ ༼སྣར།༽ འཛིན་"
    },
    {
      "span": {
        "start": 11023,
        "end": 11030
      },
      "text": "བརྒྱགས་ ༼སྣར། པེ།༽ རྒྱགས་"
    },
    {
      "span": {
        "start": 11045,
        "end": 11049
      },
      "text": "རྟག་ ༼སྣར། པེ།༽ རྟགས་"
    },
    {
      "span": {
        "start": 11324,
        "end": 11333
      },
      "text": "འབྲངས་ཏེ། ༼སྣར། པེ།༽ འབྲང་སྟེ།"
    },
    {
      "span": {
        "start": 11617,
        "end": 11625
      },
      "text": "འཁྲུལ་པ་ ༼སྣར།༽ འཕྲུལ་པ་"
    },
    {
      "span": {
        "start": 11688,
        "end": 11693
      },
      "text": "དཔྱད་ ༼སྣར། པེ།༽ སྤྱད་"
    },
    {
      "span": {
        "start": 11950,
        "end": 11957
      },
      "text": "ཀུན་ཡང་ ༼སྣར། པེ།༽ ཀུན་ཀྱང་"
    },
    {
      "span": {
        "start": 12063,
        "end": 12071
      },
      "text": "བྱས་ཀྱི་ ༼པེ།༽ བྱས་ཀྱིས་"
    },
    {
      "span": {
        "start": 12222,
        "end": 12227
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 12250,
        "end": 12258
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 12330,
        "end": 12337
      },
      "text": "ཁས་འཆེ་ ༼སྣར།༽ ཁས་ཆེ་ ༼པེ།༽ མཁས་ཆེ་"
    },
    {
      "span": {
        "start": 12476,
        "end": 12484
      },
      "text": "ཁྱིམ་ཐབ་ ༼སྣར།༽ ཁྱིམ་ཐབས་"
    },
    {
      "span": {
        "start": 13208,
        "end": 13217
      },
      "text": "ཕུལ་བ་ཡི། ༼སྣར། པེ།༽ ཕུལ་བ་ཡིས།"
    },
    {
      "span": {
        "start": 13277,
        "end": 13282
      },
      "text": "རིགས་ ༼སྣར།༽ རིག་"
    },
    {
      "span": {
        "start": 13566,
        "end": 13571
      },
      "text": "བསྡུ་ ༼སྣར། པེ།༽ བསྡུས་"
    },
    {
      "span": {
        "start": 13602,
        "end": 13613
      },
      "text": "བསྐྱེད་པའི་ ༼སྣར། པེ།༽ སྐྱེད་པའི་"
    },
    {
      "span": {
        "start": 13775,
        "end": 13779
      },
      "text": "གཡང་ ༼སྣར། པེ།༽ གཡེལ་"
    },
    {
      "span": {
        "start": 13818,
        "end": 13822
      },
      "text": "བཅད། ༼སྣར། པེ།༽ གཅད།"
    },
    {
      "span": {
        "start": 13967,
        "end": 13973
      },
      "text": "བརྡུང་ ༼སྣར། པེ།༽ རྡུང་"
    },
    {
      "span": {
        "start": 13986,
        "end": 13990
      },
      "text": "ཁུར། ༼སྣར། པེ།༽ འཁུར།"
    },
    {
      "span": {
        "start": 14026,
        "end": 14030
      },
      "text": "བཅད། ༼སྣར། པེ།༽ གཅད།"
    },
    {
      "span": {
        "start": 14130,
        "end": 14134
      },
      "text": "མནའ་ ༼སྣར། པེ།༽ རྣ་"
    },
    {
      "span": {
        "start": 14145,
        "end": 14153
      },
      "text": "ཕྱག་རྒྱ་ ༼སྣར། པེ།༽ ཕྱག་རྒྱར་"
    },
    {
      "span": {
        "start": 14237,
        "end": 14247
      },
      "text": "དགོན་པར་མ་ ༼སྣར། པེ།༽ དགོན་པར་མི་"
    },
    {
      "span": {
        "start": 14295,
        "end": 14298
      },
      "text": "ཅོ་ ༼སྣར། པེ།༽ རྩེ་"
    },
    {
      "span": {
        "start": 14345,
        "end": 14348
      },
      "text": "པས་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 14629,
        "end": 14636
      },
      "text": "ཁས་འཆེ་ ༼སྣར།༽ ཁས་བ་ཆེས་ ༼པེ།༽ འཆེས་"
    },
    {
      "span": {
        "start": 14926,
        "end": 14933
      },
      "text": "ཐིགས་པ་ ༼སྣར། པེ།༽ ཐིག་པ་"
    },
    {
      "span": {
        "start": 14959,
        "end": 14965
      },
      "text": "རུལ་བ་ ༼སྣར། པེ།༽ འདྲུལ་བ་"
    },
    {
      "span": {
        "start": 14984,
        "end": 14987
      },
      "text": "ངན་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 14990,
        "end": 14993
      },
      "text": "དང་ ༼སྣར། པེ།༽ དང་མ་"
    },
    {
      "span": {
        "start": 14993,
        "end": 15001
      },
      "text": "འདྲེས་པ་ ༼སྣར། པེ།༽ འདྲེས་"
    },
    {
      "span": {
        "start": 15117,
        "end": 15124
      },
      "text": "ནོར་བུ་ ༼སྣར། པེ།༽ ནོར་བུར་"
    },
    {
      "span": {
        "start": 15178,
        "end": 15185
      },
      "text": "སྐྱོབས། ༼སྣར། པེ།༽ སྐྱོབ།"
    },
    {
      "span": {
        "start": 15250,
        "end": 15257
      },
      "text": "བསྲུང་། ༼སྣར། པེ།༽ གསུངས།"
    },
    {
      "span": {
        "start": 15277,
        "end": 15286
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 15321,
        "end": 15330
      },
      "text": "རིམ་གྱིས་ ༼སྣར། པེ།༽ རིམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 15374,
        "end": 15382
      },
      "text": "སྒྱུ་མར་ ༼སྣར།༽ རྒྱུ་མར་"
    },
    {
      "span": {
        "start": 15401,
        "end": 15410
      },
      "text": "འགྲོ་བའོ་ ༼སྣར། པེ།༽ འགྲོའོ་"
    },
    {
      "span": {
        "start": 15494,
        "end": 15501
      },
      "text": "རང་གཞན་ ༼སྣར། པེ།༽ རང་བཞིན་"
    },
    {
      "span": {
        "start": 16008,
        "end": 16023
      },
      "text": "སྔགས་ཀྱི་ཏན་གན་ ༼སྣར། པེ།༽ སྔགས་ཀྱིསྟན་འགན་"
    },
    {
      "span": {
        "start": 16040,
        "end": 16048
      },
      "text": "མཐོང་ནས། ༼སྣར། པེ།༽ མཐོང་ན།"
    },
    {
      "span": {
        "start": 16090,
        "end": 16099
      },
      "text": "གསང་སྔགས་ ༼པེ།༽ གསང་སྔགས་དང་"
    },
    {
      "span": {
        "start": 16191,
        "end": 16196
      },
      "text": "སྟེང་ ༼སྣར། པེ།༽ གཏིང་"
    },
    {
      "span": {
        "start": 16310,
        "end": 16315
      },
      "text": "བསླད་ ༼སྣར། པེ།༽ སླད་"
    }
  ]
}