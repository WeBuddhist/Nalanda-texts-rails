{
  "durchens": [
    {
      "span": {
        "start": 543,
        "end": 553
      },
      "text": "དེ་དག་གིས་ ༼སྣར། པེ།༽ དེ་དག་གི་"
    },
    {
      "span": {
        "start": 646,
        "end": 653
      },
      "text": "ལྟ་བུར། ༼སྣར།༽ ལྟ་བུ།"
    },
    {
      "span": {
        "start": 943,
        "end": 946
      },
      "text": "ཡི་ ༼པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 976,
        "end": 988
      },
      "text": "གསུངས་པ་སྟེ། ༼སྣར།༽ གསུངས་པ་ཏེ།"
    },
    {
      "span": {
        "start": 1023,
        "end": 1029
      },
      "text": "རང་གི་ ༼པེ།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 1695,
        "end": 1702
      },
      "text": "ནི་རིམ་ ༼སྣར། པེ།༽ ན་རིམ་"
    },
    {
      "span": {
        "start": 1781,
        "end": 1785
      },
      "text": "སོད་ ༼སྣར། པེ།༽ གསོད་"
    },
    {
      "span": {
        "start": 2040,
        "end": 2042
      },
      "text": "ན། ༼ཅོ།༽ ནི།"
    },
    {
      "span": {
        "start": 2148,
        "end": 2152
      },
      "text": "རིག་ ༼པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 2257,
        "end": 2270
      },
      "text": "ཁྲོས་པས་དན་ཏ་ ༼སྣར། པེ།༽ ཁྲོས་པས་དནྟེ་"
    },
    {
      "span": {
        "start": 2329,
        "end": 2336
      },
      "text": "དེ་མིས་ ༼སྣར། པེ།༽ དེ་ཡིས་"
    },
    {
      "span": {
        "start": 2369,
        "end": 2376
      },
      "text": "རིག་པས་ ༼སྣར། པེ།༽ རིག་པའི་"
    },
    {
      "span": {
        "start": 2391,
        "end": 2402
      },
      "text": "བཞིན་མ་ཡིན་ ༼སྣར།༽ བཞིན་མ་"
    }
  ]
}