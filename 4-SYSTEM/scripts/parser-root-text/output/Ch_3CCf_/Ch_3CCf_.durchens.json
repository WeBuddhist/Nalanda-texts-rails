{
  "durchens": [
    {
      "span": {
        "start": 175,
        "end": 182
      },
      "text": "བཤད་པར་ ༼སྣར། པེ།༽ བཤད་"
    },
    {
      "span": {
        "start": 189,
        "end": 200
      },
      "text": "དགག་བསྒྲུབ་ ༼སྣར། པེ།༽ དགག་སྒྲུབ་"
    },
    {
      "span": {
        "start": 237,
        "end": 243
      },
      "text": "གང་ཡང་ ༼སྣར། པེ།༽ འགའ་ཡང་"
    },
    {
      "span": {
        "start": 350,
        "end": 355
      },
      "text": "བླང་། ༼སྣར། པེ།༽ བླངས།"
    },
    {
      "span": {
        "start": 389,
        "end": 396
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 412,
        "end": 421
      },
      "text": "སློང་བའི་ ༼སྣར། པེ།༽ སྣང་བའི་"
    },
    {
      "span": {
        "start": 614,
        "end": 621
      },
      "text": "གནས་པས་ ༼སྣར། པེ།༽ གནས་པ་"
    },
    {
      "span": {
        "start": 791,
        "end": 799
      },
      "text": "བརྫུན་པ་ ༼སྣར། པེ།༽ རྫུན་པ་"
    },
    {
      "span": {
        "start": 824,
        "end": 833
      },
      "text": "བརྫུན་པར་ ༼སྣར། པེ།༽ རྫུན་པར་"
    },
    {
      "span": {
        "start": 889,
        "end": 894
      },
      "text": "བྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 1072,
        "end": 1083
      },
      "text": "བསྒྲུབ་པའི་ ༼སྣར། པེ།༽ སྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 1136,
        "end": 1140
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 1157,
        "end": 1164
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 1452,
        "end": 1461
      },
      "text": "ངོས་གཟུང་ ༼སྣར། པེ།༽ དངོས་གཟུངས་"
    },
    {
      "span": {
        "start": 1469,
        "end": 1476
      },
      "text": "ཡེངས་པ་ ༼སྣར། པེ།༽ གཡེང་བ་"
    },
    {
      "span": {
        "start": 1503,
        "end": 1509
      },
      "text": "བསྒོམ། ༼སྣར། པེ།༽ སྒོམ།"
    },
    {
      "span": {
        "start": 1621,
        "end": 1630
      },
      "text": "སྙིང་རྗེ་ ༼སྣར།༽ སྙིང་རྗེས་"
    },
    {
      "span": {
        "start": 1775,
        "end": 1788
      },
      "text": "སངས་རྒྱས་ཀྱི། ༼སྣར། པེ།༽ སངས་རྒྱས་ཀྱིས།"
    },
    {
      "span": {
        "start": 1919,
        "end": 1925
      },
      "text": "འབད་པ་ ༼སྣར།༽ འབད་པས་"
    },
    {
      "span": {
        "start": 1939,
        "end": 1947
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ དངོས་དང་"
    },
    {
      "span": {
        "start": 1950,
        "end": 1955
      },
      "text": "བ་ཐག་ ༼སྣར།༽ བར་ཐག་"
    },
    {
      "span": {
        "start": 1970,
        "end": 1978
      },
      "text": "སྒོམ་པས་ ༼སྣར། པེ།༽ བསྒོམ་པས་"
    },
    {
      "span": {
        "start": 2182,
        "end": 2196
      },
      "text": "བསྒྲུབ་པ་ལ་ནི་ ༼སྣར། པེ།༽ སྒྲུབ་ནི་རབ་ཏུ་"
    },
    {
      "span": {
        "start": 2377,
        "end": 2388
      },
      "text": "འགོས་ཁུག་པ་ ༼སྣར།༽ བགོས་ཁུ་བ་ ༼པེ།༽ འགོས་ཁུ་བ་"
    }
  ]
}