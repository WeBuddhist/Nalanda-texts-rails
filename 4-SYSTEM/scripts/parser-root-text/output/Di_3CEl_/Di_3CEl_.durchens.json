{
  "durchens": [
    {
      "span": {
        "start": 605,
        "end": 609
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ ཡི།"
    },
    {
      "span": {
        "start": 880,
        "end": 889
      },
      "text": "དོན་གྱིས། ༼སྣར། པེ།༽ དོན་གྱི།"
    },
    {
      "span": {
        "start": 968,
        "end": 981
      },
      "text": "བརྗོད་ཉིད་དོ། ༼སྣར། པེ།༽ བརྗོད་དེ་ཉིད།"
    },
    {
      "span": {
        "start": 1625,
        "end": 1627
      },
      "text": "མ་ ༼སྣར། པེ།༽ མི་"
    },
    {
      "span": {
        "start": 1778,
        "end": 1786
      },
      "text": "ཞེས་བྱར་ ༼སྣར། པེ།༽ ཞེས་ཀྱང་"
    },
    {
      "span": {
        "start": 1812,
        "end": 1821
      },
      "text": "སོགས་ལོག་ ༼སྣར། པེ།༽ སོགས་"
    },
    {
      "span": {
        "start": 1821,
        "end": 1824
      },
      "text": "ལྟ་ ༼སྣར། པེ།༽ ལྟ་བ་"
    },
    {
      "span": {
        "start": 1948,
        "end": 1957
      },
      "text": "བརྗོད་པར་ ༼སྣར། པེ།༽ རྗོད་པར་"
    },
    {
      "span": {
        "start": 1984,
        "end": 1991
      },
      "text": "རིག་པས་ ༼སྣར། པེ།༽ རིགས་པས་"
    },
    {
      "span": {
        "start": 1991,
        "end": 1995
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 2129,
        "end": 2135
      },
      "text": "བསལ་བ་ ༼སྣར། པེ།༽ གསལ་བ་"
    },
    {
      "span": {
        "start": 2170,
        "end": 2175
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 2236,
        "end": 2246
      },
      "text": "བསྡུས་པའོ། ༼སྣར། པེ།༽ བསྡུས་པ་ཞེས།"
    },
    {
      "span": {
        "start": 2297,
        "end": 2305
      },
      "text": "གཡེང་པས། ༼སྣར།༽ གཡེངས་པར ༼པེ།༽ གཡེངས་པས།"
    },
    {
      "span": {
        "start": 2503,
        "end": 2513
      },
      "text": "ཀུན་བརྗོད་ ༼སྣར། པེ།༽ ཀུན་རྫོབ་"
    },
    {
      "span": {
        "start": 2566,
        "end": 2579
      },
      "text": "དངོས་མེད་ཀྱི། ༼སྣར། པེ།༽ དངོས་མེད་ཀྱིས།"
    },
    {
      "span": {
        "start": 2581,
        "end": 2589
      },
      "text": "རྟག་པའི་ ༼སྣར། པེ།༽ རྟོགས་པའི་"
    },
    {
      "span": {
        "start": 2714,
        "end": 2718
      },
      "text": "དགག་ ༼སྣར། པེ།༽ འགག་"
    },
    {
      "span": {
        "start": 2746,
        "end": 2750
      },
      "text": "མིན་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 3969,
        "end": 3976
      },
      "text": "ཤེས་པར་ ༼སྣར། པེ།༽ རྟོགས་པར་"
    },
    {
      "span": {
        "start": 4025,
        "end": 4032
      },
      "text": "སྟོན་པ་ ༼སྣར། པེ།༽ སྟོང་པ་"
    },
    {
      "span": {
        "start": 4049,
        "end": 4059
      },
      "text": "རྣམ་རྟོགས་ ༼སྡེ།༽ རྣམ་རྟོག་"
    },
    {
      "span": {
        "start": 4079,
        "end": 4086
      },
      "text": "སེལ་བར་ ༼སྣར། པེ།༽ སེལ་བ་"
    },
    {
      "span": {
        "start": 4129,
        "end": 4134
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 4402,
        "end": 4406
      },
      "text": "སྒྲ་ ༼སྣར། པེ།༽ སྒྲར་"
    },
    {
      "span": {
        "start": 4473,
        "end": 4479
      },
      "text": "རང་གི་ ༼སྣར། པེ།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 4606,
        "end": 4615
      },
      "text": "རྣམས་ཀྱི། ༼སྣར། པེ།༽ རྣམས་ཀྱིས།"
    },
    {
      "span": {
        "start": 4663,
        "end": 4676
      },
      "text": "འདི་དག་བརྗོད། ༼སྣར། པེ།༽ འདི་བརྗོད་དོ།"
    },
    {
      "span": {
        "start": 4827,
        "end": 4833
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 4974,
        "end": 4980
      },
      "text": "ཞུས་པ་ ༼སྣར། པེ།༽ ནུས་པས་"
    },
    {
      "span": {
        "start": 5139,
        "end": 5144
      },
      "text": "གསུང་ ༼སྣར། པེ།༽ གསུངས་"
    },
    {
      "span": {
        "start": 5300,
        "end": 5304
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 5350,
        "end": 5354
      },
      "text": "བསལ། ༼སྣར། པེ།༽ སེལ།"
    },
    {
      "span": {
        "start": 5390,
        "end": 5397
      },
      "text": "སྟོང་པ་ ༼སྣར། པེ།༽ སྟོང་པར་"
    },
    {
      "span": {
        "start": 5611,
        "end": 5623
      },
      "text": "བརྗོད་བྱ་ཡི། ༼སྣར།༽ བརྗོད་བྱ་ཡིས།"
    },
    {
      "span": {
        "start": 5840,
        "end": 5845
      },
      "text": "བྱ་བ། ༼སྣར། པེ།༽ བྱས་པ།"
    },
    {
      "span": {
        "start": 6168,
        "end": 6175
      },
      "text": "རིག་པས་ ༼ཅོ།༽ རིགས་པས་"
    },
    {
      "span": {
        "start": 6565,
        "end": 6568
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 6640,
        "end": 6645
      },
      "text": "རྟེན་ ༼སྣར།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 6777,
        "end": 6788
      },
      "text": "བསྡུས་པ་ཡི། ༼སྣར། པེ།༽ བསྡུས་པ་ཡིས།"
    },
    {
      "span": {
        "start": 6902,
        "end": 6908
      },
      "text": "བྱས་པ། ༼སྣར། པེ།༽ བྱས།། །།"
    },
    {
      "span": {
        "start": 6991,
        "end": 6997
      },
      "text": "ཤ་དང་། ༼སྣར། པེ།༽ ཤ།། །།"
    }
  ]
}