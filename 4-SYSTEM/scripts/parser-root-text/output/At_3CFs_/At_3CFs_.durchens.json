{
  "durchens": [
    {
      "span": {
        "start": 33,
        "end": 40
      },
      "text": "ལིཾ་ཏེ་ ༼སྣར། པེ།༽ ལིཾ་ཏ་"
    },
    {
      "span": {
        "start": 43,
        "end": 48
      },
      "text": "ནཱ་མ། ༼སྣར། པེ།༽ ནཱ་མ་།"
    },
    {
      "span": {
        "start": 61,
        "end": 75
      },
      "text": "དཔལ་མགོན་པོའི་ ༼སྣར། པེ།༽ དཔལ་མགོན་པོ་ནག་པོའི་"
    },
    {
      "span": {
        "start": 127,
        "end": 138
      },
      "text": "ལ་སོགས་པའི་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 161,
        "end": 173
      },
      "text": "བྱང་ཆུབ་ཀྱི་ ༼སྣར། པེ།༽ བྱང་ཆུབ་ཀྱིས་"
    },
    {
      "span": {
        "start": 322,
        "end": 329
      },
      "text": "རང་ཉིད་ ༼སྣར། པེ།༽ རང་"
    },
    {
      "span": {
        "start": 390,
        "end": 397
      },
      "text": "ཡེ་ཤེས་ ༼སྣར། པེ།༽ ཡི་གེས་"
    },
    {
      "span": {
        "start": 512,
        "end": 517
      },
      "text": "བཤམས། ༼སྣར། པེ།༽ བཤམ།"
    },
    {
      "span": {
        "start": 719,
        "end": 731
      },
      "text": "སྔོན་པོ་ཅིག་ ༼སྣར། པེ།༽ སྔོན་པོ་ཞིག་"
    },
    {
      "span": {
        "start": 838,
        "end": 845
      },
      "text": "ནི་མདའ་ ༼སྣར། པེ།༽ ན་མར་"
    },
    {
      "span": {
        "start": 868,
        "end": 878
      },
      "text": "ཅིག་བསྒོམ། ༼སྣར། པེ།༽ ཞིག་བསྒོམས།"
    },
    {
      "span": {
        "start": 929,
        "end": 937
      },
      "text": "ཚ་བ་ཅིག་ ༼སྣར། པེ།༽ ཚ་བ་ཞིག་"
    },
    {
      "span": {
        "start": 949,
        "end": 956
      },
      "text": "སྟེང་ན་ ༼སྣར། པེ།༽ སྟེང་དུ་"
    },
    {
      "span": {
        "start": 956,
        "end": 958
      },
      "text": "ཨ་ ༼སྣར། པེ།༽ ཨ་ལས་"
    },
    {
      "span": {
        "start": 997,
        "end": 1006
      },
      "text": "ཆེ་བ་ཅིག་ ༼སྣར། པེ།༽ ཆེ་བ་གཅིག་"
    },
    {
      "span": {
        "start": 1069,
        "end": 1072
      },
      "text": "མར་ ༼སྣར། པེ།༽ མར་ལ་"
    },
    {
      "span": {
        "start": 1134,
        "end": 1137
      },
      "text": "མོ། ༼སྣར།༽ མོས།"
    },
    {
      "span": {
        "start": 1268,
        "end": 1276
      },
      "text": "ཡོངས་སུ་ ༼པེ།༽ ཡོངས་"
    },
    {
      "span": {
        "start": 1318,
        "end": 1325
      },
      "text": "ཅན་ཅིག་ ༼སྣར། པེ།༽ ཅན་གཅིག་"
    },
    {
      "span": {
        "start": 1496,
        "end": 1498
      },
      "text": "ར་ ༼སྣར། པེ།༽ རྭ་"
    },
    {
      "span": {
        "start": 1577,
        "end": 1589
      },
      "text": "རླུང་གཡབ་པས་ ༼སྣར། པེ།༽ རླུང་གཡབ་"
    },
    {
      "span": {
        "start": 1601,
        "end": 1609
      },
      "text": "སྦར་མེས་ ༼སྣར། པེ།༽ འབར་མེས་"
    },
    {
      "span": {
        "start": 1627,
        "end": 1636
      },
      "text": "འཕྲོས་ནས་ ༼སྣར། པེ།༽ འཕྲོས་"
    },
    {
      "span": {
        "start": 1730,
        "end": 1733
      },
      "text": "ལྔ་ ༼སྣར། པེ།༽ ལྔའི་"
    },
    {
      "span": {
        "start": 1948,
        "end": 1957
      },
      "text": "འཁྱག་པའི་ ༼སྣར། པེ།༽ འཁྱགས་པའི་"
    },
    {
      "span": {
        "start": 1968,
        "end": 1973
      },
      "text": "གཙུག་ ༼སྣར། པེ།༽ ཙུག་"
    },
    {
      "span": {
        "start": 2125,
        "end": 2134
      },
      "text": "བསྒོམ་མོ། ༼སྣར། པེ།༽ བསྒོམ།"
    },
    {
      "span": {
        "start": 2159,
        "end": 2166
      },
      "text": "བྱ་བའོ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 2264,
        "end": 2272
      },
      "text": "སྟེང་དུ་ ༼སྣར།༽ སྟེང་ན་ ༼པེ།༽ སྟེང་ལ་"
    },
    {
      "span": {
        "start": 2277,
        "end": 2289
      },
      "text": "མཐིང་ནག་ཅིག་ ༼སྣར། པེ།༽ མཐིང་ནག་གཅིག་"
    },
    {
      "span": {
        "start": 2442,
        "end": 2453
      },
      "text": "གཡས་གཡོན་ན་ ༼སྣར། པེ།༽ གཡས་གཡོན་"
    },
    {
      "span": {
        "start": 2586,
        "end": 2611
      },
      "text": "གི་པགས་པའི་ཤམ་ཐབས་ཅན་ཅིག་ ༼སྣར།༽ གི་ཤམ་ཐབས་ཅན་ ༼པེ།༽ གི་ཤམ་སྟབས་ཅན་"
    },
    {
      "span": {
        "start": 2950,
        "end": 2962
      },
      "text": "བརྩེགས་གཡེལ་ ༼སྣར། པེ།༽ རྩེགས་གསོལ་"
    },
    {
      "span": {
        "start": 2973,
        "end": 2980
      },
      "text": "སྐ་རགས་ ༼སྣར། པེ།༽ སྐ་རགས་ཅན་"
    },
    {
      "span": {
        "start": 2988,
        "end": 2992
      },
      "text": "ཅིག་ ༼སྣར། པེ།༽ ཞིག་"
    },
    {
      "span": {
        "start": 3012,
        "end": 3018
      },
      "text": "རང་གི་ ༼སྣར། པེ།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 3089,
        "end": 3094
      },
      "text": "གཡོག་ ༼པེ།༽ གཡོགས་"
    },
    {
      "span": {
        "start": 3440,
        "end": 3448
      },
      "text": "ཞལ་གཅིག་ ༼སྣར། པེ།༽ ཞལ་ཅིག་"
    },
    {
      "span": {
        "start": 3452,
        "end": 3459
      },
      "text": "གཉིས་པ། ༼སྣར། པེ།༽ གཉིས་མ།"
    },
    {
      "span": {
        "start": 3599,
        "end": 3602
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 3628,
        "end": 3633
      },
      "text": "བཏགས་ ༼པེ།༽ བཏག་"
    },
    {
      "span": {
        "start": 3643,
        "end": 3650
      },
      "text": "རྐྱལ་པ་ ༼སྣར།༽ རྒྱལ་པ་"
    },
    {
      "span": {
        "start": 3671,
        "end": 3682
      },
      "text": "ཐོགས་པ་ཅིག་ ༼སྣར། པེ།༽ ཐོགས་པ་ཞིག་"
    },
    {
      "span": {
        "start": 3804,
        "end": 3808
      },
      "text": "ཅིག་ ༼སྣར། པེ།༽ གཅིག་"
    },
    {
      "span": {
        "start": 3811,
        "end": 3817
      },
      "text": "སོང་བ། ༼སྣར། པེ།༽ སོང་བས།"
    },
    {
      "span": {
        "start": 3869,
        "end": 3875
      },
      "text": "ནག་པོ་ ༼སྣར། པེ།༽ ནག་མོ་"
    },
    {
      "span": {
        "start": 3877,
        "end": 3884
      },
      "text": "ཆིབས་པ་ ༼སྣར། པེ།༽ བཅིབས་པ་"
    },
    {
      "span": {
        "start": 3944,
        "end": 3952
      },
      "text": "གཙིགས་པ། ༼སྣར། པེ།༽ གཙིགས།"
    },
    {
      "span": {
        "start": 3966,
        "end": 3975
      },
      "text": "གོང་སྨེད་ ༼སྣར། པེ།༽ གོང་རྨེད་"
    },
    {
      "span": {
        "start": 3988,
        "end": 3991
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 4052,
        "end": 4059
      },
      "text": "དྲུ་གུ་ ༼སྣར།༽ དྲུ་བུ་"
    },
    {
      "span": {
        "start": 4066,
        "end": 4070
      },
      "text": "ཅིག་ ༼སྣར། པེ།༽ ཞིག་"
    },
    {
      "span": {
        "start": 4096,
        "end": 4103
      },
      "text": "ཐུགས་ཀ་ ༼པེ།༽ ཐུགས་"
    },
    {
      "span": {
        "start": 4162,
        "end": 4167
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ གཟངས་"
    },
    {
      "span": {
        "start": 4197,
        "end": 4203
      },
      "text": "ལྡིངས་ ༼སྣར། པེ།༽ ལྡིང་"
    },
    {
      "span": {
        "start": 4345,
        "end": 4350
      },
      "text": "བརླབ་ ༼སྣར། པེ།༽ བརློབ་"
    },
    {
      "span": {
        "start": 4590,
        "end": 4599
      },
      "text": "ཁ་ནས་ཐོན་ ༼སྣར། པེ།༽ ཁ་ནས་"
    },
    {
      "span": {
        "start": 4711,
        "end": 4720
      },
      "text": "བསམས་ཤིང་ ༼སྣར། པེ།༽ བསམ་ཞིང་"
    },
    {
      "span": {
        "start": 4747,
        "end": 4753
      },
      "text": "ཟླས་པ་ ༼སྣར། པེ།༽ བཟླས་པ་"
    },
    {
      "span": {
        "start": 4808,
        "end": 4815
      },
      "text": "ཨོཾ་རོ་ ༼སྣར། པེ།༽ ཨོཾ་རུ་"
    },
    {
      "span": {
        "start": 4821,
        "end": 4828
      },
      "text": "རུ་ཏྲི་ ༼སྣར། པེ།༽ རུ་རུ་"
    },
    {
      "span": {
        "start": 4836,
        "end": 4840
      },
      "text": "ཤུག་ ༼སྣར། པེ།༽ ཤུད་"
    },
    {
      "span": {
        "start": 4911,
        "end": 4915
      },
      "text": "བཏང་ ༼སྣར། པེ།༽ གཏོང་"
    },
    {
      "span": {
        "start": 4934,
        "end": 4936
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་ལྕེ་"
    },
    {
      "span": {
        "start": 4939,
        "end": 4948
      },
      "text": "དམིགས་ཏེ་ ༼སྣར། པེ།༽ དམིགས་"
    },
    {
      "span": {
        "start": 4970,
        "end": 4980
      },
      "text": "ཡང་བཏབ་པོ། ༼སྣར། པེ།༽ ཡོད་པར་བསམས་ལ།"
    },
    {
      "span": {
        "start": 5041,
        "end": 5049
      },
      "text": "སྦུ་གུར་ ༼སྣར། པེ།༽ བུ་གུར་"
    },
    {
      "span": {
        "start": 5074,
        "end": 5080
      },
      "text": "སྟོབས་ ༼སྣར། པེ།༽ སྟོབ་"
    },
    {
      "span": {
        "start": 5101,
        "end": 5113
      },
      "text": "གཏོར་མ་ལ་དར་ ༼སྣར། པེ།༽ གཏོར་མ་གཏར་"
    },
    {
      "span": {
        "start": 5183,
        "end": 5188
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བ་ལ་"
    },
    {
      "span": {
        "start": 5201,
        "end": 5210
      },
      "text": "བསྟབས་སོ། ༼སྣར། པེ།༽ བསྟབ་བོ།"
    },
    {
      "span": {
        "start": 5293,
        "end": 5302
      },
      "text": "བསྟབས་སོ། ༼སྣར། པེ།༽ བསྟབ་བོ།"
    },
    {
      "span": {
        "start": 5642,
        "end": 5648
      },
      "text": "བའོ། ། ༼པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 5740,
        "end": 5743
      },
      "text": "གར་ ༼སྣར། པེ།༽ ཀར་"
    }
  ]
}