{
  "durchens": [
    {
      "span": {
        "start": 288,
        "end": 293
      },
      "text": "སོགས་ ༼སྣར། པེ།༽ ཚོགས་"
    },
    {
      "span": {
        "start": 307,
        "end": 312
      },
      "text": "ལེའུ་ ༼སྣར། པེ།༽ ལེ་"
    },
    {
      "span": {
        "start": 507,
        "end": 513
      },
      "text": "བྱས་པ་ ༼སྣར། པེ།༽ བྲེས་པ་"
    },
    {
      "span": {
        "start": 547,
        "end": 552
      },
      "text": "བཞིར་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 1112,
        "end": 1115
      },
      "text": "ལྷ་ ༼སྣར། པེ།༽ ལྷ་ལྔ་ན་ཡ་ཀ་ར་ན་རྒྱ་ནན་"
    },
    {
      "span": {
        "start": 1550,
        "end": 1552
      },
      "text": "ས་ ༼སྣར། པེ།༽ སྱ་"
    },
    {
      "span": {
        "start": 1674,
        "end": 1681
      },
      "text": "གཡོན་པ་ ༼སྣར། པེ།༽ གཡོན་"
    },
    {
      "span": {
        "start": 1750,
        "end": 1768
      },
      "text": "བཅངས་པ་བྲང་དུ་བཞག་ ༼སྣར། པེ།༽ བཅངས་"
    },
    {
      "span": {
        "start": 1923,
        "end": 1931
      },
      "text": "འདུག་པར་ ༼སྣར། པེ།༽ འདུག་པ་"
    },
    {
      "span": {
        "start": 1974,
        "end": 1981
      },
      "text": "གུང་མོ་ ༼སྣར། པེ།༽ གུང་མོའི་"
    },
    {
      "span": {
        "start": 1985,
        "end": 1989
      },
      "text": "མའི་ ༼སྣར། པེ།༽ མོའི་"
    },
    {
      "span": {
        "start": 2217,
        "end": 2222
      },
      "text": "གེའུ་ ༼སྣར། པེ།༽ གཻ་"
    },
    {
      "span": {
        "start": 2246,
        "end": 2259
      },
      "text": "ཧཱ་ཞེས་བརྗོད་ ༼སྣར། པེ།༽ ཧཱ་ཞེས་"
    },
    {
      "span": {
        "start": 2457,
        "end": 2467
      },
      "text": "བརྐྱང་སྟེ། ༼སྣར། པེ།༽ བརྐྱངས་ཏེ།"
    },
    {
      "span": {
        "start": 3005,
        "end": 3013
      },
      "text": "བསྐྱར་བ་ ༼སྣར། པེ།༽ བསྐྱེལ་བ་"
    },
    {
      "span": {
        "start": 3277,
        "end": 3282
      },
      "text": "བརྩམ་ ༼སྣར། པེ།༽ ཙམ་"
    },
    {
      "span": {
        "start": 3351,
        "end": 3354
      },
      "text": "ཛི་ ༼སྣར། པེ།༽ ཙི་"
    },
    {
      "span": {
        "start": 3401,
        "end": 3406
      },
      "text": "ཛོ་བ་ ༼སྣར། པེ།༽ ཛྭ་བ་"
    },
    {
      "span": {
        "start": 3713,
        "end": 3718
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 3893,
        "end": 3897
      },
      "text": "གཏང་ ༼སྣར། པེ།༽ བཏང་"
    }
  ]
}