{
  "durchens": [
    {
      "span": {
        "start": 333,
        "end": 337
      },
      "text": "གནག་ ༼སྣར། པེ།༽ ནག་"
    },
    {
      "span": {
        "start": 354,
        "end": 361
      },
      "text": "གཅིག་མ། ༼སྣར། པེ།༽ གཅིག་པ་"
    },
    {
      "span": {
        "start": 439,
        "end": 449
      },
      "text": "དབུ་བརྒྱན་ ༼སྣར།༽ དབུ་རྒྱན་"
    },
    {
      "span": {
        "start": 472,
        "end": 479
      },
      "text": "བསྒྲེང་ ༼སྣར། པེ།༽ བགྲེང་"
    },
    {
      "span": {
        "start": 614,
        "end": 621
      },
      "text": "མཐོ་བར་ ༼སྣར། པེ།༽ འབོར་བར་"
    },
    {
      "span": {
        "start": 699,
        "end": 706
      },
      "text": "ཚོམ་བུ་ ༼སྣར། པེ།༽ ཚོན་དུ་"
    },
    {
      "span": {
        "start": 840,
        "end": 845
      },
      "text": "སྔགས་ ༼སྣར། པེ།༽ བསྔགས་"
    },
    {
      "span": {
        "start": 994,
        "end": 998
      },
      "text": "ཞུས། ༼སྣར།༽ ཞུས་སོ།"
    }
  ]
}