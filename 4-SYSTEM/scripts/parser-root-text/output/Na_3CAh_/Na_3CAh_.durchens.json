{
  "durchens": [
    {
      "span": {
        "start": 693,
        "end": 700
      },
      "text": "གཞུག་པ་ ༼པེ།༽ བཞུག་པ་"
    },
    {
      "span": {
        "start": 912,
        "end": 916
      },
      "text": "སྟི་ ༼པེ།༽ ཏི་"
    },
    {
      "span": {
        "start": 1437,
        "end": 1440
      },
      "text": "མུ་ ༼པེ།༽ མུ་ཨ་"
    },
    {
      "span": {
        "start": 1733,
        "end": 1737
      },
      "text": "འཆར་ ༼པེ།༽ ཆར་"
    },
    {
      "span": {
        "start": 2064,
        "end": 2078
      },
      "text": "ཐམས་ཅད་ཅད་ཅིང་ ༼སྣར།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 2266,
        "end": 2271
      },
      "text": "སྡུས་ ༼སྣར།༽ སྡུད་"
    },
    {
      "span": {
        "start": 2320,
        "end": 2325
      },
      "text": "སྨ་བ་ ༼སྣར།༽ དམའ་བ་"
    },
    {
      "span": {
        "start": 2948,
        "end": 2954
      },
      "text": "བཞུག ། ༼སྣར།༽ གཞུག །"
    },
    {
      "span": {
        "start": 3293,
        "end": 3297
      },
      "text": "མངར་ ༼པེ།༽ དངར་"
    },
    {
      "span": {
        "start": 3338,
        "end": 3344
      },
      "text": "གཏོགས་ ༼པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 3545,
        "end": 3551
      },
      "text": "བཞུག ། ༼སྣར།༽ གཞུག །"
    },
    {
      "span": {
        "start": 3833,
        "end": 3839
      },
      "text": "བསྟིམ། ༼པེ།༽ གཏིམ།"
    },
    {
      "span": {
        "start": 3841,
        "end": 3847
      },
      "text": "བསྟིམ་ ༼པེ།༽ གཏིམ་"
    },
    {
      "span": {
        "start": 4010,
        "end": 4015
      },
      "text": "གཞུག་ ༼པེ།༽ བཞུག་"
    },
    {
      "span": {
        "start": 4096,
        "end": 4103
      },
      "text": "ལྟར་ཏེ། ༼པེ།༽ ལྟ་རེ།"
    },
    {
      "span": {
        "start": 4487,
        "end": 4492
      },
      "text": "རྟང་། ༼སྣར།༽ བཏང་།"
    },
    {
      "span": {
        "start": 5234,
        "end": 5239
      },
      "text": "གཞུག་ ༼པེ།༽ བཞུག་"
    },
    {
      "span": {
        "start": 5327,
        "end": 5339
      },
      "text": "མཛད་པའོ།། །། ༼པེ།༽ མམཛད་པའོ་མངྒཱ་ལཾ། །།"
    }
  ]
}