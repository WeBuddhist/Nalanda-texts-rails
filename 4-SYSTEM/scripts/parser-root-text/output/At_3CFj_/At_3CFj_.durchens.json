{
  "durchens": [
    {
      "span": {
        "start": 30,
        "end": 33
      },
      "text": "ཏི། ༼སྣར། པེ།༽ ཏ།"
    },
    {
      "span": {
        "start": 1076,
        "end": 1090
      },
      "text": "འགྱུར་བར་གྱིས། ༼སྣར། པེ།༽ འགྱུར་བ་ན།"
    },
    {
      "span": {
        "start": 1299,
        "end": 1305
      },
      "text": "མིན་ལ། ༼སྣར། པེ།༽ མིན་པ།"
    },
    {
      "span": {
        "start": 1542,
        "end": 1548
      },
      "text": "འདྲ་བ་ ༼སྣར། པེ།༽ འདྲ་"
    },
    {
      "span": {
        "start": 2617,
        "end": 2627
      },
      "text": "རྟོགས་ཤིང་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 2895,
        "end": 2901
      },
      "text": "རྒྱུད་ ༼སྣར། པེ།༽ བརྒྱུད་"
    },
    {
      "span": {
        "start": 3724,
        "end": 3731
      },
      "text": "མུན་ནག་ ༼སྣར། པེ།༽ མུན་པ་"
    }
  ]
}