{
  "durchens": [
    {
      "span": {
        "start": 149,
        "end": 153
      },
      "text": "འཚལ་ ༼སྣར། པེ།༽ བཙལ་"
    },
    {
      "span": {
        "start": 423,
        "end": 430
      },
      "text": "བསྒྱུར་ ༼སྣར། པེ།༽ སྒྱུར་"
    },
    {
      "span": {
        "start": 477,
        "end": 488
      },
      "text": "མདོར་བསྟུན་ ༼སྣར། པེ།༽ མདོར་བསྡུས་"
    },
    {
      "span": {
        "start": 497,
        "end": 502
      },
      "text": "རྟགས་ ༼སྣར། པེ།༽ བརྟགས་"
    },
    {
      "span": {
        "start": 512,
        "end": 517
      },
      "text": "དཔྱད་ ༼སྣར། པེ།༽ སྤྱད་"
    },
    {
      "span": {
        "start": 777,
        "end": 780
      },
      "text": "ལྟ་ ༼སྣར། པེ།༽ བལྟ་"
    },
    {
      "span": {
        "start": 1006,
        "end": 1014
      },
      "text": "ལྡང་སྟེ་ ༼སྣར།༽ ལྡང་སྟེང་"
    },
    {
      "span": {
        "start": 1029,
        "end": 1034
      },
      "text": "སོགས་ ༼སྣར། པེ།༽ གསོག་"
    },
    {
      "span": {
        "start": 1076,
        "end": 1081
      },
      "text": "སོགས་ ༼སྣར། པེ།༽ གསོག་"
    },
    {
      "span": {
        "start": 1106,
        "end": 1113
      },
      "text": "སོགས། ། ༼སྣར། པེ།༽ གསོག །"
    },
    {
      "span": {
        "start": 1192,
        "end": 1201
      },
      "text": "བྲོ་དྲུག་ ༼སྣར། པེ།༽ རོ་དྲུག་"
    },
    {
      "span": {
        "start": 1244,
        "end": 1250
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 1363,
        "end": 1369
      },
      "text": "རྙིང་། ༼སྣར།༽ སྙིང་།"
    },
    {
      "span": {
        "start": 1438,
        "end": 1443
      },
      "text": "སྐྱེ་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 1516,
        "end": 1522
      },
      "text": "སྐྱེད། ༼སྣར། པེ།༽ བསྐྱེད།"
    },
    {
      "span": {
        "start": 1550,
        "end": 1556
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 1696,
        "end": 1702
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 1808,
        "end": 1814
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 1855,
        "end": 1857
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 1902,
        "end": 1905
      },
      "text": "མང་ ༼སྣར། པེ།༽ མངས་"
    },
    {
      "span": {
        "start": 1968,
        "end": 1978
      },
      "text": "སྐྱེ་བྱེད་ ༼སྣར། པེ།༽ སྐྱེད་བྱེད་"
    },
    {
      "span": {
        "start": 1997,
        "end": 1999
      },
      "text": "ཚ་ ༼སྣར།༽ ཚྭ་"
    },
    {
      "span": {
        "start": 2010,
        "end": 2013
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 2051,
        "end": 2059
      },
      "text": "གསུམ་ཡང་ ༼སྣར། པེ།༽ གསུམ་"
    },
    {
      "span": {
        "start": 2059,
        "end": 2063
      },
      "text": "རིམ་ ༼སྣར། པེ།༽ རིམ་པ་"
    },
    {
      "span": {
        "start": 2090,
        "end": 2092
      },
      "text": "ཚ་ ༼སྣར།༽ ཚྭ་"
    },
    {
      "span": {
        "start": 2115,
        "end": 2122
      },
      "text": "མར་ཞིང་ ༼སྣར། པེ།༽ རིམ་བཞིན་"
    },
    {
      "span": {
        "start": 2192,
        "end": 2196
      },
      "text": "ཚ་བ་ ༼སྣར། པེ།༽ ཚྭ་བ་"
    },
    {
      "span": {
        "start": 2212,
        "end": 2215
      },
      "text": "མར་ ༼སྣར། པེ།༽ མངར་"
    },
    {
      "span": {
        "start": 2270,
        "end": 2276
      },
      "text": "སྐྱེས་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 2466,
        "end": 2476
      },
      "text": "དྲོ་འཕྲོད་ ༼སྣར།༽ དྲོ་"
    },
    {
      "span": {
        "start": 2525,
        "end": 2531
      },
      "text": "འཕྲོད་ ༼སྣར།༽ འཕྲོས་"
    },
    {
      "span": {
        "start": 2596,
        "end": 2602
      },
      "text": "སྤྱོད་ ༼སྣར། པེ།༽ བསྐྱོད་"
    },
    {
      "span": {
        "start": 2708,
        "end": 2715
      },
      "text": "ལྡང་བས། ༼ཅོ།༽ ལྡན་པས།"
    },
    {
      "span": {
        "start": 2787,
        "end": 2792
      },
      "text": "སྦྲང་ ༼སྣར།༽ སྒྲང་"
    },
    {
      "span": {
        "start": 2831,
        "end": 2850
      },
      "text": "རྒུན་ཆང་སྒ་ཆུ་སྦྲང་ ༼སྣར།༽ རྒུན་ཆང་རྒ་ ༼པེ།༽ རྒུན་ཆང་རྒ་ཆུ་སྦྲང་"
    },
    {
      "span": {
        "start": 2862,
        "end": 2866
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ རྙིང་"
    },
    {
      "span": {
        "start": 2971,
        "end": 2974
      },
      "text": "ཆུ་ ༼སྣར།༽ རླུ་"
    },
    {
      "span": {
        "start": 3081,
        "end": 3088
      },
      "text": "གཉིས་མ་ ༼སྣར། པེ།༽ གཉིས་མར་"
    },
    {
      "span": {
        "start": 3224,
        "end": 3228
      },
      "text": "གྲང་ ༼སྣར། པེ།༽ གྲངས་"
    },
    {
      "span": {
        "start": 3258,
        "end": 3263
      },
      "text": "ལན་ཚ་ ༼སྣར། པེ།༽ ལན་ཚྭ་"
    },
    {
      "span": {
        "start": 3409,
        "end": 3416
      },
      "text": "སེར་བུ་ ༼སྣར། པེ།༽ བསེར་བུ་"
    },
    {
      "span": {
        "start": 3483,
        "end": 3492
      },
      "text": "སོགས་ཤིང་ ༼སྣར། པེ།༽ གསོག་ཅིང་"
    },
    {
      "span": {
        "start": 3542,
        "end": 3550
      },
      "text": "གཡོས་པས་ ༼སྣར། པེ།༽ གཡོ་བས་"
    },
    {
      "span": {
        "start": 3638,
        "end": 3643
      },
      "text": "གཏོང་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 3723,
        "end": 3729
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 3779,
        "end": 3792
      },
      "text": "མར་ཁུས་བླུགས་ ༼སྣར། པེ།༽ མར་ཁུ་བླུག་"
    },
    {
      "span": {
        "start": 3845,
        "end": 3850
      },
      "text": "གྲོག་ ༼སྣར། པེ།༽ འགྲོགས་"
    },
    {
      "span": {
        "start": 4056,
        "end": 4061
      },
      "text": "བཏིང་ ༼སྣར། པེ།༽ གདིང་"
    },
    {
      "span": {
        "start": 4592,
        "end": 4596
      },
      "text": "ཉིན་ ༼སྣར། པེ།༽ ཉི་"
    },
    {
      "span": {
        "start": 4600,
        "end": 4611
      },
      "text": "མི་བདེ་སྟེ། ༼སྣར། པེ།༽ མི་ལྡེ།"
    },
    {
      "span": {
        "start": 4629,
        "end": 4637
      },
      "text": "སེར་བུས་ ༼སྣར། པེ།༽ བསེར་བུས་"
    },
    {
      "span": {
        "start": 4708,
        "end": 4715
      },
      "text": "སོགས། ། ༼སྣར། པེ།༽ གསོག །"
    },
    {
      "span": {
        "start": 4744,
        "end": 4746
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 4759,
        "end": 4763
      },
      "text": "འདེ། ༼སྣར།༽ སྡེ ༼པེ།༽ ལྔ།"
    },
    {
      "span": {
        "start": 4788,
        "end": 4792
      },
      "text": "ཚིལ་ ༼སྣར། པེ།༽ ཚིག་"
    },
    {
      "span": {
        "start": 4917,
        "end": 4922
      },
      "text": "རྩེལ་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 5126,
        "end": 5130
      },
      "text": "གཏང་ ༼སྣར། པེ།༽ རྩལ་"
    },
    {
      "span": {
        "start": 5284,
        "end": 5292
      },
      "text": "བརྩམ་པར་ ༼པེ།༽ རྩམ་པར་"
    },
    {
      "span": {
        "start": 5478,
        "end": 5484
      },
      "text": "སྐྱོར་ ༼སྣར། པེ།༽ སྐྱོན་"
    },
    {
      "span": {
        "start": 5488,
        "end": 5496
      },
      "text": "ཕྱིན་ཆག་ ༼སྣར། པེ།༽ ཕྱིན་ཆད་"
    },
    {
      "span": {
        "start": 5566,
        "end": 5573
      },
      "text": "ལང་ཚོས་ ༼སྣར། པེ།༽ ལོངས་སྤྱོད་"
    },
    {
      "span": {
        "start": 5591,
        "end": 5595
      },
      "text": "ཤེས་ ༼སྣར། པེ།༽ ཤེད་"
    },
    {
      "span": {
        "start": 5599,
        "end": 5603
      },
      "text": "ཁུམ་ ༼སྣར། པེ།༽ ཞུམ་"
    },
    {
      "span": {
        "start": 5634,
        "end": 5639
      },
      "text": "བཤེས་ ༼སྣར།༽ གཤེས་"
    },
    {
      "span": {
        "start": 5750,
        "end": 5754
      },
      "text": "མཉན་ ༼སྣར། པེ།༽ མཉམ་"
    },
    {
      "span": {
        "start": 5769,
        "end": 5775
      },
      "text": "སྒྲུབ། ༼སྣར། པེ།༽ བསྒྲུབ།"
    },
    {
      "span": {
        "start": 5810,
        "end": 5815
      },
      "text": "བརྙས་ ༼སྣར།༽ བསྙས་"
    },
    {
      "span": {
        "start": 5883,
        "end": 5892
      },
      "text": "གྱི་དཔྱས་ ༼སྣར། པེ།༽ གྱིས་སྤྱས་"
    },
    {
      "span": {
        "start": 5907,
        "end": 5917
      },
      "text": "རྟོག་འདོད་ ༼སྣར། པེ།༽ གཏོགས་འདོད་"
    },
    {
      "span": {
        "start": 6028,
        "end": 6032
      },
      "text": "མཉན་ ༼སྣར། པེ།༽ གཉན་"
    },
    {
      "span": {
        "start": 6046,
        "end": 6050
      },
      "text": "རྩེ། ༼སྣར། པེ།༽ བརྩེ།"
    },
    {
      "span": {
        "start": 6122,
        "end": 6130
      },
      "text": "བསད་པའི་ ༼སྣར། པེ།༽ བསད་པ་"
    },
    {
      "span": {
        "start": 6276,
        "end": 6282
      },
      "text": "ཨརྒའི་ ༼སྣར། པེ།༽ ཨཱརྱའི་"
    },
    {
      "span": {
        "start": 6297,
        "end": 6302
      },
      "text": "འགོང་ ༼སྣར། པེ།༽ འགོམ་"
    },
    {
      "span": {
        "start": 6325,
        "end": 6330
      },
      "text": "སྟགས་ ༼སྣར། པེ།༽ བཏགས་"
    },
    {
      "span": {
        "start": 6442,
        "end": 6449
      },
      "text": "དང་ཡང་། ༼སྣར། པེ།༽ དང་སྤང་།"
    },
    {
      "span": {
        "start": 6616,
        "end": 6622
      },
      "text": "རྒྱོས་ ༼སྣར། པེ།༽ རྒྱོ་"
    },
    {
      "span": {
        "start": 6664,
        "end": 6669
      },
      "text": "དགོད་ ༼སྣར། པེ།༽ རྒོད་"
    },
    {
      "span": {
        "start": 6756,
        "end": 6762
      },
      "text": "ཁུ་ཆུ་ ༼སྣར། པེ།༽ ཁ་ཆུ་"
    },
    {
      "span": {
        "start": 6773,
        "end": 6779
      },
      "text": "འཕྱེན་ ༼སྣར། པེ།༽ ཕྱིན་"
    },
    {
      "span": {
        "start": 6787,
        "end": 6792
      },
      "text": "དབྱལ། ༼སྣར། པེ།༽ གཡལ།"
    },
    {
      "span": {
        "start": 6885,
        "end": 6890
      },
      "text": "མཇིང་ ༼སྣར།༽ འཇིང་"
    },
    {
      "span": {
        "start": 7015,
        "end": 7022
      },
      "text": "མགོ་བོ་ ༼སྣར། པེ།༽ མགོ་ལ་"
    },
    {
      "span": {
        "start": 7032,
        "end": 7042
      },
      "text": "སྤྲུགས་ཏེ། ༼སྣར། པེ།༽ སྤྲུ་སྟེ།"
    },
    {
      "span": {
        "start": 7078,
        "end": 7082
      },
      "text": "མཆུ་ ༼སྣར། པེ།༽ ཆུ་"
    },
    {
      "span": {
        "start": 7094,
        "end": 7098
      },
      "text": "ནུས་ ༼སྣར།༽ ནུ་"
    },
    {
      "span": {
        "start": 7106,
        "end": 7109
      },
      "text": "ཅི་ ༼སྣར། པེ།༽ ལྕི་"
    },
    {
      "span": {
        "start": 7112,
        "end": 7117
      },
      "text": "གདགས་ ༼སྣར། པེ།༽ འདེགས་"
    },
    {
      "span": {
        "start": 7126,
        "end": 7130
      },
      "text": "གནན་ ༼སྣར། པེ།༽ མནན་"
    },
    {
      "span": {
        "start": 7174,
        "end": 7183
      },
      "text": "དུས་བཞིན་ ༼སྣར། པེ།༽ དུས་གཞན་"
    },
    {
      "span": {
        "start": 7263,
        "end": 7275
      },
      "text": "ཡིན་དུས་གཞན་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 7302,
        "end": 7310
      },
      "text": "བླུགས། ། ༼སྣར། པེ།༽ བླུག །"
    },
    {
      "span": {
        "start": 7414,
        "end": 7421
      },
      "text": "སེར་བུ་ ༼སྣར། པེ།༽ བསེར་བུ་"
    },
    {
      "span": {
        "start": 7503,
        "end": 7509
      },
      "text": "གཏང་བ་ ༼སྣར། པེ།༽ བཏང་བ་"
    },
    {
      "span": {
        "start": 7509,
        "end": 7513
      },
      "text": "དང་། ༼སྣར།༽ ལ།"
    },
    {
      "span": {
        "start": 7569,
        "end": 7574
      },
      "text": "རེངས་ ༼སྣར། པེ།༽ རེང་"
    },
    {
      "span": {
        "start": 7580,
        "end": 7588
      },
      "text": "ཙོག་པུར་ ༼སྣར། པེ།༽ ཙོག་པོར་"
    },
    {
      "span": {
        "start": 7961,
        "end": 7967
      },
      "text": "སྐྱེད། ༼སྣར། པེ།༽ བསྐྱེད།"
    },
    {
      "span": {
        "start": 7978,
        "end": 7985
      },
      "text": "དྲོ་བབ་ ༼སྣར། པེ།༽ དྲོ་བ་"
    },
    {
      "span": {
        "start": 8011,
        "end": 8016
      },
      "text": "འཐུང་ ༼སྣར། པེ།༽ བཏུང་"
    },
    {
      "span": {
        "start": 8105,
        "end": 8110
      },
      "text": "འཕྲད་ ༼སྣར། པེ།༽ ཕྲད་"
    },
    {
      "span": {
        "start": 8120,
        "end": 8124
      },
      "text": "འགམ། ༼སྣར། པེ།༽ བཀམ།"
    },
    {
      "span": {
        "start": 8263,
        "end": 8267
      },
      "text": "བརྟ་ ༼སྣར། པེ།༽ རྟ་"
    },
    {
      "span": {
        "start": 8278,
        "end": 8283
      },
      "text": "བསོད། ༼སྣར། པེ།༽ གསོད།"
    },
    {
      "span": {
        "start": 8285,
        "end": 8294
      },
      "text": "བྲོ་དྲུག་ ༼སྣར། པེ།༽ རོ་དྲུག་"
    },
    {
      "span": {
        "start": 8311,
        "end": 8315
      },
      "text": "ཟོས་ ༼སྣར།༽ ཟོད་"
    },
    {
      "span": {
        "start": 8407,
        "end": 8410
      },
      "text": "མང་ ༼སྣར། པེ།༽ མངས་"
    },
    {
      "span": {
        "start": 8446,
        "end": 8457
      },
      "text": "འབྲིང་པོའི་ ༼སྣར། པེ།༽ འབྲིང་པོ་"
    },
    {
      "span": {
        "start": 8476,
        "end": 8480
      },
      "text": "དྲག་ ༼སྣར། པེ།༽ དྲགས་"
    },
    {
      "span": {
        "start": 8682,
        "end": 8688
      },
      "text": "ཆང་དུ་ ༼སྣར། པེ།༽ ཆང་ཆུ་"
    },
    {
      "span": {
        "start": 8742,
        "end": 8748
      },
      "text": "སློང་། ༼སྣར།༽ ཀློང་།"
    },
    {
      "span": {
        "start": 8775,
        "end": 8783
      },
      "text": "ཀེའུ་ནི་ ༼སྣར། པེ།༽ ཀི་ལུན་"
    },
    {
      "span": {
        "start": 8837,
        "end": 8846
      },
      "text": "ཞོ་འདྲེར་ ༼སྣར། པེ།༽ ཞོར་འདྲེས་"
    },
    {
      "span": {
        "start": 8867,
        "end": 8874
      },
      "text": "བསྲེགས་ ༼སྣར།༽ བསྲེག་"
    },
    {
      "span": {
        "start": 8996,
        "end": 8999
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 9014,
        "end": 9020
      },
      "text": "མདོངས། ༼སྣར། པེ།༽ ལྡོང་།"
    },
    {
      "span": {
        "start": 9073,
        "end": 9079
      },
      "text": "བྲ་བོ་ ༼སྣར།༽ བྲ་དོ་"
    },
    {
      "span": {
        "start": 9128,
        "end": 9131
      },
      "text": "ཆང་ ༼སྣར།༽ འཆང་"
    },
    {
      "span": {
        "start": 9142,
        "end": 9147
      },
      "text": "རྙིད་ ༼སྣར།༽ སྙིང་"
    },
    {
      "span": {
        "start": 9302,
        "end": 9312
      },
      "text": "ཉུངས་རྙིང་ ༼སྣར།༽ ཡུངས་རྙིངས་ ༼པེ།༽ ཡུངས་རྙིང་"
    },
    {
      "span": {
        "start": 9377,
        "end": 9382
      },
      "text": "གྲོག་ ༼སྣར། པེ།༽ བགྲོག་"
    },
    {
      "span": {
        "start": 9463,
        "end": 9470
      },
      "text": "ཤ་རྟ་ཤ་ ༼སྣར། པེ།༽ ཤ་ཤ་རྟ་"
    },
    {
      "span": {
        "start": 9703,
        "end": 9707
      },
      "text": "ཅུང་ ༼སྣར།༽ ཅུ་"
    },
    {
      "span": {
        "start": 9778,
        "end": 9781
      },
      "text": "ཙམ་ ༼སྣར། པེ།༽ ཙམ་ཙི་དང་"
    },
    {
      "span": {
        "start": 9882,
        "end": 9888
      },
      "text": "ཆགས་པ་ ༼སྣར། པེ།༽ འཆག་པ་"
    },
    {
      "span": {
        "start": 10084,
        "end": 10093
      },
      "text": "དགར་གཞག ། ༼ཅོ།༽ གར་གཞག ༼སྣར། པེ།༽ གར་བཞག །"
    },
    {
      "span": {
        "start": 10128,
        "end": 10136
      },
      "text": "བརྩལ་བར་ ༼སྣར། པེ།༽ རྩོལ་བར་"
    },
    {
      "span": {
        "start": 10174,
        "end": 10184
      },
      "text": "ཁྱུད་འཁོར་ ༼སྣར། པེ།༽ ཁྱུད་ཁོར་"
    }
  ]
}