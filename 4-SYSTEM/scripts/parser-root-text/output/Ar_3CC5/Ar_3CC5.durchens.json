{
  "durchens": [
    {
      "span": {
        "start": 27,
        "end": 29
      },
      "text": "ག་ ༼ཅོ། སྡེ།༽ གྷ་"
    },
    {
      "span": {
        "start": 139,
        "end": 143
      },
      "text": "ཉིད་ ༼ཅོ།༽ ནི་"
    },
    {
      "span": {
        "start": 392,
        "end": 400
      },
      "text": "ཉིད་ཀྱི་ ༼ཅོ། སྡེ།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 977,
        "end": 987
      },
      "text": "སྐྱོན་གྱི་ ༼ཅོ།༽ སྐྱོན་གྱིས་"
    },
    {
      "span": {
        "start": 2403,
        "end": 2407
      },
      "text": "གྱི་ ༼ཅོ། སྡེ།༽ གྱིས་"
    },
    {
      "span": {
        "start": 2527,
        "end": 2533
      },
      "text": "བ་དང་། ༼ཅོ། སྡེ།༽ བ།"
    },
    {
      "span": {
        "start": 2565,
        "end": 2568
      },
      "text": "གི་ ༼ཅོ། སྡེ།༽ གི་ནུ་"
    },
    {
      "span": {
        "start": 2681,
        "end": 2688
      },
      "text": "གཞལ་ཡས་ ༼ཅོ། སྡེ།༽ གཞལ་མེད་"
    },
    {
      "span": {
        "start": 2933,
        "end": 2944
      },
      "text": "ཚོམ་སྒྲེངས་ ༼ཅོ། སྡེ།༽ ཚོགས་སྦྲེངས་"
    },
    {
      "span": {
        "start": 3844,
        "end": 3851
      },
      "text": "བསམས་པ་ ༼སྣར། པེ།༽ བསམ་པ་"
    },
    {
      "span": {
        "start": 3873,
        "end": 3879
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 4190,
        "end": 4202
      },
      "text": "བསྒྲིབས་པའི་ ༼སྣར། པེ།༽ བསྒྲིབ་པའི་"
    },
    {
      "span": {
        "start": 4213,
        "end": 4222
      },
      "text": "འཇིགས་པས་ ༼སྣར། པེ།༽ འཇིགས་པ་"
    },
    {
      "span": {
        "start": 4273,
        "end": 4285
      },
      "text": "བསྒྲུབས་པའི་ ༼སྣར། པེ།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 4304,
        "end": 4310
      },
      "text": "ཡིན་པ་ ༼སྣར། པེ།༽ ཡིན་པར་"
    },
    {
      "span": {
        "start": 4884,
        "end": 4896
      },
      "text": "དེ་ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ དེ་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 5019,
        "end": 5030
      },
      "text": "ཉོན་མོངས་པ་ ༼སྣར། པེ།༽ ཉོན་མོངས་"
    },
    {
      "span": {
        "start": 5222,
        "end": 5230
      },
      "text": "རིགས་པས་ ༼སྣར། པེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 5285,
        "end": 5294
      },
      "text": "མི་འཕྲུལ་ ༼སྣར། པེ།༽ མིག་འཕྲུལ་"
    },
    {
      "span": {
        "start": 5504,
        "end": 5506
      },
      "text": "ལ། ༼ཅོ།༽ ལས།"
    }
  ]
}