{
  "durchens": [
    {
      "span": {
        "start": 169,
        "end": 178
      },
      "text": "གསོ་དཔྱད་ ༼སྣར། པེ།༽ གསོ་སྤྱད་"
    },
    {
      "span": {
        "start": 258,
        "end": 266
      },
      "text": "བཅིང་བར་ ༼སྣར། པེ།༽ བཅིངས་པར་"
    },
    {
      "span": {
        "start": 401,
        "end": 404
      },
      "text": "གླ་ ༼སྣར། པེ།༽ སླ་"
    },
    {
      "span": {
        "start": 437,
        "end": 463
      },
      "text": "གླ་སྒང་ཏིག་ཏ་པརྤ་ཏ། །བ་ཤཀ་ ༼སྣར། པེ།༽ གླ་སྒང་ཏིཀྟ་པརྦ་ཊ། བཱ་སཱ་"
    },
    {
      "span": {
        "start": 626,
        "end": 631
      },
      "text": "དང་ཀ་ ༼སྡེ།༽ དང་ག་"
    },
    {
      "span": {
        "start": 665,
        "end": 670
      },
      "text": "རིམས་ ༼སྣར། པེ།༽ རིམ་"
    },
    {
      "span": {
        "start": 908,
        "end": 916
      },
      "text": "བླ་འཆོལ་ ༼སྣར། པེ།༽ བསླབ་བཙོལ་"
    },
    {
      "span": {
        "start": 962,
        "end": 965
      },
      "text": "ཕན། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 971,
        "end": 976
      },
      "text": "ཀ་རི་ ༼སྣར། པེ།༽ ཀཱ་རི་"
    },
    {
      "span": {
        "start": 1000,
        "end": 1005
      },
      "text": "དྲོད་ ༼སྣར། པེ།༽ དྲོ་"
    },
    {
      "span": {
        "start": 1084,
        "end": 1087
      },
      "text": "ཆམ་ ༼སྣར། པེ།༽ ཆབ་"
    },
    {
      "span": {
        "start": 1125,
        "end": 1127
      },
      "text": "ཏ་ ༼སྣར། པེ།༽ ཊ་"
    },
    {
      "span": {
        "start": 1142,
        "end": 1156
      },
      "text": "ཧོང་ལེན་ཏིག་ཏ་ ༼སྣར། པེ།༽ ཧོང་ལེན་ཏིཏྦ་"
    },
    {
      "span": {
        "start": 1244,
        "end": 1249
      },
      "text": "རིམས་ ༼པེ།༽ རིམ་"
    },
    {
      "span": {
        "start": 1260,
        "end": 1265
      },
      "text": "དཔྱད་ ༼སྣར། པེ།༽ སྤྱད་"
    },
    {
      "span": {
        "start": 1265,
        "end": 1270
      },
      "text": "དོ། ། ༼སྣར།༽ ། །།། ༼པེ།༽ །།"
    },
    {
      "span": {
        "start": 1302,
        "end": 1304
      },
      "text": "ལ། ༼སྣར།༽ ལཱ།"
    },
    {
      "span": {
        "start": 1418,
        "end": 1421
      },
      "text": "དི་ ༼སྣར། པེ།༽ དཱི་"
    },
    {
      "span": {
        "start": 1429,
        "end": 1433
      },
      "text": "པེད་ ༼སྣར། པེ།༽ བདེ་"
    },
    {
      "span": {
        "start": 1483,
        "end": 1488
      },
      "text": "གཟེར་ ༼སྣར།༽ ཟེར་"
    },
    {
      "span": {
        "start": 1508,
        "end": 1510
      },
      "text": "པ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 1589,
        "end": 1597
      },
      "text": "ཆ་སྙོམས་ ༼སྣར། པེ།༽ ཆ་མཉམ་"
    },
    {
      "span": {
        "start": 1634,
        "end": 1640
      },
      "text": "རྒྱུན་ ༼སྣར། པེ།༽ རྒུན་"
    },
    {
      "span": {
        "start": 1696,
        "end": 1704
      },
      "text": "ལྤགས་ནད་ ༼སྣར། པེ།༽ པགས་ནད་"
    },
    {
      "span": {
        "start": 1723,
        "end": 1726
      },
      "text": "ནད། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 1747,
        "end": 1752
      },
      "text": "མགུལ་ ༼ཅོ།༽ འགུལ་"
    },
    {
      "span": {
        "start": 1824,
        "end": 1827
      },
      "text": "གླ་ ༼སྣར། པེ།༽ བླ་"
    },
    {
      "span": {
        "start": 1834,
        "end": 1838
      },
      "text": "ཀྲུ་ ༼སྣར། པེ།༽ གྲུ་"
    },
    {
      "span": {
        "start": 1858,
        "end": 1870
      },
      "text": "བྱི་དང་དྲོད་ ༼སྣར། པེ།༽ བི་ཏ་གྲོ་"
    },
    {
      "span": {
        "start": 1924,
        "end": 1927
      },
      "text": "བུ་ ༼སྣར།༽ ཕུ་ ༼པེ།༽ པུ་"
    },
    {
      "span": {
        "start": 1982,
        "end": 1987
      },
      "text": "དྲོད་ ༼སྣར། པེ།༽ དྲོ་"
    },
    {
      "span": {
        "start": 2141,
        "end": 2146
      },
      "text": "དྲོད་ ༼སྣར། པེ།༽ དྲོ་"
    },
    {
      "span": {
        "start": 2206,
        "end": 2211
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ ཙམ་"
    },
    {
      "span": {
        "start": 2404,
        "end": 2406
      },
      "text": "བ་ ༼སྣར། པེ།༽ བཱ་"
    },
    {
      "span": {
        "start": 2530,
        "end": 2533
      },
      "text": "ལི་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 2563,
        "end": 2566
      },
      "text": "ཆུ་ ༼སྣར། པེ།༽ ཆུན་"
    },
    {
      "span": {
        "start": 2669,
        "end": 2673
      },
      "text": "བྲི་ ༼སྣར། པེ།༽ བི་"
    },
    {
      "span": {
        "start": 2794,
        "end": 2800
      },
      "text": "གདུང་། ༼སྣར། པེ།༽ བཏུང་།"
    },
    {
      "span": {
        "start": 2960,
        "end": 2962
      },
      "text": "ཚ་ ༼སྣར། པེ།༽ ཙ་"
    },
    {
      "span": {
        "start": 2964,
        "end": 2974
      },
      "text": "སྙོམས་ཕྱེ། ༼སྣར། པེ།༽ སྙམ་ཕྱེད་།"
    },
    {
      "span": {
        "start": 3075,
        "end": 3079
      },
      "text": "ཁུས་ ༼སྣར། པེ།༽ ཁྲུས་"
    },
    {
      "span": {
        "start": 3155,
        "end": 3162
      },
      "text": "བརྩེགས། ༼སྣར། པེ།༽ བཙེགས།"
    },
    {
      "span": {
        "start": 3262,
        "end": 3269
      },
      "text": "སརྫིཀ ་ ༼སྣར།༽ སརྫིཀསྭརྩི་ ༼པེ།༽ སརྫིཀསིརྩ་"
    },
    {
      "span": {
        "start": 3491,
        "end": 3497
      },
      "text": "ག་མེད་ ༼སྣར། པེ།༽ ཀ་མེད་"
    },
    {
      "span": {
        "start": 3497,
        "end": 3505
      },
      "text": "ཆམ་སྟོད་ ༼སྣར། པེ།༽ ཆབ་སྟོད་"
    },
    {
      "span": {
        "start": 3539,
        "end": 3549
      },
      "text": "ཨརྐ་ཤིཀྲུ་ ༼སྣར། པེ།༽ ཨརྒ་ཤིགྲུ་"
    },
    {
      "span": {
        "start": 3563,
        "end": 3583
      },
      "text": "བྱ་ཀྲི་བྲི་ཧ་ཏི། །པ་ ༼སྣར། པེ།༽ བྱཱ་གྷི་བྲིཧ་ཏཱི། པཱ་"
    },
    {
      "span": {
        "start": 3606,
        "end": 3608
      },
      "text": "པ་ ༼སྣར། པེ།༽ བཱ་"
    },
    {
      "span": {
        "start": 3628,
        "end": 3630
      },
      "text": "ཤ་ ༼སྣར། པེ།༽ ཥ་"
    },
    {
      "span": {
        "start": 3696,
        "end": 3707
      },
      "text": "ལ་སོགས་བཏབ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 3744,
        "end": 3749
      },
      "text": "ཙ་བྱ་ ༼སྣར། པེ།༽ ཙ་བྱཱ་"
    },
    {
      "span": {
        "start": 3787,
        "end": 3790
      },
      "text": "ཅུ་ ༼སྣར། པེ།༽ བཅུ་"
    },
    {
      "span": {
        "start": 3908,
        "end": 3911
      },
      "text": "ཅུ་ ༼སྣར། པེ།༽ བཅུ་"
    },
    {
      "span": {
        "start": 3925,
        "end": 3929
      },
      "text": "སུམ་ ༼སྣར། པེ།༽ གསུམ་"
    },
    {
      "span": {
        "start": 3961,
        "end": 3971
      },
      "text": "རི་ལུ་བྱས། ༼སྣར། པེ།༽ རིལ་བྱར་མུར།"
    },
    {
      "span": {
        "start": 3977,
        "end": 3990
      },
      "text": "གཞི་གློ་རིམས་ ༼ཅོ།༽ གཞི་བློའི་ཟར་ ༼སྣར། པེ།༽ བཞི་གློ་རིམས་"
    },
    {
      "span": {
        "start": 4018,
        "end": 4023
      },
      "text": "དྲོས་ ༼སྣར། པེ།༽ དྲོད་"
    },
    {
      "span": {
        "start": 4042,
        "end": 4044
      },
      "text": "ཚ། ༼ཅོ།༽ ཙ།"
    },
    {
      "span": {
        "start": 4109,
        "end": 4112
      },
      "text": "མེ་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 4138,
        "end": 4143
      },
      "text": "འགུལ་ ༼སྣར། པེ།༽ མགུལ་"
    },
    {
      "span": {
        "start": 4212,
        "end": 4220
      },
      "text": "རིལ་བུར་ ༼སྣར།༽ རིལ་བུ་"
    },
    {
      "span": {
        "start": 4316,
        "end": 4324
      },
      "text": "རྒྱ་ཤུག་ ༼ཅོ།༽ རྒྱ་ཤུགས་ ༼སྣར།༽ བརྒྱ་ཤུགས་"
    },
    {
      "span": {
        "start": 4466,
        "end": 4474
      },
      "text": "དྲོ་སྨན་ ༼སྣར། པེ།༽ དྲོད་སྨན་"
    },
    {
      "span": {
        "start": 4519,
        "end": 4524
      },
      "text": "རྙིང་ ༼སྣར། པེ།༽ སྙིང་"
    },
    {
      "span": {
        "start": 4750,
        "end": 4754
      },
      "text": "ཕྱེ་ ༼སྣར། པེ།༽ ཆེ་"
    },
    {
      "span": {
        "start": 4772,
        "end": 4777
      },
      "text": "སྲ་བ་ ༼སྣར། པེ།༽ སྲུ་པ་"
    },
    {
      "span": {
        "start": 4941,
        "end": 4945
      },
      "text": "ནུས་ ༼སྣར། པེ།༽ པུས་"
    },
    {
      "span": {
        "start": 5037,
        "end": 5043
      },
      "text": "བསྟེན། ༼སྣར། པེ།༽ བསྟན།"
    },
    {
      "span": {
        "start": 5314,
        "end": 5324
      },
      "text": "པོས་བྱུགས་ ༼སྣར། པེ།༽ པས་བྱུག་"
    },
    {
      "span": {
        "start": 5393,
        "end": 5397
      },
      "text": "བྲི་ ༼སྣར། པེ།༽ བྷི་"
    },
    {
      "span": {
        "start": 5497,
        "end": 5501
      },
      "text": "སེར་ ༼སྣར།༽ སེ་"
    },
    {
      "span": {
        "start": 5525,
        "end": 5533
      },
      "text": "སྤྲ་ཚིལ་ ༼སྣར། པེ།༽ པྲ་ཚིལ་"
    },
    {
      "span": {
        "start": 5544,
        "end": 5549
      },
      "text": "སྤངས་ ༼སྣར། པེ།༽ པང་"
    },
    {
      "span": {
        "start": 5649,
        "end": 5653
      },
      "text": "རྩི་ ༼སྣར། པེ།༽ བརྩི་"
    },
    {
      "span": {
        "start": 5689,
        "end": 5694
      },
      "text": "བཙོད་ ༼སྣར། པེ།༽ བརྩོད་"
    },
    {
      "span": {
        "start": 5787,
        "end": 5792
      },
      "text": "ཀ་རི་ ༼སྣར། པེ།༽ ཀཱ་རི་"
    },
    {
      "span": {
        "start": 5801,
        "end": 5803
      },
      "text": "བ་ ༼སྣར། པེ།༽ པཱ་"
    },
    {
      "span": {
        "start": 5808,
        "end": 5814
      },
      "text": "ཕྱེ་མ་ ༼སྣར། པེ།༽ ཕྱེ་མར་"
    },
    {
      "span": {
        "start": 5914,
        "end": 5916
      },
      "text": "བ་ ༼སྣར། པེ།༽ བཱ་"
    },
    {
      "span": {
        "start": 6016,
        "end": 6021
      },
      "text": "སྐྲན་ ༼སྣར། པེ།༽ བསྐྲན་"
    },
    {
      "span": {
        "start": 6028,
        "end": 6036
      },
      "text": "རྒྱལ་བར་ ༼སྣར། པེ།༽ བརྒྱལ་བར་"
    },
    {
      "span": {
        "start": 6253,
        "end": 6259
      },
      "text": "ཆུ་མར་ ༼སྣར། པེ།༽ ཆུང་ར་"
    },
    {
      "span": {
        "start": 6275,
        "end": 6279
      },
      "text": "བཙོ། ༼སྣར། པེ།༽ གཙོ།"
    },
    {
      "span": {
        "start": 6378,
        "end": 6403
      },
      "text": "གསུམ་དྲི་གསུམ་ཟིར་ལྡན་པར་ ༼སྣར།༽ གསུམ་ཟིར་ལྡན་པ་རི་ ༼པེ།༽ གསུམ་ཟིར་ལྡན་པར་"
    },
    {
      "span": {
        "start": 6476,
        "end": 6484
      },
      "text": "ལུད་ཁྲག་ ༼སྣར།༽ ལུས་ཁྲག་"
    },
    {
      "span": {
        "start": 6555,
        "end": 6560
      },
      "text": "དྲོད་ ༼སྣར། པེ།༽ དྲོ་"
    },
    {
      "span": {
        "start": 6740,
        "end": 6751
      },
      "text": "བཞིན་བླུགས་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 6781,
        "end": 6790
      },
      "text": "མུར་འགྲམ་ ༼སྣར། པེ།༽ མུ་འགྲམ་"
    },
    {
      "span": {
        "start": 6878,
        "end": 6882
      },
      "text": "སུམ་ ༼སྣར།༽ གསུམ་"
    },
    {
      "span": {
        "start": 6887,
        "end": 6895
      },
      "text": "གཅིག་གམ་ ༼སྣར། པེ།༽ གཅིག་གི་"
    },
    {
      "span": {
        "start": 6963,
        "end": 6974
      },
      "text": "འཁྲུགས་པའང་ ༼སྣར། པེ།༽ འཁྲུག་པའང་"
    },
    {
      "span": {
        "start": 7099,
        "end": 7106
      },
      "text": "མིག་གི་ ༼སྣར། པེ།༽ མིག་གིས་"
    },
    {
      "span": {
        "start": 7205,
        "end": 7211
      },
      "text": "བྱུགས་ ༼སྣར། པེ།༽ བྱུག་"
    },
    {
      "span": {
        "start": 7221,
        "end": 7227
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 7271,
        "end": 7277
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 7291,
        "end": 7295
      },
      "text": "ལྦུ་ ༼སྣར། པེ།༽ སྤུ་"
    },
    {
      "span": {
        "start": 7313,
        "end": 7318
      },
      "text": "དྲོད་ ༼སྣར། པེ།༽ གྲོ་"
    },
    {
      "span": {
        "start": 7343,
        "end": 7351
      },
      "text": "ལིག་མིག་ ༼སྣར། པེ།༽ ལུག་མིག་"
    },
    {
      "span": {
        "start": 7369,
        "end": 7375
      },
      "text": "འགྲིབ་ ༼སྣར། པེ།༽ འགྲིབས་"
    },
    {
      "span": {
        "start": 7448,
        "end": 7452
      },
      "text": "ལྦུ། ༼སྣར། པེ།༽ སྦུ།"
    },
    {
      "span": {
        "start": 7646,
        "end": 7653
      },
      "text": "སྤངས་མ་ ༼སྣར། པེ།༽ སྤང་མ་"
    },
    {
      "span": {
        "start": 7653,
        "end": 7656
      },
      "text": "སམ་ ༼སྣར། པེ།༽ སང་"
    },
    {
      "span": {
        "start": 7777,
        "end": 7787
      },
      "text": "བྱུགས་པའང་ ༼སྣར། པེ།༽ བྱུག་པའང་"
    },
    {
      "span": {
        "start": 7838,
        "end": 7844
      },
      "text": "གི་ཝང་ ༼སྣར། པེ།༽ གི་ཧང་"
    },
    {
      "span": {
        "start": 7851,
        "end": 7860
      },
      "text": "སྤང་སྤོས་ ༼སྣར། པེ།༽ སྤང་པོས་"
    },
    {
      "span": {
        "start": 7898,
        "end": 7902
      },
      "text": "འདབ། ༼སྣར། པེ།༽ གདབ།"
    },
    {
      "span": {
        "start": 7983,
        "end": 7998
      },
      "text": "གཟེར་ནས་འཕྲོགས་ ༼སྣར། པེ།༽ གཟེར་ནད་འཕྲོག་"
    },
    {
      "span": {
        "start": 8038,
        "end": 8043
      },
      "text": "དོ། ། ༼སྣར། པེ།༽ རྫོགས་སོ། །།།"
    },
    {
      "span": {
        "start": 8086,
        "end": 8109
      },
      "text": "ཧོང་ལེན་མ་ནུ་པ་ཐའི་ཐང་། ༼ཅོ།༽ མ་ནུ་པ་ཐ་མའི་བང་ ༼སྣར། པེ།༽ པཱ་ཏྲའི་ཐང་།"
    },
    {
      "span": {
        "start": 8118,
        "end": 8121
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 8192,
        "end": 8197
      },
      "text": "ཏི་པ་ ༼སྣར། པེ།༽ ཏ་པ་"
    },
    {
      "span": {
        "start": 8197,
        "end": 8199
      },
      "text": "ཐ་ ༼སྣར། པེ།༽ ཐཱ་"
    },
    {
      "span": {
        "start": 8228,
        "end": 8233
      },
      "text": "དྲོད་ ༼སྣར། པེ།༽ གྲོ་"
    },
    {
      "span": {
        "start": 8258,
        "end": 8261
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 8282,
        "end": 8288
      },
      "text": "བྱ་ཡི་ ༼སྣར། པེ།༽ བྱའོ་"
    },
    {
      "span": {
        "start": 8333,
        "end": 8344
      },
      "text": "མེ་ཏོག་དང་། ༼སྣར། པེ།༽ མེ་ཏོག་གི།"
    },
    {
      "span": {
        "start": 8520,
        "end": 8524
      },
      "text": "པ་ཐ་ ༼སྣར། པེ།༽ པཱ་ཐཱ་"
    },
    {
      "span": {
        "start": 8581,
        "end": 8588
      },
      "text": "འཁྱུགས་ ༼སྣར།༽ འཁྱུག་ ༼པེ།༽ འཁྲུག་"
    },
    {
      "span": {
        "start": 8616,
        "end": 8619
      },
      "text": "བི་ ༼སྣར།༽ པྲི་ ༼པེ།༽ པཱི་"
    },
    {
      "span": {
        "start": 8716,
        "end": 8725
      },
      "text": "བླུགས་པས་ ༼པེ།༽ བླུག་པས་"
    },
    {
      "span": {
        "start": 8760,
        "end": 8765
      },
      "text": "ལ་དང་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 8863,
        "end": 8866
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 8926,
        "end": 8934
      },
      "text": "ལྤགས་ནད་ ༼སྣར། པེ།༽ པགས་ནད་"
    },
    {
      "span": {
        "start": 9001,
        "end": 9004
      },
      "text": "རྩ་ ༼སྣར། པེ།༽ ཙ་"
    },
    {
      "span": {
        "start": 9021,
        "end": 9023
      },
      "text": "ཏ་ ༼སྣར། པེ།༽ ཊ་"
    },
    {
      "span": {
        "start": 9026,
        "end": 9031
      },
      "text": "དྲོད་ ༼སྣར། པེ།༽ རོ་"
    },
    {
      "span": {
        "start": 9108,
        "end": 9112
      },
      "text": "དམར། ༼སྣར། པེ།༽ མངར།"
    },
    {
      "span": {
        "start": 9144,
        "end": 9147
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 9239,
        "end": 9243
      },
      "text": "ལའོ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 9256,
        "end": 9262
      },
      "text": "པོ་ཡི་ ༼སྣར། པེ།༽ པོའི་"
    },
    {
      "span": {
        "start": 9323,
        "end": 9339
      },
      "text": "སྟར་གའི་འབྲས་བུ་ ༼སྣར། པེ།༽ ཏ་ཁར་ཡི་མར་ཁུ་"
    },
    {
      "span": {
        "start": 9345,
        "end": 9351
      },
      "text": "བཅས་པ་ ༼སྣར། པེ།༽ བཅས་"
    },
    {
      "span": {
        "start": 9354,
        "end": 9361
      },
      "text": "གྲུབ་པ། ༼སྣར། པེ།༽ གྲུབ་།"
    },
    {
      "span": {
        "start": 9499,
        "end": 9505
      },
      "text": "བླུགས་ ༼སྣར། པེ།༽ བླུག་པར་"
    },
    {
      "span": {
        "start": 9514,
        "end": 9524
      },
      "text": "དེ་ཉིད་དུ་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 9591,
        "end": 9600
      },
      "text": "བདུགས་པས་ ༼སྣར། པེ།༽ གདུག་པའི་"
    },
    {
      "span": {
        "start": 9622,
        "end": 9625
      },
      "text": "རྩ་ ༼སྣར། པེ།༽ ཙ་"
    },
    {
      "span": {
        "start": 9663,
        "end": 9677
      },
      "text": "རྡོལ་བའི་ལྤགས་ ༼སྣར། པེ།༽ བརྡོལ་པའི་པགས་"
    },
    {
      "span": {
        "start": 9809,
        "end": 9813
      },
      "text": "བཙོ་ ༼སྣར། པེ།༽ གཙོ་"
    },
    {
      "span": {
        "start": 9891,
        "end": 9894
      },
      "text": "དང་ ༼སྣར།༽ ད་"
    },
    {
      "span": {
        "start": 9955,
        "end": 9963
      },
      "text": "སྤྲ་ཚིལ་ ༼སྣར། པེ།༽ པྲ་ཚིལ་"
    },
    {
      "span": {
        "start": 9963,
        "end": 9968
      },
      "text": "སྤངས་ ༼སྣར། པེ།༽ པངས་"
    },
    {
      "span": {
        "start": 9997,
        "end": 10000
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 10041,
        "end": 10044
      },
      "text": "རྩ་ ༼སྣར། པེ།༽ ཙ་"
    },
    {
      "span": {
        "start": 10217,
        "end": 10227
      },
      "text": "སྦྲུལ་གྱི་ ༼སྣར། པེ།༽ སྦྲུལ་གྱིས་"
    },
    {
      "span": {
        "start": 10764,
        "end": 10770
      },
      "text": "གི་ཝང་ ༼སྣར།༽ གྷ་ཧི་ ༼པེ།༽ གི་ཧཾ་"
    },
    {
      "span": {
        "start": 10817,
        "end": 10820
      },
      "text": "རྟ་ ༼སྣར། པེ།༽ རྟཱ་"
    },
    {
      "span": {
        "start": 10840,
        "end": 10844
      },
      "text": "གུམ་ ༼སྣར།༽ ཀུམ་"
    },
    {
      "span": {
        "start": 10862,
        "end": 10870
      },
      "text": "ཉུངས་ཀར་ ༼སྣར། པེ།༽ ཡུངས་ཀར་"
    },
    {
      "span": {
        "start": 10876,
        "end": 10878
      },
      "text": "ཚ་ ༼སྣར། པེ།༽ ཆ་"
    },
    {
      "span": {
        "start": 10898,
        "end": 10904
      },
      "text": "བཞིའི་ ༼སྣར། པེ།༽ བཞིས་"
    },
    {
      "span": {
        "start": 10957,
        "end": 10962
      },
      "text": "རིམས་ ༼སྣར།༽ རིམ་"
    },
    {
      "span": {
        "start": 11031,
        "end": 11043
      },
      "text": "རྒྱུད་བཞི་པ་ ༼སྣར།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 11056,
        "end": 11064
      },
      "text": "ཉུངས་ཀར་ ༼སྣར། པེ།༽ ཡུངས་དཀར་"
    },
    {
      "span": {
        "start": 11202,
        "end": 11208
      },
      "text": "འཐུངས་ ༼པེ།༽ འཐུང་"
    },
    {
      "span": {
        "start": 11213,
        "end": 11222
      },
      "text": "བརྟེན་པས་ ༼སྣར།༽ ལྟེན་ ༼པེ།༽ སྟེན་པས་"
    },
    {
      "span": {
        "start": 11222,
        "end": 11232
      },
      "text": "སྦྲུལ་གྱི་ ༼སྣར། པེ།༽ སྦྲུལ་གྱིས་"
    },
    {
      "span": {
        "start": 11303,
        "end": 11310
      },
      "text": "རླག་པར་ ༼སྣར། པེ།༽ བརླག་པར་"
    },
    {
      "span": {
        "start": 11326,
        "end": 11335
      },
      "text": "ཀརྤ་པ་ཡི་ ༼སྣར། པེ།༽ ཀརྤ་སའི་"
    },
    {
      "span": {
        "start": 11367,
        "end": 11370
      },
      "text": "ཏི་ ༼སྣར། པེ།༽ ཧི་"
    },
    {
      "span": {
        "start": 11418,
        "end": 11425
      },
      "text": "རྟུག་པ་ ༼སྣར། པེ།༽ བརྟུག་པ་"
    },
    {
      "span": {
        "start": 11425,
        "end": 11427
      },
      "text": "བ་ ༼སྣར། པེ།༽ བཱ་"
    },
    {
      "span": {
        "start": 11429,
        "end": 11431
      },
      "text": "ཀ་ ༼སྣར། པེ།༽ ཀཱ་"
    },
    {
      "span": {
        "start": 11607,
        "end": 11620
      },
      "text": "གུར་གུམ་དྲོད་ ༼སྣར།༽ གུར་ཀུམ་དྲོ་ ༼པེ།༽ གུར་གུམ་དྲོ་"
    },
    {
      "span": {
        "start": 11650,
        "end": 11656
      },
      "text": "ཡུང་བ་ ༼སྣར།༽ ཡུང་"
    },
    {
      "span": {
        "start": 11687,
        "end": 11694
      },
      "text": "ཉུང་ཀར་ ༼སྣར། པེ།༽ ཉུང་"
    },
    {
      "span": {
        "start": 11726,
        "end": 11729
      },
      "text": "ཙེ་ ༼སྣར།༽ རྩེ་"
    },
    {
      "span": {
        "start": 11732,
        "end": 11740
      },
      "text": "ཧོང་ལེན་ ༼སྣར།༽ ཧོ་ལན་"
    },
    {
      "span": {
        "start": 11743,
        "end": 11746
      },
      "text": "དག་ ༼སྣར། པེ།༽ ཏག་"
    },
    {
      "span": {
        "start": 11932,
        "end": 11935
      },
      "text": "ཆུ་ ༼སྣར། པེ།༽ ཆ་"
    },
    {
      "span": {
        "start": 11937,
        "end": 11943
      },
      "text": "བསྐོལ་ ༼སྣར། པེ།༽ བསྐོལ་བ་"
    },
    {
      "span": {
        "start": 11975,
        "end": 11982
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 12075,
        "end": 12080
      },
      "text": "ཏྲིཀ་ ༼སྣར། པེ།༽ ཌ་ཀཱ་"
    },
    {
      "span": {
        "start": 12093,
        "end": 12100
      },
      "text": "དང་ཤིང་ ༼སྣར། པེ།༽ དང་ཤིན་"
    },
    {
      "span": {
        "start": 12104,
        "end": 12112
      },
      "text": "ཉུངས་ཀར་ ༼སྣར། པེ།༽ ཡུངས་ཀར་"
    },
    {
      "span": {
        "start": 12178,
        "end": 12181
      },
      "text": "དང་ ༼སྣར། པེ།༽ ཏི་"
    },
    {
      "span": {
        "start": 12321,
        "end": 12327
      },
      "text": "ཕྱེ་མ་ ༼སྣར། པེ།༽ ཕྱེ་བ་"
    },
    {
      "span": {
        "start": 12367,
        "end": 12371
      },
      "text": "གཞག་ ༼སྣར། པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 12375,
        "end": 12380
      },
      "text": "གྱིས་ ༼སྣར། པེ།༽ གྱི་"
    },
    {
      "span": {
        "start": 12584,
        "end": 12588
      },
      "text": "སིང་ ༼སྣར། པེ།༽ སི་"
    },
    {
      "span": {
        "start": 12752,
        "end": 12760
      },
      "text": "བྱུགས་པ་ ༼སྣར། པེ།༽ བྱུག་པ་"
    },
    {
      "span": {
        "start": 12840,
        "end": 12849
      },
      "text": "གློ་རིམས་ ༼སྣར། པེ།༽ གོ་རིམ་"
    },
    {
      "span": {
        "start": 13137,
        "end": 13143
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 13235,
        "end": 13239
      },
      "text": "གསལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 13364,
        "end": 13372
      },
      "text": "རྒྱགས་པ་ ༼སྣར། པེ།༽ རྒྱག་པ་"
    },
    {
      "span": {
        "start": 13400,
        "end": 13409
      },
      "text": "འཁྲིགས་པ་ ༼སྣར། པེ།༽ འཁྲིག་པ་"
    },
    {
      "span": {
        "start": 13438,
        "end": 13441
      },
      "text": "ཅུ་ ༼སྣར། པེ།༽ བཅུ་"
    },
    {
      "span": {
        "start": 13451,
        "end": 13456
      },
      "text": "དྲོད་ ༼སྣར།༽ དྲོ་"
    },
    {
      "span": {
        "start": 13522,
        "end": 13528
      },
      "text": "གཞུངས་ ༼སྣར། པེ།༽ བཞུངས་"
    },
    {
      "span": {
        "start": 13604,
        "end": 13607
      },
      "text": "བྱ། ༼སྣར། པེ།༽ བྱས་།"
    },
    {
      "span": {
        "start": 13614,
        "end": 13620
      },
      "text": "རྩིའི་ ༼སྣར། པེ།༽ རྩི་"
    },
    {
      "span": {
        "start": 13651,
        "end": 13657
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 13764,
        "end": 13772
      },
      "text": "ཇི་ལྟ་བ་ ༼སྣར།༽ ཇི་ལྟ་"
    },
    {
      "span": {
        "start": 13867,
        "end": 13873
      },
      "text": "དང་ནི་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 13878,
        "end": 13884
      },
      "text": "བརྒྱད། ༼སྣར། པེ།༽ བཅུ།"
    },
    {
      "span": {
        "start": 13921,
        "end": 13925
      },
      "text": "ཐུག་ ༼སྣར།༽ ཐུགས་"
    },
    {
      "span": {
        "start": 14061,
        "end": 14066
      },
      "text": "དྲོད་ ༼སྣར། པེ།༽ དྲོ་"
    },
    {
      "span": {
        "start": 14157,
        "end": 14161
      },
      "text": "ལའོ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 14192,
        "end": 14197
      },
      "text": "དྲོད་ ༼སྣར། པེ།༽ དྲོ་"
    },
    {
      "span": {
        "start": 14200,
        "end": 14205
      },
      "text": "ཁ་རུ་ ༼སྣར། པེ།༽ ཨ་རུ་"
    },
    {
      "span": {
        "start": 14210,
        "end": 14215
      },
      "text": "ཕྱེད་ ༼སྣར། པེ།༽ ཕྱེ་"
    },
    {
      "span": {
        "start": 14504,
        "end": 14512
      },
      "text": "མས་གཏོང་ ༼སྣར། པེ།༽ མ་བཏང་"
    },
    {
      "span": {
        "start": 14596,
        "end": 14602
      },
      "text": "སྐྱུར་ ༼སྣར། པེ།༽ སྐྱུ་"
    },
    {
      "span": {
        "start": 14736,
        "end": 14741
      },
      "text": "དྲོད་ ༼སྣར། པེ།༽ དྲོ་"
    },
    {
      "span": {
        "start": 14755,
        "end": 14762
      },
      "text": "མཇིང་པ་ ༼སྣར། པེ།༽ འཇིམ་པ་"
    },
    {
      "span": {
        "start": 14911,
        "end": 14920
      },
      "text": "སྐྱུགས་པ་ ༼སྣར། པེ།༽ སྐྱུག་པ་"
    },
    {
      "span": {
        "start": 14979,
        "end": 14989
      },
      "text": "སྐྱུ་རུའི་ ༼སྣར། པེ།༽ སྐྱུ་རུ་ར་ཡི་"
    },
    {
      "span": {
        "start": 15013,
        "end": 15018
      },
      "text": "ར་སྣ་ ༼སྣར། པེ།༽ རཱ་སྣཱ་"
    },
    {
      "span": {
        "start": 15057,
        "end": 15062
      },
      "text": "དྲོད་ ༼སྣར། པེ།༽ དྲོ་"
    },
    {
      "span": {
        "start": 15075,
        "end": 15078
      },
      "text": "དང་ ༼སྣར། པེ།༽ ཏཾ་"
    },
    {
      "span": {
        "start": 15159,
        "end": 15163
      },
      "text": "བསེ་ ༼སྣར། པེ།༽ བསྲེ་"
    },
    {
      "span": {
        "start": 15167,
        "end": 15173
      },
      "text": "ཧེ་མམ་ ༼སྣར། པེ།༽ ཧེ་མི་"
    },
    {
      "span": {
        "start": 15212,
        "end": 15218
      },
      "text": "དང་གས། ༼སྣར། པེ།༽ ཏཾ་ཀས།"
    },
    {
      "span": {
        "start": 15368,
        "end": 15372
      },
      "text": "བཅད་ ༼སྣར། པེ།༽ ནད་"
    },
    {
      "span": {
        "start": 15393,
        "end": 15397
      },
      "text": "ན་ག་ ༼སྣར། པེ།༽ ནཱ་ག་"
    },
    {
      "span": {
        "start": 15443,
        "end": 15452
      },
      "text": "གདོན་གྱི་ ༼སྣར། པེ།༽ གདོན་"
    },
    {
      "span": {
        "start": 15584,
        "end": 15594
      },
      "text": "རྟོགས་པའི་ ༼སྣར། པེ།༽ རྟོག་པའི་"
    },
    {
      "span": {
        "start": 15692,
        "end": 15696
      },
      "text": "ཆགས་ ༼སྣར། པེ།༽ ཆག་"
    },
    {
      "span": {
        "start": 15718,
        "end": 15725
      },
      "text": "བཞོན་པ་ ༼སྣར།༽ གཞོན་པ་"
    },
    {
      "span": {
        "start": 15736,
        "end": 15740
      },
      "text": "བསྐ་ ༼སྣར།༽ བསྐ་བ་"
    },
    {
      "span": {
        "start": 15759,
        "end": 15764
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 15782,
        "end": 15792
      },
      "text": "སྨྱུང་གནས་ ༼སྣར། པེ།༽ བསྙུང་གནས་"
    },
    {
      "span": {
        "start": 15835,
        "end": 15845
      },
      "text": "འཁྲུགས་པར་ ༼སྣར། པེ།༽ འཁྲུག་པར་"
    },
    {
      "span": {
        "start": 15912,
        "end": 15918
      },
      "text": "སྐམ་པ་ ༼སྣར། པེ།༽ སྐམ་པོ་"
    },
    {
      "span": {
        "start": 16036,
        "end": 16040
      },
      "text": "གྲང་ ༼སྣར། པེ།༽ གྲངས་"
    },
    {
      "span": {
        "start": 16234,
        "end": 16241
      },
      "text": "གདུག་པ་ ༼སྣར། པེ།༽ བདུག་པ་"
    },
    {
      "span": {
        "start": 16427,
        "end": 16437
      },
      "text": "རྨོངས་དྲང་ ༼སྣར། པེ།༽ རྨོང་གྲང་"
    },
    {
      "span": {
        "start": 16543,
        "end": 16547
      },
      "text": "རྣག་ ༼པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 16569,
        "end": 16577
      },
      "text": "བླ་འཆོལ་ ༼སྣར། པེ།༽ བསླབ་བཅོལ་"
    },
    {
      "span": {
        "start": 16730,
        "end": 16735
      },
      "text": "སྣབས་ ༼སྣར། པེ།༽ སྣམས་"
    },
    {
      "span": {
        "start": 16905,
        "end": 16912
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 17126,
        "end": 17132
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 17135,
        "end": 17138
      },
      "text": "ཚྭ་ ༼སྣར། པེ།༽ ཚ་"
    },
    {
      "span": {
        "start": 17182,
        "end": 17196
      },
      "text": "གཏོང་ཤ་དང་སྟན་ ༼སྣར། པེ།༽ བཏང་ཤེ་དང་"
    },
    {
      "span": {
        "start": 17406,
        "end": 17410
      },
      "text": "ཟེར་ ༼སྣར། པེ།༽ གཟེར་"
    },
    {
      "span": {
        "start": 17456,
        "end": 17460
      },
      "text": "རྩེ་ ༼སྣར། པེ།༽ བརྩེ་"
    },
    {
      "span": {
        "start": 17534,
        "end": 17539
      },
      "text": "དཔྱད་ ༼སྣར། པེ།༽ སྤྱད་"
    },
    {
      "span": {
        "start": 17660,
        "end": 17672
      },
      "text": "སྣབས་སྦྱོང་། ༼སྣར།༽ སྣབ་སྦྱར ༼པེ།༽ སྣབ་སྦྱང་།"
    },
    {
      "span": {
        "start": 17692,
        "end": 17695
      },
      "text": "ངལ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 17785,
        "end": 17790
      },
      "text": "དུགས་ ༼སྣར། པེ།༽ དུག་"
    },
    {
      "span": {
        "start": 17796,
        "end": 17801
      },
      "text": "གཏོང་ ༼སྣར། པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 17886,
        "end": 17892
      },
      "text": "སྨྱུང་ ༼སྣར། པེ།༽ བསྙུང་"
    },
    {
      "span": {
        "start": 18022,
        "end": 18027
      },
      "text": "དགུན་ ༼སྣར། པེ།༽ རྒུན་"
    },
    {
      "span": {
        "start": 18040,
        "end": 18045
      },
      "text": "དགུན་ ༼སྣར། པེ།༽ རྒུན་"
    },
    {
      "span": {
        "start": 18082,
        "end": 18084
      },
      "text": "ག་ ༼སྣར། པེ།༽ ཁ་"
    },
    {
      "span": {
        "start": 18125,
        "end": 18132
      },
      "text": "འཁྲུགས། ༼སྣར། པེ།༽ འཁྲུག།"
    },
    {
      "span": {
        "start": 18158,
        "end": 18164
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 18234,
        "end": 18239
      },
      "text": "བཀྲུ་ ༼སྣར།༽ བཀྲུས་"
    },
    {
      "span": {
        "start": 18243,
        "end": 18248
      },
      "text": "གཏང་། ༼སྣར། པེ།༽ བཏང་།"
    },
    {
      "span": {
        "start": 18336,
        "end": 18338
      },
      "text": "ལ་ ༼ཅོ།༽ དང་"
    },
    {
      "span": {
        "start": 18653,
        "end": 18669
      },
      "text": "གིས་ཡང་དག་རྟོགས་ ༼སྣར། པེ།༽ གིས་རྟགས་"
    },
    {
      "span": {
        "start": 18754,
        "end": 18758
      },
      "text": "གཏན་ ༼སྣར།༽ བཏན་"
    },
    {
      "span": {
        "start": 19313,
        "end": 19317
      },
      "text": "ཤེལ་ ༼སྣར། པེ།༽ ཤེར་"
    },
    {
      "span": {
        "start": 19400,
        "end": 19402
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 19661,
        "end": 19666
      },
      "text": "།། །། ༼སྣར། པེ།༽ པའོ།།"
    },
    {
      "span": {
        "start": 19702,
        "end": 19706
      },
      "text": "གནས། ༼སྣར། པེ།༽ གནད།"
    },
    {
      "span": {
        "start": 19756,
        "end": 19762
      },
      "text": "བརྒྱན་ ༼སྣར། པེ།༽ རྒྱན་"
    },
    {
      "span": {
        "start": 19769,
        "end": 19774
      },
      "text": "སྦྱར་ ༼ཅོ།༽ སྦྱོར་"
    },
    {
      "span": {
        "start": 19823,
        "end": 19828
      },
      "text": "ཤོག། ༼སྣར། པེ།༽ ཤོག། ས་སྟེང་དུ་ཉི་མ་དང་ཟླ་བ་ལྟར་གྱུར་ཅིག། །།ལོ་ཙཱ་བའི་འགྱུར་བསྟན་ལ་དཔེ་ཕྱི་བྱས་ནས་བྲིས་ཏེ། ཞུས་དག་ལེགས་པར་བགྱིས་པ་འདིས། སེམས་ཅན་དཔག་ཏུ་མེད་པའི་དོན་བྱེད་པར་གྱུར་ཅིག། །།"
    }
  ]
}