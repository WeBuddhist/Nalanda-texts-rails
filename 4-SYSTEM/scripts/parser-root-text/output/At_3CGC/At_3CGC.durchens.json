{
  "durchens": [
    {
      "span": {
        "start": 499,
        "end": 502
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 538,
        "end": 544
      },
      "text": "སྦྱང་། ༼སྣར། པེ།༽ སྦྱངས།"
    },
    {
      "span": {
        "start": 795,
        "end": 798
      },
      "text": "དེ་ ༼པེ།༽ ། །"
    },
    {
      "span": {
        "start": 990,
        "end": 994
      },
      "text": "དཀར་ ༼སྣར། པེ།༽ དམར་"
    },
    {
      "span": {
        "start": 1351,
        "end": 1388
      },
      "text": "། །དཀྱིལ་འཁོར་གྱི་ནི་ཕྱོགས་བཞིར་ནི། ། ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 1431,
        "end": 1440
      },
      "text": "སྔོན་པོར་ ༼སྣར། པེ།༽ སྔོན་མོར་"
    },
    {
      "span": {
        "start": 1783,
        "end": 1795
      },
      "text": "འདོད་ན་བཟླས་ ༼སྣར། པེ།༽ འདོད་"
    },
    {
      "span": {
        "start": 1909,
        "end": 1919
      },
      "text": "བཟླསནས་ནི། ༼སྡེ། ཅོ།༽ བཟླས།"
    },
    {
      "span": {
        "start": 2118,
        "end": 2120
      },
      "text": "ཨ་ ༼སྣར། པེ།༽ ཨཾ་"
    }
  ]
}