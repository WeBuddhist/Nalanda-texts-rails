{
  "durchens": [
    {
      "span": {
        "start": 38,
        "end": 45
      },
      "text": "སྟོ་ཏྲ་ ༼སྣར། པེ།༽ སྟ་པ་"
    },
    {
      "span": {
        "start": 404,
        "end": 410
      },
      "text": "བསྔགས་ ༼སྣར། པེ།༽ དངངས་"
    },
    {
      "span": {
        "start": 452,
        "end": 462
      },
      "text": "བསྲུང་མཛད་ ༼སྣར། པེ།༽ སྲུང་མཛད་"
    },
    {
      "span": {
        "start": 473,
        "end": 480
      },
      "text": "འཕྲོགས་ ༼སྣར། པེ།༽ འཕྲོག་"
    },
    {
      "span": {
        "start": 489,
        "end": 499
      },
      "text": "ན་བཟས་བཀབ་ ༼སྣར། པེ།༽ ན་བཟའ་དཀའ་"
    },
    {
      "span": {
        "start": 565,
        "end": 568
      },
      "text": "རོ་ ༼སྣར། པེ།༽ རོས་"
    },
    {
      "span": {
        "start": 670,
        "end": 682
      },
      "text": "ཕྲེང་བའི་བར་ ༼སྣར། པེ།༽ ཕྲེང་བ་འབར་"
    },
    {
      "span": {
        "start": 714,
        "end": 718
      },
      "text": "གསལ་ ༼སྣར། པེ།༽ གསིལ་"
    },
    {
      "span": {
        "start": 729,
        "end": 733
      },
      "text": "རྒྱ་ ༼སྣར། པེ།༽ ཟུང་"
    },
    {
      "span": {
        "start": 1146,
        "end": 1161
      },
      "text": "མཛད་པ་མི་མགོའི་ ༼སྣར། པེ།༽ མཛད་པ་མགོ་བོའི་"
    },
    {
      "span": {
        "start": 1530,
        "end": 1537
      },
      "text": "ཁྲོས་པ་ ༼སྣར། པེ།༽ ཁྲོས་པའི་"
    },
    {
      "span": {
        "start": 1570,
        "end": 1575
      },
      "text": "དམ་པ་ ༼སྣར། པེ།༽ དམ་པའི་"
    },
    {
      "span": {
        "start": 1989,
        "end": 1999
      },
      "text": "ཚོགས་ཀྱིས་ ༼པེ།༽ ཚོགས་ཀྱི་"
    },
    {
      "span": {
        "start": 2055,
        "end": 2059
      },
      "text": "སིད་ ༼སྣར། པེ།༽ སྲིད་"
    },
    {
      "span": {
        "start": 2232,
        "end": 2240
      },
      "text": "སྣ་ཚོགས་ ༼སྣར། པེ།༽ སྣ་ཚོགས་ཁྱབ་ཅིང་མཐའ་ཡས་"
    },
    {
      "span": {
        "start": 2757,
        "end": 2762
      },
      "text": "དངོས་ ༼སྣར། པེ།༽ དངོས་དང་དངོས་"
    },
    {
      "span": {
        "start": 3196,
        "end": 3202
      },
      "text": "ཤེས་པ་ ༼སྣར། པེ།༽ ཤེས་པར་"
    },
    {
      "span": {
        "start": 3277,
        "end": 3282
      },
      "text": "ཡོངས་ ༼པེ།༽ ཡོངས་སུ་"
    },
    {
      "span": {
        "start": 3482,
        "end": 3490
      },
      "text": "སྐུ་ཆེན་ ༼སྣར། པེ།༽ སྐུ་ཅན་"
    },
    {
      "span": {
        "start": 3693,
        "end": 3703
      },
      "text": "བསྲེགས་མེ་ ༼སྣར། པེ།༽ བསྲེགས་མ་"
    },
    {
      "span": {
        "start": 3787,
        "end": 3795
      },
      "text": "མཆོག་གི་ ༼སྣར། པེ།༽ མཆོག་གིས་"
    },
    {
      "span": {
        "start": 4431,
        "end": 4448
      },
      "text": "མངོན་པར་མཆོད་པའི་ ༼སྣར། པེ།༽ མངོན་མཆོད་"
    },
    {
      "span": {
        "start": 4968,
        "end": 4977
      },
      "text": "མཁན་པོ་མ་ ༼སྣར། པེ།༽ མཁན་པོ་མཱ་"
    }
  ]
}