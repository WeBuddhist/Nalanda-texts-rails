{
  "durchens": [
    {
      "span": {
        "start": 230,
        "end": 252
      },
      "text": "དག་པ་ལྟ་བུར་རྣམ་པར་དག་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 433,
        "end": 439
      },
      "text": "ལྟ་བུ་ ༼སྣར། པེ།༽ ལྟ་བུར་"
    },
    {
      "span": {
        "start": 704,
        "end": 715
      },
      "text": "ཐོགས་པ་དང་། ༼སྣར། པེ།༽ ཐོགས་པ།"
    },
    {
      "span": {
        "start": 734,
        "end": 742
      },
      "text": "བུམ་པའི་ ༼སྣར། པེ།༽ བུམ་"
    },
    {
      "span": {
        "start": 867,
        "end": 879
      },
      "text": "སེམས་དཔའ་དང་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 1108,
        "end": 1120
      },
      "text": "འདི་སྐད་ཅེས་ ༼སྣར། པེ།༽ འདི་སྐད་"
    },
    {
      "span": {
        "start": 1312,
        "end": 1318
      },
      "text": "གཟུང་། ༼སྣར། པེ།༽ བཟུང་།"
    },
    {
      "span": {
        "start": 1486,
        "end": 1501
      },
      "text": "རིམ་གྱིས་བསྒོམ། ༼སྣར།༽ རིམས་ཀྱིས་བསྒོམས ༼པེ།༽ རིམས་ཀྱིས་བསྒོམ།"
    },
    {
      "span": {
        "start": 1516,
        "end": 1526
      },
      "text": "ཛྙཱ་ན་བཛྲ་ ༼སྣར། པེ།༽ ཛྙཱ་ན་"
    },
    {
      "span": {
        "start": 1680,
        "end": 1695
      },
      "text": "དཀྱིལ་འཁོར་ཅིག་ ༼སྣར། པེ།༽ དཀྱིལ་འཁོར་ཞིག་"
    },
    {
      "span": {
        "start": 1745,
        "end": 1760
      },
      "text": "འོད་འཕྲོས་པ་ལས་ ༼སྣར། པེ།༽ འོད་འཕྲོས་པས་"
    },
    {
      "span": {
        "start": 1977,
        "end": 1986
      },
      "text": "ཤར་ཕྱོགས་ ༼སྣར། པེ།༽ ཤར་ཕྱོགས་སུ་"
    },
    {
      "span": {
        "start": 2157,
        "end": 2161
      },
      "text": "ཕུབ་ ༼སྣར། པེ།༽ ཕུག་"
    },
    {
      "span": {
        "start": 2309,
        "end": 2321
      },
      "text": "ཞིང་ཆེན་གྱི་ ༼སྣར། པེ།༽ ཞིང་ཆེན་གྱིས་"
    },
    {
      "span": {
        "start": 2383,
        "end": 2388
      },
      "text": "ཀ་ཞུ་ ༼སྣར། པེ།༽ ཀ་གཞུ་"
    },
    {
      "span": {
        "start": 2523,
        "end": 2530
      },
      "text": "རཾ་ཅིག་ ༼སྣར། པེ།༽ རཾ་གཅིག་"
    },
    {
      "span": {
        "start": 3147,
        "end": 3152
      },
      "text": "ལྡིར་ ༼སྣར། པེ།༽ འདིར་"
    },
    {
      "span": {
        "start": 3161,
        "end": 3173
      },
      "text": "སྐམ་པོ་ལྔའི་ ༼སྣར།༽ སྐམ་པོའི་"
    },
    {
      "span": {
        "start": 3496,
        "end": 3505
      },
      "text": "གཉིས་པ་ན་ ༼སྣར། པེ།༽ གཉིས་པ་"
    },
    {
      "span": {
        "start": 3818,
        "end": 3827
      },
      "text": "དྲུག་གིས་ ༼སྣར། པེ།༽ དྲུག་གི་"
    },
    {
      "span": {
        "start": 3870,
        "end": 3876
      },
      "text": "ནས་བྱ་ ༼སྣར། པེ།༽ ནས་ཀྱང་"
    },
    {
      "span": {
        "start": 3943,
        "end": 3959
      },
      "text": "ཡེ་ཤེས་ཀྱི་མེའི་ ༼སྣར། པེ།༽ ཡེ་ཤེས་ཀྱི་"
    },
    {
      "span": {
        "start": 3964,
        "end": 3972
      },
      "text": "དཀྱིལ་ན་ ༼སྣར། པེ།༽ དཀྱིལ་ནས་"
    },
    {
      "span": {
        "start": 4078,
        "end": 4080
      },
      "text": "ན་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 4309,
        "end": 4316
      },
      "text": "གཡས་པར་ ༼སྣར། པེ།༽ གཡས་པའི་"
    },
    {
      "span": {
        "start": 4587,
        "end": 4598
      },
      "text": "ཁ་དོག་ལྔ་པ་ ༼སྣར། པེ།༽ ཁ་དོག་"
    },
    {
      "span": {
        "start": 4673,
        "end": 4682
      },
      "text": "འཁྲུགས་པ་ ༼སྣར། པེ།༽ འཁྲུག་པ་"
    },
    {
      "span": {
        "start": 4835,
        "end": 4839
      },
      "text": "ཆུས་ ༼སྣར། པེ།༽ ཆུ་"
    },
    {
      "span": {
        "start": 4844,
        "end": 4847
      },
      "text": "བོ་ ༼པེ།༽ བོས་"
    },
    {
      "span": {
        "start": 4883,
        "end": 4893
      },
      "text": "འཁྲུགས་པས་ ༼སྣར།༽ འཁྲུག་པས་"
    },
    {
      "span": {
        "start": 5182,
        "end": 5188
      },
      "text": "དེ་ནས་ ༼སྣར། པེ།༽ ཡེ་ནས་"
    },
    {
      "span": {
        "start": 5188,
        "end": 5201
      },
      "text": "གྲུབ་པའི་དཔལ་ ༼སྣར། པེ།༽ གྲུབ་པའི་"
    },
    {
      "span": {
        "start": 5352,
        "end": 5357
      },
      "text": "ཆང་བ་ ༼སྣར།༽ འཆང་བ་"
    },
    {
      "span": {
        "start": 5426,
        "end": 5433
      },
      "text": "དྲངས་ལ། ༼སྣར། པེ།༽ དྲངས།"
    },
    {
      "span": {
        "start": 5473,
        "end": 5477
      },
      "text": "ཕོག་ ༼སྣར། པེ།༽ ཕྲོག་"
    },
    {
      "span": {
        "start": 5511,
        "end": 5517
      },
      "text": "བཅིངས། ༼སྣར། པེ།༽ བཅིང་།"
    },
    {
      "span": {
        "start": 5680,
        "end": 5692
      },
      "text": "ཧུ་ཧུ་ཧུ་ལུ་ ༼སྣར། པེ།༽ ཧུ་ཧུ་"
    },
    {
      "span": {
        "start": 5739,
        "end": 5742
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 6218,
        "end": 6222
      },
      "text": "སྟག་ ༼སྣར། པེ།༽ རྟག་"
    },
    {
      "span": {
        "start": 6257,
        "end": 6270
      },
      "text": "ཙེར་ཙེར་མཚེར། ༼སྣར། པེ།༽ ཚེར་ཚེར་འཚེར།"
    },
    {
      "span": {
        "start": 6797,
        "end": 6804
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 6965,
        "end": 6980
      },
      "text": "མཆོད་པ་བྱ། བདག་ ༼པེ།༽ མཆོད་པ་བབདག་"
    },
    {
      "span": {
        "start": 7243,
        "end": 7246
      },
      "text": "གི་ ༼སྣར། པེ།༽ གི་དང་"
    },
    {
      "span": {
        "start": 7295,
        "end": 7303
      },
      "text": "གདུལ་བར་ ༼སྣར། པེ།༽ འདུལ་བར་"
    },
    {
      "span": {
        "start": 7345,
        "end": 7348
      },
      "text": "ཆུ་ ༼སྣར། པེ།༽ ཆུས་"
    },
    {
      "span": {
        "start": 7392,
        "end": 7404
      },
      "text": "སེང་ལྡེང་གི་ ༼སྣར། པེ།༽ སེང་ལྡེང་"
    },
    {
      "span": {
        "start": 7516,
        "end": 7525
      },
      "text": "བཟློག་པར་ ༼སྣར། པེ།༽ ཟློག་པར་"
    },
    {
      "span": {
        "start": 7614,
        "end": 7626
      },
      "text": "བརྒྱད་པ་ཅིག་ ༼སྣར། པེ།༽ བརྒྱད་པ་གཅིག་"
    },
    {
      "span": {
        "start": 7665,
        "end": 7671
      },
      "text": "བཟློག་ ༼སྣར། པེ།༽ ཟློགས་"
    },
    {
      "span": {
        "start": 7790,
        "end": 7799
      },
      "text": "དཀྱིལ་དང་ ༼སྣར། པེ།༽ བརྒྱད་ཀྱི་དཀྱིལ་དུ་"
    },
    {
      "span": {
        "start": 7815,
        "end": 7820
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ ཟློགས་"
    },
    {
      "span": {
        "start": 7886,
        "end": 7891
      },
      "text": "རྒོད་ ༼སྣར། པེ།༽ སྒོད་"
    },
    {
      "span": {
        "start": 7910,
        "end": 7916
      },
      "text": "བཟློག་ ༼སྣར། པེ།༽ བཟློགས་"
    },
    {
      "span": {
        "start": 7948,
        "end": 7955
      },
      "text": "ལྷོག་པ་ ༼སྣར། པེ།༽ ལྷོག་ལྷོག་པ་དང་"
    },
    {
      "span": {
        "start": 8301,
        "end": 8308
      },
      "text": "ལས་འོད་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 8492,
        "end": 8503
      },
      "text": "དམར་པོ་ཅིག་ ༼སྣར། པེ།༽ དམར་པོ་གཅིག་"
    },
    {
      "span": {
        "start": 8660,
        "end": 8669
      },
      "text": "དེའི་འོད་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 8705,
        "end": 8710
      },
      "text": "བསྔོ། ༼སྡེ། ཅོ།༽ སྔོ།"
    },
    {
      "span": {
        "start": 8871,
        "end": 8880
      },
      "text": "བརླབ་པའི་ ༼སྣར། པེ།༽ བརླབས་པའི་"
    },
    {
      "span": {
        "start": 8977,
        "end": 8982
      },
      "text": "ཡང་ན་ ༼སྣར། པེ།༽ ཡང་དག་"
    },
    {
      "span": {
        "start": 8999,
        "end": 9007
      },
      "text": "བརྗོད་ལ་ ༼སྣར། པེ།༽ བརྗོད་"
    }
  ]
}