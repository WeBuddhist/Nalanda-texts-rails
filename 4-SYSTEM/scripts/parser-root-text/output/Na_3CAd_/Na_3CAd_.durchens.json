{
  "durchens": [
    {
      "span": {
        "start": 550,
        "end": 556
      },
      "text": "ནགས་ན་ ༼པེ།༽ ནགས་"
    },
    {
      "span": {
        "start": 883,
        "end": 889
      },
      "text": "བརྒྱན་ ༼སྣར།༽ རྒྱན་"
    },
    {
      "span": {
        "start": 1601,
        "end": 1607
      },
      "text": "ལྷུངས་ ༼པེ།༽ ལྷུང་"
    },
    {
      "span": {
        "start": 2641,
        "end": 2646
      },
      "text": "བཀུར་ ༼པེ།༽ བསྐུར་"
    },
    {
      "span": {
        "start": 2730,
        "end": 2743
      },
      "text": "རྒྱལ་བུ་མོའི་ ༼པེ།༽ རྒྱལ་བུ་མོ་"
    },
    {
      "span": {
        "start": 3162,
        "end": 3167
      },
      "text": "།། །། ༼པེ།༽ །། །།སརྦ་མངྒ་ལཾ།། །།"
    }
  ]
}