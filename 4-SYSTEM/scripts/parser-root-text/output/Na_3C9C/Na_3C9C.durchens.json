{
  "durchens": [
    {
      "span": {
        "start": 232,
        "end": 237
      },
      "text": "བགྱི། ༼པེ།༽ བགྱིད།"
    },
    {
      "span": {
        "start": 1267,
        "end": 1277
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 1914,
        "end": 1919
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 1967,
        "end": 1972
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 2172,
        "end": 2178
      },
      "text": "ཇི་ལྟ་ ༼སྣར།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 2273,
        "end": 2281
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    }
  ]
}