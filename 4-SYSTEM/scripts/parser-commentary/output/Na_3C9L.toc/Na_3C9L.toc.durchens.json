{
  "durchens": [
    {
      "span": {
        "start": 40,
        "end": 43
      },
      "text": "ཀ ། ༼སྣར། པེ།༽ ཀཱ། །"
    },
    {
      "span": {
        "start": 620,
        "end": 628
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 716,
        "end": 723
      },
      "text": "འདུ་བར་ ༼སྣར། པེ།༽ འདུ་བ་"
    },
    {
      "span": {
        "start": 887,
        "end": 892
      },
      "text": "རྗེས་ ༼སྣར། པེ།༽ རྗེ་"
    },
    {
      "span": {
        "start": 929,
        "end": 937
      },
      "text": "གཞོམ་དུ་ ༼སྣར། པེ།༽ གཞོམ་པ་"
    },
    {
      "span": {
        "start": 985,
        "end": 994
      },
      "text": "བརྡུང་བར་ ༼སྣར། པེ།༽ བརྡུང་བས་"
    },
    {
      "span": {
        "start": 1097,
        "end": 1099
      },
      "text": "ར་ ༼སྣར། པེ།༽ རཾ་"
    },
    {
      "span": {
        "start": 1293,
        "end": 1295
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལཱ་"
    },
    {
      "span": {
        "start": 1480,
        "end": 1513
      },
      "text": "། སྤྲུལ་པ་གཅིག་པུ་ནི་རྟག་པ་ཡིན་ལ། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 1663,
        "end": 1670
      },
      "text": "འཐུང་ལ་ ༼སྣར། པེ།༽ འཐུང་བ་"
    },
    {
      "span": {
        "start": 1751,
        "end": 1753
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལཱ་"
    },
    {
      "span": {
        "start": 1811,
        "end": 1814
      },
      "text": "པི་ ༼སྣར། པེ།༽ པཱི་"
    },
    {
      "span": {
        "start": 2063,
        "end": 2065
      },
      "text": "ར་ ༼སྣར། པེ།༽ པཱུ་"
    },
    {
      "span": {
        "start": 2112,
        "end": 2116
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 2306,
        "end": 2314
      },
      "text": "ཕྱི་རོལ་ ༼སྣར། པེ།༽ ཕྱི་རོལ་ཏུ་"
    },
    {
      "span": {
        "start": 2463,
        "end": 2468
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟས་"
    },
    {
      "span": {
        "start": 3120,
        "end": 3127
      },
      "text": "གཅི་བས་ ༼སྣར། པེ།༽ གཅི་བ་"
    },
    {
      "span": {
        "start": 3189,
        "end": 3193
      },
      "text": "གཉི་ ༼ཅོ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 3507,
        "end": 3513
      },
      "text": "ཤུ་ཀྲ་ ༼སྣར། པེ།༽ ཤྲ་བ་སྲ་"
    },
    {
      "span": {
        "start": 3701,
        "end": 3704
      },
      "text": "ཏྲ་ ༼སྣར། པེ།༽ ཊ་"
    },
    {
      "span": {
        "start": 3768,
        "end": 3774
      },
      "text": "རྟོགས་ ༼སྣར། པེ།༽ རྟོག་"
    },
    {
      "span": {
        "start": 4269,
        "end": 4271
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལཱ་"
    },
    {
      "span": {
        "start": 4316,
        "end": 4318
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལཱ་"
    },
    {
      "span": {
        "start": 4461,
        "end": 4469
      },
      "text": "བྱ་བ་ནི་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 5465,
        "end": 5477
      },
      "text": "དམིགས་པ་སྟེ། ༼སྣར། པེ།༽ དམིགས་པ་པའོ།"
    },
    {
      "span": {
        "start": 5789,
        "end": 5800
      },
      "text": "མགྲིན་པ་ནས་ ༼སྣར། པེ།༽ མགྲིན་པ་ལས་"
    },
    {
      "span": {
        "start": 6976,
        "end": 6982
      },
      "text": "བསྡུས་ ༼སྣར། པེ།༽ སྡུད་"
    },
    {
      "span": {
        "start": 7605,
        "end": 7612
      },
      "text": "ངེས་པར་ ༼སྣར། པེ།༽ ངེས་"
    },
    {
      "span": {
        "start": 8559,
        "end": 8567
      },
      "text": "བྱ་བ་ནི་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 9395,
        "end": 9406
      },
      "text": "ནི་སྦྱོར་བ་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 9721,
        "end": 9726
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 9835,
        "end": 9842
      },
      "text": "ཡེ་ཤེས་ ༼སྣར། པེ།༽ ཡི་གེ་"
    },
    {
      "span": {
        "start": 10142,
        "end": 10149
      },
      "text": "ཐོབ་བོ་ ༼སྣར། པེ།༽ འཐོབ་བོ་"
    },
    {
      "span": {
        "start": 10290,
        "end": 10293
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ནི་སྣ་"
    },
    {
      "span": {
        "start": 10967,
        "end": 10974
      },
      "text": "ཀྲི་པི་ ༼སྣར། པེ།༽ ཀི་པཱི་"
    },
    {
      "span": {
        "start": 11687,
        "end": 11689
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལཱ་"
    },
    {
      "span": {
        "start": 12058,
        "end": 12064
      },
      "text": "འཚོགས་ ༼སྣར། པེ།༽ འཚོག་"
    },
    {
      "span": {
        "start": 12632,
        "end": 12638
      },
      "text": "འབྱུང་ ༼པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 13949,
        "end": 13955
      },
      "text": "བའོ། ། ༼པེ།༽ ། །མངྒལཾ། །"
    }
  ]
}