{
  "durchens": [
    {
      "span": {
        "start": 217,
        "end": 221
      },
      "text": "སྙན་ ༼སྣར། པེ།༽ བསྙད་"
    },
    {
      "span": {
        "start": 231,
        "end": 239
      },
      "text": "གསུང་གི་ ༼སྣར། པེ།༽ གསུང་གིས་"
    },
    {
      "span": {
        "start": 388,
        "end": 410
      },
      "text": "སངས་རྒྱས་ཀྱིས་གསུང་གི་ ༼སྣར། པེ།༽ སངས་རྒྱས་གསུངས་ཀྱི་"
    },
    {
      "span": {
        "start": 794,
        "end": 802
      },
      "text": "རང་བཞིན་ ༼སྣར། པེ།༽ རང་བཞིན་གྱིས་"
    },
    {
      "span": {
        "start": 823,
        "end": 830
      },
      "text": "ཅི་ལྟར་ ༼སྣར། པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 1064,
        "end": 1067
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 1123,
        "end": 1130
      },
      "text": "རྒྱུའི་ ༼སྣར། པེ།༽ རྒྱུའམ་"
    },
    {
      "span": {
        "start": 1387,
        "end": 1391
      },
      "text": "འགག་ ༼སྣར། པེ།༽ འགོག་"
    },
    {
      "span": {
        "start": 1667,
        "end": 1678
      },
      "text": "ཡོད་པ་ཡང་མ་ ༼སྣར། པེ།༽ ཡོད་པ་ཡང་"
    },
    {
      "span": {
        "start": 1682,
        "end": 1693
      },
      "text": "མེད་པ་ཡང་མ་ ༼སྣར། པེ།༽ མེད་པ་ཡང་"
    },
    {
      "span": {
        "start": 2025,
        "end": 2030
      },
      "text": "སྐྱེ་ ༼སྣར། པེ།༽ སྐྱེས་"
    },
    {
      "span": {
        "start": 2381,
        "end": 2390
      },
      "text": "སྐྱེ་བའི་ ༼སྣར།༽ སྐྱོ་བའི་"
    },
    {
      "span": {
        "start": 2443,
        "end": 2451
      },
      "text": "སྐྱེད་པ་ ༼སྣར། པེ།༽ སྐྱེས་པ་"
    },
    {
      "span": {
        "start": 2568,
        "end": 2576
      },
      "text": "སྐྱེས་པ་ ༼སྣར།༽ སྐྱེས་"
    },
    {
      "span": {
        "start": 2869,
        "end": 2874
      },
      "text": "ཕྱིར་ ༼སྣར། པེ།༽ ཕྱིར་སྐྱེ་བའི་ཚེ་"
    },
    {
      "span": {
        "start": 3074,
        "end": 3077
      },
      "text": "སུ་ ༼སྣར། པེ།༽ སུའང་"
    },
    {
      "span": {
        "start": 3343,
        "end": 3349
      },
      "text": "ཇི་ལྟ་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 3379,
        "end": 3385
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 3413,
        "end": 3426
      },
      "text": "ཕྱི་མར་བརྟགས་ ༼སྣར། པེ།༽ འཕྱི་བར་བརྟག་"
    },
    {
      "span": {
        "start": 3495,
        "end": 3501
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 3567,
        "end": 3575
      },
      "text": "འབྲས་བུ་ ༼སྣར། པེ།༽ འབྲས་བུ་ནི་"
    },
    {
      "span": {
        "start": 3599,
        "end": 3602
      },
      "text": "ཅར་ ༼སྣར། པེ།༽ ཆར་"
    },
    {
      "span": {
        "start": 3783,
        "end": 3790
      },
      "text": "འཐད་པས་ ༼སྣར།༽ འཐད་པའི་"
    },
    {
      "span": {
        "start": 3930,
        "end": 3938
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ བྱུང་བ་"
    },
    {
      "span": {
        "start": 4042,
        "end": 4050
      },
      "text": "རྣམས་ནི་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 4530,
        "end": 4536
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 4958,
        "end": 4964
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བཏགས་"
    },
    {
      "span": {
        "start": 4975,
        "end": 4978
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 4995,
        "end": 5002
      },
      "text": "ལོག་པར་ ༼སྣར།༽ ལོག་ཡིན་པས་ ༼པེ།༽ ལོག་ཡིན་པར་"
    },
    {
      "span": {
        "start": 5307,
        "end": 5313
      },
      "text": "སྦྱོར་ ༼སྣར། པེ།༽ སྦྱར་"
    },
    {
      "span": {
        "start": 5380,
        "end": 5384
      },
      "text": "བཞི་ ༼སྣར། པེ།༽ གཞི་"
    },
    {
      "span": {
        "start": 5610,
        "end": 5618
      },
      "text": "མེད་མིན་ ༼སྣར། པེ།༽ མེད་མི་"
    },
    {
      "span": {
        "start": 5817,
        "end": 5825
      },
      "text": "སྐྱེད་པ་ ༼སྣར། པེ།༽ བསྐྱེད་བྱེད་"
    },
    {
      "span": {
        "start": 6302,
        "end": 6307
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ གཉིས་ནི་"
    },
    {
      "span": {
        "start": 6314,
        "end": 6329
      },
      "text": "མེད་པ་ཡང་མ་ཡིན་ ༼སྣར། པེ།༽ མེད་པར་ཡང་མེད་"
    },
    {
      "span": {
        "start": 6534,
        "end": 6542
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ བྱུང་བ་"
    },
    {
      "span": {
        "start": 6696,
        "end": 6703
      },
      "text": "བྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 6883,
        "end": 6890
      },
      "text": "གྲུབ་པ་ ༼པེ།༽ གྲུབ་པའང་"
    },
    {
      "span": {
        "start": 7000,
        "end": 7009
      },
      "text": "དངོས་མིན་ ༼སྣར། པེ།༽ དངོས་མི་"
    },
    {
      "span": {
        "start": 7439,
        "end": 7449
      },
      "text": "མེད་པར་ཡང་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 7530,
        "end": 7534
      },
      "text": "དང་། ༼སྣར། པེ།༽ དང་དངོས་པོ་དང་།"
    },
    {
      "span": {
        "start": 7564,
        "end": 7573
      },
      "text": "འདི་རྟེན་ ༼སྣར། པེ།༽ དང་བརྟེན་"
    },
    {
      "span": {
        "start": 7676,
        "end": 7684
      },
      "text": "འཇིག་པར་ ༼སྣར། པེ།༽ འཇོག་པར་"
    },
    {
      "span": {
        "start": 7911,
        "end": 7934
      },
      "text": "ཕྱིར་རང་གི་དངོས་པོ་དང་། ༼སྣར། པེ།༽ ཕྱིར།"
    },
    {
      "span": {
        "start": 7976,
        "end": 7987
      },
      "text": "དངོས་པོ་དང་ ༼སྣར། པེ།༽ དངོས་པོ་"
    },
    {
      "span": {
        "start": 8096,
        "end": 8105
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 8155,
        "end": 8168
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་"
    },
    {
      "span": {
        "start": 8286,
        "end": 8291
      },
      "text": "ན་ནི། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 8372,
        "end": 8382
      },
      "text": "ཐམས་ཅད་ནི་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 8626,
        "end": 8629
      },
      "text": "དག་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 8788,
        "end": 8802
      },
      "text": "། །གང་གི་ཕྱིར་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 8828,
        "end": 8835
      },
      "text": "འཐད་དོ། ༼སྣར། པེ།༽ འཐད་དེ།"
    },
    {
      "span": {
        "start": 8997,
        "end": 9018
      },
      "text": "དངོས་པོ་མི་རྟག་པ་ཉིད་ ༼སྣར། པེ།༽ མི་རྟག་པ་"
    },
    {
      "span": {
        "start": 9106,
        "end": 9115
      },
      "text": "འཇིག་པའི་ ༼སྣར། པེ།༽ འཇིག་པའི་ཚེ་"
    },
    {
      "span": {
        "start": 9263,
        "end": 9269
      },
      "text": "མེད་ན་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 9372,
        "end": 9380
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ དངོས་པོ་དང་དངོས་པོ་"
    },
    {
      "span": {
        "start": 9832,
        "end": 9841
      },
      "text": "མེད་དོ། ། ༼སྣར། པེ།༽ མེད་དེ། དངོས་པོ་"
    },
    {
      "span": {
        "start": 9977,
        "end": 9980
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 10036,
        "end": 10040
      },
      "text": "ཡོད་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 10040,
        "end": 10042
      },
      "text": "ན་ ༼སྣར། པེ།༽ ན་ནི་"
    },
    {
      "span": {
        "start": 10061,
        "end": 10064
      },
      "text": "རོ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 10141,
        "end": 10150
      },
      "text": "འགྱུར་བས་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 10310,
        "end": 10314
      },
      "text": "གཉི་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 10393,
        "end": 10399
      },
      "text": "འདི་མ་ ༼སྣར། པེ།༽ འདི་མི་"
    },
    {
      "span": {
        "start": 11520,
        "end": 11529
      },
      "text": "མེད་པ་ཡང་ ༼སྣར། པེ།༽ མེད་པ་དང་"
    },
    {
      "span": {
        "start": 11581,
        "end": 11592
      },
      "text": "འགོག་ཆ་དང་། ༼སྣར། པེ།༽ འགོག་ཆད།"
    },
    {
      "span": {
        "start": 11612,
        "end": 11621
      },
      "text": "བརྟག་པ། ། ༼སྣར། པེ།༽ ན་རྟག །"
    },
    {
      "span": {
        "start": 11879,
        "end": 11888
      },
      "text": "དེ་ལྟ་བུ་ ༼སྣར།༽ དེ་ལྟ་བུ་ནི་"
    },
    {
      "span": {
        "start": 12298,
        "end": 12308
      },
      "text": "ཇི་སྐད་དུ་ ༼སྣར། པེ།༽ ཇི་སྐད་"
    },
    {
      "span": {
        "start": 12318,
        "end": 12323
      },
      "text": "ཞེ་ན། ༼སྣར། པེ།༽ ཞེ་ན་དངོས་པོ་མེད་པར་ཡང་དངོས་པོ་མེད་པ་མེད་པར་ཡང་། དངོས་པོ་ལ་མ་བརྟེན་པར་ཡང་། དངོས་པོ་མེད་པ་ལ་མ་བརྟེན་པར་ཡང་ཞེས་བཤད་པ་ཡིན་ནོ། །འདིར་སྨྲས་པ། མཚན་གཞི་དང་མཚན་ཉིད་འབྲེལ་པའི་ཕྱིར་དངོས་པོ་རྣམས་ནི་ཡོད་དོ། །འདིར་བཤད་པ།"
    },
    {
      "span": {
        "start": 12506,
        "end": 12512
      },
      "text": "རང་གི་ ༼སྣར། པེ།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 12560,
        "end": 12570
      },
      "text": "ཕན་ཚུན་དུ་ ༼སྣར། པེ།༽ ཕན་ཚུན་"
    },
    {
      "span": {
        "start": 12727,
        "end": 12736
      },
      "text": "བྱེད་པ་མ་ ༼པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 12809,
        "end": 12813
      },
      "text": "བལྟ་ ༼སྣར། པེ།༽ ལྟ་"
    },
    {
      "span": {
        "start": 12821,
        "end": 12826
      },
      "text": "ཅིའང་ ༼སྣར། པེ།༽ ཅི་ཡང་"
    },
    {
      "span": {
        "start": 12888,
        "end": 12895
      },
      "text": "གསུམ་པ་ ༼སྣར། པེ།༽ རྣམ་པ་"
    },
    {
      "span": {
        "start": 12906,
        "end": 12909
      },
      "text": "ཏེ། ༼སྣར། པེ།༽ སྟེ་"
    },
    {
      "span": {
        "start": 13130,
        "end": 13142
      },
      "text": "གནས་པ་ཡིན་པ་ ༼སྣར། པེ།༽ གནས་པ་"
    },
    {
      "span": {
        "start": 13177,
        "end": 13185
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 13306,
        "end": 13313
      },
      "text": "བརྟག་པ་ ༼སྣར། པེ།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 13504,
        "end": 13511
      },
      "text": "བརྟག་པ་ ༼སྣར། པེ།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 13705,
        "end": 13714
      },
      "text": "གྲུབ་པའོ། ༼སྣར། པེ།༽ གྲུབ་པོ།"
    },
    {
      "span": {
        "start": 13796,
        "end": 13803
      },
      "text": "གྲུབ་པ་ ༼སྣར། པེ།༽ གྲུབ་"
    },
    {
      "span": {
        "start": 13925,
        "end": 13932
      },
      "text": "བཙལ་ནས་ ༼སྣར། པེ།༽ བཙལ་ན་"
    },
    {
      "span": {
        "start": 13938,
        "end": 13952
      },
      "text": "ངོ་བོར་གྲུབ་པ་ ༼སྣར། པེ།༽ ངོ་བོར་"
    },
    {
      "span": {
        "start": 14514,
        "end": 14520
      },
      "text": "བྱས་པ་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 14572,
        "end": 14580
      },
      "text": "ཟིན་ཀྱང་ ༼སྣར། པེ།༽ ཟིན་ཡང་"
    },
    {
      "span": {
        "start": 15002,
        "end": 15011
      },
      "text": "གནས་པའང་། ༼སྣར། པེ།༽ གནས་པའམ།"
    },
    {
      "span": {
        "start": 15236,
        "end": 15243
      },
      "text": "གཉིས་ཀ་ ༼སྣར། པེ།༽ གཉི་ག་"
    },
    {
      "span": {
        "start": 15335,
        "end": 15340
      },
      "text": "དེའི་ ༼སྣར། པེ།༽ དེའི་ཕྱིར་"
    },
    {
      "span": {
        "start": 15665,
        "end": 15672
      },
      "text": "ངེས་པར་ ༼སྣར། པེ།༽ ངེས་པ་"
    },
    {
      "span": {
        "start": 15711,
        "end": 15728
      },
      "text": "ཐམས་ཅད་འདུ་བ་ཞེས་ ༼སྣར། པེ།༽ ཐམས་ཅད་འུབ་ཅེས་"
    },
    {
      "span": {
        "start": 15789,
        "end": 15799
      },
      "text": "བསྡུས་ཟིན་ ༼སྣར། པེ།༽ བསྡུས་"
    },
    {
      "span": {
        "start": 16114,
        "end": 16119
      },
      "text": "བྱ་བ་ ༼པེ།༽ བྱ་བ་མ་"
    },
    {
      "span": {
        "start": 16136,
        "end": 16142
      },
      "text": "གསུངས། ༼སྣར། པེ།༽ གསུངས་ཏེ།"
    },
    {
      "span": {
        "start": 16364,
        "end": 16369
      },
      "text": "དེ་མ་ ༼སྣར། པེ།༽ མ་"
    },
    {
      "span": {
        "start": 16463,
        "end": 16469
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 16559,
        "end": 16563
      },
      "text": "རྟག་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 16563,
        "end": 16572
      },
      "text": "པར་འགྱུར། ༼སྣར། པེ།༽ པར་འགྱུར་སྡུག་བསྔལ་རྣམ་སྨིན་ཅན་མི་འགྱུར། །དེ་ཕྱིར་ལས་ཀྱང་བདག་ཏུ་འགྱུར།"
    },
    {
      "span": {
        "start": 16659,
        "end": 16665
      },
      "text": "དག་པར་ ༼སྣར།༽ རྟག་པར་ ༼པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 16696,
        "end": 16705
      },
      "text": "འགྱུར་རོ་ ༼སྣར། པེ།༽ འགྱུར་ཏེ་"
    },
    {
      "span": {
        "start": 16772,
        "end": 16786
      },
      "text": "སྡུག་བསྔལ་གྱི་ ༼སྣར། པེ།༽ སྡུག་བསྔལ་"
    },
    {
      "span": {
        "start": 16912,
        "end": 16923
      },
      "text": "གང་གི་ཕྱིར་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 17137,
        "end": 17140
      },
      "text": "ཏེ། ༼སྣར། པེ།༽ ཏེ་ཅིའི་ཕྱིར་ཞེ་ན། འདུ་བྱེད་རྣམས་ནི་སྒྱུ་མ་དང་། དྲི་ཟའི་གྲོང་ཁྱེར་སྨིག་རྒྱུ་འདྲ།"
    },
    {
      "span": {
        "start": 17628,
        "end": 17637
      },
      "text": "ཉོན་མོངས་ ༼སྣར། པེ།༽ ཉོན་མོངས་པའི་"
    },
    {
      "span": {
        "start": 17674,
        "end": 17678
      },
      "text": "ལུས་ ༼སྣར། པེ།༽ ལུས་ལས་"
    },
    {
      "span": {
        "start": 17715,
        "end": 17718
      },
      "text": "ཅར་ ༼སྣར། པེ།༽ ཆར་"
    },
    {
      "span": {
        "start": 17721,
        "end": 17734
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 17894,
        "end": 17907
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་"
    },
    {
      "span": {
        "start": 18150,
        "end": 18156
      },
      "text": "ལས་ལས་ ༼སྣར། པེ།༽ ལ་ལས་"
    },
    {
      "span": {
        "start": 18217,
        "end": 18224
      },
      "text": "སྟོང་པ་ ༼སྣར། པེ།༽ སྟོང་པར་"
    },
    {
      "span": {
        "start": 18245,
        "end": 18251
      },
      "text": "ལས་ནི་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 18407,
        "end": 18413
      },
      "text": "ཇི་ལྟ་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 18762,
        "end": 18770
      },
      "text": "གང་ཅིའང་ ༼སྣར། པེ།༽ གང་ཅི་ཡང་"
    },
    {
      "span": {
        "start": 19009,
        "end": 19021
      },
      "text": "སྤྲུལ་པ་གཞན་ ༼སྣར། པེ།༽ སྤྲུལ་པ་"
    },
    {
      "span": {
        "start": 19042,
        "end": 19045
      },
      "text": "ཇི་ ༼སྣར། པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 19074,
        "end": 19082
      },
      "text": "གཉི་ག་ལ་ ༼སྣར། པེ།༽ གཉི་ག་"
    },
    {
      "span": {
        "start": 19194,
        "end": 19200
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 19275,
        "end": 19282
      },
      "text": "གྲུབ་པ་ ༼སྣར། པེ།༽ གྲུབ་"
    },
    {
      "span": {
        "start": 19297,
        "end": 19303
      },
      "text": "འདས་པ་ ༼སྣར། པེ།༽ འདས་པ་ཐོབ་པ་"
    },
    {
      "span": {
        "start": 19366,
        "end": 19379
      },
      "text": "བྱེད་པ་པོ་ཡང་ ༼སྣར། པེ།༽ བྱེད་པ་པོ་"
    },
    {
      "span": {
        "start": 19418,
        "end": 19424
      },
      "text": "གལ་ཏེ་ ༼སྣར། པེ།༽ གལ་ཏེ་ལས་"
    },
    {
      "span": {
        "start": 19454,
        "end": 19464
      },
      "text": "སྐྱེད་པའི་ ༼སྣར། པེ།༽ བསྐྱེད་པའི་"
    },
    {
      "span": {
        "start": 19464,
        "end": 19477
      },
      "text": "འབྲས་བུ་སྡུག་ ༼སྣར། པེ།༽ འབྲས་བུ་སྡུག་པ་"
    },
    {
      "span": {
        "start": 19688,
        "end": 19696
      },
      "text": "དགོངས་ན་ ༼སྣར། པེ།༽ དགོངས་ནས་"
    },
    {
      "span": {
        "start": 19763,
        "end": 19771
      },
      "text": "བརྟག་པར་ ༼སྣར། པེ།༽ བརྟགས་པར་"
    },
    {
      "span": {
        "start": 19814,
        "end": 19822
      },
      "text": "བརྟག་པར་ ༼སྣར། པེ།༽ བརྟགས་པར་"
    },
    {
      "span": {
        "start": 19822,
        "end": 19829
      },
      "text": "ཡོད་དོ། ༼སྣར། པེ།༽ ཡོད།"
    },
    {
      "span": {
        "start": 19843,
        "end": 19845
      },
      "text": "པ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 19860,
        "end": 19867
      },
      "text": "བརྟག་པ་ ༼སྣར། པེ།༽ རྟགས་པ་"
    },
    {
      "span": {
        "start": 19881,
        "end": 19890
      },
      "text": "སངས་རྒྱས་ ༼སྣར། པེ།༽ སངས་རྒྱས་རྣམས་"
    },
    {
      "span": {
        "start": 19937,
        "end": 19946
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 20047,
        "end": 20060
      },
      "text": "ཡིན་པའི་ཕྱིར་ ༼སྣར། པེ།༽ ཡིན་པའི་"
    },
    {
      "span": {
        "start": 20197,
        "end": 20204
      },
      "text": "ཕྱིར་ན་ ༼སྣར། པེ།༽ ཕྱིར་ནས་"
    },
    {
      "span": {
        "start": 20240,
        "end": 20247
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ བྱུང་བ་"
    },
    {
      "span": {
        "start": 20262,
        "end": 20268
      },
      "text": "དེ་ལྟ་ ༼སྣར། པེ།༽ དེ་ལྟ་ཡིན་"
    },
    {
      "span": {
        "start": 20279,
        "end": 20288
      },
      "text": "ཡང་དག་པར་ ༼སྣར། པེ།༽ ཡང་དག་པ་མ་"
    },
    {
      "span": {
        "start": 20501,
        "end": 20509
      },
      "text": "དེ་བཞིན་ ༼སྣར། པེ།༽ དེའི་གཞན་"
    },
    {
      "span": {
        "start": 20637,
        "end": 20643
      },
      "text": "ཇི་ལྟ་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 20693,
        "end": 20700
      },
      "text": "ལས་ཤེས་ ༼སྣར། པེ།༽ ལས་ཞེས་"
    },
    {
      "span": {
        "start": 20734,
        "end": 20741
      },
      "text": "ལས་ཞེས་ ༼སྡེ།༽ ལས་ཤེས་"
    },
    {
      "span": {
        "start": 20806,
        "end": 20813
      },
      "text": "ཆེན་པོ་ ༼སྣར། པེ།༽ བཞི་པོ་"
    },
    {
      "span": {
        "start": 20907,
        "end": 20912
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 20958,
        "end": 20966
      },
      "text": "མཚན་གཞི་ ༼སྣར། པེ།༽ ཕྱིར་མཚན་བཞི་"
    },
    {
      "span": {
        "start": 21000,
        "end": 21004
      },
      "text": "པའང་ ༼སྣར། པེ།༽ ལའང་"
    },
    {
      "span": {
        "start": 21159,
        "end": 21163
      },
      "text": "པའང་ ༼སྣར། པེ།༽ ལའང་"
    },
    {
      "span": {
        "start": 21385,
        "end": 21390
      },
      "text": "བྱེད་ ༼སྣར། པེ།༽ སྐྱེས་"
    },
    {
      "span": {
        "start": 21417,
        "end": 21424
      },
      "text": "རིགས་མ་ ༼སྣར། པེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 21633,
        "end": 21638
      },
      "text": "རྟགས་ ༼སྣར། པེ།༽ བཏགས་"
    },
    {
      "span": {
        "start": 22065,
        "end": 22074
      },
      "text": "། །གལ་ཏེ་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 22132,
        "end": 22140
      },
      "text": "མེད་པའི་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 22140,
        "end": 22147
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 22262,
        "end": 22269
      },
      "text": "མེད་ལས་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 22348,
        "end": 22356
      },
      "text": "གྱུར་ཏེ། ༼སྣར། པེ།༽ གྱུར་ན།"
    },
    {
      "span": {
        "start": 22526,
        "end": 22531
      },
      "text": "ཕྱིར་ ༼སྣར། པེ།༽ ཕྱིར་བློ་དེ་"
    },
    {
      "span": {
        "start": 22814,
        "end": 22821
      },
      "text": "དེ་ཡིས་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 22857,
        "end": 22866
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 22950,
        "end": 22958
      },
      "text": "སྐད་ཅིག་ ༼སྣར།༽ སྐད་ཅིག་པ་ ༼པེ།༽ སྐད་ཅིག་མ་"
    },
    {
      "span": {
        "start": 22979,
        "end": 22987
      },
      "text": "སྐད་ཅིག་ ༼སྣར། པེ།༽ སྐད་ཅིག་པ་"
    },
    {
      "span": {
        "start": 23030,
        "end": 23039
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 23066,
        "end": 23075
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 23145,
        "end": 23149
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིས་"
    },
    {
      "span": {
        "start": 23194,
        "end": 23201
      },
      "text": "དབྱིབས་ ༼སྣར། པེ།༽ དབྱིབས་སུ་"
    },
    {
      "span": {
        "start": 23390,
        "end": 23402
      },
      "text": "དབྱིབས་གཉིས་ ༼སྣར། པེ།༽ དབྱིབས་"
    },
    {
      "span": {
        "start": 23404,
        "end": 23407
      },
      "text": "དད་ ༼སྣར། པེ།༽ དད་པ་"
    },
    {
      "span": {
        "start": 23465,
        "end": 23471
      },
      "text": "འགྱུར། ༼སྣར། པེ།༽ འགྱུརན།"
    },
    {
      "span": {
        "start": 23684,
        "end": 23686
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 23876,
        "end": 23880
      },
      "text": "ཡོད། ༼སྣར། པེ།༽ ཡོདདེ།"
    },
    {
      "span": {
        "start": 23900,
        "end": 23907
      },
      "text": "བལྟ་བར་ ༼སྣར། པེ།༽ ལྟ་བར་"
    },
    {
      "span": {
        "start": 24301,
        "end": 24309
      },
      "text": "བདག་ཉིད་ ༼སྣར། པེ།༽ བདག་ཉིད་རང་"
    },
    {
      "span": {
        "start": 24431,
        "end": 24439
      },
      "text": "བསྟན་ཏེ། ༼སྣར།༽ བསྟན་པ་སྟེ ༼པེ།༽ བསྟན་པ་ཏེ།"
    },
    {
      "span": {
        "start": 24556,
        "end": 24563
      },
      "text": "ཡིན་ཏེ། ༼པེ།༽ ཡིན་ནོ།"
    },
    {
      "span": {
        "start": 24576,
        "end": 24585
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 24867,
        "end": 24874
      },
      "text": "ཡུལ་ཏེ་ ༼སྣར། པེ།༽ ཡུལ་སྟེ་"
    },
    {
      "span": {
        "start": 25107,
        "end": 25111
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ ཉིད་གང་ལས་"
    },
    {
      "span": {
        "start": 25150,
        "end": 25155
      },
      "text": "གྲུབ་ ༼སྣར། པེ།༽ གྲུབ་པ་"
    },
    {
      "span": {
        "start": 25182,
        "end": 25186
      },
      "text": "བྱས་ ༼སྣར། པེ།༽ བྱ་བ་ཉིད་"
    },
    {
      "span": {
        "start": 25225,
        "end": 25234
      },
      "text": "བརྟེན་ནས་ ༼པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 25247,
        "end": 25253
      },
      "text": "རང་གི་ ༼སྣར།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 25257,
        "end": 25264
      },
      "text": "ཉིད་དེ། ༼སྣར། པེ།༽ ཉིད་ཀྱིས་མ་གྲུབ་སྟེ།"
    },
    {
      "span": {
        "start": 25471,
        "end": 25479
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 25692,
        "end": 25709
      },
      "text": "སྔར་བཤད་པ་ཡིན་ནོ། ༼སྣར།༽ བརྟག་པ་བཤད་པ་སྔར་བྱས་ཟིན་ཏོ ༼པེ།༽ རྟག་པ་བཤད་པ་སྔར་བྱས་ཟིན་ཏོ།"
    },
    {
      "span": {
        "start": 25919,
        "end": 25934
      },
      "text": "འགྲུབ་པ་ཡིན་ནོ། ༼སྣར། པེ།༽ གྲུབ་པའི་ཕྱིར་རོ།"
    },
    {
      "span": {
        "start": 25948,
        "end": 25956
      },
      "text": "འགྲུབ་པ་ ༼སྣར། པེ།༽ གྲུབ་པ་"
    },
    {
      "span": {
        "start": 26019,
        "end": 26032
      },
      "text": "བདག་ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ བདག་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 26043,
        "end": 26050
      },
      "text": "ཇི་སྟེ་ ༼སྣར། པེ།༽ ཅི་སྟེ་"
    },
    {
      "span": {
        "start": 26155,
        "end": 26163
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ དངོས་"
    },
    {
      "span": {
        "start": 26221,
        "end": 26234
      },
      "text": "བདག་ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ བདག་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 27295,
        "end": 27301
      },
      "text": "རང་གི་ ༼སྣར།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 27380,
        "end": 27391
      },
      "text": "བདག་ཉིད་མི་ ༼སྣར།༽ བདག་ཉིད་ནི་"
    },
    {
      "span": {
        "start": 27718,
        "end": 27724
      },
      "text": "གལ་ཏེ་ ༼སྣར། པེ།༽ གང་ཚེ་"
    },
    {
      "span": {
        "start": 27797,
        "end": 27802
      },
      "text": "སྟོན་ ༼སྣར། པེ།༽ སྟེན་"
    },
    {
      "span": {
        "start": 27810,
        "end": 27820
      },
      "text": "སྟོང་པ་ཡང་ ༼སྣར། པེ།༽ སྟོང་པ་འང་"
    },
    {
      "span": {
        "start": 27833,
        "end": 27842
      },
      "text": "གང་གི་ཚེ་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 27866,
        "end": 27877
      },
      "text": "ལྷན་ཅིག་ཏུ་ ༼སྣར། པེ།༽ ལྷན་ཅིག་"
    },
    {
      "span": {
        "start": 27941,
        "end": 27947
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 28215,
        "end": 28224
      },
      "text": "ཀྱིས་རེག་ ༼སྣར།༽ ཀྱི་རིག་ ༼པེ།༽ ཀྱི་རེག་"
    },
    {
      "span": {
        "start": 28230,
        "end": 28236
      },
      "text": "དེ་དེ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 28254,
        "end": 28262
      },
      "text": "མེད་ཅེས་ ༼སྣར། པེ།༽ མེད་དོ་ཞེས་"
    },
    {
      "span": {
        "start": 28493,
        "end": 28502
      },
      "text": "སྐྱེ་བའི་ ༼སྣར། པེ།༽ སྐྱེ་བ་དེའི་"
    },
    {
      "span": {
        "start": 28593,
        "end": 28612
      },
      "text": "ཤེས་པ་རྣམ་པར་ཤེས་པ་ ༼སྣར། པེ།༽ ཤེས་པར་"
    },
    {
      "span": {
        "start": 28617,
        "end": 28620
      },
      "text": "པར་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 28693,
        "end": 28702
      },
      "text": "བརྟེན་ནས། ༼སྣར། པེ།༽ བརྟེན་ན།"
    },
    {
      "span": {
        "start": 28833,
        "end": 28839
      },
      "text": "བྱ་བར་ ༼སྣར། པེ།༽ བྱ་བ་ལ་"
    },
    {
      "span": {
        "start": 28931,
        "end": 28935
      },
      "text": "ཤེས་ ༼སྣར། པེ།༽ ཤེས་པར་བྱེད་"
    },
    {
      "span": {
        "start": 29402,
        "end": 29410
      },
      "text": "མདོ་སྡེ་ ༼སྣར། པེ།༽ མདོ་"
    },
    {
      "span": {
        "start": 29727,
        "end": 29734
      },
      "text": "བྱུང་པ་ ༼སྣར། པེ།༽ འབྱུང་པ་"
    },
    {
      "span": {
        "start": 30182,
        "end": 30191
      },
      "text": "སྐྱེད་པར་ ༼སྣར། པེ།༽ བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 30817,
        "end": 30824
      },
      "text": "མེད་པས་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 31075,
        "end": 31085
      },
      "text": "འབྱུང་ངོ་། ༼སྣར། པེ།༽ འབྱུང་།"
    },
    {
      "span": {
        "start": 31303,
        "end": 31309
      },
      "text": "པ་དང་། ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 31553,
        "end": 31559
      },
      "text": "ཤེས་ན་ ༼སྣར། པེ།༽ ཤེས་ནས་"
    },
    {
      "span": {
        "start": 31621,
        "end": 31624
      },
      "text": "ལག་ ༼སྡེ།༽ ལ་"
    },
    {
      "span": {
        "start": 31754,
        "end": 31758
      },
      "text": "མགལ་ ༼སྣར། པེ།༽ འགལ་"
    },
    {
      "span": {
        "start": 31929,
        "end": 31933
      },
      "text": "པ་མ་ ༼སྣར། པེ།༽ ན་མ་"
    },
    {
      "span": {
        "start": 32044,
        "end": 32048
      },
      "text": "འགག་ ༼སྣར། པེ།༽ འགགས་"
    },
    {
      "span": {
        "start": 32401,
        "end": 32408
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་པས་"
    },
    {
      "span": {
        "start": 32481,
        "end": 32487
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 32644,
        "end": 32649
      },
      "text": "འཕགས། ༼སྣར། པེ།༽ བརྟགས།"
    },
    {
      "span": {
        "start": 32707,
        "end": 32720
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 32860,
        "end": 32868
      },
      "text": "བརྟག་པར་ ༼སྣར། པེ།༽ བརྟགས་པར་"
    },
    {
      "span": {
        "start": 32868,
        "end": 32871
      },
      "text": "ཟད་ ༼སྣར། པེ།༽ མཛད་"
    },
    {
      "span": {
        "start": 32940,
        "end": 32958
      },
      "text": "གཤེགས་བཤད་མ་རྟོགས་ ༼སྣར།༽ གཤེགས་པ་བཤད་རྟོག་ ༼པེ།༽ གཤེགས་པ་བཤད་རྟོག་ས་"
    },
    {
      "span": {
        "start": 33110,
        "end": 33117
      },
      "text": "དོན་དམ་ ༼སྣར། པེ།༽ དོན་རྣམ་"
    },
    {
      "span": {
        "start": 33196,
        "end": 33203
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 33253,
        "end": 33259
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 33273,
        "end": 33281
      },
      "text": "བྱ་བ་ནི། ༼སྣར། པེ།༽ བྱ་བའི།"
    },
    {
      "span": {
        "start": 33637,
        "end": 33647
      },
      "text": "འདིར་རིགས་ ༼སྣར། པེ།༽ འདི་རིགས་"
    },
    {
      "span": {
        "start": 33763,
        "end": 33771
      },
      "text": "འགག་ཞིག་ ༼སྣར། པེ།༽ གང་ཞིག་"
    },
    {
      "span": {
        "start": 33784,
        "end": 33792
      },
      "text": "རིགས་པས་ ༼སྣར། པེ།༽ རིག་པས་"
    },
    {
      "span": {
        "start": 33952,
        "end": 33956
      },
      "text": "སྤང་ ༼སྣར། པེ།༽ སྤངས་"
    },
    {
      "span": {
        "start": 34016,
        "end": 34022
      },
      "text": "བཤད་པ། ༼སྣར། པེ།༽ བཤད་པ་བརྡའ་སྤྲོད་པ་ཆེན་པོ་བསྟན་བཅོས་ཐམས་ཅད་འཆད་པར་བཞེད་པ།"
    }
  ]
}