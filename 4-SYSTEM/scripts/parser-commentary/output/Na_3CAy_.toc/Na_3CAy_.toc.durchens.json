{
  "durchens": [
    {
      "span": {
        "start": 47,
        "end": 50
      },
      "text": "བྱ་ ༼ཅོ། སྡེ།༽ བྱཱ་"
    },
    {
      "span": {
        "start": 329,
        "end": 332
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 451,
        "end": 456
      },
      "text": "ལྟ་བ་ ༼སྣར། པེ།༽ བལྟ་བ་"
    },
    {
      "span": {
        "start": 479,
        "end": 485
      },
      "text": "དེ་དག་ ༼སྣར། པེ།༽ དེ་དག་གི་"
    },
    {
      "span": {
        "start": 684,
        "end": 688
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 872,
        "end": 883
      },
      "text": "བྱ་བའི་རྣམ་ ༼སྣར། པེ།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 1019,
        "end": 1028
      },
      "text": "གནམ་གྱིས་ ༼སྣར། པེ།༽ གནས་ཀྱིས་"
    },
    {
      "span": {
        "start": 1128,
        "end": 1134
      },
      "text": "ཡན་ལག་ ༼སྣར། པེ།༽ ཡན་ལག་བྱེ་བྲག་"
    },
    {
      "span": {
        "start": 1210,
        "end": 1216
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 1467,
        "end": 1471
      },
      "text": "དགུ་ ༼སྣར།༽ བུ་"
    },
    {
      "span": {
        "start": 1653,
        "end": 1655
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 1840,
        "end": 1849
      },
      "text": "དེ་དག་ནི་ ༼སྣར། པེ།༽ དེ་དག་གི་"
    },
    {
      "span": {
        "start": 2038,
        "end": 2045
      },
      "text": "སྡུག་པ་ ༼སྣར།༽ སྡུག་པར་"
    },
    {
      "span": {
        "start": 2260,
        "end": 2265
      },
      "text": "སྒྲས་ ༼སྣར། པེ།༽ སྒྲ་"
    },
    {
      "span": {
        "start": 2276,
        "end": 2281
      },
      "text": "ཚིགས་ ༼སྣར། པེ།༽ ཚིག་"
    },
    {
      "span": {
        "start": 2495,
        "end": 2498
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 2658,
        "end": 2667
      },
      "text": "ཉོན་མོངས་ ༼སྣར། པེ།༽ ཉོན་མོངས་པ་"
    },
    {
      "span": {
        "start": 2700,
        "end": 2705
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ ཞེས་བྱ་བ་"
    },
    {
      "span": {
        "start": 2953,
        "end": 2961
      },
      "text": "འཕྱན་ནོ། ༼སྣར། པེ།༽ འཕྱན།"
    },
    {
      "span": {
        "start": 3006,
        "end": 3013
      },
      "text": "དོན་ཏེ། ༼སྣར། པེ།༽ དོན་སྟེ།"
    },
    {
      "span": {
        "start": 3119,
        "end": 3124
      },
      "text": "འོ་ན་ ༼སྣར། པེ།༽ ཁོ་ན་"
    },
    {
      "span": {
        "start": 3188,
        "end": 3197
      },
      "text": "ཇི་ལྟ་བུ། ༼སྣར། པེ།༽ ཇི་ལྟ་བུར།"
    },
    {
      "span": {
        "start": 3206,
        "end": 3215
      },
      "text": "འགྲོ་ཀུན་ ༼སྣར། པེ།༽ འགྲོ་བ་ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 3262,
        "end": 3270
      },
      "text": "སེམས་ཅན་ ༼སྣར། པེ།༽ སེམས་ཅན་གཞན་"
    },
    {
      "span": {
        "start": 3298,
        "end": 3305
      },
      "text": "བཏགས་པ་ ༼སྡེ།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 3465,
        "end": 3468
      },
      "text": "སུ་ ༼སྣར། པེ།༽ སུ་ལ་"
    },
    {
      "span": {
        "start": 3765,
        "end": 3773
      },
      "text": "བདུན་པོ་ ༼སྣར། པེ།༽ བདུན་པོ་དེ་"
    },
    {
      "span": {
        "start": 3943,
        "end": 3956
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 4036,
        "end": 4041
      },
      "text": "སྨྲས་ ༼སྣར། པེ།༽ དྲིས་"
    },
    {
      "span": {
        "start": 4079,
        "end": 4092
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 4156,
        "end": 4162
      },
      "text": "ཁ་ཐོན་ ༼སྣར། པེ།༽ ཁ་ཏོན་"
    },
    {
      "span": {
        "start": 4175,
        "end": 4179
      },
      "text": "རྒྱ། ༼སྣར། པེ།༽ བརྒྱ།"
    },
    {
      "span": {
        "start": 4273,
        "end": 4288
      },
      "text": "ཕ་རོལ་འགྲུབ་པར་ ༼སྣར།༽ ཕ་རོལ་"
    },
    {
      "span": {
        "start": 4619,
        "end": 4624
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ སྒྱུར་"
    },
    {
      "span": {
        "start": 4692,
        "end": 4701
      },
      "text": "འབྱུང་བས་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 4728,
        "end": 4741
      },
      "text": "ནོ་ཞེས་བརྗོད་ ༼སྣར། པེ།༽ ནོ་ཞེས་"
    },
    {
      "span": {
        "start": 4781,
        "end": 4794
      },
      "text": "སྐྱེས་པའི་ཆར་ ༼སྣར། པེ།༽ སྐྱེ་བར་"
    },
    {
      "span": {
        "start": 4881,
        "end": 4884
      },
      "text": "དུ་ ༼སྣར། པེ།༽ དུ་ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 5188,
        "end": 5193
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 6071,
        "end": 6077
      },
      "text": "གསལ་བ་ ༼སྣར། པེ།༽ བསལ་བ་"
    },
    {
      "span": {
        "start": 6146,
        "end": 6152
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 6162,
        "end": 6171
      },
      "text": "བརྟགས་པར། ༼སྣར། པེ།༽ བརྟགས་པ།"
    },
    {
      "span": {
        "start": 6187,
        "end": 6193
      },
      "text": "དེ་ཡི་ ༼སྣར། པེ།༽ དེ་ཡིས་"
    },
    {
      "span": {
        "start": 6237,
        "end": 6241
      },
      "text": "གསལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 6256,
        "end": 6263
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 6310,
        "end": 6317
      },
      "text": "མཐོང་ན་ ༼སྣར། པེ།༽ མཐོང་ནས་"
    },
    {
      "span": {
        "start": 6419,
        "end": 6424
      },
      "text": "སོ། ། ༼སྣར། པེ།༽ ། །རྒྱ་གར་གྱིས་མཁན་པོ་ཛི་ན་མི་ཏྲ་དང་། དྷ་ན་ཤི་ལ་དང་། ཤི་ལཱེནྡྲ་བོ་བྷི་དང་། བནྡེ་ཡེ་ཤེས་སྡེས་ལ་སོགས་པས་བསྒྱུར་ཅིང་ཞུས་ཏེ་གཏན་ལ་ཕབ་པའོ།། །།"
    }
  ]
}