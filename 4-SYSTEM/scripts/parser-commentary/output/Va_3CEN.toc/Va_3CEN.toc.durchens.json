{
  "durchens": [
    {
      "span": {
        "start": 158,
        "end": 162
      },
      "text": "གཞག་ ༼སྣར། པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 862,
        "end": 870
      },
      "text": "འབྱུང་ལ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 910,
        "end": 918
      },
      "text": "འབྱུང་ལ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 951,
        "end": 958
      },
      "text": "འཁོད་པ་ ༼སྣར།༽ འབོད་པ་"
    },
    {
      "span": {
        "start": 1600,
        "end": 1610
      },
      "text": "འགྲུབ་སྟེ། ༼སྣར། པེ།༽ འགྱུར་ཏེ།"
    },
    {
      "span": {
        "start": 1667,
        "end": 1673
      },
      "text": "ཇི་ལྟ་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 1777,
        "end": 1824
      },
      "text": "ལ་ཐམས་ཅད་ན་མ་ཡིན་ཡུལ་དེ་ཉིད་ན་ཡང་རེས་འགའ་སྣང་ལ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 2009,
        "end": 2015
      },
      "text": "འགྲུབ། ༼སྣར། པེ།༽ གྲུབ།"
    },
    {
      "span": {
        "start": 2203,
        "end": 2211
      },
      "text": "རྣག་གིས་ ༼སྣར། པེ།༽ རྣག་གི་"
    },
    {
      "span": {
        "start": 2250,
        "end": 2258
      },
      "text": "རྣག་གིས་ ༼སྣར། པེ།༽ རྣག་གི་"
    },
    {
      "span": {
        "start": 2304,
        "end": 2309
      },
      "text": "མེ་མ་ ༼སྣར། པེ།༽ མེ་མར་"
    },
    {
      "span": {
        "start": 2389,
        "end": 2396
      },
      "text": "སྲུང་བ་ ༼སྣར། པེ།༽ བསྲུངས་པ་"
    },
    {
      "span": {
        "start": 2539,
        "end": 2544
      },
      "text": "གྲུབ་ ༼སྣར། པེ།༽ འགྲུབ་"
    },
    {
      "span": {
        "start": 2725,
        "end": 2730
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 2770,
        "end": 2775
      },
      "text": "གྲུབ་ ༼སྣར། པེ།༽ འགྲུབ་"
    },
    {
      "span": {
        "start": 2992,
        "end": 3002
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 3181,
        "end": 3189
      },
      "text": "མཐོང་གི། ༼སྣར། པེ།༽ མཐོང་གིས།"
    },
    {
      "span": {
        "start": 3199,
        "end": 3204
      },
      "text": "ནི་མ་ ༼སྣར། པེ།༽ ན་མ་"
    },
    {
      "span": {
        "start": 3446,
        "end": 3456
      },
      "text": "ཅིའི་ཕྱིར་ ༼སྣར།༽ ཅི་ཕྱིར་"
    },
    {
      "span": {
        "start": 3758,
        "end": 3764
      },
      "text": "གཞག་པ་ ༼སྣར། པེ།༽ བཞག་པ་"
    },
    {
      "span": {
        "start": 3777,
        "end": 3782
      },
      "text": "རོ། ། ༼སྣར། པེ།༽ འཇིག།"
    },
    {
      "span": {
        "start": 4580,
        "end": 4590
      },
      "text": "དེའི་ཕྱིར་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 4628,
        "end": 4639
      },
      "text": "ཡི་དགས་ཀྱི་ ༼སྣར། པེ།༽ ཡི་དགས་"
    },
    {
      "span": {
        "start": 4680,
        "end": 4689
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 4692,
        "end": 4702
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 4920,
        "end": 4926
      },
      "text": "འགྲུབ་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 5078,
        "end": 5086
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ འགྱུར་བ་དེ་"
    },
    {
      "span": {
        "start": 5141,
        "end": 5149
      },
      "text": "ལས་ཀྱིས་ ༼སྣར། པེ།༽ ལས་ཀྱི་"
    },
    {
      "span": {
        "start": 5167,
        "end": 5174
      },
      "text": "བྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 5394,
        "end": 5400
      },
      "text": "རྟོག ། ༼སྣར། པེ།༽ རྟོགས། །"
    },
    {
      "span": {
        "start": 5466,
        "end": 5475
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 5552,
        "end": 5562
      },
      "text": "བག་ཆགས་དེ་ ༼སྣར། པེ།༽ བག་ཆགས་"
    },
    {
      "span": {
        "start": 5676,
        "end": 5683
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 5942,
        "end": 5950
      },
      "text": "གསུང་བར་ ༼པེ།༽ གསུངས་པར་"
    },
    {
      "span": {
        "start": 5953,
        "end": 5962
      },
      "text": "འགྱུར་རོ་ ༼སྣར།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 6094,
        "end": 6100
      },
      "text": "བརྫུས་ ༼སྣར། པེ།༽ རྫུས་"
    },
    {
      "span": {
        "start": 6152,
        "end": 6158
      },
      "text": "བརྫུས་ ༼སྣར། པེ།༽ རྫུས་"
    },
    {
      "span": {
        "start": 6170,
        "end": 6183
      },
      "text": "སེམས་ཅན་བཞིན་ ༼སྣར། པེ།༽ སེམས་ཅན་"
    },
    {
      "span": {
        "start": 6215,
        "end": 6230
      },
      "text": "སེམས་ཀྱི་རྒྱུད་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 6842,
        "end": 6851
      },
      "text": "འདས་ཀྱིས་ ༼སྣར། པེ།༽ འདས་ཀྱི་"
    },
    {
      "span": {
        "start": 7310,
        "end": 7321
      },
      "text": "ཤེས་པ་དྲུག་ ༼པེ།༽ ཤེས་པ་"
    },
    {
      "span": {
        "start": 7339,
        "end": 7347
      },
      "text": "གཅིག་པུ་ ༼སྣར། པེ།༽ གཅིག་པོ་"
    },
    {
      "span": {
        "start": 7474,
        "end": 7481
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ བསྟན་པའི་"
    },
    {
      "span": {
        "start": 7546,
        "end": 7549
      },
      "text": "ཙམ་ ༼སྣར། པེ།༽ ཙམ་ཉིད་"
    },
    {
      "span": {
        "start": 7681,
        "end": 7693
      },
      "text": "མཚན་ཉིད་ཀྱི་ ༼སྣར།༽ མཚན་ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 7717,
        "end": 7727
      },
      "text": "འཇུག་གོ། ། ༼སྣར། པེ།༽ འཇུག །"
    },
    {
      "span": {
        "start": 7737,
        "end": 7743
      },
      "text": "རྣམ་པ་ ༼ཅོ།༽ རྣམ་པར་"
    },
    {
      "span": {
        "start": 8022,
        "end": 8026
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱི་སྤྱོད་"
    },
    {
      "span": {
        "start": 8076,
        "end": 8078
      },
      "text": "པ་ ༼ཅོ།༽ པར་"
    },
    {
      "span": {
        "start": 8175,
        "end": 8185
      },
      "text": "རྟོགས་པའི་ ༼སྣར། པེ།༽ རྟོག་པའི་"
    },
    {
      "span": {
        "start": 8216,
        "end": 8223
      },
      "text": "གཞག་པས་ ༼སྣར། པེ།༽ བཞག་པས་"
    },
    {
      "span": {
        "start": 8559,
        "end": 8561
      },
      "text": "པ་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 8592,
        "end": 8598
      },
      "text": "རིག་པ་ ༼སྣར།༽ རིག་པར་"
    },
    {
      "span": {
        "start": 8644,
        "end": 8653
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 8968,
        "end": 8977
      },
      "text": "བརྟག་པའི་ ༼སྣར། པེ།༽ བརྟགས་པའི་"
    },
    {
      "span": {
        "start": 9466,
        "end": 9474
      },
      "text": "གཅིག་གི་ ༼སྣར། པེ།༽ གཅིག་གིས་"
    },
    {
      "span": {
        "start": 9574,
        "end": 9581
      },
      "text": "ཇི་སྟེ་ ༼སྣར།༽ ཇི་སྙེད་"
    },
    {
      "span": {
        "start": 9649,
        "end": 9651
      },
      "text": "ན་ ༼སྣར།༽ ན་ད་"
    },
    {
      "span": {
        "start": 9651,
        "end": 9658
      },
      "text": "ནི་དེས་ ༼སྣར།༽ ནི་"
    },
    {
      "span": {
        "start": 9896,
        "end": 9904
      },
      "text": "ཡིན་གྱི། ༼སྣར། པེ།༽ ཡིན་གྱིས།"
    },
    {
      "span": {
        "start": 9980,
        "end": 9999
      },
      "text": "འདུས་པ་གང་ཡིན་པ་དེ་ ༼སྣར། པེ།༽ གང་ཡིན་པ་"
    },
    {
      "span": {
        "start": 10016,
        "end": 10021
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ ནམ་གཞན་"
    },
    {
      "span": {
        "start": 10156,
        "end": 10159
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 10236,
        "end": 10247
      },
      "text": "ཕྲ་རབ་རྣམས་ ༼སྣར།༽ ཕྲ་རབ་གྱི་རྣམ་ ༼པེ།༽ ཕྲ་རབ་གྱི་རྣམས་"
    },
    {
      "span": {
        "start": 10327,
        "end": 10336
      },
      "text": "སྦྱོར་བར་ ༼སྣར། པེ།༽ སྦྱོར་བས་"
    },
    {
      "span": {
        "start": 10360,
        "end": 10366
      },
      "text": "དེ་བས་ ༼སྣར།༽ དེ་བས་ན་"
    },
    {
      "span": {
        "start": 10646,
        "end": 10652
      },
      "text": "སྒྲིབ་ ༼སྣར། པེ།༽ གྲིབ་"
    },
    {
      "span": {
        "start": 10702,
        "end": 10704
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་ཡང་"
    },
    {
      "span": {
        "start": 10760,
        "end": 10767
      },
      "text": "གྲིབ་མ་ ༼སྣར། པེ།༽ གྲིབ་མི་"
    },
    {
      "span": {
        "start": 10856,
        "end": 10862
      },
      "text": "ཕྱོགས་ ༼སྣར། པེ།༽ ཆ་"
    },
    {
      "span": {
        "start": 11007,
        "end": 11012
      },
      "text": "ཐོགས་ ༼སྣར། པེ།༽ ཐོག་"
    },
    {
      "span": {
        "start": 11224,
        "end": 11226
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 11329,
        "end": 11337
      },
      "text": "རྡུལ་ཕྲ་ ༼ཅོ།༽ རྡུལ་"
    },
    {
      "span": {
        "start": 11411,
        "end": 11419
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 11553,
        "end": 11560
      },
      "text": "གང་ཡིན། ༼སྣར།༽ གང་ཡིན་ནོ།"
    },
    {
      "span": {
        "start": 11878,
        "end": 11882
      },
      "text": "སོད་ ༼སྣར།༽ བསོད་"
    },
    {
      "span": {
        "start": 12019,
        "end": 12025
      },
      "text": "གོམ་པ་ ༼སྣར། པེ།༽ གོམས་པ་"
    },
    {
      "span": {
        "start": 12566,
        "end": 12572
      },
      "text": "པར་མི་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 12635,
        "end": 12646
      },
      "text": "དེ་དག་གཅིག་ ༼པེ།༽ དེ་དག་ཅིག་"
    },
    {
      "span": {
        "start": 12846,
        "end": 12851
      },
      "text": "ན་ཡང་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 13051,
        "end": 13060
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 13064,
        "end": 13071
      },
      "text": "དེ་མིན་ ༼སྣར། པེ།༽ དེ་མི་"
    },
    {
      "span": {
        "start": 13132,
        "end": 13139
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 13193,
        "end": 13202
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 13524,
        "end": 13528
      },
      "text": "ད་མ་ ༼སྣར། པེ།༽ ད་"
    },
    {
      "span": {
        "start": 13692,
        "end": 13696
      },
      "text": "ཟིན། ༼སྣར། པེ།༽ ཟིན་ནས།"
    },
    {
      "span": {
        "start": 13780,
        "end": 13791
      },
      "text": "དེ་བཞིན་ཏེ་ ༼སྣར། པེ།༽ དེ་བཞིན་དེ་"
    },
    {
      "span": {
        "start": 14157,
        "end": 14162
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིག་"
    },
    {
      "span": {
        "start": 14165,
        "end": 14172
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 14330,
        "end": 14336
      },
      "text": "རྟོགས་ ༼སྣར། པེ།༽ རྟོག་"
    },
    {
      "span": {
        "start": 14462,
        "end": 14470
      },
      "text": "མཐོང་ཏེ། ༼སྣར། པེ།༽ མཐོང་སྟེ།"
    },
    {
      "span": {
        "start": 14499,
        "end": 14502
      },
      "text": "ལྟ་ ༼ཅོ།༽ ལྟར་"
    },
    {
      "span": {
        "start": 14834,
        "end": 14840
      },
      "text": "འབྱུང་ ༼སྣར། པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 14852,
        "end": 14859
      },
      "text": "ཁྱད་པར་ ༼པེ།༽ ཁྱད་པ་"
    },
    {
      "span": {
        "start": 14871,
        "end": 14879
      },
      "text": "བརྟེན་པ་ ༼སྣར། པེ།༽ རྟེན་པ་"
    },
    {
      "span": {
        "start": 14944,
        "end": 14952
      },
      "text": "བརྟེན་པ་ ༼སྣར།༽ རྟེན་པ་"
    },
    {
      "span": {
        "start": 15001,
        "end": 15011
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 15037,
        "end": 15046
      },
      "text": "འགྲུབ་པར་ ༼སྣར། པེ།༽ གྲུབ་པར་"
    },
    {
      "span": {
        "start": 15148,
        "end": 15156
      },
      "text": "དབང་གིས་ ༼སྣར།༽ དབང་གི་"
    },
    {
      "span": {
        "start": 15274,
        "end": 15282
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 15341,
        "end": 15347
      },
      "text": "འབྱུང་ ༼པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 15497,
        "end": 15499
      },
      "text": "ན་ ༼པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 15529,
        "end": 15539
      },
      "text": "སྤྱོད་པའི་ ༼སྣར། པེ།༽ དཔྱད་པའི་"
    },
    {
      "span": {
        "start": 15568,
        "end": 15575
      },
      "text": "འདོད་པ་ ༼སྣར། པེ།༽ འདོད་པར་"
    },
    {
      "span": {
        "start": 15630,
        "end": 15642
      },
      "text": "དེ་ཕྱིར་རྨི་ ༼སྣར།༽ དེ་ཕྱིར་མི་"
    },
    {
      "span": {
        "start": 15677,
        "end": 15685
      },
      "text": "ཡིན་གྱི་ ༼སྣར།༽ ཡིན་གྱིས་"
    },
    {
      "span": {
        "start": 15938,
        "end": 15942
      },
      "text": "རྣམ་ ༼པེ།༽ རྣམ་པར་"
    },
    {
      "span": {
        "start": 16064,
        "end": 16072
      },
      "text": "ཡིད་ཀྱི་ ༼སྣར། པེ།༽ ཡིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 16076,
        "end": 16080
      },
      "text": "གིས་ ༼སྣར།༽ གི་"
    },
    {
      "span": {
        "start": 16087,
        "end": 16090
      },
      "text": "གི་ ༼སྣར། པེ།༽ གིས་"
    },
    {
      "span": {
        "start": 16246,
        "end": 16261
      },
      "text": "གྱི་བརླབས་ཀྱིས་ ༼སྣར།༽ གྱིས་བརླབ་མ་གྱིས་ ༼པེ།༽ གྱིས་བརླབས་ཀྱིས་"
    },
    {
      "span": {
        "start": 16325,
        "end": 16337
      },
      "text": "ཐགས་ཟངས་རིས་ ༼སྣར། པེ།༽ ཐག་བཟངས་རིགས་"
    },
    {
      "span": {
        "start": 16353,
        "end": 16360
      },
      "text": "རྣམ་པར་ ༼སྣར།༽ རྣམ་པ་"
    },
    {
      "span": {
        "start": 16448,
        "end": 16451
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 16466,
        "end": 16476
      },
      "text": "རྒྱུད་ཀྱི་ ༼སྣར། པེ།༽ རྒྱུད་ཀྱིས་"
    },
    {
      "span": {
        "start": 16482,
        "end": 16487
      },
      "text": "ཆད་པ་ ༼སྣར། པེ།༽ འཆད་པ་"
    },
    {
      "span": {
        "start": 16526,
        "end": 16534
      },
      "text": "ཁྲོས་པས་ ༼སྣར། པེ།༽ ཁྲོས་པའི་"
    },
    {
      "span": {
        "start": 16559,
        "end": 16568
      },
      "text": "སྟོངས་པར་ ༼སྣར། པེ།༽ སྟོང་པར་"
    },
    {
      "span": {
        "start": 16597,
        "end": 16605
      },
      "text": "རིག་པའི་ ༼སྣར། པེ།༽ རིག་"
    },
    {
      "span": {
        "start": 16613,
        "end": 16617
      },
      "text": "གིས་ ༼སྣར། པེ།༽ གི་"
    },
    {
      "span": {
        "start": 16694,
        "end": 16703
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 16733,
        "end": 16738
      },
      "text": "ཉེ་བ་ ༼སྣར། པེ།༽ ཉེ་བར་"
    },
    {
      "span": {
        "start": 16796,
        "end": 16806
      },
      "text": "ཀ་ལིང་ཀའི་ ༼སྣར། པེ།༽ ཀ་ལིངྒའི་"
    },
    {
      "span": {
        "start": 16816,
        "end": 16825
      },
      "text": "མ་ཏང་ཀའི་ ༼སྣར། པེ།༽ མ་ཏངྒའི་"
    },
    {
      "span": {
        "start": 16849,
        "end": 16857
      },
      "text": "སྟོངས་པ་ ༼སྣར། པེ།༽ སྟོང་པ་"
    },
    {
      "span": {
        "start": 17124,
        "end": 17134
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 17398,
        "end": 17405
      },
      "text": "རིག་པས་ ༼སྣར། པེ།༽ རིགས་པས་"
    },
    {
      "span": {
        "start": 17927,
        "end": 17935
      },
      "text": "ཙམ་གྱིས་ ༼སྣར། པེ།༽ ཙམ་གྱི་"
    },
    {
      "span": {
        "start": 17978,
        "end": 17984
      },
      "text": "དཔོགས་ ༼སྣར། པེ།༽ དཔོག་"
    },
    {
      "span": {
        "start": 18198,
        "end": 18208
      },
      "text": "སྤྱོད་ཡུལ་ ༼སྣར། པེ།༽ སྤྱོད་ཡུལ་ཡིན་"
    },
    {
      "span": {
        "start": 18294,
        "end": 18304
      },
      "text": "སྤྱོད་ཡུལ་ ༼སྣར། པེ།༽ སྤྱོད་ཡུལ་ཡིན་"
    },
    {
      "span": {
        "start": 18387,
        "end": 18403
      },
      "text": "དབྱིག་གཉེན་གྱིས་ ༼སྣར། པེ།༽ དབྱིག་གཉེན་གྱི་"
    },
    {
      "span": {
        "start": 18407,
        "end": 18409
      },
      "text": "པ་ ༼སྣར། པེ།༽ པའི་"
    }
  ]
}