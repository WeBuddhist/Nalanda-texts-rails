{
  "durchens": [
    {
      "span": {
        "start": 132,
        "end": 144
      },
      "text": "ཉི་མ་མེ་ཡིས་ ༼སྣར། པེ།༽ ཉི་མ་མའི་"
    },
    {
      "span": {
        "start": 256,
        "end": 263
      },
      "text": "ཐོབ་པར་ ༼སྣར། པེ།༽ འཐོབ་པར་"
    },
    {
      "span": {
        "start": 510,
        "end": 513
      },
      "text": "ཡར་ ༼སྣར། པེ།༽ མར་"
    },
    {
      "span": {
        "start": 616,
        "end": 623
      },
      "text": "རང་གཞན་ ༼སྣར། པེ།༽ རང་བཞིན་"
    },
    {
      "span": {
        "start": 1101,
        "end": 1103
      },
      "text": "པ་ ༼སྣར། པེ།༽ པས་"
    },
    {
      "span": {
        "start": 1201,
        "end": 1203
      },
      "text": "པ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 1240,
        "end": 1247
      },
      "text": "ཤེས་པར་ ༼སྣར། པེ།༽ ཤེས་རབ་"
    },
    {
      "span": {
        "start": 1312,
        "end": 1316
      },
      "text": "རིག་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 1355,
        "end": 1357
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 1388,
        "end": 1395
      },
      "text": "ག་འོག ། ༼སྣར། པེ།༽ གའོ། །"
    },
    {
      "span": {
        "start": 1585,
        "end": 1588
      },
      "text": "དེ་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 1701,
        "end": 1709
      },
      "text": "སྟེང་དུ་ ༼སྣར། པེ།༽ སྟེང་དང་"
    },
    {
      "span": {
        "start": 2035,
        "end": 2038
      },
      "text": "ཀྲ་ ༼སྣར། པེ།༽ ཏྲ་"
    },
    {
      "span": {
        "start": 2384,
        "end": 2395
      },
      "text": "བསྡུས་པ་ཡི། ༼སྣར། པེ།༽ བསྡུས་པ་ཡིས།"
    },
    {
      "span": {
        "start": 2456,
        "end": 2463
      },
      "text": "བཞིན་ཕ་ ༼སྣར། པེ།༽ བཞི་པ་"
    },
    {
      "span": {
        "start": 2555,
        "end": 2561
      },
      "text": "ཚལ་དུ་ ༼སྣར། པེ།༽ ཚལ་བུ་"
    },
    {
      "span": {
        "start": 2567,
        "end": 2578
      },
      "text": "ལུས་པོ་ཡིས་ ༼པེ།༽ ལུས་པོ་ཡི་"
    },
    {
      "span": {
        "start": 2649,
        "end": 2654
      },
      "text": "སྲོག་ ༼སྣར། པེ།༽ སོར་"
    },
    {
      "span": {
        "start": 2713,
        "end": 2722
      },
      "text": "ཚིགས་བཅད་ ༼སྣར། པེ།༽ ཚོགས་བཤད་"
    },
    {
      "span": {
        "start": 2975,
        "end": 2982
      },
      "text": "འདུས་པ་ ༼སྣར། པེ།༽ འདུས་པར་"
    },
    {
      "span": {
        "start": 3054,
        "end": 3062
      },
      "text": "ལུས་རིར་ ༼སྣར། པེ།༽ ལུང་རིག་"
    },
    {
      "span": {
        "start": 3155,
        "end": 3161
      },
      "text": "བཅས་པ་ ༼སྣར། པེ།༽ བཅས་པར་"
    },
    {
      "span": {
        "start": 3203,
        "end": 3209
      },
      "text": "རྩ་ཡི་ ༼སྣར། པེ།༽ རྩི་ཡང་"
    },
    {
      "span": {
        "start": 3281,
        "end": 3283
      },
      "text": "པ་ ༼སྣར། པེ།༽ ས་"
    },
    {
      "span": {
        "start": 3315,
        "end": 3324
      },
      "text": "རྡོ་རྗེར་ ༼སྣར། པེ།༽ རྡོ་རྗེས་"
    },
    {
      "span": {
        "start": 3560,
        "end": 3564
      },
      "text": "རོང་ ༼སྣར། པེ།༽ རེ་"
    },
    {
      "span": {
        "start": 3627,
        "end": 3633
      },
      "text": "བཟུང་། ༼སྣར། པེ།༽ གཟུང་།"
    },
    {
      "span": {
        "start": 3740,
        "end": 3749
      },
      "text": "ཞུ་བ་ཡིས། ༼སྣར། པེ།༽ ཞུ་བ་ཡི།"
    },
    {
      "span": {
        "start": 4287,
        "end": 4289
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 4594,
        "end": 4603
      },
      "text": "བྱིན་གྱི་ ༼སྣར། པེ།༽ བྱིན་གྱིས་"
    },
    {
      "span": {
        "start": 4611,
        "end": 4619
      },
      "text": "བྱུང་། །༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 4717,
        "end": 4720
      },
      "text": "དག་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 4843,
        "end": 4850
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 4870,
        "end": 4880
      },
      "text": "གཉིས་ཀྱིས་ ༼སྣར། པེ།༽ གཉིས་ཀྱི་"
    },
    {
      "span": {
        "start": 5034,
        "end": 5042
      },
      "text": "སྐྱོར་བ་ ༼སྣར། པེ།༽ སྐྱེར་བ་"
    },
    {
      "span": {
        "start": 5076,
        "end": 5087
      },
      "text": "ཁྱད་པར་གྱི། ༼སྣར། པེ།༽ ཁྱད་པར་གྱིས།"
    },
    {
      "span": {
        "start": 5211,
        "end": 5219
      },
      "text": "སུམ་མདོ་ ༼སྣར། པེ།༽ གསུམ་པོ་"
    },
    {
      "span": {
        "start": 5310,
        "end": 5320
      },
      "text": "གཉིས་ཀྱིས་ ༼སྣར། པེ།༽ གཉིས་ཀྱི་"
    },
    {
      "span": {
        "start": 5379,
        "end": 5389
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 5833,
        "end": 5841
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 5900,
        "end": 5906
      },
      "text": "དགྲོལ། ༼སྣར། པེ།༽ བཀྲོལ།"
    },
    {
      "span": {
        "start": 6352,
        "end": 6361
      },
      "text": "ཀུན་གྱིས་ ༼སྣར། པེ།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 6532,
        "end": 6538
      },
      "text": "གཟུང་། ༼སྣར། པེ།༽ བཟུང་།"
    },
    {
      "span": {
        "start": 6662,
        "end": 6665
      },
      "text": "དི་ ༼སྣར། པེ།༽ ཊི་"
    },
    {
      "span": {
        "start": 6784,
        "end": 6793
      },
      "text": "རབ་གནས་པ། ༼སྣར། པེ།༽ རབ་གནས་པར།"
    },
    {
      "span": {
        "start": 7430,
        "end": 7435
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ སུམ་"
    },
    {
      "span": {
        "start": 7651,
        "end": 7655
      },
      "text": "ལྡན། ༼སྣར། པེ།༽ བསྟན།"
    },
    {
      "span": {
        "start": 7729,
        "end": 7732
      },
      "text": "ཡི། ༼སྣར། པེ།༽ ཉིད།"
    },
    {
      "span": {
        "start": 7774,
        "end": 7787
      },
      "text": "བདག་ཉིད་ཀྱིས། ༼སྣར། པེ།༽ བདག་ཉིད་ཀྱི།"
    },
    {
      "span": {
        "start": 7910,
        "end": 7918
      },
      "text": "བརྒྱད་པ་ ༼སྣར། པེ།༽ རྒྱས་པ་"
    },
    {
      "span": {
        "start": 8186,
        "end": 8189
      },
      "text": "པོ་ ༼སྣར། པེ།༽ མོ་"
    },
    {
      "span": {
        "start": 8278,
        "end": 8282
      },
      "text": "རྟག་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 8333,
        "end": 8338
      },
      "text": "དག་པ་ ༼སྣར། པེ།༽ དག་པ་དག་པ་"
    },
    {
      "span": {
        "start": 8343,
        "end": 8351
      },
      "text": "ཚངས་པའི་ ༼སྣར། པེ།༽ ཚངས་པ་"
    },
    {
      "span": {
        "start": 8600,
        "end": 8606
      },
      "text": "བྱ་བར་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 9183,
        "end": 9188
      },
      "text": "ན་ལི་ ༼སྣར། པེ།༽ ངན་ལོང་"
    },
    {
      "span": {
        "start": 9272,
        "end": 9277
      },
      "text": "མཆེད་ ༼སྣར། པེ།༽ འཆེད་"
    },
    {
      "span": {
        "start": 9317,
        "end": 9327
      },
      "text": "འཇིབ་བྱེད་ ༼སྣར། པེ།༽ འཇིགས་བྱེད་"
    },
    {
      "span": {
        "start": 9451,
        "end": 9456
      },
      "text": "པ་ཡི། ༼སྣར། པེ།༽ པའི་རྩ།"
    },
    {
      "span": {
        "start": 9673,
        "end": 9678
      },
      "text": "རྟགས་ ༼སྣར། པེ།༽ རྟག་"
    },
    {
      "span": {
        "start": 9854,
        "end": 9857
      },
      "text": "ལྟ། ༼སྣར། པེ།༽ ལྷ།"
    },
    {
      "span": {
        "start": 9889,
        "end": 9892
      },
      "text": "ཞི་ ༼སྣར། པེ།༽ ཞིང་"
    },
    {
      "span": {
        "start": 10037,
        "end": 10041
      },
      "text": "ཀུན་ ༼སྣར། པེ།༽ རྟག་"
    },
    {
      "span": {
        "start": 10245,
        "end": 10259
      },
      "text": "མཆོད་སྦྱིན་ཏེ། ༼སྣར། པེ།༽ མཆོད་སྦྱིན་ཆེ།"
    },
    {
      "span": {
        "start": 10377,
        "end": 10386
      },
      "text": "ཀྱི་རིའུ་ ༼སྣར། པེ།༽ ཀྱི་རུ་"
    },
    {
      "span": {
        "start": 10443,
        "end": 10449
      },
      "text": "གསུངས། ༼སྣར། པེ།༽ གསུངས་པ།"
    },
    {
      "span": {
        "start": 10454,
        "end": 10465
      },
      "text": "བརྒྱད་ཀྱིས་ ༼སྣར། པེ།༽ བརྒྱད་ཀྱི་"
    },
    {
      "span": {
        "start": 10503,
        "end": 10517
      },
      "text": "བཤད་པར་བྱ་སྟེ། ༼སྣར། པེ།༽ བཤད་བྱ།"
    },
    {
      "span": {
        "start": 10541,
        "end": 10548
      },
      "text": "དགོད་པ་ ༼སྣར། པེ།༽ བཀོད་པ་"
    },
    {
      "span": {
        "start": 10559,
        "end": 10566
      },
      "text": "མིག་ཅན་ ༼སྣར། པེ།༽ མིག་མ་"
    },
    {
      "span": {
        "start": 10571,
        "end": 10581
      },
      "text": "བསྲེག་པའི་ ༼སྣར། པེ།༽ བསྲེགས་པའི་"
    },
    {
      "span": {
        "start": 10586,
        "end": 10592
      },
      "text": "ལྟ་བུ་ ༼སྣར། པེ།༽ ལྟ་བུར་"
    },
    {
      "span": {
        "start": 10667,
        "end": 10673
      },
      "text": "ལྷ་མོ་ ༼སྣར། པེ།༽ ལྷ་མོའི་"
    },
    {
      "span": {
        "start": 10941,
        "end": 10948
      },
      "text": "ཆེན་པོ་ ༼སྣར། པེ།༽ ཆེན་མོ་"
    },
    {
      "span": {
        "start": 10974,
        "end": 10980
      },
      "text": "ཞགས་པ་ ༼སྣར། པེ།༽ བཤགས་པ་"
    },
    {
      "span": {
        "start": 11012,
        "end": 11025
      },
      "text": "མཆོད་སྦྱིན་ལ་ ༼སྣར། པེ།༽ མཆོད་སྦྱིན་པ་"
    },
    {
      "span": {
        "start": 11362,
        "end": 11373
      },
      "text": "རོ་ཧི་ཏ་ནི་ ༼སྣར། པེ།༽ རོ་ཧ་ཧ་"
    },
    {
      "span": {
        "start": 11398,
        "end": 11407
      },
      "text": "དང་མོ་ཧི་ ༼སྣར། པེ།༽ དང་པོ་ཧེ་ཏ་"
    },
    {
      "span": {
        "start": 11487,
        "end": 11490
      },
      "text": "རི་ ༼སྣར། པེ།༽ རྀ་"
    },
    {
      "span": {
        "start": 11630,
        "end": 11637
      },
      "text": "གླང་དང་ ༼སྣར། པེ།༽ གླང་"
    },
    {
      "span": {
        "start": 11852,
        "end": 11857
      },
      "text": "སྲིད་ ༼སྣར། པེ།༽ སུཾ་"
    },
    {
      "span": {
        "start": 12013,
        "end": 12022
      },
      "text": "འདོད་པའི་ ༼སྣར། པེ།༽ འདོད་པར་"
    },
    {
      "span": {
        "start": 12097,
        "end": 12099
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 12131,
        "end": 12135
      },
      "text": "གདབ། ༼སྣར། པེ།༽ གདའ།"
    },
    {
      "span": {
        "start": 12178,
        "end": 12184
      },
      "text": "བཞིའི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 12238,
        "end": 12246
      },
      "text": "རྫོགས། །༼སྣར། པེ།༽ ། །རྒྱན་རྣམས་སྦྱིན་པར་བྱས་ནས་ནི། །"
    },
    {
      "span": {
        "start": 12378,
        "end": 12381
      },
      "text": "པར་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 12438,
        "end": 12447
      },
      "text": "བསྐུལ་པས་ ༼སྣར། པེ།༽ བསྐུམ་པས་"
    },
    {
      "span": {
        "start": 12547,
        "end": 12549
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལས།"
    }
  ]
}