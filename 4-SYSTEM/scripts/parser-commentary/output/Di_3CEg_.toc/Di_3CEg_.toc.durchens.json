{
  "durchens": [
    {
      "span": {
        "start": 103,
        "end": 113
      },
      "text": "ཚིག་ལེའུར་ ༼སྣར། པེ།༽ ཚིག་ལེའུ་"
    },
    {
      "span": {
        "start": 200,
        "end": 207
      },
      "text": "བསྒྲུབ། ༼པེ།༽ སྒྲུབ།"
    },
    {
      "span": {
        "start": 392,
        "end": 399
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ བསམ་པ་"
    },
    {
      "span": {
        "start": 665,
        "end": 675
      },
      "text": "སྐྱོན་མེད་ ༼སྣར། པེ།༽ སྐྱོ་མེད་"
    },
    {
      "span": {
        "start": 715,
        "end": 722
      },
      "text": "གནས་པས། ༼པེ།༽ གནས་པ།"
    },
    {
      "span": {
        "start": 1379,
        "end": 1385
      },
      "text": "བྱས་པ་ ༼སྣར། པེ།༽ བྱས་པས་"
    }
  ]
}