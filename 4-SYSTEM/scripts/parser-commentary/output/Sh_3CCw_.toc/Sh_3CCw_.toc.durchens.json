{
  "durchens": [
    {
      "span": {
        "start": 158,
        "end": 163
      },
      "text": "མགོན་ ༼སྣར།༽ མགོན་པོ་"
    },
    {
      "span": {
        "start": 262,
        "end": 269
      },
      "text": "རྙེད་ལ། ༼སྣར། པེ།༽ རྙེད་པ།"
    },
    {
      "span": {
        "start": 511,
        "end": 522
      },
      "text": "བསྟོད་དོ། །༼སྣར། པེ།༽ སྟོན་ཏོ།། །།"
    },
    {
      "span": {
        "start": 956,
        "end": 967
      },
      "text": "འབྲས་བུ་དང་ ༼སྣར།༽ འབྲས་བུ་"
    },
    {
      "span": {
        "start": 1060,
        "end": 1069
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 3317,
        "end": 3323
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 4072,
        "end": 4075
      },
      "text": "སོ་ ༼སྣར། པེ།༽ སོ་སོར་ཚད་མེད་ཅིང་སོ་"
    },
    {
      "span": {
        "start": 4117,
        "end": 4124
      },
      "text": "བྱ་བའི་ ༼པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 5720,
        "end": 5724
      },
      "text": "ཡིན། ༼སྣར།༽ ཡིན་ཏེ་"
    },
    {
      "span": {
        "start": 6031,
        "end": 6037
      },
      "text": "མཉམ་པ་ ༼པེ།༽ མཉན་པ་"
    },
    {
      "span": {
        "start": 6234,
        "end": 6242
      },
      "text": "དེ་བས་ན་ ༼སྣར། པེ།༽ དེ་ལྟ་བས་ན་"
    },
    {
      "span": {
        "start": 7321,
        "end": 7329
      },
      "text": "མཆོག་གི་ ༼སྣར། པེ།༽ མཆོག་"
    },
    {
      "span": {
        "start": 8367,
        "end": 8375
      },
      "text": "འདས་ཀྱི་ ༼སྣར། པེ།༽ འདས་ཀྱིས་"
    },
    {
      "span": {
        "start": 8545,
        "end": 8553
      },
      "text": "ཡོད་པའི་ ༼སྣར། པེ།༽ ཡོད་པ་"
    },
    {
      "span": {
        "start": 9642,
        "end": 9646
      },
      "text": "པའི། ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 9755,
        "end": 9758
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་ཇི་"
    },
    {
      "span": {
        "start": 9764,
        "end": 9774
      },
      "text": "ཞིག་ཅི་ཞེ་ ༼སྣར། པེ།༽ ཞིག་ཅེ་"
    },
    {
      "span": {
        "start": 9837,
        "end": 9842
      },
      "text": "ཆད་པ་ ༼སྣར། པེ།༽ ཆད་"
    },
    {
      "span": {
        "start": 10189,
        "end": 10198
      },
      "text": "དུས་ཀྱིས་ ༼སྣར། པེ།༽ དུས་ཀྱི་"
    },
    {
      "span": {
        "start": 10277,
        "end": 10281
      },
      "text": "ཡུལ་ ༼སྣར། པེ།༽ ཡུལ་ནི་ཡུལ་"
    },
    {
      "span": {
        "start": 10771,
        "end": 10779
      },
      "text": "ནི་མཇུག་ ༼སྣར། པེ།༽ ཀྱི་འཇུག་"
    },
    {
      "span": {
        "start": 11165,
        "end": 11174
      },
      "text": "ཀྱིས་འཕན་ ༼སྣར། པེ།༽ ཀྱི་འཕེན་"
    },
    {
      "span": {
        "start": 11234,
        "end": 11243
      },
      "text": "བཏགས་པའམ། ༼སྣར། པེ།༽ བཏགས་པའང་།"
    },
    {
      "span": {
        "start": 11336,
        "end": 11339
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 11534,
        "end": 11537
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་ན་"
    },
    {
      "span": {
        "start": 11565,
        "end": 11569
      },
      "text": "ལོག་ ༼པེ།༽ ལོགས་"
    },
    {
      "span": {
        "start": 11753,
        "end": 11757
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 11892,
        "end": 11896
      },
      "text": "ཡུལ་ ༼སྣར།༽ ཡུམ་"
    },
    {
      "span": {
        "start": 12097,
        "end": 12103
      },
      "text": "གླན་ཀ་ ༼སྣར། པེ།༽ ཀླན་ཀ་"
    },
    {
      "span": {
        "start": 12392,
        "end": 12396
      },
      "text": "འཆད་ ༼སྣར།༽ ཆད་"
    },
    {
      "span": {
        "start": 13099,
        "end": 13104
      },
      "text": "ཚོགས་ ༼སྣར། པེ།༽ ཚོགས་དཔག་ཏུ་"
    },
    {
      "span": {
        "start": 13229,
        "end": 13239
      },
      "text": "མི་དཔོག་པ་ ༼སྣར། པེ།༽ མི་དཔོགས་"
    },
    {
      "span": {
        "start": 13328,
        "end": 13333
      },
      "text": "བྱ་བ་ ༼སྣར།༽ བྱ་པར་ ༼པེ།༽ བར་"
    },
    {
      "span": {
        "start": 13365,
        "end": 13372
      },
      "text": "འཆད་པར་ ༼སྣར། པེ།༽ ཆད་པར་"
    },
    {
      "span": {
        "start": 13863,
        "end": 13866
      },
      "text": "ཆད་ ༼སྣར། པེ།༽ འཆད་"
    },
    {
      "span": {
        "start": 14030,
        "end": 14038
      },
      "text": "བཞིན་ནི་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 14121,
        "end": 14126
      },
      "text": "ནི་ཡ་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 14297,
        "end": 14312
      },
      "text": "མངོན་པར་ཞེན་པར་ ༼སྣར། པེ།༽ མངོན་པར་"
    },
    {
      "span": {
        "start": 14369,
        "end": 14373
      },
      "text": "སྨྲ་ ༼སྣར། པེ།༽ སྨྲ་བ་"
    },
    {
      "span": {
        "start": 14383,
        "end": 14390
      },
      "text": "རྒྱུའི་ ༼སྣར། པེ།༽ རྒྱུས་"
    },
    {
      "span": {
        "start": 15692,
        "end": 15696
      },
      "text": "འཕང་ ༼སྣར།༽ འཕངས་"
    },
    {
      "span": {
        "start": 15699,
        "end": 15709
      },
      "text": "བསྒྲུབས་པ་ ༼སྣར།༽ སྒྲུབས་པ་"
    },
    {
      "span": {
        "start": 15780,
        "end": 15789
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 15887,
        "end": 15894
      },
      "text": "མཛད་དེ་ ༼སྣར། པེ།༽ མཛད་དོ་"
    },
    {
      "span": {
        "start": 15940,
        "end": 15949
      },
      "text": "འགྲུབ་པར་ ༼སྣར། པེ།༽ གྲུབ་པར་"
    },
    {
      "span": {
        "start": 16025,
        "end": 16033
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 16045,
        "end": 16053
      },
      "text": "ནི་དམ་པ་ ༼སྣར། པེ།༽ ནི་དམ་"
    },
    {
      "span": {
        "start": 16782,
        "end": 16789
      },
      "text": "བདེ་བར་ ༼སྣར། པེ།༽ བདེ་"
    },
    {
      "span": {
        "start": 17026,
        "end": 17031
      },
      "text": "བ་ནི། ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 17297,
        "end": 17301
      },
      "text": "ཚིག་ ༼པེ།༽ ཚིགས་"
    },
    {
      "span": {
        "start": 17360,
        "end": 17365
      },
      "text": "གཏོང་ ༼སྣར། པེ།༽ གཏང་"
    },
    {
      "span": {
        "start": 17390,
        "end": 17397
      },
      "text": "བརྟན་པ་ ༼སྣར། པེ།༽ བསྟེན་པ་"
    },
    {
      "span": {
        "start": 17467,
        "end": 17487
      },
      "text": "ལས་བྱར་རུང་བ་ཉིད་དུ། ༼སྣར། པེ།༽ ལས།"
    },
    {
      "span": {
        "start": 18125,
        "end": 18135
      },
      "text": "ལྟ་བུ་ཡིས་ ༼སྣར། པེ།༽ ལྟ་བུའི་"
    }
  ]
}