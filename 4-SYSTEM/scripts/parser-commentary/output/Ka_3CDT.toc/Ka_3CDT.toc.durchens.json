{
  "durchens": [
    {
      "span": {
        "start": 1359,
        "end": 1367
      },
      "text": "ཡོངས་སུ་ ༼སྣར།༽ ཡོངས་"
    },
    {
      "span": {
        "start": 1406,
        "end": 1412
      },
      "text": "ཡོད་པ་ ༼སྣར།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 1467,
        "end": 1480
      },
      "text": "དགེ་སྦྱོང་གི་ ༼སྣར། པེ།༽ དགེ་སྦྱོང་གིས་"
    },
    {
      "span": {
        "start": 2149,
        "end": 2159
      },
      "text": "འབྱུང་བ་ལ་ ༼སྣར། པེ།༽ འབྱུང་བར་"
    },
    {
      "span": {
        "start": 2393,
        "end": 2400
      },
      "text": "སྤང་བར་ ༼སྣར། པེ།༽ སྤོང་བར་"
    },
    {
      "span": {
        "start": 2431,
        "end": 2438
      },
      "text": "དགོས་པ་ ༼སྣར།༽ དགོས་པའོ་དགོས་པ་"
    },
    {
      "span": {
        "start": 2452,
        "end": 2457
      },
      "text": "ཉན་པ་ ༼སྣར།༽ གཉན་པ་"
    },
    {
      "span": {
        "start": 2551,
        "end": 2559
      },
      "text": "འདུས་པས་ ༼སྣར།༽ འདུས་པ་"
    },
    {
      "span": {
        "start": 2712,
        "end": 2715
      },
      "text": "ནི། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 2792,
        "end": 2800
      },
      "text": "སྟོན་ཏེ། ༼སྣར། པེ།༽ སྟོན་ཏོ།"
    },
    {
      "span": {
        "start": 2947,
        "end": 2952
      },
      "text": "ཀྱིས་ ༼སྣར། པེ།༽ ཀྱི་ཐོས་ཀྱི་"
    },
    {
      "span": {
        "start": 3649,
        "end": 3658
      },
      "text": "གྲོང་ཆེར་ ༼སྣར། པེ།༽ གྲོང་ཁྱེར་"
    },
    {
      "span": {
        "start": 3747,
        "end": 3754
      },
      "text": "འཚེ་བས་ ༼སྣར།༽ འཆེར་བ་"
    },
    {
      "span": {
        "start": 3994,
        "end": 4000
      },
      "text": "ཁབ་ནི་ ༼སྣར། པེ།༽ ཁབ་"
    },
    {
      "span": {
        "start": 4156,
        "end": 4164
      },
      "text": "བྱ་རྒོད་ ༼སྣར། པེ།༽ བྱ་རྒོད་ཀྱི་"
    },
    {
      "span": {
        "start": 4396,
        "end": 4399
      },
      "text": "ཏེ། ༼སྣར།༽ ཏོ།"
    },
    {
      "span": {
        "start": 4450,
        "end": 4457
      },
      "text": "ཅན་གྱི་ ༼པེ།༽ ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 4492,
        "end": 4500
      },
      "text": "བརྟན་པས་ ༼སྣར། པེ།༽ བསྟན་པས་"
    },
    {
      "span": {
        "start": 5143,
        "end": 5148
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བར་"
    },
    {
      "span": {
        "start": 5253,
        "end": 5264
      },
      "text": "དེ་ནས་དེའི་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 5324,
        "end": 5332
      },
      "text": "བསྒོམ་པ་ ༼སྣར། པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 5458,
        "end": 5462
      },
      "text": "ཞབས་ ༼སྣར། པེ།༽ ཞ་"
    },
    {
      "span": {
        "start": 5547,
        "end": 5559
      },
      "text": "དགེ་འདུན་ལས་ ༼སྣར། པེ།༽ དགེ་འདུན་པས་"
    },
    {
      "span": {
        "start": 5579,
        "end": 5585
      },
      "text": "མོང་བ་ ༼སྣར། པེ།༽ མང་བ་"
    },
    {
      "span": {
        "start": 6061,
        "end": 6072
      },
      "text": "བྱང་ཆུབ་ཏུ་ ༼པེ།༽ བྱང་ཆུབ་"
    },
    {
      "span": {
        "start": 6213,
        "end": 6223
      },
      "text": "བསྐྱེད་པར་ ༼སྣར། པེ།༽ སྐྱེད་པར་"
    },
    {
      "span": {
        "start": 6697,
        "end": 6707
      },
      "text": "ཚེ་གང་ཞིག་ ༼སྣར། པེ།༽ ཚེ་གང་ཞིག་གང་"
    },
    {
      "span": {
        "start": 6709,
        "end": 6715
      },
      "text": "གང་དང་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 6750,
        "end": 6754
      },
      "text": "གཞི་ ༼སྣར།༽ བཞི་"
    },
    {
      "span": {
        "start": 6764,
        "end": 6766
      },
      "text": "ད་ ༼སྣར། པེ།༽ །། །།དེ་"
    },
    {
      "span": {
        "start": 7109,
        "end": 7120
      },
      "text": "ཀུན་དགའ་བར་ ༼སྣར། པེ།༽ ཀུན་དགའ་བོ་"
    },
    {
      "span": {
        "start": 7378,
        "end": 7385
      },
      "text": "འདུས་ན་ ༼སྣར། པེ།༽ འདུས་ནས་"
    },
    {
      "span": {
        "start": 7951,
        "end": 7958
      },
      "text": "ལ་ལྟོས་ ༼སྣར། པེ།༽ ལས་བལྟོས་"
    },
    {
      "span": {
        "start": 8049,
        "end": 8056
      },
      "text": "བཤད་དོ། ༼སྣར།༽ བཤད།"
    },
    {
      "span": {
        "start": 8173,
        "end": 8181
      },
      "text": "རྟགས་དེ་ ༼སྣར། པེ།༽ བརྟགས་ཏེ་"
    },
    {
      "span": {
        "start": 8252,
        "end": 8262
      },
      "text": "དེ་དག་གིས་ ༼སྣར། པེ།༽ དེ་དག་གི་"
    },
    {
      "span": {
        "start": 8624,
        "end": 8634
      },
      "text": "གཉེན་པོ་ལ་ ༼སྣར། པེ།༽ གཉེན་པོ་"
    },
    {
      "span": {
        "start": 9108,
        "end": 9116
      },
      "text": "གསུངས་པ། ༼སྣར། པེ།༽ གསུངས་"
    },
    {
      "span": {
        "start": 9293,
        "end": 9302
      },
      "text": "འགྱུར་རོ། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 9529,
        "end": 9532
      },
      "text": "ཚད་ ༼སྣར། པེ།༽ ཚེ་"
    },
    {
      "span": {
        "start": 9672,
        "end": 9677
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 9692,
        "end": 9701
      },
      "text": "ཡིན་པས་ན་ ༼སྣར། པེ།༽ ཡིན་པས་"
    },
    {
      "span": {
        "start": 10024,
        "end": 10032
      },
      "text": "དགོངས་པ་ ༼པེ།༽ གདོངས་པ་"
    },
    {
      "span": {
        "start": 11141,
        "end": 11147
      },
      "text": "དགག་པ་ ༼པེ།༽ དག་པ་"
    },
    {
      "span": {
        "start": 11310,
        "end": 11314
      },
      "text": "རིག་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 11610,
        "end": 11618
      },
      "text": "བྲལ་བའི་ ༼སྣར། པེ།༽ དབྲལ་བའི་"
    },
    {
      "span": {
        "start": 11618,
        "end": 11631
      },
      "text": "ཕྱིར་ལུགས་སུ་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 11871,
        "end": 11880
      },
      "text": "འཕགས་པའི་ ༼སྣར།༽ འཕངས་པའི་"
    },
    {
      "span": {
        "start": 11974,
        "end": 11984
      },
      "text": "སྒྲུབ་པའི་ ༼སྣར།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 12087,
        "end": 12097
      },
      "text": "སྒྲུབ་པའི་ ༼སྣར། པེ།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 12684,
        "end": 12687
      },
      "text": "དུ་ ༼པེ།༽ དུ་རྣམས་"
    },
    {
      "span": {
        "start": 12949,
        "end": 12955
      },
      "text": "རིག་པ་ ༼པེ།༽ རིམ་པ་"
    },
    {
      "span": {
        "start": 13146,
        "end": 13152
      },
      "text": "རིག་པ་ ༼སྣར། པེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 13212,
        "end": 13230
      },
      "text": "བྱེད་པ་ལ་སོགས་པ་ལ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 13271,
        "end": 13290
      },
      "text": "གསུངས་ཀྱི་དངོས་ཀྱི་ ༼པེ།༽ གསུངས་ཀྱི་"
    },
    {
      "span": {
        "start": 13586,
        "end": 13590
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིར་"
    },
    {
      "span": {
        "start": 13725,
        "end": 13737
      },
      "text": "མང་དུ་བརྗོད་ ༼སྣར། པེ།༽ མང་དུ་"
    },
    {
      "span": {
        "start": 14072,
        "end": 14077
      },
      "text": "བུའི་ ༼སྣར། པེ།༽ བུ་"
    },
    {
      "span": {
        "start": 14460,
        "end": 14468
      },
      "text": "དེ་བཞིན་ ༼སྣར། པེ།༽ དེ་བཞིན་ཉིད་"
    },
    {
      "span": {
        "start": 15019,
        "end": 15022
      },
      "text": "ལས་ ༼པེ།༽ ལམ་"
    },
    {
      "span": {
        "start": 15055,
        "end": 15066
      },
      "text": "གཞོགས་སློང་ ༼སྣར། པེ།༽ གཞོག་སློངས་"
    },
    {
      "span": {
        "start": 15261,
        "end": 15269
      },
      "text": "བརྗེད་པ་ ༼སྣར། པེ།༽ བརྗོད་པ་"
    },
    {
      "span": {
        "start": 15470,
        "end": 15479
      },
      "text": "འཕགས་པའི་ ༼སྣར། པེ།༽ འཕགས་"
    },
    {
      "span": {
        "start": 15772,
        "end": 15780
      },
      "text": "འབྲས་བུ་ ༼སྣར། པེ།༽ འབྲས་བུར་"
    },
    {
      "span": {
        "start": 16529,
        "end": 16533
      },
      "text": "མཐའ་ ༼སྣར།༽ མཐས་"
    },
    {
      "span": {
        "start": 16691,
        "end": 16697
      },
      "text": "ངག་དང་ ༼པེ།༽ གང་དང་"
    },
    {
      "span": {
        "start": 16953,
        "end": 16961
      },
      "text": "རྟོག་པས། ༼པེ།༽ རྟོགས་པ།"
    },
    {
      "span": {
        "start": 17172,
        "end": 17174
      },
      "text": "ད་ ༼སྣར།༽ དེ་"
    },
    {
      "span": {
        "start": 17323,
        "end": 17329
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 17815,
        "end": 17825
      },
      "text": "གཟིགས་ཀྱི་ ༼སྣར།༽ གཟིགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 17896,
        "end": 17903
      },
      "text": "ཐམས་ཅད་ ༼སྣར། པེ།༽ ཐམས་ཅད་དུ་"
    },
    {
      "span": {
        "start": 18147,
        "end": 18152
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བར་"
    },
    {
      "span": {
        "start": 18876,
        "end": 18888
      },
      "text": "ཁོ་ན་བསྒོམས་ ༼སྣར། པེ།༽ ཁོ་ནར་བསྒོམ་"
    },
    {
      "span": {
        "start": 19174,
        "end": 19176
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 19573,
        "end": 19577
      },
      "text": "འདི་ ༼སྣར། པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 19623,
        "end": 19628
      },
      "text": "བརྟག་ ༼སྣར། པེ།༽ རྟག་"
    },
    {
      "span": {
        "start": 19642,
        "end": 19651
      },
      "text": "དུས་གསུམ་ ༼སྣར། པེ།༽ དུས་གསུམ་དུ་"
    },
    {
      "span": {
        "start": 19751,
        "end": 19762
      },
      "text": "སྲོག་མེད་པ་ ༼སྣར། པེ།༽ སྲོག་མེད་པས་"
    },
    {
      "span": {
        "start": 20570,
        "end": 20576
      },
      "text": "རྟག་པ་ ༼སྣར། པེ།༽ བརྟག་པ་"
    },
    {
      "span": {
        "start": 21296,
        "end": 21303
      },
      "text": "བྱས་པས་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 21943,
        "end": 21950
      },
      "text": "ཐོགས་པ་ ༼སྣར།༽ ཐོབ་པ་"
    },
    {
      "span": {
        "start": 22066,
        "end": 22075
      },
      "text": "གཤེགས་དང་ ༼སྣར། པེ།༽ གཤེགས་པ་"
    },
    {
      "span": {
        "start": 22260,
        "end": 22267
      },
      "text": "གཟུང་བ་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 22405,
        "end": 22413
      },
      "text": "མེད་ཀྱང་ ༼སྣར། པེ།༽ མེད་ཅིང་"
    },
    {
      "span": {
        "start": 22638,
        "end": 22647
      },
      "text": "གསུངས་ཏེ། ༼སྣར། པེ།༽ གསུངས་སྟེ།"
    },
    {
      "span": {
        "start": 22666,
        "end": 22673
      },
      "text": "བསྒོམས་ ༼སྣར། པེ།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 22717,
        "end": 22720
      },
      "text": "ནི་ ༼སྣར།༽ བཞིན་"
    },
    {
      "span": {
        "start": 22839,
        "end": 22849
      },
      "text": "འགྱུར་གྱི་ ༼སྣར། པེ།༽ འགྱུར་གྱིས་"
    },
    {
      "span": {
        "start": 22899,
        "end": 22905
      },
      "text": "སྒོམས་ ༼སྣར། པེ།༽ བསྒོམས་"
    },
    {
      "span": {
        "start": 23109,
        "end": 23117
      },
      "text": "མེད་ཅིང་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 23369,
        "end": 23379
      },
      "text": "འགྱུར་གྱི། ༼སྣར། པེ།༽ འགྱུར་གྱིས།"
    },
    {
      "span": {
        "start": 23513,
        "end": 23523
      },
      "text": "འགྱུར་གྱི། ༼སྣར། པེ།༽ འགྱུར་གྱིས་"
    },
    {
      "span": {
        "start": 23666,
        "end": 23675
      },
      "text": "བསྒོམ་པས་ ༼སྣར། པེ།༽ བསྒོམས་པས་"
    },
    {
      "span": {
        "start": 23906,
        "end": 23916
      },
      "text": "ལ་སུས་ཀྱང་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 24094,
        "end": 24103
      },
      "text": "གཉེན་པོས་ ༼པེ།༽ གཉེན་"
    },
    {
      "span": {
        "start": 24402,
        "end": 24405
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 24595,
        "end": 24600
      },
      "text": "ལྟ་བ་ ༼སྣར། པེ།༽ བལྟ་བ་"
    },
    {
      "span": {
        "start": 24638,
        "end": 24645
      },
      "text": "གསལ་བར་ ༼སྣར། པེ།༽ བསལ་བར་"
    },
    {
      "span": {
        "start": 24768,
        "end": 24791
      },
      "text": "དུ་ཉོན་མོངས་པ་ཡང་ཉེ་བར་ ༼སྣར། པེ།༽ ཉོན་མོངས་པ་"
    },
    {
      "span": {
        "start": 24847,
        "end": 24852
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 25683,
        "end": 25691
      },
      "text": "སྙམ་པ་ལ་ ༼སྣར།༽ སྙམ་པའི་"
    },
    {
      "span": {
        "start": 25895,
        "end": 25904
      },
      "text": "འཕགས་པའི་ ༼སྣར། པེ།༽ འཕགས་པའི་ཆོས་ཁོང་དུ་ཆུད་པ་དེ་ནི་འཕགས་པའི་"
    },
    {
      "span": {
        "start": 26507,
        "end": 26515
      },
      "text": "འདས་ཀྱི་ ༼སྣར། པེ།༽ འདས་ཀྱིས་"
    },
    {
      "span": {
        "start": 26766,
        "end": 26771
      },
      "text": "ཕྱིར་ ༼སྣར། པེ།༽ ཕྱིར་ཅིའི་ཕྱིར་"
    },
    {
      "span": {
        "start": 26801,
        "end": 26813
      },
      "text": "བྱ་ཞེས་བྱ་བ་ ༼སྣར། པེ།༽ བྱ་ཞེས་"
    },
    {
      "span": {
        "start": 27120,
        "end": 27127
      },
      "text": "ཉིད་དེ། ༼པེ།༽ ཉིད་དོ་"
    },
    {
      "span": {
        "start": 27675,
        "end": 27680
      },
      "text": "འདིས་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 27732,
        "end": 27737
      },
      "text": "བསྩལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 28112,
        "end": 28117
      },
      "text": "སྒྲར་ ༼སྣར།༽ སྒྲལ་"
    },
    {
      "span": {
        "start": 28613,
        "end": 28622
      },
      "text": "ཁོ་ན་སྟེ། ༼སྣར། པེ།༽ ཁོ་ན་ཏེ།"
    },
    {
      "span": {
        "start": 28644,
        "end": 28651
      },
      "text": "ལྟོས་པ་ ༼སྣར། པེ།༽ བལྟོས་པ་"
    },
    {
      "span": {
        "start": 28806,
        "end": 28813
      },
      "text": "ལྟོས་པ་ ༼སྣར། པེ།༽ བལྟོས་པ་"
    },
    {
      "span": {
        "start": 28967,
        "end": 28980
      },
      "text": "ཉིད་ཅེས་བྱ་བ་ ༼སྣར། པེ།༽ ཉིད་ཅེས་པ་"
    },
    {
      "span": {
        "start": 29102,
        "end": 29119
      },
      "text": "འབྲེལ་བར་འབྱུང་བ་ ༼སྣར། པེ།༽ འབྲེལ་པ་"
    },
    {
      "span": {
        "start": 29971,
        "end": 29977
      },
      "text": "རྐྱེན་ ༼སྣར།༽ སྐྱེན་"
    },
    {
      "span": {
        "start": 30025,
        "end": 30031
      },
      "text": "བྱས་པ་ ༼སྣར། པེ།༽ བྱིས་པ་"
    },
    {
      "span": {
        "start": 30896,
        "end": 30901
      },
      "text": "བསྩལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 30954,
        "end": 30964
      },
      "text": "བསྒྲུབ་པོ་ ༼སྣར། པེ།༽ སྒྲུབ་པོ་"
    },
    {
      "span": {
        "start": 31164,
        "end": 31173
      },
      "text": "འགྱུར་ཏེ། ༼པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 31329,
        "end": 31336
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 31495,
        "end": 31505
      },
      "text": "མི་བསྐྱེད། ༼སྣར། པེ།༽ མི་སྐྱེད་"
    },
    {
      "span": {
        "start": 31552,
        "end": 31558
      },
      "text": "ཐུག་པ་ ༼སྣར།༽ ཐུགས་པ་"
    },
    {
      "span": {
        "start": 31576,
        "end": 31584
      },
      "text": "དེ་བས་ན་ ༼སྣར། པེ།༽ དེ་བས་"
    },
    {
      "span": {
        "start": 31602,
        "end": 31609
      },
      "text": "མེད་དོ་ ༼སྣར།༽ མེད་"
    },
    {
      "span": {
        "start": 31627,
        "end": 31635
      },
      "text": "འདས་ཀྱི་ ༼སྣར། པེ།༽ འདས་ཀྱིས་"
    },
    {
      "span": {
        "start": 31702,
        "end": 31707
      },
      "text": "བསྩལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 31843,
        "end": 31848
      },
      "text": "སྟོན་ ༼སྣར།༽ སྟན་"
    },
    {
      "span": {
        "start": 32063,
        "end": 32069
      },
      "text": "ནང་དུ་ ༼སྣར། པེ།༽ ནང་"
    },
    {
      "span": {
        "start": 32133,
        "end": 32139
      },
      "text": "བལྟའོ། ༼སྣར། པེ།༽ ལྟའོ།"
    },
    {
      "span": {
        "start": 32425,
        "end": 32431
      },
      "text": "བལྟ་བ་ ༼སྣར། པེ།༽ ལྟ་བ་"
    },
    {
      "span": {
        "start": 32431,
        "end": 32436
      },
      "text": "བསྩལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 32455,
        "end": 32464
      },
      "text": "བསྩལ་བའི་ ༼སྣར། པེ།༽ བསལ་བའི་"
    },
    {
      "span": {
        "start": 32684,
        "end": 32693
      },
      "text": "གཞན་གྱིས་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 32839,
        "end": 32849
      },
      "text": "གཉིས་ཀས་མ་ ༼སྣར། པེ།༽ གཉིས་ཀས་"
    },
    {
      "span": {
        "start": 33023,
        "end": 33032
      },
      "text": "འབྱུང་བས་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 33075,
        "end": 33081
      },
      "text": "རྟག་པ་ ༼སྣར།༽ བརྟག་པ་"
    },
    {
      "span": {
        "start": 33090,
        "end": 33097
      },
      "text": "སྡོད་པ་ ༼སྣར།༽ སྡང་པ་"
    },
    {
      "span": {
        "start": 33466,
        "end": 33473
      },
      "text": "ལྟོས་པ་ ༼སྣར། པེ།༽ བལྟོས་པ་"
    },
    {
      "span": {
        "start": 34089,
        "end": 34096
      },
      "text": "འཕོ་བར་ ༼སྣར། པེ།༽ འཕྲོ་བར་"
    },
    {
      "span": {
        "start": 34177,
        "end": 34182
      },
      "text": "བསྩལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 35488,
        "end": 35494
      },
      "text": "ནང་གི་ ༼སྣར། པེ།༽ ནང་ནི་"
    },
    {
      "span": {
        "start": 35569,
        "end": 35579
      },
      "text": "གཟུགས་ཀྱི་ ༼སྣར། པེ།༽ གཟུགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 35639,
        "end": 35653
      },
      "text": "བྱ་བར་སྦྱར་རོ། ༼སྣར།༽ བྱ་བ་སྦྱ ༼པེ།༽ བྱ་བ་སྦྱར་རོ།"
    },
    {
      "span": {
        "start": 35681,
        "end": 35685
      },
      "text": "ལྔར་ ༼སྣར།༽ ལྔས་"
    },
    {
      "span": {
        "start": 36003,
        "end": 36015
      },
      "text": "སྔོན་མ་གྲུབ་ ༼སྣར། པེ།༽ མངོན་པར་འགྲུབ་"
    },
    {
      "span": {
        "start": 37090,
        "end": 37097
      },
      "text": "ཤེས་པར་ ༼སྣར། པེ།༽ ཤེས་"
    },
    {
      "span": {
        "start": 37167,
        "end": 37171
      },
      "text": "ལ་མ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 37677,
        "end": 37686
      },
      "text": "བརྟེན་པར་ ༼སྣར། པེ།༽ བརྟན་པར་"
    },
    {
      "span": {
        "start": 37700,
        "end": 37708
      },
      "text": "བྱུང་ནས་ ༼སྣར། པེ།༽ བྱུང་ན་"
    },
    {
      "span": {
        "start": 37722,
        "end": 37725
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 38234,
        "end": 38245
      },
      "text": "བསྐྱེད་པའི་ ༼སྣར།༽ བསྐྱོད་པའི་"
    },
    {
      "span": {
        "start": 39073,
        "end": 39079
      },
      "text": "ཚོར་བ་ ༼སྣར།༽ ཚོལ་བ་"
    },
    {
      "span": {
        "start": 39142,
        "end": 39152
      },
      "text": "སོང་བ་སྟེ། ༼སྣར།༽ སོང་བ་སྟ་བ།"
    },
    {
      "span": {
        "start": 39589,
        "end": 39592
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 39766,
        "end": 39780
      },
      "text": "མངོན་པར་ཞེན་པ་ ༼སྣར།༽ མངོན་པར་ཞེས་"
    },
    {
      "span": {
        "start": 39803,
        "end": 39814
      },
      "text": "བསྐྱེད་པའི་ ༼སྣར། པེ།༽ སྐྱེད་པའི་"
    },
    {
      "span": {
        "start": 39836,
        "end": 39844
      },
      "text": "སྐྱེས་པ་ ༼སྣར།༽ སྐྱ་པ་ ༼པེ།༽ སྐྱེ་པ་"
    },
    {
      "span": {
        "start": 39891,
        "end": 39894
      },
      "text": "སླ་ ༼སྣར།༽ སྨ་"
    },
    {
      "span": {
        "start": 39980,
        "end": 39991
      },
      "text": "དང་པོ་བསྟན་ ༼པེ།༽ དང་པོས་སྟན་"
    },
    {
      "span": {
        "start": 40216,
        "end": 40221
      },
      "text": "ཕྱིན་ ༼སྣར།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 40224,
        "end": 40231
      },
      "text": "ལོག་གི་ ༼སྣར།༽ ལག་བི་"
    },
    {
      "span": {
        "start": 40313,
        "end": 40321
      },
      "text": "བསྟན་ཏོ། ༼སྣར།༽ བསྟན་ཏེ།"
    },
    {
      "span": {
        "start": 41882,
        "end": 41890
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ དངོས་པོས་"
    },
    {
      "span": {
        "start": 42233,
        "end": 42240
      },
      "text": "གཡོ་བར་ ༼སྣར། པེ།༽ གཡོ་བ་"
    },
    {
      "span": {
        "start": 42390,
        "end": 42394
      },
      "text": "གཞན་ ༼སྣར།༽ གཞེན་"
    },
    {
      "span": {
        "start": 42723,
        "end": 42729
      },
      "text": "འགྱུར། ༼སྣར། པེ།༽ གྱུར།"
    },
    {
      "span": {
        "start": 42927,
        "end": 42942
      },
      "text": "འདུ་བྱེད་རྣམ་པ་ ༼སྣར། པེ།༽ འདུ་བྱེད་རྣམས་"
    },
    {
      "span": {
        "start": 43117,
        "end": 43121
      },
      "text": "ཞེས་ ༼སྣར། པེ།༽ ཞེས་བྱའོ་ཞེས་"
    },
    {
      "span": {
        "start": 44134,
        "end": 44139
      },
      "text": "མཆོག་ ༼སྣར། པེ།༽ མཆོག་ཏུ་"
    },
    {
      "span": {
        "start": 44145,
        "end": 44152
      },
      "text": "དབྱེ་བ་ ༼སྣར།༽ དབྱེའི་"
    },
    {
      "span": {
        "start": 44458,
        "end": 44465
      },
      "text": "སྡུག་པ་ ༼པེ།༽ དྲུག་པ་"
    },
    {
      "span": {
        "start": 44564,
        "end": 44567
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 44617,
        "end": 44624
      },
      "text": "སྲིད་པ་ ༼སྣར། པེ།༽ སྲེད་པ་"
    },
    {
      "span": {
        "start": 44960,
        "end": 44967
      },
      "text": "བྱུང་བ་ ༼སྣར།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 45114,
        "end": 45119
      },
      "text": "བསྩལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 45298,
        "end": 45303
      },
      "text": "བསྩལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 45720,
        "end": 45729
      },
      "text": "ལྟོས་པའི་ ༼སྣར། པེ།༽ བལྟོས་པའི་"
    },
    {
      "span": {
        "start": 46017,
        "end": 46022
      },
      "text": "བྱ་བ་ ༼པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 46302,
        "end": 46309
      },
      "text": "དུས་ནས་ ༼སྣར། པེ།༽ དུས་"
    },
    {
      "span": {
        "start": 46471,
        "end": 46481
      },
      "text": "དེ་དག་གིས་ ༼སྣར།༽ དེ་དག་གི་"
    },
    {
      "span": {
        "start": 46671,
        "end": 46674
      },
      "text": "གང་ ༼སྣར།༽ གོང་"
    },
    {
      "span": {
        "start": 46818,
        "end": 46827
      },
      "text": "འགྲུབ་པར་ ༼སྣར།༽ འགྲུབ་པ་"
    },
    {
      "span": {
        "start": 47391,
        "end": 47401
      },
      "text": "ནི་ལས་ཀྱི་ ༼སྣར། པེ།༽ ནི་ལས་ཀྱིས་"
    },
    {
      "span": {
        "start": 47430,
        "end": 47435
      },
      "text": "འདུས་ ༼སྣར། པེ།༽ འདུ་"
    },
    {
      "span": {
        "start": 47557,
        "end": 47564
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 47856,
        "end": 47863
      },
      "text": "རླན་པར་ ༼སྣར། པེ།༽ བརླན་པར་"
    },
    {
      "span": {
        "start": 48218,
        "end": 48221
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 48241,
        "end": 48243
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 48595,
        "end": 48600
      },
      "text": "གྱིས་ ༼སྣར། པེ།༽ གྱིས་མ་"
    },
    {
      "span": {
        "start": 49529,
        "end": 49538
      },
      "text": "སྐྱེས་ནས་ ༼སྣར། པེ།༽ སྐྱེས་ན་"
    },
    {
      "span": {
        "start": 50284,
        "end": 50294
      },
      "text": "ལ་སོགས་པར་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 50425,
        "end": 50439
      },
      "text": "དུས་མཉམ་དུ་བར་ ༼སྣར། པེ།༽ དུས་མཉམ་དུ་"
    },
    {
      "span": {
        "start": 50513,
        "end": 50517
      },
      "text": "དཔེ་ ༼སྣར། པེ།༽ དཔེས་"
    },
    {
      "span": {
        "start": 50535,
        "end": 50541
      },
      "text": "ཐོག་མ་ ༼སྣར།༽ མཐོ་དམན་"
    },
    {
      "span": {
        "start": 50732,
        "end": 50737
      },
      "text": "སྤངས་ ༼སྣར། པེ།༽ སྤང་"
    },
    {
      "span": {
        "start": 50780,
        "end": 50790
      },
      "text": "དོན་དམ་པར་ ༼སྣར། པེ།༽ དོན་དམ་"
    },
    {
      "span": {
        "start": 50949,
        "end": 50957
      },
      "text": "ཕྱིར་རོ། ༼སྣར།༽ ཕྱིར།"
    },
    {
      "span": {
        "start": 51189,
        "end": 51198
      },
      "text": "སྐྱེ་བའོ། ༼སྣར། པེ།༽ སྐྱེའོ།"
    },
    {
      "span": {
        "start": 51294,
        "end": 51302
      },
      "text": "ལས་ཀྱིས་ ༼སྣར། པེ།༽ ལས་ཀྱི་"
    },
    {
      "span": {
        "start": 51953,
        "end": 51956
      },
      "text": "བུ་ ༼སྣར།༽ ལྟི་བུར་ ༼པེ།༽ ཇི་ལྟ་བུར་"
    },
    {
      "span": {
        "start": 51981,
        "end": 51987
      },
      "text": "དེ་ལྟ་ ༼སྣར།༽ ད་ལྟ་"
    },
    {
      "span": {
        "start": 53669,
        "end": 53672
      },
      "text": "དང་ ༼སྣར།༽ དར་"
    },
    {
      "span": {
        "start": 53701,
        "end": 53708
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 54495,
        "end": 54502
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 55079,
        "end": 55082
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 55147,
        "end": 55151
      },
      "text": "ལྡན་ ༼སྣར། པེ།༽ ལྡན་པ་"
    },
    {
      "span": {
        "start": 55326,
        "end": 55332
      },
      "text": "གི་ཝང་ ༼སྣར། པེ།༽ འགིའུ་ཝཾ་"
    },
    {
      "span": {
        "start": 56587,
        "end": 56594
      },
      "text": "འདས་པས་ ༼སྣར། པེ།༽ བཟླས་པས་"
    },
    {
      "span": {
        "start": 56645,
        "end": 56650
      },
      "text": "རིའི་ ༼སྣར།༽ རའི་"
    },
    {
      "span": {
        "start": 56804,
        "end": 56812
      },
      "text": "སྐྱེ་བོ་ ༼སྣར།༽ སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 56869,
        "end": 56877
      },
      "text": "མདོ་སྡེ་ ༼སྣར། པེ།༽ མདོ་སྡེའི་"
    },
    {
      "span": {
        "start": 56903,
        "end": 56905
      },
      "text": "ཀ་ ༼སྣར།༽ ག་"
    }
  ]
}