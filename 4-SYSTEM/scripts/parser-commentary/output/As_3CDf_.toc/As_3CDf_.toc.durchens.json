    {
      "span": {
        "start": 20349,
        "end": 20358
      },
      "text": "རྟོག་པའི་ ༼སྣར།༽ རྟོགས་པའི་"
    },
    {
      "span": {
        "start": 20479,
        "end": 20487
      },
      "text": "ལགས་ཞེས་ ༼སྣར། པེ།༽ ལགས་ཤེས་"
    },
    {
      "span": {
        "start": 20524,
        "end": 20533
      },
      "text": "རྟོག་པའི་ ༼སྣར།༽ རྟོགས་པའི་"
    },
    {
      "span": {
        "start": 20687,
        "end": 20695
      },
      "text": "བསྒོམ་པ་ ༼སྣར། པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 20844,
        "end": 20851
      },
      "text": "གཞིག་པ་ ༼སྣར། པེ།༽ བཞིག་པ་"
    },
    {
      "span": {
        "start": 20999,
        "end": 21004
      },
      "text": "གཞིག་ ༼སྣར། པེ།༽ བཞིག་"
    },
    {
      "span": {
        "start": 21250,
        "end": 21258
      },
      "text": "བསྡུས་པ་ ༼སྣར།༽ བསྡུ་བ་"
    },
    {
      "span": {
        "start": 21299,
        "end": 21306
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 21503,
        "end": 21512
      },
      "text": "ཤེས་པ་དང་ ༼སྣར། པེ།༽ ཤེས་པ་"
