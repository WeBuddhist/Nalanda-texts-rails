{
  "durchens": [
    {
      "span": {
        "start": 947,
        "end": 955
      },
      "text": "བྱེད་པར་ ༼སྣར། པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 1289,
        "end": 1292
      },
      "text": "ཆེ་ ༼སྣར། པེ།༽ ཆེའི་"
    },
    {
      "span": {
        "start": 1349,
        "end": 1358
      },
      "text": "བརྟེན་ནས་ ༼སྣར། པེ།༽ བརྟེན་པ་ན་"
    },
    {
      "span": {
        "start": 1606,
        "end": 1615
      },
      "text": "ཟློག་པའི་ ༼སྣར། པེ།༽ ལྡོག་པའི་"
    },
    {
      "span": {
        "start": 1854,
        "end": 1862
      },
      "text": "ཆོག་ཤེས་ ༼སྣར། པེ།༽ ཆོས་ཤེས་"
    },
    {
      "span": {
        "start": 1966,
        "end": 1979
      },
      "text": "སངས་རྒྱས་ཀྱི་ ༼སྣར། པེ།༽ སངས་རྒྱས་ཀྱིས་"
    },
    {
      "span": {
        "start": 2186,
        "end": 2194
      },
      "text": "ཁམས་ཀྱི་ ༼སྣར། པེ།༽ ཁམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 2442,
        "end": 2448
      },
      "text": "བསམ་པ་ ༼སྣར། པེ།༽ བསམས་པ་"
    },
    {
      "span": {
        "start": 2694,
        "end": 2700
      },
      "text": "རིག་པ་ ༼སྣར། པེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 3035,
        "end": 3041
      },
      "text": "འབྱུང་ ༼སྣར། པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 3136,
        "end": 3145
      },
      "text": "བདུད་ཀྱི་ ༼སྣར། པེ།༽ བདུད་དང་"
    },
    {
      "span": {
        "start": 3272,
        "end": 3277
      },
      "text": "བརྟན་ ༼སྣར། པེ།༽ བསྟན་"
    },
    {
      "span": {
        "start": 3788,
        "end": 3793
      },
      "text": "ལྟ་བ་ ༼སྣར། པེ།༽ བལྟ་བ་"
    },
    {
      "span": {
        "start": 4035,
        "end": 4039
      },
      "text": "ཚིག་ ༼སྣར། པེ།༽ ཚིགས་"
    },
    {
      "span": {
        "start": 4229,
        "end": 4239
      },
      "text": "ཞབས་འབྲིང་ ༼སྣར། པེ།༽ ཞམ་རིང་"
    },
    {
      "span": {
        "start": 4323,
        "end": 4331
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 4490,
        "end": 4497
      },
      "text": "བཞོན་པ་ ༼སྣར། པེ།༽ གཞོན་པ་"
    },
    {
      "span": {
        "start": 4598,
        "end": 4606
      },
      "text": "འདས་ཀྱི་ ༼སྣར། པེ།༽ འདས་ཀྱིས་"
    },
    {
      "span": {
        "start": 5173,
        "end": 5176
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 5661,
        "end": 5664
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ནི་ལུས་"
    },
    {
      "span": {
        "start": 5676,
        "end": 5683
      },
      "text": "ཁྱབ་པར་ ༼སྣར། པེ།༽ ཁྱབ་པ་"
    },
    {
      "span": {
        "start": 5848,
        "end": 5855
      },
      "text": "མེད་པས་ ༼སྣར། པེ།༽ མེད་པའི་"
    },
    {
      "span": {
        "start": 5912,
        "end": 5921
      },
      "text": "ཞུགས་པའི་ ༼སྣར། པེ།༽ བཞུགས་པའི་"
    },
    {
      "span": {
        "start": 6362,
        "end": 6369
      },
      "text": "རྟོག་པ་ ༼སྣར།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 6616,
        "end": 6621
      },
      "text": "བླངས་ ༼སྣར།༽ བླངས་པར་བླངས་"
    },
    {
      "span": {
        "start": 7157,
        "end": 7167
      },
      "text": "མཐའ་གཏུགས་ ༼སྣར། པེ།༽ མཐས་གཏུགས་"
    },
    {
      "span": {
        "start": 7196,
        "end": 7201
      },
      "text": "འཇིག་ ༼སྣར། པེ།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 7471,
        "end": 7478
      },
      "text": "ཚོགས་པ་ ༼སྣར། པེ།༽ ཚོགས་པའི་"
    },
    {
      "span": {
        "start": 7785,
        "end": 7790
      },
      "text": "དག་པ་ ༼སྣར། པེ།༽ དག་པར་"
    },
    {
      "span": {
        "start": 7918,
        "end": 7930
      },
      "text": "སེམས་ཅན་གྱི་ ༼པེ།༽ སེམས་ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 7994,
        "end": 8001
      },
      "text": "ལམ་གྱི་ ༼སྣར། པེ།༽ ལས་ཀྱི་"
    },
    {
      "span": {
        "start": 8421,
        "end": 8424
      },
      "text": "ཡང་ ༼སྣར། པེ།༽ ཡང་ང་"
    },
    {
      "span": {
        "start": 8482,
        "end": 8491
      },
      "text": "རྟོག་པའི་ ༼སྣར།༽ རྟོགས་པའི་"
    },
    {
      "span": {
        "start": 8780,
        "end": 8785
      },
      "text": "རྒྱར་ ༼སྣར།༽ རྒྱུར་"
    },
    {
      "span": {
        "start": 8820,
        "end": 8825
      },
      "text": "འགྲོ་ ༼སྣར། པེ།༽ འགྲོ་བས་འགྲོ་"
    },
    {
      "span": {
        "start": 8854,
        "end": 8861
      },
      "text": "ཉིད་དུ་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 9221,
        "end": 9229
      },
      "text": "སྤངས་པར་ ༼སྣར། པེ།༽ སྤོང་བར་"
    },
    {
      "span": {
        "start": 9370,
        "end": 9374
      },
      "text": "རིམ་ ༼སྣར། པེ།༽ རིས་"
    },
    {
      "span": {
        "start": 9406,
        "end": 9412
      },
      "text": "མཚན་མ་ ༼སྣར། པེ།༽ མཚན་ཉིད་"
    },
    {
      "span": {
        "start": 9415,
        "end": 9422
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ བསྟན་པ་ནི་"
    },
    {
      "span": {
        "start": 9587,
        "end": 9592
      },
      "text": "རིམས་ ༼སྣར། པེ།༽ རིམ་"
    },
    {
      "span": {
        "start": 9717,
        "end": 9724
      },
      "text": "མིང་གི་ ༼སྣར། པེ།༽ མིང་ནི་"
    },
    {
      "span": {
        "start": 9788,
        "end": 9796
      },
      "text": "གྲུབ་བོ། ༼སྣར། པེ།༽ གྲུབ་པ་པོ།"
    },
    {
      "span": {
        "start": 9848,
        "end": 9860
      },
      "text": "སྣ་ཚོགས་ཀྱི་ ༼སྣར། པེ།༽ སྣ་ཚོགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 10004,
        "end": 10011
      },
      "text": "གཞག་པས་ ༼སྣར། པེ།༽ བཞག་པས་"
    },
    {
      "span": {
        "start": 10061,
        "end": 10069
      },
      "text": "སྟོན་པས་ ༼སྣར། པེ།༽ སྟོན་པའི་"
    },
    {
      "span": {
        "start": 10098,
        "end": 10104
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 10331,
        "end": 10336
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 10354,
        "end": 10359
      },
      "text": "ལྟ་བ་ ༼སྣར། པེ།༽ ལྟ་བས་"
    },
    {
      "span": {
        "start": 10425,
        "end": 10433
      },
      "text": "བཟློག་པ་ ༼སྣར། པེ།༽ ཟློག་པ་"
    },
    {
      "span": {
        "start": 10470,
        "end": 10478
      },
      "text": "དོན་རྣམ་ ༼སྣར། པེ།༽ དོན་དམ་"
    },
    {
      "span": {
        "start": 10516,
        "end": 10525
      },
      "text": "གང་ཡིན་པ་ ༼སྣར། པེ།༽ གང་ཡིན་པའི་"
    },
    {
      "span": {
        "start": 10529,
        "end": 10531
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ཀྱི་"
    },
    {
      "span": {
        "start": 10535,
        "end": 10540
      },
      "text": "དེའོ། ༼སྣར། པེ།༽ དེའི།"
    },
    {
      "span": {
        "start": 10561,
        "end": 10568
      },
      "text": "གཉིས་པ་ ༼སྣར། པེ།༽ གཉིས་པ་ལ་"
    },
    {
      "span": {
        "start": 10590,
        "end": 10594
      },
      "text": "དོན་ ༼སྣར། པེ།༽ དོན་དམ་པ་"
    },
    {
      "span": {
        "start": 10601,
        "end": 10607
      },
      "text": "སྤྱོད་ ༼སྣར། པེ།༽ དཔྱོད་"
    },
    {
      "span": {
        "start": 10649,
        "end": 10656
      },
      "text": "ཁོང་དུ་ ༼སྣར། པེ།༽ ཁོངས་སུ་"
    },
    {
      "span": {
        "start": 10777,
        "end": 10787
      },
      "text": "འདོགས་པའི་ ༼སྣར། པེ།༽ འདོད་པའི་"
    },
    {
      "span": {
        "start": 10875,
        "end": 10885
      },
      "text": "ཞི་གནས་ཙམ་ ༼སྣར། པེ།༽ ཞི་གནས་"
    },
    {
      "span": {
        "start": 11120,
        "end": 11134
      },
      "text": "མཐུན་པར་འདོགས་ ༼སྣར།༽ མཐུན་པའི་འདོག་"
    },
    {
      "span": {
        "start": 11219,
        "end": 11235
      },
      "text": "གོ་རིམས་བཞིན་དུ་ ༼སྣར། པེ།༽ གོ་རིམ་"
    },
    {
      "span": {
        "start": 11292,
        "end": 11302
      },
      "text": "སྒྲུབ་པའི་ ༼སྣར། པེ།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 11384,
        "end": 11389
      },
      "text": "རིམས་ ༼སྣར། པེ།༽ རིམ་"
    },
    {
      "span": {
        "start": 11443,
        "end": 11446
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 11771,
        "end": 11783
      },
      "text": "དངོས་པོ་འདི་ ༼སྣར། པེ།༽ དངོས་པོ་"
    },
    {
      "span": {
        "start": 11849,
        "end": 11854
      },
      "text": "བ་ནི། ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 11879,
        "end": 11886
      },
      "text": "ལྷགས་པ་ ༼སྣར། པེ།༽ ལྷགས་"
    },
    {
      "span": {
        "start": 11945,
        "end": 11959
      },
      "text": "གཞུང་ལུགས་ཀྱི་ ༼སྣར། པེ།༽ གཞུང་ལུགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 11977,
        "end": 11984
      },
      "text": "སྐུར་པ་ ༼སྣར། པེ།༽ བཀུར་བ་"
    },
    {
      "span": {
        "start": 12137,
        "end": 12143
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 12350,
        "end": 12357
      },
      "text": "ལོག་པར་ ༼སྣར། པེ།༽ ལེགས་པར་"
    },
    {
      "span": {
        "start": 12357,
        "end": 12366
      },
      "text": "ངེས་པ་དེ་ ༼སྣར། པེ།༽ ངེས་པ་"
    },
    {
      "span": {
        "start": 12433,
        "end": 12444
      },
      "text": "ནི་ཚིག་གིས་ ༼སྣར། པེ།༽ ནི་ཚིགས་"
    },
    {
      "span": {
        "start": 12555,
        "end": 12563
      },
      "text": "རིགས་པར་ ༼སྣར། པེ།༽ རིག་པར་"
    },
    {
      "span": {
        "start": 12598,
        "end": 12604
      },
      "text": "མནན་པ་ ༼སྣར།༽ གནན་པ་"
    },
    {
      "span": {
        "start": 12661,
        "end": 12669
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 12813,
        "end": 12823
      },
      "text": "ཕྱེ་བ་སྟེ། ༼སྣར། པེ།༽ ཕྱེ་བས་ཏེ།"
    },
    {
      "span": {
        "start": 13219,
        "end": 13226
      },
      "text": "བཏགས་པ་ ༼སྣར། པེ།༽ བཏག་པ་"
    },
    {
      "span": {
        "start": 13278,
        "end": 13285
      },
      "text": "བཏགས་པ་ ༼སྣར། པེ།༽ བཏག་པ་"
    },
    {
      "span": {
        "start": 13389,
        "end": 13398
      },
      "text": "གཏན་ཚིགས་ ༼སྣར། པེ།༽ གཏན་ཚིག་"
    },
    {
      "span": {
        "start": 13517,
        "end": 13525
      },
      "text": "འགྱུར་བ་ ༼པེ།༽ འགྱུར་བར་"
    },
    {
      "span": {
        "start": 13532,
        "end": 13541
      },
      "text": "གཏན་ཚིགས་ ༼སྣར།༽ གཏན་ཚིག་"
    },
    {
      "span": {
        "start": 13580,
        "end": 13587
      },
      "text": "རྣམ་པར་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 13642,
        "end": 13651
      },
      "text": "ཐ་དད་མིན་ ༼སྣར། པེ།༽ ཐ་དད་"
    },
    {
      "span": {
        "start": 14186,
        "end": 14192
      },
      "text": "རྣམ་པ་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 14265,
        "end": 14271
      },
      "text": "རྣམ་པ་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 14514,
        "end": 14520
      },
      "text": "ནི་ངས་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 14935,
        "end": 14940
      },
      "text": "བརྒལ་ ༼སྣར།༽ བསྒལ་"
    },
