    {
      "span": {
        "start": 19711,
        "end": 19721
      },
      "text": "ཤེས་པ་དང་། ༼སྣར། པེ།༽ ཤེས་ཤིང་"
    },
    {
      "span": {
        "start": 20100,
        "end": 20105
      },
      "text": "འཐོབ་ ༼སྣར། པེ།༽ ཐོབ་"
