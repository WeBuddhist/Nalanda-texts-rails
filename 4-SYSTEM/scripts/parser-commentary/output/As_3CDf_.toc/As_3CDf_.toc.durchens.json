        "end": 24758
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 25038,
        "end": 25045
      },
      "text": "ནི་སོར་ ༼སྣར། པེ།༽ ནི་སར་"
    },
    {
      "span": {
        "start": 25286,
        "end": 25292
      },
      "text": "ཐབས་ལ་ ༼སྣར། པེ།༽ ཐབས་"
    },
    {
      "span": {
        "start": 25361,
        "end": 25369
      },
      "text": "ཆེན་པོས་ ༼སྣར། པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 25829,
        "end": 25836
      },
      "text": "བརྟས་པ་ ༼སྣར། པེ།༽ རྟས་པ་"
    },
    {
      "span": {
        "start": 25855,
        "end": 25863
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ འགྲུབ་པ་"
    },
    {
      "span": {
        "start": 25923,
        "end": 25926
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 25965,
        "end": 25968
      },
      "text": "ནི། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 26007,
        "end": 26016
      },
      "text": "དེ་དག་དང་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 26069,
        "end": 26334
      },
      "text": "པའོ། །གྲོགས་ལ་མཁས་པ་ནི། བཅོམ་ལྡན་འདས་ཅིའི་སླད་དུ་ཕ་རོལ་ཏུ་ཕྱིན་པ་གཞན་དག་གྲངས་བཞིར་གདགས་པར་རིག་པར་བགྱི་ལགས་ཞེས་བྱ་བ་ལ་སོགས་པའོ། །འབྱུང་བ་ལ་མཁས་པ་ནི། བཅོམ་ལྡན་འདས་ཅིའི་སླད་དུ་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་པོ་དེ་དག་གི་གོ་རིམས་དེ་ལྟར་བསྟན་པར་རིག་པར་བགྱི་ལགས་ཞེས་བྱ་བ་ལ་སོགས་པའོ། ༼སྣར། པེ།༽ པའོ།"
    },
    {
      "span": {
        "start": 26336,
        "end": 26343
      },
      "text": "ཐ་དད་པ་ ༼སྣར། པེ།༽ ཐ་དད་པའི་"
    },
    {
      "span": {
        "start": 26403,
        "end": 26414
      },
      "text": "རྣམ་པ་དུ་མ་ ༼སྣར། པེ།༽ རྣམ་པ་དུ་"
    },
    {
      "span": {
        "start": 26505,
        "end": 26536
      },
      "text": "ཕྱིན་པ་དེ་དག་ལ་ཕ་རོལ་ཏུ་ཕྱིན་པ་ ༼སྣར། པེ།༽ ཕྱིན་པ་"
    },
    {
      "span": {
        "start": 26583,
        "end": 26590
      },
      "text": "བསྡུ་བ་ ༼སྣར། པེ།༽ བསྡུས་པ་"
    },
    {
      "span": {
        "start": 26636,
        "end": 26644
      },
      "text": "སོ་སོའི་ ༼སྣར། པེ།༽ སོ་སོ་"
    },
    {
      "span": {
        "start": 26735,
        "end": 26744
      },
      "text": "དེ་དག་གི་ ༼པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 27118,
        "end": 27124
      },
      "text": "གནས་པ་ ༼སྣར། པེ།༽ གནས་པས་"
    },
    {
      "span": {
        "start": 27157,
        "end": 27165
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 27206,
        "end": 27215
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 27218,
        "end": 27223
      },
      "text": "སོའི་ ༼སྣར། པེ།༽ སོར་"
    },
    {
      "span": {
        "start": 27333,
        "end": 27340
      },
      "text": "ཕྱིན་པ་ ༼སྣར། པེ།༽ ཕྱིན་པའི་"
    },
    {
      "span": {
        "start": 27398,
        "end": 27404
      },
      "text": "གང་དག་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 27461,
        "end": 27465
      },
      "text": "གྱི་ ༼སྣར། པེ།༽ གྱི་དོན་གྱི་"
    },
    {
      "span": {
        "start": 27602,
        "end": 27606
      },
      "text": "གདའ་ ༼སྣར། པེ།༽ བརྡའ་"
    },
    {
      "span": {
        "start": 27702,
        "end": 27707
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 27916,
        "end": 27923
      },
      "text": "འཛིན་པ་ ༼སྣར། པེ།༽ འཛིན་པའི་"
    },
    {
      "span": {
        "start": 28084,
        "end": 28092
      },
      "text": "འདས་ཀྱི་ ༼སྣར། པེ།༽ འདས་ཀྱིས་"
    },
    {
      "span": {
        "start": 28267,
        "end": 28273
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བཏགས་"
    },
    {
      "span": {
        "start": 28334,
        "end": 28348
      },
      "text": "བྱེད་ཅེས་བྱ་བ་ ༼པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 28398,
        "end": 28409
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼སྣར།༽ ཐམས་ཅད་ཀྱིས་"
    },
    {
      "span": {
        "start": 28586,
        "end": 28594
      },
      "text": "སྐྱེ་བར་ ༼སྣར། པེ།༽ སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 28629,
        "end": 28636
      },
      "text": "བཏགས་པ་ ༼སྣར།༽ བརྟག་པ་ ༼པེ།༽ བཏག་པ་"
    },
    {
      "span": {
        "start": 28806,
        "end": 28812
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 28963,
        "end": 28979
      },
      "text": "ནི་སངས་རྒྱས་ཀྱི་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 28985,
        "end": 28989
      },
      "text": "ཡུལ་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 29538,
        "end": 29545
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 29660,
        "end": 29668
      },
      "text": "ཆོས་ཀྱི་ ༼སྣར། པེ།༽ ཆོས་ཀྱིས་"
    },
    {
      "span": {
        "start": 29728,
        "end": 29736
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 29755,
        "end": 29770
      },
      "text": "ཀུན་ཏུ་རྟོགས་པ་ ༼སྣར། པེ།༽ ཀུན་རྟོགས་"
    },
    {
      "span": {
        "start": 30105,
        "end": 30151
      },
      "text": "དང་། ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་རབ་ཏུ་དབྱེ་བ་དང་། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 30775,
        "end": 30777
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནཱ་"
    },
    {
      "span": {
        "start": 30871,
        "end": 30874
      },
      "text": "ཕབ། ༼སྣར། པེ།༽ ཕབ་པའོ།"
    }
  ]
}