    {
      "span": {
        "start": 23370,
        "end": 23380
      },
      "text": "བསྒོམས་པས་ ༼སྣར། པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 23444,
        "end": 23451
      },
      "text": "བྱ་བ་ལ་ ༼པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 23473,
        "end": 23475
      },
      "text": "ལ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 23625,
        "end": 23633
      },
      "text": "བསྒོམ་པ་ ༼སྣར། པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 23705,
        "end": 23708
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
