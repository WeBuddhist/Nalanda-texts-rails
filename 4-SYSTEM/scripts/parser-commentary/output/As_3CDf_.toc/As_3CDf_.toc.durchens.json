      "span": {
        "start": 15059,
        "end": 15064
      },
      "text": "འདིར་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 15240,
        "end": 15250
      },
      "text": "ཀུན་གཞིའི་ ༼སྣར། པེ།༽ ཀུན་གཞི་"
    },
    {
      "span": {
        "start": 15281,
        "end": 15290
      },
      "text": "སེམས་ཞེས་ ༼སྣར། པེ།༽ སེམས་"
    },
    {
      "span": {
        "start": 16005,
        "end": 16008
      },
      "text": "ཡང་ ༼སྣར།༽ ཡང་དེ་"
    },
    {
      "span": {
        "start": 16126,
        "end": 16130
      },
      "text": "འོས་ ༼སྣར། པེ།༽ ས་འོག་"
    },
    {
      "span": {
        "start": 16150,
        "end": 16159
      },
      "text": "འཇུག་པའི་ ༼སྣར། པེ།༽ འཇུག་པ་"
    },
    {
      "span": {
        "start": 16172,
        "end": 16181
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 16262,
        "end": 16267
      },
      "text": "དཀའོ། ༼སྣར། པེ།༽ དཀའ་བའོ།"
    },
    {
      "span": {
        "start": 16312,
        "end": 16320
      },
      "text": "མཚན་ཉིད་ ༼སྣར། པེ།༽ མཚན་ཉིད་དེ་"
    },
    {
      "span": {
        "start": 16387,
        "end": 16398
      },
      "text": "བསྒྲུབ་པའི་ ༼སྣར། པེ།༽ སྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 16430,
        "end": 16440
      },
      "text": "རྟོགས་པའི་ ༼སྣར།༽ རྟོག་པའི་"
    },
    {
      "span": {
        "start": 16645,
        "end": 16650
      },
      "text": "འཇིག་ ༼སྣར། པེ།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 16856,
        "end": 16860
      },
      "text": "བཞག་ ༼སྣར།༽ གཞག་"
    },
    {
      "span": {
        "start": 16972,
        "end": 17041
      },
      "text": "དེ་ལ་ཐབས་ཀྱི་དགོས་པ་ནི་གང་ལ་བརྟེན་ནས་མཚན་ཉིད་གསུམ་རབ་ཏུ་ཤེས་པའོ། །དེ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 17241,
        "end": 17248
      },
      "text": "དེ་ཐམས་ ༼སྣར། པེ།༽ ཐམས་"
    },
    {
      "span": {
        "start": 17307,
        "end": 17319
      },
      "text": "བྱ་བའི་ཕྱིར་ ༼སྣར། པེ།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 17330,
        "end": 17338
      },
      "text": "ཆོས་ཞེས་ ༼སྣར། པེ།༽ ཆོས་ཤེས་"
    },
    {
      "span": {
        "start": 17604,
        "end": 17612
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར། པེ།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 17723,
        "end": 17732
      },
      "text": "ལ་ལོག་པར་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 18047,
        "end": 18054
      },
      "text": "ལྟོས་པ་ ༼སྣར། པེ།༽ བལྟོས་པ་"
    },
    {
      "span": {
        "start": 18138,
        "end": 18149
      },
      "text": "བསྒྲུབ་པའི་ ༼སྣར། པེ།༽ སྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 18197,
        "end": 18208
      },
      "text": "བསྒྲུབ་པའི་ ༼སྣར། པེ།༽ སྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 18324,
        "end": 18333
      },
      "text": "བསྐྱེད་པ་ ༼སྣར།༽ སྐྱེས་པ་"
    },
    {
      "span": {
        "start": 18381,
        "end": 18388
      },
      "text": "དོན་དམ་ ༼སྣར། པེ།༽ དོན་དམ་པར་"
    },
    {
      "span": {
        "start": 18394,
        "end": 18399
      },
      "text": "འཕགས། ༼སྣར། པེ།༽ འཕགས་པ།"
    },
    {
      "span": {
        "start": 18422,
        "end": 18429
      },
      "text": "ཞི་བའི་ ༼སྣར། པེ།༽ ཞི་བ་"
    },
    {
      "span": {
        "start": 18517,
        "end": 18525
      },
      "text": "འགྱུར་བ་ ༼སྣར།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 18547,
        "end": 18556
      },
      "text": "གྲངས་ཀྱི་ ༼སྣར། པེ།༽ གྲངས་ཀྱིས་"
    },
    {
      "span": {
        "start": 18861,
        "end": 18868
      },
      "text": "གྱུར་ལ། ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 19199,
        "end": 19205
      },
      "text": "བཞི་པ་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 19231,
        "end": 19234
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 19418,
        "end": 19425
      },
      "text": "དོན་དམ་ ༼སྣར། པེ།༽ དོན་དམ་པ་"
