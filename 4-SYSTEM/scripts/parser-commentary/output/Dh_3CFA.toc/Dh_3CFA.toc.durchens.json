{
  "durchens": [
    {
      "span": {
        "start": 184,
        "end": 189
      },
      "text": "སྨྲས་ ༼སྣར།༽ སྨྲོས་"
    },
    {
      "span": {
        "start": 390,
        "end": 398
      },
      "text": "ཡོད་མེད་ ༼སྣར།༽ ཡོད་"
    },
    {
      "span": {
        "start": 438,
        "end": 446
      },
      "text": "གྲུབ་ཏུ་ ༼སྣར། པེ།༽ གྲུབ་ན་"
    },
    {
      "span": {
        "start": 738,
        "end": 744
      },
      "text": "དེ་བས་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 786,
        "end": 794
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ དངོས་པོར་"
    },
    {
      "span": {
        "start": 827,
        "end": 834
      },
      "text": "རྟོག་པ་ ༼པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 847,
        "end": 851
      },
      "text": "དགག་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 856,
        "end": 868
      },
      "text": "ངོ་བོ་འདྲེས་ ༼སྣར།༽ ངོ་བོས་འདྲེལ་ ༼པེ།༽ ངོ་བོས་འདྲེས་"
    },
    {
      "span": {
        "start": 870,
        "end": 876
      },
      "text": "འབྲེལ་ ༼སྣར།༽ བ་འབྲེལ་པ་"
    },
    {
      "span": {
        "start": 1065,
        "end": 1073
      },
      "text": "གཅིག་པུ་ ༼སྣར། པེ།༽ གཅིག་ཏུ་"
    },
    {
      "span": {
        "start": 1083,
        "end": 1091
      },
      "text": "འབྲེལ་པ་ ༼སྣར། པེ།༽ འབྲེལ་"
    },
    {
      "span": {
        "start": 1248,
        "end": 1254
      },
      "text": "མེད་པ་ ༼ཅོ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 1314,
        "end": 1320
      },
      "text": "བར་ཆད་ ༼སྣར། པེ།༽ བར་"
    },
    {
      "span": {
        "start": 1326,
        "end": 1329
      },
      "text": "ཙམ་ ༼པེ།༽ ཅན་"
    },
    {
      "span": {
        "start": 1474,
        "end": 1485
      },
      "text": "འབྲེལ་པ་ཅན་ ༼པེ།༽ འབྲེལ་པ་ཙམ་"
    },
    {
      "span": {
        "start": 1733,
        "end": 1748
      },
      "text": "ངོ་བོ་ཐ་དད་པ་ལ་ ༼སྣར། པེ།༽ ཐ་དད་པ་"
    },
    {
      "span": {
        "start": 1788,
        "end": 1796
      },
      "text": "ཡང་དག་པ་ ༼ཅོ།༽ ཡང་དག་པར་"
    },
    {
      "span": {
        "start": 2014,
        "end": 2020
      },
      "text": "ངོ་བོ་ ༼སྣར། པེ།༽ ངོ་བོར་"
    },
    {
      "span": {
        "start": 2061,
        "end": 2071
      },
      "text": "གང་ཞིག་གི་ ༼སྣར། པེ།༽ གང་ཞིག་"
    },
    {
      "span": {
        "start": 2342,
        "end": 2351
      },
      "text": "གཅིག་པུས་ ༼སྣར། པེ།༽ ཅན་གཅིག་པུ་ཡིས་"
    },
    {
      "span": {
        "start": 2505,
        "end": 2517
      },
      "text": "འབྲེལ་པ་དོན་ ༼སྣར། པེ།༽ འབྲེལ་པ་"
    },
    {
      "span": {
        "start": 2561,
        "end": 2568
      },
      "text": "བཏགས་པ་ ༼སྣར།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 2568,
        "end": 2574
      },
      "text": "ཁོ་ནར་ ༼སྣར།༽ ཁོ་ན་"
    },
    {
      "span": {
        "start": 2617,
        "end": 2636
      },
      "text": "འབྲེལ་པ་ལས་འབྲེལ་པ་ ༼སྣར། པེ།༽ འབྲེལ་པ་"
    },
    {
      "span": {
        "start": 2738,
        "end": 2742
      },
      "text": "དོན་ ༼སྣར། པེ།༽ དོན་དང་"
    },
    {
      "span": {
        "start": 3111,
        "end": 3117
      },
      "text": "དང་ཡང་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 3434,
        "end": 3442
      },
      "text": "ཐུག་པའམ་ ༼སྣར། པེ།༽ ཐུག་པའང་"
    },
    {
      "span": {
        "start": 4266,
        "end": 4274
      },
      "text": "ཡང་དག་པ་ ༼སྣར། པེ།༽ ཡང་དག་པ་པ་"
    },
    {
      "span": {
        "start": 4323,
        "end": 4332
      },
      "text": "རྟོགས་པས་ ༼སྣར། པེ།༽ རྟོག་པས་"
    },
    {
      "span": {
        "start": 4459,
        "end": 4463
      },
      "text": "གསལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 4595,
        "end": 4605
      },
      "text": "བྱེད་པ་པོ་ ༼སྣར། པེ།༽ བྱེད་པ་པོའི་"
    },
    {
      "span": {
        "start": 4619,
        "end": 4623
      },
      "text": "ཚིག་ ༼པེ།༽ ཚིགས་"
    },
    {
      "span": {
        "start": 4731,
        "end": 4733
      },
      "text": "པ་ ༼པེ།༽ པར་"
    },
    {
      "span": {
        "start": 4839,
        "end": 4854
      },
      "text": "ཇི་ལྟར་འགྲུབ། ། ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 5041,
        "end": 5049
      },
      "text": "འབྲས་བུ་ ༼ཅོ།༽ འབྲས་བུས་"
    },
    {
      "span": {
        "start": 5179,
        "end": 5183
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ ཉིད་ཡིན་"
    },
    {
      "span": {
        "start": 5320,
        "end": 5331
      },
      "text": "ལྷན་ཅིག་ཏུ་ ༼སྣར། པེ།༽ ལྷན་ཅིག་"
    },
    {
      "span": {
        "start": 5438,
        "end": 5446
      },
      "text": "རྟོག་པས་ ༼སྣར།༽ རྟོགས་པས་"
    },
    {
      "span": {
        "start": 5900,
        "end": 5909
      },
      "text": "རིམ་གྱིས་ ༼སྣར། པེ།༽ རིམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 6020,
        "end": 6029
      },
      "text": "རིམ་གྱིས་ ༼སྣར། པེ།༽ རིམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 6191,
        "end": 6196
      },
      "text": "ཕན་པ་ ༼སྣར། པེ།༽ ཕན་པར་"
    },
    {
      "span": {
        "start": 6435,
        "end": 6438
      },
      "text": "དེ། ༼སྣར། པེ།༽ དོ། །"
    },
    {
      "span": {
        "start": 6741,
        "end": 6751
      },
      "text": "ཁོ་ན་འཐོབ་ ༼པེ།༽ ཁོ་ནའོ་ཐོབ་"
    },
    {
      "span": {
        "start": 6856,
        "end": 6859
      },
      "text": "རྭ་ ༼སྣར། པེ།༽ རོ་"
    },
    {
      "span": {
        "start": 7063,
        "end": 7071
      },
      "text": "ཡིན་གྱི། ༼པེ།༽ ཡིན་གྱིས།"
    },
    {
      "span": {
        "start": 7178,
        "end": 7196
      },
      "text": "ཁྱད་པར་རྣམ་པར་གཞག་ ༼སྣར།༽ ཁྱད་པར་བཞག་ ༼པེ།༽ ཁྱད་པར་གཞག་"
    },
    {
      "span": {
        "start": 7288,
        "end": 7310
      },
      "text": "གཉིས་ཀྱི་དོན་ཡོད་པ་དང་ ༼སྣར།༽ གཉིས་ཀྱིས་དོན་ ༼པེ།༽ གཉིས་ཀྱིས་དོན་པ་དང་"
    },
    {
      "span": {
        "start": 7314,
        "end": 7319
      },
      "text": "པ་གང་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 7472,
        "end": 7488
      },
      "text": "ཐམས་ཅད་མ་ཡིན་ནོ་ ༼སྣར། པེ།༽ ཐམས་ཅད་དོ་"
    },
    {
      "span": {
        "start": 7554,
        "end": 7559
      },
      "text": "འདིར་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 7686,
        "end": 7692
      },
      "text": "ཡོད་པ་ ༼སྣར། པེ།༽ ཡོད་པ་ཡིན་"
    },
    {
      "span": {
        "start": 7749,
        "end": 7758
      },
      "text": "ཡིན་ནོ། ། ༼སྣར། པེ།༽ ཡིན་ཏེ་"
    },
    {
      "span": {
        "start": 7895,
        "end": 7903
      },
      "text": "སྒྲ་ཞེས་ ༼སྣར། པེ།༽ སྒྲ་"
    },
    {
      "span": {
        "start": 8145,
        "end": 8154
      },
      "text": "འབྲས་བུར་ ༼སྣར། པེ།༽ འབྲས་བུ་"
    },
    {
      "span": {
        "start": 8170,
        "end": 8176
      },
      "text": "རྒྱུར་ ༼ཅོ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 8522,
        "end": 8528
      },
      "text": "ཟད་དེ། ༼སྣར།༽ ཟད་"
    },
    {
      "span": {
        "start": 8572,
        "end": 8585
      },
      "text": "དག་ལས་གཞན་དུ་ ༼སྣར།༽ དག་ལ་གཞན་ ༼པེ།༽ དག་ལ་གཞན་དུ་"
    },
    {
      "span": {
        "start": 8639,
        "end": 8645
      },
      "text": "ཆུད་པ་ ༼སྣར། པེ།༽ ཆུད་པ་ལ་"
    },
    {
      "span": {
        "start": 9212,
        "end": 9219
      },
      "text": "སྐྱེ་བ་ ༼སྣར། པེ།༽ སྐྱེད་པ་"
    },
    {
      "span": {
        "start": 9382,
        "end": 9390
      },
      "text": "མེད་པ་མ་ ༼པེ།༽ མེད་པ་ལ་"
    },
    {
      "span": {
        "start": 9499,
        "end": 9503
      },
      "text": "ཚིག་ ༼སྣར། པེ།༽ ཚིགས་"
    },
    {
      "span": {
        "start": 9660,
        "end": 9669
      },
      "text": "ཡོད་པ་དང་ ༼སྣར། པེ།༽ ཡོད་པ་"
    },
    {
      "span": {
        "start": 9813,
        "end": 9819
      },
      "text": "འདིའོ་ ༼སྣར། པེ།༽ འདིའི་"
    },
    {
      "span": {
        "start": 9870,
        "end": 9880
      },
      "text": "ཡོད་ན་ཡོད་ ༼སྣར། པེ།༽ ཡོད་"
    },
    {
      "span": {
        "start": 9897,
        "end": 9916
      },
      "text": "འདི་སྐད་དུ་རྗེས་སུ་ ༼སྣར། པེ།༽ འདི་སྐད་དུ་"
    },
    {
      "span": {
        "start": 10392,
        "end": 10411
      },
      "text": "མེད་པ་གཉི་གར་རྟོགས་ ༼སྣར།༽ མེད་པ་གཉི་གར་གཏོགས་ ༼པེ།༽ མེད་པ་གཉིས་གཏོགས་"
    },
    {
      "span": {
        "start": 10440,
        "end": 10451
      },
      "text": "ཁོ་ན་ཡིན་ན་ ༼སྣར། པེ།༽ ཁོ་ན་"
    },
    {
      "span": {
        "start": 11217,
        "end": 11224
      },
      "text": "རྟོག་པ་ ༼པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 11264,
        "end": 11271
      },
      "text": "རེ་ཞིག་ ༼སྣར། པེ།༽ རེ་ཤིག་"
    },
    {
      "span": {
        "start": 11340,
        "end": 11348
      },
      "text": "པའི་དོན་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 11391,
        "end": 11400
      },
      "text": "ཡོད་པ་དེ་ ༼སྣར། པེ།༽ ཡོད་པ་"
    },
    {
      "span": {
        "start": 11465,
        "end": 11467
      },
      "text": "པ་ ༼པེ།༽ པར་"
    },
    {
      "span": {
        "start": 11667,
        "end": 11672
      },
      "text": "ཐ་དད་ ༼སྣར། པེ།༽ ཐ་དད་མ་"
    },
    {
      "span": {
        "start": 12043,
        "end": 12048
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 12168,
        "end": 12176
      },
      "text": "འབྲེལ་པ་ ༼སྣར། པེ།༽ འབྲེལ་པ་ཞེས་"
    },
    {
      "span": {
        "start": 12238,
        "end": 12249
      },
      "text": "དངོས་པོ་གང་ ༼པེ།༽ དངོས་པོ་"
    },
    {
      "span": {
        "start": 12355,
        "end": 12363
      },
      "text": "སྨོས་པས་ ༼སྣར། པེ།༽ སྨོས་པ་"
    },
    {
      "span": {
        "start": 12612,
        "end": 12620
      },
      "text": "བྱེད་དེ། ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 12922,
        "end": 12931
      },
      "text": "དེ་ལྟ་བུ་ ༼སྣར། པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 13432,
        "end": 13440
      },
      "text": "རུང་ངོ་། ༼སྣར། པེ།༽ རུང་སྟེ།"
    },
    {
      "span": {
        "start": 13449,
        "end": 13457
      },
      "text": "འདི་སྐད་ ༼པེ།༽ དེ་སྐད་"
    },
    {
      "span": {
        "start": 13511,
        "end": 13517
      },
      "text": "འདུ་བ་ ༼སྣར། པེ།༽ དུ་བ་"
    },
    {
      "span": {
        "start": 13537,
        "end": 13541
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 13543,
        "end": 13548
      },
      "text": "ཕན་པ་ ༼སྣར། པེ།༽ ཕན་པར་"
    },
    {
      "span": {
        "start": 13675,
        "end": 13682
      },
      "text": "འདི་མི་ ༼སྣར། པེ།༽ འདི་མེད་"
    },
    {
      "span": {
        "start": 13763,
        "end": 13771
      },
      "text": "སྐྱེད་པ་ ༼སྣར། པེ།༽ སྐྱེས་པ་"
    },
    {
      "span": {
        "start": 13986,
        "end": 13994
      },
      "text": "ཕྱིར་ཏེ། ༼སྣར། པེ།༽ ཕྱིར།"
    },
    {
      "span": {
        "start": 14169,
        "end": 14174
      },
      "text": "ཕན་པ་ ༼སྣར། པེ།༽ ཕན་པར་"
    },
    {
      "span": {
        "start": 14379,
        "end": 14399
      },
      "text": "ཕན་པ་བྱེད་པ་དང་ཕན་པ་ ༼སྣར། པེ།༽ ཕན་པ་"
    },
    {
      "span": {
        "start": 14513,
        "end": 14521
      },
      "text": "འབྲས་བུ་ ༼སྣར། པེ།༽ འབྲས་བུ་མ་"
    },
    {
      "span": {
        "start": 14550,
        "end": 14560
      },
      "text": "བསྐྱེད་པས་ ༼སྣར།༽ སྐྱེད་པ་ ༼པེ།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 14610,
        "end": 14642
      },
      "text": "སྦྱོར་བ་སྐྱེད་ཀྱང་སྦྱོར་བ་སྐྱེད་ ༼སྣར། པེ།༽ སྦྱོར་བ་བསྐྱེད་"
    },
    {
      "span": {
        "start": 14837,
        "end": 14848
      },
      "text": "འགའ་ཞིག་གི་ ༼སྣར། པེ།༽ འགའ་ཞིག་གིས་"
    },
    {
      "span": {
        "start": 14856,
        "end": 14864
      },
      "text": "སྐྱེས་པ་ ༼སྣར། པེ།༽ སྐྱེས་པས་"
    },
    {
      "span": {
        "start": 14959,
        "end": 14968
      },
      "text": "འགྱུར་བར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 15003,
        "end": 15015
      },
      "text": "སྐྱེས་པར་ཡང་ ༼སྣར། པེ།༽ སྐྱེས་པར་"
    },
    {
      "span": {
        "start": 15185,
        "end": 15200
      },
      "text": "བསྐྱེད་པར་བྱ་བ་ ༼སྣར། པེ།༽ བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 15373,
        "end": 15406
      },
      "text": "གང་ཡིན་པ་དེ་ལྡན་པའི་ངོ་བོ་ཡང་ཡིན་ ༼སྣར། པེ།༽ གང་ཡིན་"
    },
    {
      "span": {
        "start": 15561,
        "end": 15567
      },
      "text": "ཡིན་པ་ ༼སྣར། པེ།༽ ཡིན་པས་"
    },
    {
      "span": {
        "start": 15683,
        "end": 15689
      },
      "text": "དྲི་བ་ ༼སྣར། པེ།༽ དྲི་མ་"
    },
    {
      "span": {
        "start": 15939,
        "end": 15955
      },
      "text": "ན་ཁྱེད་ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ན་ཁྱོད་ཉིད་"
    },
    {
      "span": {
        "start": 16034,
        "end": 16042
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ དངོས་པོར་"
    },
    {
      "span": {
        "start": 16233,
        "end": 16237
      },
      "text": "ངེད་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 16256,
        "end": 16263
      },
      "text": "སོགས་པ་ ༼སྣར།༽ སྭོ་པ་"
    },
    {
      "span": {
        "start": 16329,
        "end": 16348
      },
      "text": "གྲོལ་སོགས་པས། །ཞེས་ ༼སྣར། པེ།༽ བྲལ་སྭོ་པས་ཤེས་བྱ་"
    },
    {
      "span": {
        "start": 16351,
        "end": 16353
      },
      "text": "བ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 16377,
        "end": 16385
      },
      "text": "ཚིག་གིས་ ༼པེ།༽ ཚོགས་སུ་"
    },
    {
      "span": {
        "start": 16468,
        "end": 16477
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 16504,
        "end": 16511
      },
      "text": "ཅུང་ཟད་ ༼སྣར།༽ ཅུང་"
    },
    {
      "span": {
        "start": 16713,
        "end": 16721
      },
      "text": "གཞན་གྱི་ ༼པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 16916,
        "end": 16923
      },
      "text": "དེ་གཞན་ ༼སྣར། པེ།༽ དེ་བཞིན་"
    },
    {
      "span": {
        "start": 17170,
        "end": 17189
      },
      "text": "དངོས་པོ་ཐ་དད་པ་འདི་ ༼སྣར། པེ།༽ ཐ་དད་པ་"
    },
    {
      "span": {
        "start": 17250,
        "end": 17258
      },
      "text": "བརྟེན་པ་ ༼སྣར། པེ།༽ བརྟན་པ་"
    },
    {
      "span": {
        "start": 17494,
        "end": 17511
      },
      "text": "སློབ་དཔོན་ཆེན་པོ་ ༼སྣར། པེ།༽ སློབ་དཔོན་"
    }
  ]
}