{
  "durchens": [
    {
      "span": {
        "start": 220,
        "end": 227
      },
      "text": "ཇི་ལྟར་ ༼སྣར། པེ།༽ ཇི་ལྟ་བར་"
    },
    {
      "span": {
        "start": 542,
        "end": 551
      },
      "text": "རིམ་གྱིས་ ༼སྣར། པེ།༽ རིམས་ཀྱི་"
    },
    {
      "span": {
        "start": 768,
        "end": 771
      },
      "text": "དེ། ༼སྣར། པེ།༽ དོ། །"
    },
    {
      "span": {
        "start": 1072,
        "end": 1082
      },
      "text": "མཛེས་ཀྱིས་ ༼སྣར། པེ།༽ མཛེས་ཀྱི་"
    },
    {
      "span": {
        "start": 1086,
        "end": 1089
      },
      "text": "པས་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 1204,
        "end": 1210
      },
      "text": "གདབ་པ་ ༼སྣར། པེ།༽ བཏབ་པ་"
    },
    {
      "span": {
        "start": 1537,
        "end": 1540
      },
      "text": "ཅན་ ༼སྣར། པེ།༽ ཅན་གྱི་"
    },
    {
      "span": {
        "start": 1578,
        "end": 1586
      },
      "text": "མཚན་པའོ། ༼སྣར། པེ།༽ མཚན་མའོ།"
    },
    {
      "span": {
        "start": 1823,
        "end": 1838
      },
      "text": "དཀྱིལ་འཁོར་གྱི་ ༼སྣར། པེ།༽ དཀྱིལ་འཁོར་པ་"
    },
    {
      "span": {
        "start": 2147,
        "end": 2154
      },
      "text": "བརྩེགས་ ༼སྣར། པེ།༽ རྩེག་"
    },
    {
      "span": {
        "start": 2185,
        "end": 2194
      },
      "text": "གསུམ་པའོ། ༼སྣར། པེ།༽ གསུམ་པོའོ།"
    },
    {
      "span": {
        "start": 2549,
        "end": 2555
      },
      "text": "ཡི་གེ་ ༼སྣར། པེ།༽ ཡི་གེ་དག་"
    },
    {
      "span": {
        "start": 2656,
        "end": 2671
      },
      "text": "མིག་ལ་སོགས་པ་ལ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 2977,
        "end": 2985
      },
      "text": "དབྱིག་པ་ ༼སྣར། པེ།༽ དབྱུག་པ་"
    },
    {
      "span": {
        "start": 3222,
        "end": 3231
      },
      "text": "འཛིན་ཅིང་ ༼སྣར། པེ།༽ འཛིན་པའི་"
    },
    {
      "span": {
        "start": 3240,
        "end": 3245
      },
      "text": "ཞུགས་ ༼སྣར། པེ།༽ འཇུག་"
    },
    {
      "span": {
        "start": 3299,
        "end": 3307
      },
      "text": "བརྟགས་པ་ ༼ཅོ།༽ བརྟགས་པར་"
    },
    {
      "span": {
        "start": 3368,
        "end": 3375
      },
      "text": "ལ་སོགས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 3851,
        "end": 3859
      },
      "text": "ཚོགས་པར་ ༼སྣར། པེ།༽ ཚོགས་པ་"
    },
    {
      "span": {
        "start": 4313,
        "end": 4320
      },
      "text": "རེག་བྱ་ ༼སྣར། པེ།༽ རེག་གི་"
    },
    {
      "span": {
        "start": 4686,
        "end": 4694
      },
      "text": "བདག་ཉིད་ ༼སྣར། པེ།༽ བདག་ཉིད་ཡི་གེ་"
    },
    {
      "span": {
        "start": 5068,
        "end": 5073
      },
      "text": "སེམས་ ༼སྣར། པེ།༽ སེམས་གནས་"
    },
    {
      "span": {
        "start": 5271,
        "end": 5274
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 5278,
        "end": 5284
      },
      "text": "རྗེའི་ ༼སྣར། པེ།༽ རྗེ་"
    },
    {
      "span": {
        "start": 5551,
        "end": 5570
      },
      "text": "ལ་རྣལ་འབྱོར་པ་རྣམས་ ༼སྣར། པེ།༽ རྣལ་འབྱོར་པ་"
    },
    {
      "span": {
        "start": 5697,
        "end": 5707
      },
      "text": "སྐྱེད་པའི་ ༼སྣར། པེ།༽ བསྐྱེད་པའི་"
    },
    {
      "span": {
        "start": 5707,
        "end": 5714
      },
      "text": "གཞི་བོ། ༼སྣར། པེ།༽ གཞི་པོ།"
    },
    {
      "span": {
        "start": 5824,
        "end": 5830
      },
      "text": "བརྟགས་ ༼སྣར།༽ རྟགས་"
    },
    {
      "span": {
        "start": 6052,
        "end": 6057
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 6060,
        "end": 6065
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ རྒྱུ་བ་"
    },
    {
      "span": {
        "start": 6100,
        "end": 6107
      },
      "text": "ཉིད་དུ་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 6468,
        "end": 6505
      },
      "text": "། །ཡུངས་ཀར་ནི་མི་ཤིགས་པའི་ཐིག་ལེའོ། ། ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 6651,
        "end": 6657
      },
      "text": "ལྔ་ནི་ ༼སྣར། པེ།༽ ལྔའི་"
    },
    {
      "span": {
        "start": 6917,
        "end": 6924
      },
      "text": "བྱུང་བ་ ༼སྣར།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 7161,
        "end": 7168
      },
      "text": "ཡས་ཀྱི་ ༼སྣར། པེ།༽ ཡས་ཀྱིས་"
    },
    {
      "span": {
        "start": 7607,
        "end": 7614
      },
      "text": "གཞུག་པ་ ༼སྣར། པེ།༽ བཞུགས་པ་"
    },
    {
      "span": {
        "start": 7809,
        "end": 7811
      },
      "text": "པ་ ༼སྣར། པེ།༽ པས་"
    },
    {
      "span": {
        "start": 7898,
        "end": 7906
      },
      "text": "བརྟགས་པ་ ༼སྣར།༽ བཏགས་པ་"
    },
    {
      "span": {
        "start": 7960,
        "end": 7964
      },
      "text": "སྟེ་ ༼སྣར། པེ།༽ སྟེ་དེ་"
    },
    {
      "span": {
        "start": 8337,
        "end": 8348
      },
      "text": "འབྱུང་པོའི་ ༼སྣར། པེ།༽ འབྱུང་བའི་"
    },
    {
      "span": {
        "start": 9044,
        "end": 9053
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 9267,
        "end": 9273
      },
      "text": "བགྲངས་ ༼སྣར། པེ།༽ གྲངས་"
    },
    {
      "span": {
        "start": 9339,
        "end": 9345
      },
      "text": "ཡི་གེ་ ༼སྣར། པེ།༽ ཡི་གེའི་"
    },
    {
      "span": {
        "start": 9537,
        "end": 9540
      },
      "text": "ཀོ་ ༼སྣར། པེ།༽ གོ་"
    },
    {
      "span": {
        "start": 9547,
        "end": 9552
      },
      "text": "ཆེའི་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 9743,
        "end": 9754
      },
      "text": "བསྒྱུར་བའི་ ༼ཅོ།༽ བསྐུར་བའི་ ༼སྣར། པེ།༽ སྒྱུར་བའི་"
    },
    {
      "span": {
        "start": 9795,
        "end": 9802
      },
      "text": "ནི་སྡེ་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 9932,
        "end": 9939
      },
      "text": "སྟོན་པ་ ༼སྣར། པེ།༽ བསྟོན་པ་"
    },
    {
      "span": {
        "start": 9944,
        "end": 9957
      },
      "text": "རྣལ་འབྱོར་པས་ ༼སྣར། པེ།༽ རྣལ་འབྱོར་པའི་"
    },
    {
      "span": {
        "start": 9971,
        "end": 9978
      },
      "text": "བྱེད་པ་ ༼སྣར། པེ།༽ བྱེད་པར་"
    },
    {
      "span": {
        "start": 10030,
        "end": 10052
      },
      "text": "དཀྱིལ་འཁོར་གང་ཞིག་བསད་ ༼སྣར། པེ།༽ དཀྱིལ་འཁོར་ལ་སད་"
    },
    {
      "span": {
        "start": 10477,
        "end": 10486
      },
      "text": "བསྟོད་པར་ ༼སྣར། པེ།༽ བསྟོད་པ་"
    },
    {
      "span": {
        "start": 10494,
        "end": 10499
      },
      "text": "སྟོད་ ༼སྣར། པེ།༽ བསྟོད་"
    },
    {
      "span": {
        "start": 10532,
        "end": 10538
      },
      "text": "བཞག་པ་ ༼སྣར། པེ།༽ བཞག་པའི་"
    },
    {
      "span": {
        "start": 11008,
        "end": 11018
      },
      "text": "བརྗོད་པའོ། ༼སྣར། པེ།༽ བརྗོད་དོ།"
    },
    {
      "span": {
        "start": 11977,
        "end": 11983
      },
      "text": "མྱང་བ་ ༼སྣར། པེ།༽ མྱོང་བ་"
    },
    {
      "span": {
        "start": 12036,
        "end": 12040
      },
      "text": "ཤེས་ ༼སྣར། པེ།༽ ཤེས་པ་"
    },
    {
      "span": {
        "start": 12188,
        "end": 12193
      },
      "text": "འཐོབ་ ༼སྣར། པེ།༽ ཐོབ་"
    },
    {
      "span": {
        "start": 12239,
        "end": 12248
      },
      "text": "འཐོབ་པའི་ ༼སྣར། པེ།༽ ཐོབ་པའི་"
    },
    {
      "span": {
        "start": 12374,
        "end": 12383
      },
      "text": "སྤྱོད་པས་ ༼སྣར། པེ།༽ སྤྱད་པས་"
    },
    {
      "span": {
        "start": 12402,
        "end": 12405
      },
      "text": "ལས་ ༼ཅོ།༽ ལུས་"
    },
    {
      "span": {
        "start": 13227,
        "end": 13229
      },
      "text": "ལ་ ༼པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 13306,
        "end": 13314
      },
      "text": "འབྱོར་པ། ༼སྣར། པེ།༽ འབྱོར་"
    },
    {
      "span": {
        "start": 13752,
        "end": 13763
      },
      "text": "ཡེ་ཤེས་ཀྱི་ ༼སྣར། པེ།༽ ཡེ་ཤེས་ཀྱིས་"
    },
    {
      "span": {
        "start": 13867,
        "end": 13876
      },
      "text": "ཤེས་རབ་མ་ ༼པེ།༽ ཤེས་རབ་"
    },
    {
      "span": {
        "start": 14055,
        "end": 14060
      },
      "text": "གཟོད་ ༼སྣར།༽ བཟོད་"
    },
    {
      "span": {
        "start": 14526,
        "end": 14531
      },
      "text": "བྱའོ། ༼སྣར། པེ།༽ བྱ་བའོ།"
    },
    {
      "span": {
        "start": 14613,
        "end": 14624
      },
      "text": "བརླབ་པ་སྟེ། ༼སྣར། པེ།༽ བརླབས་ཏེ།"
    },
    {
      "span": {
        "start": 14755,
        "end": 14763
      },
      "text": "སློབ་མས་ ༼སྣར། པེ།༽ སློབ་མ་"
    },
    {
      "span": {
        "start": 15076,
        "end": 15085
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 15096,
        "end": 15105
      },
      "text": "གྲོལ་བའི་ ༼སྣར། པེ།༽ འགྲོ་བའི་"
    },
    {
      "span": {
        "start": 15398,
        "end": 15404
      },
      "text": "རིམ་པ་ ༼སྣར། པེ།༽ རིམ་པས་"
    },
    {
      "span": {
        "start": 15892,
        "end": 15900
      },
      "text": "མཚོན་པར་ ༼སྣར། པེ།༽ མཚན་པར་"
    },
    {
      "span": {
        "start": 15937,
        "end": 15945
      },
      "text": "ཕྱག་རྒྱ་ ༼ཅོ།༽ ཕྱག་རྒྱ་ནི་"
    },
    {
      "span": {
        "start": 16404,
        "end": 16418
      },
      "text": "དཀྱིལ་འཁོར་ནི་ ༼སྣར། པེ།༽ དཀྱིལ་འཁོར་"
    },
    {
      "span": {
        "start": 16589,
        "end": 16598
      },
      "text": "ཆོ་ག་ཡིས་ ༼སྣར། པེ།༽ ཆོ་ག་ཡི་"
    },
    {
      "span": {
        "start": 17100,
        "end": 17105
      },
      "text": "གང་ལ་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 17448,
        "end": 17453
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 17959,
        "end": 17970
      },
      "text": "གཟུགས་རྣམས་ ༼ཅོ།༽ གཟུགས་"
    },
    {
      "span": {
        "start": 17973,
        "end": 17983
      },
      "text": "ཀུན་རྟོགས་ ༼སྣར། པེ།༽ ཀུན་རྟོག་"
    },
    {
      "span": {
        "start": 18034,
        "end": 18040
      },
      "text": "བདེ་བ་ ༼སྣར། པེ།༽ བདེ་བ་བདེན་པ་"
    },
    {
      "span": {
        "start": 18069,
        "end": 18075
      },
      "text": "རྟོགས་ ༼སྣར། པེ།༽ རྟོག་"
    },
    {
      "span": {
        "start": 18155,
        "end": 18162
      },
      "text": "འདུག་པ་ ༼ཅོ།༽ འདུག་"
    },
    {
      "span": {
        "start": 18446,
        "end": 18452
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 18455,
        "end": 18462
      },
      "text": "བདེན་པ་ ༼སྣར། པེ།༽ དབེན་པ་"
    },
    {
      "span": {
        "start": 18961,
        "end": 18969
      },
      "text": "གཞན་འགའ་ ༼སྣར།༽ གཞན་དག་ལ་ ༼པེ།༽ དགའ་"
    }
  ]
}