{
  "durchens": [
    {
      "span": {
        "start": 262,
        "end": 273
      },
      "text": "རང་བཞིན་ནི་ ༼སྣར། པེ།༽ རང་བཞིན་"
    },
    {
      "span": {
        "start": 564,
        "end": 569
      },
      "text": "ལས་མ་ ༼སྣར། པེ།༽ ལ་མ་"
    },
    {
      "span": {
        "start": 617,
        "end": 621
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདི་དེ་"
    },
    {
      "span": {
        "start": 857,
        "end": 865
      },
      "text": "དེ་ལྟ་མ་ ༼སྣར། པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 1096,
        "end": 1104
      },
      "text": "ལྕེ་རྩེ་ ༼སྣར། པེ།༽ ལྕེ་"
    },
    {
      "span": {
        "start": 1190,
        "end": 1260
      },
      "text": "ཚོགས་པ་ཡང་མེད། རྒྱུ་དང་རྐྱེན་ཚོགས་པ་ལ་ཡང་མེད། རྒྱུ་དང་རྐྱེན་ཚོགས་པ་ལས་ ༼སྣར། པེ།༽ ཚོགས་པ་ལ་"
    },
    {
      "span": {
        "start": 1420,
        "end": 1425
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 1459,
        "end": 1472
      },
      "text": "སྲེག་པར་བྱེད་ ༼སྣར། པེ།༽ སྲེག་པར་"
    },
    {
      "span": {
        "start": 1475,
        "end": 1482
      },
      "text": "ནུས་སོ། ༼སྣར། པེ།༽ ནུས་ལ།"
    },
    {
      "span": {
        "start": 1503,
        "end": 1510
      },
      "text": "གཅད་པར་ ༼སྣར། པེ།༽ བཅད་པར་"
    },
    {
      "span": {
        "start": 1606,
        "end": 1611
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 1732,
        "end": 1742
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 2153,
        "end": 2163
      },
      "text": "ཅིའི་ཕྱིར་ ༼སྣར།༽ ཅིའི་ཕྱིར་ཞེ་ན་"
    },
    {
      "span": {
        "start": 2243,
        "end": 2250
      },
      "text": "ཐམས་ཅད་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 2436,
        "end": 2440
      },
      "text": "ཚིག་ ༼སྣར། པེ།༽ ཚིགས་"
    },
    {
      "span": {
        "start": 2485,
        "end": 2492
      },
      "text": "ཕྱིར། ། ༼སྣར། པེ།༽ ཕྱིརལ།"
    },
    {
      "span": {
        "start": 2497,
        "end": 2505
      },
      "text": "པ་ངེས་པ་ ༼སྣར། པེ།༽ པའི་ཕྱིར་དེས་"
    },
    {
      "span": {
        "start": 2606,
        "end": 2612
      },
      "text": "འཐད་པ་ ༼སྣར། པེ།༽ འཐད་པ་མ་"
    },
    {
      "span": {
        "start": 2650,
        "end": 2654
      },
      "text": "ཡིན་ ༼སྣར། པེ།༽ ཡིན་ནོ་"
    },
    {
      "span": {
        "start": 2726,
        "end": 2733
      },
      "text": "དེས་ནི་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 2787,
        "end": 2789
      },
      "text": "ལ། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 2790,
        "end": 2797
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 2888,
        "end": 2896
      },
      "text": "བསྡུས་པ་ ༼སྡེ།༽ འདུས་པ་"
    },
    {
      "span": {
        "start": 3440,
        "end": 3459
      },
      "text": "ནི་སྟོང་། ཁ་ཅིག་ནི་ ༼སྣར།༽ ནི་"
    },
    {
      "span": {
        "start": 3632,
        "end": 3640
      },
      "text": "བརྟན་པས་ ༼སྣར། པེ།༽ བསྟན་པས་"
    },
    {
      "span": {
        "start": 3893,
        "end": 3896
      },
      "text": "ཏེ། ༼སྣར། པེ།༽ པ་ན་"
    },
    {
      "span": {
        "start": 3905,
        "end": 3914
      },
      "text": "སྒྲ་ཟློག་ ༼སྣར། པེ།༽ སྒྲ་དེ་བཟློག་"
    },
    {
      "span": {
        "start": 4023,
        "end": 4028
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 4036,
        "end": 4045
      },
      "text": "དོ་སྙམ་ན། ༼སྣར། པེ།༽ དོ་"
    },
    {
      "span": {
        "start": 4059,
        "end": 4066
      },
      "text": "དེར་ཡང་ ༼སྣར། པེ།༽ དེ་ཡང་"
    },
    {
      "span": {
        "start": 4144,
        "end": 4152
      },
      "text": "འདིར་ནི་ ༼སྣར། པེ།༽ འདིར་"
    },
    {
      "span": {
        "start": 4363,
        "end": 4375
      },
      "text": "མཐུན་པར་སྒྲ་ ༼སྣར། པེ།༽ མཐུན་པར་"
    },
    {
      "span": {
        "start": 4447,
        "end": 4460
      },
      "text": "དེ་ལྟ་བས་ནའང་ ༼སྣར། པེ།༽ དེ་ལྟ་ན་ཡང་"
    },
    {
      "span": {
        "start": 4767,
        "end": 4784
      },
      "text": "མཚན་ཉིད་ཀྱིས་འདི་ ༼སྣར། པེ།༽ མཚན་ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 4810,
        "end": 4813
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་ལ་དེ་"
    },
    {
      "span": {
        "start": 4953,
        "end": 4958
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 5065,
        "end": 5078
      },
      "text": "མངོན་སུམ་གྱི་ ༼སྣར། པེ།༽ མངོན་སུམ་གྱིས་"
    },
    {
      "span": {
        "start": 5118,
        "end": 5123
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 5139,
        "end": 5147
      },
      "text": "རུང་ངོ་། ༼སྣར། པེ།༽ རུང་ན།"
    },
    {
      "span": {
        "start": 5312,
        "end": 5319
      },
      "text": "ཡིན་ནོ། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 5326,
        "end": 5344
      },
      "text": "ཕྱིར་མངོན་སུམ་གྱི་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 5516,
        "end": 5526
      },
      "text": "དཔེས་སེམས་ ༼སྣར། པེ།༽ དཔེས་"
    },
    {
      "span": {
        "start": 5561,
        "end": 5566
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 5577,
        "end": 5581
      },
      "text": "སྙམ་ ༼སྣར།༽ སྙོམ་"
    },
    {
      "span": {
        "start": 5654,
        "end": 5665
      },
      "text": "གིས་བསྒྲུབ་ ༼སྣར། པེ།༽ གི་སྒྲུབ་"
    },
    {
      "span": {
        "start": 5679,
        "end": 5686
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 6121,
        "end": 6130
      },
      "text": "སྟོང་པ་མ་ ༼སྣར། པེ།༽ སྟོང་པ་"
    },
    {
      "span": {
        "start": 6559,
        "end": 6561
      },
      "text": "ལ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 6641,
        "end": 6650
      },
      "text": "བཅུ་དགུར་ ༼སྣར། པེ།༽ བཅུ་དགུ་"
    },
    {
      "span": {
        "start": 6713,
        "end": 6720
      },
      "text": "སེམས་པ་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 6969,
        "end": 6983
      },
      "text": "རྨོངས་པ་མེད་པ་ ༼སྣར།༽ རྨོངས་འབྲལ་ ༼པེ།༽ རྨོངས་འབྲེལ་"
    },
    {
      "span": {
        "start": 6988,
        "end": 6995
      },
      "text": "སྤྲོ་བ་ ༼སྣར། པེ།༽ སྤྲོས་པ་"
    },
    {
      "span": {
        "start": 7000,
        "end": 7007
      },
      "text": "གནོད་པ་ ༼སྣར།༽ གནོས་པ་"
    },
    {
      "span": {
        "start": 7141,
        "end": 7153
      },
      "text": "རྨོངས་འབྲེལ་ ༼སྣར། པེ།༽ རྨོངས་པ་མེད་པ་དང་། མི་རྩོལ་བ་"
    },
    {
      "span": {
        "start": 7307,
        "end": 7312
      },
      "text": "རྒ་བ་ ༼སྣར། པེ།༽ དགའ་བ་"
    },
    {
      "span": {
        "start": 7336,
        "end": 7344
      },
      "text": "གདུངས་པ་ ༼སྣར། པེ།༽ གདུང་བ་"
    },
    {
      "span": {
        "start": 7402,
        "end": 7408
      },
      "text": "པ་དང་། ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 7463,
        "end": 7470
      },
      "text": "བཟུང་བ་ ༼སྣར། པེ།༽ གཟུང་བ་"
    },
    {
      "span": {
        "start": 7589,
        "end": 7596
      },
      "text": "རྒོད་པ་ ༼པེ།༽ རྒོལ་བ་"
    },
    {
      "span": {
        "start": 7629,
        "end": 7636
      },
      "text": "འགུལ་བ་ ༼སྣར། པེ།༽ མགུལ་བ་"
    },
    {
      "span": {
        "start": 7757,
        "end": 7766
      },
      "text": "འཁྲུགས་པ་ ༼སྣར། པེ།༽ འཁྲུག་པ་"
    },
    {
      "span": {
        "start": 7824,
        "end": 7830
      },
      "text": "པ་དང་། ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 7965,
        "end": 7969
      },
      "text": "རྟབ་ ༼སྣར། པེ།༽ རྟགས་"
    },
    {
      "span": {
        "start": 8024,
        "end": 8031
      },
      "text": "བརྟག་པ་ ༼སྣར། པེ།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 8060,
        "end": 8068
      },
      "text": "གདུངས་པ་ ༼སྣར། པེ།༽ གདུང་བ་"
    },
    {
      "span": {
        "start": 8297,
        "end": 8301
      },
      "text": "དགའ་ ༼སྣར། པེ།༽ དགྲ་"
    },
    {
      "span": {
        "start": 8381,
        "end": 8388
      },
      "text": "གདུག་པ་ ༼སྣར།༽ བཏུགས་པ་ ༼པེ།༽ གཏུགས་པ་"
    },
    {
      "span": {
        "start": 8418,
        "end": 8425
      },
      "text": "སྤངས་པ་ ༼སྣར། པེ།༽ སྤོང་བ་"
    },
    {
      "span": {
        "start": 8734,
        "end": 8742
      },
      "text": "བསྒྲིབས་ ༼སྣར།༽ བསྒྲིབ་"
    },
    {
      "span": {
        "start": 8845,
        "end": 8853
      },
      "text": "བསྒྲིབས་ ༼སྣར། པེ།༽ སྒྲིབས་"
    },
    {
      "span": {
        "start": 9198,
        "end": 9208
      },
      "text": "བསྒོམས་པས་ ༼སྣར། པེ།༽ བསྒོམ་པས་"
    },
    {
      "span": {
        "start": 9227,
        "end": 9237
      },
      "text": "བསྒོམས་པས་ ༼སྣར། པེ།༽ བསྒོམ་པས་"
    },
    {
      "span": {
        "start": 10445,
        "end": 10449
      },
      "text": "མེད་ ༼སྣར། པེ།༽ མེད་པ་ཡིན་ནོ། །དེ་ལ་རང་བཞིན་མེད་"
    },
    {
      "span": {
        "start": 10672,
        "end": 10680
      },
      "text": "དེ་བས་ན་ ༼སྣར། པེ།༽ དེ་བས་"
    },
    {
      "span": {
        "start": 11016,
        "end": 11021
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམས་ལ་"
    },
    {
      "span": {
        "start": 11049,
        "end": 11057
      },
      "text": "སྟོང་པར་ ༼སྣར། པེ།༽ སྟོང་པར་འགྲུབ་པར་"
    },
    {
      "span": {
        "start": 11155,
        "end": 11157
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་མ་"
    },
    {
      "span": {
        "start": 11864,
        "end": 11874
      },
      "text": "ཇི་ལྟར་རང་ ༼སྣར།༽ ཇི་ལྟ་རང་ ༼པེ།༽ ཇི་ལྟར་དེ་"
    },
    {
      "span": {
        "start": 12003,
        "end": 12008
      },
      "text": "ན་ནི། ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 12017,
        "end": 12032
      },
      "text": "ཐམས་ཅད་རང་བཞིན་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 12059,
        "end": 12069
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 12298,
        "end": 12305
      },
      "text": "ཡོད་པར་ ༼སྣར། པེ།༽ ཡོད་པ་"
    },
    {
      "span": {
        "start": 12311,
        "end": 12318
      },
      "text": "དགག་པར་ ༼སྣར། པེ།༽ འགག་པར་"
    },
    {
      "span": {
        "start": 12390,
        "end": 12393
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་ནི་"
    },
    {
      "span": {
        "start": 12507,
        "end": 12515
      },
      "text": "རང་བཞིན་ ༼སྣར། པེ།༽ རང་བཞིན་པ་"
    },
    {
      "span": {
        "start": 12536,
        "end": 12545
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 12698,
        "end": 12700
      },
      "text": "བ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 12724,
        "end": 12726
      },
      "text": "པ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 12955,
        "end": 12960
      },
      "text": "ཁྱེད་ ༼སྣར། པེ།༽ ཁྱོད་"
    },
    {
      "span": {
        "start": 13067,
        "end": 13075
      },
      "text": "ཕྱིར་དང་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 13138,
        "end": 13145
      },
      "text": "ཇི་སྟེ་ ༼སྣར། པེ།༽ ཅི་སྟེ་"
    },
    {
      "span": {
        "start": 13821,
        "end": 13828
      },
      "text": "དོན་ཏེ། ༼སྣར། པེ།༽ དོན་དེ།"
    },
    {
      "span": {
        "start": 13916,
        "end": 13925
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 13946,
        "end": 13954
      },
      "text": "དེ་ཅིའི་ ༼སྣར། པེ།༽ ཅིའི་"
    },
    {
      "span": {
        "start": 14123,
        "end": 14128
      },
      "text": "གང་ལ་ ༼སྣར། པེ།༽ ག་ལ་"
    },
    {
      "span": {
        "start": 14442,
        "end": 14449
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 14772,
        "end": 14788
      },
      "text": "དེ་ལྟ་ན་ནི་དངོས་ ༼སྣར། པེ།༽ དངོས་"
    },
    {
      "span": {
        "start": 14956,
        "end": 14960
      },
      "text": "ཕྱི་ ༼སྣར། པེ།༽ འཕྱི་"
    },
    {
      "span": {
        "start": 14988,
        "end": 14993
      },
      "text": "འཕྱི་ ༼སྣར། པེ།༽ དགག་པར་བྱ་བ་ཡོད་པ་མ་ཡིན་ན་ཅི་ཞིག་ལ་འགོག་པར་བྱེད། འཆི་"
    },
    {
      "span": {
        "start": 14997,
        "end": 15007
      },
      "text": "ཅིག་ཅར་འང་ ༼སྣར། པེ།༽ ཅིག་ཅར་"
    },
    {
      "span": {
        "start": 15158,
        "end": 15167
      },
      "text": "འགྱུར་རོ། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 15200,
        "end": 15208
      },
      "text": "བྱ་བ་ནི་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 15219,
        "end": 15226
      },
      "text": "དེ་འཐད་ ༼སྣར། པེ།༽ འཐད་"
    },
    {
      "span": {
        "start": 15312,
        "end": 15321
      },
      "text": "འགོག་མཉམ་ ༼སྣར། པེ།༽ མགོ་མཉམ་"
    },
    {
      "span": {
        "start": 15599,
        "end": 15603
      },
      "text": "ཞེས་ ༼སྣར། པེ།༽ ཞེས་སྨྲས་"
    },
    {
      "span": {
        "start": 15722,
        "end": 15727
      },
      "text": "ཚིགས་ ༼སྣར། པེ།༽ ཚིག་"
    },
    {
      "span": {
        "start": 15857,
        "end": 15859
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 15888,
        "end": 15893
      },
      "text": "གྲུབ་ ༼སྣར། པེ།༽ འགྲུབ་"
    },
    {
      "span": {
        "start": 16161,
        "end": 16165
      },
      "text": "མེད། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 16187,
        "end": 16221
      },
      "text": "ལ་ཡང་མེད། རྒྱུ་དང་རྐྱེན་ཚོགས་པ་ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 16229,
        "end": 16231
      },
      "text": "པ་ ༼སྣར།༽ པར་"
    },
    {
      "span": {
        "start": 16334,
        "end": 16341
      },
      "text": "ཚིག་དེ་ ༼སྣར། པེ།༽ ཚིག་སྟེ་"
    },
    {
      "span": {
        "start": 16544,
        "end": 16549
      },
      "text": "ཀྱིས་ ༼སྣར། པེ།༽ ཀྱིས་ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 16674,
        "end": 16679
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 16682,
        "end": 16689
      },
      "text": "བྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 16730,
        "end": 16735
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 16829,
        "end": 16836
      },
      "text": "ཁོང་དུ་ ༼སྣར། པེ།༽ ཁོང་དུ་མ་"
    },
    {
      "span": {
        "start": 16979,
        "end": 16984
      },
      "text": "རྟེན་ ༼སྣར།༽ བརྟན་ ༼པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 17280,
        "end": 17282
      },
      "text": "པ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 17531,
        "end": 17540
      },
      "text": "སྟོང་པའོ་ ༼སྣར། པེ།༽ སྟོང་པ་"
    },
    {
      "span": {
        "start": 17655,
        "end": 17661
      },
      "text": "ཡིན་པ་ ༼སྣར། པེ།༽ ཡིན་ཡང་"
    },
    {
      "span": {
        "start": 17734,
        "end": 17740
      },
      "text": "ཉི་མས་ ༼སྣར། པེ།༽ ཉི་མ་"
    },
    {
      "span": {
        "start": 17757,
        "end": 17763
      },
      "text": "ནུས་པ་ ༼པེ།༽ ནུས་"
    },
    {
      "span": {
        "start": 17880,
        "end": 17889
      },
      "text": "སྒྲུབ་པར་ ༼སྣར། པེ།༽ བསྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 17985,
        "end": 17993
      },
      "text": "འཐད་པ་མ་ ༼སྣར། པེ།༽ འཐད་པ་"
    },
    {
      "span": {
        "start": 18082,
        "end": 18093
      },
      "text": "སྒྱུ་མ་ཡིས་ ༼སྣར། པེ།༽ སྒྱུ་མ་ཡི་"
    },
    {
      "span": {
        "start": 18096,
        "end": 18108
      },
      "text": "སྐྱེས་བུ་ཡི། ༼སྣར། པེ།༽ སྐྱེས་བུ་ཡིས།"
    },
    {
      "span": {
        "start": 18256,
        "end": 18264
      },
      "text": "འགོག་པར་ ༼སྣར། པེ།༽ འགོག་པ་"
    },
    {
      "span": {
        "start": 18645,
        "end": 18659
      },
      "text": "སྟོང་པ་ཉིད་དུ་ ༼སྣར། པེ།༽ སྟོང་པས་ཀྱང་"
    },
    {
      "span": {
        "start": 19687,
        "end": 19689
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 19854,
        "end": 19863
      },
      "text": "གཏན་ཚིགས་ ༼སྣར། པེ།༽ གཏན་ཚིག་"
    },
    {
      "span": {
        "start": 20035,
        "end": 20044
      },
      "text": "གཏན་ཚིགས་ ༼སྣར། པེ།༽ གཏན་ཚིགས་ཀྱི་"
    },
    {
      "span": {
        "start": 20155,
        "end": 20158
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 20183,
        "end": 20193
      },
      "text": "ཡོད་པ་ཡིས། ༼སྣར། པེ།༽ ཡོད་པ་ལས།"
    },
    {
      "span": {
        "start": 20297,
        "end": 20307
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 20486,
        "end": 20491
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 20516,
        "end": 20519
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེས་ནི་སྟོན་པ་"
    },
    {
      "span": {
        "start": 20566,
        "end": 20571
      },
      "text": "དཔེས་ ༼སྣར། པེ།༽ དཔེ་སྒྲས་"
    },
    {
      "span": {
        "start": 20575,
        "end": 20580
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 20869,
        "end": 20879
      },
      "text": "སྒྲས་ཟློག་ ༼སྣར། པེ།༽ སྒྲས་སྒྲ་བཟློག་"
    },
    {
      "span": {
        "start": 20925,
        "end": 20933
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར། པེ།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 20962,
        "end": 20967
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 20986,
        "end": 20994
      },
      "text": "དཔེ་འདི་ ༼སྣར། པེ།༽ དཔེ་"
    },
    {
      "span": {
        "start": 21042,
        "end": 21050
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར། པེ།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 21197,
        "end": 21205
      },
      "text": "བཀག་པའི་ ༼སྣར། པེ།༽ བཀག་པ་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 21333,
        "end": 21344
      },
      "text": "ཉིད་སྨྲ་ཡི། ༼སྣར། པེ།༽ ཉིད་དུ་སྨྲའི།"
    },
    {
      "span": {
        "start": 21383,
        "end": 21387
      },
      "text": "དཔེ་ ༼སྣར། པེ།༽ དཔེ་འདི་"
    },
    {
      "span": {
        "start": 21389,
        "end": 21396
      },
      "text": "ཡིན་ནོ། ༼སྣར། པེ།༽ ཡིན་པ་ཉིད་དོ།"
    },
    {
      "span": {
        "start": 21664,
        "end": 21673
      },
      "text": "དེས་དེའི་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 21789,
        "end": 21794
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 21944,
        "end": 21953
      },
      "text": "བཟློག་པར་ ༼སྡེ།༽ ཟློག་པར་"
    },
    {
      "span": {
        "start": 22123,
        "end": 22128
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 22147,
        "end": 22154
      },
      "text": "འཆད་པར་ ༼སྣར། པེ།༽ ཆད་པར་"
    },
    {
      "span": {
        "start": 22391,
        "end": 22396
      },
      "text": "ཕྱིར་ ༼སྣར། པེ།༽ ཕྱིར་དང་"
    },
    {
      "span": {
        "start": 22501,
        "end": 22508
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 22750,
        "end": 22752
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 22838,
        "end": 22844
      },
      "text": "དེ་ལྟ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 23176,
        "end": 23183
      },
      "text": "མེད་པས་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 23353,
        "end": 23355
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་ནི་"
    },
    {
      "span": {
        "start": 23455,
        "end": 23464
      },
      "text": "དམ་བཅས་པ་ ༼སྣར། པེ།༽ དམ་བཅས་པའང་"
    },
    {
      "span": {
        "start": 23606,
        "end": 23611
      },
      "text": "ཁྱོད་ ༼སྣར། པེ།༽ ཁྱོད་ཉིད་"
    },
    {
      "span": {
        "start": 23716,
        "end": 23721
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 23837,
        "end": 23845
      },
      "text": "ལུང་གིས་ ༼སྣར། པེ།༽ ལུང་གི་"
    },
    {
      "span": {
        "start": 24182,
        "end": 24198
      },
      "text": "ཞིག་གིས་འགའ་ཞིག་ ༼སྣར། པེ།༽ ཞིག་གིས་"
    },
    {
      "span": {
        "start": 24392,
        "end": 24394
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 24441,
        "end": 24446
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 24538,
        "end": 24544
      },
      "text": "སྨྲ་བ་ ༼སྣར། པེ།༽ སྨྲས་པ་"
    },
    {
      "span": {
        "start": 24605,
        "end": 24615
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 24655,
        "end": 24665
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 24781,
        "end": 24788
      },
      "text": "གཞལ་བར་ ༼སྣར། པེ།༽ གཞལ་"
    },
    {
      "span": {
        "start": 24908,
        "end": 24914
      },
      "text": "གཞལ་བ་ ༼སྣར། པེ།༽ འཇལ་བ་"
    },
    {
      "span": {
        "start": 25267,
        "end": 25270
      },
      "text": "ཡང་ ༼སྣར།༽ ལྟར་ན་ ༼པེ།༽ ལྟ་ན་"
    },
    {
      "span": {
        "start": 25387,
        "end": 25389
      },
      "text": "ལ། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 25416,
        "end": 25422
      },
      "text": "ཐུག་པ་ ༼སྣར། པེ།༽ ཐུག་པར་"
    },
    {
      "span": {
        "start": 25429,
        "end": 25436
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 25539,
        "end": 25541
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལ་དེ་རྣམས་ཀྱང་གཞན་རྣམས་ཀྱིས་ཡིན་ཞིང་།"
    },
    {
      "span": {
        "start": 25700,
        "end": 25710
      },
      "text": "འགྲུབ་པའོ་ ༼སྣར། པེ།༽ འགྲུབ་པོ་"
    },
    {
      "span": {
        "start": 25888,
        "end": 25899
      },
      "text": "རྣམས་རབ་ཏུ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 26001,
        "end": 26010
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 26063,
        "end": 26066
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 26355,
        "end": 26359
      },
      "text": "འདི་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 26538,
        "end": 26548
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ནི་"
    },
    {
      "span": {
        "start": 26807,
        "end": 26811
      },
      "text": "ཁུང་ ༼སྣར། པེ།༽ ཁོང་"
    },
    {
      "span": {
        "start": 26898,
        "end": 26907
      },
      "text": "རྣམས་ཀྱང་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 27011,
        "end": 27014
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 27045,
        "end": 27051
      },
      "text": "མེ་མི་ ༼སྣར། པེ།༽ མེ་མ་"
    },
    {
      "span": {
        "start": 27087,
        "end": 27095
      },
      "text": "དམིགས་པ་ ༼སྣར། པེ།༽ དམིགས་"
    },
    {
      "span": {
        "start": 27365,
        "end": 27373
      },
      "text": "འདིས་རང་ ༼སྣར། པེ།༽ འདི་རང་"
    },
    {
      "span": {
        "start": 27470,
        "end": 27474
      },
      "text": "མེས་ ༼སྣར། པེ།༽ མེ་"
    },
    {
      "span": {
        "start": 27653,
        "end": 27659
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 27697,
        "end": 27705
      },
      "text": "བདག་ཉིད་ ༼སྣར། པེ།༽ བདག་ཉིད་བཞིན་དུ་རང་གི་བདག་ཉིད་"
    },
    {
      "span": {
        "start": 27873,
        "end": 27883
      },
      "text": "བསྒྲིབ་པར་ ༼སྣར། པེ།༽ སྒྲིབ་པར་"
    },
    {
      "span": {
        "start": 27992,
        "end": 28005
      },
      "text": "གྱུར་པ་མུན་པ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 28035,
        "end": 28045
      },
      "text": "བསྒྲིབ་པར་ ༼སྣར། པེ།༽ སྒྲིབ་པར་"
    },
    {
      "span": {
        "start": 28060,
        "end": 28066
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 28102,
        "end": 28111
      },
      "text": "གཞན་གྱིས་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 28334,
        "end": 28339
      },
      "text": "ན་མེ་ ༼པེ།༽ ན་"
    },
    {
      "span": {
        "start": 28345,
        "end": 28350
      },
      "text": "དེ་ན་ ༼སྣར།༽ དེ་"
    },
    {
      "span": {
        "start": 28644,
        "end": 28653
      },
      "text": "མེད་པ་དེ་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 28686,
        "end": 28700
      },
      "text": "བདག་ཉིད་གཉི་ག་ ༼སྣར། པེ།༽ བདག་ཉིད་གཉིས་"
    },
    {
      "span": {
        "start": 28754,
        "end": 28760
      },
      "text": "བསལ་བ་ ༼སྣར། པེ།༽ གསལ་བ་"
    },
    {
      "span": {
        "start": 29153,
        "end": 29165
      },
      "text": "འབྱུང་བ་ཉིད་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 29589,
        "end": 29592
      },
      "text": "དང་ ༼སྣར། པེ།༽ དང་མ་"
    },
    {
      "span": {
        "start": 29640,
        "end": 29643
      },
      "text": "དེ་ ༼སྣར། པེ།༽ ད་"
    },
    {
      "span": {
        "start": 29938,
        "end": 29943
      },
      "text": "འདིར། ༼སྣར། པེ།༽ འདི།"
    },
    {
      "span": {
        "start": 30139,
        "end": 30146
      },
      "text": "ལྟོས་པ་ ༼སྣར།༽ བསྟོས་པ་ ༼པེ།༽ བལྟོས་པ་"
    },
    {
      "span": {
        "start": 30234,
        "end": 30241
      },
      "text": "བྱ་བའི་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 30250,
        "end": 30255
      },
      "text": "ལ་ནི། ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 30259,
        "end": 30264
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 30305,
        "end": 30314
      },
      "text": "གཞལ་བྱའི་ ༼སྣར། པེ།༽ གཞལ་བྱ་"
    },
    {
      "span": {
        "start": 30380,
        "end": 30388
      },
      "text": "གང་གིའང་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 30486,
        "end": 30494
      },
      "text": "དེ་ལྟ་ན་ ༼སྣར། པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 30497,
        "end": 30507
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 30816,
        "end": 30823
      },
      "text": "གཞལ་བར་ ༼སྣར། པེ།༽ གསལ་བར་"
    },
    {
      "span": {
        "start": 30859,
        "end": 30867
      },
      "text": "འགྲུབ་པ་ ༼པེ།༽ འགྲུབ་པ་མ་"
    },
    {
      "span": {
        "start": 30936,
        "end": 30945
      },
      "text": "ལྷ་སྦྱིན་ ༼སྣར། པེ།༽ ལྷས་བྱིན་"
    },
    {
      "span": {
        "start": 30988,
        "end": 30998
      },
      "text": "ཁྱོད་ཀྱིས་ ༼སྣར། པེ།༽ ཁྱེད་ཀྱི་"
    },
    {
      "span": {
        "start": 31003,
        "end": 31021
      },
      "text": "གཞི་འགྱུར་བ་འགྲུབ་ ༼སྣར།༽ གཞི་གྲུབ་པས་སྒྲུབ་ ༼པེ།༽ བཞི་གྲུབ་པས་སྒྲུབ་"
    },
    {
      "span": {
        "start": 31147,
        "end": 31163
      },
      "text": "གཞལ་བྱ་ལ། །ལྟོས་ ༼སྣར། པེ།༽ གཞལ་བྱ་ལས་བལྟོས་"
    },
    {
      "span": {
        "start": 31194,
        "end": 31198
      },
      "text": "ལ་མ་ ༼སྣར། པེ།༽ ལས་མ་"
    },
    {
      "span": {
        "start": 31198,
        "end": 31203
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 31322,
        "end": 31334
      },
      "text": "བྱ་བ་མ་གྲུབ་ ༼སྣར། པེ།༽ བྱ་བ་འགྲུབ་"
    },
    {
      "span": {
        "start": 31401,
        "end": 31410
      },
      "text": "སྒྲུབ་པར་ ༼པེ།༽ བསྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 31426,
        "end": 31436
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 31467,
        "end": 31474
      },
      "text": "ཡིན་ནོ་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 31713,
        "end": 31721
      },
      "text": "བརྟག་པས་ ༼སྣར། པེ།༽ བརྟགས་པས་"
    },
    {
      "span": {
        "start": 31792,
        "end": 31801
      },
      "text": "བརྟག་པའི་ ༼སྣར། པེ།༽ བརྟགས་པའི་"
    },
    {
      "span": {
        "start": 31815,
        "end": 31827
      },
      "text": "དོན་དེ་རྣམས་ ༼སྣར། པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 31961,
        "end": 31968
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 32242,
        "end": 32251
      },
