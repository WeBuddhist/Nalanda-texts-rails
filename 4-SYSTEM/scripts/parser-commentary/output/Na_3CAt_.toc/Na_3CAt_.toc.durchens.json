        "end": 44919
      },
      "text": "མེད་པར་ཡང་སྟེ་ ༼སྣར། པེ།༽ མེད་པར་ཡང་"
    },
    {
      "span": {
        "start": 45329,
        "end": 45337
      },
      "text": "ཆེན་པོས་ ༼སྣར། པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 45382,
        "end": 45388
      },
      "text": "དབབ་ལ་ ༼སྣར། པེ།༽ དབབ་པ་"
    },
    {
      "span": {
        "start": 45853,
        "end": 45857
      },
      "text": "ལ་མ་ ༼སྣར། པེ།༽ ལ་ཡང་"
    },
    {
      "span": {
        "start": 45971,
        "end": 45984
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་"
    },
    {
      "span": {
        "start": 46017,
        "end": 46023
      },
      "text": "དེ་དང་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 46230,
        "end": 46239
      },
      "text": "བཟློག་པར་ ༼སྣར། པེ།༽ ཟློག་པར་"
    },
    {
      "span": {
        "start": 46298,
        "end": 46306
      },
      "text": "ནམ་མཁའི་ ༼སྣར། པེ།༽ ནམ་མཁའ་"
    },
    {
      "span": {
        "start": 46461,
        "end": 46468
      },
      "text": "གཟུང་བ་ ༼སྣར། པེ།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 46517,
        "end": 46526
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 46538,
        "end": 46543
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 46705,
        "end": 46710
      },
      "text": "གང་ལ་ ༼སྣར། པེ།༽ ག་ལ་"
    },
    {
      "span": {
        "start": 46710,
        "end": 46717
      },
      "text": "ཡོད་དོ་ ༼སྣར། པེ།༽ འདོད་དེ་"
    },
    {
      "span": {
        "start": 47142,
        "end": 47145
      },
      "text": "སྔ་ ༼སྣར། པེ།༽ ལྔ་"
    },
    {
      "span": {
        "start": 47178,
        "end": 47180
      },
      "text": "ལ། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 47318,
        "end": 47327
      },
      "text": "ཁྱེད་ཀྱི་ ༼སྣར། པེ།༽ ཕྱེད་ཀྱིས་"
    },
    {
      "span": {
        "start": 47448,
        "end": 47458
      },
      "text": "ཕྱིར་ཞེ་ན་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 48110,
        "end": 48117
      },
      "text": "ཡིན་པས་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 48275,
        "end": 48283
      },
      "text": "དུས་ཀྱི་ ༼སྣར། པེ།༽ དུས་"
    },
    {
      "span": {
        "start": 48293,
        "end": 48308
      },
      "text": "སློབ་དཔོན་གྱིས་ ༼སྣར། པེ།༽ སློབ་དཔོན་གྱི་"
    },
    {
      "span": {
        "start": 48438,
        "end": 48445
      },
      "text": "ཟིན་ཏོ། ༼སྣར། པེ།༽ ཟིན་ནོ།"
    },
    {
      "span": {
        "start": 48463,
        "end": 48466
      },
      "text": "ལྟ་ ༼སྣར།༽ ལ་"
    },
    {
      "span": {
        "start": 48560,
        "end": 48565
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ ཚུལ་"
    },
    {
      "span": {
        "start": 48818,
        "end": 48823
      },
      "text": "གང་ལ་ ༼སྣར། པེ།༽ གང་ལ་སྟོང་པ་ཉིད་"
    },
    {
      "span": {
        "start": 48927,
        "end": 48935
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 49153,
        "end": 49159
      },
      "text": "ཡིན་པ་ ༼སྣར།༽ མིན་པ་"
    },
    {
      "span": {
        "start": 49420,
        "end": 49426
      },
      "text": "གཞག་པ་ ༼སྣར།༽ བཞག་པ་"
    },
    {
      "span": {
        "start": 49572,
        "end": 49581
      },
      "text": "འགྲོ་བའི་ ༼སྣར། པེ།༽ འདའ་བའི་"
    },
    {
      "span": {
        "start": 49624,
        "end": 49630
      },
      "text": "གཞག་པ་ ༼སྣར། པེ།༽ བཞག་པ་"
    },
    {
      "span": {
        "start": 49683,
        "end": 49690
      },
      "text": "རང་གིས་ ༼སྣར། པེ།༽ རང་གི་"
    },
    {
      "span": {
        "start": 49899,
        "end": 49916
      },
      "text": "སློབ་དཔོན་འཕགས་པ་ ༼སྣར། པེ།༽ སློབ་དཔོན་"
    },
    {
      "span": {
        "start": 49934,
        "end": 49947
      },
      "text": "རྫོགས་སོ།། །། ༼སྣར། པེ།༽ རྫོགས་སོཡོད་"
    },
    {
      "span": {
        "start": 49951,
        "end": 49954
      },
      "text": "དམ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 50167,
        "end": 50172
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 50321,
        "end": 50330
      },
      "text": "ཕབ་པ།། །། ༼སྣར། པེ།༽ ཕབ་པཔ"
    }
  ]
}