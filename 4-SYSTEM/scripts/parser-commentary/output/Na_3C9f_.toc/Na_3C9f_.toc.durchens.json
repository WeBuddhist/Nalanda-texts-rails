{
  "durchens": [
    {
      "span": {
        "start": 519,
        "end": 534
      },
      "text": "དངོས་པོ་ཐམས་ཅད་ ༼སྣར། པེ།༽ དངོས་པོ་"
    },
    {
      "span": {
        "start": 719,
        "end": 726
      },
      "text": "བྱེད་པ་ ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 975,
        "end": 986
      },
      "text": "ཞིང་བདག་ཏུ་ ༼སྣར། པེ།༽ ཞིང་བདག་དང་"
    },
    {
      "span": {
        "start": 1412,
        "end": 1417
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམས་དངོས་པོ་རྣམས་"
    },
    {
      "span": {
        "start": 2005,
        "end": 2011
      },
      "text": "རྣམ་པ་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 2129,
        "end": 2134
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 2699,
        "end": 2733
      },
      "text": "ཕུང་པོ་ནི་ཚོར་བའི་ཕུང་པོས་སྟོང་ངོ་ ༼སྣར། པེ།༽ ཕུང་པོའོ་"
    },
    {
      "span": {
        "start": 3211,
        "end": 3218
      },
      "text": "སེམས་པ་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 4241,
        "end": 4244
      },
      "text": "ཡང་ ༼སྣར། པེ།༽ ཡང་ཤེས་པར་བྱའོ། །ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཡང་"
    },
    {
      "span": {
        "start": 4719,
        "end": 4726
      },
      "text": "དགག་པར་ ༼སྣར། པེ།༽ དག་པར་"
    },
    {
      "span": {
        "start": 5789,
        "end": 5795
      },
      "text": "བར་དུ་ ༼སྣར། པེ།༽ བར་ན་"
    },
    {
      "span": {
        "start": 6061,
        "end": 6069
      },
      "text": "མཉམ་ཉིད་ ༼སྣར། པེ།༽ མཉམ་པ་ཉིད་"
    },
    {
      "span": {
        "start": 6679,
        "end": 6707
      },
      "text": "། །སེམས་ཀྱང་དེའི་རང་བཞིན་ནོ་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 6748,
        "end": 6754
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པའི་"
    },
    {
      "span": {
        "start": 6794,
        "end": 6800
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པའི་"
    },
    {
      "span": {
        "start": 6833,
        "end": 6841
      },
      "text": "འགགས་པར་ ༼སྣར། པེ།༽ འགག་པར་"
    },
    {
      "span": {
        "start": 7031,
        "end": 7042
      },
      "text": "བདག་པོ་ཆོས་ ༼སྣར། པེ།༽ བདག་པོ་"
    },
    {
      "span": {
        "start": 7276,
        "end": 7280
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱི་མཚན་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 7347,
        "end": 7352
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ བཞིན་མ་"
    },
    {
      "span": {
        "start": 7404,
        "end": 7414
      },
      "text": "འདི་དག་ནི་ ༼སྣར། པེ།༽ འདི་དག་"
    },
    {
      "span": {
        "start": 7474,
        "end": 7482
      },
      "text": "གཏོགས་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 8096,
        "end": 8098
      },
      "text": "ཛ་ ༼སྣར། པེ།༽ ཛཱ་"
    }
  ]
}