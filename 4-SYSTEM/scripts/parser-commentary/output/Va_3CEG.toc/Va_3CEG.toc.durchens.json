{
  "durchens": [
    {
      "span": {
        "start": 163,
        "end": 168
      },
      "text": "འཛིན་ ༼པེ།༽ མཛད་"
    },
    {
      "span": {
        "start": 315,
        "end": 322
      },
      "text": "གནང་བས་ ༼སྣར།༽ གནས་པའི་ ༼པེ།༽ གནང་བའི་"
    },
    {
      "span": {
        "start": 728,
        "end": 732
      },
      "text": "བའི་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 878,
        "end": 888
      },
      "text": "སྒོ་ནས་ནི་ ༼སྣར། པེ།༽ སྒོ་ནས་"
    },
    {
      "span": {
        "start": 908,
        "end": 915
      },
      "text": "དོན་ནོ། ༼སྣར། པེ།༽ དོན་ཏོ།"
    },
    {
      "span": {
        "start": 1556,
        "end": 1566
      },
      "text": "སྨོས་པ་ཡང་ ༼སྣར། པེ།༽ སྨོས་པ་"
    },
    {
      "span": {
        "start": 1696,
        "end": 1705
      },
      "text": "བརྗོད་ནས། ༼སྣར། པེ།༽ བརྗོད་ན།"
    },
    {
      "span": {
        "start": 1706,
        "end": 1716
      },
      "text": "གང་ཞིག་གང་ ༼སྣར། པེ།༽ གང་ཞིག་"
    },
    {
      "span": {
        "start": 1829,
        "end": 1838
      },
      "text": "ཕྱེ་བ་ནི་ ༼སྣར། པེ།༽ ཕྱེ་བའི་"
    },
    {
      "span": {
        "start": 1849,
        "end": 1858
      },
      "text": "དེ་ལ་ཆོས་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 1918,
        "end": 1928
      },
      "text": "འཁོར་བ་ནི་ ༼སྣར། པེ།༽ འཁོར་བ་"
    },
    {
      "span": {
        "start": 2012,
        "end": 2022
      },
      "text": "གསུམ་གྱིས་ ༼སྣར། པེ།༽ གསུམ་གྱི་"
    },
    {
      "span": {
        "start": 2146,
        "end": 2149
      },
      "text": "ཡང་ ༼སྣར། པེ།༽ ཡང་ན་"
    },
    {
      "span": {
        "start": 2200,
        "end": 2210
      },
      "text": "གསུམ་གྱིས་ ༼སྣར། པེ།༽ གསུམ་གྱི་"
    },
    {
      "span": {
        "start": 2476,
        "end": 2482
      },
      "text": "འདིའི་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 2703,
        "end": 2717
      },
      "text": "མངོན་པར་བརྗོད་ ༼སྣར། པེ།༽ མངོན་"
    },
    {
      "span": {
        "start": 2885,
        "end": 2900
      },
      "text": "བརྗོད་པར་སྣང་བ་ ༼སྣར། པེ།༽ བརྗོད་པ་"
    },
    {
      "span": {
        "start": 3073,
        "end": 3078
      },
      "text": "དང་མ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 3082,
        "end": 3085
      },
      "text": "པར་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 3105,
        "end": 3108
      },
      "text": "དག་ ༼སྣར། པེ།༽ དག་པ་"
    },
    {
      "span": {
        "start": 3205,
        "end": 3212
      },
      "text": "ཡིན་ཏེ། ༼སྣར། པེ།༽ ཡིན་པ།"
    },
    {
      "span": {
        "start": 3213,
        "end": 3222
      },
      "text": "ཀུན་ཏུའི་ ༼སྣར། པེ།༽ ཀུན་ཏུ་"
    },
    {
      "span": {
        "start": 3242,
        "end": 3248
      },
      "text": "དག་གི་ ༼སྣར། པེ།༽ དག་གིས་"
    },
    {
      "span": {
        "start": 4008,
        "end": 4016
      },
      "text": "རྗོད་པར་ ༼པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 4050,
        "end": 4055
      },
      "text": "རྗོད་ ༼པེ།༽ བརྗོད་"
    },
    {
      "span": {
        "start": 4404,
        "end": 4411
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 4795,
        "end": 4803
      },
      "text": "ཡིན་པ་ལ་ ༼སྣར། པེ།༽ ཡིན་པ་"
    },
    {
      "span": {
        "start": 4849,
        "end": 4853
      },
      "text": "མེད་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 4876,
        "end": 4883
      },
      "text": "གཞན་ཡང་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 4938,
        "end": 4941
      },
      "text": "གོ་ ༼སྣར། པེ།༽ གོ་དེ་ལ་ཡོད་པ་ཡང་མི་སྣང་བའི་ཕྱིར་རོ་"
    },
    {
      "span": {
        "start": 5016,
        "end": 5024
      },
      "text": "མཐོ་ཡོར་ ༼སྣར། པེ།༽ ཐོ་ཡོར་"
    },
    {
      "span": {
        "start": 5059,
        "end": 5074
      },
      "text": "སྣང་བ་དང་སྣང་བ་ ༼སྣར། པེ།༽ སྣང་བ་"
    },
    {
      "span": {
        "start": 5121,
        "end": 5133
      },
      "text": "འཇིག་རྟེན་ན་ ༼སྣར། པེ།༽ འཇིག་རྟེན་"
    },
    {
      "span": {
        "start": 5282,
        "end": 5301
      },
      "text": "དང་། མ་འཁྲུལ་པ་དང་། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 5634,
        "end": 5650
      },
      "text": "རྒྱུ་ཅན་ཡིན་པའི་ ༼སྣར། པེ།༽ རྒྱུ་ཅན་"
    },
    {
      "span": {
        "start": 5854,
        "end": 5860
      },
      "text": "ཁོ་ནར་ ༼སྣར། པེ།༽ ཁོ་ནས་"
    },
    {
      "span": {
        "start": 5898,
        "end": 5908
      },
      "text": "མེད་པ་མེད་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 6145,
        "end": 6153
      },
      "text": "མཐོ་ཡོར་ ༼སྣར། པེ།༽ ཐོ་ཡོར་"
    },
    {
      "span": {
        "start": 6205,
        "end": 6210
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ གཉིས་པ་"
    },
    {
      "span": {
        "start": 6242,
        "end": 6250
      },
      "text": "ཆོས་ཀྱི་ ༼སྣར། པེ།༽ ཆོས་ཀྱིས་"
    },
    {
      "span": {
        "start": 6313,
        "end": 6317
      },
      "text": "ལྟར་ ༼སྣར། པེ།༽ ནི་དེ་ལྟ་"
    },
    {
      "span": {
        "start": 6344,
        "end": 6356
      },
      "text": "གཅིག་ཉིད་དུ་ ༼སྣར། པེ།༽ གཅིག་ཏུ་"
    },
    {
      "span": {
        "start": 6366,
        "end": 6374
      },
      "text": "བྱས་པའམ། ༼སྣར། པེ།༽ བྱ་བའམ།"
    },
    {
      "span": {
        "start": 6535,
        "end": 6546
      },
      "text": "ཆོས་ཉིད་དག་ ༼སྣར། པེ།༽ ཆོས་ཉིད་"
    },
    {
      "span": {
        "start": 6624,
        "end": 6631
      },
      "text": "དག་ཀྱང་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 6795,
        "end": 6799
      },
      "text": "ཡིན་ ༼སྣར། པེ།༽ མིན་"
    },
    {
      "span": {
        "start": 6821,
        "end": 6830
      },
      "text": "ཡོད་པ་དང་ ༼སྣར། པེ།༽ ཡོད་པ་"
    },
    {
      "span": {
        "start": 6868,
        "end": 6873
      },
      "text": "གྱུར། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 7102,
        "end": 7107
      },
      "text": "གཅིག་ ༼སྣར། པེ།༽ གཅིག་ཉིད་"
    },
    {
      "span": {
        "start": 7142,
        "end": 7149
      },
      "text": "ཟིན་ཏོ། ༼སྣར།༽ ཟིན་ནོ།"
    },
    {
      "span": {
        "start": 7264,
        "end": 7273
      },
      "text": "དྲུག་གིས་ ༼སྣར། པེ།༽ དྲུག་གི་"
    },
    {
      "span": {
        "start": 7291,
        "end": 7297
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པ་ཡིན་ཏེ་"
    },
    {
      "span": {
        "start": 7306,
        "end": 7313
      },
      "text": "ཡིན་ཏེ། ༼སྣར། པེ།༽ ཡིན་པ་སྟེ།"
    },
    {
      "span": {
        "start": 7564,
        "end": 7572
      },
      "text": "སོ་སོ་བ་ ༼སྣར། པེ།༽ སོ་སོ་"
    },
    {
      "span": {
        "start": 7627,
        "end": 7631
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདི་དག་"
    },
    {
      "span": {
        "start": 7646,
        "end": 7654
      },
      "text": "བཞིན་དུ་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 8108,
        "end": 8111
      },
      "text": "དག་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 8216,
        "end": 8222
      },
      "text": "གནས་མ་ ༼སྣར། པེ།༽ གནས་པ་"
    },
    {
      "span": {
        "start": 8277,
        "end": 8280
      },
      "text": "གང་ ༼པེ།༽ གང་གང་"
    },
    {
      "span": {
        "start": 8372,
        "end": 8387
      },
      "text": "རྟེན་གྱི་ངོ་བོ་ ༼སྣར། པེ།༽ རྟེན་གྱི་"
    },
    {
      "span": {
        "start": 9088,
        "end": 9096
      },
      "text": "གསལ་བའི་ ༼སྣར། པེ།༽ བསལ་བའི་"
    },
    {
      "span": {
        "start": 9127,
        "end": 9133
      },
      "text": "ཇི་ལྟ་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 9343,
        "end": 9351
      },
      "text": "རིག་པའི་ ༼སྣར། པེ།༽ ཤེས་པའི་"
    },
    {
      "span": {
        "start": 9570,
        "end": 9612
      },
      "text": "ཕྱིར་དང་། སོ་སོར་རིག་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 9912,
        "end": 9922
      },
      "text": "དེ་ལས་ཀྱི་ ༼སྣར། པེ།༽ དེ་ལས་ཀྱིས་"
    },
    {
      "span": {
        "start": 9946,
        "end": 9975
      },
      "text": "། །འདིར་ནི་དགེ་བ་དང་མི་དགེ་བ་ ༼སྣར། པེ།༽ ། །འདི་ནི་དགེ་བ་"
    },
    {
      "span": {
        "start": 10028,
        "end": 10038
      },
      "text": "བྱས་པ་སྟེ་ ༼སྣར། པེ།༽ བྱས་ཏེ་"
    },
    {
      "span": {
        "start": 10401,
        "end": 10403
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 10443,
        "end": 10453
      },
      "text": "ཐུན་མོང་པ་ ༼སྣར། པེ།༽ ཐུན་མོང་མ་"
    },
    {
      "span": {
        "start": 10619,
        "end": 10627
      },
      "text": "སྣང་བའི་ ༼སྣར། པེ།༽ སྣང་བ་འཛིན་པའི་"
    },
    {
      "span": {
        "start": 10734,
        "end": 10742
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 10774,
        "end": 10788
      },
      "text": "ཕྱིར་སྣོད་ཀྱི་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 10846,
        "end": 10853
      },
      "text": "རྣམ་པར་ ༼སྣར། པེ།༽ རྣམ་པར་ཤེས་པ་"
    },
    {
      "span": {
        "start": 10990,
        "end": 10997
      },
      "text": "གཟུང་བ་ ༼སྣར། པེ།༽ གཟུང་བའི་"
    },
    {
      "span": {
        "start": 11102,
        "end": 11115
      },
      "text": "སེམས་དང་སེམས་ ༼སྣར། པེ།༽ སེམས་"
    },
    {
      "span": {
        "start": 11203,
        "end": 11209
      },
      "text": "གཉི་ག་ ༼སྣར། པེ།༽ གཉིས་གང་"
    },
    {
      "span": {
        "start": 11671,
        "end": 11680
      },
      "text": "འཛིན་གྱི་ ༼སྣར། པེ།༽ འཛིན་གྱིས་"
    },
    {
      "span": {
        "start": 11804,
        "end": 11810
      },
      "text": "དེ་ལྟ་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 11891,
        "end": 11899
      },
      "text": "དོན་མེད་ ༼སྣར། པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 12014,
        "end": 12020
      },
      "text": "མེད་ན་ ༼སྣར། པེ།༽ མེད་པ་ནི་"
    },
    {
      "span": {
        "start": 12159,
        "end": 12166
      },
      "text": "ཀུན་ནས་ ༼པེ།༽ ཀུན་ན་"
    },
    {
      "span": {
        "start": 12653,
        "end": 12662
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 12766,
        "end": 12775
      },
      "text": "ཟིན་ཏོ། ། ༼སྣར། པེ།༽ ཟིན་།། །།"
    },
    {
      "span": {
        "start": 12834,
        "end": 12848
      },
      "text": "དབང་དུ་བྱས་ཏེ་ ༼སྣར། པེ།༽ དབང་དུ་"
    },
    {
      "span": {
        "start": 13001,
        "end": 13035
      },
      "text": "དང་། རེག་པ་དང་། རྗེས་སུ་དྲན་པ་དང་། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 13052,
        "end": 13066
      },
      "text": "ཉེ་བར་སོན་པ་ལ་ ༼སྣར། པེ།༽ ཉེ་བར་སོང་བ་"
    },
    {
      "span": {
        "start": 13203,
        "end": 13215
      },
      "text": "དོ་ཞེས་བྱ་བ་ ༼སྣར། པེ།༽ དོ་ཞེས་"
    },
    {
      "span": {
        "start": 13279,
        "end": 13291
      },
      "text": "བཅུ་གཉིས་སུ་ ༼སྣར། པེ།༽ བཅུ་གཉིས་"
    },
    {
      "span": {
        "start": 13389,
        "end": 13400
      },
      "text": "དབྱངས་ཀྱིས་ ༼སྣར། པེ།༽ དབྱངས་ཀྱི་"
    },
    {
      "span": {
        "start": 14321,
        "end": 14331
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ སྒོམ་པའི་"
    },
    {
      "span": {
        "start": 14479,
        "end": 14482
      },
      "text": "ལམ་ ༼སྣར། པེ།༽ ལམ་ལ་"
    },
    {
      "span": {
        "start": 14517,
        "end": 14525
      },
      "text": "མངོན་དུ་ ༼སྣར། པེ།༽ མངོན་དུ་སུམ་"
    },
    {
      "span": {
        "start": 14534,
        "end": 14542
      },
      "text": "བྱེད་དོ། ༼སྣར། པེ།༽ བྱེད་དེ།"
    },
    {
      "span": {
        "start": 14898,
        "end": 14900
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལས།"
    },
    {
      "span": {
        "start": 14931,
        "end": 14946
      },
      "text": "ལྷག་མ་སྤངས་པའི་ ༼སྣར། པེ།༽ ལྷག་པ་སྤང་བའི་"
    },
    {
      "span": {
        "start": 15098,
        "end": 15139
      },
      "text": "གྱུར་པའི་ཕྱིར་ཏེ། དེ་ཙམ་དུ་ཡུལ་དུ་གྱུར་པ་ ༼སྣར། པེ།༽ གྱུར་པའི་"
    },
    {
      "span": {
        "start": 15342,
        "end": 15350
      },
      "text": "གྲུབ་པར་ ༼སྣར། པེ།༽ གྲུབ་པ་"
    },
    {
      "span": {
        "start": 15371,
        "end": 15380
      },
      "text": "སྤངས་པའི་ ༼སྣར། པེ།༽ སྤང་བའི་"
    },
    {
      "span": {
        "start": 15644,
        "end": 15651
      },
      "text": "ཁྱད་པར་ ༼པེ།༽ ཁྱབ་པར་"
    },
    {
      "span": {
        "start": 16394,
        "end": 16405
      },
      "text": "གྱུར་པ་སྟེ། ༼སྣར། པེ།༽ གྱུར་ཏེ།"
    },
    {
      "span": {
        "start": 16406,
        "end": 16411
      },
      "text": "དེའི་ ༼སྣར། པེ།༽ དེ་ལ་"
    },
    {
      "span": {
        "start": 16632,
        "end": 16676
      },
      "text": "གྱུར་པ་ཡིན་གྱི། གཞན་གྱི་ནི་མ་ཡིན་ཏེ་ཐུན་མོང་ ༼སྣར། པེ།༽ གྱུར་པར་འགྱུར་གྱི། བྱང་ཆུབ་སེམས་དཔའ་རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 16775,
        "end": 16784
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 16791,
        "end": 16794
      },
      "text": "པས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 16802,
        "end": 16812
      },
      "text": "བ་ཡིན་པའི་ ༼སྣར། པེ།༽ མ་ཡིན་པའི་"
    },
    {
      "span": {
        "start": 16827,
        "end": 16836
      },
      "text": "ཁྱད་པར་ལ་ ༼སྣར། པེ།༽ ཁྱད་པར་"
    },
    {
      "span": {
        "start": 16988,
        "end": 16993
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 16997,
        "end": 17005
      },
      "text": "ཡིན་གྱི་ ༼སྣར། པེ།༽ ཡིན་གྱིས་"
    },
    {
      "span": {
        "start": 17288,
        "end": 17297
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 17590,
        "end": 17598
      },
      "text": "ཆོས་ཀྱི་ ༼སྣར། པེ།༽ ཆོས་"
    },
    {
      "span": {
        "start": 17922,
        "end": 17931
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 18025,
        "end": 18037
      },
      "text": "སྨོན་ལམ་གྱི་ ༼སྣར། པེ།༽ སྨོན་ལམ་གྱིས་"
    },
    {
      "span": {
        "start": 18303,
        "end": 18311
      },
      "text": "སྤང་པའི་ ༼སྣར། པེ།༽ སྤངས་པའི་"
    },
    {
      "span": {
        "start": 18331,
        "end": 18341
      },
      "text": "བསྒོམ་པ་ལ་ ༼སྣར། པེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 18464,
        "end": 18474
      },
      "text": "འཇུག་པ་ནི་ ༼སྣར། པེ།༽ འཇུག་པ་"
    },
    {
      "span": {
        "start": 19042,
        "end": 19048
      },
      "text": "དེས་ན་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 19099,
        "end": 19106
      },
      "text": "སྤངས་པ་ ༼སྣར། པེ།༽ སྤང་བ་"
    },
    {
      "span": {
        "start": 19548,
        "end": 19567
      },
      "text": "མཚན་མ་སྤངས་པ་ལས་སོ། ༼སྣར། པེ།༽ མཚན་མའོ།"
    },
    {
      "span": {
        "start": 19569,
        "end": 19576
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 19943,
        "end": 19952
      },
      "text": "རྟོག་པའི་ ༼སྣར། པེ།༽ རྟོགས་པའི་"
    },
    {
      "span": {
        "start": 20078,
        "end": 20086
      },
      "text": "གཉིས་ཏེ། ༼སྣར། པེ།༽ བཞི་སྟེ།"
    },
    {
      "span": {
        "start": 20203,
        "end": 20211
      },
      "text": "ལས་སོ། ། ༼སྣར།༽ ལས་།། །།"
    },
    {
      "span": {
        "start": 20385,
        "end": 20390
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ གཉིས་པ་མི་གཉིས་"
    },
    {
      "span": {
        "start": 20814,
        "end": 20828
      },
      "text": "འཇིག་རྟེན་གྱི་ ༼སྣར། པེ།༽ འཇིག་རྟེན་"
    },
    {
      "span": {
        "start": 21100,
        "end": 21108
      },
      "text": "བཞིན་དུ་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 21292,
        "end": 21308
      },
      "text": "གནས་པས་ན་མི་གནས་ ༼སྣར། པེ།༽ གནས་"
    },
    {
      "span": {
        "start": 21483,
        "end": 21489
      },
      "text": "ལས་ནི་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 21537,
        "end": 21545
      },
      "text": "ཕྱིར་ཏེ། ༼སྣར། པེ།༽ ཕྱིར་རོ།"
    },
    {
      "span": {
        "start": 21626,
        "end": 21629
      },
      "text": "ལྟ་ ༼སྣར། པེ།༽ ལྟ་བུ་ལ་སོགས་པ་ལྟ་"
    },
    {
      "span": {
        "start": 21743,
        "end": 21750
      },
      "text": "བལྟ་བར་ ༼སྣར། པེ།༽ ལྟ་བར་"
    },
    {
      "span": {
        "start": 22936,
        "end": 22946
      },
      "text": "ཕྱིར་རོ། ། ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 22991,
        "end": 23000
      },
      "text": "བརྟགས་པར་ ༼སྣར། པེ།༽ བཏགས་པར་"
    },
    {
      "span": {
        "start": 23148,
        "end": 23153
      },
      "text": "མངོན་ ༼པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 23341,
        "end": 23348
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོག་"
    },
    {
      "span": {
        "start": 23631,
        "end": 23647
      },
      "text": "དེ་ཡིན་ན་ནི། དེ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 24216,
        "end": 24223
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོག་པའི་རྣམ་པ་"
    },
    {
      "span": {
        "start": 24331,
        "end": 24338
      },
      "text": "བྱེད་པ་ ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 24392,
        "end": 24399
      },
      "text": "རྣམ་པར་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 24408,
        "end": 24418
      },
      "text": "བརྗོད་པའི་ ༼སྣར། པེ།༽ རྗོད་པའི་"
    },
    {
      "span": {
        "start": 24693,
        "end": 24699
      },
      "text": "རྣམ་པ་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 24717,
        "end": 24727
      },
      "text": "ནི་ཁྱད་པར་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 24932,
        "end": 24945
      },
      "text": "བཅས་པ་ཡིན་ནོ། ༼སྣར། པེ།༽ བཅས་པའི་ཕྱིར་རོ།"
    },
    {
      "span": {
        "start": 25018,
        "end": 25026
      },
      "text": "ཕྱིར་རོ། ༼པེ།༽ ཕྱིར་ཏེ།"
    },
    {
      "span": {
        "start": 25142,
        "end": 25150
      },
      "text": "ཕྱིར་ཏེ། ༼སྣར། པེ།༽ ཕྱིར་རོ་"
    },
    {
      "span": {
        "start": 25194,
        "end": 25200
      },
      "text": "ཡོད་པ་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 25244,
        "end": 25254
      },
      "text": "ཕྱིར་རོ། ། ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 25419,
        "end": 25427
      },
      "text": "ཉེས་པ་ལ་ ༼སྣར།༽ ཉེས་པའི་"
    },
    {
      "span": {
        "start": 25595,
        "end": 25598
      },
      "text": "དག་ ༼སྣར། པེ།༽ དག་ནི་"
    },
    {
      "span": {
        "start": 25632,
        "end": 25641
      },
      "text": "གཏན་དུ་བ་ ༼སྣར། པེ།༽ གཏན་དུ་"
    },
    {
      "span": {
        "start": 25743,
        "end": 25752
      },
      "text": "མེད་པ་ནི་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 25766,
        "end": 25776
      },
      "text": "ཁྱད་པར་དུ་ ༼སྣར། པེ།༽ ཁྱད་པར་"
    },
    {
      "span": {
        "start": 25801,
        "end": 25804
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་ལ་"
    },
    {
      "span": {
        "start": 26334,
        "end": 26342
      },
      "text": "བྱེད་དེ། ༼སྣར། པེ།༽ བྱེད་དོ།"
    },
    {
      "span": {
        "start": 26508,
        "end": 26516
      },
      "text": "བྱེད་དེ། ༼སྣར། པེ།༽ བྱེད་དོ།"
    },
    {
      "span": {
        "start": 26620,
        "end": 26631
      },
      "text": "ཡུལ་ཅན་གྱི་ ༼པེ།༽ ཡུལ་ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 26652,
        "end": 26658
      },
      "text": "རྣམ་པ་ ༼པེ།༽ རྣམ་པ་པ་"
    },
    {
      "span": {
        "start": 26779,
        "end": 26784
      },
      "text": "གཏོང་ ༼སྣར། པེ།༽ གཏེར་"
    },
    {
      "span": {
        "start": 26797,
        "end": 26805
      },
      "text": "། །དེ་ལ་ ༼སྣར། པེ།༽ ། །དེས་"
    },
    {
      "span": {
        "start": 26840,
        "end": 26847
      },
      "text": "རྣམ་པར་ ༼སྣར།༽ རྣམ་"
    },
    {
      "span": {
        "start": 27173,
        "end": 27175
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 27218,
        "end": 27224
      },
      "text": "ཉིད་མ་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 27541,
        "end": 27548
      },
      "text": "སྣང་བས་ ༼སྣར། པེ།༽ སྣང་བ་"
    },
    {
      "span": {
        "start": 27562,
        "end": 27566
      },
      "text": "སྣང་ ༼སྣར། པེ།༽ སྣང་བཞི་"
    },
    {
      "span": {
        "start": 27623,
        "end": 27634
      },
      "text": "ཆོས་ཉིད་མི་ ༼སྣར། པེ།༽ ཆོས་ཉིད་"
    },
    {
      "span": {
        "start": 27898,
        "end": 27906
      },
      "text": "ཡིན་པའི་ ༼སྣར། པེ།༽ ཡིན་པ་"
    },
    {
      "span": {
        "start": 28242,
        "end": 28248
      },
      "text": "ཙམ་དུ་ ༼སྣར། པེ།༽ ཙམ་"
    },
    {
      "span": {
        "start": 28375,
        "end": 28381
      },
      "text": "རིག་པ་ ༼པེ།༽ རིག་པ་པ་"
    },
    {
      "span": {
        "start": 28417,
        "end": 28420
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 28638,
        "end": 28648
      },
      "text": "གཉིས་སོ། ། ༼སྣར། པེ།༽ གཉིས་པོ་"
    },
    {
      "span": {
        "start": 28953,
        "end": 28960
      },
      "text": "བྱེད་པ་ ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 29277,
        "end": 29283
      },
      "text": "མཚན་མ་ ༼སྣར། པེ།༽ མཚན་"
    },
    {
      "span": {
        "start": 29409,
        "end": 29415
      },
      "text": "སྦྱོར་ ༼སྣར། པེ།༽ སྤྱོད་"
    },
    {
      "span": {
        "start": 29593,
        "end": 29602
      },
      "text": "གང་ཡིན་པ་ ༼སྣར། པེ།༽ གང་ཡིན་པ་དེ་"
    },
    {
      "span": {
        "start": 30047,
        "end": 30053
      },
      "text": "རང་གི་ ༼སྣར། པེ།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 30189,
        "end": 30202
      },
      "text": "སངས་རྒྱས་ཀྱི་ ༼སྣར། པེ།༽ སངས་རྒྱས་ཀྱིས་"
    },
    {
      "span": {
        "start": 30741,
        "end": 30746
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་པ་"
    },
    {
      "span": {
        "start": 30754,
        "end": 30765
      },
      "text": "སྐྱེ་བའོ། ། ༼སྣར། པེ།༽ སྐྱེ་བའི་"
    },
    {
      "span": {
        "start": 30867,
        "end": 30871
      },
      "text": "ཡོད་ ༼སྣར། པེ།༽ ཡོད་པ་"
    },
    {
      "span": {
        "start": 31043,
        "end": 31049
      },
      "text": "བཅས་པ་ ༼སྣར། པེ།༽ བཅས་པར་"
    },
    {
      "span": {
        "start": 31160,
        "end": 31165
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམས་ལ་"
    },
    {
      "span": {
        "start": 31308,
        "end": 31316
      },
      "text": "གཉིས་པོ་ ༼སྣར། པེ།༽ གཉེན་པོ་"
    },
    {
      "span": {
        "start": 31439,
        "end": 31449
      },
      "text": "རྟེན་གཅིག་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 31778,
        "end": 31786
      },
      "text": "མེད་པའི་ ༼སྣར། པེ།༽ བྱེད་པའི་"
    },
    {
      "span": {
        "start": 31862,
        "end": 31870
      },
      "text": "བཟློག་པ་ ༼སྣར། པེ།༽ བཟློགས་པ་"
    },
    {
      "span": {
        "start": 32054,
        "end": 32063
      },
      "text": "ཟིན་ཏོ། ། ༼སྣར། པེ།༽ ཟིན་།། །།"
    },
    {
      "span": {
        "start": 32402,
        "end": 32411
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 32431,
        "end": 32440
      },
      "text": "བཅུས་གནས་ ༼སྣར། པེ།༽ བཅུས་"
    },
    {
      "span": {
        "start": 32532,
        "end": 32541
      },
      "text": "འགྱུར་བས་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 32618,
        "end": 32627
      },
      "text": "ཕྱིར་གནས་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 32916,
        "end": 32919
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 33009,
        "end": 33019
      },
      "text": "འོན་ཀྱང་མ་ ༼སྣར། པེ།༽ འོན་ཀྱང་མི་"
    },
    {
      "span": {
        "start": 33067,
        "end": 33079
      },
      "text": "དག་པར་དམིགས་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 33126,
        "end": 33131
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 33339,
        "end": 33346
      },
      "text": "དངས་པར་ ༼སྣར། པེ།༽ དང་བར་"
    },
    {
      "span": {
        "start": 33430,
        "end": 33435
      },
      "text": "ནི་མ་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 33528,
        "end": 33534
      },
      "text": "དངས་པ་ ༼སྣར། པེ།༽ དང་བ་"
    },
    {
      "span": {
        "start": 33725,
        "end": 33735
      },
      "text": "སྣང་བས་མི་ ༼སྣར། པེ།༽ སྣང་བས་"
    },
    {
      "span": {
        "start": 33783,
        "end": 33789
      },
      "text": "དངས་པ་ ༼སྣར། པེ།༽ དང་བ་"
    },
    {
      "span": {
        "start": 33834,
        "end": 33840
      },
      "text": "གང་ལས་ ༼སྣར། པེ།༽ གང་ལ་"
    },
    {
      "span": {
        "start": 33873,
        "end": 33880
      },
      "text": "སྣང་བར་ ༼སྣར། པེ།༽ རྣམ་པར་"
    },
    {
      "span": {
        "start": 33944,
        "end": 33947
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 34169,
        "end": 34178
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 34405,
        "end": 34410
      },
      "text": "།། །། ༼པེ།༽ །། །།སརྦ་མངྒཱ་ལམ་"
    }
  ]
}