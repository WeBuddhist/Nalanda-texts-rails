{
  "durchens": [
    {
      "span": {
        "start": 248,
        "end": 256
      },
      "text": "བསྙེན་པ་ ༼པེ།༽ སྙེན་པ་"
    },
    {
      "span": {
        "start": 315,
        "end": 319
      },
      "text": "གཏང་ ༼པེ།༽ བཏང་"
    },
    {
      "span": {
        "start": 775,
        "end": 779
      },
      "text": "དབུ་ ༼པེ།༽ དབུས་"
    },
    {
      "span": {
        "start": 1412,
        "end": 1424
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼པེ།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 1589,
        "end": 1598
      },
      "text": "བསྒོམས་པ་ ༼པེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 1780,
        "end": 1786
      },
      "text": "བརྒྱན་ ༼པེ།༽ རྒྱན་"
    },
    {
      "span": {
        "start": 4719,
        "end": 4724
      },
      "text": "རྔ་བ་ ༼པེ།༽ སྔ་བ་"
    },
    {
      "span": {
        "start": 4899,
        "end": 4904
      },
      "text": "ལྟའོ། ༼པེ།༽ བལྟའོ།"
    },
    {
      "span": {
        "start": 5154,
        "end": 5159
      },
      "text": "སློབ་ ༼པེ།༽ ཏཾསློབ་"
    },
    {
      "span": {
        "start": 5315,
        "end": 5318
      },
      "text": "བུ་ ༼པེ།༽ བྷུ་"
    },
    {
      "span": {
        "start": 5321,
        "end": 5323
      },
      "text": "ཕ་ ༼པེ།༽ པ་"
    },
    {
      "span": {
        "start": 6222,
        "end": 6232
      },
      "text": "རིགས་གཅིག་ ༼པེ།༽ རིགས་ཅིག་"
    }
  ]
}