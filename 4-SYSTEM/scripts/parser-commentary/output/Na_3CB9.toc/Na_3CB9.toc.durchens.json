        "end": 56582
      },
      "text": "དཔའ་བོས་ ༼སྣར། པེ།༽ དཔའ་བོ་"
    },
    {
      "span": {
        "start": 56653,
        "end": 56661
      },
      "text": "འདི་ལྟར་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 56734,
        "end": 56744
      },
      "text": "སློབ་ཕྱིར། ༼སྣར། པེ།༽ སློབ་ཅིང་།"
    },
    {
      "span": {
        "start": 57073,
        "end": 57081
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 57142,
        "end": 57153
      },
      "text": "སྤྱོད་ཕྱིར་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 57218,
        "end": 57226
      },
      "text": "སྒྲིབ་པ་ ༼སྣར། པེ།༽ སྒྲིབས་པ་"
    },
    {
      "span": {
        "start": 57575,
        "end": 57582
      },
      "text": "ཅན་གྱི་ ༼སྣར། པེ།༽ ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 57783,
        "end": 57788
      },
      "text": "ཅིག ། ༼སྣར། པེ།༽ ཅིང་། །"
    },
    {
      "span": {
        "start": 58352,
        "end": 58357
      },
      "text": "དྲ་བ་ ༼སྣར། པེ།༽ དྲ་བས་"
    },
    {
      "span": {
        "start": 59073,
        "end": 59075
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 59205,
        "end": 59209
      },
      "text": "དེས། ༼སྣར། པེ།༽ དེའི།"
    },
    {
      "span": {
        "start": 59317,
        "end": 59324
      },
      "text": "བཟང་པོ་ ༼སྣར། པེ།༽ བཟང་པོའི་"
    }
  ]
}