{
  "durchens": [
    {
      "span": {
        "start": 45,
        "end": 49
      },
      "text": "ན་མ་ ༼སྣར། པེ།༽ ནཱ་མ་"
    },
    {
      "span": {
        "start": 150,
        "end": 157
      },
      "text": "བཟང་པོ་ ༼སྣར།༽ བཟང་མོ་"
    },
    {
      "span": {
        "start": 568,
        "end": 570
      },
      "text": "པ་ ༼སྣར།༽ པས་"
    },
    {
      "span": {
        "start": 909,
        "end": 912
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 1283,
        "end": 1292
      },
      "text": "འདས་རྣམས་ ༼སྣར། པེ།༽ འདས་"
    },
    {
      "span": {
        "start": 1624,
        "end": 1634
      },
      "text": "ལུས་པ་ཡངས་ ༼སྣར། པེ།༽ ལུས་པ་"
    },
    {
      "span": {
        "start": 1642,
        "end": 1651
      },
      "text": "གཟུང་བའི་ ༼སྣར། པེ།༽ བཟུང་བའི་"
    },
    {
      "span": {
        "start": 1954,
        "end": 1956
      },
      "text": "པ་ ༼སྣར། པེ།༽ པས་"
    },
    {
      "span": {
        "start": 2007,
        "end": 2013
      },
      "text": "རབ་ཏུ་ ༼སྣར། པེ།༽ རབ་"
    },
    {
      "span": {
        "start": 2207,
        "end": 2215
      },
      "text": "བཏུད་པས། ༼སྣར།༽ བཏུད་པས་ནི།"
    },
    {
      "span": {
        "start": 2673,
        "end": 2679
      },
      "text": "ཅི་ཞེ་ ༼སྣར། པེ།༽ ཅི་ཞེས་"
    },
    {
      "span": {
        "start": 3150,
        "end": 3156
      },
      "text": "དེ་ནས་ ༼སྣར། པེ།༽ དེས་ན་"
    },
    {
      "span": {
        "start": 3204,
        "end": 3212
      },
      "text": "ཚུལ་གྱི་ ༼སྣར། པེ།༽ ཚུལ་གྱིས་"
    },
    {
      "span": {
        "start": 3373,
        "end": 3381
      },
      "text": "སྲས་ཀྱི་ ༼སྣར། པེ།༽ སྲས་ཀྱིས་"
    },
    {
      "span": {
        "start": 3416,
        "end": 3425
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་དཔའི་"
    },
    {
      "span": {
        "start": 3688,
        "end": 3695
      },
      "text": "སྟེང་ན་ ༼སྣར། པེ།༽ སྟེང་"
    },
    {
      "span": {
        "start": 3709,
        "end": 3722
      },
      "text": "འདི་ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ འདི་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 4112,
        "end": 4120
      },
      "text": "ཡིད་ཀྱི་ ༼སྣར། པེ།༽ ཡིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 4415,
        "end": 4423
      },
      "text": "མི་ཟད་པ་ ༼སྣར། པེ།༽ མི་ཟད་"
    },
    {
      "span": {
        "start": 4599,
        "end": 4609
      },
      "text": "རྒྱ་མཚོའི་ ༼སྣར། པེ།༽ རྒྱ་མཚོ་"
    },
    {
      "span": {
        "start": 4731,
        "end": 4733
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 4952,
        "end": 4988
      },
      "text": "དབྱངས་ཀྱི་ཡོན་ཏན་དང་ལྡན་པའི་སྒྲས་ཏེ་ ༼སྣར། པེ།༽ དབྱངས་ཀྱིཡན་ལག་དང་ལྡན་པའིསྒྲ་སྟེ་"
    },
    {
      "span": {
        "start": 5083,
        "end": 5085
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལས།"
    },
    {
      "span": {
        "start": 5094,
        "end": 5103
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 5234,
        "end": 5240
      },
      "text": "རབ་ཏུ་ ༼སྣར། པེ།༽ རབ་"
    },
    {
      "span": {
        "start": 5373,
        "end": 5381
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 5475,
        "end": 5480
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 5488,
        "end": 5492
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱིས་"
    },
    {
      "span": {
        "start": 5562,
        "end": 5571
      },
      "text": "རབ་བརྗོད་ ༼སྣར། པེ།༽ རབ་ཏུ་རྗོད་"
    },
    {
      "span": {
        "start": 5759,
        "end": 5766
      },
      "text": "ཡིན་ཏེ། ༼སྣར། པེ།༽ ཡིན།"
    },
    {
      "span": {
        "start": 6095,
        "end": 6100
      },
      "text": "ག་རུ་ ༼སྣར། པེ།༽ ཀ་རུ་"
    },
    {
      "span": {
        "start": 6149,
        "end": 6156
      },
      "text": "བཀོད་པ་ ༼སྣར། པེ།༽ བཀོད་པའི་"
    },
    {
      "span": {
        "start": 6349,
        "end": 6356
      },
      "text": "བགྱིའོ། ༼སྣར། པེ།༽ བགྱི་བའོ།"
    },
    {
      "span": {
        "start": 6571,
        "end": 6583
      },
      "text": "མཐར་ཐུག་པའི་ ༼སྣར། པེ།༽ མཐར་ཐུག་པས་"
    },
    {
      "span": {
        "start": 6641,
        "end": 6649
      },
      "text": "སྤྱོད་ལ་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 6934,
        "end": 6943
      },
      "text": "བསྡུས་པར་ ༼སྣར། པེ།༽ བསྡུས་པ་"
    },
    {
      "span": {
        "start": 7071,
        "end": 7075
      },
      "text": "གནས་ ༼སྣར། པེ།༽ གནས་པ་"
    },
    {
      "span": {
        "start": 7544,
        "end": 7567
      },
      "text": "རྣམས་ཀྱི་སྤྱན་སྔར་མངོན་ ༼སྣར། པེ།༽ རྣམས་ཀྱིམངོན་"
    },
    {
      "span": {
        "start": 7599,
        "end": 7604
      },
      "text": "ལ་འང་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 7656,
        "end": 7658
      },
      "text": "ད་ ༼སྣར།༽ དེ་"
    },
    {
      "span": {
        "start": 7802,
        "end": 7810
      },
      "text": "བསྒོམ་པ་ ༼པེ།༽ བསྒོམས་པ་"
    },
    {
      "span": {
        "start": 7923,
        "end": 7933
      },
      "text": "རང་རྒྱལ་བ་ ༼སྣར། པེ།༽ རང་རྒྱལ་"
    },
    {
      "span": {
        "start": 8514,
        "end": 8522
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 8529,
        "end": 8556
      },
      "text": "ཉིད་ཀྱིས་སློབ་པ་དང་མི་སློབ་ ༼སྣར། པེ།༽ ཉིད་ཀྱིསསློབ་"
    },
    {
      "span": {
        "start": 8678,
        "end": 8685
      },
      "text": "སྲིད་པ་ ༼སྣར། པེ།༽ སྲེད་པ་"
    },
    {
      "span": {
        "start": 8838,
        "end": 8847
      },
      "text": "བརྗོད་པར་ ༼སྣར།༽ བརྗོད་པར་པར་"
    },
    {
      "span": {
        "start": 8854,
        "end": 8861
      },
      "text": "ཡིན་ཏེ། ༼ཅོ།༽ ཡིན་ཏོ།"
    },
    {
      "span": {
        "start": 9181,
        "end": 9196
      },
      "text": "བྱང་ཆུབ་རིམ་པར་ ༼སྣར། པེ།༽ བྱང་ཆུབརྣམས་"
    },
    {
      "span": {
        "start": 9283,
        "end": 9293
      },
      "text": "ཆགས་བརྙེས་ ༼སྣར། པེ།༽ ཆགས་པས་སྙེས་"
    },
    {
      "span": {
        "start": 9424,
        "end": 9433
      },
      "text": "ཡང་དག་པར་ ༼སྣར། པེ།༽ ཡང་དག་"
    },
    {
      "span": {
        "start": 9453,
        "end": 9463
      },
      "text": "རྟོགས་པའི་ ༼སྣར། པེ།༽ རྟོགས་པ་ནི་"
    },
    {
      "span": {
        "start": 9775,
        "end": 9788
      },
      "text": "སྣང་བ་བྱ་བའི་ ༼སྣར། པེ།༽ སྣང་བབྱས་པའི་"
    },
    {
      "span": {
        "start": 9860,
        "end": 9866
      },
      "text": "བཙུགས་ ༼སྣར། པེ།༽ བརྩུགས་"
    },
    {
      "span": {
        "start": 9876,
        "end": 9883
      },
      "text": "སྦྱར་བ་ ༼སྣར། པེ།༽ སྦྱར་བར་"
    },
    {
      "span": {
        "start": 9971,
        "end": 9975
      },
      "text": "བའི་ ༼སྣར། པེ།༽ སྐོར་འི་"
    },
    {
      "span": {
        "start": 10006,
        "end": 10010
      },
      "text": "འདས་ ༼སྣར། པེ།༽ འདའ་"
    },
    {
      "span": {
        "start": 10214,
        "end": 10221
      },
      "text": "འདས་གང་ ༼སྣར། པེ།༽ འདས་"
    },
    {
      "span": {
        "start": 10354,
        "end": 10368
      },
      "text": "སྟེ་ཞུ་བ་འབུལ་ ༼སྣར། པེ།༽ སྟེ་ཞུབར་དབུལ་"
    },
    {
      "span": {
        "start": 10385,
        "end": 10388
      },
      "text": "དུ་ ༼སྣར། པེ།༽ དུ་ན་"
    },
    {
      "span": {
        "start": 10433,
        "end": 10443
      },
      "text": "རྟོགས་པའི་ ༼སྣར། པེ།༽ གཏོགས་པའི་"
    },
    {
      "span": {
        "start": 10650,
        "end": 10654
      },
      "text": "ཐོབ་ ༼སྣར། པེ།༽ འཐོབ་"
    },
    {
      "span": {
        "start": 10695,
        "end": 10699
      },
      "text": "ཐོབ་ ༼སྣར། པེ།༽ འཐོབ་"
    },
    {
      "span": {
        "start": 10747,
        "end": 10758
      },
      "text": "བསྐྱེད་པའི་ ༼སྣར། པེ།༽ སྐྱེས་པའི་"
    },
    {
      "span": {
        "start": 10800,
        "end": 10807
      },
      "text": "སྔོ་བར་ ༼སྣར། པེ།༽ བསྔོ་བར་"
    },
    {
      "span": {
        "start": 10998,
        "end": 11013
      },
      "text": "གཤེགས་པ་ལ་གསོལ་ ༼སྣར།༽ གཤེགས་པ་ལགསོལ་ ༼པེ།༽ གཤེགས་པ་ལསོགས་"
    },
    {
      "span": {
        "start": 11015,
        "end": 11023
      },
      "text": "བཏབ་པའི་ ༼སྣར། པེ།༽ བཏབ་པས་"
    },
    {
      "span": {
        "start": 11287,
        "end": 11293
      },
      "text": "རྣམ་པ་ ༼སྣར། པེ།༽ རྣམ་པ་བཅུ་"
    },
    {
      "span": {
        "start": 11494,
        "end": 11502
      },
      "text": "ཕྲད་པའི་ ༼སྣར། པེ།༽ འཕྲད་པའི་"
    },
    {
      "span": {
        "start": 12206,
        "end": 12213
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ ད་ལྟ་"
    },
    {
      "span": {
        "start": 12379,
        "end": 12386
      },
      "text": "རིམ་པར་ ༼སྣར། པེ།༽ རྣམ་པར་"
    },
    {
      "span": {
        "start": 12648,
        "end": 12652
      },
      "text": "བཅུ་ ༼སྣར། པེ།༽ བཅུའི་"
    },
    {
      "span": {
        "start": 12989,
        "end": 13018
      },
      "text": "མེད་པར་ཁྱབ་པར་ཤོག་ཅེས་བྱ་བའོ། ༼སྣར།༽ ཁྱབ་པར་ཤོག་ཅེསབྱའོ།"
    },
    {
      "span": {
        "start": 13155,
        "end": 13163
      },
      "text": "དྲུག་གི་ ༼སྣར། པེ།༽ དྲུག་གིས་"
    },
    {
      "span": {
        "start": 13368,
        "end": 13376
      },
      "text": "གྲུབ་པར་ ༼སྣར། པེ།༽ གྱུར་པར་"
    },
    {
      "span": {
        "start": 13390,
        "end": 13399
      },
      "text": "ཀུན་གྱིས་ ༼སྣར། པེ།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 13447,
        "end": 13455
      },
      "text": "ཡོངས་སུ་ ༼སྣར།༽ ཡོངས་"
    },
    {
      "span": {
        "start": 13502,
        "end": 13508
      },
      "text": "སྤང་བ་ ༼སྣར།༽ སྤངས་བ་"
    },
    {
      "span": {
        "start": 13610,
        "end": 13613
      },
      "text": "དག་ ༼སྣར།༽ དང་"
    },
    {
      "span": {
        "start": 13928,
        "end": 13945
      },
      "text": "སྐྱེ་བ་ནས་བདག་ནི་ ༼སྣར།༽ སྐྱེ་བན་བདག་ནི་ ༼པེ།༽ སྐྱེ་བནི་"
    },
    {
      "span": {
        "start": 14008,
        "end": 14013
      },
      "text": "གྱིས་ ༼པེ།༽ གྱིས་ན་བར་གྱིས་"
    },
    {
      "span": {
        "start": 14289,
        "end": 14291
      },
      "text": "པ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 14317,
        "end": 14333
      },
      "text": "རྫོགས་བྱེད་ཅིང་། ༼སྣར། པེ།༽ རྫོགས་བྱེད་པས།"
    },
    {
      "span": {
        "start": 14371,
        "end": 14381
      },
      "text": "ཅི་ཞིག་གི་ ༼སྣར། པེ།༽ ཅི་ཞིག་གིས་"
    },
    {
      "span": {
        "start": 14861,
        "end": 14870
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 15118,
        "end": 15124
      },
      "text": "སྐྱོན་ ༼སྣར། པེ།༽ སྐྱེན་"
    },
    {
      "span": {
        "start": 15154,
        "end": 15162
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ དབྱུང་བ་"
    },
    {
      "span": {
        "start": 15420,
        "end": 15425
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 15564,
        "end": 15572
      },
      "text": "སྟོན་པར་ ༼སྣར། པེ།༽ སྟེན་པར་"
    },
    {
      "span": {
        "start": 15644,
        "end": 15649
      },
      "text": "བཞིན་ ༼སྣར།༽ གཞིན་"
    },
    {
      "span": {
        "start": 15858,
        "end": 15865
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 16022,
        "end": 16033
      },
      "text": "ཉིད་ཀྱིས་ན་ ༼སྣར། པེ།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 16186,
        "end": 16190
      },
      "text": "དྲི་ ༼སྣར། པེ།༽ དྲི་མ་"
    },
    {
      "span": {
        "start": 16394,
        "end": 16406
      },
      "text": "སྐད་ཀྱིས་སོ། ༼སྣར། པེ།༽ སྐད་ཀྱིས།"
    },
    {
      "span": {
        "start": 16475,
        "end": 16483
      },
      "text": "ཀྱིས་སོ། ༼སྣར། པེ།༽ ཀྱིས་ཏེ།"
    },
    {
      "span": {
        "start": 16500,
        "end": 16508
      },
      "text": "ཀུན་གྱི་ ༼སྣར། པེ།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 16565,
        "end": 16577
      },
      "text": "བྱང་ཆུབ་ཀྱི་ ༼སྣར། པེ།༽ བྱང་ཆུབ་ཀྱིས་"
    },
    {
      "span": {
        "start": 16606,
        "end": 16615
      },
      "text": "བྱ་བ་འདི་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 16697,
        "end": 16703
      },
      "text": "ངེས་པ་ ༼སྣར། པེ།༽ ངེས་"
    },
    {
      "span": {
        "start": 16999,
        "end": 17013
      },
      "text": "འདི་དག་གིས་ནི་ ༼པེ།༽ འདི་དག་གིས་"
    },
    {
      "span": {
        "start": 17153,
        "end": 17179
      },
      "text": "མཐུན་པའི་ཕྱོགས་སྤང་བ་བསྟན་ ༼སྣར། པེ།༽ མཐུན་པའི་ཕྱོགསསྤོང་པ་སྟོན་"
    },
    {
      "span": {
        "start": 17367,
        "end": 17385
      },
      "text": "བྱང་བར་སྟེ་སྤང་བར་ ༼སྣར། པེ།༽ བྱང་བར་སྟེསྤངས་པར་"
    },
    {
      "span": {
        "start": 17592,
        "end": 17595
      },
      "text": "ལས་ ༼པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 17722,
        "end": 17731
      },
      "text": "བདུད་ཀྱི་ ༼སྣར།༽ བདུད་ཀྱིས་"
    },
    {
      "span": {
        "start": 17742,
        "end": 17752
      },
      "text": "གྲོལ་བ་ནི་ ༼སྣར། པེ།༽ གྲོལ་བ་"
    },
    {
      "span": {
        "start": 17961,
        "end": 17970
      },
      "text": "བདུད་ཀྱི་ ༼སྣར།༽ བདུད་ཀྱིས་"
    },
    {
      "span": {
        "start": 18109,
        "end": 18133
      },
      "text": "མི་ལྟོས་པར་དེ་བཞིན་འགྲོ་ ༼སྣར། པེ།༽ མི་བལྟོས་པརའགྲོ་"
    },
    {
      "span": {
        "start": 18152,
        "end": 18163
      },
      "text": "བསྒྲུབ་པའི་ ༼སྣར། པེ།༽ སྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 18452,
        "end": 18459
      },
      "text": "མཚན་མོ་ ༼སྣར། པེ།༽ མཚན་མོར་"
    },
    {
      "span": {
        "start": 18714,
        "end": 18722
      },
      "text": "དེའི་ལས་ ༼སྣར། པེ།༽ དེའི་ལམ་"
    },
    {
      "span": {
        "start": 18919,
        "end": 18929
      },
      "text": "གསུམ་གྱིས་ ༼སྣར། པེ།༽ གསུམ་གྱི་"
    },
    {
      "span": {
        "start": 18939,
        "end": 18952
      },
      "text": "ཐམས་ཅད་རབ་ཏུ་ ༼སྣར། པེ།༽ ཐམས་ཅདདང་"
    },
    {
      "span": {
        "start": 19034,
        "end": 19037
      },
      "text": "དག་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 19195,
        "end": 19202
      },
      "text": "འགྲོ་བ་ ༼སྣར། པེ།༽ འགྲོ་"
    },
    {
      "span": {
        "start": 19591,
        "end": 19601
      },
      "text": "བརྒྱུད་ལས་ ༼སྣར། པེ།༽ བརྒྱུད་མས་"
    },
    {
      "span": {
        "start": 19636,
        "end": 19642
      },
      "text": "ཕྱོགས་ ༼སྣར། པེ།༽ སྲོག་"
    },
    {
      "span": {
        "start": 20448,
        "end": 20451
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 20512,
        "end": 20520
      },
      "text": "བརྗོད་པ་ ༼པེ།༽ རྗོད་པ་"
    },
    {
      "span": {
        "start": 20523,
        "end": 20531
      },
      "text": "གསོལ་བར་ ༼སྣར། པེ།༽ གསལ་བར་"
    },
    {
      "span": {
        "start": 20754,
        "end": 20773
      },
      "text": "མཚུངས་པར་ལྡན་པ་ཞེས་ ༼སྣར། པེ།༽ མཚུངས་པརཞེས་"
    },
    {
      "span": {
        "start": 21089,
        "end": 21091
      },
      "text": "པ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 21122,
        "end": 21133
      },
      "text": "ཉོན་མོངས་པ་ ༼སྣར། པེ།༽ ཉོན་མོངས་"
    },
    {
      "span": {
        "start": 21199,
        "end": 21207
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 21305,
        "end": 21314
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 21499,
        "end": 21509
      },
      "text": "ཅིག་པའོ། ། ༼སྣར། པེ།༽ ཅིག །"
    },
    {
      "span": {
        "start": 21720,
        "end": 21729
      },
      "text": "གཤེགས་པར་ ༼སྣར། པེ།༽ གཤེགས་པ་"
    },
    {
      "span": {
        "start": 21744,
        "end": 21747
      },
      "text": "ནི། ༼པེ།༽ ན།"
    },
    {
      "span": {
        "start": 22141,
        "end": 22149
      },
      "text": "ནམ་མཁའི་ ༼སྣར། པེ།༽ ནམ་མཁའ་"
    },
    {
      "span": {
        "start": 22178,
        "end": 22187
      },
      "text": "ཆོས་ཀྱིས་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 22442,
        "end": 22451
      },
      "text": "འཛིན་པའི་ ༼སྣར། པེ།༽ འཛིན་པ་ནི་"
    },
    {
      "span": {
        "start": 22567,
        "end": 22572
      },
      "text": "གསུང་ ༼སྣར།༽ གསུངས་"
    },
    {
      "span": {
        "start": 22608,
        "end": 22614
      },
      "text": "གཟུངས་ ༼སྣར། པེ།༽ གཟུགས་"
    },
    {
      "span": {
        "start": 22637,
        "end": 22644
      },
      "text": "བྱེད་པ་ ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 22686,
        "end": 22699
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 22724,
        "end": 22747
      },
      "text": "ཀུན་དུ་སྣང་བར་བྱེད་ཅེས་ ༼སྣར། པེ།༽ ཀུན་དུསྣང་བྱེད་ཅིང་ཞེས་"
    },
    {
      "span": {
        "start": 22862,
        "end": 22869
      },
      "text": "བཟང་པོ་ ༼སྣར། པེ།༽ བཟང་པོར་"
    },
    {
      "span": {
        "start": 23423,
        "end": 23427
      },
      "text": "ཐབས་ ༼སྣར།༽ ཐབས་པ་"
    },
    {
      "span": {
        "start": 23552,
        "end": 23559
      },
      "text": "ཐར་པའི་ ༼སྣར། པེ།༽ ཐར་པ་"
    },
    {
      "span": {
        "start": 23621,
        "end": 23629
      },
      "text": "རྣམས་ནས་ ༼པེ།༽ རྣམས་ཞེས་"
    },
    {
      "span": {
        "start": 23781,
        "end": 23790
      },
      "text": "གྱུར་ཅིག་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 24052,
        "end": 24058
      },
      "text": "བལྟ་བ་ ༼སྣར། པེ།༽ ལྟ་བ་"
    },
    {
      "span": {
        "start": 24117,
        "end": 24126
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 24455,
        "end": 24471
      },
      "text": "ཞིང་དེ་རྣམས་དང་། ༼སྣར། པེ།༽ ཞིང་རྣམས་"
    },
    {
      "span": {
        "start": 24493,
        "end": 24500
      },
      "text": "དང་ཞིང་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 24802,
        "end": 24809
      },
      "text": "བལྟ་བར་ ༼སྣར། པེ།༽ ལྟ་བར་"
    },
    {
      "span": {
        "start": 25068,
        "end": 25075
      },
      "text": "སྟེང་ན་ ༼སྣར། པེ།༽ སྟེང་དུ་"
    },
    {
      "span": {
        "start": 25413,
        "end": 25422
      },
      "text": "བསམ་གྱིས་ ༼སྣར། པེ།༽ བསམ་གྱི་"
    },
    {
      "span": {
        "start": 25522,
        "end": 25533
      },
      "text": "དེ་བཞིན་དུ་ ༼སྣར། པེ།༽ དེ་བཞིན་"
    },
    {
      "span": {
        "start": 25553,
        "end": 25564
      },
      "text": "ཡེ་ཤེས་ཀྱི་ ༼སྣར། པེ།༽ ཡེ་ཤེས་ཀྱིས་"
    },
    {
      "span": {
        "start": 25582,
        "end": 25590
      },
      "text": "གཅིག་གི་ ༼སྣར། པེ།༽ གཅིག་གིས་"
    },
    {
      "span": {
        "start": 25731,
        "end": 25738
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 25857,
        "end": 25863
      },
      "text": "ཁྱབ་པ་ ༼སྣར། པེ།༽ ཁྱབ་པར་"
    },
    {
      "span": {
        "start": 25922,
        "end": 25928
      },
      "text": "དོན་མ་ ༼སྣར། པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 26090,
        "end": 26103
      },
      "text": "སངས་རྒྱས་ཀྱི་ ༼སྣར། པེ།༽ སངས་རྒྱས་ཀྱིས་"
    },
    {
      "span": {
        "start": 26245,
        "end": 26249
      },
      "text": "དངས་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 26541,
        "end": 26546
      },
      "text": "འདིར་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 26615,
        "end": 26620
      },
      "text": "ཕྱིར་ ༼སྣར། པེ།༽ ཕྱིས་"
    },
    {
      "span": {
        "start": 26712,
        "end": 26719
      },
      "text": "ཇི་ལྟར་ ༼སྣར། པེ།༽ ཇི་ལྟ་བ་"
    },
    {
      "span": {
        "start": 26837,
        "end": 26842
      },
      "text": "སྟེང་ ༼སྣར། པེ།༽ སྟོང་"
    },
    {
      "span": {
        "start": 27154,
        "end": 27164
      },
      "text": "རྣམས་ཀྱིས། ༼སྣར། པེ།༽ རྣམས་ལ།"
    },
    {
      "span": {
        "start": 27275,
        "end": 27280
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམས་ལ་"
    },
    {
      "span": {
        "start": 27550,
        "end": 27560
      },
      "text": "གང་ཡིན་པས་ ༼སྣར། པེ།༽ གང་ཡིན་པ་"
    },
    {
      "span": {
        "start": 27968,
        "end": 27977
      },
      "text": "ཀུན་གྱིས་ ༼སྣར། པེ།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 28179,
        "end": 28187
      },
      "text": "མེད་དང་། ༼སྣར། པེ།༽ མེད་པ།"
    },
    {
      "span": {
        "start": 28272,
        "end": 28281
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 28316,
        "end": 28331
      },
      "text": "ཀྱི་གནས་ཡིན་ནོ། ༼སྣར། པེ།༽ ཀྱི་གནསཔ་ཡིན།"
    },
    {
      "span": {
        "start": 28485,
        "end": 28490
      },
      "text": "གསུང་ ༼སྣར། པེ།༽ གསུངས་"
    },
    {
      "span": {
        "start": 28556,
        "end": 28570
      },
      "text": "བདུན་པའི་གཅིག་ ༼སྣར། པེ།༽ བདུནཔ་གཅིག་གི་"
    },
    {
      "span": {
        "start": 28574,
        "end": 28577
      },
      "text": "གི་ ༼སྣར། པེ།༽ གིས་"
    },
    {
      "span": {
        "start": 28604,
        "end": 28635
      },
      "text": "གིས་ནི་སྟེའི་སྒྲ་ཚིག་གི་ཁ་སྐོང་ ༼སྣར། པེ།༽ གིས་ནིཏེའི་སྒྲ་ཚིག་གིས་བསྐོང་"
    },
    {
      "span": {
        "start": 28719,
        "end": 28730
      },
      "text": "འཁོར་ལོ་ཡི། ༼སྣར། པེ།༽ འཁོར་ལོ་མི།"
    },
    {
      "span": {
        "start": 28893,
        "end": 28898
      },
      "text": "སྐོར་ ༼སྣར། པེ།༽ བསྐོར་"
    },
    {
      "span": {
        "start": 29059,
        "end": 29065
      },
      "text": "གང་དང་ ༼སྣར། པེ།༽ གང་དང་གང་"
    },
    {
      "span": {
        "start": 29166,
        "end": 29171
      },
      "text": "གདུལ་ ༼སྣར། པེ།༽ འདུལ་"
    },
    {
      "span": {
        "start": 29241,
        "end": 29245
      },
      "text": "གིས་ ༼སྣར། པེ།༽ ཚིགས་གི་"
    },
    {
      "span": {
        "start": 29252,
        "end": 29256
      },
      "text": "བའི་ ༼སྣར། པེ།༽ གི་"
    },
    {
      "span": {
        "start": 29323,
        "end": 29330
      },
      "text": "འཇུག་ལ། ༼སྣར། པེ།༽ འཇུག་པ།"
    },
    {
      "span": {
        "start": 29380,
        "end": 29390
      },
      "text": "གཏོགས་པའི་ ༼སྣར། པེ།༽ རྟོགས་པའི་"
    },
    {
      "span": {
        "start": 29437,
        "end": 29444
      },
      "text": "བསྐལ་པ་ ༼སྣར། པེ།༽ བསྐལ་པ་ལ་"
    },
    {
      "span": {
        "start": 29483,
        "end": 29491
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་ནི་"
    },
    {
      "span": {
        "start": 29565,
        "end": 29570
      },
      "text": "གྲངས་ ༼སྣར། པེ།༽ གྲགས་"
    },
    {
      "span": {
        "start": 29603,
        "end": 29614
      },
      "text": "སྐད་ཅིག་གི་ ༼སྣར། པེ།༽ སྐད་ཅིག་གིས་"
    },
    {
      "span": {
        "start": 29638,
        "end": 29646
      },
      "text": "གཅིག་གི་ ༼སྣར། པེ།༽ གཅིག་གིས་"
    },
    {
      "span": {
        "start": 29683,
        "end": 29688
      },
      "text": "ཞུགས་ ༼སྣར།༽ ཞུགས་སོ་"
    },
    {
      "span": {
        "start": 29935,
        "end": 29956
      },
      "text": "གཅིག་གིས་བདག་གིས་བལྟ་ ༼པེ།༽ གཅིག་གིསབལྟ་"
    },
    {
      "span": {
        "start": 30007,
        "end": 30015
      },
      "text": "སྒྱུ་མར་ ༼པེ།༽ སྒོ་མར་"
    },
    {
      "span": {
        "start": 30363,
        "end": 30374
      },
      "text": "སྟོབས་ཀྱིས་ ༼སྣར། པེ།༽ སྟོབས་"
    },
    {
      "span": {
        "start": 30681,
        "end": 30688
      },
      "text": "དབྱིབས་ ༼སྣར། པེ།༽ དབྱིངས་"
    },
    {
      "span": {
        "start": 30818,
        "end": 30826
      },
      "text": "བཞིན་དུ་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 30910,
        "end": 30916
      },
      "text": "གནས་པ་ ༼སྣར། པེ།༽ གནས་པར་"
    },
    {
      "span": {
        "start": 30933,
        "end": 30940
      },
      "text": "དེས་ནི་ ༼པེ།༽ དེས་ན་"
    },
    {
      "span": {
        "start": 31271,
        "end": 31278
      },
      "text": "ཏིང་ངེ་ ༼སྣར།༽ ཏིང་"
    },
    {
      "span": {
        "start": 31375,
        "end": 31377
      },
      "text": "ན་ ༼པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 31385,
        "end": 31393
      },
      "text": "སྒོམ་པར་ ༼སྣར། པེ།༽ བསྒོམས་པར་"
    },
    {
      "span": {
        "start": 31822,
        "end": 31826
      },
      "text": "ཡིན་ ༼སྣར།༽ མིན་"
    },
    {
      "span": {
        "start": 31966,
        "end": 31985
      },
      "text": "གཏུགས་པ་གཞན་དང་གཞན་ ༼སྣར། པེ།༽ གཏུགས་པགཞན་"
    },
    {
      "span": {
        "start": 32123,
        "end": 32134
      },
      "text": "བྱང་ཆུབ་ཏུ་ ༼སྣར། པེ།༽ བྱང་ཆུབ་"
    },
    {
      "span": {
        "start": 32863,
        "end": 32869
      },
      "text": "འཆིའོ་ ༼སྣར། པེ།༽ མཆིའོ་"
    },
    {
      "span": {
        "start": 33190,
        "end": 33197
      },
      "text": "ཞུགས་པ་ ༼སྣར། པེ།༽ བཞུགས་པ་"
    },
    {
      "span": {
        "start": 33202,
        "end": 33210
      },
      "text": "བལྟམས་པ་ ༼སྣར། པེ།༽ བལྟམ་པ་"
    },
    {
      "span": {
        "start": 33305,
        "end": 33311
      },
      "text": "དཀའ་བ་ ༼སྣར། པེ།༽ དགའ་བ་"
    },
    {
      "span": {
        "start": 33805,
        "end": 33811
      },
      "text": "ཏེ་ཡང་ ༼སྣར། པེ།༽ དེ་ཡང་"
    },
    {
      "span": {
        "start": 33817,
        "end": 33826
      },
      "text": "གྲུབ་ཅིང་ ༼པེ།༽ གྲུབ་ཅི་"
    },
    {
      "span": {
        "start": 34092,
        "end": 34101
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་དཔའི་"
    },
    {
      "span": {
        "start": 34105,
        "end": 34110
      },
      "text": "གྱིས་ ༼སྣར། པེ།༽ དུ་"
    },
    {
      "span": {
        "start": 34902,
        "end": 34909
      },
      "text": "ཐམས་ཅད་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱང་"
    },
    {
      "span": {
        "start": 35017,
        "end": 35040
      },
      "text": "གཉིས་ཀའི་སྟོབས་ཀྱིས་ཏེ། ༼སྣར། པེ།༽ གཉིས་ཀའི་སྟོབསཀྱི་སྟེ།"
    },
    {
      "span": {
        "start": 35290,
        "end": 35295
      },
      "text": "བཅུར་ ༼སྣར། པེ།༽ བཅུ་"
    },
    {
      "span": {
        "start": 35831,
        "end": 35841
      },
      "text": "སྟོབས་དེས་ ༼སྣར། པེ།༽ སྟོབས་"
    },
    {
      "span": {
        "start": 35921,
        "end": 35933
      },
      "text": "བསྒྲུབས་པའི་ ༼སྣར། པེ།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 36114,
        "end": 36122
      },
      "text": "དོན་གྱི་ ༼སྣར། པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 36130,
        "end": 36136
      },
      "text": "རྟོགས་ ༼སྣར། པེ།༽ སྟོབས་"
    },
    {
      "span": {
        "start": 36380,
        "end": 36388
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 36553,
        "end": 36559
      },
      "text": "ཡང་དག་ ༼སྣར། པེ།༽ ཡང་དག་པར་"
    },
    {
      "span": {
        "start": 36749,
        "end": 36756
      },
      "text": "ལོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 37059,
        "end": 37062
      },
      "text": "ཟད་ ༼སྣར། པེ།༽ བཟད་"
    },
    {
      "span": {
        "start": 37093,
        "end": 37097
      },
      "text": "སྲབ་ ༼ཅོ།༽ སྲེབ་ ༼སྣར། པེ།༽ སྲབས་"
    },
    {
      "span": {
        "start": 37113,
        "end": 37118
      },
      "text": "བཤགས་ ༼སྣར། པེ།༽ གཤགས་"
    },
    {
      "span": {
        "start": 37412,
        "end": 37423
      },
      "text": "ཅུང་ཟད་བྱས་ ༼སྣར། པེ།༽ ཅུང་ཟད་"
    },
    {
      "span": {
        "start": 37758,
        "end": 37766
      },
      "text": "དྲལ་བའི་ ༼སྣར། པེ།༽ བྲལ་བའི་"
    },
    {
      "span": {
        "start": 37810,
        "end": 37813
      },
      "text": "དག་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 37859,
        "end": 37865
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 38101,
        "end": 38110
      },
      "text": "མངོན་སུམ་ ༼སྣར། པེ།༽ མངོན་"
    },
    {
      "span": {
        "start": 38451,
        "end": 38453
      },
      "text": "མ་ ༼སྣར། པེ།༽ མི་"
    },
    {
      "span": {
        "start": 38974,
        "end": 38981
      },
      "text": "ཉིད་དུ་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 39372,
        "end": 39379
      },
      "text": "བྱེད་ལ་ ༼སྣར། པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 39407,
        "end": 39413
      },
      "text": "ནང་ནས་ ༼སྣར། པེ།༽ ནང་ན་"
    },
    {
      "span": {
        "start": 39548,
        "end": 39559
      },
      "text": "དགྲ་བཅོམ་མ་ ༼སྣར། པེ།༽ དགྲ་བཅོམ་པ་"
    },
    {
      "span": {
        "start": 39628,
        "end": 39634
      },
