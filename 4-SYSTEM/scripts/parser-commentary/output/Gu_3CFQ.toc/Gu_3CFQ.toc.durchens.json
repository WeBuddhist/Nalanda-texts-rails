{
  "durchens": [
    {
      "span": {
        "start": 252,
        "end": 257
      },
      "text": "ཕན་པ་ ༼སྣར། པེ།༽ ཕན་"
    },
    {
      "span": {
        "start": 313,
        "end": 325
      },
      "text": "སྙིང་བརྩེ་བ་ ༼སྣར། པེ།༽ སྙིང་བརྩེ་"
    },
    {
      "span": {
        "start": 437,
        "end": 458
      },
      "text": "གཉེར་བ་དང་དོན་དང་ལྡན་ ༼སྣར། པེ།༽ གཉེར་བ་དངལྡན་"
    },
    {
      "span": {
        "start": 564,
        "end": 570
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 645,
        "end": 653
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ བྱུང་བ་"
    },
    {
      "span": {
        "start": 806,
        "end": 818
      },
      "text": "སྙིང་བརྩེ་བ་ ༼སྣར། པེ།༽ སྙིང་བརྩེ་"
    },
    {
      "span": {
        "start": 930,
        "end": 937
      },
      "text": "བདག་ཅག་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 941,
        "end": 948
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ འདི་ལྟར་"
    },
    {
      "span": {
        "start": 982,
        "end": 988
      },
      "text": "དེ་ལྟ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 1100,
        "end": 1110
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ བསྒྲུབ་པར་བྱ་"
    },
    {
      "span": {
        "start": 1470,
        "end": 1479
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 1761,
        "end": 1779
      },
      "text": "ཐ་མལ་པ་གནས་པ་རྣམས་ ༼སྣར། པེ།༽ ཐ་མལ་པརྣམས་"
    },
    {
      "span": {
        "start": 1986,
        "end": 1992
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 2367,
        "end": 2375
      },
      "text": "འདིར་ནི་ ༼སྣར། པེ།༽ འདིར་"
    },
    {
      "span": {
        "start": 2732,
        "end": 2742
      },
      "text": "སྒྱུར་བའི་ ༼སྣར།༽ བསྒྱུར་བའི་"
    },
    {
      "span": {
        "start": 3080,
        "end": 3087
      },
      "text": "མཐོང་བ་ ༼སྣར། པེ།༽ མཐོང་"
    },
    {
      "span": {
        "start": 3281,
        "end": 3284
      },
      "text": "ཅན་ ༼སྣར། པེ།༽ ཅན་ཡིན་"
    },
    {
      "span": {
        "start": 3362,
        "end": 3368
      },
      "text": "རྣམ་པ་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 3471,
        "end": 3479
      },
      "text": "དག་པ་དང་ ༼སྣར། པེ།༽ དག་པ་"
    },
    {
      "span": {
        "start": 3598,
        "end": 3606
      },
      "text": "ཆོ་ག་དང་ ༼སྣར། པེ།༽ ཆོ་ག་"
    },
    {
      "span": {
        "start": 3653,
        "end": 3664
      },
      "text": "དེ་ཙམ་གྱིས་ ༼སྣར། པེ།༽ དེ་ཙམ་གྱི་"
    },
    {
      "span": {
        "start": 4097,
        "end": 4104
      },
      "text": "གང་ཡིན་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 4260,
        "end": 4267
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 4344,
        "end": 4351
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 4377,
        "end": 4386
      },
      "text": "མེད་པས་ན་ ༼སྣར། པེ།༽ མེད་པས་"
    },
    {
      "span": {
        "start": 4476,
        "end": 4483
      },
      "text": "རྣམས་ལ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 4626,
        "end": 4633
      },
      "text": "མེད་དོ། ༼སྣར། པེ།༽ མེད་དེ།"
    },
    {
      "span": {
        "start": 4841,
        "end": 4847
      },
      "text": "ཉེས་པ་ ༼སྣར། པེ།༽ ཉེས་པའི་"
    },
    {
      "span": {
        "start": 4947,
        "end": 4957
      },
      "text": "སྤྱོད་པའི་ ༼སྣར། པེ།༽ དཔྱོད་པའི་"
    },
    {
      "span": {
        "start": 5159,
        "end": 5165
      },
      "text": "དག་གི་ ༼སྣར། པེ།༽ དག་གིས་"
    },
    {
      "span": {
        "start": 5196,
        "end": 5201
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ གཉི་ག་"
    },
    {
      "span": {
        "start": 5333,
        "end": 5339
      },
      "text": "དང་ཡང་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 5509,
        "end": 5517
      },
      "text": "བདེ་བའི་ ༼སྣར། པེ།༽ དགེ་བའི་"
    },
    {
      "span": {
        "start": 5642,
        "end": 5663
      },
      "text": "ཡོངས་སུ་ཤེས་པ་ཡང་ཤེས་ ༼སྣར། པེ།༽ ཡོངས་སུཤེས་"
    },
    {
      "span": {
        "start": 5700,
        "end": 5704
      },
      "text": "དོན་ ༼སྣར། པེ།༽ དོན་གྱི་མདོ་ནི་"
    },
    {
      "span": {
        "start": 5975,
        "end": 5983
      },
      "text": "བསྡུམ་པ་ ༼སྣར། པེ།༽ སྡུམ་པ་"
    },
    {
      "span": {
        "start": 6035,
        "end": 6040
      },
      "text": "སྙོམ་ ༼སྣར། པེ།༽ སྙམ་"
    },
    {
      "span": {
        "start": 6527,
        "end": 6534
      },
      "text": "སྲུང་བ་ ༼སྣར། པེ།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 6537,
        "end": 6543
      },
      "text": "རང་གི་ ༼ཅོ།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 6593,
        "end": 6601
      },
      "text": "ཕྱིར་དང་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 6647,
        "end": 6659
      },
      "text": "སྡུག་བསྔལ་བ་ ༼སྣར། པེ།༽ སྡུག་བསྔལ་"
    },
    {
      "span": {
        "start": 6668,
        "end": 6677
      },
      "text": "གྲོགས་སུ་ ༼སྣར། པེ།༽ གྲོགས་ཀྱི་"
    },
    {
      "span": {
        "start": 7079,
        "end": 7106
      },
      "text": "། རྗེས་སུ་འཕྲོད་པ་རྣམས་དང་། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 7228,
        "end": 7236
      },
      "text": "ཚིག་འདི་ ༼སྣར། པེ།༽ ཚིག་"
    },
    {
      "span": {
        "start": 7239,
        "end": 7243
      },
      "text": "གིས་ ༼སྣར། པེ།༽ གི་"
    },
    {
      "span": {
        "start": 7310,
        "end": 7320
      },
      "text": "སྦྱོར་བའི་ ༼སྣར། པེ།༽ སྦྱར་བའི་"
    },
    {
      "span": {
        "start": 7406,
        "end": 7411
      },
      "text": "བསྟན་ ༼སྣར། པེ།༽ སྟོན་"
    },
    {
      "span": {
        "start": 7468,
        "end": 7476
      },
      "text": "ཆོས་ཉིད་ ༼སྣར། པེ།༽ ཆོས་"
    },
    {
      "span": {
        "start": 7515,
        "end": 7520
      },
      "text": "བསྟན་ ༼སྣར། པེ།༽ སྟོན་"
    },
    {
      "span": {
        "start": 7691,
        "end": 7699
      },
      "text": "སྟོན་ཏོ། ༼སྣར། པེ།༽ སྟོན་ཏེ།"
    },
    {
      "span": {
        "start": 8502,
        "end": 8523
      },
      "text": "གདབ་པར་བསྟན་པར་འགྱུར་ ༼སྣར། པེ།༽ གདབ་པརའགྱུར་"
    },
    {
      "span": {
        "start": 8662,
        "end": 8669
      },
      "text": "གདབ་པར་ ༼སྣར། པེ།༽ གདབ་པ་"
    },
    {
      "span": {
        "start": 9070,
        "end": 9078
      },
      "text": "ཅི་བཞིན་ ༼སྣར། པེ།༽ ཇི་བཞིན་"
    },
    {
      "span": {
        "start": 9511,
        "end": 9523
      },
      "text": "བྱེ་བྲག་གིས་ ༼སྣར། པེ།༽ བྱེ་བྲག་གི་"
    },
    {
      "span": {
        "start": 9736,
        "end": 9749
      },
      "text": "འཇིགས་པ་ཕྱིར་ ༼སྣར། པེ།༽ འཇིགས་པ་"
    },
    {
      "span": {
        "start": 9983,
        "end": 9993
      },
      "text": "མྱ་ངན་གྱི་ ༼སྣར། པེ།༽ མྱ་ངན་གྱིས་"
    },
    {
      "span": {
        "start": 9999,
        "end": 10020
      },
      "text": "པའི་དོན་ནི་མདོར་བསྡུ་ ༼སྣར། པེ།༽ པའི་དོནབསྡུ་"
    },
    {
      "span": {
        "start": 10071,
        "end": 10113
      },
      "text": "དང་ལོངས་སྤྱོད་ཀྱི་སྡུག་བསྔལ་ལས་གྱུར་པའོ། ། ༼སྣར། པེ།༽ དང །"
    },
    {
      "span": {
        "start": 10243,
        "end": 10250
      },
      "text": "བཟུང་བ་ ༼སྣར། པེ།༽ གཟུང་བ་"
    },
    {
      "span": {
        "start": 10255,
        "end": 10273
      },
      "text": "འབྲས་བུ་བུ་དང་ཆུང་ ༼སྣར། པེ།༽ འབྲས་བུཆུང་"
    },
    {
      "span": {
        "start": 10293,
        "end": 10297
      },
      "text": "བྲན་ ༼སྣར། པེ།༽ བྲན་པོ་"
    },
    {
      "span": {
        "start": 10422,
        "end": 10437
      },
      "text": "ལོངས་སྤྱོད་ཀྱི་ ༼སྣར། པེ།༽ ལོངས་སྤྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 10458,
        "end": 10469
      },
      "text": "ལོངས་སྤྱོད་ ༼སྣར། པེ།༽ ལོངས་སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 11284,
        "end": 11321
      },
      "text": "ཆོས་དང་ཟང་ཟིང་གཉིས་ཀྱིས་སོ། །དེ་ལ་ཟང་ ༼སྣར། པེ།༽ ཆོས་དངཟང་"
    },
    {
      "span": {
        "start": 11418,
        "end": 11427
      },
      "text": "ཆོས་ཀྱིས་ ༼སྣར།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 11489,
        "end": 11498
      },
      "text": "བསྟན་པའོ། ༼སྣར། པེ།༽ བསྟན་པས་སོ།"
    },
    {
      "span": {
        "start": 11508,
        "end": 11529
      },
      "text": "སེམས་དང་རྗེས་སུ་མཐུན་ ༼སྣར། པེ།༽ སེམས་དངམཐུན་"
    },
    {
      "span": {
        "start": 11553,
        "end": 11556
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 11622,
        "end": 11629
      },
      "text": "མདོ་ལས་ ༼སྣར། པེ།༽ མདོ་"
    },
    {
      "span": {
        "start": 11643,
        "end": 11646
      },
      "text": "རང་ ༼སྣར།༽ རང་དེ་"
    },
    {
      "span": {
        "start": 11674,
        "end": 11684
      },
      "text": "གང་དག་གིས་ ༼སྣར། པེ།༽ གང་དག་"
    },
    {
      "span": {
        "start": 11952,
        "end": 11961
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 12104,
        "end": 12113
      },
      "text": "བསམ་པ་དང་ ༼སྣར། པེ།༽ བསམ་པ་"
    },
    {
      "span": {
        "start": 12136,
        "end": 12158
      },
      "text": "རྣམས་ལ་བསྒྲུབ་པར་བྱའོ། ༼སྣར། པེ།༽ རྣམས་ལསྒྲུབ་པའོ།"
    },
    {
      "span": {
        "start": 12617,
        "end": 12639
      },
      "text": "ཇི་ལྟར་བསྒྲུབ་པར་བྱ་བ་ ༼སྣར། པེ།༽ ཇི་ལྟར་བསྒྲུབཔ་"
    },
    {
      "span": {
        "start": 12708,
        "end": 12717
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 12756,
        "end": 12763
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 12817,
        "end": 12846
      },
      "text": "ཀུན་ནས་དཀྲིས་པས་ཀུན་ནས་དཀྲིས་ ༼སྣར།༽ ཀུན་ནསདཀྲིས་ ༼པེ།༽ ཀུན་ནསཀུན་ནས་དཀྲིས་"
    },
    {
      "span": {
        "start": 12871,
        "end": 12879
      },
      "text": "མཐོང་བར་ ༼སྣར། པེ།༽ མཐོ་བར་"
    },
    {
      "span": {
        "start": 12928,
        "end": 12937
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 13099,
        "end": 13107
      },
      "text": "འཁྲུག་ལ་ ༼སྣར། པེ།༽ འཁྲུག་པ་"
    },
    {
      "span": {
        "start": 13212,
        "end": 13220
      },
      "text": "མི་རྟེན་ ༼སྣར།༽ ཡང་མི་བརྟེན་ ༼པེ།༽ མི་བརྟེན་"
    },
    {
      "span": {
        "start": 13239,
        "end": 13247
      },
      "text": "རྟེན་པར་ ༼སྣར། པེ།༽ བརྟེན་པར་"
    },
    {
      "span": {
        "start": 13307,
        "end": 13310
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 13315,
        "end": 13321
      },
      "text": "པར་ཡང་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 13356,
        "end": 13364
      },
      "text": "བཤད་ཀྱི་ ༼སྣར། པེ།༽ ཤད་ཀྱིས་"
    },
    {
      "span": {
        "start": 13381,
        "end": 13390
      },
      "text": "ཡང་དག་པར་ ༼སྣར། པེ།༽ ཡང་དག་པའི་"
    },
    {
      "span": {
        "start": 13411,
        "end": 13427
      },
      "text": "དགའ་བར་བྱེད་པའི་ ༼སྣར། པེ།༽ དགའ་བརབྱ་བའི་"
    },
    {
      "span": {
        "start": 13796,
        "end": 13803
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ གགས་པ་"
    },
    {
      "span": {
        "start": 14044,
        "end": 14051
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ ངག་གི་"
    },
    {
      "span": {
        "start": 14178,
        "end": 14182
      },
      "text": "ཞེས་ ༼སྣར། པེ།༽ ཞེས་ཀྱང་"
    },
    {
      "span": {
        "start": 14435,
        "end": 14440
      },
      "text": "སེམས་ ༼སྣར། པེ།༽ སེམས་དང་"
    },
    {
      "span": {
        "start": 14545,
        "end": 14553
      },
      "text": "འབོགས་པ་ ༼སྣར། པེ།༽ འབོག་པ་"
    },
    {
      "span": {
        "start": 14624,
        "end": 14631
      },
      "text": "བྱུང་བ་ ༼སྣར། པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 14636,
        "end": 14642
      },
      "text": "གལ་ཏེ་ ༼སྣར། པེ།༽ གལ་ཏེ་དེ་"
    },
    {
      "span": {
        "start": 14666,
        "end": 14683
      },
      "text": "ལྡན་པ་ཞེས་བྱ་བའོ། ༼སྣར། པེ།༽ ལྡན་པ་ཞེསབྱའོ།"
    },
    {
      "span": {
        "start": 14693,
        "end": 14707
      },
      "text": "རྒན་པ་ཞིག་ཡིན་ ༼སྣར། པེ།༽ རྒན་པ་ཞིག་"
    },
    {
      "span": {
        "start": 14731,
        "end": 14739
      },
      "text": "འདིས་ཅི་ ༼སྣར། པེ།༽ འདིས་"
    },
    {
      "span": {
        "start": 15082,
        "end": 15099
      },
      "text": "དངོས་པོ་མངོན་སུམ་ ༼སྣར། པེ།༽ དངོས་པོགསུམ་"
    },
    {
      "span": {
        "start": 15276,
        "end": 15278
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 15326,
        "end": 15328
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 15431,
        "end": 15433
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 15757,
        "end": 15761
      },
      "text": "ཆོས་ ༼སྣར། པེ།༽ ཆོས་རྣམས་"
    },
    {
      "span": {
        "start": 15815,
        "end": 15822
      },
      "text": "མཐུན་པ་ ༼སྣར། པེ།༽ མཐུན་པའི་"
    },
    {
      "span": {
        "start": 16089,
        "end": 16094
      },
      "text": "བྱའི་ ༼སྣར། པེ།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 16142,
        "end": 16148
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 16301,
        "end": 16304
      },
      "text": "ཏེ། ༼སྣར། པེ།༽ ཏོ། །"
    },
    {
      "span": {
        "start": 16311,
        "end": 16318
      },
      "text": "སྟོད་པ་ ༼སྣར། པེ།༽ བསྟོད་པ་"
    },
    {
      "span": {
        "start": 16535,
        "end": 16545
      },
      "text": "ཟང་ཟིང་མི་ ༼སྣར། པེ།༽ ཟང་ཟིང་"
    },
    {
      "span": {
        "start": 16870,
        "end": 16876
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པས་"
    },
    {
      "span": {
        "start": 17298,
        "end": 17303
      },
      "text": "བསྟན་ ༼སྣར། པེ།༽ སྟན་"
    },
    {
      "span": {
        "start": 17312,
        "end": 17320
      },
      "text": "མཐུན་པས་ ༼སྣར། པེ།༽ མཐུན་པ་"
    },
    {
      "span": {
        "start": 17332,
        "end": 17348
      },
      "text": "གཞན་ཡང་བསྡུ་བའི་ ༼སྣར། པེ།༽ གཞན་ཡངབསྡུས་པའི་"
    },
    {
      "span": {
        "start": 17393,
        "end": 17400
      },
      "text": "རྡེག་པ་ ༼སྣར། པེ།༽ བརྡེག་པ་"
    },
    {
      "span": {
        "start": 17480,
        "end": 17495
      },
      "text": "རྣམ་པར་ཐོ་འཚམས་ ༼སྣར། པེ།༽ རྣམ་པརམཐོ་འཚམ་"
    },
    {
      "span": {
        "start": 17515,
        "end": 17530
      },
      "text": "ཤིན་ཏུ་ཐོ་འཚམས་ ༼སྣར། པེ།༽ ཤིན་ཏུམཐོ་འཚམ་"
    },
    {
      "span": {
        "start": 17543,
        "end": 17558
      },
      "text": "རྣམ་པར་ཐོ་འཚམས་ ༼སྣར། པེ།༽ རྣམ་པརམཐོ་འཚམ་"
    },
    {
      "span": {
        "start": 17564,
        "end": 17571
      },
      "text": "རྡེག་པ་ ༼སྣར། པེ།༽ བརྡེག་པ་"
    },
    {
      "span": {
        "start": 17610,
        "end": 17615
      },
      "text": "བསྟན་ ༼སྣར། པེ།༽ སྟོན་"
    },
    {
      "span": {
        "start": 17644,
        "end": 17651
      },
      "text": "བཟུང་ལ་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 17663,
        "end": 17681
      },
      "text": "རྣམ་པར་ཐོ་འཚམས་པར་ ༼སྣར། པེ།༽ རྣམ་པརམཐོ་འཚམ་པས་"
    },
    {
      "span": {
        "start": 18006,
        "end": 18012
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ འགྱུར་བ་བྱ་"
    },
    {
      "span": {
        "start": 18441,
        "end": 18448
      },
      "text": "གཏང་བར་ ༼སྣར། པེ།༽ བཏང་བར་"
    },
    {
      "span": {
        "start": 18518,
        "end": 18526
      },
      "text": "གཏོང་བར་ ༼སྣར། པེ།༽ བཏང་བར་"
    },
    {
      "span": {
        "start": 18548,
        "end": 18557
      },
      "text": "སེམས་དཔས་ ༼སྣར།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 18647,
        "end": 18665
      },
      "text": "ཡང་དག་པར་བླངས་པའི་ ༼སྣར། པེ།༽ ཡང་དག་པརབླང་བའི་"
    },
    {
      "span": {
        "start": 18757,
        "end": 18762
      },
      "text": "བྱའི་ ༼སྣར། པེ།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 18921,
        "end": 18930
      },
      "text": "བརྗེས་སུ་ ༼སྣར། པེ།༽ རྗེས་སུ་"
    },
    {
      "span": {
        "start": 18947,
        "end": 18956
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 19523,
        "end": 19532
      },
      "text": "བསྡམས་པར་ ༼སྣར། པེ།༽ བསྡམ་པར་"
    },
    {
      "span": {
        "start": 19837,
        "end": 19841
      },
      "text": "གཞི་ ༼སྣར། པེ།༽ གཞི་པོ་"
    },
    {
      "span": {
        "start": 19846,
        "end": 19853
      },
      "text": "བསྩོགས་ ༼སྣར། པེ།༽ གསོགས་"
    },
    {
      "span": {
        "start": 19864,
        "end": 19872
      },
      "text": "ཕམ་པ་ནི་ ༼སྣར། པེ།༽ ཕམ་པ་"
    },
    {
      "span": {
        "start": 20093,
        "end": 20102
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 20350,
        "end": 20364
      },
      "text": "རིག་པར་བྱ་སྟེ། ༼སྣར།༽ རིག་པརབྱའོ། །"
    },
    {
      "span": {
        "start": 20866,
        "end": 20888
      },
      "text": "དཀྲིས་པ་མཚུངས་པས་བསམས་ ༼སྣར། པེ།༽ དཀྲིས་པ་མཚུངསཔ་བསམ་"
    },
    {
      "span": {
        "start": 21096,
        "end": 21107
      },
      "text": "གཏི་མུག་གི་ ༼སྣར། པེ།༽ གཏི་མུག་གིས་"
    },
    {
      "span": {
        "start": 21282,
        "end": 21291
      },
      "text": "འགྱུར་བར་ ༼སྣར།༽ འགྱུར་བའི་"
    },
    {
      "span": {
        "start": 21332,
        "end": 21335
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 21654,
        "end": 21660
      },
      "text": "འབྱུང་ ༼སྣར། པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 21739,
        "end": 21756
      },
      "text": "ཆེན་པོར་འགྱུར་བར་ ༼སྣར། པེ།༽ ཆེན་པོརགྱུར་པར་"
    },
    {
      "span": {
        "start": 21945,
        "end": 21953
      },
      "text": "བྱ་བ་ནི་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 22126,
        "end": 22128
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 22439,
        "end": 22455
      },
      "text": "རྒ་ཤི་སྐྱེད་པའི་ ༼སྣར། པེ།༽ རྒ་ཤིསྐྱེ་བའི་"
    },
    {
      "span": {
        "start": 22517,
        "end": 22527
      },
      "text": "བསྲུང་བའི་ ༼སྣར། པེ།༽ སྲུང་བའི་"
    },
    {
      "span": {
        "start": 22554,
        "end": 22561
      },
      "text": "སྲུང་བ་ ༼སྣར། པེ།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 22803,
        "end": 22806
      },
      "text": "པར་ ༼སྣར། པེ།༽ པ་ལ་"
    },
    {
      "span": {
        "start": 22815,
        "end": 22823
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 22828,
        "end": 22831
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 22953,
        "end": 22970
      },
      "text": "དུ་ཕྱིར་འཆོས་པའོ། ༼སྣར། པེ།༽ དུ་ཕྱིརའཆོས་སོ།"
    },
    {
      "span": {
        "start": 22999,
        "end": 23010
      },
      "text": "ཐོག་མར་བདག་ ༼སྣར། པེ།༽ ཐོགམ་བར་དག་"
    },
    {
      "span": {
        "start": 23284,
        "end": 23294
      },
      "text": "གཞི་ཡང་ཡང་ ༼སྣར། པེ།༽ གཞི་ཡང་"
    },
    {
      "span": {
        "start": 23329,
        "end": 23346
      },
      "text": "ཆོས་བཞིན་དུ་ཕྱིར་ ༼སྣར། པེ།༽ ཆོས་བཞིན་དུ་"
    },
    {
      "span": {
        "start": 23473,
        "end": 23479
      },
      "text": "ལྡན་པ་ ༼སྣར། པེ།༽ ལྡན་"
    },
    {
      "span": {
        "start": 23841,
        "end": 23850
      },
      "text": "བསོད་ཉམས་ ༼སྣར། པེ།༽ བསོད་ནམས་"
    },
    {
      "span": {
        "start": 23858,
        "end": 23868
      },
      "text": "སྤོངས་པའི་ ༼སྣར། པེ།༽ སྤངས་པའི་"
    },
    {
      "span": {
        "start": 23973,
        "end": 23977
      },
      "text": "སྟི་ ༼སྣར། པེ།༽ བསྟི་"
    },
    {
      "span": {
        "start": 24071,
        "end": 24082
      },
      "text": "འཕྲོགས་པའི་ ༼སྣར།༽ འཕྲོག་པའི་"
    },
    {
      "span": {
        "start": 25053,
        "end": 25058
      },
      "text": "ཕོངས་ ༼སྣར། པེ།༽ འཕོངས་"
    },
    {
      "span": {
        "start": 25071,
        "end": 25097
      },
      "text": "ཚུལ་ཁྲིམས་ཀྱི་དོན་གྱི་མདོ་ ༼སྣར། པེ།༽ ཚུལ་ཁྲིམས་ཀྱིམདོ་"
    },
    {
      "span": {
        "start": 25100,
        "end": 25107
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 25114,
        "end": 25118
      },
      "text": "དཔག་ ༼སྣར། པེ།༽ དཔགས་"
    },
    {
      "span": {
        "start": 25213,
        "end": 25231
      },
      "text": "ལུས་ཀྱི་ལས་ཀྱི་ལམ་ ༼སྣར། པེ།༽ ལུས་ཀྱིལམ་"
    },
    {
      "span": {
        "start": 25234,
        "end": 25245
      },
      "text": "གཏོགས་པ་དང་ ༼སྣར། པེ།༽ གཏོགས་པ་"
    },
    {
      "span": {
        "start": 26543,
        "end": 26549
      },
      "text": "འདོགས་ ༼སྣར།༽ འདོག་"
    },
    {
      "span": {
        "start": 26662,
        "end": 26672
      },
      "text": "བརྟེན་པོར་ ༼སྣར། པེ།༽ བརྟན་པོར་"
    },
    {
      "span": {
        "start": 26773,
        "end": 26782
      },
      "text": "འཐོབ་པའི་ ༼སྣར། པེ།༽ ཐོབ་པའི་"
    },
    {
      "span": {
        "start": 26782,
        "end": 26788
      },
      "text": "ཉེས་པ་ ༼སྣར། པེ།༽ ཉེས་པའི་"
    },
    {
      "span": {
        "start": 27126,
        "end": 27134
      },
      "text": "སྨོན་པས་ ༼སྣར། པེ།༽ སྨིན་པས་"
    },
    {
      "span": {
        "start": 27897,
        "end": 27905
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 28124,
        "end": 28126
      },
      "text": "བ་ ༼སྣར། པེ།༽ བཱ་"
    }
  ]
}