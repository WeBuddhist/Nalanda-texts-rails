{
  "durchens": [
    {
      "span": {
        "start": 35,
        "end": 44
      },
      "text": "ཀ་བྲྀཏྟི། ༼སྣར།༽ ག་བྲིཏྟི ༼པེ།༽ ག་བྲྀཏྟི།"
    },
    {
      "span": {
        "start": 232,
        "end": 239
      },
      "text": "གུས་པས་ ༼སྣར། པེ།༽ གུས་པར་"
    },
    {
      "span": {
        "start": 426,
        "end": 429
      },
      "text": "བྱ། ༼སྣར། པེ།༽ བྱས།"
    },
    {
      "span": {
        "start": 488,
        "end": 491
      },
      "text": "ཏེ། ༼སྣར། པེ།༽ ཏོ། །"
    },
    {
      "span": {
        "start": 515,
        "end": 522
      },
      "text": "དེ་སྐད་ ༼སྣར། པེ།༽ དེ་སྐད་དུ་"
    },
    {
      "span": {
        "start": 938,
        "end": 952
      },
      "text": "། འདི་སྐད་ཅེས། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 1038,
        "end": 1046
      },
      "text": "འཚལ་གྱི། ༼སྣར། པེ།༽ འཚལ་གྱིས།"
    },
    {
      "span": {
        "start": 1053,
        "end": 1059
      },
      "text": "ནོད་པ་ ༼སྣར། པེ།༽ གནོད་པ་མ་"
    },
    {
      "span": {
        "start": 1647,
        "end": 1654
      },
      "text": "བརྟན་པ་ ༼སྣར། པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 1667,
        "end": 1675
      },
      "text": "བརྟན་པར་ ༼ཅོ།༽ བརྟེན་པར་"
    },
    {
      "span": {
        "start": 1722,
        "end": 1732
      },
      "text": "སྐྱེད་པའི་ ༼སྣར། པེ།༽ བསྐྱེད་པའི་"
    },
    {
      "span": {
        "start": 1778,
        "end": 1785
      },
      "text": "གསོལ་བ་ ༼སྣར། པེ།༽ གསོལ་"
    },
    {
      "span": {
        "start": 1917,
        "end": 1924
      },
      "text": "ཞུགས་པ་ ༼སྣར། པེ།༽ བཞུགས་པ་"
    },
    {
      "span": {
        "start": 2469,
        "end": 2473
      },
      "text": "གཞག་ ༼སྣར། པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 2730,
        "end": 2736
      },
      "text": "འགྲེང་ ༼སྣར། པེ།༽ བགྲེང་"
    },
    {
      "span": {
        "start": 3073,
        "end": 3085
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼སྣར།༽ ཐམས་ཅད་ཀྱི་ ༼པེ།༽ ཐམས་ཅད་ཀྱང་"
    },
    {
      "span": {
        "start": 3187,
        "end": 3199
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 3328,
        "end": 3340
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱང་"
    },
    {
      "span": {
        "start": 3389,
        "end": 3395
      },
      "text": "པ་དང་། ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 3783,
        "end": 3793
      },
      "text": "ཚུལ་ཁྲིམས་ ༼སྣར། པེ།༽ ཚུལ་ཁྲིམས་ང་"
    },
    {
      "span": {
        "start": 3988,
        "end": 3995
      },
      "text": "བླང་བར་ ༼སྣར།༽ སྤངས་པར་"
    },
    {
      "span": {
        "start": 4694,
        "end": 4701
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ གྱུར་པར་"
    },
    {
      "span": {
        "start": 4986,
        "end": 4990
      },
      "text": "དཔས་ ༼སྣར། པེ།༽ དཔའ་"
    },
    {
      "span": {
        "start": 5148,
        "end": 5156
      },
      "text": "མནོད་པར་ ༼སྣར། པེ།༽ ནོད་པར་"
    },
    {
      "span": {
        "start": 5455,
        "end": 5460
      },
      "text": "སྙོམ་ ༼སྣར། པེ།༽ སྙོམས་"
    },
    {
      "span": {
        "start": 5523,
        "end": 5528
      },
      "text": "གློས་ ༼སྣར། པེ།༽ བློས་"
    },
    {
      "span": {
        "start": 5624,
        "end": 5632
      },
      "text": "མནོད་པར་ ༼སྣར།༽ གནོད་པར་"
    },
    {
      "span": {
        "start": 6000,
        "end": 6005
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 6172,
        "end": 6179
      },
      "text": "ཐོས་ནས། ༼སྣར། པེ།༽ ཐོས་ན།"
    },
    {
      "span": {
        "start": 6350,
        "end": 6359
      },
      "text": "མེད་པ་ཇི་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 6372,
        "end": 6382
      },
      "text": "གྱུར་པ་དེ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 6721,
        "end": 6726
      },
      "text": "བསླབ་ ༼ཅོ།༽ བསློབ་ ༼སྣར། པེ།༽ སླབ་"
    },
    {
      "span": {
        "start": 6817,
        "end": 6829
      },
      "text": "ཤེས་རབ་ཀྱིས་ ༼སྣར། པེ།༽ ཤེས་རབ་ཀྱི་"
    },
    {
      "span": {
        "start": 7315,
        "end": 7323
      },
      "text": "ལ་ཞབས་ལ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 7332,
        "end": 7339
      },
      "text": "ལྡང་བར་ ༼སྣར།༽ སྡང་བར་"
    },
    {
      "span": {
        "start": 7385,
        "end": 7394
      },
      "text": "ཡང་དག་པར་ ༼སྣར།༽ ཡང་དག་"
    },
    {
      "span": {
        "start": 7455,
        "end": 7465
      },
      "text": "ཁྱད་པར་དུ་ ༼སྣར། པེ།༽ ཁྱད་པར་"
    },
    {
      "span": {
        "start": 7797,
        "end": 7803
      },
      "text": "ཆར་ཡང་ ༼པེ།༽ ཆར་"
    },
    {
      "span": {
        "start": 7974,
        "end": 7984
      },
      "text": "རྣམས་ཀྱིས། ༼སྣར། པེ།༽ རྣམས་ཀྱི།"
    },
    {
      "span": {
        "start": 7999,
        "end": 8008
      },
      "text": "ཀྱིས་རྟག་ ༼སྣར།༽ ཀྱི་བརྟག་ས་ ༼པེ།༽ ཀྱི་བརྟག་"
    },
    {
      "span": {
        "start": 8041,
        "end": 8049
      },
      "text": "འགྱུར། ། ༼སྣར། པེ།༽ ། །བ་"
    },
    {
      "span": {
        "start": 8229,
        "end": 8237
      },
      "text": "ཆུད་པའི་ ༼སྣར། པེ།༽ ཚུད་པའི་"
    },
    {
      "span": {
        "start": 8283,
        "end": 8290
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 8315,
        "end": 8325
      },
      "text": "སེམས་དཔའི་ ༼སྣར། པེ།༽ སེམས་དཔའ་བྱང་ཆུབ་སེམས་དཔའི་"
    },
    {
      "span": {
        "start": 8481,
        "end": 8490
      },
      "text": "དགོངས་པར་ ༼སྣར། པེ།༽ དགོངས་པ་"
    },
    {
      "span": {
        "start": 8541,
        "end": 8550
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 8757,
        "end": 8762
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བར་"
    },
    {
      "span": {
        "start": 9333,
        "end": 9337
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིས་"
    },
    {
      "span": {
        "start": 9542,
        "end": 9547
      },
      "text": "མ་མོ་ ༼སྣར། པེ།༽ མ་མོས་"
    },
    {
      "span": {
        "start": 9746,
        "end": 9751
      },
      "text": "ཆ་གང་ ༼སྣར། པེ།༽ ཆ་"
    },
    {
      "span": {
        "start": 9834,
        "end": 9838
      },
      "text": "ལའང་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 10210,
        "end": 10213
      },
      "text": "དག་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 10329,
        "end": 10337
      },
      "text": "དེ་བས་ན་ ༼སྣར། པེ།༽ དེ་བས་"
    },
    {
      "span": {
        "start": 10649,
        "end": 10657
      },
      "text": "སཱ་ལུའི་ ༼སྣར། པེ།༽ ས་ལུའི་"
    },
    {
      "span": {
        "start": 10693,
        "end": 10711
      },
      "text": "སྙིང་རྗེ་དང་ལྡན་པ་ ༼སྣར། པེ།༽ སྙིང་རྗེ་ཅན་"
    },
    {
      "span": {
        "start": 10882,
        "end": 10892
      },
      "text": "བྱུང་བ་ཡི། ༼སྣར། པེ།༽ བྱུང་བ་ཡིས།"
    },
    {
      "span": {
        "start": 10944,
        "end": 10947
      },
      "text": "ཕས་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 10947,
        "end": 10950
      },
      "text": "ཕམ་ ༼སྣར། པེ།༽ ཕམ་པར་"
    },
    {
      "span": {
        "start": 10965,
        "end": 10969
      },
      "text": "ཡིན། ༼སྣར།༽ ཡི།"
    },
    {
      "span": {
        "start": 11049,
        "end": 11057
      },
      "text": "ཆོས་ཅིག་ ༼སྣར། པེ།༽ ཆོས་གཅིག་"
    },
    {
      "span": {
        "start": 11116,
        "end": 11123
      },
      "text": "ཆེན་པོ་ ༼སྣར། པེ།༽ ཆེན་པོ་ལ་"
    },
    {
      "span": {
        "start": 12066,
        "end": 12090
      },
      "text": "སེམས་དཔའི་ཚུལ་ཁྲིམས་ཀྱི་ ༼སྣར། པེ།༽ སེམས་དཔའི་"
    },
    {
      "span": {
        "start": 12395,
        "end": 12402
      },
      "text": "ཕམ་པའི་ ༼སྣར།༽ ཕན་པའི་"
    },
    {
      "span": {
        "start": 12468,
        "end": 12473
      },
      "text": "ཚེ་བ་ ༼སྣར། པེ།༽ ཚེ་"
    },
    {
      "span": {
        "start": 12596,
        "end": 12603
      },
      "text": "བླངས་པ་ ༼སྣར།༽ བླང་པ་"
    },
    {
      "span": {
        "start": 12645,
        "end": 12654
      },
      "text": "བརྗེས་པས་ ༼སྣར།༽ རྗེས་སུ་ ༼པེ།༽ རྗེས་པ་"
    },
    {
      "span": {
        "start": 12732,
        "end": 12739
      },
      "text": "ནོད་པར་ ༼སྣར། པེ།༽ གནོད་པར་"
    },
    {
      "span": {
        "start": 12862,
        "end": 12867
      },
      "text": "སྟོད་ ༼སྣར། པེ།༽ བསྟོད་"
    },
    {
      "span": {
        "start": 12916,
        "end": 12924
      },
      "text": "སེར་སྣས་ ༼སྣར། པེ།༽ སེར་སྣ་"
    },
    {
      "span": {
        "start": 12975,
        "end": 12980
      },
      "text": "ཁྲོས་ ༼སྣར། པེ།༽ ཁྲོ་"
    },
    {
      "span": {
        "start": 13092,
        "end": 13098
      },
      "text": "ཞེན་པ་ ༼སྣར། པེ།༽ ཞེན་"
    },
    {
      "span": {
        "start": 13108,
        "end": 13115
      },
      "text": "སྟོད་པ་ ༼སྣར། པེ།༽ བསྟོད་པ་"
    },
    {
      "span": {
        "start": 13237,
        "end": 13244
      },
      "text": "ཅན་གྱི་ ༼སྣར། པེ།༽ ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 13249,
        "end": 13256
      },
      "text": "བསྔལ་བ་ ༼སྣར། པེ།༽ བསྔལ་"
    },
    {
      "span": {
        "start": 13286,
        "end": 13295
      },
      "text": "རྟེན་མེད་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 13415,
        "end": 13427
      },
      "text": "གཉེར་བ་འོངས་ ༼སྣར།༽ ལ་འོས་ ༼པེ།༽ གཉེར་བ་འོས་"
    },
    {
      "span": {
        "start": 13665,
        "end": 13674
      },
      "text": "དབྱིག་པས་ ༼སྣར། པེ།༽ དབྱུག་པས་"
    },
    {
      "span": {
        "start": 13689,
        "end": 13697
      },
      "text": "རྡེག་པར་ ༼སྣར། པེ།༽ བརྡེག་པར་"
    },
    {
      "span": {
        "start": 13730,
        "end": 13738
      },
      "text": "ཐོ་འཚམས་ ༼སྣར། པེ།༽ མཐོ་འཚམ་"
    },
    {
      "span": {
        "start": 13788,
        "end": 13799
      },
      "text": "གཞན་དག་གིས་ ༼སྣར། པེ།༽ གཞན་དག་གི་"
    },
    {
      "span": {
        "start": 14059,
        "end": 14066
      },
      "text": "སྟོན་པ་ ༼སྣར། པེ།༽ རྟོན་པ་"
    },
    {
      "span": {
        "start": 14132,
        "end": 14134
      },
      "text": "ད་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 14281,
        "end": 14288
      },
      "text": "སོ་སོར་ ༼སྣར། པེ།༽ སོ་སོ་"
    },
    {
      "span": {
        "start": 14349,
        "end": 14358
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་དཔས་"
    },
    {
      "span": {
        "start": 14367,
        "end": 14374
      },
      "text": "བླང་བར་ ༼སྣར། པེ།༽ བླངས་པར་"
    },
    {
      "span": {
        "start": 14843,
        "end": 14850
      },
      "text": "སྡོམ་པ་ ༼སྣར།༽ སྡོམ་"
    },
    {
      "span": {
        "start": 14943,
        "end": 14949
      },
      "text": "བཙུགས་ ༼སྣར། པེ།༽ གཙུགས་"
    },
    {
      "span": {
        "start": 15037,
        "end": 15045
      },
      "text": "གཤེགས་པ་ ༼ཅོ།༽ གཤེགས་"
    },
    {
      "span": {
        "start": 15114,
        "end": 15123
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 15167,
        "end": 15174
      },
      "text": "ཅད་དང་། ༼སྣར། པེ།༽ ཅད་"
    },
    {
      "span": {
        "start": 15489,
        "end": 15514
      },
      "text": "གིས་ཡང་དག་པར་བླང་བར་བྱའོ་ ༼སྣར། པེ།༽ ཡང་དག་པར་བསླང་ངོ་"
    },
    {
      "span": {
        "start": 15597,
        "end": 15609
      },
      "text": "བཞིན་དུ་རིག་ ༼སྣར། པེ།༽ བཞིན་རིགས་"
    },
    {
      "span": {
        "start": 15737,
        "end": 15746
      },
      "text": "བསླབ་པའི་ ༼སྡེ།༽ བསབ་པའི་"
    },
    {
      "span": {
        "start": 16132,
        "end": 16140
      },
      "text": "བཤགས་པར་ ༼སྣར། པེ།༽ བཤགས་པ་"
    },
    {
      "span": {
        "start": 16407,
        "end": 16418
      },
      "text": "མཐོལ་ཏེ་མི་ ༼སྣར། པེ།༽ མཐོལ་ཏེ་"
    },
    {
      "span": {
        "start": 16902,
        "end": 16910
      },
      "text": "ཉེས་བྱས་ ༼སྣར། པེ།༽ ཉེས་པ་"
    },
    {
      "span": {
        "start": 16937,
        "end": 16944
      },
      "text": "ཉིད་དོ། ༼སྣར། པེ།༽ ཉིད་དེ།"
    },
    {
      "span": {
        "start": 17826,
        "end": 17832
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 17968,
        "end": 17976
      },
      "text": "བསྡམ་པར་ ༼སྣར། པེ།༽ བསྡམས་པར་"
    },
    {
      "span": {
        "start": 18018,
        "end": 18025
      },
      "text": "ཤེས་པར་ ༼སྣར། པེ།༽ བཤད་པར་"
    },
    {
      "span": {
        "start": 18135,
        "end": 18146
      },
      "text": "ཉོན་མོངས་པ་ ༼པེ།༽ ཉོན་མོངས་"
    },
    {
      "span": {
        "start": 18193,
        "end": 18195
      },
      "text": "ལ། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 18210,
        "end": 18218
      },
      "text": "བསྟན་པར་ ༼སྣར། པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 18349,
        "end": 18354
      },
      "text": "གཅིག་ ༼སྣར། པེ།༽ གཅིག་དེ་"
    },
    {
      "span": {
        "start": 18440,
        "end": 18446
      },
      "text": "བྱས་པ་ ༼སྣར། པེ།༽ བྱས་པས་"
    },
    {
      "span": {
        "start": 18795,
        "end": 18817
      },
      "text": "ཙམ་ཚིག་ཏུ་བརྗོད་པ་དང་། ༼སྣར། པེ།༽ ཙམ་ཚིགས་དུ།"
    },
    {
      "span": {
        "start": 18822,
        "end": 18832
      },
      "text": "སེམས་ཀྱིས་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 19027,
        "end": 19032
      },
      "text": "ལོའི་ ༼སྣར། པེ།༽ ལོ་"
    },
    {
      "span": {
        "start": 19489,
        "end": 19495
      },
      "text": "ལྟ་བུ་ ༼སྣར། པེ།༽ ལྟ་བ་"
    },
    {
      "span": {
        "start": 19512,
        "end": 19520
      },
      "text": "ལ་གལ་ཏེ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 19792,
        "end": 19797
      },
      "text": "འགགས་ ༼སྣར། པེ།༽ གགས་"
    },
    {
      "span": {
        "start": 19805,
        "end": 19818
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 19860,
        "end": 19866
      },
      "text": "ཡང་དང་ ༼སྣར། པེ།༽ ཡང་ནས་"
    },
    {
      "span": {
        "start": 19965,
        "end": 19974
      },
      "text": "སེམས་དཔས་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 19996,
        "end": 20002
      },
      "text": "ལྡན་པ་ ༼སྣར། པེ།༽ ལྡན་"
    },
    {
      "span": {
        "start": 20036,
        "end": 20043
      },
      "text": "མཐོང་ན་ ༼སྣར། པེ།༽ མཐོང་ནས་"
    },
    {
      "span": {
        "start": 20050,
        "end": 20055
      },
      "text": "གྱིས་ ༼སྣར། པེ།༽ གྱི་"
    },
    {
      "span": {
        "start": 20345,
        "end": 20354
      },
      "text": "ཚུལ་གྱིས་ ༼པེ།༽ ཚུལ་གྱི་"
    },
    {
      "span": {
        "start": 20362,
        "end": 20367
      },
      "text": "རྗོད་ ༼སྣར། པེ།༽ བརྗོད་"
    },
    {
      "span": {
        "start": 20565,
        "end": 20570
      },
      "text": "སྙོམ་ ༼སྣར། པེ།༽ སྙོམས་"
    },
    {
      "span": {
        "start": 20766,
        "end": 20774
      },
      "text": "དེ་གཉིད་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 20794,
        "end": 20807
      },
      "text": "འདུ་ཤེས་ཀྱིས་ ༼སྣར། པེ།༽ འདུ་ཤེས་ཀྱི་"
    },
    {
      "span": {
        "start": 20962,
        "end": 20971
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 21051,
        "end": 21058
      },
      "text": "གཞན་དག་ ༼སྣར། པེ།༽ གཞན་དག་ལ་"
    },
    {
      "span": {
        "start": 21067,
        "end": 21071
      },
      "text": "པའམ། ༼སྣར། པེ།༽ ཏམ།"
    },
    {
      "span": {
        "start": 21143,
        "end": 21151
      },
      "text": "ཀྱི་གཏམ་ ༼སྣར།༽ ཀྱི་ཏམ་"
    },
    {
      "span": {
        "start": 21251,
        "end": 21256
      },
      "text": "འདུལ་ ༼སྣར། པེ།༽ འདུལ་བ་"
    },
    {
      "span": {
        "start": 21276,
        "end": 21285
      },
      "text": "བསླང་སྟེ་ ༼སྣར། པེ།༽ བསླང་དེ་"
    },
    {
      "span": {
        "start": 21411,
        "end": 21421
      },
      "text": "མགྲོན་པོར་ ༼སྣར། པེ།༽ མགྲོན་པོས་"
    },
    {
      "span": {
        "start": 21468,
        "end": 21472
      },
      "text": "གི ། ༼སྣར། པེ།༽ གིས། །"
    },
    {
      "span": {
        "start": 21550,
        "end": 21563
      },
      "text": "རྣམས་ལ་བོས་པ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 21880,
        "end": 21885
      },
      "text": "སྙོམ་ ༼སྣར།༽ སྙོམས་"
    },
    {
      "span": {
        "start": 21909,
        "end": 21912
      },
      "text": "ཚང་ ༼སྣར། པེ།༽ སོང་"
    },
    {
      "span": {
        "start": 22285,
        "end": 22294
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 22322,
        "end": 22330
      },
      "text": "ཆོས་ཀྱི་ ༼སྣར། པེ།༽ ཆོས་ཀྱིས་"
    },
    {
      "span": {
        "start": 22522,
        "end": 22530
      },
      "text": "ཐོ་འཚམས་ ༼སྣར། པེ།༽ མཐོ་འཚམ་"
    },
    {
      "span": {
        "start": 22572,
        "end": 22579
      },
      "text": "དག་གིས་ ༼སྣར། པེ།༽ དག་གི་"
    },
    {
      "span": {
        "start": 22841,
        "end": 22850
      },
      "text": "དུས་ཀྱིས་ ༼སྣར། པེ།༽ དུས་ཀྱི་"
    },
    {
      "span": {
        "start": 23304,
        "end": 23310
      },
      "text": "ཉེས་པ་ ༼སྣར།༽ ཉེས་"
    },
    {
      "span": {
        "start": 23412,
        "end": 23420
      },
      "text": "ཕོངས་པར་ ༼སྣར། པེ།༽ འཕོངས་པར་"
    },
    {
      "span": {
        "start": 23563,
        "end": 23581
      },
      "text": "གསད་པའམ། བཅིང་བའམ། ༼སྣར། པེ།༽ བསད་པ་འམ། བཅིངས་པའམ།"
    },
    {
      "span": {
        "start": 23588,
        "end": 23593
      },
      "text": "གཅོད་ ༼སྣར། པེ།༽ བཅད་"
    },
    {
      "span": {
        "start": 23732,
        "end": 23750
      },
      "text": "མནར་སེམས་ཀྱི་སེམས་ ༼སྣར། པེ།༽ མནར་སེམས་"
    },
    {
      "span": {
        "start": 23789,
        "end": 23802
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 23931,
        "end": 23936
      },
      "text": "སྙོམ་ ༼སྣར། པེ།༽ སྙོམས་"
    },
    {
      "span": {
        "start": 24072,
        "end": 24076
      },
      "text": "ཚོལ་ ༼སྣར། པེ།༽ འཚོལ་"
    },
    {
      "span": {
        "start": 24370,
        "end": 24387
      },
      "text": "དབང་པོ་རྟུལ་པོ་ལ་ ༼སྣར།༽ དབང་པོ་རྟུལ་པོ་ ༼པེ།༽ དབང་པོ་བརྟུལ་པོ་"
    },
    {
      "span": {
        "start": 24528,
        "end": 24534
      },
      "text": "ལན་དུ་ ༼སྣར། པེ།༽ ལག་ཏུ་"
    },
    {
      "span": {
        "start": 24561,
        "end": 24568
      },
      "text": "རྣམས་ལ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 24661,
        "end": 24668
      },
      "text": "རུངས་པ་ ༼པེ།༽ རུང་བ་"
    },
    {
      "span": {
        "start": 24823,
        "end": 24831
      },
      "text": "འདོར་རམ། ༼སྣར། པེ།༽ འདོར་ན།"
    },
    {
      "span": {
        "start": 24900,
        "end": 24907
      },
      "text": "ཅན་གྱི་ ༼སྣར། པེ།༽ ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 25365,
        "end": 25370
      },
      "text": "ལ་ནི་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 25409,
        "end": 25418
      },
      "text": "འདོད་པ་ལ་ ༼སྣར། པེ།༽ འདོད་པ་ནས་"
    },
    {
      "span": {
        "start": 25489,
        "end": 25502
      },
      "text": "དགེ་འདུན་གྱི་ ༼སྣར། པེ།༽ དགེ་འདུན་གྱིས་"
    },
    {
      "span": {
        "start": 25574,
        "end": 25588
      },
      "text": "ལ་བྱ་བ་ཆུང་། ། ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 25747,
        "end": 25755
      },
      "text": "བཅས་པའི་ ༼སྣར། པེ།༽ བཅད་པའི་"
    },
    {
      "span": {
        "start": 25782,
        "end": 25788
      },
      "text": "གཞག་པ་ ༼སྣར། པེ།༽ བཞག་པ་"
    },
    {
      "span": {
        "start": 25894,
        "end": 25901
      },
      "text": "གི་དོན་ ༼སྣར།༽ གིར་ན་"
    },
    {
      "span": {
        "start": 26333,
        "end": 26352
      },
      "text": "ཉན་ཐོས་རྣམས་ནི་བདག་ ༼སྣར། པེ།༽ ཉན་ཐོས་དག་"
    },
    {
      "span": {
        "start": 26389,
        "end": 26396
      },
      "text": "བལྟ་བར་ ༼སྣར། པེ།༽ ལྟ་བས་"
    },
    {
      "span": {
        "start": 26408,
        "end": 26411
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 26586,
        "end": 26595
      },
      "text": "གནས་པ་ནི་ ༼སྣར། པེ།༽ གནས་པ་"
    },
    {
      "span": {
        "start": 26637,
        "end": 26647
      },
      "text": "གཞན་དག་གི་ ༼སྣར། པེ།༽ གཞན་དག་གིས་"
    },
    {
      "span": {
        "start": 26687,
        "end": 26693
      },
      "text": "ཉེ་བར་ ༼སྣར། པེ།༽ ཉེ་དུར་"
    },
    {
      "span": {
        "start": 26827,
        "end": 26834
      },
      "text": "བླང་བར་ ༼སྣར།༽ བླངས་པར་"
    },
    {
      "span": {
        "start": 26928,
        "end": 26940
      },
      "text": "བདག་ཉིད་ཀྱི་ ༼སྣར། པེ།༽ བདག་ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 27099,
        "end": 27106
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 27255,
        "end": 27259
      },
      "text": "དོན་ ༼སྣར། པེ།༽ དོན་ཉུང་ཞིང་བྱ་བ་ཉུང་ལ་གནས་པ་ནི་དེ་ལ་སོགས་པ་ཉན་ཐོས་དོན་"
    },
    {
      "span": {
        "start": 27838,
        "end": 27843
      },
      "text": "སྙོམ་ ༼སྣར།༽ སྙོམས་"
    },
    {
      "span": {
        "start": 27887,
        "end": 27895
      },
      "text": "ཆུང་ངུས་ ༼སྣར། པེ།༽ ཆུང་ངུར་"
    },
    {
      "span": {
        "start": 28053,
        "end": 28066
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 28096,
        "end": 28105
      },
      "text": "སེམས་དཔའ་ ༼པེ།༽ སེམས་དཔས་"
    },
    {
      "span": {
        "start": 28175,
        "end": 28184
      },
      "text": "མང་པོ་ཡང་ ༼སྣར། པེ།༽ མང་པོ་"
    },
    {
      "span": {
        "start": 28358,
        "end": 28373
      },
      "text": "གསད་པ་བརྩོན་ཏེ། ༼སྣར། པེ།༽ བསད་པར་བྱ་སྟེ།"
    },
    {
      "span": {
        "start": 28405,
        "end": 28415
      },
      "text": "ཞུགས་པ་དག་ ༼སྣར། པེ།༽ ཞུགས་པ་"
    },
    {
      "span": {
        "start": 28706,
        "end": 28715
      },
      "text": "སེམས་དཔས་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 28972,
        "end": 28977
      },
      "text": "བརླང་ ༼སྣར། པེ།༽ བསླང་"
    },
    {
      "span": {
        "start": 29066,
        "end": 29073
      },
      "text": "གནས་ནས་ ༼སྣར། པེ།༽ གནས་ན་"
    },
    {
      "span": {
        "start": 29157,
        "end": 29164
      },
      "text": "བསམ་པས་ ༼སྣར།༽ བསམས་པས་"
    },
    {
      "span": {
        "start": 29366,
        "end": 29375
      },
      "text": "སེམས་དཔས་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 29375,
        "end": 29379
      },
      "text": "ནོར་ ༼སྣར། པེ།༽ ནོར་གྱི་"
    },
    {
      "span": {
        "start": 29398,
        "end": 29408
      },
      "text": "ལོངས་སྤྱད་ ༼སྣར།༽ ལོངས་སྤྱོད་"
    },
    {
      "span": {
        "start": 29408,
        "end": 29417
      },
      "text": "པ་དེས་དེ་ ༼སྣར།༽ པ་དེས་ ༼པེ།༽ པ་དེ་"
    },
    {
      "span": {
        "start": 29639,
        "end": 29646
      },
      "text": "སྲུང་བ་ ༼སྣར། པེ།༽ བསྲུང་བ་"
    },
    {
      "span": {
        "start": 29811,
        "end": 29816
      },
      "text": "སྤྱད་ ༼སྣར།༽ སྤྱོད་"
    },
    {
      "span": {
        "start": 30113,
        "end": 30122
      },
      "text": "སྤྱོད་པས་ ༼སྣར།༽ སྤྱོད་པར་"
    },
    {
      "span": {
        "start": 30264,
        "end": 30276
      },
      "text": "ཅི་དགའ་དགུར་ ༼པེ།༽ ཅི་དགའ་མགུར་"
    },
    {
      "span": {
        "start": 30411,
        "end": 30417
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 30452,
        "end": 30458
      },
      "text": "བསྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 30597,
        "end": 30605
      },
      "text": "སྲུང་བས་ ༼སྣར། པེ།༽ བསྲུང་བས་"
    },
    {
      "span": {
        "start": 30626,
        "end": 30634
      },
      "text": "བསྟེན་པ་ ༼སྣར། པེ།༽ རྟེན་པ་"
    },
    {
      "span": {
        "start": 30720,
        "end": 30728
      },
      "text": "བཅིངས་པ་ ༼སྣར། པེ།༽ བཅིང་བ་"
    },
    {
      "span": {
        "start": 30906,
        "end": 30921
      },
      "text": "གང་མི་སྨྲ་བ་ཡང་ ༼སྣར། པེ།༽ མི་སྨྲ་བ་"
    },
    {
      "span": {
        "start": 31213,
        "end": 31220
      },
      "text": "གཞན་དུ་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 31496,
        "end": 31501
      },
      "text": "ཕན་པ་ ༼སྣར།༽ ཕམ་པ་"
    },
    {
      "span": {
        "start": 31667,
        "end": 31671
      },
      "text": "རྣམ་ ༼སྣར།༽ རྣམས་"
    },
    {
      "span": {
        "start": 31702,
        "end": 31712
      },
      "text": "ཉེས་པར་ཡང་ ༼སྣར། པེ།༽ ཉེས་པར་"
    },
    {
      "span": {
        "start": 31939,
        "end": 31942
      },
      "text": "སྨ་ ༼པེ།༽ སྨྲ་བ་"
    },
    {
      "span": {
        "start": 32527,
        "end": 32537
      },
      "text": "སེམས་དཔའི་ ༼སྣར།༽ སེམས་པའི་"
    },
    {
      "span": {
        "start": 32680,
        "end": 32691
      },
      "text": "གཞོགས་སློང་ ༼སྣར། པེ།༽ གཞོག་སློངས་"
    },
    {
      "span": {
        "start": 32696,
        "end": 32700
      },
      "text": "ཐོབ་ ༼སྣར། པེ།༽ འཐོབ་"
    },
    {
      "span": {
        "start": 32705,
        "end": 32711
      },
      "text": "འཇལ་བ་ ༼སྣར།༽ འཇལ་བ་བ་"
    },
    {
      "span": {
        "start": 32799,
        "end": 32812
      },
      "text": "དེ་དག་གིས་མི་ ༼པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 32918,
        "end": 32926
      },
      "text": "བསལ་བའི་ ༼སྣར།༽ གསལ་བའི་"
    },
    {
      "span": {
        "start": 32954,
        "end": 32959
      },
      "text": "རྩོལ་ ༼སྣར། པེ།༽ རྩོམ་"
    },
    {
      "span": {
        "start": 33753,
        "end": 33764
      },
      "text": "སེམས་དཔའ་ལ་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 33858,
        "end": 33869
      },
      "text": "དགའ་བའི་རང་ ༼སྣར། པེ།༽ དགའ་བའི་"
    },
    {
      "span": {
        "start": 33891,
        "end": 33896
      },
      "text": "དག་པ་ ༼སྣར། པེ།༽ དག་པར་"
    },
    {
      "span": {
        "start": 33938,
        "end": 33946
      },
      "text": "གཅིག་ཏུ་ ༼སྣར། པེ།༽ གཅིག་པུ་"
    },
    {
      "span": {
        "start": 34011,
        "end": 34019
      },
      "text": "འདས་པ་ལ་ ༼སྣར། པེ།༽ འདས་པ་"
    },
    {
      "span": {
        "start": 34298,
        "end": 34308
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 34347,
        "end": 34352
      },
      "text": "སྨྲས་ ༼སྣར། པེ།༽ སྨྲ་"
    },
    {
      "span": {
        "start": 34460,
        "end": 34472
      },
      "text": "སེམས་དཔས་ནི་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 34528,
        "end": 34537
      },
      "text": "བསྟེན་པར་ ༼སྣར། པེ།༽ བརྟེན་པར་"
    },
    {
      "span": {
        "start": 34672,
        "end": 34681
      },
      "text": "བསྟེན་པར་ ༼སྣར། པེ།༽ བརྟེན་པར་"
    },
    {
      "span": {
        "start": 34857,
        "end": 34865
      },
      "text": "བརྩོན་པ་ ༼སྣར། པེ།༽ རྩོན་པ་"
    },
    {
      "span": {
        "start": 34869,
        "end": 34871
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 34913,
        "end": 34921
      },
      "text": "གོམས་པར་ ༼སྣར། པེ།༽ གོམ་པར་"
    },
    {
      "span": {
        "start": 35001,
        "end": 35008
      },
      "text": "ཁྱད་པར་ ༼སྣར། པེ།༽ ཁྱད་"
    },
    {
      "span": {
        "start": 35011,
        "end": 35018
      },
      "text": "འཕགས་པ་ ༼སྣར། པེ།༽ འཕགས་པར་"
    },
    {
      "span": {
        "start": 35131,
        "end": 35140
      },
      "text": "སེམས་དཔས་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 35316,
        "end": 35323
      },
      "text": "ཅན་གྱི་ ༼སྣར། པེ།༽ ཅན་"
    },
    {
      "span": {
        "start": 35451,
        "end": 35458
      },
      "text": "ཅན་གྱི་ ༼སྣར། པེ།༽ ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 35581,
        "end": 35586
      },
      "text": "སློང་ ༼སྣར། པེ།༽ སློངས་"
    },
    {
      "span": {
        "start": 35626,
        "end": 35633
      },
      "text": "སྙན་པར་ ༼སྣར། པེ།༽ སྙན་པ་"
    },
    {
      "span": {
        "start": 35833,
        "end": 35841
      },
      "text": "འགྱུར་བ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 35846,
        "end": 35858
      },
      "text": "བཞིན་དུ་ཡིད་ ༼སྣར། པེ།༽ བཞིན་དུ་"
    },
    {
      "span": {
        "start": 36051,
        "end": 36056
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 36168,
        "end": 36176
      },
      "text": "བརྡེག་པ་ ༼སྣར། པེ།༽ རྡེག་པ་"
    },
    {
      "span": {
        "start": 36209,
        "end": 36218
      },
      "text": "ཕྱིར་མཚང་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 36332,
        "end": 36339
      },
      "text": "འདོར། ། ༼སྣར། པེ།༽ འཇོག །"
    },
    {
      "span": {
        "start": 36551,
        "end": 36557
      },
      "text": "འགྱུར་ ༼པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 36915,
        "end": 36922
      },
      "text": "བཅས་པར་ ༼སྣར། པེ།༽ བཅས་པ་"
    },
    {
      "span": {
        "start": 37211,
        "end": 37221
      },
      "text": "ལ་བདག་གིས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 37227,
        "end": 37233
      },
      "text": "བྱས་པ་ ༼སྣར། པེ།༽ བྱུང་བ་"
    },
    {
      "span": {
        "start": 37401,
        "end": 37410
      },
      "text": "གཞན་དག་ལ་ ༼སྣར། པེ།༽ གཞན་དག་"
    },
    {
      "span": {
        "start": 37498,
        "end": 37505
      },
      "text": "ཐོ་འཚམ་ ༼སྣར། པེ།༽ མཐོ་འཚམས་"
    },
    {
      "span": {
        "start": 37729,
        "end": 37739
      },
      "text": "ཉིད་དུ་མི་ ༼སྣར། པེ།༽ ཉིད་དུ་"
    },
    {
      "span": {
        "start": 37912,
        "end": 37921
      },
      "text": "སེམས་ཀྱི་ ༼སྣར། པེ།༽ སེམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 37943,
        "end": 37953
      },
      "text": "སེམས་དཔའི་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 37990,
        "end": 37992
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 38586,
        "end": 38591
      },
      "text": "གློས་ ༼སྣར། པེ།༽ བློས་"
    },
    {
      "span": {
        "start": 38625,
        "end": 38629
      },
      "text": "ཚོད་ ༼སྣར། པེ།༽ ཚོན་"
    },
    {
      "span": {
        "start": 38902,
        "end": 38911
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་དཔས་"
    },
    {
      "span": {
        "start": 38942,
        "end": 38952
      },
      "text": "སེམས་ཀྱིས་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 39116,
        "end": 39125
      },
      "text": "ཕ་རོལ་པོ་ ༼སྣར། པེ།༽ ཕ་རོལ་"
    },
    {
      "span": {
        "start": 39751,
        "end": 39755
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 39763,
        "end": 39767
      },
      "text": "གིས་ ༼སྣར། པེ།༽ གི་"
    },
    {
      "span": {
        "start": 39821,
        "end": 39825
      },
      "text": "སྤང་ ༼སྣར། པེ།༽ སྤོང་"
    },
    {
      "span": {
        "start": 40557,
        "end": 40566
      },
      "text": "སེམས་དཔས་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 40667,
        "end": 40676
      },
      "text": "སེམས་དཔས་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 40725,
        "end": 40739
      },
      "text": "ཅི་ཞིག་བྱ་སྟེ་ ༼སྣར།༽ ཅི་བྱས་ཏེ་ ༼པེ།༽ ཅི་བྱས་སྟེ་"
    },
    {
      "span": {
        "start": 41628,
        "end": 41638
      },
      "text": "ཡིད་གཞུངས་ ༼སྣར།༽ ཡིད་ལ་གཞུངས་ ༼པེ།༽ ཡིད་ལ་གཞུང་"
    },
    {
      "span": {
        "start": 41645,
        "end": 41656
      },
      "text": "ལོབས་སྐྱེན་ ༼པེ།༽ ལོ་རྐྱེན་"
    },
    {
      "span": {
        "start": 41677,
        "end": 41686
      },
      "text": "བརྗེད་པར་ ༼སྣར། པེ།༽ བརྗོད་པ་"
    },
    {
      "span": {
        "start": 41713,
        "end": 41722
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 41836,
        "end": 41846
      },
      "text": "གཅིག་བཞིན་ ༼སྣར། པེ།༽ གཅིག་"
    },
    {
      "span": {
        "start": 41939,
        "end": 41948
      },
      "text": "སེམས་དཔས་ ༼སྣར།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 42332,
        "end": 42344
      },
      "text": "སངས་རྒྱས་དང་ ༼སྣར། པེ།༽ སངས་རྒྱས་སམ་"
    },
    {
      "span": {
        "start": 42369,
        "end": 42374
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བརྩམས་"
    },
    {
      "span": {
        "start": 42580,
        "end": 42592
      },
      "text": "བདག་ཉིད་ཀྱི་ ༼སྣར། པེ།༽ བདག་ཉིད་"
    },
    {
      "span": {
        "start": 42791,
        "end": 42802
      },
      "text": "གནས་དག་ཐོས་ ༼སྣར། པེ།༽ གནས་ཐོབ་"
    },
    {
      "span": {
        "start": 42934,
        "end": 42943
      },
      "text": "སྤྱན་གྱི་ ༼སྣར། པེ།༽ སྤྱན་གྱིས་"
    },
    {
      "span": {
        "start": 43354,
        "end": 43359
      },
      "text": "ཀྱིས་ ༼སྣར། པེ།༽ ཀྱིས་གཞན་དག་ལ་"
    },
    {
      "span": {
        "start": 43562,
        "end": 43565
      },
      "text": "དེ། ༼སྣར། པེ།༽ དོ། །"
    },
    {
      "span": {
        "start": 43610,
        "end": 43617
      },
      "text": "མེད་དེ་ ༼སྣར། པེ།༽ མེད་དོ་"
    },
    {
      "span": {
        "start": 43808,
        "end": 43818
      },
      "text": "འབྲེལ་བའི་ ༼སྣར། པེ།༽ འབེལ་བའི་"
    },
    {
      "span": {
        "start": 44267,
        "end": 44279
      },
      "text": "གྱི་གདམས་ངག་ ༼སྣར། པེ།༽ གྱི་གཏམ་"
    },
    {
      "span": {
        "start": 44313,
        "end": 44319
      },
      "text": "ཐོས་པ་ ༼སྣར། པེ།༽ ཐོས་པ་དང་ཐོས་"
    },
    {
      "span": {
        "start": 44329,
        "end": 44335
      },
      "text": "ཐོས་པ་ ༼སྣར།༽ ཐོབ་པ་"
    },
    {
      "span": {
        "start": 44430,
        "end": 44439
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 44461,
        "end": 44471
      },
      "text": "། །ཤིན་ཏུ་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 44532,
        "end": 44536
      },
      "text": "མཉམ་ ༼སྣར།༽ མཉམ་པ་ལ་སེམས་མཉམ་"
    },
    {
      "span": {
        "start": 44598,
        "end": 44604
      },
      "text": "བརྟེན། ༼སྣར། པེ།༽ རྟེན།"
    },
    {
      "span": {
        "start": 44643,
        "end": 44653
      },
      "text": "བསམས་བཞིན་ ༼སྣར། པེ།༽ བསམ་བཞིན་"
    },
    {
      "span": {
        "start": 45042,
        "end": 45047
      },
      "text": "སྲུང་ ༼སྣར། པེ།༽ བསྲུང་"
    },
    {
      "span": {
        "start": 45058,
        "end": 45063
      },
      "text": "སྡུམ་ ༼སྣར། པེ།༽ བསྡུམ་"
    },
    {
      "span": {
        "start": 45380,
        "end": 45387
      },
      "text": "བཅོལ་བ་ ༼སྣར། པེ།༽ འཚོལ་བ་"
    },
    {
      "span": {
        "start": 45387,
        "end": 45393
      },
      "text": "དང་རང་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 45726,
        "end": 45732
      },
      "text": "འབོགས་ ༼སྣར། པེ།༽ འབོག་"
    },
    {
      "span": {
        "start": 45790,
        "end": 45798
      },
      "text": "སྲུང་བར་ ༼སྣར། པེ།༽ བསྲུང་བར་"
    },
    {
      "span": {
        "start": 45914,
        "end": 45922
      },
      "text": "ནད་ཀྱིས་ ༼སྣར། པེ།༽ ནད་ཀྱི་"
    },
    {
      "span": {
        "start": 46248,
        "end": 46252
      },
      "text": "བཙལ་ ༼སྣར། པེ།༽ བཅོལ་"
    },
    {
      "span": {
        "start": 46407,
        "end": 46413
      },
      "text": "ཏེ་སོ་ ༼སྣར། པེ།༽ ཏེ་སོང་"
    },
    {
      "span": {
        "start": 46468,
        "end": 46472
      },
      "text": "རྟག་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 46519,
        "end": 46529
      },
      "text": "བསྲུང་བའི་ ༼སྣར།༽ སྲུང་བའི་"
    },
    {
      "span": {
        "start": 46637,
        "end": 46646
      },
      "text": "མེད་དོ། ། ༼སྣར།༽ མེད་།། །།"
    },
    {
      "span": {
        "start": 46710,
        "end": 46712
      },
      "text": "པ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 46750,
        "end": 46772
      },
      "text": "བའི་སྡུག་བསྔལ་བསལ་བའི་ ༼སྣར། པེ།༽ བའི་"
    },
    {
      "span": {
        "start": 46866,
        "end": 46872
      },
      "text": "དང་ཚེ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 47152,
        "end": 47155
      },
      "text": "ཅན་ ༼སྣར། པེ།༽ ཅན་གྱི་"
    },
    {
      "span": {
        "start": 47190,
        "end": 47197
      },
      "text": "ཤེས་ཏེ་ ༼སྣར། པེ།༽ ཤེས་"
    },
    {
      "span": {
        "start": 47573,
        "end": 47579
      },
      "text": "བྱས་ལ་ ༼སྣར། པེ།༽ བྱས་པ་"
    },
    {
      "span": {
        "start": 47616,
        "end": 47626
      },
      "text": "སེམས་ཅན་ལ་ ༼སྣར། པེ།༽ སེམས་ཅན་"
    },
    {
      "span": {
        "start": 47823,
        "end": 47832
      },
      "text": "འགྱུར་རོ། ༼སྣར། པེ།༽ འགྱུར་ཏེ།"
    },
    {
      "span": {
        "start": 47904,
        "end": 47912
      },
      "text": "བསྒྲིམས་ ༼སྣར། པེ།༽ བསྒྲིབས་"
    },
    {
      "span": {
        "start": 48031,
        "end": 48038
      },
      "text": "འདོད་ན་ ༼སྣར། པེ།༽ འདོད་"
    },
    {
      "span": {
        "start": 48131,
        "end": 48140
      },
      "text": "གྱུར་པའི་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 48450,
        "end": 48458
      },
      "text": "བརྩམས་པ་ ༼སྣར། པེ།༽ བརྩམས་པའི་"
    },
    {
      "span": {
        "start": 48593,
        "end": 48604
      },
      "text": "ལ་སོགས་པའི་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 49263,
        "end": 49271
      },
      "text": "དད་པ་ཅན་ ༼སྣར། པེ།༽ དད་པ་"
    },
    {
      "span": {
        "start": 49589,
        "end": 49598
      },
      "text": "དེས་འདུལ་ ༼སྣར། པེ།༽ དེ་དུལ་"
    },
    {
      "span": {
        "start": 49772,
        "end": 49788
      },
      "text": "བསོད་ནམས་ཆེན་པོ་ ༼སྣར། པེ།༽ བསོད་ནམས་"
    },
    {
      "span": {
        "start": 49893,
        "end": 49904
      },
      "text": "གདམས་ངག་དང་ ༼སྣར། པེ།༽ གདམས་ངག་"
    },
    {
      "span": {
        "start": 49977,
        "end": 49986
      },
      "text": "ཆོས་རྐུར་ ༼སྣར། པེ།༽ ཆོས་སྐུར་"
    },
    {
      "span": {
        "start": 50374,
        "end": 50382
      },
      "text": "ནི་འཕྲད་ ༼སྣར། པེ།༽ མི་འཕྲོད་"
    },
    {
      "span": {
        "start": 50597,
        "end": 50605
      },
      "text": "གཅད་པའི་ ༼སྣར། པེ།༽ བཅད་པའི་"
    },
    {
      "span": {
        "start": 50631,
        "end": 50640
      },
      "text": "དེས་འདུལ་ ༼སྣར། པེ།༽ དེ་དུལ་"
    },
    {
      "span": {
        "start": 50776,
        "end": 50787
      },
      "text": "གཞན་དག་གིས་ ༼པེ།༽ གཞན་དག་གི་"
    },
    {
      "span": {
        "start": 50804,
        "end": 50812
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 51459,
        "end": 51466
      },
      "text": "སྨྲས་པ་ ༼སྣར། པེ།༽ སྨྲས་པ་ཡང་ལེགས་པར་སྨྲས་པ་"
    },
    {
      "span": {
        "start": 51531,
        "end": 51539
      },
      "text": "གཅད་པའི་ ༼སྣར། པེ།༽ བཅད་པའི་"
    },
    {
      "span": {
        "start": 51685,
        "end": 51693
      },
      "text": "གཅད་པའི་ ༼སྣར། པེ།༽ བཅད་པའི་"
    },
    {
      "span": {
        "start": 51989,
        "end": 51993
      },
      "text": "པའི་ ༼སྣར།༽ པར་"
    },
    {
      "span": {
        "start": 52136,
        "end": 52156
      },
      "text": "མནར་སེམས་ཀྱི་སེམས་ཆ་ ༼སྣར། པེ།༽ མནར་སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 52242,
        "end": 52246
      },
      "text": "མཚང་ ༼སྣར། པེ།༽ འཚང་"
    },
    {
      "span": {
        "start": 52279,
        "end": 52295
      },
      "text": "འགྱུར་བར་མི་འཐད་ ༼སྣར། པེ།༽ འགྱུར་བར་མཐོང་"
    },
    {
      "span": {
        "start": 52321,
        "end": 52327
      },
      "text": "འཁྲུག་ ༼སྣར།༽ འཁྲུགས་"
    },
    {
      "span": {
        "start": 52331,
        "end": 52339
      },
      "text": "འབྱེ་བར་ ༼སྣར། པེ།༽ འབྱེད་པར་"
    },
    {
      "span": {
        "start": 52615,
        "end": 52622
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 52958,
        "end": 52965
      },
      "text": "དག་ཅིག་ ༼སྣར། པེ།༽ དག་གཅིག་"
    },
    {
      "span": {
        "start": 53075,
        "end": 53082
      },
      "text": "མནོས་པ་ ༼སྣར། པེ།༽ ནོས་པ་"
    },
    {
      "span": {
        "start": 53816,
        "end": 53824
      },
      "text": "བྱ་བ་ནི་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 53871,
        "end": 53873
      },
      "text": "བ་ ༼སྣར།༽ བར་"
    },
    {
      "span": {
        "start": 53918,
        "end": 53924
      },
      "text": "སྡང་བ་ ༼སྣར།༽ ལྡང་བ་"
    },
    {
      "span": {
        "start": 54172,
        "end": 54180
      },
      "text": "ཉི་ཤུའི་ ༼སྣར། པེ།༽ ཉི་ཤུ་པའི་"
    },
    {
      "span": {
        "start": 54205,
        "end": 54213
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 54393,
        "end": 54405
      },
      "text": "དུ་གྱུར།། །། ༼སྣར། པེ།༽ དུ་མྱུར་གྱུར་"
    },
    {
      "span": {
        "start": 54412,
        "end": 54422
      },
      "text": "ཉི་ཤུ་པའི་ ༼ཅོ།༽ ཉི་ཤུའི་"
    }
  ]
}