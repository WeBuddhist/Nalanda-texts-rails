{
  "durchens": [
    {
      "span": {
        "start": 226,
        "end": 234
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 1001,
        "end": 1008
      },
      "text": "རྗོད་པ་ ༼སྣར། པེ།༽ བརྗོད་པ་"
    },
    {
      "span": {
        "start": 1130,
        "end": 1140
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 1504,
        "end": 1509
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ གཉིས་པ་"
    },
    {
      "span": {
        "start": 2711,
        "end": 2722
      },
      "text": "སྟོབས་ཀྱིས་ ༼སྣར། པེ།༽ སྟོབས་ཀྱི་"
    },
    {
      "span": {
        "start": 3402,
        "end": 3406
      },
      "text": "གཞལ་ ༼སྣར། པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 3444,
        "end": 3447
      },
      "text": "ལྟ། ༼སྣར། པེ།༽ བལྟ།"
    },
    {
      "span": {
        "start": 3717,
        "end": 3721
      },
      "text": "མེད་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 3880,
        "end": 3885
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 4288,
        "end": 4290
      },
      "text": "ན་ ༼སྣར།༽ ནི་"
    },
    {
      "span": {
        "start": 7242,
        "end": 7246
      },
      "text": "ནགས་ ༼སྣར། པེ།༽ གནས་"
    },
    {
      "span": {
        "start": 7734,
        "end": 7738
      },
      "text": "སེལ་ ༼སྣར། པེ།༽ སེལ་བ་"
    },
    {
      "span": {
        "start": 8703,
        "end": 8711
      },
      "text": "གཤེགས་པ་ ༼པེ།༽ གཤེགས་"
    },
    {
      "span": {
        "start": 8892,
        "end": 8904
      },
      "text": "དགའ་ལྡན་གྱི་ ༼སྣར། པེ།༽ དགའ་ལྡན་གྱིས་"
    }
  ]
}