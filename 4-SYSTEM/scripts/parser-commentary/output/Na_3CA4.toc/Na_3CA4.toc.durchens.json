{
  "durchens": [
    {
      "span": {
        "start": 178,
        "end": 185
      },
      "text": "གསུམ་ལ་ ༼པེ།༽ གསུམ་"
    },
    {
      "span": {
        "start": 619,
        "end": 626
      },
      "text": "བརྒྱུད་ ༼པེ།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 676,
        "end": 681
      },
      "text": "རྙེད་ ༼སྣར།༽ བསྙེད་"
    },
    {
      "span": {
        "start": 731,
        "end": 739
      },
      "text": "གྲགས་པར་ ༼སྣར། པེ།༽ གྲགས་"
    },
    {
      "span": {
        "start": 833,
        "end": 837
      },
      "text": "མཚན་ ༼པེ།༽ མཚན་ཉིད་"
    },
    {
      "span": {
        "start": 1010,
        "end": 1018
      },
      "text": "སྙིང་པོ་ ༼པེ།༽ གཉེན་པོ་"
    },
    {
      "span": {
        "start": 1112,
        "end": 1116
      },
      "text": "ཐ་མ་ ༼པེ།༽ མཐའ་མ་"
    },
    {
      "span": {
        "start": 1164,
        "end": 1169
      },
      "text": "སྔོན་ ༼སྣར། པེ།༽ སྔོན་པོ་"
    },
    {
      "span": {
        "start": 1359,
        "end": 1371
      },
      "text": "རྡོ་རྗེ་སྟེ་ ༼པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 1467,
        "end": 1474
      },
      "text": "བསྐྱེད་ ༼པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 1572,
        "end": 1582
      },
      "text": "སྙེད་ཀྱིས་ ༼སྣར།༽ སྙེད་ཀྱི་"
    },
    {
      "span": {
        "start": 1639,
        "end": 1651
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼སྣར།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 1688,
        "end": 1692
      },
      "text": "གཏད་ ༼སྣར།༽ བཏད་"
    },
    {
      "span": {
        "start": 1786,
        "end": 1794
      },
      "text": "གཙིགས་པ་ ༼སྣར།༽ གཅིག་པ་"
    },
    {
      "span": {
        "start": 1815,
        "end": 1828
      },
      "text": "མཐུན་པའི་སྟེ། ༼པེ།༽ མཐུན་པས་ཏེ།"
    },
    {
      "span": {
        "start": 1843,
        "end": 1851
      },
      "text": "འདུལ་བས་ ༼སྣར།༽ འདུལ་བར་"
    },
    {
      "span": {
        "start": 1978,
        "end": 1986
      },
      "text": "སྟངས་ཏེ། ༼སྣར།༽ སྟང་སྟེ།"
    },
    {
      "span": {
        "start": 2773,
        "end": 2781
      },
      "text": "སྙན་གྱི་ ༼སྣར།༽ སྙན་གྱིས་"
    },
    {
      "span": {
        "start": 2987,
        "end": 2994
      },
      "text": "གདུག་པ་ ༼པེ།༽ གདུགས་པ་"
    },
    {
      "span": {
        "start": 3000,
        "end": 3002
      },
      "text": "ཟ་ ༼པེ།༽ ཟ་བ་"
    },
    {
      "span": {
        "start": 3176,
        "end": 3183
      },
      "text": "བསྒྲུབ་ ༼པེ།༽ སྦྲུབ་"
    },
    {
      "span": {
        "start": 3276,
        "end": 3284
      },
      "text": "དཔྲལ་བར་ ༼སྣར།༽ དང་དཔྲལ་བ་ ༼པེ།༽ དང་དང་དཔྲལ་བ་"
    },
    {
      "span": {
        "start": 3361,
        "end": 3365
      },
      "text": "དང་། ༼པེ།༽ དང་མཁའ་འགྲོ་ལ་སོགས་པ་ཐམས་ཅད་འདུལ་བ་དང་།"
    },
    {
      "span": {
        "start": 3682,
        "end": 3698
      },
      "text": "འགྱུ་བ་ཞེས་པ་ནི་ ༼པེ།༽ འགྱུ་བ་ཞེས་"
    },
    {
      "span": {
        "start": 3746,
        "end": 3753
      },
      "text": "དེས་ནི་ ༼སྣར།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 3791,
        "end": 3796
      },
      "text": "འཇིག་ ༼སྣར།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 3911,
        "end": 3917
      },
      "text": "ནི་ནམ་ ༼སྣར།༽ ནི་"
    },
    {
      "span": {
        "start": 3994,
        "end": 4020
      },
      "text": "ཁྱབ་འཇུག་ལ་སོགས་པ་དྲེགས་པ་ ༼སྣར།༽ ལ་སོགས་པ་དྲེག་པ་དྲེག་པ་ ༼པེ།༽ པ་"
    },
    {
      "span": {
        "start": 4039,
        "end": 4046
      },
      "text": "དངང་པར་ ༼པེ།༽ སྡང་བར་"
    },
    {
      "span": {
        "start": 4115,
        "end": 4119
      },
      "text": "འདབ་ ༼སྣར།༽ འདབས་"
    },
    {
      "span": {
        "start": 4161,
        "end": 4165
      },
      "text": "གིས་ ༼པེ།༽ གི་"
    },
    {
      "span": {
        "start": 4193,
        "end": 4203
      },
      "text": "གཉིས་ཀྱིས་ ༼སྣར།༽ གཉིས་ཀྱི་ ༼པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 4288,
        "end": 4303
      },
      "text": "བཅིངས་པས་འཁྲེས་ ༼སྣར། པེ།༽ བཅིངས་པ་ཁྲིས་"
    },
    {
      "span": {
        "start": 4405,
        "end": 4412
      },
      "text": "གདུག་པ་ ༼སྣར།༽ དུག་པ་ ༼པེ།༽ གདུགས་པ་"
    },
    {
      "span": {
        "start": 4415,
        "end": 4420
      },
      "text": "རྣམས་ ༼སྣར།༽ རྣམ་"
    },
    {
      "span": {
        "start": 4446,
        "end": 4453
      },
      "text": "མནན་པར་ ༼པེ།༽ གནོན་པར་"
    },
    {
      "span": {
        "start": 4663,
        "end": 4673
      },
      "text": "དབང་པོ་དང་ ༼སྣར།༽ དབང་པོ་"
    },
    {
      "span": {
        "start": 4883,
        "end": 4890
      },
      "text": "རླག་པར་ ༼པེ།༽ བརླག་པར་"
    },
    {
      "span": {
        "start": 5091,
        "end": 5095
      },
      "text": "ལོག་ ༼པེ།༽ ལོ་"
    },
    {
      "span": {
        "start": 5124,
        "end": 5133
      },
      "text": "འཁྲུག་པར་ ༼སྣར།༽ འཁྲུགས་པར་"
    },
    {
      "span": {
        "start": 5140,
        "end": 5148
      },
      "text": "སྤ་བཀོང་ ༼པེ།༽ དཔའ་སྐོང་"
    },
    {
      "span": {
        "start": 5410,
        "end": 5418
      },
      "text": "འཆིང་བར་ ༼པེ།༽ འཆི་བར་"
    },
    {
      "span": {
        "start": 5509,
        "end": 5516
      },
      "text": "རླག་པར་ ༼སྣར།༽ རླགས་ ༼པེ།༽ བརླག་པར་"
    },
    {
      "span": {
        "start": 5547,
        "end": 5551
      },
      "text": "ཀུན་ ༼པེ།༽ སྐུན་"
    },
    {
      "span": {
        "start": 5563,
        "end": 5573
      },
      "text": "མཆོད་པ་ནི་ ༼པེ།༽ མཆོད་པས་ན་"
    },
    {
      "span": {
        "start": 5616,
        "end": 5619
      },
      "text": "ནས་ ༼སྣར།༽ ནས་གནས་"
    },
    {
      "span": {
        "start": 5701,
        "end": 5711
      },
      "text": "སྙེད་ཀྱིས་ ༼སྣར།༽ སྙེད་ཀྱི་"
    },
    {
      "span": {
        "start": 5740,
        "end": 5767
      },
      "text": "སོ་ཞེས་སྨོས་པ་ལ། དེ་ནས་ཞེས་ ༼པེ།༽ སོ་ཞེས་"
    },
    {
      "span": {
        "start": 5918,
        "end": 5930
      },
      "text": "ཐམས་ཅད་ཀྱིས་ ༼སྣར།༽ ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 5943,
        "end": 5950
      },
      "text": "གསུང་པ་ ༼སྣར།༽ གསུངས་པ་"
    },
    {
      "span": {
        "start": 6016,
        "end": 6026
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 6096,
        "end": 6102
      },
      "text": "མོང་མ་ ༼པེ།༽ མོ་མ་"
    },
    {
      "span": {
        "start": 6126,
        "end": 6133
      },
      "text": "གང་གིས་ ༼སྣར།༽ གང་གི་"
    },
    {
      "span": {
        "start": 6230,
        "end": 6241
      },
      "text": "སྔགས་དེ་དག་ ༼པེ།༽ སྔགས་"
    },
    {
      "span": {
        "start": 6438,
        "end": 6440
      },
      "text": "ག་ ༼སྣར།༽ གཱ་"
    },
    {
      "span": {
        "start": 6469,
        "end": 6482
      },
      "text": "ནི་ལྷག་པར་རོ། ༼སྣར། པེ།༽ ནི་བདག་པོའོ།"
    },
    {
      "span": {
        "start": 6500,
        "end": 6519
      },
      "text": "བརྒྱད་ཀྱི་བདག་པོའོ། ༼སྣར། པེ།༽ བརྒྱད་དོ།"
    },
    {
      "span": {
        "start": 6733,
        "end": 6741
      },
      "text": "མེད་པའོ། ༼པེ།༽ མེད་དོ།"
    },
    {
      "span": {
        "start": 6759,
        "end": 6761
      },
      "text": "ཡ་ ༼སྣར།༽ ཡམ་ ༼པེ།༽ ཡཾ་"
    },
    {
      "span": {
        "start": 6799,
        "end": 6806
      },
      "text": "གང་གིས་ ༼སྣར།༽ གང་གི་"
    },
    {
      "span": {
        "start": 6890,
        "end": 6895
      },
      "text": "འདོར་ ༼སྣར།༽ མདོར་"
    },
    {
      "span": {
        "start": 7197,
        "end": 7204
      },
      "text": "ཅན་གྱི་ ༼པེ།༽ ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 7388,
        "end": 7394
      },
      "text": "བརྡེག་ ༼པེ།༽ བདྷེག་"
    },
    {
      "span": {
        "start": 7577,
        "end": 7582
      },
      "text": "ཆོམས་ ༼སྣར། པེ།༽ ཆོམ་"
    },
    {
      "span": {
        "start": 7649,
        "end": 7658
      },
      "text": "ཆོམས་ཤིག་ ༼སྣར།༽ ཆོམ་ཤིག་ ༼པེ།༽ ཆོམ་ཞིག་"
    },
    {
      "span": {
        "start": 7688,
        "end": 7690
      },
      "text": "ར་ ༼པེ།༽ རཱ་"
    },
    {
      "span": {
        "start": 7736,
        "end": 7745
      },
      "text": "ཆོམས་ཤིག་ ༼སྣར།༽ ཆོམ་ཤིག་ ༼པེ།༽ ཆོམ་ཞིག་"
    },
    {
      "span": {
        "start": 7771,
        "end": 7785
      },
      "text": "གཟི་བརྗིད་ཀྱི་ ༼པེ།༽ གཟི་བརྗིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 7791,
        "end": 7800
      },
      "text": "ཆོམས་ཤིག་ ༼སྣར།༽ ཆོམ་ཤིག་ ༼པེ།༽ ཆོམ་ཞིག་"
    },
    {
      "span": {
        "start": 7806,
        "end": 7813
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 7822,
        "end": 7824
      },
      "text": "ག་ ༼སྣར།༽ གཱ་"
    },
    {
      "span": {
        "start": 7936,
        "end": 7946
      },
      "text": "སྔགས་ཀྱིས་ ༼སྣར། པེ།༽ སྔགས་ཀྱི་"
    },
    {
      "span": {
        "start": 8046,
        "end": 8055
      },
      "text": "ཟུངས་ཤིག་ ༼སྣར། པེ།༽ ཟུང་ཞིག་"
    },
    {
      "span": {
        "start": 8061,
        "end": 8070
      },
      "text": "ཧཱུཾ་གིས་ ༼སྣར།༽ ཧཱུཾ་གི་"
    },
    {
      "span": {
        "start": 8086,
        "end": 8094
      },
      "text": "ཕཊ་ཀྱིས་ ༼སྣར།༽ ཕཊ་ཀྱི་"
    },
    {
      "span": {
        "start": 8171,
        "end": 8179
      },
      "text": "དུག་གིས་ ༼པེ།༽ དུག་"
    },
    {
      "span": {
        "start": 8346,
        "end": 8351
      },
      "text": "ཀྲ་མ་ ༼པེ།༽ ཀྲ་མཱ་"
    },
    {
      "span": {
        "start": 8365,
        "end": 8371
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 8376,
        "end": 8400
      },
      "text": "ཁྱོད་ཀྱི་ཐོགས་པ་མེད་པའི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱི་"
    },
    {
      "span": {
        "start": 8559,
        "end": 8569
      },
      "text": "སྲུལ་པོའི་ ༼པེ།༽ སྲུལ་པོའོ་"
    },
    {
      "span": {
        "start": 8650,
        "end": 8652
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནཱ་"
    },
    {
      "span": {
        "start": 8671,
        "end": 8679
      },
      "text": "ཡིན་གྱི་ ༼པེ།༽ ཡིན་གྱིས་"
    },
    {
      "span": {
        "start": 8738,
        "end": 8743
      },
      "text": "སྨྱོ་ ༼སྣར།༽ མྱོ་"
    },
    {
      "span": {
        "start": 8748,
        "end": 8753
      },
      "text": "ཀྱིས་ ༼སྣར།༽ ཀྱི་"
    },
    {
      "span": {
        "start": 8783,
        "end": 8787
      },
      "text": "པྲེ་ ༼པེ།༽ ཕྲེ་"
    },
    {
      "span": {
        "start": 8803,
        "end": 8805
      },
      "text": "ཤ་ ༼པེ།༽ ཤཱ་"
    },
    {
      "span": {
        "start": 8824,
        "end": 8841
      },
      "text": "ཡི་དྭགས་དང་ཤ་ཟའི་ ༼སྣར། པེ།༽ ཡི་དྭགས་ཀྱི་"
    },
    {
      "span": {
        "start": 8885,
        "end": 8887
      },
      "text": "ཤ་ ༼སྣར། པེ།༽ ཥ་"
    },
    {
      "span": {
        "start": 8906,
        "end": 8935
      },
      "text": "གནོད་སྦྱིན་དང་བརྗེད་བྱེད་ཀྱི་ ༼སྣར། པེ།༽ གནོད་སྦྱིན་གྱི་"
    },
    {
      "span": {
        "start": 9094,
        "end": 9096
      },
      "text": "ཤ་ ༼སྣར། པེ།༽ ཥ་"
    },
    {
      "span": {
        "start": 9101,
        "end": 9103
      },
      "text": "ཤ་ ༼སྣར། པེ།༽ ཥ་"
    },
    {
      "span": {
        "start": 9298,
        "end": 9300
      },
      "text": "ཤ་ ༼སྣར། པེ།༽ ཥ་"
    },
    {
      "span": {
        "start": 9323,
        "end": 9328
      },
      "text": "འདུན་ ༼པེ།༽ བདུན་"
    },
    {
      "span": {
        "start": 9358,
        "end": 9365
      },
      "text": "རླག་པར་ ༼པེ།༽ བརླག་པར་"
    },
    {
      "span": {
        "start": 9534,
        "end": 9552
      },
      "text": "ཉེ་བར་བསྡུས་པའོ། ། ༼སྣར།༽ ཉེ་བར་བསྡུད་པའོ་ ༼པེ།༽ ཉེ་བར་སྡུད་པའོ།། །།"
    },
    {
      "span": {
        "start": 9640,
        "end": 9655
      },
      "text": "གནོད་སྦྱིན་གྱི་ ༼པེ།༽ གནོད་སྦྱིན་གྱིས་"
    },
    {
      "span": {
        "start": 9705,
        "end": 9712
      },
      "text": "བཏང་བར་ ༼པེ།༽ གཏང་བར་"
    },
    {
      "span": {
        "start": 9759,
        "end": 9767
      },
      "text": "ནི་བཞིན་ ༼པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 9803,
        "end": 9808
      },
      "text": "བཙོག་ ༼པེ།༽ བརྩོག་"
    },
    {
      "span": {
        "start": 9825,
        "end": 9833
      },
      "text": "བརྡེག་པ་ ༼པེ།༽ རྡེག་པ་"
    },
    {
      "span": {
        "start": 10020,
        "end": 10026
      },
      "text": "བྲིའོ། ༼པེ།༽ བྲི།"
    },
    {
      "span": {
        "start": 10151,
        "end": 10160
      },
      "text": "ཁྲུས་བྱས་ ༼པེ།༽ ཁྲུས་"
    },
    {
      "span": {
        "start": 10181,
        "end": 10190
      },
      "text": "མཎྜལ་གྱི་ ༼པེ།༽ མཎྜལ་གྱིས་"
    },
    {
      "span": {
        "start": 10457,
        "end": 10466
      },
      "text": "གཡོན་གྱི་ ༼པེ།༽ གཡོན་གྱིས་"
    },
    {
      "span": {
        "start": 11062,
        "end": 11072
      },
      "text": "བསྟན་ཏོ། ། ༼པེ།༽ བསྟན་།། །།"
    },
    {
      "span": {
        "start": 11097,
        "end": 11104
      },
      "text": "ཤད་ཀྱི་ ༼པེ།༽ ཤད་ཀྱིས་"
    },
    {
      "span": {
        "start": 11156,
        "end": 11166
      },
      "text": "ནད་པའི་ནད་ ༼པེ།༽ ནད་"
    },
    {
      "span": {
        "start": 11412,
        "end": 11418
      },
      "text": "གལ་ཏེ་ ༼པེ།༽ གལ་"
    },
    {
      "span": {
        "start": 11488,
        "end": 11491
      },
      "text": "ཤད་ ༼སྣར།༽ བཤད་"
    },
    {
      "span": {
        "start": 11608,
        "end": 11617
      },
      "text": "ཀྱིས་གཅད་ ༼སྣར།༽ ཀྱི་བཅག་ ༼པེ།༽ ཀྱིས་བཅག་"
    },
    {
      "span": {
        "start": 11679,
        "end": 11684
      },
      "text": "བཅུག་ ༼སྣར།༽ ལྕུག་"
    },
    {
      "span": {
        "start": 11908,
        "end": 11915
      },
      "text": "རྩངས་མ་ ༼སྣར། པེ།༽ རྩངས་པ་"
    },
    {
      "span": {
        "start": 12176,
        "end": 12184
      },
      "text": "རྨ་བྱའི་ ༼པེ།༽ རྨ་བྱ་"
    },
    {
      "span": {
        "start": 12219,
        "end": 12223
      },
      "text": "བཞག་ ༼པེ།༽ གཞག་"
    },
    {
      "span": {
        "start": 12283,
        "end": 12288
      },
      "text": "བསམས་ ༼སྣར།༽ བསམ་"
    },
    {
      "span": {
        "start": 12321,
        "end": 12330
      },
      "text": "བསམས་པའི་ ༼སྣར།༽ བསམ་པའི་"
    },
    {
      "span": {
        "start": 12392,
        "end": 12397
      },
      "text": "མཇུག་ ༼སྣར།༽ འཇུག་"
    },
    {
      "span": {
        "start": 12476,
        "end": 12484
      },
      "text": "སྐད་ཅིག་ ༼པེ།༽ སྐ་ཅིག་"
    },
    {
      "span": {
        "start": 12568,
        "end": 12574
      },
      "text": "དེ་ནི་ ༼སྣར།༽ དེ་དེའི་"
    },
    {
      "span": {
        "start": 12594,
        "end": 12600
      },
      "text": "གའོ། ། ༼པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 12611,
        "end": 12617
      },
      "text": "བརྗེད་ ༼སྣར།༽ རྗེད་"
    },
    {
      "span": {
        "start": 12655,
        "end": 12661
      },
      "text": "བརྗེད་ ༼སྣར།༽ རྗེད་"
    },
    {
      "span": {
        "start": 12775,
        "end": 12780
      },
      "text": "གཉིད་ ༼སྣར།༽ གཉིས་"
    },
    {
      "span": {
        "start": 12831,
        "end": 12838
      },
      "text": "བྱས་ཏེ། ༼སྣར།༽ བྱ་སྟེ་"
    },
    {
      "span": {
        "start": 12907,
        "end": 12915
      },
      "text": "ཟངས་ཀྱི་ ༼པེ།༽ ཟངས་ཀྱིས་"
    },
    {
      "span": {
        "start": 13008,
        "end": 13018
      },
      "text": "བཞིན་ནོ། ། ༼པེ།༽ བཞིན་།། །།"
    },
    {
      "span": {
        "start": 13203,
        "end": 13212
      },
      "text": "མགུལ་པའམ་ ༼པེ།༽ མགུལ་ལམ་"
    },
    {
      "span": {
        "start": 13252,
        "end": 13262
      },
      "text": "གདོན་གྱིས་ ༼སྣར།༽ གདོན་གྱི་"
    },
    {
      "span": {
        "start": 13273,
        "end": 13280
      },
      "text": "ནད་ཀྱི་ ༼སྣར། པེ།༽ ནད་ཀྱིས་"
    },
    {
      "span": {
        "start": 13328,
        "end": 13331
      },
      "text": "རས་ ༼སྣར།༽ རལ་"
    },
    {
      "span": {
        "start": 13431,
        "end": 13441
      },
      "text": "རེ་རེ་ཞིང་ ༼པེ།༽ རེ་རེ་ཞེས་"
    },
    {
      "span": {
        "start": 13550,
        "end": 13559
      },
      "text": "བསྒོམས་ན་ ༼སྣར།༽ བསྒོམ་ནར་"
    },
    {
      "span": {
        "start": 13664,
        "end": 13669
      },
      "text": "གཏིང་ ༼སྣར།༽ བཏིང་"
    },
    {
      "span": {
        "start": 13829,
        "end": 13837
      },
      "text": "བླུགས་ལ། ༼སྣར།༽ བླུགས་པ།"
    },
    {
      "span": {
        "start": 13855,
        "end": 13861
      },
      "text": "བུག་པ་ ༼སྣར། པེ།༽ བུག་"
    },
    {
      "span": {
        "start": 14086,
        "end": 14093
      },
      "text": "ལོག་པར་ ༼སྣར། པེ།༽ ལྡོག་པར་"
    },
    {
      "span": {
        "start": 14099,
        "end": 14104
      },
      "text": "རོ། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 14196,
        "end": 14201
      },
      "text": "རོ། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 14232,
        "end": 14236
      },
      "text": "ཞེས་ ༼སྣར། པེ།༽ ཞེས་བྱ་"
    },
    {
      "span": {
        "start": 14283,
        "end": 14285
      },
      "text": "པ་ ༼པེ།༽ ན་"
    },
    {
      "span": {
        "start": 14341,
        "end": 14351
      },
      "text": "སྦྲུལ་གྱི་ ༼པེ།༽ སྦྲུལ་གྱིས་"
    },
    {
      "span": {
        "start": 14357,
        "end": 14361
      },
      "text": "ཅིག་ ༼སྣར།༽ ཤིག་"
    },
    {
      "span": {
        "start": 14394,
        "end": 14402
      },
      "text": "བྱབ་སྟེ་ ༼སྣར། པེ།༽ བྱབས་ཏེ་"
    },
    {
      "span": {
        "start": 14463,
        "end": 14468
      },
      "text": "འགུལ་ ༼སྣར།༽ མགུལ་"
    },
    {
      "span": {
        "start": 14471,
        "end": 14479
      },
      "text": "བསམ་ཤིང་ ༼པེ།༽ བསམ་ཞིང་"
    },
    {
      "span": {
        "start": 14502,
        "end": 14505
      },
      "text": "ལས་ ༼པེ།༽ ཧྲིཿལས་"
    },
    {
      "span": {
        "start": 14544,
        "end": 14546
      },
      "text": "ལ་ ༼སྣར།༽ ཧྲཱིཿལས་ ༼པེ།༽ ཧྲིཿལ་"
    },
    {
      "span": {
        "start": 14691,
        "end": 14698
      },
      "text": "བྱའོ། ། ༼པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 14717,
        "end": 14726
      },
      "text": "སྨྱུང་བར་ ༼པེ།༽ བསྙུང་བར་"
    },
    {
      "span": {
        "start": 14881,
        "end": 14888
      },
      "text": "བསྒོམས་ ༼སྣར།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 14936,
        "end": 14945
      },
      "text": "སྨྱུང་བར་ ༼པེ།༽ བསྙུང་བར་"
    },
    {
      "span": {
        "start": 14982,
        "end": 14987
      },
      "text": "བརྒྱ་ ༼པེ།༽ བརྒྱད་"
    },
    {
      "span": {
        "start": 15131,
        "end": 15140
      },
      "text": "སྨྱུང་བར་ ༼པེ།༽ བསྙུང་བར་"
    },
    {
      "span": {
        "start": 15474,
        "end": 15478
      },
      "text": "པའམ། ༼པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 15600,
        "end": 15609
      },
      "text": "གྲུབ་པའི་ ༼སྣར།༽ གྲུབ་པ་"
    },
    {
      "span": {
        "start": 15626,
        "end": 15636
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 15772,
        "end": 15785
      },
      "text": "ཡུངས་ཀར་གྱིས་ ༼སྣར།༽ ཡུངས་ཀར་གྱི་"
    },
    {
      "span": {
        "start": 15866,
        "end": 15884
      },
      "text": "བསྒྲུབ་པ་ལ་སོགས་པ། ༼སྣར། པེ།༽ བསྒྲུབས་ལ།"
    },
    {
      "span": {
        "start": 15942,
        "end": 15951
      },
      "text": "སྒོ་ལྕགས་ ༼སྣར། པེ།༽ ལྕགས་"
    },
    {
      "span": {
        "start": 15999,
        "end": 16003
      },
      "text": "ཁུང་ ༼པེ།༽ ཁུངས་"
    },
    {
      "span": {
        "start": 16060,
        "end": 16065
      },
      "text": "རོ། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 16164,
        "end": 16168
      },
      "text": "ཁུང་ ༼པེ།༽ ཁོང་"
    },
    {
      "span": {
        "start": 16196,
        "end": 16200
      },
      "text": "བཏང་ ༼པེ།༽ གཏང་"
    },
    {
      "span": {
        "start": 16202,
        "end": 16205
      },
      "text": "མེ་ ༼པེ།༽ མེ་གཏང་ལ་མེ་"
    },
    {
      "span": {
        "start": 16244,
        "end": 16258
      },
      "text": "བག་ཕྱེར་གཏུམས་ ༼སྣར།༽ ཆེར་གཏུམས་ ༼པེ།༽ བག་ཕྱེར་བཏུམས་"
    },
    {
      "span": {
        "start": 16276,
        "end": 16279
      },
      "text": "དང་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 16373,
        "end": 16379
      },
      "text": "འཇིགས་ ༼པེ།༽ །། །།འཇིག་"
    },
    {
      "span": {
        "start": 16477,
        "end": 16482
      },
      "text": "བཅུག་ ༼པེ།༽ བཅུ་"
    },
    {
      "span": {
        "start": 16780,
        "end": 16787
      },
      "text": "རེ་རེར་ ༼པེ།༽ རེ་རེ་"
    },
    {
      "span": {
        "start": 16963,
        "end": 16970
      },
      "text": "རྙིང་པ་ ༼སྣར། པེ།༽ སྙིང་པ་"
    },
    {
      "span": {
        "start": 16984,
        "end": 16990
      },
      "text": "གཟུངས་ ༼སྣར།༽ གཟུགས་"
    },
    {
      "span": {
        "start": 17065,
        "end": 17068
      },
      "text": "ཡང་ ༼སྣར། པེ།༽ ཡང་འཇིགས་པ་ཐམས་ཅད་ལས་"
    },
    {
      "span": {
        "start": 17080,
        "end": 17085
      },
      "text": "རོ། ། ༼སྣར།༽ །། །།"
    },
    {
      "span": {
        "start": 17203,
        "end": 17209
      },
      "text": "བསྔགས་ ༼སྣར། པེ།༽ སྔགས་"
    },
    {
      "span": {
        "start": 17248,
        "end": 17255
      },
      "text": "བྱའོ། ། ༼སྣར།༽ །། །།"
    },
    {
      "span": {
        "start": 17755,
        "end": 17761
      },
      "text": "སྒྲུབ་ ༼སྣར།༽ སྒྲུབས་"
    },
    {
      "span": {
        "start": 17855,
        "end": 17858
      },
      "text": "ཉི་ ༼པེ།༽ ཉི་མ་ཉི་"
    },
    {
      "span": {
        "start": 18063,
        "end": 18077
      },
      "text": "སྐུ་གཟུགས་ཀྱི་ ༼པེ།༽ སྐུ་གཟུགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 18100,
        "end": 18106
      },
      "text": "སྒྲུབ་ ༼སྣར།༽ སྒྲུབས་"
    },
    {
      "span": {
        "start": 18282,
        "end": 18289
      },
      "text": "རྣམས་ལ་ ༼སྣར།༽ རྣམས་"
    },
    {
      "span": {
        "start": 18597,
        "end": 18605
      },
      "text": "གནང་དབང་ ༼སྣར། པེ།༽ རྣ་དབང་"
    },
    {
      "span": {
        "start": 18796,
        "end": 18800
      },
      "text": "རྣམ་ ༼སྣར།༽ རྣམས་"
    },
    {
      "span": {
        "start": 18805,
        "end": 18816
      },
      "text": "ཐོབ་པར་ཤོག་ ༼པེ།༽ ཐོབ་པར་ཤོག།། །།"
    },
    {
      "span": {
        "start": 18944,
        "end": 18958
      },
      "text": "ཀླུ་གྲུབ་ཀྱིས་ ༼སྣར།༽ གྲུབ་ཀྱི་ ༼པེ།༽ ཀླུ་སྒྲུབ་ཀྱིས་"
    },
    {
      "span": {
        "start": 19040,
        "end": 19054
      },
      "text": "བརྩོན་སེང་གེས་ ༼སྣར།༽ བརྩོན་སེངྒེ་ ༼པེ།༽ བརྩོན་སེང་གིས་"
    }
  ]
}