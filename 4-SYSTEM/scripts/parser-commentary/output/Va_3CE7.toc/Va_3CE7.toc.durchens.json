{
  "durchens": [
    {
      "span": {
        "start": 593,
        "end": 596
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 701,
        "end": 705
      },
      "text": "ལ་མ་ ༼སྣར། པེ།༽ ལ་མི་"
    },
    {
      "span": {
        "start": 849,
        "end": 860
      },
      "text": "མི་དགེ་བའི་ ༼པེ།༽ མི་དགེ་"
    },
    {
      "span": {
        "start": 1038,
        "end": 1050
      },
      "text": "དྲུག་པོ་འདི་ ༼སྣར། པེ།༽ དྲུག་པོ་"
    },
    {
      "span": {
        "start": 1184,
        "end": 1194
      },
      "text": "བསྟན་ཏེ། ། ༼སྣར། པེ།༽ བསྟན་ཏོ།། །།"
    },
    {
      "span": {
        "start": 1278,
        "end": 1285
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 1295,
        "end": 1305
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 1968,
        "end": 1973
      },
      "text": "རྩ་བ་ ༼སྣར། པེ།༽ རྩ་བའི་"
    },
    {
      "span": {
        "start": 2679,
        "end": 2684
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ གཉིས་ནི་"
    },
    {
      "span": {
        "start": 2829,
        "end": 2841
      },
      "text": "བསྒྲུབས་པའི་ ༼སྣར། པེ།༽ སྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 3035,
        "end": 3044
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 3441,
        "end": 3446
      },
      "text": "སྡུད་ ༼སྣར།༽ སྡུས་"
    }
  ]
}