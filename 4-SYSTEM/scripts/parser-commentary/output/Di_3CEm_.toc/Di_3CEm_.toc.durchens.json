{
  "durchens": [
    {
      "span": {
        "start": 86,
        "end": 89
      },
      "text": "དེ་ ༼སྣར། པེ།༽ ད་ན་"
    },
    {
      "span": {
        "start": 180,
        "end": 198
      },
      "text": "གླང་པོའི་ཞབས་ཀྱིས་ ༼སྣར། པེ།༽ གླང་པོས་"
    },
    {
      "span": {
        "start": 306,
        "end": 313
      },
      "text": "ཡོད་དོ། ༼སྣར། པེ།༽ ཡོད་དེ།"
    },
    {
      "span": {
        "start": 814,
        "end": 823
      },
      "text": "ཡིད་ཀྱིས་ ༼སྣར།༽ ཡིད་ཀྱི་"
    },
    {
      "span": {
        "start": 893,
        "end": 896
      },
      "text": "ཟད་ ༼སྣར།༽ བཟད་"
    },
    {
      "span": {
        "start": 1093,
        "end": 1098
      },
      "text": "བླ་ན་ ༼སྣར། པེ།༽ བླ་"
    },
    {
      "span": {
        "start": 1315,
        "end": 1343
      },
      "text": "། །དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ལ་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 2241,
        "end": 2250
      },
      "text": "སྦྱང་བའི་ ༼སྣར། པེ།༽ བྱང་བའི་"
    },
    {
      "span": {
        "start": 2433,
        "end": 2440
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ བསྟན་པས་"
    },
    {
      "span": {
        "start": 2474,
        "end": 2483
      },
      "text": "གང་གསུངས་ ༼སྣར། པེ།༽ གསུངས་"
    },
    {
      "span": {
        "start": 2928,
        "end": 2936
      },
      "text": "སྤྱོད་པ་ ༼སྣར། པེ།༽ སྤྱོད་"
    },
    {
      "span": {
        "start": 3152,
        "end": 3163
      },
      "text": "ནན་ཏན་གྱིས་ ༼སྣར། པེ།༽ ནན་ཏན་གྱི་"
    },
    {
      "span": {
        "start": 3443,
        "end": 3451
      },
      "text": "སྦྱོང་བ་ ༼སྣར། པེ།༽ སྦྱང་བ་"
    },
    {
      "span": {
        "start": 3752,
        "end": 3761
      },
      "text": "འཇུག་པའི་ ༼སྣར། པེ།༽ འཇུག་པ་ནི་"
    },
    {
      "span": {
        "start": 3877,
        "end": 3882
      },
      "text": "གསུང་ ༼སྣར།༽ གསུངས་"
    },
    {
      "span": {
        "start": 3974,
        "end": 3984
      },
      "text": "བསྐོར་བ་ལ་ ༼སྣར། པེ།༽ བསྐོར་བ་"
    },
    {
      "span": {
        "start": 4016,
        "end": 4021
      },
      "text": "གསུང་ ༼སྣར།༽ གསུངས་"
    },
    {
      "span": {
        "start": 4258,
        "end": 4269
      },
      "text": "འཇུག་པར་གང་ ༼སྣར། པེ།༽ འཇུག་པར་"
    },
    {
      "span": {
        "start": 4649,
        "end": 4654
      },
      "text": "གཞོམ་ ༼སྣར། པེ།༽ བཞོམ་"
    },
    {
      "span": {
        "start": 4669,
        "end": 4680
      },
      "text": "གསུམ་དུ་གང་ ༼སྣར། པེ།༽ གསུམ་དུ་"
    },
    {
      "span": {
        "start": 4785,
        "end": 4792
      },
      "text": "སྦྱང་བ་ ༼སྣར། པེ།༽ སྤྱངས་པ་"
    },
    {
      "span": {
        "start": 5116,
        "end": 5135
      },
      "text": "ཡིད་ཀྱི་སྤྱོད་པ་དང་ ༼སྣར། པེ།༽ ཡིད་ཀྱི་"
    },
    {
      "span": {
        "start": 5627,
        "end": 5635
      },
      "text": "ཕྱི་མའོ། ༼སྣར། པེ།༽ ཕྱི་མའིའོ།"
    },
    {
      "span": {
        "start": 5702,
        "end": 5709
      },
      "text": "གཟུང་བ་ ༼སྣར། པེ།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 6176,
        "end": 6183
      },
      "text": "སྤང་བར་ ༼སྣར། པེ།༽ སྤངས་པར་"
    },
    {
      "span": {
        "start": 6273,
        "end": 6279
      },
      "text": "སྐལ་བ་ ༼པེ།༽ བསྐལ་པ་"
    },
    {
      "span": {
        "start": 7262,
        "end": 7275
      },
      "text": "སེམས་ཅན་གྱིས་ ༼པེ།༽ སེམས་ཅན་གྱི་"
    },
    {
      "span": {
        "start": 8270,
        "end": 8284
      },
      "text": "འཇིག་རྟེན་གྱི་ ༼སྣར། པེ།༽ འཇིག་རྟེན་"
    },
    {
      "span": {
        "start": 8342,
        "end": 8355
      },
      "text": "དུས་གསུམ་གྱི་ ༼སྣར། པེ།༽ དུས་གསུམ་གྱིས་"
    },
    {
      "span": {
        "start": 8468,
        "end": 8475
      },
      "text": "དོགས་པ་ ༼སྣར། པེ།༽ དགོས་པ་"
    },
    {
      "span": {
        "start": 8631,
        "end": 8638
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 9113,
        "end": 9123
      },
      "text": "གཤེགས་པའོ་ ༼སྣར། པེ།༽ གཤེགས་པའི་"
    },
    {
      "span": {
        "start": 9526,
        "end": 9530
      },
      "text": "གཞན་ ༼སྣར། པེ།༽ གཞལ་"
    },
    {
      "span": {
        "start": 9731,
        "end": 9735
      },
      "text": "བཟང་ ༼སྣར།༽ ཟང་དེ་"
    },
    {
      "span": {
        "start": 10186,
        "end": 10201
      },
      "text": "སངས་རྒྱས་རྣམ་པ་ ༼སྣར། པེ།༽ སངས་རྒྱས་རྣམས་"
    },
    {
      "span": {
        "start": 10301,
        "end": 10311
      },
      "text": "སྙེད་ཀྱིས་ ༼སྣར། པེ།༽ སྙེད་ཀྱི་"
    },
    {
      "span": {
        "start": 10508,
        "end": 10511
      },
      "text": "དུ་ ༼སྣར། པེ།༽ དུ་ཡང་"
    },
    {
      "span": {
        "start": 10597,
        "end": 10607
      },
      "text": "དབྱིངས་ནི་ ༼སྣར། པེ།༽ དབྱིངས་"
    },
    {
      "span": {
        "start": 10656,
        "end": 10663
      },
      "text": "ཐམས་ཅད་ ༼སྣར། པེ།༽ ཐམས་ཅད་དུ་"
    },
    {
      "span": {
        "start": 10850,
        "end": 10858
      },
      "text": "ལས་རྣམས་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 10885,
        "end": 10893
      },
      "text": "ཡིད་ཀྱི་ ༼སྣར། པེ།༽ ཡིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 11310,
        "end": 11321
      },
      "text": "ཡོན་ཏན་གྱི་ ༼སྣར། པེ།༽ ཡོན་ཏན་གྱིས་"
    },
    {
      "span": {
        "start": 11504,
        "end": 11510
      },
      "text": "ལྡན་པ། ༼སྣར། པེ།༽ ལྡན།"
    },
    {
      "span": {
        "start": 11594,
        "end": 11601
      },
      "text": "བྱའོ། ། ༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 12040,
        "end": 12045
      },
      "text": "ག་རུ་ ༼སྣར། པེ།༽ ཀ་རུ་"
    },
    {
      "span": {
        "start": 12292,
        "end": 12307
      },
      "text": "མེད་པའི་མཆོད་པ་ ༼སྣར། པེ།༽ མེད་པའི་"
    },
    {
      "span": {
        "start": 12533,
        "end": 12550
      },
      "text": "བདག་གི་བསམ་པས་སོ། ༼སྣར། པེ།༽ བདག་གིས་བསམ་པའོ།"
    },
    {
      "span": {
        "start": 12559,
        "end": 12565
      },
      "text": "སྤྱོད་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 12940,
        "end": 12947
      },
      "text": "གནས་ཏེ་ ༼སྣར། པེ།༽ གནས་དང་"
    },
    {
      "span": {
        "start": 12952,
        "end": 12956
      },
      "text": "གྱི་ ༼སྣར། པེ།༽ གྱིས་"
    },
    {
      "span": {
        "start": 13195,
        "end": 13204
      },
      "text": "འདོད་ཆགས་ ༼སྣར།༽ འདོད་ཆགས་དང་"
    },
    {
      "span": {
        "start": 13408,
        "end": 13414
      },
      "text": "སྨྱུར་ ༼སྣར། པེ།༽ བསྙུར་"
    },
    {
      "span": {
        "start": 13417,
        "end": 13423
      },
      "text": "སྐྱུག་ ༼སྣར། པེ།༽ བསྐུག་"
    },
    {
      "span": {
        "start": 13563,
        "end": 13571
      },
      "text": "བསྒོམ་པ་ ༼པེ།༽ བསྒོམས་པ་"
    },
    {
      "span": {
        "start": 13668,
        "end": 13693
      },
      "text": "གང་རང་རྒྱལ་བའི་རྣམ་པ་སྟེ། ༼སྣར། པེ།༽ རང་རྒྱལ་བའི་རྣམས་ཏེ།"
    },
    {
      "span": {
        "start": 13739,
        "end": 13748
      },
      "text": "གཉིས་ཀྱི་ ༼སྣར། པེ།༽ གཉིས་ཀྱིས་"
    },
    {
      "span": {
        "start": 13969,
        "end": 13977
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ གཏོགས་པ་"
    },
    {
      "span": {
        "start": 14272,
        "end": 14281
      },
      "text": "སྙེགས་པས་ ༼སྣར། པེ།༽ བསྙེགས་པས་"
    },
    {
      "span": {
        "start": 14373,
        "end": 14384
      },
      "text": "འགྲོ་བ་སྟེ་ ༼སྣར། པེ།༽ འགྲོ་བ་"
    },
    {
      "span": {
        "start": 14401,
        "end": 14409
      },
      "text": "འཁོར་བར་ ༼སྣར། པེ།༽ འཁོར་བས་"
    },
    {
      "span": {
        "start": 14540,
        "end": 14548
      },
      "text": "བསྐུལ་བ་ ༼སྣར། པེ།༽ བསྐུལ་བར་"
    },
    {
      "span": {
        "start": 14904,
        "end": 14915
      },
      "text": "སྟོབས་ཀྱིས་ ༼སྣར། པེ།༽ སྟོབས་ཀྱི་"
    },
    {
      "span": {
        "start": 15120,
        "end": 15122
      },
      "text": "བ་ ༼སྣར། པེ།༽ བར་"
    },
    {
      "span": {
        "start": 15253,
        "end": 15261
      },
      "text": "མུན་གནག་ ༼སྣར། པེ།༽ མུན་ནག་"
    },
    {
      "span": {
        "start": 15288,
        "end": 15299
      },
      "text": "ཡེ་ཤེས་ཀྱི་ ༼སྣར། པེ།༽ ཡེ་ཤེས་ཀྱིས་"
    },
    {
      "span": {
        "start": 15486,
        "end": 15490
      },
      "text": "འདའ་ ༼སྣར། པེ།༽ འདས་"
    },
    {
      "span": {
        "start": 15490,
        "end": 15495
      },
      "text": "སྟོན་ ༼སྣར།༽ སྟོན་པ་"
    },
    {
      "span": {
        "start": 15632,
        "end": 15638
      },
      "text": "བཅུ་ན་ ༼སྣར། པེ།༽ བཅུ་ནས་"
    },
    {
      "span": {
        "start": 15682,
        "end": 15686
      },
      "text": "འདའ་ ༼སྣར། པེ།༽ འདས་"
    },
    {
      "span": {
        "start": 16088,
        "end": 16097
      },
      "text": "སྙེད་ཀྱི་ ༼སྣར།༽ སྙེད་ཀྱིས་"
    },
    {
      "span": {
        "start": 16714,
        "end": 16721
      },
      "text": "གདགས་པ་ ༼སྣར།༽ བདགས་པ་ ༼པེ།༽ བདག་པ་"
    },
    {
      "span": {
        "start": 17385,
        "end": 17388
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 17420,
        "end": 17428
      },
      "text": "སྟོབས་པ་ ༼སྣར།༽ བསྟོབས་པ་"
    },
    {
      "span": {
        "start": 17491,
        "end": 17500
      },
      "text": "འབྱོན་པར་ ༼སྣར། པེ།༽ བྱོན་པར་"
    },
    {
      "span": {
        "start": 17508,
        "end": 17517
      },
      "text": "དེ་དག་གི་ ༼པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 17536,
        "end": 17549
      },
      "text": "སངས་རྒྱས་ཀྱི་ ༼སྣར། པེ།༽ སངས་རྒྱས་དང་"
    },
    {
      "span": {
        "start": 17553,
        "end": 17557
      },
      "text": "ཆུབ་ ༼སྣར། པེ།༽ ཆུབ་ཏུ་"
    },
    {
      "span": {
        "start": 17648,
        "end": 17656
      },
      "text": "དགོངས་པ་ ༼སྣར། པེ།༽ དགོངས་པར་"
    },
    {
      "span": {
        "start": 17665,
        "end": 17671
      },
      "text": "བསམ་པ་ ༼སྣར། པེ།༽ བསམ་པར་"
    },
    {
      "span": {
        "start": 17792,
        "end": 17797
      },
      "text": "གང་ན་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 17832,
        "end": 17846
      },
      "text": "གང་དག་ཡོད་པའོ། ༼སྣར། པེ།༽ གང་རུང་བའོ།"
    },
    {
      "span": {
        "start": 17973,
        "end": 17979
      },
      "text": "ཡས་ཅི་ ༼སྣར། པེ།༽ ཡས་ཀྱི་"
    },
    {
      "span": {
        "start": 18144,
        "end": 18151
      },
      "text": "ཞིང་བར་ ༼སྣར། པེ།༽ ཞིང་"
    },
    {
      "span": {
        "start": 18493,
        "end": 18500
      },
      "text": "རྙེད་པ་ ༼སྣར། པེ།༽ སྙེད་པ་"
    },
    {
      "span": {
        "start": 18587,
        "end": 18605
      },
      "text": "ཕུན་སུམ་ཚོགས་པ་དང་ ༼སྣར། པེ།༽ ཕུན་སུམ་"
    },
    {
      "span": {
        "start": 18612,
        "end": 18621
      },
      "text": "གྱུར་ཅིག་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 18705,
        "end": 18713
      },
      "text": "བསྟན་པར་ ༼སྣར། པེ།༽ བསྟན་པས་"
    },
    {
      "span": {
        "start": 18971,
        "end": 18977
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབས་"
    },
    {
      "span": {
        "start": 19326,
        "end": 19335
      },
      "text": "བསླབ་པའི་ ༼སྣར། པེ།༽ བསླབས་པའི་"
    },
    {
      "span": {
        "start": 19695,
        "end": 19699
      },
      "text": "ཀུན་ ༼སྣར།༽ ཀུན་ཏུ་"
    },
    {
      "span": {
        "start": 19829,
        "end": 19832
      },
      "text": "ཆེ་ ༼སྣར། པེ།༽ ཆེའི་"
    },
    {
      "span": {
        "start": 20090,
        "end": 20097
      },
      "text": "སློབ་པ་ ༼སྣར། པེ།༽ བསླབ་པ་"
    },
    {
      "span": {
        "start": 20265,
        "end": 20272
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ ད་ལྟར་"
    },
    {
      "span": {
        "start": 20467,
        "end": 20474
      },
      "text": "གདུང་བ་ ༼སྣར། པེ།༽ བདུང་བ་"
    },
    {
      "span": {
        "start": 20552,
        "end": 20561
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 20561,
        "end": 20569
      },
      "text": "འབའ་ཞིག་ ༼པེ།༽ འགའ་ཞིག་"
    },
    {
      "span": {
        "start": 20782,
        "end": 20788
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 21005,
        "end": 21014
      },
      "text": "སྐད་ཀྱིས་ ༼སྣར། པེ།༽ སྐད་དང་སྒྲ་ཡིས་"
    },
    {
      "span": {
        "start": 21254,
        "end": 21263
      },
      "text": "བཅུ་པོའོ། ༼སྣར། པེ།༽ བཅུ་པའོ།"
    },
    {
      "span": {
        "start": 21526,
        "end": 21537
      },
      "text": "བསྒྲིབས་པར་ ༼སྣར། པེ།༽ སྒྲིབ་པར་"
    },
    {
      "span": {
        "start": 21831,
        "end": 21839
      },
      "text": "སྦྱོར་བ་ ༼སྣར། པེ།༽ སྦྱོར་"
    },
    {
      "span": {
        "start": 22014,
        "end": 22021
      },
      "text": "ཕྱེད་པ་ ༼སྣར། པེ།༽ ཕྱེ་བ་"
    },
    {
      "span": {
        "start": 22191,
        "end": 22194
      },
      "text": "གང་ ༼སྣར། པེ།༽ གང་ན་"
    },
    {
      "span": {
        "start": 22343,
        "end": 22352
      },
      "text": "ཆགས་པ་དེ་ ༼སྣར། པེ།༽ ཆགས་པ་"
    },
    {
      "span": {
        "start": 22380,
        "end": 22392
      },
      "text": "བདུད་ཀྱི་ལས་ ༼སྣར། པེ།༽ བདུད་ཀྱི་"
    },
    {
      "span": {
        "start": 22510,
        "end": 22512
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 22801,
        "end": 22811
      },
      "text": "བཞུགས་ཤིང་ ༼སྣར། པེ།༽ ཞུགས་ཤིང་"
    },
    {
      "span": {
        "start": 22811,
        "end": 22818
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 23027,
        "end": 23030
      },
      "text": "ཆད་ ༼སྣར།༽ བྱད་"
    },
    {
      "span": {
        "start": 23093,
        "end": 23099
      },
      "text": "རྒྱུས་ ༼སྣར། པེ།༽ སྒྱུས་"
    },
    {
      "span": {
        "start": 23099,
        "end": 23107
      },
      "text": "འཚེ་བའོ། ༼སྣར། པེ།༽ འཚེ་བ་བའོ།"
    },
    {
      "span": {
        "start": 23431,
        "end": 23440
      },
      "text": "ཡིན་གྱིས། ༼སྣར། པེ།༽ ཡིན་གྱི།"
    },
    {
      "span": {
        "start": 23555,
        "end": 23563
      },
      "text": "འགོད་པར་ ༼པེ།༽ བགོད་པར་"
    },
    {
      "span": {
        "start": 23601,
        "end": 23610
      },
      "text": "སྤྱོད་པར་ ༼སྣར། པེ།༽ སྤྱད་པར་"
    },
    {
      "span": {
        "start": 23610,
        "end": 23615
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱས་པ་"
    },
    {
      "span": {
        "start": 24170,
        "end": 24176
      },
      "text": "སྤྱོད་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 24230,
        "end": 24235
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ སྒྱུ་"
    },
    {
      "span": {
        "start": 24599,
        "end": 24604
      },
      "text": "གཟུང་ ༼སྣར།༽ བཟུང་"
    },
    {
      "span": {
        "start": 24608,
        "end": 24617
      },
      "text": "ཐབས་ཀྱིས་ ༼སྣར།༽ ཐབས་ཀྱི་"
    },
    {
      "span": {
        "start": 24788,
        "end": 24796
      },
      "text": "ཡིད་ཀྱི་ ༼སྣར། པེ།༽ ཡིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 24822,
        "end": 24828
      },
      "text": "སྐལ་བ་ ༼སྣར།༽ བསྐལ་པ་"
    },
    {
      "span": {
        "start": 24864,
        "end": 24871
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ སྟེན་པ་"
    },
    {
      "span": {
        "start": 25170,
        "end": 25174
      },
      "text": "ཤིག་ ༼སྣར། པེ།༽ ཅིག་"
    },
    {
      "span": {
        "start": 25423,
        "end": 25429
      },
      "text": "ཟེར་བ་ ༼སྣར། པེ།༽ ཟེར་བ་དེ་"
    },
    {
      "span": {
        "start": 25489,
        "end": 25495
      },
      "text": "དེ་དག་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 25503,
        "end": 25515
      },
      "text": "ནམས་ཀྱང་སྟེ་ ༼སྣར། པེ།༽ ནམས་ཀྱང་"
    },
    {
      "span": {
        "start": 26322,
        "end": 26328
      },
      "text": "བཤད་པ་ ༼སྣར།༽ བཅད་པ་"
    },
    {
      "span": {
        "start": 26481,
        "end": 26486
      },
      "text": "པ་ནི་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 26614,
        "end": 26621
      },
      "text": "བྱ་བའོ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 26642,
        "end": 26651
      },
      "text": "བསྒྲག་པར་ ༼སྣར། པེ།༽ བསྒྲགས་པར་"
    },
    {
      "span": {
        "start": 26658,
        "end": 26669
      },
      "text": "ཆོས་ཉིད་དེ། ༼སྣར། པེ།༽ ཆོས་ཉིད་དོ།"
    },
    {
      "span": {
        "start": 26831,
        "end": 26836
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་པ་"
    },
    {
      "span": {
        "start": 26913,
        "end": 26920
      },
      "text": "བསྐལ་པ་ ༼སྣར། པེ།༽ སྐལ་པ་"
    },
    {
      "span": {
        "start": 26927,
        "end": 26935
      },
      "text": "སྤྱད་པར་ ༼ཅོ།༽ སྤྱོད་པར་"
    },
    {
      "span": {
        "start": 27370,
        "end": 27380
      },
      "text": "སེམས་དཔའི་ ༼སྡེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 27841,
        "end": 27861
      },
      "text": "གཤེགས་པ་ལ་བལྟ་བ་དང་། ༼སྣར། པེ།༽ གཤེགས་པ་བལྟ་ཞིང་།"
    },
    {
      "span": {
        "start": 28506,
        "end": 28513
      },
      "text": "སྤྱད་པ་ ༼ཅོ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 28513,
        "end": 28528
      },
      "text": "སྤྱོད་ཅིང་སྤྱད་ ༼སྣར། པེ།༽ སྤྱོད་"
    },
    {
      "span": {
        "start": 28650,
        "end": 28656
      },
      "text": "ཇི་ལྟ་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 28716,
        "end": 28724
      },
      "text": "གཅིག་གི་ ༼སྣར། པེ།༽ གཅིག་"
    },
    {
      "span": {
        "start": 28808,
        "end": 28817
      },
      "text": "སྙེད་ཀྱི་ ༼སྣར། པེ།༽ སྙེད་ཀྱིས་"
    },
    {
      "span": {
        "start": 28887,
        "end": 28893
      },
      "text": "རེ་རེ་ ༼སྣར། པེ།༽ རེ་རེ་ལ་"
    },
    {
      "span": {
        "start": 28998,
        "end": 29005
      },
      "text": "སྨོན་པ་ ༼སྣར། པེ།༽ སྨོན་པར་"
    },
    {
      "span": {
        "start": 29019,
        "end": 29026
      },
      "text": "བརྒལ་བ་ ༼སྣར། པེ།༽ བསྒལ་བ་"
    },
    {
      "span": {
        "start": 29114,
        "end": 29120
      },
      "text": "སྣྲེལ་ ༼སྣར།༽ སྣལ་"
    },
    {
      "span": {
        "start": 29631,
        "end": 29641
      },
      "text": "དངས་པས་གང་ ༼སྣར། པེ།༽ དང་བས་བཀང་"
    },
    {
      "span": {
        "start": 29789,
        "end": 29792
      },
      "text": "དེ། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 30267,
        "end": 30275
      },
      "text": "ཤོག་ཤིག་ ༼སྣར། པེ།༽ ཤོག་ཅིག་"
    },
    {
      "span": {
        "start": 30478,
        "end": 30486
      },
      "text": "རྣམས་སུ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 30614,
        "end": 30626
      },
      "text": "ཉན་པའི་འཁོར་ ༼སྣར། པེ།༽ ཉན་པ་"
    },
    {
      "span": {
        "start": 30676,
        "end": 30690
      },
      "text": "སངས་རྒྱས་ཀྱིས་ ༼སྣར། པེ།༽ སངས་རྒྱས་ཀྱི་"
    },
    {
      "span": {
        "start": 30841,
        "end": 30847
      },
      "text": "མང་པོ་ ༼སྣར། པེ།༽ མང་པོའི་"
    },
    {
      "span": {
        "start": 30899,
        "end": 30907
      },
      "text": "མོད་ཀྱི། ༼སྣར། པེ།༽ མོད་ཀྱིས།"
    },
    {
      "span": {
        "start": 31035,
        "end": 31041
      },
      "text": "ཡོད་པ་ ༼སྣར། པེ།༽ ཡོད་"
    },
    {
      "span": {
        "start": 31485,
        "end": 31491
      },
      "text": "མི་ཟད་ ༼སྣར། པེ།༽ མི་ཟད་པ་"
    },
    {
      "span": {
        "start": 31594,
        "end": 31600
      },
      "text": "བསྐོར་ ༼པེ།༽ སྐོར་"
    },
    {
      "span": {
        "start": 31632,
        "end": 31639
      },
      "text": "བགྲང་བ་ ༼སྣར། པེ།༽ བགྲང་"
    },
    {
      "span": {
        "start": 31741,
        "end": 31747
      },
      "text": "རྟོགས་ ༼སྣར། པེ།༽ སྟོབས་"
    },
    {
      "span": {
        "start": 31787,
        "end": 31796
      },
      "text": "ཐབས་ཀྱིས་ ༼སྣར། པེ།༽ ཐབས་ཀྱི་"
    },
    {
      "span": {
        "start": 31868,
        "end": 31870
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 32213,
        "end": 32221
      },
      "text": "གཅིག་གི་ ༼སྣར། པེ།༽ གཅིག་གིས་"
    },
    {
      "span": {
        "start": 32263,
        "end": 32266
      },
      "text": "ལྟ་ ༼སྣར། པེ།༽ བལྟ་"
    },
    {
      "span": {
        "start": 32285,
        "end": 32287
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 32511,
        "end": 32518
      },
      "text": "བྱ་བའོ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 32676,
        "end": 32687
      },
      "text": "ཡེ་ཤེས་ཀྱི་ ༼སྣར། པེ།༽ ཡེ་ཤེས་ཀྱིས་"
    },
    {
      "span": {
        "start": 32969,
        "end": 32976
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 33093,
        "end": 33104
      },
      "text": "ཡེ་ཤེས་ཀྱི་ ༼སྣར། པེ།༽ ཡེ་ཤེས་ཀྱིས་"
    },
    {
      "span": {
        "start": 33146,
        "end": 33154
      },
      "text": "བསྒྲུབས་ ༼སྣར། པེ།༽ སྒྲུབས་"
    },
    {
      "span": {
        "start": 33421,
        "end": 33424
      },
      "text": "བྱ། ༼སྣར། པེ།༽ བྱ་སྟེ།"
    },
    {
      "span": {
        "start": 33489,
        "end": 33491
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 33652,
        "end": 33659
      },
      "text": "མོས་པར་ ༼སྣར། པེ།༽ མོས་པས་"
    },
    {
      "span": {
        "start": 33978,
        "end": 33985
      },
      "text": "མཛེས་པ་ ༼སྣར། པེ།༽ འཛེས་པ་"
    },
    {
      "span": {
        "start": 34056,
        "end": 34063
      },
      "text": "བྱ་སྟེ། ༼སྣར། པེ།༽ བྱས་ཏེ་"
    },
    {
      "span": {
        "start": 34131,
        "end": 34136
      },
      "text": "བཀུར་ ༼སྣར། པེ།༽ བསྐུར་"
    },
    {
      "span": {
        "start": 34313,
        "end": 34322
      },
      "text": "འདས་རྣམས་ ༼སྣར། པེ།༽ འདས་"
    },
    {
      "span": {
        "start": 34381,
        "end": 34389
      },
      "text": "ཀླས་པ་ན་ ༼སྣར། པེ།༽ ཀླས་པ་ནས་"
    },
    {
      "span": {
        "start": 34518,
        "end": 34526
      },
      "text": "མངོན་པར་ ༼སྣར།༽ མངོན་པར་རྫོགས་པའི་བྱང་ཆུབ་ཏུ་མངོན་པར་"
    },
    {
      "span": {
        "start": 34629,
        "end": 34638
      },
      "text": "མྱ་ངན་ལས་ ༼པེ།༽ མྱ་ངན་"
    },
    {
      "span": {
        "start": 34831,
        "end": 34843
      },
      "text": "འདས་པ་རྣམ་པ་ ༼སྣར། པེ།༽ འདས་པ་རྣམས་"
    },
    {
      "span": {
        "start": 34866,
        "end": 34877
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱིས་"
    },
    {
      "span": {
        "start": 34881,
        "end": 34885
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱིས་"
    },
    {
      "span": {
        "start": 34954,
        "end": 34963
      },
      "text": "གཉིས་ཀྱི་ ༼སྣར། པེ།༽ གཉིས་ཀྱིས་"
    },
    {
      "span": {
        "start": 34976,
        "end": 34987
      },
      "text": "སྤྲིན་གྱིས་ ༼སྣར། པེ།༽ སྤྲིན་"
    },
    {
      "span": {
        "start": 35248,
        "end": 35264
      },
      "text": "སྟོན་པ་ཞེས་བྱའམ། ༼སྣར། པེ།༽ སྟོན་པ་ཞེའམ།"
    },
    {
      "span": {
        "start": 35290,
        "end": 35296
      },
      "text": "ཚིག་ཁ་ ༼སྣར། པེ།༽ ཚིག་"
    },
    {
      "span": {
        "start": 35395,
        "end": 35403
      },
      "text": "གནས་ཀྱི་ ༼སྣར། པེ།༽ གནས་ཀྱིས་"
    },
    {
      "span": {
        "start": 35431,
        "end": 35435
      },
      "text": "འཕོ་ ༼སྣར། པེ།༽ ཕོ་"
    },
    {
      "span": {
        "start": 35469,
        "end": 35477
      },
      "text": "ལྷས་ཕྱག་ ༼སྣར། པེ།༽ ལྷ་ཕྱག་"
    },
    {
      "span": {
        "start": 36202,
        "end": 36211
      },
      "text": "འགྲོ་བའོ། ༼སྣར། པེ།༽ བགྲོད་དོ།"
    },
    {
      "span": {
        "start": 36213,
        "end": 36222
      },
      "text": "འགྲོ་བ་ན་ ༼སྣར། པེ།༽ གོ་ཆ་ལ་"
    },
    {
      "span": {
        "start": 36279,
        "end": 36284
      },
      "text": "ཐོགས་ ༼སྣར། པེ།༽ ཐོག་"
    },
    {
      "span": {
        "start": 36693,
        "end": 36697
      },
      "text": "ཆོམ་ ༼སྣར། པེ།༽ ཆོམས་"
    },
    {
      "span": {
        "start": 36887,
        "end": 36890
      },
      "text": "ལས་ ༼སྡེ།༽ ལ་"
    },
    {
      "span": {
        "start": 36982,
        "end": 37002
      },
      "text": "སེམས་དཔའི་སྤྱོད་པའི་ ༼སྣར། པེ།༽ སེམས་དཔའི་"
    },
    {
      "span": {
        "start": 37039,
        "end": 37053
      },
      "text": "སྟོབས་ཀྱིས་སོ། ༼སྣར།༽ སྟོབས་ཀྱིས།"
    },
    {
      "span": {
        "start": 37310,
        "end": 37323
      },
      "text": "ཕྱི་ཕྱིར་ཞེས་ ༼སྣར། པེ།༽ ཕྱི་ཕྱིར་ཞིང་"
    },
    {
      "span": {
        "start": 37529,
        "end": 37532
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 37586,
        "end": 37601
      },
      "text": "ལྡན་པའི་དམ་པའི་ ༼སྣར། པེ།༽ ལྡན་པའི་"
    },
    {
      "span": {
        "start": 37688,
        "end": 37693
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 37726,
        "end": 37731
      },
      "text": "བསྔོ་ ༼སྣར། པེ།༽ བསྔོས་"
    },
    {
      "span": {
        "start": 37734,
        "end": 37742
      },
      "text": "གྱུར་པར་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 37747,
        "end": 37760
      },
      "text": "བསོད་ནམས་ཀྱི་ ༼སྣར།༽ བསོད་ནམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 38048,
        "end": 38054
      },
      "text": "རྟོགས་ ༼སྣར། པེ།༽ དུ་སྟོབས་"
    },
    {
      "span": {
        "start": 38086,
        "end": 38096
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 38155,
        "end": 38164
      },
      "text": "ཏིང་འཛིན་ ༼སྣར། པེ།༽ ཏིང་ངེ་འཛིན་"
    },
    {
      "span": {
        "start": 38207,
        "end": 38215
      },
      "text": "འཛིན་ཏེ་ ༼སྣར། པེ།༽ འཛིན་"
    },
    {
      "span": {
        "start": 38245,
        "end": 38256
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱིས་"
    },
    {
      "span": {
        "start": 38477,
        "end": 38486
      },
      "text": "སྒྲུབ་པར་ ༼སྣར། པེ།༽ བསྒྲུབས་པར་"
    },
    {
      "span": {
        "start": 38558,
        "end": 38582
      },
      "text": "དེ་ཡང་མི་མཐུན་པའི་ཕྱོགས་ ༼སྣར། པེ།༽ དེ་ཡང་"
    },
    {
      "span": {
        "start": 38617,
        "end": 38622
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་མི་མཐུན་པའི་ཕྱོགས་རྣམས་"
    },
    {
      "span": {
        "start": 38769,
        "end": 38782
      },
      "text": "དམིགས་ཀྱིས་མ་ ༼སྣར། པེ།༽ དམིགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 38989,
        "end": 38997
      },
      "text": "མ་རུང་བ་ ༼སྣར། པེ།༽ མ་རུངས་པ་"
    },
    {
      "span": {
        "start": 39028,
        "end": 39034
      },
      "text": "བསྲབས་ ༼སྣར།༽ བསྲེབས་"
    },
    {
      "span": {
        "start": 39061,
        "end": 39067
      },
      "text": "བྱས་ན་ ༼སྣར། པེ།༽ བྱས་ནས་"
    },
    {
      "span": {
        "start": 39084,
        "end": 39092
      },
      "text": "འདོན་པར་ ༼སྣར།༽ འདོད་པར་"
    },
    {
      "span": {
        "start": 39139,
        "end": 39147
      },
      "text": "བྱེད་དེ། ༼སྣར། པེ།༽ རུང་སྟེ།"
    },
    {
      "span": {
        "start": 39184,
        "end": 39190
      },
      "text": "རྒྱུས་ ༼སྣར། པེ།༽ རྒྱུའི་"
    },
    {
      "span": {
        "start": 39207,
        "end": 39214
      },
      "text": "ཞིང་གི་ ༼སྣར། པེ།༽ ཞིང་གིས་"
    },
    {
      "span": {
        "start": 39239,
        "end": 39279
      },
      "text": "འབྲས་བུ་རྣམ་པར་སྨིན་པར་གྱུར་ཀྱང་འབྲས་བུ་ ༼སྣར། པེ།༽ འབྲས་བུ་"
    },
    {
      "span": {
        "start": 39456,
        "end": 39463
      },
      "text": "ཇི་ལྟར་ ༼སྣར། པེ།༽ ཇི་ལྟ་"
    },
    {
      "span": {
        "start": 39590,
        "end": 39598
      },
      "text": "འཁོར་ལོ་ ༼སྣར། པེ།༽ འཁོར་ལོས་"
    },
    {
      "span": {
        "start": 39608,
        "end": 39622
      },
      "text": "སྡུག་བསྔལ་གྱི་ ༼སྣར། པེ།༽ སྡུག་བསྔལ་གྱིས་"
    },
    {
      "span": {
        "start": 39808,
        "end": 39815
      },
      "text": "སྡེ་ལས། ༼སྣར།༽ སྡེ་པས།"
    },
    {
      "span": {
        "start": 39848,
        "end": 39855
      },
      "text": "བཙོག་པ་ ༼སྣར། པེ།༽ བརྩོགས་པ་"
    },
    {
      "span": {
        "start": 40010,
        "end": 40017
      },
      "text": "གནས་སུ་ ༼སྣར། པེ།༽ གནམ་དུ་"
    },
    {
      "span": {
        "start": 40174,
        "end": 40186
      },
      "text": "གཞན་ཞིག་གིས་ ༼སྣར། པེ།༽ གཞན་ཞིག་"
    },
    {
      "span": {
        "start": 40209,
        "end": 40211
      },
      "text": "མ་ ༼སྣར། པེ།༽ མི་"
    },
    {
      "span": {
        "start": 40272,
        "end": 40280
      },
      "text": "སྨྱོན་པ་ ༼སྣར། པེ།༽ སྨོན་པ་"
    },
    {
      "span": {
        "start": 40461,
        "end": 40472
      },
      "text": "སྨྲས་པ་སྟེ། ༼སྣར། པེ།༽ སྨྲས་ཏེ།"
    },
    {
      "span": {
        "start": 40473,
        "end": 40480
      },
      "text": "སྡིག་པ་ ༼སྣར། པེ།༽ སྡིག་"
    },
    {
      "span": {
        "start": 40489,
        "end": 40496
      },
      "text": "དཀྲུགས་ ༼སྣར། པེ།༽ སྐྲུས་"
    },
    {
      "span": {
        "start": 40504,
        "end": 40509
      },
      "text": "དྲུང་ ༼སྣར། པེ།༽ བྲུད་"
    },
    {
      "span": {
        "start": 40512,
        "end": 40521
      },
      "text": "ཇི་ཙམ་ནས་ ༼སྣར། པེ།༽ ཇི་ཙམ་ན་"
    },
    {
      "span": {
        "start": 40646,
        "end": 40654
      },
      "text": "ཟབ་མོའི་ ༼སྣར། པེ།༽ ཟབ་མོ་"
    },
    {
      "span": {
        "start": 40700,
        "end": 40711
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 40729,
        "end": 40734
      },
      "text": "ཕྱུང་ ༼སྣར། པེ།༽ ཕྱིན་"
    },
    {
      "span": {
        "start": 40884,
        "end": 40892
      },
      "text": "སྦྱོང་བ་ ༼སྣར།༽ སྦྱང་བ་"
    },
    {
      "span": {
        "start": 40959,
        "end": 40968
      },
      "text": "གསུངས་སོ། ༼སྣར།༽ གསུངས།"
    },
    {
      "span": {
        "start": 41024,
        "end": 41034
      },
      "text": "འོད་སྲུངས་ ༼སྣར། པེ།༽ འོད་སྲུང་"
    },
    {
      "span": {
        "start": 41034,
        "end": 41044
      },
      "text": "གང་ཞིག་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 41179,
        "end": 41189
      },
      "text": "གསུམ་གྱིས་ ༼སྣར། པེ།༽ གསུམ་གྱི་"
    },
    {
      "span": {
        "start": 41259,
        "end": 41270
      },
      "text": "དགྲ་བཅོམ་མ་ ༼སྣར། པེ།༽ དགྲ་བཅོམ་པ་"
    },
    {
      "span": {
        "start": 41407,
        "end": 41412
      },
      "text": "བྱེད་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 41485,
        "end": 41493
      },
      "text": "ཀྱལ་པའི་ ༼པེ།༽ རྐྱལ་པའི་"
    },
    {
      "span": {
        "start": 41712,
        "end": 41718
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 41906,
        "end": 41915
      },
      "text": "མི་དགེ་བ་ ༼སྣར། པེ།༽ མི་དགེ་བའི་"
    },
    {
      "span": {
        "start": 42222,
        "end": 42239
      },
      "text": "དག་པ་ལ་འཇུག་ཅིང་། ༼སྣར། པེ།༽ དག་པ་དང་།"
    },
    {
      "span": {
        "start": 42343,
        "end": 42348
      },
      "text": "སྨྲས་ ༼སྣར། པེ།༽ གསུངས་"
    },
    {
      "span": {
        "start": 42501,
        "end": 42508
      },
      "text": "སྐྱེ་ལ། ༼སྣར། པེ།༽ སྐྱེ་"
    },
    {
      "span": {
        "start": 42574,
        "end": 42582
      },
      "text": "ཞི་བ་དེ་ ༼སྣར། པེ།༽ ཞི་བ་"
    },
    {
      "span": {
        "start": 42850,
        "end": 42855
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 42875,
        "end": 42883
      },
      "text": "འབྱང་བར་ ༼ཅོ།༽ འབྱུང་བར་"
    },
    {
      "span": {
        "start": 43362,
        "end": 43368
      },
      "text": "གསུངས་ ༼སྣར།༽ གསུང་"
    },
    {
      "span": {
        "start": 43459,
        "end": 43466
      },
      "text": "ཀློག་པ་ ༼སྣར། པེ།༽ ཀླག་པ་"
    },
    {
      "span": {
        "start": 43601,
        "end": 43606
      },
      "text": "སྔ་མ་ ༼སྣར། པེ།༽ སྔ་མ་སྔ་མ་"
    },
    {
      "span": {
        "start": 43672,
        "end": 43674
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 43679,
        "end": 43684
      },
      "text": "ཀྱིས་ ༼སྣར། པེ།༽ ཀྱི་"
    },
    {
      "span": {
        "start": 43724,
        "end": 43732
      },
      "text": "འབྱང་བར་ ༼སྣར། པེ།༽ བྱང་བར་"
    },
    {
      "span": {
        "start": 43845,
        "end": 43852
      },
      "text": "བྱང་བར་ ༼སྣར། པེ།༽ བྱ་བར་"
    },
    {
      "span": {
        "start": 43917,
        "end": 43924
      },
      "text": "འབྱང་བ་ ༼སྣར། པེ།༽ བྱང་བར་"
    },
    {
      "span": {
        "start": 43941,
        "end": 43950
      },
      "text": "ཟེར་བ་དེ་ ༼སྣར། པེ།༽ ཟེར་བ་"
    },
    {
      "span": {
        "start": 44193,
        "end": 44198
      },
      "text": "མཐུས་ ༼སྣར། པེ།༽ མཐུས་ནད་"
    },
    {
      "span": {
        "start": 44560,
        "end": 44569
      },
      "text": "ཞེས་བྱ་བ་ ༼སྣར། པེ།༽ ཞེས་"
    },
    {
      "span": {
        "start": 44649,
        "end": 44652
      },
      "text": "དག་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 44819,
        "end": 44825
      },
      "text": "ནི་ཡང་ ༼སྣར། པེ།༽ ནི་སྤོང་"
    },
    {
      "span": {
        "start": 44875,
        "end": 44882
      },
      "text": "འབྱིངས། ༼སྣར། པེ།༽ འབྱིང་།"
    },
    {
      "span": {
        "start": 44951,
        "end": 44964
      },
      "text": "དུས་གསུམ་གྱི་ ༼སྣར། པེ།༽ དུས་གསུམ་གྱིས་"
    },
    {
      "span": {
        "start": 44992,
        "end": 44995
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 44998,
        "end": 45005
      },
      "text": "ལས་ཀྱི་ ༼སྣར། པེ།༽ ལས་ཀྱིས་"
    },
    {
      "span": {
        "start": 45174,
        "end": 45182
      },
      "text": "ཚད་རྣམས་ ༼སྣར། པེ།༽ ཚད་"
    },
    {
      "span": {
        "start": 45221,
        "end": 45237
      },
      "text": "ཟ་བར་རོ་མྱོང་བར་ ༼སྣར། པེ།༽ ཟ་བར་"
    },
    {
      "span": {
        "start": 45338,
        "end": 45344
      },
      "text": "ཇི་ལྟ་ ༼སྣར།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 45433,
        "end": 45441
      },
      "text": "མི་ཟ་བར་ ༼སྣར། པེ།༽ མི་ཟད་པར་"
    },
    {
      "span": {
        "start": 45580,
        "end": 45592
      },
      "text": "སེམས་ཅན་གྱི་ ༼སྣར། པེ།༽ སེམས་ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 45957,
        "end": 45967
      },
      "text": "བསྒོམས་པས་ ༼པེ།༽ བསྒོམ་པས་"
    },
    {
      "span": {
        "start": 46029,
        "end": 46034
      },
      "text": "མདོར་ ༼སྣར། པེ།༽ འདོར་"
    },
    {
      "span": {
        "start": 46047,
        "end": 46053
      },
      "text": "ལ་དབང་ ༼སྣར། པེ།༽ ལས་དབང་"
    },
    {
      "span": {
        "start": 46472,
        "end": 46480
      },
      "text": "འདུ་ཤེས་ ༼སྣར། པེ།༽ འདུ་"
    },
    {
      "span": {
        "start": 46522,
        "end": 46530
      },
      "text": "བྱ་བ་ནི་ ༼སྣར། པེ།༽ བྱེད་པ་ན་"
    },
    {
      "span": {
        "start": 46585,
        "end": 46588
      },
      "text": "གང་ ༼སྣར། པེ།༽ གོང་"
    },
    {
      "span": {
        "start": 46608,
        "end": 46612
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 46622,
        "end": 46628
      },
      "text": "གང་ཡང་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 46673,
        "end": 46679
      },
      "text": "ལས་དེ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 46951,
        "end": 46966
      },
      "text": "ལྕགས་སྒྲོག་གིས་ ༼སྣར།༽ སྒྲོགས་གི་ཆིང་བས་ ༼པེ།༽ ལྕགས་སྒྲོག་གི་ཚེར་བས་"
    },
    {
      "span": {
        "start": 47431,
        "end": 47434
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 47498,
        "end": 47506
      },
      "text": "བྱ་བ་ནི་ ༼སྣར།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 47570,
        "end": 47577
      },
      "text": "ཕྱེ་བས་ ༼སྣར།༽ ཕྱེད་པས་"
    },
    {
      "span": {
        "start": 47657,
        "end": 47665
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབས་པ་"
    },
    {
      "span": {
        "start": 47830,
        "end": 47839
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 47857,
        "end": 47861
      },
      "text": "སུམ་ ༼སྣར། པེ།༽ གསུམ་"
    },
    {
      "span": {
        "start": 48518,
        "end": 48530
      },
      "text": "དུས་གསུམ་དུ་ ༼སྣར། པེ།༽ དུས་གསུམ་"
    },
    {
      "span": {
        "start": 48804,
        "end": 48811
      },
      "text": "བྱ་བའོ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 48947,
        "end": 48955
      },
      "text": "སློབ་པར་ ༼སྣར། པེ།༽ བསླབ་པར་"
    },
    {
      "span": {
        "start": 49359,
        "end": 49367
      },
      "text": "ཀུན་གྱི་ ༼སྣར། པེ།༽ ཀུན་གྱིས་"
    },
    {
      "span": {
        "start": 49468,
        "end": 49477
      },
      "text": "དེ་ཉིད་ལ་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 49748,
        "end": 49755
      },
      "text": "བསྔོ་བ་ ༼སྣར། པེ།༽ བསྔོ་"
    },
    {
      "span": {
        "start": 49960,
        "end": 49969
      },
      "text": "སྤྱད་པའི་ ༼སྣར། པེ།༽ སྤྱོད་པའི་"
    },
    {
      "span": {
        "start": 49988,
        "end": 49992
      },
      "text": "ཐོག་ ༼སྣར། པེ།༽ ཐོགས་"
    },
    {
      "span": {
        "start": 50043,
        "end": 50056
      },
      "text": "སྤྱད་པར་བགྱི། ༼སྣར། པེ།༽ སྤྱད་པར་གྱི།"
    },
    {
      "span": {
        "start": 50067,
        "end": 50079
      },
      "text": "ནི་ཚད་མེད་པ་ ༼སྣར། པེ།༽ ནི་འཕགས་"
    },
    {
      "span": {
        "start": 50112,
        "end": 50116
      },
      "text": "ཤིག་ ༼སྣར། པེ།༽ ཅིག་"
    },
    {
      "span": {
        "start": 50149,
        "end": 50154
      },
      "text": "གཞུང་ ༼པེ།༽ གཞུངས་"
    },
    {
      "span": {
        "start": 50218,
        "end": 50222
      },
      "text": "ཐོག་ ༼སྣར།༽ ཐོགས་"
    },
    {
      "span": {
        "start": 50403,
        "end": 50413
      },
      "text": "ཐམས་ཅད་དུ་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 51218,
        "end": 51222
      },
      "text": "མཐའ་ ༼སྣར། པེ།༽ མཐའི་"
    },
    {
      "span": {
        "start": 51508,
        "end": 51514
      },
      "text": "ཐུག་པ་ ༼སྣར།༽ ཐུགས་པ་"
    },
    {
      "span": {
        "start": 51664,
        "end": 51671
      },
      "text": "ཁྱད་པར་ ༼སྣར།༽ ཁྱབ་པར་"
    },
    {
      "span": {
        "start": 51877,
        "end": 51885
      },
      "text": "གྱི་དཔེ་ ༼སྣར། པེ།༽ གྱིས་དེས་"
    },
    {
      "span": {
        "start": 52098,
        "end": 52104
      },
      "text": "བུ་མོ་ ༼སྣར། པེ།༽ བུ་མོ་འམ་"
    },
    {
      "span": {
        "start": 52243,
        "end": 52250
      },
      "text": "རིན་པོ་ ༼པེ།༽ ཆིན་པོ་"
    },
    {
      "span": {
        "start": 52472,
        "end": 52481
      },
      "text": "བསྐྱེད་པ་ ༼སྣར། པེ།༽ སྐྱེད་པ་"
    },
    {
      "span": {
        "start": 52627,
        "end": 52636
      },
      "text": "བསྐྱེད་པ་ ༼སྣར། པེ།༽ སྐྱེད་པ་"
    },
    {
      "span": {
        "start": 52958,
        "end": 52965
      },
      "text": "སྤང་བར་ ༼སྣར། པེ།༽ སྤངས་པར་"
    },
    {
      "span": {
        "start": 53062,
        "end": 53069
      },
      "text": "སྤང་བར་ ༼སྣར། པེ།༽ སྤངས་པར་"
    },
    {
      "span": {
        "start": 53160,
        "end": 53166
      },
      "text": "སྣང་བ་ ༼སྣར།༽ སྣ་བར་"
    },
    {
      "span": {
        "start": 53508,
        "end": 53511
      },
      "text": "ཆེ་ ༼སྣར། པེ།༽ ཆེའི་"
    },
    {
      "span": {
        "start": 53589,
        "end": 53596
      },
      "text": "ཐོབ་པས་ ༼སྣར། པེ།༽ ཐོས་པས་"
    },
    {
      "span": {
        "start": 53598,
        "end": 53612
      },
      "text": "། །དེ་ལྟ་བས་ན་ ༼སྣར།༽ དེ་ལྟ་བས་"
    },
    {
      "span": {
        "start": 53699,
        "end": 53704
      },
      "text": "འོངས། ༼སྡེ། ཅོ།༽ འོང་།"
    },
    {
      "span": {
        "start": 54145,
        "end": 54152
      },
      "text": "བཟང་པོ་ ༼སྣར། པེ།༽ བཟང་པོའི་"
    },
    {
      "span": {
        "start": 54174,
        "end": 54180
      },
      "text": "གོང་མ་ ༼སྣར། པེ།༽ གོང་"
    },
    {
      "span": {
        "start": 54309,
        "end": 54329
      },
      "text": "ན་མཚམས་མེད་པའི་སྡིག་ ༼སྣར། པེ།༽ མཚམས་མེད་པ་"
    },
    {
      "span": {
        "start": 54742,
        "end": 54749
      },
      "text": "སུམ་ཅུ་ ༼སྣར། པེ།༽ སུམ་ཅུ་རྩ་"
    },
    {
      "span": {
        "start": 54842,
        "end": 54850
      },
      "text": "རིགས་དང་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 55121,
        "end": 55130
      },
      "text": "ཟིལ་གྱིས་ ༼སྣར།༽ ཟིལ་གྱི་"
    },
    {
      "span": {
        "start": 55203,
        "end": 55208
      },
      "text": "གྱུར་ ༼སྣར།༽ བྱུང་བ་"
    },
    {
      "span": {
        "start": 55267,
        "end": 55276
      },
      "text": "སྟོན་པའོ། ༼སྣར། པེ།༽ སྟོན་ཅིང་།"
    },
    {
      "span": {
        "start": 55703,
        "end": 55710
      },
      "text": "སོང་ནས་ ༼སྣར། པེ།༽ སོང་བས་"
    },
    {
      "span": {
        "start": 55852,
        "end": 55859
      },
      "text": "ཆུབ་ཏུ་ ༼སྣར། པེ།༽ ཆུབ་"
    },
    {
      "span": {
        "start": 56279,
        "end": 56288
      },
      "text": "འདས་ཀྱིས་ ༼སྣར།༽ འདས་ཀྱི་"
    },
    {
      "span": {
        "start": 56325,
        "end": 56332
      },
      "text": "སྨིན་པ་ ༼སྣར། པེ།༽ སྨིན་པར་"
    },
    {
      "span": {
        "start": 56476,
        "end": 56480
      },
      "text": "བཤད་ ༼སྣར།༽ གཤད་"
    },
    {
      "span": {
        "start": 56612,
        "end": 56615
      },
      "text": "ཉི་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 56626,
        "end": 56635
      },
      "text": "ཅེས་བྱའོ། ༼སྣར། པེ།༽ ཅེས་པའོ།"
    },
    {
      "span": {
        "start": 56835,
        "end": 56844
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 56946,
        "end": 56956
      },
      "text": "གཤེགས་པའི་ ༼སྣར། པེ།༽ གཤེགས་པ་"
    },
    {
      "span": {
        "start": 56961,
        "end": 56965
      },
      "text": "བ་བ་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 57320,
        "end": 57325
      },
      "text": "གཟུང་ ༼སྣར། པེ།༽ བཟུང་"
    },
    {
      "span": {
        "start": 57459,
        "end": 57467
      },
      "text": "བསྒྲིབས་ ༼སྣར། པེ།༽ སྒྲིབས་"
    },
    {
      "span": {
        "start": 57488,
        "end": 57491
      },
      "text": "དེ་ ༼ཅོ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 57503,
        "end": 57507
      },
      "text": "བསལ་ ༼སྣར། པེ།༽ གསལ་"
    },
    {
      "span": {
        "start": 57649,
        "end": 57656
      },
      "text": "སོང་ནས་ ༼སྣར། པེ།༽ སོང་ན་"
    },
    {
      "span": {
        "start": 57743,
        "end": 57749
      },
      "text": "གདབ་པ་ ༼སྣར། པེ།༽ བཏབ་པ་"
    },
    {
      "span": {
        "start": 58208,
        "end": 58216
      },
      "text": "བྱ་བ་ནི་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 58239,
        "end": 58247
      },
      "text": "པདྨོ་དམ་ ༼སྣར། པེ།༽ པདྨོ་དག་"
    },
    {
      "span": {
        "start": 58500,
        "end": 58510
      },
      "text": "རྫོགས་པའི་ ༼སྣར། པེ།༽ རྫོགས་པར་"
    },
    {
      "span": {
        "start": 58514,
        "end": 58521
      },
      "text": "རྒྱ་བར་ ༼སྣར། པེ།༽ རྒྱ་བ་"
    },
    {
      "span": {
        "start": 58590,
        "end": 58594
      },
      "text": "སུམ་ ༼སྣར། པེ།༽ གསུམ་"
    },
    {
      "span": {
        "start": 58883,
        "end": 58894
      },
      "text": "སྟོབས་ཀྱིས་ ༼སྣར། པེ།༽ སྟོབས་ཀྱི་"
    },
    {
      "span": {
        "start": 58951,
        "end": 58957
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པས་"
    },
    {
      "span": {
        "start": 59003,
        "end": 59015
      },
      "text": "སྨོན་ལམ་གྱི་ ༼སྣར།༽ སྨོན་ལམ་གྱིས་"
    }
  ]
}