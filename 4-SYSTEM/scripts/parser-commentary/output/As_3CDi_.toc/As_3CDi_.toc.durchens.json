{
  "durchens": [
    {
      "span": {
        "start": 1870,
        "end": 1875
      },
      "text": "སློང་ ༼སྣར། པེ།༽ ཕྱིར་དགེ་སྦྱོང་"
    },
    {
      "span": {
        "start": 2094,
        "end": 2103
      },
      "text": "འགྱུར་རོ་ ༼སྣར།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 2145,
        "end": 2152
      },
      "text": "ཆོས་སོ་ ༼སྣར།༽ ཆོས་"
    },
    {
      "span": {
        "start": 2916,
        "end": 2921
      },
      "text": "ལྟ་བ་ ༼སྣར། པེ།༽ ལྟ་བར་"
    },
    {
      "span": {
        "start": 3663,
        "end": 3670
      },
      "text": "ནས་ཀྱང་ ༼སྣར། པེ།༽ ན་ཡང་"
    },
    {
      "span": {
        "start": 3689,
        "end": 3696
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 3817,
        "end": 3827
      },
      "text": "སྤངས་པར་མ་ ༼སྣར། པེ།༽ སྤངས་པར་"
    },
    {
      "span": {
        "start": 3858,
        "end": 3865
      },
      "text": "ཞུགས་པ་ ༼སྣར། པེ།༽ ཞུགས་"
    },
    {
      "span": {
        "start": 4030,
        "end": 4039
      },
      "text": "ཞུགས་པའི་ ༼སྣར།༽ ཞུགས་བ་ནི་"
    },
    {
      "span": {
        "start": 4058,
        "end": 4071
      },
      "text": "དགྲ་བཅོམ་ལྡན་ ༼སྣར། པེ།༽ དགྲ་བཅོམ་"
    },
    {
      "span": {
        "start": 4178,
        "end": 4185
      },
      "text": "བསགས་པ་ ༼སྣར། པེ།༽ བསགས་པས་"
    },
    {
      "span": {
        "start": 4342,
        "end": 4350
      },
      "text": "འདས་ཀྱི་ ༼སྣར། པེ།༽ འདས་ཀྱིས་"
    },
    {
      "span": {
        "start": 4776,
        "end": 4793
      },
      "text": "ཚུལ་ཁྲིམས་ཡིན་ནོ་ ༼སྣར།༽ ཚུལ་ཁྲིམས་མནན་"
    },
    {
      "span": {
        "start": 4897,
        "end": 4904
      },
      "text": "ཤེས་རབ་ ༼སྣར། པེ།༽ ཤེས་རབ་ཀྱི་"
    },
    {
      "span": {
        "start": 5114,
        "end": 5116
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་གང་ཞིག་"
    },
    {
      "span": {
        "start": 5124,
        "end": 5131
      },
      "text": "སྤངས་པ་ ༼སྣར། པེ།༽ སྤོང་བ་"
    },
    {
      "span": {
        "start": 5514,
        "end": 5527
      },
      "text": "དང་ཡང་དག་པའི་ ༼སྣར། པེ།༽ དང་དགའ་བའི་"
    },
    {
      "span": {
        "start": 5635,
        "end": 5641
      },
      "text": "བྱ་བར་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 5992,
        "end": 6002
      },
      "text": "དྲག་པོ་ནི་ ༼སྣར།༽ དྲག་པ་ན་ ༼པེ།༽ དྲག་པ་ནི་"
    },
    {
      "span": {
        "start": 6542,
        "end": 6550
      },
      "text": "ལྷན་ཅིག་ ༼སྣར།༽ ལན་ཅིག་"
    },
    {
      "span": {
        "start": 6803,
        "end": 6809
      },
      "text": "དེ་ཡི་ ༼སྣར། པེ།༽ དེ་ཡིས་"
    },
    {
      "span": {
        "start": 6944,
        "end": 6955
      },
      "text": "གསུངས་སོ། ། ༼སྣར། པེ།༽ གསུངས།། །།"
    },
    {
      "span": {
        "start": 7071,
        "end": 7074
      },
      "text": "དྲ་ ༼སྣར། པེ།༽ དྲཱ་"
    }
  ]
}