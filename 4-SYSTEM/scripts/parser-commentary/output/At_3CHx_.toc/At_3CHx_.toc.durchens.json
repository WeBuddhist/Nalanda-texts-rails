{
  "durchens": [
    {
      "span": {
        "start": 311,
        "end": 316
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 532,
        "end": 538
      },
      "text": "གཅིག ། ༼སྣར། པེ།༽ གཅིགགོ། །"
    },
    {
      "span": {
        "start": 606,
        "end": 613
      },
      "text": "ལོག་པར་ ༼སྣར། པེ།༽ ལོག་པ་"
    },
    {
      "span": {
        "start": 1329,
        "end": 1333
      },
      "text": "ཡོན་ ༼སྣར། པེ།༽ ཡོན་ཏན་"
    },
    {
      "span": {
        "start": 1466,
        "end": 1474
      },
      "text": "ལྡན་པའི་ ༼སྣར། པེ།༽ ལྡང་བའི་"
    },
    {
      "span": {
        "start": 1589,
        "end": 1601
      },
      "text": "བྱང་ཆུབ་ཀྱི་ ༼སྣར། པེ།༽ བྱང་ཆུབ་"
    },
    {
      "span": {
        "start": 1822,
        "end": 1830
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 1969,
        "end": 1976
      },
      "text": "བྱས་ནས་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 2225,
        "end": 2231
      },
      "text": "འབྲངས་ ༼སྣར། པེ།༽ འབྲང་"
    },
    {
      "span": {
        "start": 2347,
        "end": 2350
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 2454,
        "end": 2456
      },
      "text": "པ་ ༼སྣར། པེ།༽ ས་"
    },
    {
      "span": {
        "start": 2478,
        "end": 2486
      },
      "text": "བསྟབས་པ་ ༼སྣར། པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 2525,
        "end": 2535
      },
      "text": "བཀུར་བྱེད་ ༼སྣར། པེ།༽ བསྐུར་ཞེས་"
    },
    {
      "span": {
        "start": 2821,
        "end": 2829
      },
      "text": "གྱུར་པས་ ༼སྣར། པེ།༽ གྱུར་ནས་"
    },
    {
      "span": {
        "start": 2862,
        "end": 2868
      },
      "text": "པ་སྟེ། ༼སྣར། པེ།༽ ནས་ནི།"
    },
    {
      "span": {
        "start": 3363,
        "end": 3372
      },
      "text": "འདྲེན་མི་ ༼སྣར། པེ།༽ འདྲེན་མ་"
    },
    {
      "span": {
        "start": 3501,
        "end": 3510
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབས་པ་"
    },
    {
      "span": {
        "start": 3589,
        "end": 3594
      },
      "text": "བསྟན་ ༼སྣར།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 3820,
        "end": 3828
      },
      "text": "ལྟུང་བར་ ༼སྣར།༽ ལྷུང་བར་"
    },
    {
      "span": {
        "start": 4077,
        "end": 4082
      },
      "text": "བྱམས་ ༼སྣར། པེ།༽ སྦྱངས་"
    },
    {
      "span": {
        "start": 4115,
        "end": 4122
      },
      "text": "འདོད་པ་ ༼སྣར། པེ།༽ འདོགས་པ་"
    },
    {
      "span": {
        "start": 4144,
        "end": 4148
      },
      "text": "བློ་ ༼སྣར།༽ གློ་"
    },
    {
      "span": {
        "start": 4427,
        "end": 4438
      },
      "text": "སྟོབས་ཀྱིས་ ༼སྣར། པེ།༽ སྟོབས་ཀྱི་"
    },
    {
      "span": {
        "start": 4591,
        "end": 4602
      },
      "text": "བསྐྱེད་པའི་ ༼སྣར། པེ།༽ སྐྱེད་པའི་"
    },
    {
      "span": {
        "start": 4660,
        "end": 4665
      },
      "text": "བསགས་ ༼སྣར། པེ།༽ གསགས་"
    },
    {
      "span": {
        "start": 4740,
        "end": 4750
      },
      "text": "བསྲུངས་པས་ ༼སྣར། པེ།༽ བསྲུངས་པ་"
    },
    {
      "span": {
        "start": 5028,
        "end": 5032
      },
      "text": "མཚན་ ༼སྣར། པེ།༽ ཚན་"
    },
    {
      "span": {
        "start": 5510,
        "end": 5521
      },
      "text": "བསྐྱེད་པའི་ ༼སྣར། པེ།༽ སྐྱེད་པའི་"
    },
    {
      "span": {
        "start": 5521,
        "end": 5529
      },
      "text": "གོ་རིམས་ ༼སྣར། པེ།༽ གོ་རིམ་"
    },
    {
      "span": {
        "start": 5815,
        "end": 5821
      },
      "text": "ཕུང་བ་ ༼སྣར། པེ།༽ འཕུང་བ་"
    },
    {
      "span": {
        "start": 5826,
        "end": 5835
      },
      "text": "འབྱུང་བས་ ༼སྣར། པེ།༽ འབྱུང་བར་"
    },
    {
      "span": {
        "start": 5842,
        "end": 5851
      },
      "text": "བསྲུང་བར་ ༼སྣར། པེ།༽ བསྲུངས་པར་"
    },
    {
      "span": {
        "start": 6096,
        "end": 6103
      },
      "text": "གདུག་པ་ ༼སྣར། པེ།༽ གདུགས་པ་"
    },
    {
      "span": {
        "start": 6188,
        "end": 6198
      },
      "text": "གྱི་སྦྱོར་ ༼ཅོ།༽ གྱི་སོར་"
    },
    {
      "span": {
        "start": 6649,
        "end": 6657
      },
      "text": "བསྟེན་པ་ ༼སྣར། པེ།༽ སྟེན་པ་"
    },
    {
      "span": {
        "start": 6929,
        "end": 6937
      },
      "text": "བརྟག་པར་ ༼སྣར། པེ།༽ བརྟགས་པར་"
    },
    {
      "span": {
        "start": 7211,
        "end": 7214
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 7599,
        "end": 7609
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 7723,
        "end": 7731
      },
      "text": "གཞུག་གོ། ༼སྣར། པེ།༽ གཞུགས་སོ།"
    },
    {
      "span": {
        "start": 7793,
        "end": 7799
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ བརྟན་"
    },
    {
      "span": {
        "start": 7963,
        "end": 7970
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 7981,
        "end": 7988
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 8014,
        "end": 8020
      },
      "text": "དེ་ཡང་ ༼སྣར། པེ།༽ དེ་ཡང་དང་པོ་བསྐྱེད་པའི་རིམ་པ་དང་སྦྱར་ཏེ་དེ་ཡང་"
    },
    {
      "span": {
        "start": 8074,
        "end": 8079
      },
      "text": "བསགས། ༼སྣར། པེ།༽ བསགས་པས།"
    },
    {
      "span": {
        "start": 8106,
        "end": 8114
      },
      "text": "གོ་རིམས་ ༼སྣར། པེ།༽ གོ་རིམ་"
    },
    {
      "span": {
        "start": 8129,
        "end": 8137
      },
      "text": "རབ་ཀྱིས་ ༼སྣར། པེ།༽ རབ་ཀྱི་"
    },
    {
      "span": {
        "start": 8229,
        "end": 8234
      },
      "text": "ཟློག་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 8733,
        "end": 8741
      },
      "text": "བླངས་པས་ ༼སྣར། པེ།༽ སྤངས་པས་"
    },
    {
      "span": {
        "start": 8803,
        "end": 8814
      },
      "text": "མཉམ་གཞག་གི་ ༼པེ།༽ མཉམ་གཞིག་"
    },
    {
      "span": {
        "start": 8827,
        "end": 8830
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 8917,
        "end": 8923
      },
      "text": "གཞིའི་ ༼སྣར། པེ།༽ བཞིའི་"
    },
    {
      "span": {
        "start": 9103,
        "end": 9108
      },
      "text": "བྱམས་ ༼སྣར། པེ།༽ བྱམས་དང་"
    },
    {
      "span": {
        "start": 9138,
        "end": 9144
      },
      "text": "བར་དུ་ ༼སྣར། པེ།༽ བར་དུ་བར་"
    },
    {
      "span": {
        "start": 9176,
        "end": 9182
      },
      "text": "རྣམ་པ་ ༼སྣར། པེ།༽ རྣམས་པ་"
    },
    {
      "span": {
        "start": 9615,
        "end": 9629
      },
      "text": "ཤེས་བཞིན་གྱིས་ ༼ཅོ།༽ ཤེས་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 10325,
        "end": 10332
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 10443,
        "end": 10455
      },
      "text": "ཟུང་འཇུག་ཏུ་ ༼སྣར། པེ།༽ ཟུང་དུ་འཇུག་པ་"
    },
    {
      "span": {
        "start": 11022,
        "end": 11040
      },
      "text": "བླ་མ་དམ་ཚིག་ཉམས་པ་ ༼སྣར། པེ།༽ དམ་ཚིག་ཉམས་"
    },
    {
      "span": {
        "start": 11076,
        "end": 11083
      },
      "text": "སྦྱང་བ་ ༼སྣར། པེ།༽ སྦྱོང་བ་"
    },
    {
      "span": {
        "start": 11142,
        "end": 11151
      },
      "text": "བསླབས་པས་ ༼སྣར། པེ།༽ བརླབས་པས་"
    },
    {
      "span": {
        "start": 11196,
        "end": 11206
      },
      "text": "ནི་ལམ་རིམ་ ༼ཅོ།༽ ནི་ལམ་"
    },
    {
      "span": {
        "start": 11297,
        "end": 11301
      },
      "text": "ལུས་ ༼པེ།༽ ལུང་"
    },
    {
      "span": {
        "start": 11492,
        "end": 11500
      },
      "text": "གོ་རིམས་ ༼སྣར། པེ།༽ གོ་རིམ་"
    },
    {
      "span": {
        "start": 11528,
        "end": 11540
      },
      "text": "དེ་མ་བསྒོམས་ ༼སྣར། པེ།༽ དེ་བསྒོམ་"
    },
    {
      "span": {
        "start": 11612,
        "end": 11616
      },
      "text": "ལགས་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 11712,
        "end": 11719
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 11749,
        "end": 11756
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 12004,
        "end": 12011
      },
      "text": "བྱེད་པ་ ༼སྣར། པེ།༽ བྱེད་པས་"
    },
    {
      "span": {
        "start": 12204,
        "end": 12212
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 12256,
        "end": 12265
      },
      "text": "རྟོགས་པས་ ༼སྣར། པེ།༽ རྟོག་པས་"
    },
    {
      "span": {
        "start": 12300,
        "end": 12305
      },
      "text": "བཤེས་ ༼སྣར། པེ།༽ གཤེས་"
    },
    {
      "span": {
        "start": 13034,
        "end": 13039
      },
      "text": "བལྟས་ ༼སྣར། པེ།༽ ལྟས་"
    },
    {
      "span": {
        "start": 13528,
        "end": 13538
      },
      "text": "གཉིས་ཀ་མི་ ༼སྣར།༽ གཉིས་ཀ་མ་"
    },
    {
      "span": {
        "start": 13631,
        "end": 13638
      },
      "text": "གདུག་ལ་ ༼ཅོ།༽ གདུག་པ་ ༼སྣར། པེ།༽ གདུགས་པ་"
    },
    {
      "span": {
        "start": 13975,
        "end": 13980
      },
      "text": "སྒོམ་ ༼སྣར། པེ།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 14065,
        "end": 14074
      },
      "text": "རྣམ་གཉིས་ ༼སྣར། པེ།༽ རྣམས་ཉིད་"
    },
    {
      "span": {
        "start": 14152,
        "end": 14163
      },
      "text": "བརྒྱད་པ་དང་ ༼སྣར། པེ།༽ བརྒྱད་པ་"
    },
    {
      "span": {
        "start": 14183,
        "end": 14192
      },
      "text": "སྒོམ་པའི་ ༼སྣར། པེ།༽ བསྒོམ་པའི་"
    },
    {
      "span": {
        "start": 14235,
        "end": 14243
      },
      "text": "བསྟེན་པ་ ༼སྣར། པེ།༽ སྟེན་པ་"
    },
    {
      "span": {
        "start": 14262,
        "end": 14272
      },
      "text": "གསུམ་གྱིས་ ༼སྣར། པེ།༽ གསུམ་གྱི་"
    },
    {
      "span": {
        "start": 14338,
        "end": 14342
      },
      "text": "འདའ་ ༼སྣར། པེ།༽ འདས་"
    },
    {
      "span": {
        "start": 14505,
        "end": 14512
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 14612,
        "end": 14619
      },
      "text": "བྱས་པས། ༼སྣར། པེ།༽ བྱས་པ་བས།"
    },
    {
      "span": {
        "start": 14827,
        "end": 14834
      },
      "text": "རྙེད་པ་ ༼སྣར། པེ།༽ བརྙེད་པ་"
    },
    {
      "span": {
        "start": 14848,
        "end": 14854
      },
      "text": "རྒྱུས་ ༼སྣར། པེ།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 15195,
        "end": 15201
      },
      "text": "སྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 15355,
        "end": 15363
      },
      "text": "ཡང་གནོད་ ༼སྣར། པེ།༽ འང་སྣོད་"
    },
    {
      "span": {
        "start": 15443,
        "end": 15448
      },
      "text": "བསླབ་ ༼སྣར། པེ།༽ སླབ་"
    }
  ]
}