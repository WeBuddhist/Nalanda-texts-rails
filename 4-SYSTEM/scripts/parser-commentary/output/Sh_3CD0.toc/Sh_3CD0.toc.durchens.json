{
  "durchens": [
    {
      "span": {
        "start": 166,
        "end": 174
      },
      "text": "མཁྱེན་པ་ ༼སྣར། པེ།༽ མཁྱེན་པའི་"
    },
    {
      "span": {
        "start": 179,
        "end": 189
      },
      "text": "རྟེན་མགོན། ༼སྣར།༽ རྟེན་སྒྲུབས་"
    },
    {
      "span": {
        "start": 710,
        "end": 718
      },
      "text": "བར་གྱིས་ ༼སྣར། པེ།༽ བར་གྱི་"
    },
    {
      "span": {
        "start": 802,
        "end": 809
      },
      "text": "གནས་དང་ ༼སྣར།༽ གནས་"
    },
    {
      "span": {
        "start": 952,
        "end": 959
      },
      "text": "མིང་གི་ ༼སྣར།༽ མིང་གིས་"
    },
    {
      "span": {
        "start": 1056,
        "end": 1069
      },
      "text": "འདུས་བྱས་ཀྱི་ ༼པེ།༽ འདུས་བྱས་ཀྱིས་"
    },
    {
      "span": {
        "start": 1132,
        "end": 1138
      },
      "text": "དག་གི་ ༼པེ།༽ དག་གིས་"
    },
    {
      "span": {
        "start": 1213,
        "end": 1223
      },
      "text": "བདུན་གྱིས་ ༼སྣར།༽ བདུན་གྱི་"
    },
    {
      "span": {
        "start": 1278,
        "end": 1286
      },
      "text": "རྫས་ཀྱི་ ༼པེ།༽ རྫས་ཀྱིས་"
    },
    {
      "span": {
        "start": 1298,
        "end": 1305
      },
      "text": "བཅད་པར་ ༼པེ།༽ གཅད་པར་"
    },
    {
      "span": {
        "start": 1470,
        "end": 1478
      },
      "text": "བསྲུང་བ་ ༼སྣར།༽ བསྲུངས་བར་བྱ་ ༼པེ།༽ སྲུང་བ་"
    },
    {
      "span": {
        "start": 1495,
        "end": 1500
      },
      "text": "བསྟན་ ༼སྣར།༽ སྟན་"
    },
    {
      "span": {
        "start": 1520,
        "end": 1523
      },
      "text": "རེ་ ༼སྣར།༽ ནི་"
    },
    {
      "span": {
        "start": 1604,
        "end": 1614
      },
      "text": "ཡེ་ཤེས་སུ་ ༼པེ།༽ ཡེ་ཤེས་"
    },
    {
      "span": {
        "start": 1618,
        "end": 1627
      },
      "text": "གཅིག་ཉིད་ ༼པེ།༽ གཅིག་"
    },
    {
      "span": {
        "start": 1683,
        "end": 1691
      },
      "text": "ཅན་གྱིས་ ༼སྣར། པེ།༽ ཅན་གྱི་"
    },
    {
      "span": {
        "start": 1754,
        "end": 1761
      },
      "text": "རོ་ཞེས་ ༼སྣར།༽ རོ་"
    },
    {
      "span": {
        "start": 1953,
        "end": 1961
      },
      "text": "སྐྱེད་པ་ ༼པེ།༽ སྐྱེས་པ་"
    },
    {
      "span": {
        "start": 2051,
        "end": 2056
      },
      "text": "སྤངས་ ༼སྣར།༽ སྤང་"
    },
    {
      "span": {
        "start": 2270,
        "end": 2275
      },
      "text": "བྱའོ། ༼པེ།༽ བྱ་བའོ།"
    },
    {
      "span": {
        "start": 2378,
        "end": 2383
      },
      "text": "རིགས་ ༼པེ།༽ རིས་"
    },
    {
      "span": {
        "start": 2438,
        "end": 2446
      },
      "text": "བདག་གིས་ ༼སྣར།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 2450,
        "end": 2454
      },
      "text": "པའི་ ༼པེ།༽ པ་"
    },
    {
      "span": {
        "start": 2710,
        "end": 2712
      },
      "text": "ན་ ༼སྣར།༽ ལ་"
    },
    {
      "span": {
        "start": 2782,
        "end": 2785
      },
      "text": "ནི་ ༼སྣར།༽ ནི་དེ་"
    },
    {
      "span": {
        "start": 2894,
        "end": 2903
      },
      "text": "གང་གི་ཚེ་ ༼སྣར།༽ གང་གི་"
    },
    {
      "span": {
        "start": 2941,
        "end": 2943
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་མ་"
    },
    {
      "span": {
        "start": 3166,
        "end": 3176
      },
      "text": "བྱིན་གྱིས་ ༼སྣར།༽ བྱིན་གྱི་"
    },
    {
      "span": {
        "start": 3197,
        "end": 3202
      },
      "text": "ཞུགས་ ༼སྣར།༽ བཞུགས་"
    },
    {
      "span": {
        "start": 3208,
        "end": 3214
      },
      "text": "དེ་ནས་ ༼པེ།༽ དེ་ལ་"
    },
    {
      "span": {
        "start": 3223,
        "end": 3227
      },
      "text": "ཀྱི་ ༼པེ།༽ ཀྱིས་"
    },
    {
      "span": {
        "start": 3350,
        "end": 3360
      },
      "text": "གྱིས་བརླབ་ ༼སྣར།༽ གྱི་བརླབས་ ༼པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 3382,
        "end": 3392
      },
      "text": "གྱིས་བརླབ་ ༼སྣར།༽ གྱི་བརླབ་ ༼པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 3821,
        "end": 3830
      },
      "text": "ཆེན་པོའི་ ༼སྣར། པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 3918,
        "end": 3927
      },
      "text": "བྱུང་བའི་ ༼པེ།༽ བྱུང་བ་"
    },
    {
      "span": {
        "start": 4046,
        "end": 4052
      },
      "text": "ནང་གི་ ༼པེ།༽ ནང་གིས་"
    },
    {
      "span": {
        "start": 4259,
        "end": 4264
      },
      "text": "ཞུགས་ ༼པེ།༽ བཞུགས་"
    },
    {
      "span": {
        "start": 4271,
        "end": 4278
      },
      "text": "བྱ་བའོ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 4350,
        "end": 4360
      },
      "text": "དངོས་གཞིས་ ༼པེ།༽ དངོས་གཞི་"
    },
    {
      "span": {
        "start": 4377,
        "end": 4386
      },
      "text": "གསུམ་སྟེ། ༼པེ།༽ གསུམ་ཏེ།"
    },
    {
      "span": {
        "start": 4404,
        "end": 4413
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 4451,
        "end": 4462
      },
      "text": "ཁྱད་པར་གྱི་ ༼སྣར།༽ ཁྱད་པར་"
    },
    {
      "span": {
        "start": 4676,
        "end": 4684
      },
      "text": "བསྟན་ཏོ། ༼པེ།༽ བསྟན་ནོ།"
    },
    {
      "span": {
        "start": 4708,
        "end": 4717
      },
      "text": "རྡོ་རྗེས་ ༼སྣར།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 4784,
        "end": 4790
      },
      "text": "ཡ་ཞེས་ ༼སྣར། པེ།༽ ཡ་"
    },
    {
      "span": {
        "start": 4827,
        "end": 4835
      },
      "text": "བར་གྱིས་ ༼སྣར།༽ བར་གྱི་"
    },
    {
      "span": {
        "start": 4918,
        "end": 4927
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 4965,
        "end": 4974
      },
      "text": "གྱི་རླབས་ ༼སྣར། པེ།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 5065,
        "end": 5079
      },
      "text": "གྱི་རླབས་ཀྱིས་ ༼སྣར།༽ གྱིས་བརླབ་ཀྱི་ ༼པེ།༽ གྱི་བརླབས་ཀྱིས་"
    },
    {
      "span": {
        "start": 5189,
        "end": 5198
      },
      "text": "གྱི་རླབས་ ༼སྣར།༽ གྱིས་བརླབས་"
    },
    {
      "span": {
        "start": 5312,
        "end": 5319
      },
      "text": "བྱ་བའི་ ༼པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 5322,
        "end": 5335
      },
      "text": "སྐབས་སྦྱར་རོ། ༼སྣར།༽ སྐབས་སོ།"
    },
    {
      "span": {
        "start": 5413,
        "end": 5421
      },
      "text": "སྙིང་པོ་ ༼སྣར། པེ།༽ སྙིང་པོས་"
    },
    {
      "span": {
        "start": 5469,
        "end": 5488
      },
      "text": "ཡེ་ཤེས་ཀྱི་རྡོ་རྗེ་ ༼སྣར།༽ ཡེ་ཤེས་ཀྱི་"
    },
    {
      "span": {
        "start": 5548,
        "end": 5553
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 5620,
        "end": 5637
      },
      "text": "རྡོ་རྗེས་སྨྲས་སོ་ ༼པེ།༽ རྡོ་རྗེས་"
    },
    {
      "span": {
        "start": 6054,
        "end": 6057
      },
      "text": "ཕམ་ ༼པེ།༽ འཕམ་"
    },
    {
      "span": {
        "start": 6144,
        "end": 6149
      },
      "text": "གཟུང་ ༼སྣར།༽ གཟུངས་"
    },
    {
      "span": {
        "start": 6186,
        "end": 6195
      },
      "text": "བརྟས་པའི་ ༼སྣར། པེ།༽ རྟས་པའི་"
    },
    {
      "span": {
        "start": 6246,
        "end": 6251
      },
      "text": "རླབས་ ༼སྣར།༽ བརླབས་"
    },
    {
      "span": {
        "start": 6290,
        "end": 6294
      },
      "text": "འཚེ་ ༼སྣར།༽ ཚེ་"
    },
    {
      "span": {
        "start": 6322,
        "end": 6329
      },
      "text": "ནུར་བར་ ༼པེ།༽ ནུ་བར་"
    },
    {
      "span": {
        "start": 6329,
        "end": 6334
      },
      "text": "གྱུར་ ༼པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 6353,
        "end": 6360
      },
      "text": "ཐམས་ཅད་ ༼པེ།༽ ཐམས་"
    },
    {
      "span": {
        "start": 6482,
        "end": 6490
      },
      "text": "གཅོད་པར་ ༼པེ།༽ སྤྱོད་པར་"
    },
    {
      "span": {
        "start": 6619,
        "end": 6624
      },
      "text": "ཕྱིར། ༼པེ།༽ ཕྱིརནི།"
    },
    {
      "span": {
        "start": 6635,
        "end": 6644
      },
      "text": "འཇོམས་པར་ ༼སྣར།༽ འཇོམས་པའི་"
    },
    {
      "span": {
        "start": 6683,
        "end": 6693
      },
      "text": "ཐམས་ཅད་དུ་ ༼པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 6693,
        "end": 6703
      },
      "text": "དོན་སྤྱོད་ ༼སྣར།༽ དོན་དཔྱོད་ ༼པེ།༽ དོན་དུ་སྤྱོད་"
    },
    {
      "span": {
        "start": 6817,
        "end": 6831
      },
      "text": "གྱི་རླབས་ཀྱིས་ ༼སྣར།༽ གྱིས་བརླབས་ཀྱིས་ ༼པེ།༽ གྱི་རླབ་ཀྱི་"
    },
    {
      "span": {
        "start": 6835,
        "end": 6839
      },
      "text": "གྱི་ ༼སྣར།༽ གྱིས་"
    },
    {
      "span": {
        "start": 7057,
        "end": 7060
      },
      "text": "དེ་ ༼སྣར།༽ དེས་"
    },
    {
      "span": {
        "start": 7169,
        "end": 7176
      },
      "text": "ལྟ་བུར་ ༼སྣར། པེ།༽ ལྟ་བུ་"
    },
    {
      "span": {
        "start": 7264,
        "end": 7268
      },
      "text": "གཞི་ ༼སྣར།༽ བཞི་"
    },
    {
      "span": {
        "start": 7598,
        "end": 7622
      },
      "text": "དེའི་བྱིན་གྱི་རླབས་ཀྱིས་ ༼སྣར།༽ དེ་ནི་བྱིན་གྱིས་བརླབས་ཀྱི་ ༼པེ།༽ དེ་ནི་བྱིན་གྱིས་རླབས་ཀྱིས་"
    },
    {
      "span": {
        "start": 7695,
        "end": 7701
      },
      "text": "བསྲུང་ ༼སྣར། པེ།༽ སྲུང་"
    },
    {
      "span": {
        "start": 7846,
        "end": 7853
      },
      "text": "རྣམ་པར་ ༼སྣར།༽ རྣམ་པས་"
    },
    {
      "span": {
        "start": 7990,
        "end": 7993
      },
      "text": "ནི་ ༼སྣར།༽ ནི་མོང་"
    },
    {
      "span": {
        "start": 8156,
        "end": 8164
      },
      "text": "འཇིགས་པ་ ༼སྣར། པེ།༽ འཇར་བ་"
    },
    {
      "span": {
        "start": 8297,
        "end": 8304
      },
      "text": "རྟག་པར་ ༼སྣར།༽ རྟག་པ་"
    },
    {
      "span": {
        "start": 8308,
        "end": 8311
      },
      "text": "བར་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 8394,
        "end": 8400
      },
      "text": "སོ་ཞེ་ ༼སྣར།༽ སོ་ཞེས་"
    },
    {
      "span": {
        "start": 8488,
        "end": 8496
      },
      "text": "འདིར་ནི་ ༼སྣར།༽ འདིར་མི་"
    },
    {
      "span": {
        "start": 9137,
        "end": 9146
      },
      "text": "སྙིང་པོས་ ༼པེ།༽ སྙིང་པོ་"
    },
    {
      "span": {
        "start": 9223,
        "end": 9228
      },
      "text": "རོ། །༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 9281,
        "end": 9307
      },
      "text": "རང་བཞིན་དངོས་གཞི་ལ་བབས་ཏེ། ༼སྣར།༽ རང་བཞིན་ཏེ ༼པེ།༽ རང་བཞིན་དངོས་གཞི་ལ་བབ་སྟེ།"
    },
    {
      "span": {
        "start": 9418,
        "end": 9426
      },
      "text": "བརྟན་པར་ ༼པེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 9593,
        "end": 9597
      },
      "text": "འཚལ་ ༼སྣར།༽ བཙལ་"
    },
    {
      "span": {
        "start": 9637,
        "end": 9641
      },
      "text": "ན་པ་ ༼སྣར། པེ།༽ ནཱ་པ་"
    },
    {
      "span": {
        "start": 9674,
        "end": 9690
      },
      "text": "སྡེ་དཔོན་ཆེན་པོ་ ༼པེ།༽ སྡེ་དཔོན་"
    },
    {
      "span": {
        "start": 9812,
        "end": 9822
      },
      "text": "གྱིས་བརླབ་ ༼སྣར།༽ གྱི་བརླབ་ ༼པེ།༽ གྱིས་རློབ་"
    },
    {
      "span": {
        "start": 9947,
        "end": 9962
      },
      "text": "བྱེད་པའི་བར་དུ་ ༼སྣར།༽ བྱེད་པའི་"
    },
    {
      "span": {
        "start": 9972,
        "end": 9979
      },
      "text": "བརླབ་པ་ ༼པེ།༽ རློབ་པ་"
    },
    {
      "span": {
        "start": 10012,
        "end": 10016
      },
      "text": "བཛྲ་ ༼པེ།༽ བཛྲ་ཡ་"
    },
    {
      "span": {
        "start": 10038,
        "end": 10044
      },
      "text": "ཆོད་པ་ ༼པེ།༽ ཆོད་པའི་"
    },
    {
      "span": {
        "start": 10115,
        "end": 10121
      },
      "text": "ཕུལླུ། ༼སྣར། པེ།༽ ཕུ་ལུ།"
    },
    {
      "span": {
        "start": 10128,
        "end": 10134
      },
      "text": "ཕུལླུ་ ༼སྣར། པེ།༽ ཕུ་ལུ་"
    },
    {
      "span": {
        "start": 10202,
        "end": 10211
      },
      "text": "རྣམས་ཀྱི་ ༼པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 10507,
        "end": 10509
      },
      "text": "ར་ ༼སྣར། པེ།༽ རཱ་"
    },
    {
      "span": {
        "start": 10538,
        "end": 10549
      },
      "text": "བསྐྱེད་པའི་ ༼པེ།༽ སྐྱེད་པའི་"
    },
    {
      "span": {
        "start": 10774,
        "end": 10783
      },
      "text": "བསྐྱེད་པ་ ༼པེ།༽ སྐྱེད་པའི་"
    },
    {
      "span": {
        "start": 10820,
        "end": 10837
      },
      "text": "བྱིན་རླབས་བྱ་བའོ། ༼སྣར།༽ བྱིན་བརླབ་བྱའོ ༼པེ།༽ བྱིན་བརླབས་བྱ་བའོ།"
    },
    {
      "span": {
        "start": 10970,
        "end": 10980
      },
      "text": "བསྐུར་བའི་ ༼པེ།༽ སྐུར་བའི་"
    },
    {
      "span": {
        "start": 11049,
        "end": 11051
      },
      "text": "པ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 11148,
        "end": 11156
      },
      "text": "འཚལ་བའི་ ༼པེ།༽ བཙལ་བའི་"
    },
    {
      "span": {
        "start": 11428,
        "end": 11434
      },
      "text": "སྐད་ལ་ ༼པེ།༽ སྐད་"
    },
    {
      "span": {
        "start": 11451,
        "end": 11458
      },
      "text": "མང་སྟེ། ༼པེ།༽ མང་ཏེ།"
    },
    {
      "span": {
        "start": 11469,
        "end": 11477
      },
      "text": "བརླབས་པ་ ༼སྣར།༽ བརླབ་པ་ ༼པེ།༽ རློབ་པ་"
    },
    {
      "span": {
        "start": 11497,
        "end": 11502
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 11563,
        "end": 11572
      },
      "text": "འཆད་དོ། །༼སྣར། པེ།༽ འཆད་།། །།"
    },
    {
      "span": {
        "start": 11808,
        "end": 11816
      },
      "text": "བསྒྲུབས་ ༼པེ།༽ སྒྲུབས་"
    },
    {
      "span": {
        "start": 11819,
        "end": 11828
      },
      "text": "སྔོན་གྱི་ ༼པེ།༽ སྔོན་གྱིས་"
    },
    {
      "span": {
        "start": 11902,
        "end": 11908
      },
      "text": "འགྱུར་ ༼སྣར།༽ གྱུར་"
    },
    {
      "span": {
        "start": 12218,
        "end": 12230
      },
      "text": "ཅིའི་ཕྱིར་ན་ ༼སྣར།༽ ཅིའི་ཕྱིར་མ་"
    },
    {
      "span": {
        "start": 12257,
        "end": 12260
      },
      "text": "དག་ ༼པེ།༽ བཞན་ག་"
    },
    {
      "span": {
        "start": 12437,
        "end": 12446
      },
      "text": "ཀུན་གྱིས་ ༼སྣར།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 12489,
        "end": 12508
      },
      "text": "གཉིས་ཀྱིས་བསྟན་པའི་ ༼སྣར།༽ གཉིས་ཀྱི་བསྟན་"
    },
    {
      "span": {
        "start": 12531,
        "end": 12537
      },
      "text": "བཞི་ལ་ ༼པེ།༽ བཞི་པ་"
    },
    {
      "span": {
        "start": 12733,
        "end": 12736
      },
      "text": "ངལ་ ༼སྣར། པེ།༽ མངལ་"
    },
    {
      "span": {
        "start": 12739,
        "end": 12770
      },
      "text": "བྱུང་བ་ཡི། །ཞེས་བྱ་བའི་བར་གྱིས་ ༼སྣར།༽ བྱུང་བའི་བར་གྱི་ ༼པེ།༽ བའི། བྱ་བའི་བར་གྱིས་"
    },
    {
      "span": {
        "start": 12874,
        "end": 12879
      },
      "text": "ཁྲུས་ ༼པེ།༽ བཀྲུས་"
    },
    {
      "span": {
        "start": 13068,
        "end": 13086
      },
      "text": "གཙང་མ་ཡིན་ནས། གཙང་ ༼སྣར།༽ གཙང་མ་ཡིས་ནས་གཙང་ ༼པེ།༽ གཙང་མ་ཡིས་ནས། བཙང་"
    },
    {
      "span": {
        "start": 13300,
        "end": 13308
      },
      "text": "བར་གྱིས་ ༼སྣར།༽ བར་གྱི་"
    },
    {
      "span": {
        "start": 13514,
        "end": 13522
      },
      "text": "ནས་ཆུའི་ ༼སྣར། པེ།༽ ནས་ཆུ་ཡིས་"
    },
    {
      "span": {
        "start": 13563,
        "end": 13571
      },
      "text": "གསེར་རམ་ ༼པེ།༽ གསེར་"
    },
    {
      "span": {
        "start": 13678,
        "end": 13686
      },
      "text": "བསྟན་ནོ། ༼སྣར། པེ།༽ བསྟན་ཏོ།"
    },
    {
      "span": {
        "start": 13820,
        "end": 13827
      },
      "text": "བྱ་བའི་ ༼སྣར།༽ བྱའི་"
    },
    {
      "span": {
        "start": 13990,
        "end": 13996
      },
      "text": "ཚེ་ཟད་ ༼པེ།༽ ཚེ་"
    },
    {
      "span": {
        "start": 14102,
        "end": 14111
      },
      "text": "ཕོངས་པའི་ ༼སྣར།༽ འཕངས་པའི་"
    },
    {
      "span": {
        "start": 14231,
        "end": 14241
      },
      "text": "རྒྱབ་ཀྱིས་ ༼པེ།༽ རྒྱབ་ཀྱི་"
    },
    {
      "span": {
        "start": 14419,
        "end": 14425
      },
      "text": "དག་གི་ ༼སྣར། པེ།༽ དག་གིས་"
    },
    {
      "span": {
        "start": 14490,
        "end": 14493
      },
      "text": "དལ་ ༼པེ།༽ མངལ་"
    },
    {
      "span": {
        "start": 14527,
        "end": 14533
      },
      "text": "ན་ཡང་། ༼པེ།༽ ན།"
    },
    {
      "span": {
        "start": 14730,
        "end": 14737
      },
      "text": "གོས་ནི་ ༼པེ།༽ གོས་ཞེས་པ་"
    },
    {
      "span": {
        "start": 14926,
        "end": 14930
      },
      "text": "བཤད་ ༼པེ།༽ བཤད་པ་"
    },
    {
      "span": {
        "start": 15026,
        "end": 15032
      },
      "text": "དེ་ནས་ ༼པེ།༽ དེ་ནི་"
    },
    {
      "span": {
        "start": 15100,
        "end": 15112
      },
      "text": "མི་བཟད་པ་ཡི་ ༼སྣར།༽ མི་ཟད་པའི་ ༼པེ།༽ མི་བཟད་པའི་"
    },
    {
      "span": {
        "start": 15287,
        "end": 15293
      },
      "text": "ཅེས་པ་ ༼སྣར།༽ །པ་"
    },
    {
      "span": {
        "start": 15342,
        "end": 15345
      },
      "text": "ནི་ ༼པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 15494,
        "end": 15501
      },
      "text": "ཕབ་། །། ༼སྣར།༽ ཕབ་པ། །།"
    }
  ]
}