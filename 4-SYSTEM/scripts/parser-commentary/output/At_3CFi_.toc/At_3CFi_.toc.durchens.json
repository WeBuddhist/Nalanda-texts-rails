{
  "durchens": [
    {
      "span": {
        "start": 834,
        "end": 839
      },
      "text": "ལས་ས་ ༼སྣར། པེ།༽ ལས་པ་"
    },
    {
      "span": {
        "start": 1257,
        "end": 1267
      },
      "text": "དེའི་ཕྱིར་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 1487,
        "end": 1495
      },
      "text": "བསྟེན་པ་ ༼སྣར། པེ།༽ རྟེན་པ་"
    },
    {
      "span": {
        "start": 1644,
        "end": 1652
      },
      "text": "ལྷག་པའི་ ༼སྣར། པེ།༽ ལྡོག་པའི་"
    },
    {
      "span": {
        "start": 1817,
        "end": 1822
      },
      "text": "གྱུར། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 2222,
        "end": 2230
      },
      "text": "མཚོན་བྱ་ ༼སྣར། པེ།༽ མཚོན་བྱ་དང་"
    },
    {
      "span": {
        "start": 2386,
        "end": 2405
      },
      "text": "། །མཛེས་མ་མཆོག་ལྡན་ ༼སྣར། པེ།༽ མཛེས་མ་མཆོག་"
    },
    {
      "span": {
        "start": 2574,
        "end": 2581
      },
      "text": "དབེན་པ་ ༼སྣར། པེ།༽ བདེན་པ་"
    },
    {
      "span": {
        "start": 3992,
        "end": 4000
      },
      "text": "སྒྲིབ་པ་ ༼སྣར།༽ བསྒྲུབ་པ་ ༼པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 4291,
        "end": 4304
      },
      "text": "ཉོན་མོངས་པའི་ ༼སྣར། པེ།༽ ཉོན་མོངས་ཀྱིས་"
    },
    {
      "span": {
        "start": 4402,
        "end": 4410
      },
      "text": "མཚོན་བྱ་ ༼སྣར། པེ།༽ མཚོན་ཆ་"
    },
    {
      "span": {
        "start": 4476,
        "end": 4478
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 4616,
        "end": 4620
      },
      "text": "རྣམ་ ༼པེ།༽ རྣམ་པར་"
    },
    {
      "span": {
        "start": 5636,
        "end": 5645
      },
      "text": "བརླབས་པས་ ༼སྣར། པེ།༽ བླངས་པས་"
    },
    {
      "span": {
        "start": 5663,
        "end": 5673
      },
      "text": "མཚོན་བྱའི་ ༼སྣར། པེ།༽ མཚོན་ཆའི་"
    },
    {
      "span": {
        "start": 6005,
        "end": 6014
      },
      "text": "ངོ་བོ་ཡང་ ༼སྣར། པེ།༽ ངོ་བོ་ཡོངས་"
    },
    {
      "span": {
        "start": 6132,
        "end": 6136
      },
      "text": "ལུས་ ༼སྣར། པེ།༽ ལུས་པ་"
    },
    {
      "span": {
        "start": 6407,
        "end": 6420
      },
      "text": "བདག་མེད་མ་དེ་ ༼སྣར། པེ།༽ བདག་མེད་བདེ་"
    },
    {
      "span": {
        "start": 6747,
        "end": 6751
      },
      "text": "མཐའ་ ༼སྣར།༽ མཐའི་"
    },
    {
      "span": {
        "start": 6911,
        "end": 6918
      },
      "text": "བྱུང་བ། ༼སྣར། པེ།༽ བྱུང་བའི།"
    },
    {
      "span": {
        "start": 7027,
        "end": 7037
      },
      "text": "བྱམས་པ་དང་ ༼སྣར། པེ།༽ བྱམས་པ་"
    },
    {
      "span": {
        "start": 7230,
        "end": 7236
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 7905,
        "end": 7910
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 9374,
        "end": 9379
      },
      "text": "དེའི་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 9504,
        "end": 9513
      },
      "text": "ཐབས་ཀྱིས་ ༼སྣར། པེ།༽ ཐབས་ཀྱི་"
    },
    {
      "span": {
        "start": 9761,
        "end": 9768
      },
      "text": "ལྟ་བའི་ ༼སྣར། པེ།༽ བལྟ་བའི་"
    },
    {
      "span": {
        "start": 9963,
        "end": 9970
      },
      "text": "དཔེར་ན་ ༼སྣར། པེ།༽ དཔེར་ན་ནི་"
    },
    {
      "span": {
        "start": 10383,
        "end": 10393
      },
      "text": "མིག་འཕྲུལ་ ༼སྣར། པེ།༽ མིག་འཕྲུལ་ཅན་"
    },
    {
      "span": {
        "start": 10444,
        "end": 10459
      },
      "text": "འོངས་པའི་བརྟགས་ ༼སྣར། པེ།༽ འོང་བའི་བརྟག་"
    },
    {
      "span": {
        "start": 10901,
        "end": 10910
      },
      "text": "ཐབས་རྣམས་ ༼སྣར། པེ།༽ ཐབས་"
    },
    {
      "span": {
        "start": 11199,
        "end": 11206
      },
      "text": "གདམས་ན་ ༼སྣར། པེ།༽ གདམས་པ་"
    },
    {
      "span": {
        "start": 11540,
        "end": 11546
      },
      "text": "དེ་བས་ ༼སྣར། པེ།༽ བདེ་བས་"
    },
    {
      "span": {
        "start": 14200,
        "end": 14205
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 14257,
        "end": 14278
      },
      "text": "ལ་འཇིག་རྟེན་པའི་སེམས་ ༼སྣར། པེ།༽ འཇིག་རྟེན་པའི་"
    },
    {
      "span": {
        "start": 14346,
        "end": 14354
      },
      "text": "གིས་ཤེས་ ༼སྣར། པེ།༽ གིས་ཞེ་"
    },
    {
      "span": {
        "start": 14481,
        "end": 14485
      },
      "text": "གསལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 14597,
        "end": 14603
      },
      "text": "རྟོགས། ༼སྣར། པེ།༽ རྟོག།"
    },
    {
      "span": {
        "start": 15052,
        "end": 15057
      },
      "text": "རླུང་ ༼སྣར། པེ།༽ རླུང་དང་"
    },
    {
      "span": {
        "start": 15425,
        "end": 15433
      },
      "text": "གཞག་པའི་ ༼སྣར། པེ།༽ བཞག་པའི་"
    },
    {
      "span": {
        "start": 16234,
        "end": 16239
      },
      "text": "འཇིག་ ༼སྣར། པེ།༽ འཇིགས་"
    }
  ]
}