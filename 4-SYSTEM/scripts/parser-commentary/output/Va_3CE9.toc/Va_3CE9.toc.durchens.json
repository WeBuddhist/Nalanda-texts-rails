{
  "durchens": [
    {
      "span": {
        "start": 17,
        "end": 23
      },
      "text": "མགོའི་ ༼སྣར། པེ།༽ གཽ་"
    },
    {
      "span": {
        "start": 178,
        "end": 186
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 568,
        "end": 576
      },
      "text": "བཟུང་བར་ ༼སྣར། པེ།༽ གཟུང་བར་"
    },
    {
      "span": {
        "start": 653,
        "end": 659
      },
      "text": "བསྡུས་ ༼སྣར།༽ བསྡུད་"
    },
    {
      "span": {
        "start": 1084,
        "end": 1091
      },
      "text": "བྱིན་པ་ ༼སྣར།༽ བྱིན་པར་"
    },
    {
      "span": {
        "start": 1220,
        "end": 1232
      },
      "text": "རྫོགས་པས་སོ། ༼སྣར། པེ།༽ རྫོགས་པའོ།"
    },
    {
      "span": {
        "start": 1254,
        "end": 1262
      },
      "text": "བརྟག་པར་ ༼སྣར། པེ།༽ བརྟགས་པར་"
    },
    {
      "span": {
        "start": 1361,
        "end": 1369
      },
      "text": "འདས་ཀྱི་ ༼སྣར། པེ།༽ འདས་ཀྱིས་"
    },
    {
      "span": {
        "start": 1410,
        "end": 1414
      },
      "text": "མོང་ ༼སྣར། པེ།༽ མོངས་"
    },
    {
      "span": {
        "start": 1445,
        "end": 1453
      },
      "text": "དོན་འདི་ ༼སྣར། པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 1881,
        "end": 1889
      },
      "text": "ཡང་དག་པ་ ༼སྣར། པེ།༽ ཡང་དག་པར་"
    },
    {
      "span": {
        "start": 1948,
        "end": 1957
      },
      "text": "རྡུ་བཏོན་ ༼སྣར། པེ།༽ རྡུ་སྟོན་"
    },
    {
      "span": {
        "start": 2245,
        "end": 2247
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 2566,
        "end": 2578
      },
      "text": "དང་སེམས་ཀྱི་ ༼སྣར། པེ།༽ དང་སེམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 2640,
        "end": 2647
      },
      "text": "བཏགས་པ་ ༼སྣར། པེ།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 2692,
        "end": 2701
      },
      "text": "རིགས་པའི་ ༼སྣར། པེ།༽ རིག་པའི་"
    },
    {
      "span": {
        "start": 2708,
        "end": 2714
      },
      "text": "རྣམ་པ་ ༼སྣར།༽ རྣམ་པར་"
    },
    {
      "span": {
        "start": 2955,
        "end": 2964
      },
      "text": "སེམས་ཀྱི་ ༼སྣར། པེ།༽ སེམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 3750,
        "end": 3758
      },
      "text": "ཡིད་ཀྱི་ ༼སྣར། པེ།༽ ཡིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 4153,
        "end": 4160
      },
      "text": "བཏགས་པ་ ༼སྣར།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 4218,
        "end": 4220
      },
      "text": "པ་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 4709,
        "end": 4718
      },
      "text": "དང་བ་དང་། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 4794,
        "end": 4803
      },
      "text": "འཛིན་གྱི་ ༼སྣར། པེ།༽ འཛིན་གྱིས་"
    },
    {
      "span": {
        "start": 4819,
        "end": 4827
      },
      "text": "རྫོགས་པ་ ༼སྣར། པེ།༽ རྫོགས་"
    },
    {
      "span": {
        "start": 5076,
        "end": 5080
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 5120,
        "end": 5124
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 5339,
        "end": 5344
      },
      "text": "དག་པ་ ༼སྣར། པེ།༽ དག་པར་"
    },
    {
      "span": {
        "start": 5510,
        "end": 5520
      },
      "text": "མི་རྟག་པར་ ༼སྣར། པེ།༽ མི་རྟག་པ་"
    },
    {
      "span": {
        "start": 5700,
        "end": 5702
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 6063,
        "end": 6072
      },
      "text": "བཟུང་བའི་ ༼སྣར། པེ།༽ གཟུང་བའི་"
    },
    {
      "span": {
        "start": 6097,
        "end": 6104
      },
      "text": "རྟོག་པ་ ༼སྣར།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 6152,
        "end": 6160
      },
      "text": "བསྟེན་པ་ ༼སྣར། པེ།༽ བརྟེན་པ་"
    },
    {
      "span": {
        "start": 6534,
        "end": 6539
      },
      "text": "བཞིས་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 6783,
        "end": 6787
      },
      "text": "ཆོས་ ༼སྣར། པེ།༽ ཆོས་ཀྱི་"
    },
    {
      "span": {
        "start": 7087,
        "end": 7095
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 7254,
        "end": 7263
      },
      "text": "ཐམས་ཅད་ལ་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 7339,
        "end": 7351
      },
      "text": "འཇིག་རྟེན་པ་ ༼སྣར། པེ།༽ འཇིག་རྟེན་"
    },
    {
      "span": {
        "start": 7436,
        "end": 7448
      },
      "text": "སེམས་ཅན་གྱི་ ༼སྣར། པེ།༽ སེམས་ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 7736,
        "end": 7741
      },
      "text": "བཞིན་ ༼སྣར།༽ གཞིན་"
    },
    {
      "span": {
        "start": 7834,
        "end": 7844
      },
      "text": "རྟོགས་པའི་ ༼སྣར། པེ།༽ རྟོག་པའི་"
    },
    {
      "span": {
        "start": 7867,
        "end": 7877
      },
      "text": "བསྒོམ་པའི་ ༼སྣར།༽ བསྒོས་པའི་"
    },
    {
      "span": {
        "start": 7976,
        "end": 7984
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 8196,
        "end": 8211
      },
      "text": "མཐུན་པ་བཞིན་དུ་ ༼སྣར། པེ།༽ མཐུན་པའི་"
    },
    {
      "span": {
        "start": 8312,
        "end": 8321
      },
      "text": "བསླབ་པའི་ ༼སྣར།༽ བསླབས་པའི་"
    },
    {
      "span": {
        "start": 8387,
        "end": 8398
      },
      "text": "བསྒོམས་པའི་ ༼སྣར། པེ།༽ བསྒོམ་པའི་"
    },
    {
      "span": {
        "start": 8776,
        "end": 8781
      },
      "text": "དག་པ་ ༼སྣར།༽ དག་པས་"
    },
    {
      "span": {
        "start": 9117,
        "end": 9126
      },
      "text": "དེ་དག་གི་ ༼སྣར།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 9708,
        "end": 9716
      },
      "text": "ཡང་དག་པ་ ༼སྣར། པེ།༽ ཡང་དག་པར་"
    },
    {
      "span": {
        "start": 9876,
        "end": 9883
      },
      "text": "རྩ་བའི་ ༼སྣར། པེ།༽ རྩ་བ་"
    },
    {
      "span": {
        "start": 10383,
        "end": 10392
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 10587,
        "end": 10591
      },
      "text": "ཆུད་ ༼སྣར། པེ།༽ ཆུད་པ་མེད་"
    },
    {
      "span": {
        "start": 10714,
        "end": 10720
      },
      "text": "གང་དུ་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 10872,
        "end": 10878
      },
      "text": "དག་པས་ ༼སྣར། པེ།༽ དག་པ་ལས་"
    },
    {
      "span": {
        "start": 10959,
        "end": 10970
      },
      "text": "ཡེ་ཤེས་ཀྱི་ ༼སྣར།༽ ཡེ་ཤེས་ཀྱིས་"
    },
    {
      "span": {
        "start": 11178,
        "end": 11186
      },
      "text": "ཡང་དག་པ་ ༼སྣར། པེ།༽ ཡང་དག་པར་"
    },
    {
      "span": {
        "start": 11399,
        "end": 11407
      },
      "text": "མཐུན་པར་ ༼སྣར། པེ།༽ མཐུན་པ་"
    },
    {
      "span": {
        "start": 11439,
        "end": 11446
      },
      "text": "ཆུང་དུ་ ༼སྣར། པེ།༽ ཆུང་ངུས་"
    },
    {
      "span": {
        "start": 11517,
        "end": 11529
      },
      "text": "སྣ་ཚོགས་ཀྱི་ ༼སྣར། པེ།༽ སྣ་ཚོགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 11716,
        "end": 11725
      },
      "text": "ཡིད་ཀྱིས་ ༼པེ།༽ ཡིད་ཀྱི་"
    },
    {
      "span": {
        "start": 11964,
        "end": 11972
      },
      "text": "སྒྱུར་བ་ ༼སྣར། པེ།༽ བསྒྱུར་བ་"
    },
    {
      "span": {
        "start": 12314,
        "end": 12322
      },
      "text": "འཇིགས་པ་ ༼སྣར།༽ འཇིག་པ་"
    },
    {
      "span": {
        "start": 12443,
        "end": 12448
      },
      "text": "མངོན་ ༼སྣར། པེ།༽ མངོན་པས་མངོན་"
    },
    {
      "span": {
        "start": 12658,
        "end": 12660
      },
      "text": "པ་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 12706,
        "end": 12726
      },
      "text": "དང་རྣམ་པར་བྱང་བ་ཆུང་ ༼སྣར།༽ རྣམ་པར་བྱང་ཆུབ་"
    },
    {
      "span": {
        "start": 12750,
        "end": 12757
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 14380,
        "end": 14397
      },
      "text": "བརྩམས་པས་སོ། །ཡང་ ༼སྣར།༽ བརྩམས་པའོ། །"
    },
    {
      "span": {
        "start": 14416,
        "end": 14423
      },
      "text": "བསླབ་པ་ ༼སྣར། པེ།༽ བསླབས་པ་"
    },
    {
      "span": {
        "start": 14769,
        "end": 14794
      },
      "text": "། བསྟན་པ་རྣམ་པར་དག་པ་དང་། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 14996,
        "end": 14999
      },
      "text": "ཞུ་ ༼སྣར། པེ།༽ ཞུས་"
    }
  ]
}