{
  "durchens": [
    {
      "span": {
        "start": 157,
        "end": 165
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 197,
        "end": 205
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 231,
        "end": 239
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 263,
        "end": 271
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 293,
        "end": 299
      },
      "text": "རྟོགས་ ༼སྣར། པེ།༽ རྟོག་"
    },
    {
      "span": {
        "start": 324,
        "end": 332
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 392,
        "end": 396
      },
      "text": "ཡིན་ ༼སྣར། པེ།༽ ཡིན་གྱི་"
    },
    {
      "span": {
        "start": 523,
        "end": 530
      },
      "text": "རིགས་པ་ ༼སྣར།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 945,
        "end": 953
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 987,
        "end": 999
      },
      "text": "མངོན་སུམ་དུ་ ༼སྣར། པེ།༽ མངོན་སུམ་"
    },
    {
      "span": {
        "start": 1208,
        "end": 1215
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 1285,
        "end": 1295
      },
      "text": "ལ་སོགས་པར་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 1343,
        "end": 1353
      },
      "text": "བྱེ་བྲག་པ་ ༼སྣར།༽ བྱེ་བྲག་"
    },
    {
      "span": {
        "start": 1418,
        "end": 1426
      },
      "text": "འབྲེལ་པ་ ༼སྣར། པེ།༽ བྲེལ་བ་"
    },
    {
      "span": {
        "start": 2149,
        "end": 2159
      },
      "text": "ལ་དབང་པོས་ ༼སྣར།༽ མེད་པ་བས་"
    },
    {
      "span": {
        "start": 2379,
        "end": 2388
      },
      "text": "རྟོགས་པས་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 2450,
        "end": 2457
      },
      "text": "ཡང་ཡོད་ ༼སྣར།༽ ཡང་ཡང་"
    },
    {
      "span": {
        "start": 2497,
        "end": 2504
      },
      "text": "གཅད་པར་ ༼སྣར། པེ།༽ བཅད་པར་"
    },
    {
      "span": {
        "start": 2601,
        "end": 2611
      },
      "text": "ལ་སོགས་པར་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 2731,
        "end": 2737
      },
      "text": "ཚད་མས་ ༼སྣར། པེ།༽ ཚད་མ་"
    },
    {
      "span": {
        "start": 2787,
        "end": 2795
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 2999,
        "end": 3008
      },
      "text": "ཡིན་ནོ། ། ༼སྣར།༽ ཡིན་།། །།"
    },
    {
      "span": {
        "start": 3117,
        "end": 3120
      },
      "text": "དང་ ༼སྣར། པེ།༽ དང་ནི་"
    },
    {
      "span": {
        "start": 3556,
        "end": 3564
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 3580,
        "end": 3586
      },
      "text": "ཡོད་པ་ ༼སྣར། པེ།༽ ཡོད་པས་"
    },
    {
      "span": {
        "start": 3725,
        "end": 3732
      },
      "text": "བསྲེགས་ ༼སྣར། པེ།༽ བསྲེག་"
    },
    {
      "span": {
        "start": 3896,
        "end": 3904
      },
      "text": "ཞལ་གྱིས་ ༼སྣར། པེ།༽ ཞལ་གྱི་"
    },
    {
      "span": {
        "start": 3994,
        "end": 4004
      },
      "text": "ནི་བསྲེགས་ ༼སྣར།༽ མི་བསྲེག་ ༼པེ།༽ ནི་བསྲེག་"
    },
    {
      "span": {
        "start": 4048,
        "end": 4054
      },
      "text": "དཔག་པ་ ༼སྣར། པེ།༽ དཔག་པའི་"
    },
    {
      "span": {
        "start": 4119,
        "end": 4125
      },
      "text": "བཅད་པ་ ༼སྣར། པེ།༽ གཅད་པ་"
    },
    {
      "span": {
        "start": 4320,
        "end": 4330
      },
      "text": "བསྲེགས་པས་ ༼སྣར། པེ།༽ སྲེག་པས་"
    },
    {
      "span": {
        "start": 4393,
        "end": 4398
      },
      "text": "ལ་ནི་ ༼པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 4427,
        "end": 4435
      },
      "text": "བརྟགས་པ་ ༼སྣར།༽ བརྟག་པ་"
    },
    {
      "span": {
        "start": 4531,
        "end": 4539
      },
      "text": "བརྟགས་པ་ ༼སྣར། པེ།༽ བརྟག་པ་"
    },
    {
      "span": {
        "start": 4569,
        "end": 4573
      },
      "text": "ལུས་ ༼སྣར། པེ།༽ ལུང་"
    },
    {
      "span": {
        "start": 4850,
        "end": 4854
      },
      "text": "དོན་ ༼སྣར། པེ།༽ དོན་ལ་དོན་"
    },
    {
      "span": {
        "start": 5256,
        "end": 5259
      },
      "text": "པར་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 5471,
        "end": 5480
      },
      "text": "བྱེད་པོར་ ༼སྣར། པེ།༽ བྱེད་པ་"
    },
    {
      "span": {
        "start": 5545,
        "end": 5554
      },
      "text": "ཡང་དག་པར་ ༼སྣར། པེ།༽ ཡང་དག་པ་"
    },
    {
      "span": {
        "start": 5877,
        "end": 5891
      },
      "text": "གཏན་ཚིགས་ཀྱིས་ ༼སྣར། པེ།༽ གཏན་ཚིགས་ཀྱི་"
    },
    {
      "span": {
        "start": 6038,
        "end": 6043
      },
      "text": "དེའི་ ༼སྣར།༽ དེ་དེའི་"
    },
    {
      "span": {
        "start": 6052,
        "end": 6056
      },
      "text": "ཡིན་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 6650,
        "end": 6658
      },
      "text": "ཁོངས་སུ་ ༼སྣར།༽ ཁོང་དུ་"
    },
    {
      "span": {
        "start": 6906,
        "end": 6915
      },
      "text": "བརྗོད་པར་ ༼སྣར། པེ།༽ རྗོད་པར་"
    },
    {
      "span": {
        "start": 7267,
        "end": 7280
      },
      "text": "མཐོང་བའི་དེར་ ༼སྣར། པེ།༽ མཐོང་བ་ནི་དེའི་"
    },
    {
      "span": {
        "start": 7607,
        "end": 7610
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 7845,
        "end": 7854
      },
      "text": "བརྗོད་པར་ ༼སྣར། པེ།༽ རྗོད་པར་"
    },
    {
      "span": {
        "start": 7996,
        "end": 8004
      },
      "text": "གཅད་པའི་ ༼ཅོ།༽ བཅད་པའི་"
    },
    {
      "span": {
        "start": 8016,
        "end": 8023
      },
      "text": "གཟུང་བ་ ༼སྣར།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 8327,
        "end": 8335
      },
      "text": "གཅད་པའི་ ༼སྣར།༽ བཅད་པའི་"
    },
    {
      "span": {
        "start": 8441,
        "end": 8449
      },
      "text": "ཡོད་པ་ལ་ ༼སྣར།༽ ཡོད་པ་"
    },
    {
      "span": {
        "start": 8464,
        "end": 8473
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ གཏོགས་པར་"
    },
    {
      "span": {
        "start": 8596,
        "end": 8609
      },
      "text": "ངེས་པའི་གཟུང་ ༼སྣར།༽ ངེས་པར་བཟུང་ ༼པེ།༽ ངེས་པར་གཟུང་"
    },
    {
      "span": {
        "start": 8749,
        "end": 8751
      },
      "text": "པ་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 8783,
        "end": 8788
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བར་"
    },
    {
      "span": {
        "start": 8872,
        "end": 8879
      },
      "text": "གྲུབ་པ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 8890,
        "end": 8895
      },
      "text": "དེ་ལ་ ༼སྣར།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 8935,
        "end": 8940
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བར་"
    },
    {
      "span": {
        "start": 8961,
        "end": 8969
      },
      "text": "ངེས་པའི་ ༼སྣར། པེ།༽ ངེས་པ་"
    },
    {
      "span": {
        "start": 9122,
        "end": 9130
      },
      "text": "ལ་རྟག་པ་ ༼སྣར། པེ།༽ ལ་རྟགས་"
    },
    {
      "span": {
        "start": 9405,
        "end": 9416
      },
      "text": "མི་འདྲ་བའི་ ༼སྣར། པེ།༽ མི་དྲབ་"
    },
    {
      "span": {
        "start": 9442,
        "end": 9451
      },
      "text": "རྟོགས་པར་ ༼སྣར།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 9774,
        "end": 9779
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བར་"
    },
    {
      "span": {
        "start": 9864,
        "end": 9872
      },
      "text": "བྱེ་བྲག་ ༼སྣར། པེ།༽ བྱེ་བྲག་ཏུ་"
    },
    {
      "span": {
        "start": 10119,
        "end": 10127
      },
      "text": "བྱེ་བྲག་ ༼སྣར། པེ།༽ བྱེ་བྲག་པ་"
    },
    {
      "span": {
        "start": 10222,
        "end": 10225
      },
      "text": "དང་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 10496,
        "end": 10500
      },
      "text": "རིག་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 10522,
        "end": 10532
      },
      "text": "དམིགས་པ་ལ་ ༼སྣར། པེ།༽ དམིགས་པ་"
    },
    {
      "span": {
        "start": 10707,
        "end": 10718
      },
      "text": "བརྗོད་དོ། ། ༼སྣར། པེ།༽ བརྗོད་དེ་"
    },
    {
      "span": {
        "start": 10856,
        "end": 10864
      },
      "text": "མཐོང་བས། ༼སྣར། པེ།༽ མཐོང་ནས་"
    },
    {
      "span": {
        "start": 11026,
        "end": 11037
      },
      "text": "བརྗོད་དོ། ། ༼སྣར། པེ།༽ བརྗོད་དེ་"
    },
    {
      "span": {
        "start": 11072,
        "end": 11098
      },
      "text": "ནི་ལྷ་སྦྱིན་དང་མཆོད་སྦྱིན་ ༼སྣར། པེ།༽ ནི་ལྷས་བྱིན་དང་རྟ་"
    },
    {
      "span": {
        "start": 11362,
        "end": 11366
      },
      "text": "ཤུག་ ༼སྣར། པེ།༽ ཤུགས་"
    },
    {
      "span": {
        "start": 11471,
        "end": 11474
      },
      "text": "དེ། ༼སྣར།༽ དོ། །"
    },
    {
      "span": {
        "start": 11722,
        "end": 11729
      },
      "text": "དུ་བ་ལ་ ༼པེ།༽ དུ་བ་"
    },
    {
      "span": {
        "start": 11770,
        "end": 11779
      },
      "text": "འཕྲོ་བའི་ ༼སྣར། པེ།༽ ཕྲོད་པའི་"
    },
    {
      "span": {
        "start": 11859,
        "end": 11861
      },
      "text": "པ་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 11874,
        "end": 11884
      },
      "text": "ལྟ་བུའོ། ། ༼སྣར།༽ ལྟ་བུའོ་ཞེས་ཟེར་རོ། ། ༼པེ།༽ ལྟ་བའོ་ཞེས་ཟེར་རོ།། །།"
    },
    {
      "span": {
        "start": 11893,
        "end": 11907
      },
      "text": "གཞུང་ལུགས་ཀྱི་ ༼སྣར། པེ།༽ གཞུང་ལུགས་ནི་"
    },
    {
      "span": {
        "start": 11921,
        "end": 11927
      },
      "text": "ཁོ་ནར་ ༼སྣར། པེ།༽ ཁོ་ནས་"
    },
    {
      "span": {
        "start": 11958,
        "end": 11965
      },
      "text": "བྱེད་པ་ ༼སྣར། པེ།༽ བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་"
    },
    {
      "span": {
        "start": 11997,
        "end": 12004
      },
      "text": "གཉིས་པ་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 12238,
        "end": 12245
      },
      "text": "ཁྱད་པར་ ༼སྣར། པེ།༽ ཁྱབ་པར་"
    },
    {
      "span": {
        "start": 12307,
        "end": 12315
      },
      "text": "དངོས་པོ་ ༼སྣར། པེ།༽ དངོས་སུ་"
    },
    {
      "span": {
        "start": 12318,
        "end": 12328
      },
      "text": "བསྒྲུབ་པས་ ༼སྣར། པེ།༽ རྒྱུད་པས་"
    },
    {
      "span": {
        "start": 12457,
        "end": 12464
      },
      "text": "འཇིག་པ་ ༼སྣར།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 12485,
        "end": 12493
      },
      "text": "འགག་པའི་ ༼སྣར། པེ།༽ དགག་པའི་"
    },
    {
      "span": {
        "start": 12704,
        "end": 12709
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བར་"
    },
    {
      "span": {
        "start": 13053,
        "end": 13058
      },
      "text": "ན་ནི་ ༼སྣར། པེ།༽ ན་མི་"
    },
    {
      "span": {
        "start": 13135,
        "end": 13142
      },
      "text": "ཀུན་དུ་ ༼སྣར། པེ།༽ ཀུན་"
    },
    {
      "span": {
        "start": 13275,
        "end": 13281
      },
      "text": "བསལ་བ་ ༼སྣར། པེ།༽ གསལ་བ་"
    },
    {
      "span": {
        "start": 13694,
        "end": 13704
      },
      "text": "ཡིན་པ་སྤང་ ༼སྣར། པེ།༽ ཡིན་པར་སྤོང་"
    },
    {
      "span": {
        "start": 13930,
        "end": 13935
      },
      "text": "ང་དང་ ༼ཅོ། སྣར།༽ ང་"
    },
    {
      "span": {
        "start": 13957,
        "end": 13965
      },
      "text": "གཟུང་བར་ ༼སྣར།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 14238,
        "end": 14242
      },
      "text": "བཅས་ ༼སྣར།༽ བཅའ་"
    },
    {
      "span": {
        "start": 14470,
        "end": 14478
      },
      "text": "བསྟན་ཏོ། ༼སྣར། པེ།༽ རྟོགས་སོ།"
    },
    {
      "span": {
        "start": 14508,
        "end": 14517
      },
      "text": "ལྔ་པོ་དེ་ ༼སྣར། པེ།༽ ལྔ་པོ་"
    },
    {
      "span": {
        "start": 14601,
        "end": 14605
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདི་ལྟར་"
    },
    {
      "span": {
        "start": 14758,
        "end": 14766
      },
      "text": "མཐུན་པར་ ༼སྣར། པེ།༽ མཐུན་པ་"
    },
    {
      "span": {
        "start": 15406,
        "end": 15415
      },
      "text": "རྟོགས་པར་ ༼སྣར།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 15648,
        "end": 15652
      },
      "text": "ཆོས་ ༼སྣར། པེ།༽ ཚུལ་"
    },
    {
      "span": {
        "start": 15723,
        "end": 15730
      },
      "text": "ལྡོག་པ་ ༼སྣར། པེ།༽ ཟློས་པ་"
    },
    {
      "span": {
        "start": 15885,
        "end": 15893
      },
      "text": "སྨོས་ཏེ། ༼སྣར། པེ།༽ སྨོས་སོ།"
    },
    {
      "span": {
        "start": 15989,
        "end": 15994
      },
      "text": "རྗོད་ ༼ཅོ།༽ བརྗོད་"
    },
    {
      "span": {
        "start": 16012,
        "end": 16020
      },
      "text": "བསལ་བའི་ ༼སྣར། པེ།༽ གསལ་བའི་ཕྱིར་"
    },
    {
      "span": {
        "start": 16379,
        "end": 16386
      },
      "text": "ཡོད་པར་ ༼སྣར། པེ།༽ ཡོད་པ་"
    },
    {
      "span": {
        "start": 16552,
        "end": 16561
      },
      "text": "བརྗོད་པར་ ༼སྣར། པེ།༽ རྗོད་པར་"
    },
    {
      "span": {
        "start": 16590,
        "end": 16599
      },
      "text": "ཕྱོགས་སུ་ ༼སྣར།༽ ཕྱོགས་"
    },
    {
      "span": {
        "start": 16622,
        "end": 16627
      },
      "text": "གྲུབ་ ༼སྣར།༽ གྲུབ་པ་"
    },
    {
      "span": {
        "start": 16757,
        "end": 16764
      },
      "text": "གཟུང་བ་ ༼ཅོ།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 16797,
        "end": 16804
      },
      "text": "གཟུང་བ་ ༼སྣར། པེ།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 16900,
        "end": 16908
      },
      "text": "བྱེ་བྲག་ ༼སྣར། པེ།༽ བྱེ་བྲག་པ་"
    },
    {
      "span": {
        "start": 17085,
        "end": 17093
      },
      "text": "ཕྱིར་རོ་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 17211,
        "end": 17218
      },
      "text": "ཆེ་བའི་ ༼སྣར། པེ།༽ ཆེས་པའི་"
    },
    {
      "span": {
        "start": 17321,
        "end": 17328
      },
      "text": "བསྟན་པ། ༼སྣར། པེ།༽ བསྟན་ཏོ་"
    },
    {
      "span": {
        "start": 17667,
        "end": 17675
      },
      "text": "བྱེད་པར་ ༼སྣར། པེ།༽ བྱེད་པའི་"
    },
    {
      "span": {
        "start": 17726,
        "end": 17737
      },
      "text": "རྟོགས་སོ། ། ༼སྣར། པེ།༽ རྟོགས་ཏེ་"
    },
    {
      "span": {
        "start": 17798,
        "end": 17806
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 17866,
        "end": 17877
      },
      "text": "བསྒྲུབ་པའི་ ༼སྣར། པེ།༽ སྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 17883,
        "end": 17893
      },
      "text": "བྱེ་བྲག་པ་ ༼སྣར། པེ།༽ བྱེ་བྲག་པ་པ་"
    },
    {
      "span": {
        "start": 18082,
        "end": 18090
      },
      "text": "གྲགས་ཏེ། ༼སྣར། པེ།༽ གྲག་སྟེ།"
    },
    {
      "span": {
        "start": 18219,
        "end": 18228
      },
      "text": "ཡིན་པ་དེ་ ༼སྣར། པེ།༽ ཡིན་པ་"
    },
    {
      "span": {
        "start": 18249,
        "end": 18259
      },
      "text": "དེ་དག་གིས་ ༼སྣར། པེ།༽ དེ་དག་གི་"
    },
    {
      "span": {
        "start": 18323,
        "end": 18336
      },
      "text": "མངོན་སུམ་གྱི་ ༼སྣར། པེ།༽ མངོན་སུམ་གྱིས་"
    },
    {
      "span": {
        "start": 18406,
        "end": 18412
      },
      "text": "རྟག་པ་ ༼སྣར། པེ།༽ རྟགས་པ་"
    },
    {
      "span": {
        "start": 18412,
        "end": 18420
      },
      "text": "ཉིད་སྒྲ་ ༼སྣར། པེ།༽ ཉིད་དུ་"
    },
    {
      "span": {
        "start": 18545,
        "end": 18557
      },
      "text": "བརྡ་སྤྲོད་པ་ ༼སྣར། པེ།༽ བརྡ་སྤྲོད་པ་པ་"
    },
    {
      "span": {
        "start": 18652,
        "end": 18656
      },
      "text": "སྒྲ་ ༼སྣར། པེ།༽ སྒྲ་ཐམས་ཅད་ཀྱི་"
    },
    {
      "span": {
        "start": 18721,
        "end": 18732
      },
      "text": "གནག་རྫི་མོ་ ༼སྣར།༽ གནག་རྫི་མ་"
    },
    {
      "span": {
        "start": 18747,
        "end": 18755
      },
      "text": "འདོད་པར་ ༼སྣར། པེ།༽ འདོར་བར་"
    },
    {
      "span": {
        "start": 18760,
        "end": 18769
      },
      "text": "པ་ཡིན་ཏེ། ༼སྣར། པེ།༽ པ་སྟེ།"
    },
    {
      "span": {
        "start": 18788,
        "end": 18794
      },
      "text": "གསལ་བ་ ༼སྣར། པེ།༽ བསལ་བ་"
    },
    {
      "span": {
        "start": 18818,
        "end": 18823
      },
      "text": "པན་པ་ ༼སྣར། པེ།༽ འཕན་པ་"
    },
    {
      "span": {
        "start": 18846,
        "end": 18855
      },
      "text": "བརྗོད་པར་ ༼སྣར། པེ།༽ རྗོད་པར་"
    },
    {
      "span": {
        "start": 18899,
        "end": 18904
      },
      "text": "ན་མི་ ༼སྣར།༽ ན་ནི་"
    },
    {
      "span": {
        "start": 19431,
        "end": 19442
      },
      "text": "བྱེ་བྲག་ནི་ ༼སྣར། པེ།༽ བྱེ་བྲག་པ་ན་རེ་"
    },
    {
      "span": {
        "start": 19498,
        "end": 19502
      },
      "text": "ཡིན་ ༼སྣར། པེ།༽ ཡིན་ནོ་"
    },
    {
      "span": {
        "start": 19538,
        "end": 19544
      },
      "text": "བསམ་པ་ ༼པེ།༽ བསམས་པ་"
    },
    {
      "span": {
        "start": 19693,
        "end": 19699
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པ་ནི་"
    },
    {
      "span": {
        "start": 19816,
        "end": 19827
      },
      "text": "བྱ་བ་ལྟ་བུ་ ༼ཅོ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 19897,
        "end": 19905
      },
      "text": "རྗོད་པར་ ༼སྣར།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 20053,
        "end": 20060
      },
      "text": "སྨྲས་པ་ ༼སྣར། པེ།༽ སྨྲ་བ་"
    },
    {
      "span": {
        "start": 20488,
        "end": 20498
      },
      "text": "བརྗོད་པའི་ ༼སྣར། པེ།༽ རྗོད་པའི་"
    },
    {
      "span": {
        "start": 20700,
        "end": 20702
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 20762,
        "end": 20775
      },
      "text": "རྟག་པ་ཡིན་ནོ་ ༼སྣར། པེ།༽ རྟག་པའོ་"
    },
    {
      "span": {
        "start": 20787,
        "end": 20795
      },
      "text": "དཔྱོད་པ་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 20968,
        "end": 20997
      },
      "text": "ཡོད་དོ་ཞེས་རྗོད་པར་བྱེད་དོ། ། ༼སྣར། པེ།༽ ཡོད་དེ་ཞེས་བརྗོད་པར་བྱེད་དེ་"
    },
    {
      "span": {
        "start": 21340,
        "end": 21348
      },
      "text": "བརྗོད་པ་ ༼སྣར། པེ།༽ རྗོད་པ་"
    },
    {
      "span": {
        "start": 21406,
        "end": 21416
      },
      "text": "བྱ་བ་ལ་ཡང་ ༼སྣར། པེ།༽ བྱས་པ་ལ་"
    },
    {
      "span": {
        "start": 21566,
        "end": 21574
      },
      "text": "གྲགས་ཏེ། ༼སྣར། པེ།༽ གྲག་སྟེ།"
    },
    {
      "span": {
        "start": 21665,
        "end": 21674
      },
      "text": "ཐམས་ཅད་ན་ ༼པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 21700,
        "end": 21709
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 21795,
        "end": 21803
      },
      "text": "ཡིན་གྱི། ༼ཅོ།༽ ཡིན་ཏེ།"
    },
    {
      "span": {
        "start": 22015,
        "end": 22024
      },
      "text": "གཞན་གྱིས་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 22105,
        "end": 22113
      },
      "text": "བཀོད་དེ། ༼སྣར། པེ།༽ བཀོད་དོ།"
    },
    {
      "span": {
        "start": 22282,
        "end": 22285
      },
      "text": "ཡང་ ༼སྣར། པེ།༽ ཡང་མ་"
    },
    {
      "span": {
        "start": 22303,
        "end": 22312
      },
      "text": "མི་རྟག་པ་ ༼སྣར། པེ།༽ མི་རྟག་ཡང་"
    },
    {
      "span": {
        "start": 22395,
        "end": 22403
      },
      "text": "ལམ་པོའི་ ༼སྣར། པེ།༽ ལམ་པོ་"
    },
    {
      "span": {
        "start": 22542,
        "end": 22551
      },
      "text": "ཟེར་རོ། ། ༼སྣར། པེ།༽ ཟེར་ཏེ་"
    },
    {
      "span": {
        "start": 22610,
        "end": 22619
      },
      "text": "སྦྱོར་བར་ ༼སྣར། པེ།༽ སྦྱོར་བ་"
    },
    {
      "span": {
        "start": 22737,
        "end": 22745
      },
      "text": "རིག་པའི་ ༼སྣར། པེ།༽ རིགས་པའི་"
    },
    {
      "span": {
        "start": 22771,
        "end": 22780
      },
      "text": "བརྗོད་པར་ ༼སྣར། པེ།༽ རྗོད་པར་"
    },
    {
      "span": {
        "start": 23027,
        "end": 23035
      },
      "text": "དཔྱོད་པ་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 23059,
        "end": 23078
      },
      "text": "ནི་མི་རྟག་པ་ཉིད་དེ་ ༼སྣར། པེ།༽ མི་རྟག་པ་སྟེ་"
    },
    {
      "span": {
        "start": 23147,
        "end": 23151
      },
      "text": "ཆོད་ ༼པེ།༽ མཆོད་"
    },
    {
      "span": {
        "start": 23165,
        "end": 23173
      },
      "text": "བརྗོད་པ་ ༼སྣར། པེ།༽ རྗོད་པ་"
    },
    {
      "span": {
        "start": 23219,
        "end": 23235
      },
      "text": "ཉིད་ལ་སོགས་པ་ནི་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 23306,
        "end": 23326
      },
      "text": "ལྟག་ཆོད་སྨྲ་བས་རྒོལ་ ༼སྣར། པེ།༽ ལྟག་ཆོད་བརྒལ་"
    },
    {
      "span": {
        "start": 23935,
        "end": 23939
      },
      "text": "ལྟག་ ༼སྣར། པེ།༽ རྟག་"
    },
    {
      "span": {
        "start": 24014,
        "end": 24021
      },
      "text": "ཕྲད་པར་ ༼སྣར། པེ།༽ ཕྲད་པ་"
    },
    {
      "span": {
        "start": 24194,
        "end": 24202
      },
      "text": "བསྲེག་པ་ ༼སྣར། པེ།༽ སྲེག་པ་"
    },
    {
      "span": {
        "start": 24271,
        "end": 24275
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ ཉིད་ནི་"
    },
    {
      "span": {
        "start": 24448,
        "end": 24459
      },
      "text": "མཐའ་མེད་པས། ༼ཅོ།༽ མཐའ་མེད་པ།"
    },
    {
      "span": {
        "start": 24563,
        "end": 24569
      },
      "text": "བསལ་བ་ ༼སྣར།༽ གསལ་བ་"
    },
    {
      "span": {
        "start": 24583,
        "end": 24590
      },
      "text": "བསམས་པ་ ༼ཅོ།༽ བསམ་པ་"
    },
    {
      "span": {
        "start": 24707,
        "end": 24714
      },
      "text": "མཁན་པོ་ ༼སྣར། པེ།༽ མཁན་པོ་བི་"
    },
    {
      "span": {
        "start": 24763,
        "end": 24770
      },
      "text": "བརྩེགས་ ༼སྣར། པེ།༽ རྩེགས་"
    }
  ]
}