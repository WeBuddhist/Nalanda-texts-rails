{
  "durchens": [
    {
      "span": {
        "start": 332,
        "end": 337
      },
      "text": "ཟླ་བ་ ༼སྣར། པེ།༽ ཟླ་བའི་"
    },
    {
      "span": {
        "start": 432,
        "end": 444
      },
      "text": "བཅས་པའོ་ཞེས་ ༼སྣར། པེ།༽ བཅས་པའོ་ཞེས་པ་"
    },
    {
      "span": {
        "start": 1031,
        "end": 1038
      },
      "text": "ཡིན་པས་ ༼སྣར། པེ།༽ ཡིན་པས་ལམ་"
    },
    {
      "span": {
        "start": 1572,
        "end": 1575
      },
      "text": "གང་ ༼སྣར། པེ།༽ གང་ཡིན་"
    },
    {
      "span": {
        "start": 1800,
        "end": 1807
      },
      "text": "སྨིན་པ་ ༼སྣར། པེ།༽ སྨིན་པ་རྣམས་"
    },
    {
      "span": {
        "start": 1927,
        "end": 1934
      },
      "text": "ཡེ་ཤེས་ ༼སྣར། པེ།༽ ཡེ་ཤེས་དང་"
    },
    {
      "span": {
        "start": 1989,
        "end": 1994
      },
      "text": "ལ་རང་ ༼སྣར། པེ།༽ ལའང་"
    },
    {
      "span": {
        "start": 2115,
        "end": 2126
      },
      "text": "ཡང་ཕྱིར་རོ། ༼སྣར། པེ།༽ ཡང་ཕྱིར།"
    },
    {
      "span": {
        "start": 2329,
        "end": 2340
      },
      "text": "དེ་སྲིད་དུ་ ༼པེ།༽ དེ་སྲིད་"
    },
    {
      "span": {
        "start": 2957,
        "end": 2964
      },
      "text": "གཞན་དུ་ ༼སྣར། པེ།༽ གཞན་ལ་"
    },
    {
      "span": {
        "start": 3081,
        "end": 3088
      },
      "text": "མེད་དོ་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 3142,
        "end": 3150
      },
      "text": "ཤེས་པའི་ ༼སྣར། པེ།༽ ཤེས་"
    },
    {
      "span": {
        "start": 3150,
        "end": 3155
      },
      "text": "གཉེན་ ༼སྣར།༽ གཉེན་པའི་"
    },
    {
      "span": {
        "start": 4032,
        "end": 4042
      },
      "text": "བསྟན་པ་མི་ ༼པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 4385,
        "end": 4390
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ རྒྱུ་གང་"
    },
    {
      "span": {
        "start": 4393,
        "end": 4401
      },
      "text": "སྦྱོར་བ་ ༼སྣར། པེ།༽ སྦྱོར་"
    },
    {
      "span": {
        "start": 4440,
        "end": 4445
      },
      "text": "བསྟན་ ༼སྣར། པེ།༽ སྟན་"
    },
    {
      "span": {
        "start": 4461,
        "end": 4468
      },
      "text": "བསྟན་པ་ ༼སྣར།༽ བསྟན་པ་ལ་"
    },
    {
      "span": {
        "start": 4740,
        "end": 4749
      },
      "text": "འཁྲུད་པར་ ༼སྣར། པེ།༽ འཁྲུ་བར་"
    },
    {
      "span": {
        "start": 4753,
        "end": 4758
      },
      "text": "པ་དེ་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 4821,
        "end": 4827
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 4932,
        "end": 4940
      },
      "text": "ཐུན་མོང་ ༼སྣར། པེ།༽ ཐུན་མོང་གང་"
    },
    {
      "span": {
        "start": 5304,
        "end": 5310
      },
      "text": "ཐོབ་པ་ ༼སྣར། པེ།༽ ཐོས་པ་"
    },
    {
      "span": {
        "start": 5355,
        "end": 5358
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 6113,
        "end": 6118
      },
      "text": "འབྲུ་ ༼སྣར། པེ།༽ འབྲུ་ལྔ་ནི་"
    },
    {
      "span": {
        "start": 6144,
        "end": 6152
      },
      "text": "རས་ཀྱིས་ ༼སྣར། པེ།༽ རལ་གྱིས་"
    },
    {
      "span": {
        "start": 6684,
        "end": 6690
      },
      "text": "དབང་བ་ ༼སྣར། པེ།༽ དབང་"
    },
    {
      "span": {
        "start": 6803,
        "end": 6809
      },
      "text": "བསྐུར་ ༼སྣར། པེ།༽ བསྐུར་བ་"
    },
    {
      "span": {
        "start": 6816,
        "end": 6821
      },
      "text": "འཁྲུ་ ༼སྣར། པེ།༽ འཁྲུ་བ་"
    },
    {
      "span": {
        "start": 7025,
        "end": 7034
      },
      "text": "འགྲུབ་པར་ ༼སྣར། པེ།༽ གྲུབ་པར་"
    },
    {
      "span": {
        "start": 7168,
        "end": 7177
      },
      "text": "སྤྱི་བོར་ ༼སྣར། པེ།༽ སྤྱི་བོ་"
    },
    {
      "span": {
        "start": 7389,
        "end": 7398
      },
      "text": "ཡིན་པས་ན་ ༼སྣར། པེ།༽ ཡིན་པས་"
    },
    {
      "span": {
        "start": 7583,
        "end": 7592
      },
      "text": "ཏིང་འཛིན་ ༼སྣར། པེ།༽ ཏིང་ངེ་འཛིན་"
    },
    {
      "span": {
        "start": 7670,
        "end": 7676
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 7901,
        "end": 7926
      },
      "text": "བུམ་པ་ལ་སོགས་པའི་མཚན་ཉིད་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 8620,
        "end": 8627
      },
      "text": "གཅལ་བར་ ༼སྣར། པེ།༽ གཅལ་བ་"
    },
    {
      "span": {
        "start": 8753,
        "end": 8774
      },
      "text": "ནུས་པ་ཕུན་སུམ་ཚོགས་པ་ ༼སྣར། པེ།༽ ནུས་པ་"
    },
    {
      "span": {
        "start": 8842,
        "end": 8850
      },
      "text": "བྱ་བ་ཡང་ ༼སྣར། པེ།༽ བྱ་བ་དང་"
    },
    {
      "span": {
        "start": 9439,
        "end": 9443
      },
      "text": "གའི་ ༼སྣར། པེ།༽ ག་"
    },
    {
      "span": {
        "start": 9572,
        "end": 9580
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ བྱུང་བ་"
    },
    {
      "span": {
        "start": 10411,
        "end": 10420
      },
      "text": "བརྡའི་ལན་ ༼སྣར། པེ།༽ བརྡའི་ལམ་"
    },
    {
      "span": {
        "start": 10540,
        "end": 10547
      },
      "text": "བཅུག་པ་ ༼སྣར། པེ།༽ ལྐུགས་པ་"
    },
    {
      "span": {
        "start": 10803,
        "end": 10807
      },
      "text": "ཅིག་ ༼སྣར། པེ།༽ གཅིག་"
    },
    {
      "span": {
        "start": 10809,
        "end": 10817
      },
      "text": "བསྐུར་བ་ ༼སྣར། པེ།༽ བསྐུར་"
    },
    {
      "span": {
        "start": 10961,
        "end": 10963
      },
      "text": "པ་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 10975,
        "end": 10985
      },
      "text": "བསྐུར་བའི་ ༼སྣར། པེ།༽ བསྐུར་"
    },
    {
      "span": {
        "start": 11100,
        "end": 11109
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 11501,
        "end": 11507
      },
      "text": "ལན་ཚྭ་ ༼སྣར། པེ།༽ ལན་ཚྭ་བ་"
    },
    {
      "span": {
        "start": 12031,
        "end": 12042
      },
      "text": "བྱང་ཆུབ་ཏུ་ ༼སྣར། པེ།༽ བྱང་ཆུབ་"
    },
    {
      "span": {
        "start": 12700,
        "end": 12710
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 12756,
        "end": 12762
      },
      "text": "ཁར་རྔ་ ༼སྣར། པེ།༽ འཁར་རྔ་"
    },
    {
      "span": {
        "start": 13231,
        "end": 13241
      },
      "text": "ནི་རྣ་ལྟག་ ༼པེ།༽ ནི་རྟག་"
    },
    {
      "span": {
        "start": 14099,
        "end": 14104
      },
      "text": "བྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 14528,
        "end": 14534
      },
      "text": "གནང་བ་ ༼སྣར། པེ།༽ ནད་པ་"
    },
    {
      "span": {
        "start": 14745,
        "end": 14752
      },
      "text": "བསྡུ་བ་ ༼སྣར། པེ།༽ བསྡུས་པ་"
    },
    {
      "span": {
        "start": 14763,
        "end": 14769
      },
      "text": "ནོད་པ་ ༼སྣར། པེ།༽ མནོད་པ་"
    },
    {
      "span": {
        "start": 14881,
        "end": 14888
      },
      "text": "བྱས་ཏེ། ༼སྣར། པེ།༽ བྱས་ལ།"
    },
    {
      "span": {
        "start": 15323,
        "end": 15330
      },
      "text": "བསླང་བ་ ༼སྣར། པེ།༽ སླང་བ་"
    },
    {
      "span": {
        "start": 15377,
        "end": 15382
      },
      "text": "བརླབ་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 15399,
        "end": 15407
      },
      "text": "ཞེས་པའོ། ༼སྣར། པེ།༽ ཞེས་པ།"
    },
    {
      "span": {
        "start": 15694,
        "end": 15706
      },
      "text": "མེ་ལ་རྟོག་པ་ ༼སྣར། པེ།༽ མེ་ཏོག་"
    },
    {
      "span": {
        "start": 15887,
        "end": 15892
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 16004,
        "end": 16009
      },
      "text": "བརླབ་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 16197,
        "end": 16204
      },
      "text": "སོ་སོར་ ༼སྣར། པེ།༽ གོ་གོར་"
    },
    {
      "span": {
        "start": 16838,
        "end": 16845
      },
      "text": "འོད་དུ་ ༼སྣར། པེ།༽ འོག་ཏུ་"
    },
    {
      "span": {
        "start": 16988,
        "end": 16995
      },
      "text": "བརླབ་པ་ ༼སྣར། པེ།༽ བརླབ་"
    },
    {
      "span": {
        "start": 17073,
        "end": 17082
      },
      "text": "བསྡུ་བའམ་ ༼སྣར། པེ།༽ བསྡུ་བའི་"
    },
    {
      "span": {
        "start": 17400,
        "end": 17408
      },
      "text": "བརླབས་པ་ ༼སྣར།༽ བརླབ་པ་"
    },
    {
      "span": {
        "start": 17575,
        "end": 17578
      },
      "text": "ཡི། ༼སྣར། པེ།༽ ཡིད།"
    },
    {
      "span": {
        "start": 17706,
        "end": 17714
      },
      "text": "སྡུ་གུར་ ༼སྣར། པེ།༽ སྡུག་གུར་"
    },
    {
      "span": {
        "start": 17923,
        "end": 17930
      },
      "text": "བརྟག་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 18147,
        "end": 18153
      },
      "text": "ཕོག་པ་ ༼སྣར། པེ།༽ ཕོབ་པ་"
    },
    {
      "span": {
        "start": 18158,
        "end": 18164
      },
      "text": "ཕོག་པ་ ༼སྣར། པེ།༽ ཕོབ་པ་"
    },
    {
      "span": {
        "start": 18508,
        "end": 18518
      },
      "text": "སེམས་ཀྱིས་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 18531,
        "end": 18538
      },
      "text": "ལྷ་མོས་ ༼སྣར། པེ།༽ ལྷ་མོ་"
    },
    {
      "span": {
        "start": 18565,
        "end": 18574
      },
      "text": "བསྒོམས་པ་ ༼སྣར། པེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 18735,
        "end": 18752
      },
      "text": "གང་གིས་དབང་བསྐུར་ ༼སྣར། པེ།༽ གང་གི་དབང་"
    },
    {
      "span": {
        "start": 19003,
        "end": 19012
      },
      "text": "ཞིང་དེའི་ ༼སྣར། པེ།༽ ཞིང་"
    },
    {
      "span": {
        "start": 19197,
        "end": 19201
      },
      "text": "ཞེས་ ༼སྣར། པེ།༽ ། །བསྟན་ཅེས་"
    },
    {
      "span": {
        "start": 19318,
        "end": 19324
      },
      "text": "རི་ལུ་ ༼སྣར། པེ།༽ རིལ་བུ་"
    },
    {
      "span": {
        "start": 19374,
        "end": 19391
      },
      "text": "བུམ་པ་ལ་སོགས་པའི་ ༼སྣར། པེ།༽ བུམ་པའི་"
    },
    {
      "span": {
        "start": 19405,
        "end": 19420
      },
      "text": "དཀྱིལ་འཁོར་གྱི་ ༼སྣར། པེ།༽ དཀྱིལ་འཁོར་གྱིས་"
    },
    {
      "span": {
        "start": 19434,
        "end": 19441
      },
      "text": "རྒྱས་པ་ ༼སྡེ།༽ རྒྱས་པར་"
    },
    {
      "span": {
        "start": 19582,
        "end": 19589
      },
      "text": "བཀུག་པ་ ༼སྣར། པེ།༽ ལྐུགས་པ་"
    },
    {
      "span": {
        "start": 19784,
        "end": 19787
      },
      "text": "གང་ ༼སྣར། པེ།༽ གང་ཞིག་"
    },
    {
      "span": {
        "start": 19973,
        "end": 19977
      },
      "text": "ཐོབ་ ༼སྣར། པེ།༽ ཐོག་"
    },
    {
      "span": {
        "start": 19992,
        "end": 19994
      },
      "text": "པ་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 20004,
        "end": 20007
      },
      "text": "གང་ ༼སྣར། པེ།༽ གང་ཞིག་"
    },
    {
      "span": {
        "start": 20685,
        "end": 20687
      },
      "text": "པ་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 21054,
        "end": 21065
      },
      "text": "བསམ་གཏན་དང་ ༼སྣར། པེ།༽ བསམ་གཏན་"
    },
    {
      "span": {
        "start": 21123,
        "end": 21129
      },
      "text": "བྲལ་བ་ ༼སྣར། པེ།༽ བྲལ་"
    },
    {
      "span": {
        "start": 21349,
        "end": 21356
      },
      "text": "གསང་བར་ ༼སྣར། པེ།༽ གསང་"
    },
    {
      "span": {
        "start": 21818,
        "end": 21823
      },
      "text": "རླབས་ ༼ཅོ།༽ བརླབས་ ༼སྣར། པེ།༽ བརླབ་"
    },
    {
      "span": {
        "start": 21872,
        "end": 21877
      },
      "text": "བྱེད། ༼སྣར། པེ།༽ བྱེད་པ།"
    },
    {
      "span": {
        "start": 22374,
        "end": 22386
      },
      "text": "བྱང་ཆུབ་ཀྱི་ ༼སྣར། པེ།༽ བྱང་ཆུབ་"
    },
    {
      "span": {
        "start": 22419,
        "end": 22426
      },
      "text": "ཏིང་ངེ་ ༼སྣར། པེ།༽ ཏིང་"
    },
    {
      "span": {
        "start": 22503,
        "end": 22508
      },
      "text": "བྱ་བ་ ༼པེ།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 22697,
        "end": 22701
      },
      "text": "མོད་ ༼སྣར། པེ།༽ མོས་"
    },
    {
      "span": {
        "start": 22743,
        "end": 22760
      },
      "text": "འགྱུར་བས་བྱང་ཆུབ་ ༼སྣར། པེ།༽ འགྱུར་བས་"
    },
    {
      "span": {
        "start": 22789,
        "end": 22803
      },
      "text": "སེམས་ཞེས་བྱ་བ་ ༼སྣར། པེ།༽ སེམས་ཤེས་པ་"
    },
    {
      "span": {
        "start": 22912,
        "end": 22917
      },
      "text": "སྦྱར་ ༼སྣར། པེ།༽ སྦྱོར་བའི་"
    },
    {
      "span": {
        "start": 22979,
        "end": 22983
      },
      "text": "དབབ་ ༼སྣར།༽ དབང་"
    },
    {
      "span": {
        "start": 23287,
        "end": 23294
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 23348,
        "end": 23351
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 23359,
        "end": 23369
      },
      "text": "སྦྱངས་པའི་ ༼སྣར། པེ།༽ སྦྱང་བའི་"
    },
    {
      "span": {
        "start": 23407,
        "end": 23414
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 23560,
        "end": 23571
      },
      "text": "གཟོབ་པ་འོང་ ༼སྣར། པེ།༽ གཟོབ་པ་འང་"
    },
    {
      "span": {
        "start": 24030,
        "end": 24039
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ གཉིས་ཀྱི་"
    },
    {
      "span": {
        "start": 24365,
        "end": 24375
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 24394,
        "end": 24424
      },
      "text": "སུ་སྤྱད་པའི་སྟོབས་ཀྱིས་འཁོར་བ་ ༼སྣར། པེ།༽ སུ་སྦྱང་བའི་སྟོབས་ཀྱི་འཁོར་"
    },
    {
      "span": {
        "start": 24456,
        "end": 24463
      },
      "text": "ཉན་ཐོས་ ༼སྣར།༽ ཉན་ཐོས་དང་"
    },
    {
      "span": {
        "start": 24502,
        "end": 24513
      },
      "text": "སྟོབས་ཀྱིས་ ༼པེ།༽ སྟོབས་ཀྱི་"
    },
    {
      "span": {
        "start": 24589,
        "end": 24595
      },
      "text": "བསླངས་ ༼སྣར། པེ།༽ བསླང་"
    },
    {
      "span": {
        "start": 24598,
        "end": 24607
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 24663,
        "end": 24671
      },
      "text": "གཞིའོ། །༼སྣར། པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 24700,
        "end": 24703
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 24775,
        "end": 24787
      },
      "text": "བྱང་ཆུབ་ཀྱི་ ༼སྣར། པེ།༽ བྱང་ཆུབ་"
    },
    {
      "span": {
        "start": 24815,
        "end": 24819
      },
      "text": "པའི་ ༼སྣར། པེ།༽ པའི་བྱང་ཆུབ་སེམས་དཀར་དམར་དང་"
    },
    {
      "span": {
        "start": 25183,
        "end": 25188
      },
      "text": "རྟེན་ ༼སྣར།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 25354,
        "end": 25362
      },
      "text": "བརྟེན་པ་ ༼སྣར། པེ།༽ བརྟེན་པའི་"
    },
    {
      "span": {
        "start": 25493,
        "end": 25499
      },
      "text": "ཡང་ནི་ ༼སྣར། པེ།༽ ཡང་ན་"
    },
    {
      "span": {
        "start": 25536,
        "end": 25542
      },
      "text": "བུམ་པ་ ༼སྣར། པེ།༽ བུག་པ་"
    },
    {
      "span": {
        "start": 25583,
        "end": 25592
      },
      "text": "བརྟེན་པས་ ༼སྣར། པེ།༽ བསྟན་པས་"
    },
    {
      "span": {
        "start": 25704,
        "end": 25715
      },
      "text": "མིང་བཏགས་པ་ ༼སྣར། པེ།༽ མིང་བརྟགས་"
    },
    {
      "span": {
        "start": 25749,
        "end": 25755
      },
      "text": "ཡིན་པ་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 25860,
        "end": 25869
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 26058,
        "end": 26064
      },
      "text": "ཅེས་པ་ ༼སྣར། པེ།༽ ས་པ་"
    },
    {
      "span": {
        "start": 26112,
        "end": 26116
      },
      "text": "བྱང་ ༼སྣར། པེ།༽ བྱང་ཆུབ་"
    },
    {
      "span": {
        "start": 26194,
        "end": 26198
      },
      "text": "བྱང་ ༼སྣར། པེ།༽ བྱང་ཆུབ་"
    },
    {
      "span": {
        "start": 26217,
        "end": 26226
      },
      "text": "བརྟེན་ནས་ ༼སྣར། པེ།༽ བརྟེན་ལ་"
    },
    {
      "span": {
        "start": 26562,
        "end": 26567
      },
      "text": "ལ་རྩ་ ༼སྣར།༽ ལ་རྩ་བ་"
    },
    {
      "span": {
        "start": 26597,
        "end": 26606
      },
      "text": "ནི་ཀ་བའོ། ༼སྣར།༽ ནི་བཀཔའོ ༼པེ།༽ ནི་བཀ་བའོ།"
    },
    {
      "span": {
        "start": 26783,
        "end": 26791
      },
      "text": "རས་ཀྱིས་ ༼སྣར། པེ།༽ རས་ཀྱི་"
    },
    {
      "span": {
        "start": 26794,
        "end": 26803
      },
      "text": "ཡང་དག་པར་ ༼སྡེ།༽ ཡང་དག་པ་"
    },
    {
      "span": {
        "start": 26863,
        "end": 26878
      },
      "text": "ཕྱག་རྒྱ་མ་གཉིས་ ༼སྣར། པེ།༽ ཕྱག་རྒྱ་མ་"
    },
    {
      "span": {
        "start": 27093,
        "end": 27099
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 27228,
        "end": 27235
      },
      "text": "བསླང་བ་ ༼སྣར། པེ།༽ བསློང་བ་"
    },
    {
      "span": {
        "start": 27362,
        "end": 27367
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 27857,
        "end": 27861
      },
      "text": "གཅལ་ ༼སྣར། པེ།༽ བཅལ་"
    },
    {
      "span": {
        "start": 27915,
        "end": 27922
      },
      "text": "ངོ་བོར་ ༼སྣར། པེ།༽ ངོ་བོ་"
    },
    {
      "span": {
        "start": 27975,
        "end": 27980
      },
      "text": "རྟགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 28051,
        "end": 28056
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 28086,
        "end": 28102
      },
      "text": "མཐོང་བའི་འདྲི་བ་ ༼སྣར། པེ།༽ མཐོང་བ་"
    },
    {
      "span": {
        "start": 28460,
        "end": 28464
      },
      "text": "ལྟར་ ༼སྣར། པེ།༽ ལྷར་"
    },
    {
      "span": {
        "start": 28705,
        "end": 28709
      },
      "text": "ལྕེ་ ༼སྣར། པེ།༽ ལྟེ་"
    },
    {
      "span": {
        "start": 29037,
        "end": 29051
      },
      "text": "ཞེས་པ་སྦྱིན་པ་ ༼སྣར། པེ།༽ ཞེས་པ་"
    },
    {
      "span": {
        "start": 29065,
        "end": 29072
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 29076,
        "end": 29088
      },
      "text": "མེད་བསྟེན་པ་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 29120,
        "end": 29129
      },
      "text": "ལྟོས་པའི་ ༼སྣར། པེ།༽ བལྟོས་པའི་"
    },
    {
      "span": {
        "start": 29276,
        "end": 29281
      },
      "text": "ཟབ་པ་ ༼སྣར། པེ།༽ ཟབ་"
    },
    {
      "span": {
        "start": 29350,
        "end": 29367
      },
      "text": "བསྐྱེད་པའི་རིམ་པ་ ༼སྣར། པེ།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 29505,
        "end": 29510
      },
      "text": "འདིར་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 29599,
        "end": 29605
      },
      "text": "རི་ལུ་ ༼སྣར། པེ།༽ རིལ་བུ་"
    },
    {
      "span": {
        "start": 29650,
        "end": 29660
      },
      "text": "བཅུད་ཀྱིས་ ༼སྣར། པེ།༽ བཅུད་ཀྱི་"
    },
    {
      "span": {
        "start": 29660,
        "end": 29664
      },
      "text": "ལེན་ ༼སྣར། པེ།༽ ལེན་པ་"
    },
    {
      "span": {
        "start": 29795,
        "end": 29802
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 29850,
        "end": 29865
      },
      "text": "སུ་དང་། བརྒྱུད་ ༼སྣར། པེ།༽ སུ་དངརྒྱུད་"
    },
    {
      "span": {
        "start": 30017,
        "end": 30027
      },
      "text": "བསྟན་ཏོ། །༼སྣར། པེ།༽ བསྟན་།། །།"
    },
    {
      "span": {
        "start": 30076,
        "end": 30085
      },
      "text": "འདིའི་ཡང་ ༼སྣར། པེ།༽ འདིའི་"
    },
    {
      "span": {
        "start": 30174,
        "end": 30180
      },
      "text": "རང་གི་ ༼སྣར། པེ།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 30224,
        "end": 30238
      },
      "text": "ཤེས་རབ་ཡེ་ཤེས་ ༼སྣར། པེ།༽ ཤེས་རབ་"
    },
    {
      "span": {
        "start": 30359,
        "end": 30366
      },
      "text": "འདི་འང་ ༼སྣར། པེ།༽ འདི་གང་"
    },
    {
      "span": {
        "start": 30527,
        "end": 30538
      },
      "text": "སྟོབས་ཀྱིས་ ༼སྣར། པེ།༽ སྟོབས་ཀྱི་"
    },
    {
      "span": {
        "start": 30644,
        "end": 30649
      },
      "text": "བྱེད་ ༼སྣར། པེ།༽ བྱེད་པའི་"
    },
    {
      "span": {
        "start": 30715,
        "end": 30719
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ ཉིད་དང་"
    },
    {
      "span": {
        "start": 31075,
        "end": 31082
      },
      "text": "ཏིང་ངེ་ ༼སྣར། པེ།༽ ཏིང་"
    },
    {
      "span": {
        "start": 31137,
        "end": 31308
      },
      "text": "། །ཞེས་པ་ཤེས་རབ་དམ་པ་བསྐྱེད་པ་ཉིད་དང་། ཡེ་ཤེས་དམ་པ་དང་། ཏིང་ངེ་འཛིན་དམ་པ་ལ་དམིགས་པ་ཉིད་དང་ཐབས་བདེན་པའི་རྣལ་འབྱོར་པ་བདག་ཉིད་ཀྱི་འཇུག་པ་དང་། ཞུ་བ་བྱང་ཆུབ་སེམས་ལ་སྤྱོད་པ་དང་། ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 31327,
        "end": 31334
      },
      "text": "འདུག་པ་ ༼སྣར། པེ།༽ འཇུག་པ་"
    },
    {
      "span": {
        "start": 31739,
        "end": 31746
      },
      "text": "ཉེ་བའི་ ༼སྣར། པེ།༽ ཉེས་པའི་"
    },
    {
      "span": {
        "start": 31874,
        "end": 31886
      },
      "text": "དམིགས་པ་ཡིས། ༼སྣར། པེ།༽ དམིགས་པ་ཡི།"
    },
    {
      "span": {
        "start": 31953,
        "end": 31959
      },
      "text": "བསྐུར་ ༼སྣར། པེ།༽ སྐུར་"
    },
    {
      "span": {
        "start": 31982,
        "end": 31987
      },
      "text": "གང་མ་ ༼སྣར། པེ།༽ གོང་མ་"
    },
    {
      "span": {
        "start": 32050,
        "end": 32065
      },
      "text": "ཐོབ་པའི་སྟེང་ལ་ ༼སྣར། པེ།༽ ཐོབ་པ་"
    },
    {
      "span": {
        "start": 32095,
        "end": 32105
      },
      "text": "གཉིས་ཀྱིས་ ༼སྣར། པེ།༽ གཉིས་ཀྱི་"
    },
    {
      "span": {
        "start": 32129,
        "end": 32134
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ གཉིས་ཀ་"
    },
    {
      "span": {
        "start": 32216,
        "end": 32221
      },
      "text": "སྦྱར་ ༼སྣར། པེ།༽ སྦྱོར་"
    },
    {
      "span": {
        "start": 32523,
        "end": 32530
      },
      "text": "དངངས་པ་ ༼སྣར། པེ།༽ དངང་བ་"
    },
    {
      "span": {
        "start": 32782,
        "end": 32793
      },
      "text": "ཁྱད་པར་གྱི་ ༼སྣར།༽ ཁྱད་པར་གྱིས་"
    },
    {
      "span": {
        "start": 33281,
        "end": 33285
      },
      "text": "ཏིང་ ༼སྣར། པེ།༽ ཏིང་ངེ་"
    },
    {
      "span": {
        "start": 33285,
        "end": 33294
      },
      "text": "འཛིན་འདི་ ༼སྣར། པེ།༽ འཛིན་"
    },
    {
      "span": {
        "start": 33301,
        "end": 33305
      },
      "text": "ཞེས་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 33549,
        "end": 33557
      },
      "text": "སྦྱོར་བ་ ༼སྣར། པེ།༽ སྦྱོར་བས་"
    },
    {
      "span": {
        "start": 33640,
        "end": 33645
      },
      "text": "དང་མ་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 33654,
        "end": 33659
      },
      "text": "མྱོང་ ༼སྣར། པེ།༽ མྱང་"
    },
    {
      "span": {
        "start": 33897,
        "end": 33906
      },
      "text": "སེམས་ཀྱི་ ༼སྣར། པེ།༽ སེམས་"
    },
    {
      "span": {
        "start": 33965,
        "end": 33976
      },
      "text": "འཇོམས་པ་ནི་ ༼སྣར། པེ།༽ འཇོམས་པ་"
    },
    {
      "span": {
        "start": 34005,
        "end": 34011
      },
      "text": "གོང་མ་ ༼སྣར། པེ།༽ གོང་"
    },
    {
      "span": {
        "start": 34934,
        "end": 34937
      },
      "text": "གང་ ༼སྣར། པེ།༽ གསང་"
    },
    {
      "span": {
        "start": 35322,
        "end": 35328
      },
      "text": "འབྱུང་ ༼སྣར། པེ།༽ བྱུང་"
    },
    {
      "span": {
        "start": 35641,
        "end": 35647
      },
      "text": "མནན་པ་ ༼སྣར། པེ།༽ མནན་པའི་"
    },
    {
      "span": {
        "start": 35687,
        "end": 35698
      },
      "text": "སོར་མོ་ཡིས། ༼སྣར། པེ།༽ སོར་མོ་ཡི།"
    },
    {
      "span": {
        "start": 35717,
        "end": 35723
      },
      "text": "གཞག་པ་ ༼སྣར། པེ།༽ བཞག་པ་"
    },
    {
      "span": {
        "start": 35974,
        "end": 35983
      },
      "text": "སྟེང་འོག་ ༼སྣར། པེ།༽ སྟེང་འོག་དང་"
    },
    {
      "span": {
        "start": 36025,
        "end": 36036
      },
      "text": "སྟོབས་ཀྱིས་ ༼སྣར། པེ།༽ སྟོབས་ཀྱི་"
    },
    {
      "span": {
        "start": 36821,
        "end": 36827
      },
      "text": "དེ་འང་ ༼སྣར། པེ།༽ དེ་ལའང་"
    },
    {
      "span": {
        "start": 36856,
        "end": 36864
      },
      "text": "འདི་ཡིས་ ༼སྣར། པེ།༽ འདི་ཡི་"
    },
    {
      "span": {
        "start": 36934,
        "end": 36942
      },
      "text": "རིག་མ་ལ་ ༼སྣར། པེ།༽ རིག་མ་"
    },
    {
      "span": {
        "start": 37019,
        "end": 37028
      },
      "text": "བརྟེན་པར་ ༼སྣར། པེ།༽ བསྟན་པར་"
    },
    {
      "span": {
        "start": 37190,
        "end": 37198
      },
      "text": "འགྲུབ་པ་ ༼སྣར། པེ།༽ གྲུབ་པ་"
    },
    {
      "span": {
        "start": 37695,
        "end": 37699
      },
      "text": "མཉན་ ༼སྣར། པེ།༽ གཉན་"
    },
    {
      "span": {
        "start": 37977,
        "end": 38002
      },
      "text": "ཡེ་ཤེས་ཀྱི་དབང་བསྐུར་བའི་ ༼སྣར། པེ།༽ ཡེ་ཤེས་ཀྱི་"
    },
    {
      "span": {
        "start": 38082,
        "end": 38087
      },
      "text": "རྟེན་ ༼སྣར། པེ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 38091,
        "end": 38095
      },
      "text": "ཀྱི། ༼སྣར། པེ།༽ ཀྱིས།"
    },
    {
      "span": {
        "start": 38248,
        "end": 38254
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 38548,
        "end": 38555
      },
      "text": "འདི་ནི་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 38578,
        "end": 38584
      },
      "text": "གང་དུ་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 39120,
        "end": 39126
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 39707,
        "end": 39715
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 40004,
        "end": 40014
      },
      "text": "གང་ཞིག་གི་ ༼སྣར། པེ།༽ གང་ཞིག་གིས་"
    },
    {
      "span": {
        "start": 40077,
        "end": 40085
      },
      "text": "དེ་ལ་དེ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 40616,
        "end": 40627
      },
      "text": "གྱུར་པ་ཡིས། ༼སྣར། པེ།༽ གྱུར་པ་ཡི།"
    },
    {
      "span": {
        "start": 40721,
        "end": 40732
      },
      "text": "དཀྱིལ་འཁོར་ ༼སྣར། པེ།༽ དཀྱིལ་"
    },
    {
      "span": {
        "start": 40746,
        "end": 40753
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 41522,
        "end": 41526
      },
      "text": "བཞུ་ ༼སྣར། པེ།༽ གཞུ་"
    },
    {
      "span": {
        "start": 42126,
        "end": 42134
      },
      "text": "བརྟེན་པ་ ༼སྣར། པེ།༽ རྟེན་པ་"
    },
    {
      "span": {
        "start": 42315,
        "end": 42332
      },
      "text": "སློབ་པ་སྨིག་རྒྱུ་ ༼སྣར། པེ།༽ སློབ་པ་དམིགས་"
    },
    {
      "span": {
        "start": 42334,
        "end": 42339
      },
      "text": "སོགས་ ༼སྣར། པེ།༽ སོགས་པ་"
    },
    {
      "span": {
        "start": 42475,
        "end": 42483
      },
      "text": "ཟླ་བསྟན་ ༼སྣར། པེ།༽ ཟླ་བ་"
    },
    {
      "span": {
        "start": 42536,
        "end": 42546
      },
      "text": "དང་ཚིག་དང་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 42976,
        "end": 42979
      },
      "text": "ཡི་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 43330,
        "end": 43336
      },
      "text": "བསྐུར་ ༼སྣར། པེ།༽ སྒྱུར་"
    },
    {
      "span": {
        "start": 43822,
        "end": 43829
      },
      "text": "ཁྱད་ནི་ ༼སྣར། པེ།༽ ཁྱད་པར་"
    },
    {
      "span": {
        "start": 44442,
        "end": 44451
      },
      "text": "རྣམ་གྲངས་ ༼སྣར། པེ།༽ རྣམས་གང་"
    },
    {
      "span": {
        "start": 44899,
        "end": 44908
      },
      "text": "གང་ཡིན་པ་ ༼སྣར། པེ།༽ གང་ཡིན་"
    },
    {
      "span": {
        "start": 44947,
        "end": 44950
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 45135,
        "end": 45142
      },
      "text": "འདི་ཡང་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 45360,
        "end": 45365
      },
      "text": "རྟེན་ ༼སྣར།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 45384,
        "end": 45392
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 45469,
        "end": 45478
      },
      "text": "། །ཞེས་པ་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 46712,
        "end": 46720
      },
      "text": "དམིགས་པ་ ༼སྣར། པེ།༽ དམིགས་པའོ་"
    },
    {
      "span": {
        "start": 46774,
        "end": 46779
      },
      "text": "སྐོམ་ ༼པེ།༽ སྒོམ་"
    },
    {
      "span": {
        "start": 46839,
        "end": 46850
      },
      "text": "བསྐྱེད་པའི་ ༼སྣར། པེ།༽ སྐྱེད་པའི་"
    },
    {
      "span": {
        "start": 47003,
        "end": 47011
      },
      "text": "བསྐུར་བ་ ༼སྣར། པེ།༽ བསྐུར་"
    },
    {
      "span": {
        "start": 47053,
        "end": 47058
      },
      "text": "བསྐང་ ༼སྣར། པེ།༽ བསྐོང་"
    },
    {
      "span": {
        "start": 47126,
        "end": 47134
      },
      "text": "རྒྱུ་དག་ ༼སྣར། པེ།༽ རྒྱུད་པ་"
    },
    {
      "span": {
        "start": 47391,
        "end": 47393
      },
      "text": "པ་ ༼ཅོ།༽ པའི་"
    },
    {
      "span": {
        "start": 47619,
        "end": 47643
      },
      "text": "། བསོད་ནམས་ཀྱི་ཚོགས་དང་། ༼སྣར། པེ།༽ །"
    },
    {
      "span": {
        "start": 47679,
        "end": 47684
      },
      "text": "བྱའོ། ༼སྣར། པེ།༽ བྱའོ་ཞེས་བྱའོ།"
    },
    {
      "span": {
        "start": 47868,
        "end": 47876
      },
      "text": "གནས་ཀྱང་ ༼སྣར། པེ།༽ གནས་"
    },
    {
      "span": {
        "start": 47928,
        "end": 47932
      },
      "text": "ཡིས་ ༼སྣར། པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 47948,
        "end": 47954
      },
      "text": "ཞེས་པ་ ༼སྣར། པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 48384,
        "end": 48403
      },
      "text": "གོམས་པ་ནི། །བསྒྱུར་ ༼སྣར། པེ།༽ གོམས་པ་མི་སྒྱུར་"
    },
    {
      "span": {
        "start": 48503,
        "end": 48512
      },
      "text": "ནི་འདིའི་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 48916,
        "end": 48927
      },
      "text": "འདི་དག་གིས་ ༼སྣར། པེ།༽ འདི་དག་"
    },
    {
      "span": {
        "start": 49304,
        "end": 49311
      },
      "text": "གསོས་པ་ ༼སྣར། པེ།༽ གསོས་"
    },
    {
      "span": {
        "start": 49996,
        "end": 50002
      },
      "text": "གང་དང་ ༼སྣར།༽ གང་ཡང་"
    },
    {
      "span": {
        "start": 50261,
        "end": 50271
      },
      "text": "འབྲས་བུའོ། ༼སྣར། པེ།༽ འབྲས་བུ་དང་།"
    },
    {
      "span": {
        "start": 50288,
        "end": 50295
      },
      "text": "བྱ་བའང་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 50546,
        "end": 50556
      },
      "text": "ཤུགས་ཀྱིས་ ༼སྣར། པེ།༽ ཤུགས་ཀྱི་"
    },
    {
      "span": {
        "start": 51013,
        "end": 51022
      },
      "text": "དབང་པོའང་ ༼སྣར། པེ།༽ དབང་པོའི་འང་"
    },
    {
      "span": {
        "start": 51165,
        "end": 51180
      },
      "text": "ལུས་ཀྱི་དབང་པོ་ ༼སྣར། པེ།༽ ལུས་"
    },
    {
      "span": {
        "start": 51402,
        "end": 51411
      },
      "text": "བརྟེན་པར་ ༼ཅོ།༽ རྟེན་པར་"
    },
    {
      "span": {
        "start": 51489,
        "end": 51504
      },
      "text": "ཅིའི་ཕྱིར་དེའི་ ༼སྣར། པེ།༽ ཅིའི་ཕྱིར་"
    },
    {
      "span": {
        "start": 52019,
        "end": 52026
      },
      "text": "རྩེ་མོ་ ༼སྣར། པེ།༽ རྩེ་མོར་"
    },
    {
      "span": {
        "start": 52213,
        "end": 52219
      },
      "text": "རྒྱུན་ ༼སྣར། པེ།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 52304,
        "end": 52316
      },
      "text": "དེ་ལས་གང་གི་ ༼སྣར། པེ།༽ དེ་ལས་གོང་"
    },
    {
      "span": {
        "start": 52323,
        "end": 52328
      },
      "text": "འདུས་ ༼སྣར། པེ།༽ འདུག་"
    },
    {
      "span": {
        "start": 52390,
        "end": 52395
      },
      "text": "རྣ་བ་ ༼སྣར། པེ།༽ རྣ་བ་སྣ་"
    },
    {
      "span": {
        "start": 52395,
        "end": 52401
      },
      "text": "དང་ནི་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 52538,
        "end": 52542
      },
      "text": "གྲི། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 52852,
        "end": 52859
      },
      "text": "རྩེ་མོ་ ༼སྣར། པེ།༽ རྩེ་"
    },
    {
      "span": {
        "start": 53070,
        "end": 53077
      },
      "text": "གང་ཞིག་ ༼སྣར། པེ།༽ གང་"
    },
    {
      "span": {
        "start": 53081,
        "end": 53086
      },
      "text": "སྙིང་ ༼སྣར། པེ།༽ སྙིང་པོ་"
    },
    {
      "span": {
        "start": 53947,
        "end": 53953
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 53986,
        "end": 53996
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 54020,
        "end": 54027
      },
      "text": "རྒྱུ་བ་ ༼སྣར། པེ།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 54341,
        "end": 54347
      },
      "text": "གསུངས། ༼སྣར། པེ།༽ གསུང་།"
    },
    {
      "span": {
        "start": 54779,
        "end": 54786
      },
      "text": "ཡིན་པས་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 54831,
        "end": 54837
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 55359,
        "end": 55367
      },
      "text": "ལ་བརྟེན་ ༼སྣར། པེ།༽ ལས་བསྟན་"
    },
    {
      "span": {
        "start": 55398,
        "end": 55404
      },
      "text": "དང་པོ་ ༼སྣར། པེ།༽ དང་པོ་པ་"
    },
    {
      "span": {
        "start": 55503,
        "end": 55517
      },
      "text": "རྡོ་རྗེས་བཟླས་ ༼སྣར། པེ།༽ རྡོ་རྗེ་ཟླས་"
    },
    {
      "span": {
        "start": 55520,
        "end": 55534
      },
      "text": "རྡོ་རྗེར་བཟླས། ༼སྣར། པེ།༽ རྡོ་རྗེ་ཟླས།"
    },
    {
      "span": {
        "start": 55563,
        "end": 55575
      },
      "text": "རྡོ་རྗེ་ཡིས་ ༼སྣར། པེ།༽ རྡོ་རྗེ་ཡི་"
    },
    {
      "span": {
        "start": 55620,
        "end": 55626
      },
      "text": "སྤོང་། ༼སྣར། པེ།༽ སྤོར།"
    },
    {
      "span": {
        "start": 55706,
        "end": 55715
      },
      "text": "རྡོ་རྗེར་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 55775,
        "end": 55780
      },
      "text": "ཟློས་ ༼སྣར། པེ།༽ བཟློས་"
    },
    {
      "span": {
        "start": 56951,
        "end": 56959
      },
      "text": "རྟོག་པར་ ༼སྡེ།༽ རྟོགས་པར་"
    },
    {
      "span": {
        "start": 57532,
        "end": 57551
      },
      "text": "དམིགས་པ་མཐར་ཕྱིན་པ་ ༼སྣར། པེ།༽ དམིགས་པ་"
    },
    {
      "span": {
        "start": 57875,
        "end": 57883
      },
      "text": "དང་བ་ཐག་ ༼སྣར། པེ།༽ དང་བ་ཐག་དང་བ་ཐག་ལ་"
    },
    {
      "span": {
        "start": 58384,
        "end": 58389
      },
      "text": "རྟེན་ ༼ཅོ།༽ བརྟེན་"
    },
    {
      "span": {
        "start": 58474,
        "end": 58479
      },
      "text": "འཁྱལ་ ༼སྣར། པེ།༽ ཁྱལ་"
    },
    {
      "span": {
        "start": 58512,
        "end": 58518
      },
      "text": "ཀྱལ་པ་ ༼སྣར། པེ།༽ ཁྱལ་པ་"
    },
    {
      "span": {
        "start": 58567,
        "end": 58574
      },
      "text": "བཟླས་པ་ ༼སྣར། པེ།༽ བཟླས་པའི་"
    },
    {
      "span": {
        "start": 58797,
        "end": 58804
      },
      "text": "བཟོད་པ་ ༼སྣར། པེ།༽ བཟོད་པའི་"
    },
    {
      "span": {
        "start": 58995,
        "end": 59003
      },
      "text": "འབྱུང་ལ་ ༼སྣར།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 59082,
        "end": 59089
      },
      "text": "འདི་ཡི་ ༼སྣར། པེ།༽ འདི་ཡིས་"
    },
    {
      "span": {
        "start": 59298,
        "end": 59309
      },
      "text": "འདི་དག་གིས་ ༼སྣར། པེ།༽ འདི་དག་གི་"
    },
    {
      "span": {
        "start": 59314,
        "end": 59316
      },
      "text": "པ་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 59412,
        "end": 59421
      },
      "text": "། །ཞེས་པ་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 59605,
        "end": 59611
      },
      "text": "ངག་གི་ ༼སྣར། པེ།༽ ངག་གིས་"
    },
    {
      "span": {
        "start": 59768,
        "end": 59777
      },
      "text": "ཁ་དོག་དང་ ༼སྣར། པེ།༽ ཁ་དོག་"
    },
    {
      "span": {
        "start": 59863,
        "end": 59869
      },
      "text": "འཕོ་བ་ ༼སྣར། པེ།༽ འཕོ་བར་"
    },
    {
      "span": {
        "start": 59988,
        "end": 59999
      },
      "text": "རགས་པ་བཞིན་ ༼སྣར། པེ།༽ རགས་པའི་གཞན་"
    },
    {
      "span": {
        "start": 60019,
        "end": 60021
      },
      "text": "པ་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 60027,
        "end": 60037
      },
      "text": "འདིའི་དུས་ ༼སྣར། པེ།༽ འདི་དུས་"
    },
    {
      "span": {
        "start": 60209,
        "end": 60218
      },
      "text": "དང་ཁ་དོག་ ༼སྣར། པེ།༽ དང་ཁ་ཏོན་"
    },
    {
      "span": {
        "start": 60242,
        "end": 60247
      },
      "text": "དགོས་ ༼སྣར། པེ།༽ གོས་"
    },
    {
      "span": {
        "start": 60348,
        "end": 60354
      },
      "text": "ངག་གི་ ༼སྣར། པེ།༽ ངག་གིས་"
    },
    {
      "span": {
        "start": 60703,
        "end": 60712
      },
      "text": "ཏིང་འཛིན་ ༼སྣར། པེ།༽ ཏིང་ངེ་འཛིན་"
    },
    {
      "span": {
        "start": 61283,
        "end": 61287
      },
      "text": "ཞེས་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 61550,
        "end": 61554
      },
      "text": "ནུས་ ༼སྣར། པེ།༽ ནི་དུས་"
    },
    {
      "span": {
        "start": 61611,
        "end": 61617
      },
      "text": "ཅེས་པ་ ༼སྣར། པེ།༽ ཅེས་"
    },
    {
      "span": {
        "start": 61870,
        "end": 61878
      },
      "text": "ལྟ་བུའོ་ ༼སྣར། པེ།༽ ལྟ་བུ་"
    },
    {
      "span": {
        "start": 62400,
        "end": 62408
      },
      "text": "བཟློག་པ་ ༼སྣར། པེ།༽ བཟླས་པ་"
    },
    {
      "span": {
        "start": 62694,
        "end": 62702
      },
      "text": "རྒྱས་པར་ ༼སྣར། པེ།༽ རྒྱུད་པར་"
    },
    {
      "span": {
        "start": 63102,
        "end": 63111
      },
      "text": "ཡིད་ཀྱིས་ ༼སྣར། པེ།༽ ཡིད་ཀྱི་"
    },
    {
      "span": {
        "start": 63189,
        "end": 63201
      },
      "text": "རང་བཞིན་གྱི་ ༼སྣར། པེ།༽ རང་བཞིན་གྱིས་"
    },
    {
      "span": {
        "start": 63633,
        "end": 63636
      },
      "text": "སོ། ༼སྣར། པེ།༽ སོ་ཞེ་ན།"
    },
    {
      "span": {
        "start": 63714,
        "end": 63723
      },
      "text": "སྦྱངས་ནས། ༼སྣར། པེ།༽ སྦྱངས་པས།"
    },
    {
      "span": {
        "start": 64560,
        "end": 64563
      },
      "text": "ནི། ༼སྣར། པེ།༽ བཞི།"
    },
    {
      "span": {
        "start": 64760,
        "end": 64766
      },
      "text": "གཞིག ། ༼སྣར། པེ།༽ ཞིག །"
    },
    {
      "span": {
        "start": 64833,
        "end": 64840
      },
      "text": "རྣམ་དག་ ༼སྣར།༽ རྣམས་དང་ ༼པེ།༽ རྣམ་དང་"
    },
    {
      "span": {
        "start": 64889,
        "end": 64902
      },
      "text": "ཀྱིས་གསུངས་པ་ ༼སྣར། པེ།༽ ཀྱི་གསུང་བ་"
    },
    {
      "span": {
        "start": 65474,
        "end": 65481
      },
      "text": "འཇུག་པ་ ༼སྣར། པེ།༽ འཇུག་པར་"
    },
    {
      "span": {
        "start": 66195,
        "end": 66200
      },
      "text": "ཕྱིན་ ༼སྣར། པེ།༽ ཕྱིན་པ་"
    },
    {
      "span": {
        "start": 66368,
        "end": 66375
      },
      "text": "བཞི་པོ་ ༼སྣར། པེ།༽ བཞི་པ་"
    },
    {
      "span": {
        "start": 66435,
        "end": 66443
      },
      "text": "འདི་ཡིས་ ༼སྣར། པེ།༽ འདི་ཡི་"
    },
    {
      "span": {
        "start": 66628,
        "end": 66635
      },
      "text": "ཏིང་ངེ་ ༼སྣར། པེ།༽ ཏིང་"
    },
    {
      "span": {
        "start": 67112,
        "end": 67126
      },
      "text": "ཟུང་དུ་འཇུག་པ་ ༼སྣར། པེ།༽ ཟུང་འཇུག་"
    },
    {
      "span": {
        "start": 67196,
        "end": 67200
      },
      "text": "བཞི་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 67413,
        "end": 67418
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 67516,
        "end": 67526
      },
      "text": "སེམས་ཀྱིས་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 67599,
        "end": 67608
      },
      "text": "ལྟོས་པའི་ ༼སྣར། པེ།༽ བལྟོས་པའི་"
    },
    {
      "span": {
        "start": 67659,
        "end": 67668
      },
      "text": "ལྟོས་པའི་ ༼སྣར། པེ།༽ བལྟོས་པའི་"
    },
    {
      "span": {
        "start": 67824,
        "end": 67828
      },
      "text": "ཚིག་ ༼སྣར། པེ།༽ ཚིམ་"
    },
    {
      "span": {
        "start": 67887,
        "end": 67898
      },
      "text": "ལ་སོགས་པའི་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 67975,
        "end": 67981
      },
      "text": "དག་ནི་ ༼སྣར། པེ།༽ དག་གི་"
    },
    {
      "span": {
        "start": 68215,
        "end": 68223
      },
      "text": "སྤྱོད་པ་ ༼སྣར། པེ།༽ སྤྱོད་པར་"
    },
    {
      "span": {
        "start": 68601,
        "end": 68612
      },
      "text": "གང་ཞིག་གིས་ ༼སྣར། པེ།༽ གང་ཞིག་གི་"
    },
    {
      "span": {
        "start": 68710,
        "end": 68718
      },
      "text": "རྒྱུ་དང་ ༼སྣར། པེ།༽ རྒྱུ་དག་"
    },
    {
      "span": {
        "start": 69633,
        "end": 69637
      },
      "text": "བཞི་ ༼སྡེ།༽ གཞི་"
    },
    {
      "span": {
        "start": 69766,
        "end": 69773
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ བརྟན་པ་"
    },
    {
      "span": {
        "start": 69935,
        "end": 69946
      },
      "text": "ཀྱིས་བརྒྱན། ༼སྣར། པེ།༽ ཀྱི་རྒྱན།"
    },
    {
      "span": {
        "start": 69948,
        "end": 69962
      },
      "text": "སེམས་ཅན་མ་ལུས་ ༼སྣར། པེ།༽ སེམས་ཅན་"
    },
    {
      "span": {
        "start": 70001,
        "end": 70005
      },
      "text": "ཞེས་ ༼སྣར། པེ།༽ ཞེས་བྱ་བ་"
    },
    {
      "span": {
        "start": 70036,
        "end": 70045
      },
      "text": "ཀུན་གྱིས་ ༼སྣར། པེ།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 70096,
        "end": 70107
      },
      "text": "རྒྱལ་བ་ཡིས་ ༼སྣར། པེ།༽ རྒྱལ་བ་ཡི་"
    },
    {
      "span": {
        "start": 70173,
        "end": 70186
      },
      "text": "པར་འཇིག་རྟེན་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 70403,
        "end": 70419
      },
      "text": "འཚལ་བདེ་ཕྱག་འཚལ། ༼སྣར། པེ།༽ འཚལ་ལོ།"
    },
    {
      "span": {
        "start": 70483,
        "end": 70499
      },
      "text": "ཉི་མའི་འོད་ཀྱིས་ ༼སྣར། པེ།༽ ཉི་མས་"
    },
    {
      "span": {
        "start": 70535,
        "end": 70544
      },
      "text": "འོད་ཀྱིས་ ༼སྣར། པེ།༽ འོད་ཀྱི་"
    },
    {
      "span": {
        "start": 70647,
        "end": 70660
      },
      "text": "ཡུན་རིངས་དུས་ ༼སྣར། པེ།༽ ཡུན་རིངས་དུ་"
    },
    {
      "span": {
        "start": 70674,
        "end": 70680
      },
      "text": "བརྙེས་ ༼སྣར། པེ།༽ སྙེམས་"
    },
    {
      "span": {
        "start": 70725,
        "end": 70732
      },
      "text": "ཕོངས་པ་ ༼སྣར། པེ།༽ ཕངས་པ་"
    },
    {
      "span": {
        "start": 70812,
        "end": 70815
      },
      "text": "དག་ ༼སྣར། པེ།༽ བདག་"
    },
    {
      "span": {
        "start": 70944,
        "end": 70959
      },
      "text": "དེ་དག་ཀུན་གྱིས་ ༼སྣར། པེ།༽ དེ་དག་"
    },
    {
      "span": {
        "start": 71040,
        "end": 71048
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 71066,
        "end": 71071
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 71169,
        "end": 71177
      },
      "text": "བརྩམ་པར་ ༼སྣར། པེ།༽ རྩམ་པར་"
    },
    {
      "span": {
        "start": 71226,
        "end": 71231
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ འགྱུར་"
    },
    {
      "span": {
        "start": 71272,
        "end": 71274
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 71298,
        "end": 71302
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 71384,
        "end": 71396
      },
      "text": "གྱུར་ཅིང་། །༼སྣར། པེ།༽ གྱུར་ཅིག །"
    },
    {
      "span": {
        "start": 71402,
        "end": 71408
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 71411,
        "end": 71420
      },
      "text": "ཀུན་གྱིས་ ༼སྣར། པེ།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 71493,
        "end": 71501
      },
      "text": "འགྲེལ་པ་ ༼སྣར།༽ འབྲེལ་པ་"
    }
  ]
}