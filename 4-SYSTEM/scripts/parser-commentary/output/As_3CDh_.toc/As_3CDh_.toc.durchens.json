{
  "durchens": [
    {
      "span": {
        "start": 167,
        "end": 173
      },
      "text": "ཡང་དག་ ༼སྣར། པེ།༽ ཡང་དག་པར་"
    },
    {
      "span": {
        "start": 212,
        "end": 218
      },
      "text": "རིག་པ་ ༼སྣར། པེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 449,
        "end": 453
      },
      "text": "ཐོབ་ ༼སྣར། པེ།༽ འཐོབ་"
    },
    {
      "span": {
        "start": 658,
        "end": 662
      },
      "text": "ཡིན་ ༼སྣར།༽ མིན་"
    },
    {
      "span": {
        "start": 992,
        "end": 1000
      },
      "text": "སྤོངས་པ་ ༼སྣར། པེ།༽ སྤོང་བ་"
    },
    {
      "span": {
        "start": 1291,
        "end": 1296
      },
      "text": "བྱའོ། ༼སྣར། པེ།༽ བྱ་བའོ།"
    },
    {
      "span": {
        "start": 1475,
        "end": 1485
      },
      "text": "ཁྱད་པར་དུ་ ༼སྣར། པེ།༽ ཁྱད་པར་"
    },
    {
      "span": {
        "start": 1516,
        "end": 1525
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    }
  ]
}