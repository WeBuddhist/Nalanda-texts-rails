{
  "durchens": [
    {
      "span": {
        "start": 272,
        "end": 280
      },
      "text": "བཀླགས་པ་ ༼པེ།༽ ཀླགས་པ་"
    },
    {
      "span": {
        "start": 573,
        "end": 580
      },
      "text": "ཅན་གྱི་ ༼པེ།༽ ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 1058,
        "end": 1065
      },
      "text": "ཤེས་རབ་ ༼སྣར། པེ།༽ ཤེས་རབ་དང་ཤེས་རབ་"
    },
    {
      "span": {
        "start": 1350,
        "end": 1355
      },
      "text": "བྱ་བ་ ༼པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 1388,
        "end": 1403
      },
      "text": "གཉིས་པོ་ནི་ཚིག་ ༼སྣར། པེ།༽ གཉིས་པོ་"
    },
    {
      "span": {
        "start": 1472,
        "end": 1478
      },
      "text": "སྒྲུབ་ ༼སྣར།༽ བསྒྲུབ་"
    },
    {
      "span": {
        "start": 1492,
        "end": 1499
      },
      "text": "བདག་གི་ ༼སྣར། པེ།༽ བདག་གིས་"
    },
    {
      "span": {
        "start": 2333,
        "end": 2343
      },
      "text": "དེ་དག་ཀྱང་ ༼སྣར། པེ།༽ དེ་དག་ཡང་"
    },
    {
      "span": {
        "start": 2899,
        "end": 2904
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ ནམ་"
    },
    {
      "span": {
        "start": 3116,
        "end": 3122
      },
      "text": "བཞུགས་ ༼སྣར། པེ།༽ བཞུགས་པས་"
    },
    {
      "span": {
        "start": 3841,
        "end": 3846
      },
      "text": "འཛིན་ ༼སྣར། པེ།༽ འཛིན་འཛིན་"
    },
    {
      "span": {
        "start": 3851,
        "end": 3858
      },
      "text": "ཞུགས་པ་ ༼སྣར། པེ།༽ བཞུགས་པ་"
    },
    {
      "span": {
        "start": 4310,
        "end": 4319
      },
      "text": "དེ་ནས་ནི་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 4458,
        "end": 4463
      },
      "text": "སྐྱེ་ ༼སྣར། པེ།༽ སྐྱེས་"
    },
    {
      "span": {
        "start": 4818,
        "end": 4827
      },
      "text": "སྟོན་པའི་ ༼སྣར། པེ།༽ སྟོང་པའི་"
    },
    {
      "span": {
        "start": 4888,
        "end": 4897
      },
      "text": "སྲུང་བའི་ ༼སྣར། པེ།༽ བསྲུང་བའི་"
    },
    {
      "span": {
        "start": 4905,
        "end": 4910
      },
      "text": "མདུན་ ༼སྣར། པེ།༽ བདུན་"
    },
    {
      "span": {
        "start": 5022,
        "end": 5031
      },
      "text": "ཚོགས་པ་ལ་ ༼སྣར། པེ།༽ ཚོགས་པ་"
    },
    {
      "span": {
        "start": 5232,
        "end": 5241
      },
      "text": "རྣམས་ཉིད་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 5462,
        "end": 5469
      },
      "text": "ཞུགས་པ་ ༼སྣར། པེ།༽ བཞུགས་པ་"
    },
    {
      "span": {
        "start": 5547,
        "end": 5556
      },
      "text": "གསུམ་གྱི་ ༼པེ།༽ གསུམ་གྱིས་"
    },
    {
      "span": {
        "start": 5815,
        "end": 5822
      },
      "text": "དབྱེ་བ་ ༼སྣར། པེ།༽ བདེ་བ་"
    },
    {
      "span": {
        "start": 6238,
        "end": 6245
      },
      "text": "འཛིན་པ་ ༼སྣར། པེ།༽ འཛིན་"
    },
    {
      "span": {
        "start": 6477,
        "end": 6483
      },
      "text": "དེ་ནི་ ༼པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 6550,
        "end": 6555
      },
      "text": "སྲོག་ ༼སྡེ།༽ སོག་"
    },
    {
      "span": {
        "start": 6701,
        "end": 6713
      },
      "text": "གནས་པ་ཞེས་པ་ ༼སྣར། པེ།༽ གནས་པ་ཞེས་"
    },
    {
      "span": {
        "start": 6902,
        "end": 6912
      },
      "text": "མཐོང་བ་ནི་ ༼སྣར། པེ།༽ མཐོང་བ་"
    },
    {
      "span": {
        "start": 6991,
        "end": 6996
      },
      "text": "བརླབ་ ༼པེ།༽ རླབ་"
    },
    {
      "span": {
        "start": 7034,
        "end": 7044
      },
      "text": "མཐར་ཐུག་པ་ ༼སྣར། པེ།༽ མཐར་ཐུག་པར་"
    },
    {
      "span": {
        "start": 7143,
        "end": 7150
      },
      "text": "སྟོང་པ་ ༼སྣར། པེ།༽ སྟོང་"
    },
    {
      "span": {
        "start": 7160,
        "end": 7170
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ སྒོམ་པའི་"
    },
    {
      "span": {
        "start": 7236,
        "end": 7244
      },
      "text": "བསྒོམ་པ་ ༼སྡེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 7302,
        "end": 7308
      },
      "text": "རྣམ་པ་ ༼སྣར། པེ།༽ རྣམ་པར་"
    },
    {
      "span": {
        "start": 7483,
        "end": 7491
      },
      "text": "འགེགས་པ་ ༼སྣར། པེ།༽ འགོག་པ་"
    },
    {
      "span": {
        "start": 7568,
        "end": 7570
      },
      "text": "པ་ ༼ཅོ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 7985,
        "end": 7994
      },
      "text": "དོན་གྱིས་ ༼སྣར། པེ།༽ དོན་གྱི་"
    },
    {
      "span": {
        "start": 7997,
        "end": 8005
      },
      "text": "བསྒོམ་པ་ ༼སྣར། པེ།༽ བསྒོམས་པ་"
    },
    {
      "span": {
        "start": 8046,
        "end": 8059
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 8229,
        "end": 8239
      },
      "text": "ཐུགས་ཀྱིས་ ༼སྣར། པེ།༽ ཐུགས་ཀྱི་"
    },
    {
      "span": {
        "start": 8277,
        "end": 8286
      },
      "text": "མཛད་ཀྱིས་ ༼སྣར། པེ།༽ མཛད་ཀྱི་"
    },
    {
      "span": {
        "start": 8393,
        "end": 8405
      },
      "text": "གསུམ་པོ་རྣམ་ ༼སྣར། པེ།༽ གསུམ་"
    },
    {
      "span": {
        "start": 8405,
        "end": 8407
      },
      "text": "པ་ ༼སྣར། པེ།༽ པ་རྣམས་"
    },
    {
      "span": {
        "start": 9042,
        "end": 9045
      },
      "text": "དེ། ༼སྣར། པེ།༽ དོ། །"
    },
    {
      "span": {
        "start": 9242,
        "end": 9249
      },
      "text": "བཀོད་པ་ ༼པེ།༽ དཀོད་པ་"
    },
    {
      "span": {
        "start": 9520,
        "end": 9526
      },
      "text": "བྱས་པ་ ༼པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 9608,
        "end": 9613
      },
      "text": "བཟངས་ ༼སྣར། པེ།༽ བཟང་"
    },
    {
      "span": {
        "start": 10001,
        "end": 10012
      },
      "text": "ཆེན་པོའོ། ། ༼པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 10244,
        "end": 10255
      },
      "text": "རྣམས་ལ་ངེས་ ༼སྣར། པེ།༽ རྣམས་ལངས་"
    },
    {
      "span": {
        "start": 10422,
        "end": 10429
      },
      "text": "བྱེད་པ་ ༼སྣར། པེ།༽ བྱེད་པར་"
    },
    {
      "span": {
        "start": 10570,
        "end": 10575
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ གསུམ་པོ་"
    },
    {
      "span": {
        "start": 10858,
        "end": 10863
      },
      "text": "བཤད་དོ། ། ^a-3 ༼སྣར། པེ།༽ བཤད་དེ་"
    },
    {
      "span": {
        "start": 10918,
        "end": 10925
      },
      "text": "ཆོས་ཅན་ ༼སྣར། པེ།༽ ཆོས་"
    },
    {
      "span": {
        "start": 11475,
        "end": 11479
      },
      "text": "པའོ། ༼སྣར། པེ།༽ ལའོ།"
    },
    {
      "span": {
        "start": 11813,
        "end": 11822
      },
      "text": "སྔགས་ཀྱི་ ༼པེ།༽ སྔགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 11869,
        "end": 11876
      },
      "text": "ཉིད་དོ། ༼སྣར། པེ།༽ ཉིད་དེ།"
    },
    {
      "span": {
        "start": 12653,
        "end": 12667
      },
      "text": "ཡེ་ཤེས་སོ་ཞེས་ ༼སྣར། པེ།༽ ཡེ་ཤེས་"
    },
    {
      "span": {
        "start": 12850,
        "end": 12856
      },
      "text": "སོ་སོ་ ༼སྣར། པེ།༽ སོ་སོར་"
    },
    {
      "span": {
        "start": 12917,
        "end": 12924
      },
      "text": "བྱ་བའོ། ༼པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 12934,
        "end": 12940
      },
      "text": "སོ་སོ་ ༼སྣར། པེ།༽ སོ་སོར་"
    },
    {
      "span": {
        "start": 12983,
        "end": 12990
      },
      "text": "རིམ་པར་ ༼སྣར། པེ།༽ རིམ་པ་"
    },
    {
      "span": {
        "start": 13823,
        "end": 13834
      },
      "text": "འདོད་པ་ཅིག་ ༼སྣར། པེ།༽ འདོད་པ་གཅིག་"
    },
    {
      "span": {
        "start": 13953,
        "end": 13963
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 14077,
        "end": 14112
      },
      "text": "སྣ་ཚོགས་པའི་དགའ་བས་གདུལ་བྱ་སྣ་ཚོགས་ ༼པེ།༽ སྣ་ཚོགས་"
    },
    {
      "span": {
        "start": 14214,
        "end": 14223
      },
      "text": "སྔགས་ཀྱི་ ༼སྣར། པེ།༽ སྔགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 14282,
        "end": 14289
      },
      "text": "སྤེལ་བ་ ༼སྣར། པེ།༽ སྤེལ་"
    },
    {
      "span": {
        "start": 14401,
        "end": 14409
      },
      "text": "གོ་རིམས་ ༼སྣར། པེ།༽ གོ་རིམ་"
    },
    {
      "span": {
        "start": 14496,
        "end": 14501
      },
      "text": "རང་བཞིན་ནོ། ། ^a-4 ༼པེ།༽ རང་བཞིན་"
    },
    {
      "span": {
        "start": 14676,
        "end": 14685
      },
      "text": "མཛེས་ཀྱི་ ༼སྣར། པེ།༽ མཛེས་"
    },
    {
      "span": {
        "start": 14782,
        "end": 14794
      },
      "text": "གི་ཞེས་བྱ་བ་ ༼སྣར། པེ།༽ གི་ཞེས་པ་"
    },
    {
      "span": {
        "start": 15602,
        "end": 15611
      },
      "text": "སྲུང་བའི་ ༼སྣར།༽ བསྲུང་བའི་ ༼པེ།༽ གསུང་བའི་"
    },
    {
      "span": {
        "start": 15846,
        "end": 15861
      },
      "text": "རྣམས་ཀྱི་རིམ་པ་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 15871,
        "end": 15875
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱི་རིམ་པ་"
    },
    {
      "span": {
        "start": 16344,
        "end": 16353
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 16455,
        "end": 16460
      },
      "text": "བཀོད་ ༼པེ།༽ དཀོད་"
    },
    {
      "span": {
        "start": 17122,
        "end": 17125
      },
      "text": "ནི་ ༼པེ།༽ ན་"
    },
    {
      "span": {
        "start": 17316,
        "end": 17324
      },
      "text": "ཨོཾ་གྱི་ ༼སྣར། པེ།༽ ཨོཾ་གྱིས་"
    },
    {
      "span": {
        "start": 17398,
        "end": 17405
      },
      "text": "བླངས་ན་ ༼སྣར། པེ།༽ བླངས་ནས་"
    },
    {
      "span": {
        "start": 17512,
        "end": 17519
      },
      "text": "བསྒོམས་ ༼པེ།༽ བསྒོམ་"
    },
    {
      "span": {
        "start": 17601,
        "end": 17610
      },
