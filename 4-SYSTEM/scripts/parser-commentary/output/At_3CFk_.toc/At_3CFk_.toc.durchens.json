{
  "durchens": [
    {
      "span": {
        "start": 30,
        "end": 33
      },
      "text": "ཏི་ ༼སྣར། པེ།༽ ཏ་"
    },
    {
      "span": {
        "start": 926,
        "end": 931
      },
      "text": "དེའི་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 1312,
        "end": 1316
      },
      "text": "པ་ལ། ༼སྣར། པེ།༽ པའོ། །"
    },
    {
      "span": {
        "start": 1824,
        "end": 1831
      },
      "text": "སྣང་ཡང་ ༼སྣར། པེ།༽ སྣང་བའང་"
    },
    {
      "span": {
        "start": 1938,
        "end": 1945
      },
      "text": "དཀྲུགས་ ༼པེ།༽ དཀྲུག་"
    },
    {
      "span": {
        "start": 2292,
        "end": 2297
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 2861,
        "end": 2866
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 3115,
        "end": 3128
      },
      "text": "འོད་གསལ་གྱིས་ ༼སྣར། པེ།༽ འོད་ཀྱི་"
    },
    {
      "span": {
        "start": 4454,
        "end": 4457
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 4610,
        "end": 4620
      },
      "text": "བསྲེགས་པས་ ༼སྣར། པེ།༽ བསྲེག་པས་"
    },
    {
      "span": {
        "start": 5296,
        "end": 5309
      },
      "text": "ཁོ་ན་ཉིད་ཀྱི་ ༼སྣར། པེ།༽ ཁོ་ན་"
    },
    {
      "span": {
        "start": 5458,
        "end": 5466
      },
      "text": "དགོས་པས་ ༼སྣར།༽ དགོས་པར་"
    },
    {
      "span": {
        "start": 5696,
        "end": 5703
      },
      "text": "རིགས་ལ་ ༼སྣར།༽ རིགས་"
    },
    {
      "span": {
        "start": 5863,
        "end": 5866
      },
      "text": "པས་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 5967,
        "end": 5974
      },
      "text": "མེ་ལོང་ ༼སྣར། པེ།༽ མེད་ང་"
    },
    {
      "span": {
        "start": 6900,
        "end": 6906
      },
      "text": "བདེ་བ་ ༼སྣར། པེ།༽ བདེ་"
    }
  ]
}