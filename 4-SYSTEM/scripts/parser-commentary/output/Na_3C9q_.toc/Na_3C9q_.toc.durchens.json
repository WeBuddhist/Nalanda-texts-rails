{
  "durchens": [
    {
      "span": {
        "start": 568,
        "end": 573
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 708,
        "end": 716
      },
      "text": "ལམ་གྱིས་ ༼སྣར། པེ།༽ ལམ་གྱི་"
    },
    {
      "span": {
        "start": 744,
        "end": 752
      },
      "text": "ངོ་བོའི་ ༼སྣར། པེ།༽ ངོ་བོ་"
    },
    {
      "span": {
        "start": 786,
        "end": 792
      },
      "text": "གསུང་། ༼ཅོ།༽ གསུངས།"
    },
    {
      "span": {
        "start": 843,
        "end": 849
      },
      "text": "འཐོམས་ ༼སྣར། པེ།༽ འཐོབས་"
    },
    {
      "span": {
        "start": 887,
        "end": 897
      },
      "text": "སྒྲོན་མེས་ ༼སྣར།༽ སྒྲོལ་མ་ ༼པེ།༽ སྒྲོན་མ་"
    },
    {
      "span": {
        "start": 978,
        "end": 983
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིས་"
    },
    {
      "span": {
        "start": 1154,
        "end": 1162
      },
      "text": "རྡུལ་དང་ ༼སྣར། པེ།༽ རྡུལ་"
    },
    {
      "span": {
        "start": 1218,
        "end": 1227
      },
      "text": "བསྒོམ་པས་ ༼སྣར། པེ།༽ སྒོམ་པར་"
    },
    {
      "span": {
        "start": 1397,
        "end": 1409
      },
      "text": "ཉོན་མོངས་དང་ ༼སྣར། པེ།༽ ཉོན་མོངས་"
    },
    {
      "span": {
        "start": 1416,
        "end": 1427
      },
      "text": "ཉོན་མོངས་པ་ ༼སྣར། པེ།༽ ཉོན་མོངས་"
    },
    {
      "span": {
        "start": 1449,
        "end": 1459
      },
      "text": "སྒྲོན་མེས་ ༼སྣར། པེ།༽ སྒྲོན་མ་"
    },
    {
      "span": {
        "start": 1869,
        "end": 1876
      },
      "text": "བཏུད་པ་ ༼སྣར། པེ།༽ འདུས་པ་"
    },
    {
      "span": {
        "start": 2217,
        "end": 2222
      },
      "text": "ཆེའི་ ༼སྣར། པེ།༽ ཆེ་"
    },
    {
      "span": {
        "start": 2317,
        "end": 2327
      },
      "text": "ཀུན་ལྡན་པ་ ༼སྣར། པེ།༽ ཀུན་ལྡན་པའི་"
    },
    {
      "span": {
        "start": 2675,
        "end": 2682
      },
      "text": "སོགས་པ་ ༼སྣར། པེ།༽ གསོག་པ་"
    },
    {
      "span": {
        "start": 2738,
        "end": 2740
      },
      "text": "ན། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 2786,
        "end": 2792
      },
      "text": "རྒྱུད་ ༼སྣར། པེ།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 2809,
        "end": 2821
      },
      "text": "སེམས་བསྐྱེད་ ༼སྣར། པེ།༽ སེམས་"
    },
    {
      "span": {
        "start": 3082,
        "end": 3093
      },
      "text": "བྱིན་བརླབས་ ༼སྣར། པེ།༽ བྱིན་རླབས་"
    },
    {
      "span": {
        "start": 3121,
        "end": 3129
      },
      "text": "བསྒོམ་པ་ ༼སྣར། པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 3178,
        "end": 3187
      },
      "text": "སྔགས་མིག་ ༼སྣར། པེ།༽ སྡང་མིག་"
    },
    {
      "span": {
        "start": 3337,
        "end": 3345
      },
      "text": "སྦྱོང་བ་ ༼སྣར། པེ།༽ སོང་བ་"
    },
    {
      "span": {
        "start": 3619,
        "end": 3624
      },
      "text": "དབུབ། ༼སྣར། པེ།༽ དབུལ།"
    },
    {
      "span": {
        "start": 3649,
        "end": 3655
      },
      "text": "རཾ་ཡང་ ༼སྣར། པེ།༽ རཾ་དང་"
    },
    {
      "span": {
        "start": 3892,
        "end": 3899
      },
      "text": "དྲུག་པ་ ༼སྣར། པེ།༽ གྲུབ་པ་"
    },
    {
      "span": {
        "start": 4065,
        "end": 4072
      },
      "text": "གྲུབ་པ་ ༼སྣར། པེ།༽ གྲུབ་"
    },
    {
      "span": {
        "start": 4127,
        "end": 4129
      },
      "text": "ཨ། ༼སྣར། པེ།༽ ཨཱ།"
    },
    {
      "span": {
        "start": 4131,
        "end": 4141
      },
      "text": "སྙིང་རྗེས་ ༼སྣར། པེ།༽ སྙིང་རྗེ་"
    },
    {
      "span": {
        "start": 4198,
        "end": 4205
      },
      "text": "གསོས་པ་ ༼སྣར། པེ།༽ གསོ་བ་"
    },
    {
      "span": {
        "start": 4356,
        "end": 4360
      },
      "text": "གཞི་ ༼སྣར།༽ བཞི་"
    },
    {
      "span": {
        "start": 4368,
        "end": 4377
      },
      "text": "གསོད་པའི་ ༼སྣར། པེ།༽ བསད་པའི་"
    },
    {
      "span": {
        "start": 4900,
        "end": 4905
      },
      "text": "བྱུང་ ༼སྣར།༽ བྱུང་བ་"
    },
    {
      "span": {
        "start": 5550,
        "end": 5558
      },
      "text": "ཆེན་པོར་ ༼སྣར།༽ ཆེན་པོའི་"
    },
    {
      "span": {
        "start": 5768,
        "end": 5776
      },
      "text": "ཕྱིར་མི་ ༼སྣར། པེ།༽ ཕྱི་མི་"
    },
    {
      "span": {
        "start": 5901,
        "end": 5912
      },
      "text": "ཁྱད་པར་གྱི་ ༼སྣར། པེ།༽ ཁྱད་པར་"
    },
    {
      "span": {
        "start": 5912,
        "end": 5916
      },
      "text": "དོན་ ༼སྣར། པེ།༽ དོན་ནོ། །"
    },
    {
      "span": {
        "start": 5998,
        "end": 6007
      },
      "text": "ལས་འདའ་བ་ ༼སྣར། པེ།༽ ལས་མི་འདའ་ཡང་"
    },
    {
      "span": {
        "start": 6705,
        "end": 6709
      },
      "text": "པའི་ ༼སྣར། པེ།༽ པའོ། །"
    },
    {
      "span": {
        "start": 6845,
        "end": 6856
      },
      "text": "ནང་སེམས་ཅན་ ༼སྣར། པེ།༽ ནང་སེམས་ཅན་ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 6903,
        "end": 6913
      },
      "text": "གཟུང་བ་དང་ ༼སྣར། པེ།༽ གཟུང་བ་"
    },
    {
      "span": {
        "start": 6922,
        "end": 6929
      },
      "text": "རྟོག་པ་ ༼སྣར།༽ རྟོག་པའི་ཆོས་ ༼པེ།༽ རྟོག་པ་ཆོས་"
    },
    {
      "span": {
        "start": 7470,
        "end": 7475
      },
      "text": "བྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 7822,
        "end": 7828
      },
      "text": "གཞག་པ་ ༼སྣར། པེ།༽ བཞག་པ་"
    },
    {
      "span": {
        "start": 7835,
        "end": 7839
      },
      "text": "ལྡན། ༼སྣར། པེ།༽ ལྡན་པའོ།"
    },
    {
      "span": {
        "start": 7880,
        "end": 7884
      },
      "text": "ལྡན། ༼སྣར། པེ།༽ ལྡན་པ།"
    },
    {
      "span": {
        "start": 8210,
        "end": 8216
      },
      "text": "སྤང་བ་ ༼སྣར། པེ།༽ སྤོང་བ་"
    },
    {
      "span": {
        "start": 8235,
        "end": 8239
      },
      "text": "ཕྱི་ ༼སྣར། པེ།༽ ཕྱི་དང་"
    },
    {
      "span": {
        "start": 8410,
        "end": 8416
      },
      "text": "སྤྲིན་ ༼སྣར། པེ།༽ སྲིན་པོ་"
    },
    {
      "span": {
        "start": 8446,
        "end": 8454
      },
      "text": "ཅེ་སྤྱང་ ༼པེ།༽ ལྕེ་སྤྱང་"
    },
    {
      "span": {
        "start": 8492,
        "end": 8499
      },
      "text": "རྣམ་པར་ ༼སྣར། པེ།༽ རྣམ་པ་"
    },
    {
      "span": {
        "start": 8544,
        "end": 8548
      },
      "text": "བའི་ ༼སྣར། པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 8578,
        "end": 8592
      },
      "text": "འཁོར་ལོ་དང་། ། ༼སྣར། པེ།༽ འཁོར་ལོ་"
    },
    {
      "span": {
        "start": 8595,
        "end": 8598
      },
      "text": "ཟླ་ ༼སྣར། པེ།༽ ཟླའི་"
    },
    {
      "span": {
        "start": 8771,
        "end": 8780
      },
      "text": "རྡོ་རྗེར་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 9069,
        "end": 9077
      },
      "text": "མཐོང་བས་ ༼སྣར། པེ།༽ མཐོང་བ་"
    },
    {
      "span": {
        "start": 9086,
        "end": 9095
      },
      "text": "བསྒོམ་པས་ ༼སྣར། པེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 9183,
        "end": 9193
      },
      "text": "རིགས་ལྔའི་ ༼སྣར། པེ།༽ རིག་ལྔ་"
    },
    {
      "span": {
        "start": 9302,
        "end": 9311
      },
      "text": "མཆོག་ཀྱང་ ༼སྣར། པེ།༽ མཆོག་ཡང་"
    },
    {
      "span": {
        "start": 9402,
        "end": 9411
      },
      "text": "དཔའ་བོའི་ ༼སྣར། པེ།༽ དཔའ་བོ་"
    },
    {
      "span": {
        "start": 9506,
        "end": 9511
      },
      "text": "ལྔའི་ ༼སྣར། པེ།༽ ལྔ་"
    },
    {
      "span": {
        "start": 9600,
        "end": 9609
      },
      "text": "གནས་པ་ནི་ ༼སྣར། པེ།༽ གནས་པ་"
    },
    {
      "span": {
        "start": 9876,
        "end": 9885
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 9930,
        "end": 9939
      },
      "text": "མཆོག་ཀྱང་ ༼སྣར། པེ།༽ མཆོག་ཡང་"
    },
    {
      "span": {
        "start": 10055,
        "end": 10066
      },
      "text": "རྗེའུ་རིགས་ ༼སྣར། པེ།༽ རྗེ་རིགས་"
    },
    {
      "span": {
        "start": 10279,
        "end": 10292
      },
      "text": "ཉོན་མོངས་པའི་ ༼སྣར། པེ།༽ ཉོན་མོངས་པ་"
    },
    {
      "span": {
        "start": 10299,
        "end": 10305
      },
      "text": "མཇོམས་ ༼སྣར། པེ།༽ འཇོམ་"
    },
    {
      "span": {
        "start": 10319,
        "end": 10328
      },
      "text": "དཔའ་བོའི་ ༼སྣར། པེ།༽ དཔའ་བོ་"
    },
    {
      "span": {
        "start": 10525,
        "end": 10533
      },
      "text": "རང་བཞིན་ ༼སྣར། པེ།༽ རང་བཞིན་ནི་"
    },
    {
      "span": {
        "start": 10748,
        "end": 10760
      },
      "text": "འོག་མིན་གྱི་ ༼སྣར། པེ།༽ འོག་མིན་"
    },
    {
      "span": {
        "start": 11002,
        "end": 11011
      },
      "text": "འགྱུར་རོ། ༼སྣར། པེ།༽ འབྱུང་ངོ་།"
    },
    {
      "span": {
        "start": 11109,
        "end": 11125
      },
      "text": "མཆོད་པ་ཡིད་ཀྱིས་ ༼སྣར། པེ།༽ མཆོད་པ་བཞིན་"
    },
    {
      "span": {
        "start": 11143,
        "end": 11148
      },
      "text": "མཆོད་ ༼སྣར། པེ།༽ མཆོད་པ་དང་སྨན་གྱིས་མཆོད་"
    },
    {
      "span": {
        "start": 11384,
        "end": 11393
      },
      "text": "སྐུ་གསུང་ ༼སྣར། པེ།༽ སྐུ་གསུམ་"
    },
    {
      "span": {
        "start": 11481,
        "end": 11488
      },
      "text": "བསྲེགས་ ༼སྣར། པེ།༽ བསྲེག་"
    },
    {
      "span": {
        "start": 11491,
        "end": 11499
      },
      "text": "སྦྱོང་བ་ ༼སྣར། པེ།༽ སྦྱང་བ་"
    },
    {
      "span": {
        "start": 11646,
        "end": 11651
      },
      "text": "བྱུང་ ༼སྣར།༽ ཕྱུང་"
    },
    {
      "span": {
        "start": 11700,
        "end": 11709
      },
      "text": "ཡིག་འབྲུ་ ༼སྣར། པེ།༽ ཡིག་འབྲུ་སྟེ་"
    },
    {
      "span": {
        "start": 11844,
        "end": 11848
      },
      "text": "བའོ། ༼པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 11980,
        "end": 11987
      },
      "text": "བསྟིམས་ ༼སྣར། པེ།༽ བསྟིམ་"
    },
    {
      "span": {
        "start": 12005,
        "end": 12009
      },
      "text": "ལྔས་ ༼སྣར། པེ།༽ ལྔ་"
    },
    {
      "span": {
        "start": 12030,
        "end": 12036
      },
      "text": "བསྐུར་ ༼སྣར། པེ།༽ སྐུར་"
    },
    {
      "span": {
        "start": 12101,
        "end": 12108
      },
      "text": "བྱ་བའི་ ༼སྣར། པེ།༽ བྱ་བ་ནི་"
    },
    {
      "span": {
        "start": 12135,
        "end": 12142
      },
      "text": "བྱས་ཏེ་ ༼སྣར། པེ།༽ བྱ་སྟེ་"
    },
    {
      "span": {
        "start": 12157,
        "end": 12166
      },
      "text": "རིག་སྔགས་ ༼སྣར། པེ།༽ རིགས་ལྔ་"
    },
    {
      "span": {
        "start": 12268,
        "end": 12274
      },
      "text": "བསྐུར་ ༼སྣར།༽ བཀུར་"
    },
    {
      "span": {
        "start": 12520,
        "end": 12526
      },
      "text": "སོ་སོ་ ༼སྣར། པེ།༽ སོ་སོར་"
    },
    {
      "span": {
        "start": 12553,
        "end": 12563
      },
      "text": "དྲིལ་བུའི་ ༼སྣར། པེ།༽ དྲིལ་བུ་"
    },
    {
      "span": {
        "start": 12749,
        "end": 12758
      },
      "text": "རིགས་ལྔས་ ༼སྣར། པེ།༽ རིག་སྔགས་"
    },
    {
      "span": {
        "start": 12821,
        "end": 12827
      },
      "text": "སྦྱང་། ༼སྣར། པེ།༽ སྦྱོང་།"
    },
    {
      "span": {
        "start": 13089,
        "end": 13098
      },
      "text": "རྡོ་རྗེར་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 13309,
        "end": 13314
      },
      "text": "དག་པ་ ༼སྣར། པེ།༽ དགའ་བ་"
    },
    {
      "span": {
        "start": 13459,
        "end": 13464
      },
      "text": "སྔགས་ ༼སྣར། པེ།༽ བསྔགས་"
    },
    {
      "span": {
        "start": 13481,
        "end": 13490
      },
      "text": "རྣམ་གཉིས་ ༼པེ།༽ རྣམས་ཉིས་"
    },
    {
      "span": {
        "start": 13497,
        "end": 13500
      },
      "text": "ཕྲ། ༼པེ།༽ ཕྲག།"
    },
    {
      "span": {
        "start": 13584,
        "end": 13586
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 13671,
        "end": 13678
      },
      "text": "བརྩེགས་ ༼སྣར། པེ།༽ རྩེགས་"
    },
    {
      "span": {
        "start": 13961,
        "end": 13967
      },
      "text": "བསྐུལ་ ༼སྣར། པེ།༽ སྐུལ་"
    },
    {
      "span": {
        "start": 13986,
        "end": 13993
      },
      "text": "ལྟེ་བར་ ༼སྣར། པེ།༽ ལྟེ་བ་"
    },
    {
      "span": {
        "start": 14008,
        "end": 14012
      },
      "text": "ཨ། ། ༼སྣར། པེ།༽ ཨཱ་"
    },
    {
      "span": {
        "start": 14027,
        "end": 14037
      },
      "text": "སྦྱོང་བའི་ ༼སྣར། པེ།༽ སྦྱང་བའི་"
    },
    {
      "span": {
        "start": 14173,
        "end": 14177
      },
      "text": "ཡིད་ ༼སྣར། པེ།༽ ཡིད་ཀྱི་འོད་"
    },
    {
      "span": {
        "start": 14326,
        "end": 14333
      },
      "text": "ལྟེ་བར་ ༼སྣར། པེ།༽ ལྟེ་བ་"
    },
    {
      "span": {
        "start": 14590,
        "end": 14597
      },
      "text": "འཐུང་བ་ ༼སྣར། པེ།༽ འཐུང་"
    },
    {
      "span": {
        "start": 14733,
        "end": 14738
      },
      "text": "ཡོངས་ ༼སྣར། པེ།༽ ཡོ་"
    },
    {
      "span": {
        "start": 14828,
        "end": 14834
      },
      "text": "བསྐུལ་ ༼སྣར། པེ།༽ སྐུལ་"
    },
    {
      "span": {
        "start": 15337,
        "end": 15341
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིར་"
    },
    {
      "span": {
        "start": 15372,
        "end": 15386
      },
      "text": "སྙིང་གར་བསྐོར་ ༼སྣར། པེ།༽ སྙིང་ག་སྐོར་"
    },
    {
      "span": {
        "start": 15659,
        "end": 15667
      },
      "text": "བསྐོར་བ་ ༼སྣར། པེ།༽ སྐོར་བ་"
    },
    {
      "span": {
        "start": 15879,
        "end": 15884
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབ་"
    },
    {
      "span": {
        "start": 16045,
        "end": 16061
      },
      "text": "ཞེས་པ་ནི་བསྒྲུབ་ ༼སྣར། པེ།༽ ཞེས་པ་སྒྲུབ་"
    },
    {
      "span": {
        "start": 16068,
        "end": 16073
      },
      "text": "སྟོན་ ༼པེ།༽ བསྟོན་"
    },
    {
      "span": {
        "start": 16105,
        "end": 16110
      },
      "text": "དགུག་ ༼སྣར། པེ།༽ བཀུག་"
    },
    {
      "span": {
        "start": 16429,
        "end": 16436
      },
      "text": "དོན་ཏོ། ༼སྣར། པེ།༽ དོན་ཏེ།"
    },
    {
      "span": {
        "start": 16451,
        "end": 16462
      },
      "text": "བརྩེགས་ཀྱི་ ༼སྣར། པེ།༽ རྩེག་གི་"
    },
    {
      "span": {
        "start": 16466,
        "end": 16472
      },
      "text": "རྗེའི་ ༼སྣར། པེ།༽ རྗེ་"
    },
    {
      "span": {
        "start": 16814,
        "end": 16819
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ གཉིས་ཀྱིས་"
    },
    {
      "span": {
        "start": 16914,
        "end": 16918
      },
      "text": "རིང་ ༼སྣར། པེ།༽ རིངས་"
    },
    {
      "span": {
        "start": 17283,
        "end": 17289
      },
      "text": "བཞིའི་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 17346,
        "end": 17355
      },
      "text": "སྒྲོལ་བར་ ༼སྣར། པེ།༽ སྲུན་པར་"
    },
    {
      "span": {
        "start": 17492,
        "end": 17502
      },
      "text": "སྔགས་རྣམས་ ༼སྣར། པེ།༽ སྔགས་"
    },
    {
      "span": {
        "start": 17780,
        "end": 17788
      },
      "text": "ཉི་ཟླའི་ ༼སྣར། པེ།༽ ཉི་ཟླ་"
    },
    {
      "span": {
        "start": 17815,
        "end": 17822
      },
      "text": "སྡིག་པ་ ༼སྣར། པེ།༽ སྡིག་"
    },
    {
      "span": {
        "start": 17844,
        "end": 17847
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 18019,
        "end": 18027
      },
      "text": "གཞའ་ཚོན་ ༼སྣར།༽ འཇའ་ཚོན་"
    },
    {
      "span": {
        "start": 18137,
        "end": 18145
      },
      "text": "མང་པོའི་ ༼སྣར། པེ།༽ མང་བའི་"
    },
    {
      "span": {
        "start": 18245,
        "end": 18250
      },
      "text": "བྱུང་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 18264,
        "end": 18273
      },
      "text": "དངོས་པོར་ ༼སྣར། པེ།༽ དངོས་པོ་"
    },
    {
      "span": {
        "start": 18357,
        "end": 18364
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 18414,
        "end": 18418
      },
      "text": "གཉི་ ༼སྣར། པེ།༽ ཉི་"
    },
    {
      "span": {
        "start": 18464,
        "end": 18470
      },
      "text": "རྟོགས་ ༼སྣར། པེ།༽ རྟོག་"
    },
    {
      "span": {
        "start": 18549,
        "end": 18558
      },
      "text": "དུ་ཡང་ནི་ ༼སྣར། པེ།༽ དུ་ཡང་"
    },
    {
      "span": {
        "start": 18842,
        "end": 18852
      },
      "text": "སྤྲུལ་པའི་ ༼པེ།༽ སྤྲུལ་པ་"
    },
    {
      "span": {
        "start": 19054,
        "end": 19060
      },
      "text": "གསད་པ་ ༼སྣར། པེ།༽ བསད་པ་"
    },
    {
      "span": {
        "start": 19068,
        "end": 19070
      },
      "text": "ཚ་ ༼སྣར། པེ།༽ སཱཙྪ་"
    },
    {
      "span": {
        "start": 19417,
        "end": 19420
      },
      "text": "བུ་ ༼སྣར། པེ།༽ བུ་ལ་"
    },
    {
      "span": {
        "start": 19456,
        "end": 19467
      },
      "text": "ཆེའི་གའུའི་ ༼སྣར། པེ།༽ ཆེ་གའུ་"
    },
    {
      "span": {
        "start": 19602,
        "end": 19608
      },
      "text": "ཁ་ཐོན་ ༼སྣར། པེ།༽ ཁ་ཏོན་"
    },
    {
      "span": {
        "start": 19821,
        "end": 19829
      },
      "text": "ཕྲིན་ལས་ ༼སྣར། པེ།༽ འཕྲིན་ལས་"
    },
    {
      "span": {
        "start": 19890,
        "end": 19896
      },
      "text": "གསད་པ་ ༼སྣར། པེ།༽ བསད་པ་"
    },
    {
      "span": {
        "start": 19922,
        "end": 19926
      },
      "text": "གསད་ ༼སྣར། པེ།༽ བསད་"
    },
    {
      "span": {
        "start": 19984,
        "end": 19996
      },
      "text": "བརྩམས་པས་ཏེ་ ༼སྣར། པེ།༽ བརྩམས་པས་སྟེ་"
    },
    {
      "span": {
        "start": 20023,
        "end": 20030
      },
      "text": "གསད་པའོ ༼སྣར། པེ།༽ བསད་པའོ"
    },
    {
      "span": {
        "start": 20030,
        "end": 20037
      },
      "text": "། །ཚ་ཚ་ ༼སྣར། པེ།༽ ། །སཱཙྪ་"
    },
    {
      "span": {
        "start": 20179,
        "end": 20186
      },
      "text": "ཡིན་ཏེ། ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 20449,
        "end": 20454
      },
      "text": "གནོད་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 20466,
        "end": 20476
      },
      "text": "བཅུད་ཀྱིས་ ༼སྣར། པེ།༽ བཅུད་ཀྱི་"
    },
    {
      "span": {
        "start": 20563,
        "end": 20568
      },
      "text": "མཆོད་ ༼སྣར། པེ།༽ མཆོད་པ་"
    },
    {
      "span": {
        "start": 20612,
        "end": 20620
      },
      "text": "རིམ་པའི་ ༼སྣར། པེ།༽ རིམ་པ་"
    },
    {
      "span": {
        "start": 20664,
        "end": 20673
      },
      "text": "ཆེན་པོའི་ ༼སྣར། པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 20817,
        "end": 20824
      },
      "text": "ཡི་གེས་ ༼སྣར། པེ།༽ ཡི་གེ་"
    },
    {
      "span": {
        "start": 20953,
        "end": 20957
      },
      "text": "ཟུང་ ༼སྣར། པེ།༽ ཟུར་"
    },
    {
      "span": {
        "start": 20960,
        "end": 20970
      },
      "text": "འབྲེལ་པའི་ ༼སྣར། པེ།༽ འགྲེལ་པའི་"
    },
    {
      "span": {
        "start": 21034,
        "end": 21038
      },
      "text": "ཨ་ཝ་ ༼སྣར། པེ།༽ ཨ་བ་"
    },
    {
      "span": {
        "start": 21276,
        "end": 21282
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 21355,
        "end": 21363
      },
      "text": "གཡས་པའི་ ༼སྣར། པེ།༽ གཡས་པ་"
    },
    {
      "span": {
        "start": 21410,
        "end": 21420
      },
      "text": "འཁྱགས་པའི་ ༼སྣར། པེ།༽ འཁྱགས་པ་"
    },
    {
      "span": {
        "start": 21479,
        "end": 21484
      },
      "text": "ཟླའི་ ༼སྣར། པེ།༽ ཟླ་"
    },
    {
      "span": {
        "start": 21501,
        "end": 21508
      },
      "text": "ཐིག་ལེ་ ༼སྣར། པེ།༽ ཐིག་ལེ་ངོ་བོ་གནས་ཐིག་ལེ་"
    },
    {
      "span": {
        "start": 21522,
        "end": 21527
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 21810,
        "end": 21820
      },
      "text": "གཏུམ་མོའི་ ༼སྣར། པེ།༽ གཏུམ་མོ་"
    },
    {
      "span": {
        "start": 21991,
        "end": 21997
      },
      "text": "བཅུའི་ ༼སྣར། པེ།༽ བཅུ་"
    },
    {
      "span": {
        "start": 22026,
        "end": 22035
      },
      "text": "ཐིག་ལེའི་ ༼སྣར། པེ།༽ ཐིག་ལེ་"
    },
    {
      "span": {
        "start": 22524,
        "end": 22530
      },
      "text": "བསྒོམ། ༼སྣར། པེ།༽ སྒོམ།"
    },
    {
      "span": {
        "start": 22543,
        "end": 22547
      },
      "text": "ཡིས་ ༼པེ།༽ ཡི་"
    },
    {
      "span": {
        "start": 22673,
        "end": 22682
      },
      "text": "བ་ཐག་ཅེས་ ༼སྣར།༽ བ་ཐག་ཅེས་པ་"
    },
    {
      "span": {
        "start": 22784,
        "end": 22793
      },
      "text": "ཐིག་ལེའི་ ༼སྣར། པེ།༽ ཐིག་ལེ་"
    },
    {
      "span": {
        "start": 23109,
        "end": 23115
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བཏགས་"
    },
    {
      "span": {
        "start": 23145,
        "end": 23152
      },
      "text": "སྐྱེ་བ་ ༼སྣར། པེ།༽ སྐྱེས་པ་"
    },
    {
      "span": {
        "start": 23599,
        "end": 23602
      },
      "text": "དང་ ༼སྣར། པེ།༽ དང་རླུང་"
    },
    {
      "span": {
        "start": 23606,
        "end": 23609
      },
      "text": "ལེ་ ༼སྣར། པེ།༽ ལེ་ལ་"
    },
    {
      "span": {
        "start": 23644,
        "end": 23654
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 23808,
        "end": 23812
      },
      "text": "ཨ་ཝ་ ༼སྣར། པེ།༽ ཨ་བ་"
    },
    {
      "span": {
        "start": 24188,
        "end": 24194
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 24246,
        "end": 24251
      },
      "text": "རྟགས་ ༼སྣར། པེ།༽ ལྔ་ལོ་ཟླ་"
    },
    {
      "span": {
        "start": 24255,
        "end": 24261
      },
      "text": "རྒྱའི་ ༼སྣར། པེ།༽ རྒྱའོ། །"
    },
    {
      "span": {
        "start": 24334,
        "end": 24343
      },
      "text": "སྣང་རྟགས། ༼སྣར།༽ སྣང་མཁའ་སྣང་རྟགས ༼པེ།༽ སྣང་མཁའ་སྣང་སྟགས།"
    },
    {
      "span": {
        "start": 24459,
        "end": 24465
      },
      "text": "གང་ཟག་ ༼སྣར།༽ གང་དག་"
    },
    {
      "span": {
        "start": 24591,
        "end": 24599
      },
      "text": "ཟབ་མོའི་ ༼སྣར། པེ།༽ ཟབ་མོ་"
    },
    {
      "span": {
        "start": 24678,
        "end": 24683
      },
      "text": "འཆོས་ ༼སྣར། པེ།༽ ཆོས་"
    },
    {
      "span": {
        "start": 24936,
        "end": 24947
      },
      "text": "བརྒྱུད་པའི་ ༼སྣར། པེ།༽ བརྒྱུད་པ་"
    },
    {
      "span": {
        "start": 25005,
        "end": 25010
      },
      "text": "རིགས་ ༼སྣར། པེ།༽ རིག་"
    },
    {
      "span": {
        "start": 25345,
        "end": 25352
      },
      "text": "རྟོག་པ་ ༼སྣར།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 25423,
        "end": 25432
      },
      "text": "ཀུན་གྱིས་ ༼སྣར། པེ།༽ ཀུན་གྱི་"
    },
    {
      "span": {
        "start": 25462,
        "end": 25471
      },
      "text": "ཆེན་པོའི་ ༼སྣར། པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 25511,
        "end": 25520
      },
      "text": "བརྩམས་པར་ ༼སྣར། པེ།༽ བརྩམ་པར་"
    }
  ]
}