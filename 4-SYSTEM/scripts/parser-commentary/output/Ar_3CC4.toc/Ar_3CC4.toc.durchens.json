{
  "durchens": [
    {
      "span": {
        "start": 589,
        "end": 598
      },
      "text": "ཁོང་དུ་མ་ ༼སྣར། པེ།༽ ཁོང་དུ་"
    },
    {
      "span": {
        "start": 748,
        "end": 754
      },
      "text": "ཁོ་ནར་ ༼སྣར། པེ།༽ ཁོ་ན་"
    },
    {
      "span": {
        "start": 1207,
        "end": 1217
      },
      "text": "བརྟགས་པའི་ ༼སྣར། པེ།༽ བཏགས་པའི་"
    },
    {
      "span": {
        "start": 1313,
        "end": 1319
      },
      "text": "བརྟགས། ༼སྣར། པེ།༽ བཏགས།"
    },
    {
      "span": {
        "start": 1515,
        "end": 1525
      },
      "text": "བརྟགས་པའི་ ༼སྣར། པེ།༽ བཏགས་པའི་"
    },
    {
      "span": {
        "start": 1559,
        "end": 1566
      },
      "text": "ལྟོས་པ་ ༼སྣར། པེ།༽ བལྟོས་པ་"
    },
    {
      "span": {
        "start": 1738,
        "end": 1742
      },
      "text": "མེད་ ༼སྣར། པེ།༽ མིན་"
    },
    {
      "span": {
        "start": 1780,
        "end": 1790
      },
      "text": "བརྟགས་པའི་ ༼སྣར། པེ།༽ བཏགས་པའི་"
    },
    {
      "span": {
        "start": 2088,
        "end": 2091
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 2300,
        "end": 2327
      },
      "text": "ཕྱོགས་ཆ་ཐ་དད་པའི་ཕྱིར་ཆ་ཤས་ ༼སྣར། པེ།༽ ཕྱོགས་"
    },
    {
      "span": {
        "start": 2916,
        "end": 2922
      },
      "text": "རྟོགས་ ༼སྣར། པེ།༽ རྟག་"
    },
    {
      "span": {
        "start": 2947,
        "end": 2955
      },
      "text": "བརྟགས་པ་ ༼སྣར། པེ།༽ བཏགས་པ་"
    },
    {
      "span": {
        "start": 3021,
        "end": 3028
      },
      "text": "ཡོད་དེ། ༼སྣར། པེ།༽ ཡོད་དོ།"
    },
    {
      "span": {
        "start": 3367,
        "end": 3374
      },
      "text": "ཡིན་ཏེ། ༼སྣར། པེ།༽ ཡིན་ནོ།"
    },
    {
      "span": {
        "start": 3395,
        "end": 3399
      },
      "text": "དོན་ ༼སྣར། པེ།༽ དོན་དེ་"
    },
    {
      "span": {
        "start": 3773,
        "end": 3781
      },
      "text": "བརྟགས་པ་ ༼སྣར། པེ།༽ བཏགས་པ་"
    },
    {
      "span": {
        "start": 3801,
        "end": 3805
      },
      "text": "དེས་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 3808,
        "end": 3812
      },
      "text": "ཆགས་ ༼སྣར། པེ།༽ ཆ་"
    },
    {
      "span": {
        "start": 3880,
        "end": 3888
      },
      "text": "བརྟགས་པ་ ༼སྣར། པེ།༽ བཏགས་པ་"
    },
    {
      "span": {
        "start": 4126,
        "end": 4129
      },
      "text": "ནི། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 4393,
        "end": 4403
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 4618,
        "end": 4632
      },
      "text": "ཐ་སྙད་དུ་བྱའོ། ༼སྣར། པེ།༽ ཐ་སྙད་དུའོ།"
    },
    {
      "span": {
        "start": 4727,
        "end": 4739
      },
      "text": "མཚན་ཉིད་ཀྱི་ ༼སྣར། པེ།༽ མཚན་ཉིད་ཀྱིས་"
    }
  ]
}