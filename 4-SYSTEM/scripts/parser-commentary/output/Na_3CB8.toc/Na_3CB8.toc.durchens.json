{
  "durchens": [
    {
      "span": {
        "start": 613,
        "end": 618
      },
      "text": "འདིར་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 835,
        "end": 844
      },
      "text": "ལ་སོགས་པ་ ༼ཅོ།༽ ལ་སོགས་པ་ལ་མེད་"
    },
    {
      "span": {
        "start": 958,
        "end": 963
      },
      "text": "ཉེ་བ་ ༼སྣར། པེ།༽ ཉེ་བར་"
    },
    {
      "span": {
        "start": 970,
        "end": 976
      },
      "text": "བསྐུར་ ༼སྣར། པེ།༽ བསྐུལ་"
    },
    {
      "span": {
        "start": 1113,
        "end": 1119
      },
      "text": "ཁམས་པ་ ༼སྣར། པེ།༽ ཁམ་པ་"
    },
    {
      "span": {
        "start": 1166,
        "end": 1173
      },
      "text": "མགོ་བོ་ ༼སྣར། པེ།༽ མགོ་"
    },
    {
      "span": {
        "start": 1291,
        "end": 1307
      },
      "text": "ལ་སོགས་པ་ལ་སོགས་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 1453,
        "end": 1459
      },
      "text": "དེ་དག་ ༼སྣར། པེ།༽ འདི་དག་"
    },
    {
      "span": {
        "start": 1959,
        "end": 1964
      },
      "text": "གཅིག་ ༼སྣར། པེ།༽ དྲུག་"
    },
    {
      "span": {
        "start": 2018,
        "end": 2021
      },
      "text": "གི་ ༼སྣར། པེ།༽ གིས་"
    },
    {
      "span": {
        "start": 2047,
        "end": 2059
      },
      "text": "གཅིག་གིས་སོ་ ༼སྣར།༽ གཅིག་གིའོ་"
    },
    {
      "span": {
        "start": 2157,
        "end": 2165
      },
      "text": "ནོ་ཞེ་ན། ༼པེ།༽ ནོ་"
    },
    {
      "span": {
        "start": 2435,
        "end": 2440
      },
      "text": "མཇུག་ ༼པེ།༽ འཇུག་"
    },
    {
      "span": {
        "start": 2718,
        "end": 2725
      },
      "text": "རྟེན་པ་ ༼སྣར། པེ།༽ བརྟེན་པ་"
    },
    {
      "span": {
        "start": 2743,
        "end": 2747
      },
      "text": "པའོ། ༼སྣར།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 2857,
        "end": 2861
      },
      "text": "བཞི་ ༼སྣར། པེ།༽ གཞི་"
    },
    {
      "span": {
        "start": 3182,
        "end": 3187
      },
      "text": "ཉེ་བ་ ༼སྣར། པེ།༽ ཉེ་བར་"
    },
    {
      "span": {
        "start": 3234,
        "end": 3243
      },
      "text": "འདས་ཀྱིས་ ༼སྣར། པེ།༽ འདས་ཀྱི་"
    },
    {
      "span": {
        "start": 3246,
        "end": 3254
      },
      "text": "བའི་གནས་ ༼སྣར། པེ།༽ བའི་"
    },
    {
      "span": {
        "start": 3325,
        "end": 3329
      },
      "text": "གཏན་ ༼སྣར། པེ།༽ བཏན་"
    },
    {
      "span": {
        "start": 3479,
        "end": 3494
      },
      "text": "གསུམ་པ་ཞེས་ཀྱང་ ༼སྣར།༽ གསུམ་པོ་ཞེས་"
    },
    {
      "span": {
        "start": 3716,
        "end": 3724
      },
      "text": "བྱ་བ་ནི་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 4007,
        "end": 4010
      },
      "text": "ཕམ་ ༼ཅོ།༽ ཕ་མེ་"
    },
    {
      "span": {
        "start": 4465,
        "end": 4469
      },
      "text": "ཞེས་ ༼ཅོ། སྡེ།༽ ཞེས་བྱ་བ་"
    },
    {
      "span": {
        "start": 5041,
        "end": 5043
      },
      "text": "པ་ ༼སྣར། པེ།༽ པས་"
    },
    {
      "span": {
        "start": 5102,
        "end": 5108
      },
      "text": "བརྟེན་ ༼པེ།༽ བསྟེན་"
    },
    {
      "span": {
        "start": 5119,
        "end": 5129
      },
      "text": "མན་ངག་གིས་ ༼སྣར། པེ།༽ མན་ངག་གི་"
    },
    {
      "span": {
        "start": 5652,
        "end": 5657
      },
      "text": "འཇིག་ ༼སྣར། པེ།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 5822,
        "end": 5829
      },
      "text": "ནམ་མཁའ་ ༼སྣར། པེ།༽ ནམ་མཁས་"
    },
    {
      "span": {
        "start": 5967,
        "end": 5976
      },
      "text": "ཡིད་ཀྱིས་ ༼སྣར། པེ།༽ ཡིད་ཀྱི་"
    },
    {
      "span": {
        "start": 6069,
        "end": 6078
      },
      "text": "སྐུ་གསུམ་ ༼སྣར། པེ།༽ སྐུ་གསུམ་གྱི་"
    },
    {
      "span": {
        "start": 6527,
        "end": 6535
      },
      "text": "བསྟན་ནས། ༼སྣར། པེ།༽ བསྟན་ན།"
    },
    {
      "span": {
        "start": 6890,
        "end": 6898
      },
      "text": "དཔེ་བྱད་ ༼སྣར། པེ།༽ དཔེ་བྱད་དང་"
    },
    {
      "span": {
        "start": 7155,
        "end": 7163
      },
      "text": "ཡིད་ཀྱི་ ༼སྣར། པེ།༽ ཡིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 7358,
        "end": 7363
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 7691,
        "end": 7694
      },
      "text": "ལས་ ༼ཅོ།༽ པས་"
    },
    {
      "span": {
        "start": 7747,
        "end": 7752
      },
      "text": "བྱའི་ ༼སྣར།༽ བྱིས་"
    },
    {
      "span": {
        "start": 7824,
        "end": 7833
      },
      "text": "ཡང་དག་པར་ ༼སྣར། པེ།༽ ཡང་དག་པ་"
    },
    {
      "span": {
        "start": 8199,
        "end": 8204
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 8234,
        "end": 8241
      },
      "text": "བསྡོམས་ ༼སྣར། པེ།༽ བསྡམས་"
    },
    {
      "span": {
        "start": 8282,
        "end": 8285
      },
      "text": "པས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 8988,
        "end": 8996
      },
      "text": "རིན་ཆེན་ ༼སྣར།༽ རིམ་ཆེམ་"
    },
    {
      "span": {
        "start": 9161,
        "end": 9168
      },
      "text": "གསལ་བས་ ༼སྣར། པེ།༽ བསལ་བས་"
    },
    {
      "span": {
        "start": 9497,
        "end": 9504
      },
      "text": "བསྒྱུར་ ༼སྣར། པེ།༽ སྒྱུར་"
    },
    {
      "span": {
        "start": 9595,
        "end": 9604
      },
      "text": "དཔའ་བོའི་ ༼སྣར།༽ དཔའ་བའི་"
    },
    {
      "span": {
        "start": 9662,
        "end": 9670
      },
      "text": "བསྣམས་པ་ ༼སྣར།༽ སྣམས་པ་"
    },
    {
      "span": {
        "start": 9853,
        "end": 9857
      },
      "text": "དཔལ་ ༼སྣར། པེ།༽ དཔའ་"
    },
    {
      "span": {
        "start": 10061,
        "end": 10067
      },
      "text": "བཞུགས་ ༼སྣར། པེ།༽ ཞུགས་"
    },
    {
      "span": {
        "start": 10316,
        "end": 10319
      },
      "text": "མེ་ ༼སྣར།༽ མ་"
    },
    {
      "span": {
        "start": 10393,
        "end": 10405
      },
      "text": "ལ་སོགས་སྲེག་ ༼སྣར།༽ ལ་སོགས་པ་བསྲེག་ ༼པེ།༽ ལ་སོགས་པ་བསྲེག་ས་"
    },
    {
      "span": {
        "start": 10570,
        "end": 10573
      },
      "text": "ལེ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 11050,
        "end": 11052
      },
      "text": "ན་ ༼ཅོ། སྣར།༽ ནི་"
    },
    {
      "span": {
        "start": 11265,
        "end": 11271
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པ་གཉིས་"
    },
    {
      "span": {
        "start": 11532,
        "end": 11536
      },
      "text": "དཔལ་ ༼སྣར། པེ།༽ དཔས་"
    },
    {
      "span": {
        "start": 11801,
        "end": 11809
      },
      "text": "སྡིག་པར་ ༼སྣར། པེ།༽ སྡིག་པ་"
    },
    {
      "span": {
        "start": 12519,
        "end": 12529
      },
      "text": "ཡོན་ཏན་ཏེ་ ༼སྣར། པེ།༽ ཡོན་ཏན་དེ་"
    },
    {
      "span": {
        "start": 14315,
        "end": 14324
      },
      "text": "སྒྲིབས་པ་ ༼སྣར། པེ།༽ སྒྲིབ་པ་"
    },
    {
      "span": {
        "start": 15048,
        "end": 15052
      },
      "text": "ཆེར་ ༼སྣར།༽ ཆར་"
    },
    {
      "span": {
        "start": 15057,
        "end": 15063
      },
      "text": "པ་ཞེས་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 15362,
        "end": 15369
      },
      "text": "རོལ་བས་ ༼སྣར། པེ།༽ རོལ་པ་"
    },
    {
      "span": {
        "start": 15536,
        "end": 15540
      },
      "text": "གོང་ ༼སྣར། པེ།༽ ཀྱི་ང་"
    },
    {
      "span": {
        "start": 17045,
        "end": 17055
      },
      "text": "ཡོན་ཏན་ཏེ་ ༼སྣར།༽ ཡོན་ཏན་དེས་"
    },
    {
      "span": {
        "start": 17312,
        "end": 17323
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱིས་"
    },
    {
      "span": {
        "start": 17625,
        "end": 17628
      },
      "text": "ནི་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 17744,
        "end": 17746
      },
      "text": "ན་ ༼སྣར།༽ ནི་"
    },
    {
      "span": {
        "start": 18072,
        "end": 18084
      },
      "text": "ཡེ་ཤེས་ཀྱིས་ ༼སྣར། པེ།༽ ཡེ་ཤེས་ཀྱི་"
    },
    {
      "span": {
        "start": 18632,
        "end": 18634
      },
      "text": "པ་ ༼སྣར།༽ ས་"
    },
    {
      "span": {
        "start": 18639,
        "end": 18647
      },
      "text": "དྲངས་ཏེ་ ༼སྣར། པེ།༽ དྲང་སྟེ་"
    },
    {
      "span": {
        "start": 19311,
        "end": 19318
      },
      "text": "གཏད་པར་ ༼སྣར། པེ།༽ བསྟད་པར་"
    },
    {
      "span": {
        "start": 20207,
        "end": 20212
      },
      "text": "བསམས་ ༼པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 20316,
        "end": 20326
      },
      "text": "མེད་པ་སྟེ་ ༼སྣར།༽ མེད་པ་སྡེ་"
    },
    {
      "span": {
        "start": 20596,
        "end": 20605
      },
      "text": "སྐྱེ་གནས་ ༼སྣར།༽ སྐྱེ་ནས་"
    },
    {
      "span": {
        "start": 20740,
        "end": 20748
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 20881,
        "end": 20897
      },
      "text": "འདོད་ཆགས་ལ་སོགས་ ༼པེ།༽ འདོད་ཆགས་"
    },
    {
      "span": {
        "start": 20904,
        "end": 20916
      },
      "text": "གྱི་ཕྱེད་པོ་ ༼སྣར། པེ།༽ གྱིས་བྱེད་པ་"
    },
    {
      "span": {
        "start": 20939,
        "end": 20946
      },
      "text": "བྱས་སོ། ༼སྣར། པེ།༽ བྱས་པའོ།"
    },
    {
      "span": {
        "start": 21297,
        "end": 21305
      },
      "text": "བདག་གིས་ ༼སྣར།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 21328,
        "end": 21334
      },
      "text": "བགྱིད་ ༼པེ།༽ གྱིད་"
    },
    {
      "span": {
        "start": 21426,
        "end": 21432
      },
      "text": "སྩལ་བ་ ༼སྣར། པེ།༽ རྩལ་བ་"
    },
    {
      "span": {
        "start": 21719,
        "end": 21730
      },
      "text": "སོགས་པའིའོ། ༼སྣར། པེ།༽ སོགསཔ་ཡིའོ།"
    },
    {
      "span": {
        "start": 21819,
        "end": 21828
      },
      "text": "མགྲོན་པོ་ ༼སྣར། པེ།༽ འགྲོན་པོ་"
    },
    {
      "span": {
        "start": 21843,
        "end": 21852
      },
      "text": "རྐུ་བ་དང་ ༼སྣར། པེ།༽ རྐུ་བ་"
    },
    {
      "span": {
        "start": 21860,
        "end": 21866
      },
      "text": "འཕྲོག་ ༼པེ།༽ འཕྲོགས་"
    },
    {
      "span": {
        "start": 21925,
        "end": 21928
      },
      "text": "བར་ ༼སྣར། པེ།༽ བར་མ་"
    },
    {
      "span": {
        "start": 22063,
        "end": 22070
      },
      "text": "བླངས་པ་ ༼སྣར། པེ།༽ བླངས་"
    },
    {
      "span": {
        "start": 22075,
        "end": 22080
      },
      "text": "ཟླ་ལ་ ༼སྣར།༽ ཟླ་བ་"
    },
    {
      "span": {
        "start": 22224,
        "end": 22228
      },
      "text": "ཡིན་ ༼སྣར།༽ ཡིད་"
    },
    {
      "span": {
        "start": 22287,
        "end": 22301
      },
      "text": "བྱའོ་ཞེས་བྱ་བ་ ༼སྣར། པེ།༽ བྱའོ་ཞེས་པ་"
    },
    {
      "span": {
        "start": 22496,
        "end": 22499
      },
      "text": "དེ་ ༼སྣར། པེ།༽ ད་"
    },
    {
      "span": {
        "start": 22636,
        "end": 22641
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་ཡང་"
    },
    {
      "span": {
        "start": 22688,
        "end": 22697
      },
      "text": "གནས་ཀྱིས་ ༼པེ།༽ གནས་ཀྱི་"
    },
    {
      "span": {
        "start": 22763,
        "end": 22771
      },
      "text": "ལས་ངན་པ་ ༼སྣར།༽ ལས་ངན་"
    },
    {
      "span": {
        "start": 22954,
        "end": 22963
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 23361,
        "end": 23371
      },
      "text": "མེད་པ་སྟེ། ༼སྣར། པེ།༽ མེད་པའོ།"
    },
    {
      "span": {
        "start": 23687,
        "end": 23694
      },
      "text": "འགོག་པ་ ༼སྣར།༽ འགག་པ་"
    },
    {
      "span": {
        "start": 24242,
        "end": 24250
      },
      "text": "དེ་འཇིག་ ༼སྣར། པེ།༽ འཇིག་"
    },
    {
      "span": {
        "start": 24623,
        "end": 24625
      },
      "text": "པ་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 24758,
        "end": 24768
      },
      "text": "ཐུགས་ཀྱིས་ ༼སྣར། པེ།༽ ཐུགས་ཀྱི་"
    },
    {
      "span": {
        "start": 25092,
        "end": 25096
      },
      "text": "སྟེ། ༼སྣར། པེ།༽ ཏེ་"
    },
    {
      "span": {
        "start": 25100,
        "end": 25105
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ བཞིས་"
    },
    {
      "span": {
        "start": 25156,
        "end": 25162
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ ད་ནི་"
    },
    {
      "span": {
        "start": 25415,
        "end": 25422
      },
      "text": "གཅད་པར་ ༼སྣར། པེ།༽ བཅད་པར་"
    },
    {
      "span": {
        "start": 25715,
        "end": 25722
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ བསྟེན་པ་"
    },
    {
      "span": {
        "start": 26062,
        "end": 26066
      },
      "text": "ཐ་མ་ ༼སྣར། པེ།༽ ཐ་ན་"
    },
    {
      "span": {
        "start": 26309,
        "end": 26315
      },
      "text": "དཀའ་བ་ ༼སྣར། པེ།༽ དཀར་བ་"
    },
    {
      "span": {
        "start": 26325,
        "end": 26328
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 26676,
        "end": 26684
      },
      "text": "བཟློག་པ་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 26828,
        "end": 26839
      },
      "text": "བྱང་ཆུབ་ཏུ་ ༼པེ།༽ བྱང་ཆུབ་"
    },
    {
      "span": {
        "start": 26878,
        "end": 26887
      },
      "text": "གནས་པ་ནི་ ༼སྣར། པེ།༽ གནས་པ་"
    },
    {
      "span": {
        "start": 27163,
        "end": 27171
      },
      "text": "གཉིས་སུ་ ༼པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 27517,
        "end": 27521
      },
      "text": "གོང་ ༼སྣར།༽ ངོ་"
    },
    {
      "span": {
        "start": 28383,
        "end": 28386
      },
      "text": "ནི་ ༼སྣར།༽ ན་"
    },
    {
      "span": {
        "start": 28418,
        "end": 28428
      },
      "text": "གསུམ་གྱིས་ ༼པེ།༽ གསུམ་གྱི་"
    },
    {
      "span": {
        "start": 28540,
        "end": 28545
      },
      "text": "བླ་ན་ ༼སྣར། པེ།༽ བླ་"
    },
    {
      "span": {
        "start": 28593,
        "end": 28599
      },
      "text": "སྐྱབས་ ༼པེ།༽ སྐབས་"
    },
    {
      "span": {
        "start": 28638,
        "end": 28648
      },
      "text": "འགྲོ་བ་ནི་ ༼སྣར། པེ།༽ འགྲོ་བ་"
    },
    {
      "span": {
        "start": 29012,
        "end": 29021
      },
      "text": "ཐལ་མོ་ནི་ ༼སྣར།༽ ཐལ་མོ་མི་"
    },
    {
      "span": {
        "start": 29178,
        "end": 29183
      },
      "text": "འདིར་ ༼སྣར། པེ།༽ འདི་"
    },
    {
      "span": {
        "start": 29338,
        "end": 29343
      },
      "text": "སྙོམ་ ༼སྣར། པེ།༽ སྙོམས་"
    },
    {
      "span": {
        "start": 29637,
        "end": 29647
      },
      "text": "སྟོན་པ་པོ། ༼སྣར།༽ སྟོན་པ་པའོ།"
    }
  ]
}