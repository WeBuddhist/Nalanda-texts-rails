{
  "durchens": [
    {
      "span": {
        "start": 348,
        "end": 356
      },
      "text": "ཐོས་པའི་ ༼སྣར། པེ།༽ ཐོས་པ་"
    },
    {
      "span": {
        "start": 523,
        "end": 531
      },
      "text": "ཁང་བཟངས་ ༼སྣར། པེ།༽ ཁང་བཟང་"
    },
    {
      "span": {
        "start": 789,
        "end": 791
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 897,
        "end": 904
      },
      "text": "འཁོར་བ་ ༼པེ།༽ འཁོར་"
    },
    {
      "span": {
        "start": 1282,
        "end": 1293
      },
      "text": "ཁང་བཟངས་སོ། ༼སྣར། པེ།༽ ཁང་བཟང་ངོ་།"
    },
    {
      "span": {
        "start": 1336,
        "end": 1343
      },
      "text": "གཞག་པས་ ༼ཅོ།༽ བཞགས་པས་"
    },
    {
      "span": {
        "start": 1918,
        "end": 1925
      },
      "text": "རྟོག་པ་ ༼སྣར།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 2314,
        "end": 2320
      },
      "text": "དེས་ན་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 2526,
        "end": 2529
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 2538,
        "end": 2542
      },
      "text": "སྟེ། ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 2572,
        "end": 2574
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 2599,
        "end": 2609
      },
      "text": "འབྱུང་བའི་ ༼སྣར། པེ།༽ བྱུང་བའི་"
    },
    {
      "span": {
        "start": 2755,
        "end": 2763
      },
      "text": "ངས་ལེགས་ ༼སྣར།༽ ངེས་ལེགས་"
    },
    {
      "span": {
        "start": 2773,
        "end": 2779
      },
      "text": "བྱ་ཡི་ ༼སྣར། པེ།༽ བྱ་ཡིས་"
    },
    {
      "span": {
        "start": 2834,
        "end": 2842
      },
      "text": "འཁྱམ་པས་ ༼སྣར། པེ།༽ འཁྱམས་པས་"
    },
    {
      "span": {
        "start": 2880,
        "end": 2888
      },
      "text": "སྲིད་དོ། ༼སྣར། པེ།༽ སྲིད་དེ།"
    },
    {
      "span": {
        "start": 3064,
        "end": 3071
      },
      "text": "ནམ་འཆི་ ༼སྣར། པེ།༽ ནམས་ཆི་"
    },
    {
      "span": {
        "start": 3073,
        "end": 3077
      },
      "text": "མའི་ ༼སྣར། པེ།༽ མའི་ཚེ་"
    },
    {
      "span": {
        "start": 3224,
        "end": 3234
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ སྒོམ་པའི་"
    },
    {
      "span": {
        "start": 3245,
        "end": 3257
      },
      "text": "བཅས་པས་བསྟན་ ༼སྣར།༽ བཅས་པར་བསྟན་ ༼པེ།༽ བཅས་པར་སྟན་"
    },
    {
      "span": {
        "start": 3260,
        "end": 3266
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ ད་ནི་"
    },
    {
      "span": {
        "start": 3554,
        "end": 3559
      },
      "text": "གྲངས་ ༼སྣར། པེ།༽ གྲངས་ཀྱི་"
    },
    {
      "span": {
        "start": 3579,
        "end": 3584
      },
      "text": "དེ་མ་ ༼སྣར། པེ།༽ དེ་ལ་"
    },
    {
      "span": {
        "start": 3711,
        "end": 3720
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 3761,
        "end": 3768
      },
      "text": "ཐམས་ཅད་ ༼སྣར། པེ།༽ ཐམས་ཅད་རྣམ་"
    },
    {
      "span": {
        "start": 3768,
        "end": 3773
      },
      "text": "དག་པ་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 4155,
        "end": 4168
      },
      "text": "སྦྱར་བ་ཡང་ཡང་ ༼སྣར། པེ།༽ སྦྱར་བ་ཡང་"
    },
    {
      "span": {
        "start": 4189,
        "end": 4196
      },
      "text": "དོན་དམ་ ༼སྣར། པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 4225,
        "end": 4232
      },
      "text": "ལ་ལྟོས་ ༼སྣར། པེ།༽ ལས་བལྟོས་"
    },
    {
      "span": {
        "start": 4243,
        "end": 4257
      },
      "text": "ཕྱིར་ཀུན་རྫོབ་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 4261,
        "end": 4264
      },
      "text": "ཆད་ ༼སྣར། པེ།༽ ཆད་པ་"
    },
    {
      "span": {
        "start": 4320,
        "end": 4328
      },
      "text": "སྤང་བའི་ ༼སྣར། པེ།༽ སྤོང་བའི་"
    },
    {
      "span": {
        "start": 4480,
        "end": 4487
      },
      "text": "ལ་ལྟོས་ ༼སྣར། པེ།༽ ལས་བལྟོས་"
    },
    {
      "span": {
        "start": 4540,
        "end": 4543
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 4546,
        "end": 4554
      },
      "text": "གནོད་པས་ ༼སྣར། པེ།༽ གནོད་པ་"
    },
    {
      "span": {
        "start": 4564,
        "end": 4570
      },
      "text": "བྱ་བར་ ༼སྣར། པེ།༽ བྱས་པར་"
    },
    {
      "span": {
        "start": 4646,
        "end": 4655
      },
      "text": "གནས་པས་ན། ༼སྣར།༽ གནས་པས་ནས།"
    },
    {
      "span": {
        "start": 4758,
        "end": 4765
      },
      "text": "མིན་ཏེ། ༼སྣར། པེ།༽ མིན་"
    },
    {
      "span": {
        "start": 4778,
        "end": 4785
      },
      "text": "བཅས་པས་ ༼སྣར། པེ།༽ བཅས་པར་"
    },
    {
      "span": {
        "start": 4841,
        "end": 4843
      },
      "text": "པ། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 4915,
        "end": 4919
      },
      "text": "ལྟར་ ༼ཅོ། སྡེ།༽ ལྟང་"
    },
    {
      "span": {
        "start": 5118,
        "end": 5127
      },
      "text": "བློ་བརྟན་ ༼སྣར།༽ བླ་བརྟེན་ ༼པེ།༽ བློ་བརྟེན་"
    },
    {
      "span": {
        "start": 5252,
        "end": 5259
      },
      "text": "ལོས་པས་ ༼སྣར། པེ།༽ བལྟོས་པས་"
    },
    {
      "span": {
        "start": 5465,
        "end": 5467
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 5506,
        "end": 5517
      },
      "text": "བསྟན་པ་སྟེ། ༼པེ།༽ བསྟན་པ་ཏེ།"
    },
    {
      "span": {
        "start": 5654,
        "end": 5675
      },
      "text": "ཐམས་ཅད་འོད་གསལ་བ་སྟེ། ༼སྣར། པེ།༽ འོད་གསལ་བས་ཏེ།"
    },
    {
      "span": {
        "start": 6164,
        "end": 6171
      },
      "text": "གསལ་བས་ ༼སྣར། པེ།༽ བསལ་བས་"
    },
    {
      "span": {
        "start": 6208,
        "end": 6214
      },
      "text": "སྒྲིབ་ ༼སྣར། པེ།༽ སྒྲིབས་"
    },
    {
      "span": {
        "start": 6283,
        "end": 6285
      },
      "text": "ལ། ༼སྣར། པེ།༽ ལས།"
    },
    {
      "span": {
        "start": 6468,
        "end": 6477
      },
      "text": "དམིགས་ཏེ་ ༼སྣར། པེ།༽ དམིགས་དེ་"
    },
    {
      "span": {
        "start": 6617,
        "end": 6624
      },
      "text": "ཚིག་གི་ ༼སྣར། པེ།༽ ཚིག་གིས་"
    },
    {
      "span": {
        "start": 6646,
        "end": 6652
      },
      "text": "འཆི་ཀ་ ༼སྣར། པེ།༽ འཆི་ཁ་"
    },
    {
      "span": {
        "start": 6711,
        "end": 6716
      },
      "text": "ཁོ་ན་ ༼སྣར། པེ།༽ ཁོ་ནར་"
    },
    {
      "span": {
        "start": 6806,
        "end": 6808
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 7501,
        "end": 7507
      },
      "text": "བ་མེད། ༼སྣར། པེ།༽ བ་དང་"
    },
    {
      "span": {
        "start": 7519,
        "end": 7530
      },
      "text": "ཞུགས་པ་སྟེ། ༼སྣར། པེ།༽ ཞུགས་པ་དེ།"
    },
    {
      "span": {
        "start": 7917,
        "end": 7928
      },
      "text": "ཕྱིར་བརྟེན་ ༼སྣར། པེ།༽ ཕྱི་བརྟན་"
    },
    {
      "span": {
        "start": 8165,
        "end": 8170
      },
      "text": "སྤངས། ༼སྣར། པེ།༽ སྤང་།"
    },
    {
      "span": {
        "start": 8488,
        "end": 8495
      },
      "text": "དོན་ཏོ། ༼སྣར། པེ།༽ དོན་ནོ།"
    },
    {
      "span": {
        "start": 8731,
        "end": 8736
      },
      "text": "འདིར་ ༼པེ།༽ འདིས་"
    },
    {
      "span": {
        "start": 8869,
        "end": 8885
      },
      "text": "བྱའོ་ཞེས་བཤད་དོ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 8957,
        "end": 8963
      },
      "text": "ཆགས་པ་ ༼སྣར། པེ།༽ ཆགས་པའི་ཆགས་པ་"
    },
    {
      "span": {
        "start": 9026,
        "end": 9031
      },
      "text": "དངོས་ ༼ཅོ།༽ དངོས་པོ་"
    },
    {
      "span": {
        "start": 9353,
        "end": 9361
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 9480,
        "end": 9484
      },
      "text": "གཞན་ ༼སྣར། པེ།༽ གཞན་དུ་"
    },
    {
      "span": {
        "start": 9576,
        "end": 9584
      },
      "text": "དབུ་མ་པ་ ༼སྣར། པེ།༽ དབུ་མ་"
    },
    {
      "span": {
        "start": 9925,
        "end": 9932
      },
      "text": "མེད་དོ། ༼སྣར།༽ མེད།"
    },
    {
      "span": {
        "start": 10081,
        "end": 10086
      },
      "text": "ཁོངས་ ༼སྣར། པེ།༽ ཁུངས་"
    },
    {
      "span": {
        "start": 10123,
        "end": 10129
      },
      "text": "སྲུངས་ ༼སྣར།༽ སྲུང་"
    },
    {
      "span": {
        "start": 10145,
        "end": 10152
      },
      "text": "བཙལ་ནས་ ༼སྣར། པེ།༽ བཙལ་ན་"
    },
    {
      "span": {
        "start": 10306,
        "end": 10314
      },
      "text": "རྟོགས་པ་ ༼སྣར།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 10336,
        "end": 10344
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 10423,
        "end": 10434
      },
      "text": "རྟོགས་པ་དེ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 10799,
        "end": 10806
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 11303,
        "end": 11309
      },
      "text": "གསུངས་ ༼སྣར།༽ གསུང་"
    },
    {
      "span": {
        "start": 11725,
        "end": 11727
      },
      "text": "པ་ ༼ཅོ།༽ པས་"
    },
    {
      "span": {
        "start": 11827,
        "end": 11836
      },
      "text": "བསྟན་པའི་ ༼སྣར། པེ།༽ བརྟན་པའི་"
    },
    {
      "span": {
        "start": 12427,
        "end": 12436
      },
      "text": "ཡས་མ་རིག་ ༼ཅོ།༽ ཡས་མ་ཅིག་"
    },
    {
      "span": {
        "start": 12475,
        "end": 12485
      },
      "text": "ལ་མོས་པའི་ ༼སྣར། པེ།༽ ལ་མོས་པ་"
    },
    {
      "span": {
        "start": 12517,
        "end": 12522
      },
      "text": "ཀ་ཡེ་ ༼ཅོ།༽ ཀ་"
    }
  ]
}