{
  "durchens": [
    {
      "span": {
        "start": 165,
        "end": 170
      },
      "text": "དོན་དྲུག་ལ་ ༼པེ།༽ དོན་དྲུག་ལས།"
    },
    {
      "span": {
        "start": 514,
        "end": 523
      },
      "text": "ཚོགས་ཀྱི་ ༼པེ།༽ ཚོགས་ཀྱིས།"
    },
    {
      "span": {
        "start": 798,
        "end": 801
      },
      "text": "ཇི་སྙམ་ ༼པེ།༽ ཇི་མི་སྙམ།"
    },
    {
      "span": {
        "start": 1084,
        "end": 1092
      },
      "text": "གོ་རིམས་ ༼པེ། སྣར། ཅོ།༽ གོ་རིམ།"
    },
    {
      "span": {
        "start": 1138,
        "end": 1146
      },
      "text": "གཉིས་པས་ ༼པེ།༽ གཉིས་པ།"
    },
    {
      "span": {
        "start": 1324,
        "end": 1329
      },
      "text": "གེགས་ ༼པེ། སྣར།༽ བགེགས།"
    },
    {
      "span": {
        "start": 1374,
        "end": 1382
      },
      "text": "དྲུག་པས་ ༼པེ།༽ དྲུག་པས་ནི།"
    },
    {
      "span": {
        "start": 1588,
        "end": 1598
      },
      "text": "གཅིག་ཏུ་ན་ ༼སྣར།༽ གཅིག་ཏུ་ནི།"
    },
    {
      "span": {
        "start": 1633,
        "end": 1639
      },
      "text": "རྣམ་པ་ ༼པེ།༽ རྣམ་པ།"
    },
    {
      "span": {
        "start": 1807,
        "end": 1811
      },
      "text": "བལྟ་ ༼པེ། སྣར།༽ ལྟ།"
    },
    {
      "span": {
        "start": 1831,
        "end": 1839
      },
      "text": "རྨོངས་པ་ ༼པེ།༽ ལ་སོགས་པའི་ཀུན་ནས་ཉོན་མོངས་པ།"
    },
    {
      "span": {
        "start": 1944,
        "end": 1949
      },
      "text": "བརྟས་ ༼པེ། སྣར།༽ རྟས།"
    },
    {
      "span": {
        "start": 2271,
        "end": 2275
      },
      "text": "པའམ་ ༼པེ།༽ འཇིག་རྟེན་པའམ།"
    },
    {
      "span": {
        "start": 2375,
        "end": 2380
      },
      "text": "གསུང་ ༼པེ།༽ གསུངས་པའི།"
    },
    {
      "span": {
        "start": 2661,
        "end": 2666
      },
      "text": "གཅིག་ ༼སྣར།༽ ཅིག"
    },
    {
      "span": {
        "start": 2673,
        "end": 2678
      },
      "text": "ལྟོས་ ༼སྣར།༽ བལྟོས།"
    },
    {
      "span": {
        "start": 2714,
        "end": 2718
      },
      "text": "ཆོས་ ༼པེ། སྣར།༽ ཚོགས།"
    },
    {
      "span": {
        "start": 3100,
        "end": 3105
      },
      "text": "ཀྱིས་ ༼པེ༽ ཀྱིས།"
    },
    {
      "span": {
        "start": 3316,
        "end": 3320
      },
      "text": "བདག་ ༼པེ།༽ དག"
    },
    {
      "span": {
        "start": 3339,
        "end": 3342
      },
      "text": "གི་ ༼པེ།༽ གིས།"
    },
    {
      "span": {
        "start": 3381,
        "end": 3389
      },
      "text": "གོ་རིམས་ ༼པེ། སྣར།༽ གོ་རིམ།"
    },
    {
      "span": {
        "start": 3925,
        "end": 3932
      },
      "text": "བསྒྲུབ་ ༼པེ།༽ སྒྲིབ།"
    }
  ]
}