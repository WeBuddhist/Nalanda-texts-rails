{
  "durchens": [
    {
      "span": {
        "start": 507,
        "end": 515
      },
      "text": "གཅད་པའི་ ༼སྣར། པེ།༽ བཅད་པའི་"
    },
    {
      "span": {
        "start": 584,
        "end": 593
      },
      "text": "རྣམས་ཀྱི་ ༼སྡེ།༽ རྣམ་ཀྱིས་"
    },
    {
      "span": {
        "start": 796,
        "end": 801
      },
      "text": "ཚད་མ་ ༼སྣར། པེ།༽ ཚད་མ་ནི་ཚད་མ་"
    },
    {
      "span": {
        "start": 1278,
        "end": 1288
      },
      "text": "བསྐྱེད་པར་ ༼སྡེ།༽ སྐྱེད་པར་"
    },
    {
      "span": {
        "start": 1310,
        "end": 1316
      },
      "text": "ཡིན་པ། ༼ཅོ། སྣར།༽ ཡིན་པར་"
    },
    {
      "span": {
        "start": 1400,
        "end": 1407
      },
      "text": "ལྟོས་པ་ ༼སྣར། པེ།༽ བལྟོས་པ་"
    },
    {
      "span": {
        "start": 1469,
        "end": 1477
      },
      "text": "མེད་པའམ་ ༼སྡེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 1494,
        "end": 1500
      },
      "text": "གྲང་ན། ༼སྣར། པེ།༽ གྲང་"
    },
    {
      "span": {
        "start": 1693,
        "end": 1696
      },
      "text": "ཐལ་ ༼སྣར། པེ།༽ ཐལ་བར་འགྱུར་"
    },
    {
      "span": {
        "start": 1866,
        "end": 1870
      },
      "text": "སྨྲ་ ༼སྣར། པེ།༽ སྨྲས་"
    },
    {
      "span": {
        "start": 1904,
        "end": 1917
      },
      "text": "མེད་པར་ཐལ་བར་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 2502,
        "end": 2512
      },
      "text": "གཞན་རབ་ཏུ་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 2786,
        "end": 2796
      },
      "text": "ཕྲད་པར་ཡང་ ༼སྣར། པེ།༽ ཕྲད་པར་"
    },
    {
      "span": {
        "start": 2808,
        "end": 2814
      },
      "text": "གྲང་ན། ༼སྣར། པེ།༽ གྲང་"
    },
    {
      "span": {
        "start": 2927,
        "end": 2933
      },
      "text": "ཕྲད་པ་ ༼སྡེ།༽ ཕྲད་པ་ཡོད་པ་"
    },
    {
      "span": {
        "start": 3200,
        "end": 3209
      },
      "text": "ལྷ་སྦྱིན་ ༼སྣར། པེ།༽ ལྷས་བྱིན་"
    },
    {
      "span": {
        "start": 3349,
        "end": 3355
      },
      "text": "ཡིན་པ་ ༼སྣར། པེ།༽ ན་པ་"
    },
    {
      "span": {
        "start": 3601,
        "end": 3607
      },
      "text": "དེ་ནས་ ༼སྣར། པེ།༽ དེས་ན་"
    },
    {
      "span": {
        "start": 3652,
        "end": 3660
      },
      "text": "ཡོད་པའི་ ༼སྣར། པེ།༽ ཡོད་པའི་མར་"
    },
    {
      "span": {
        "start": 3797,
        "end": 3804
      },
      "text": "སོགས་པ་ ༼སྣར། པེ།༽ རིགས་པ་"
    },
    {
      "span": {
        "start": 4184,
        "end": 4192
      },
      "text": "སྤྱོད་པ་ ༼སྣར། པེ།༽ དཔྱོད་པ་"
    },
    {
      "span": {
        "start": 4348,
        "end": 4355
      },
      "text": "མཐུན་པ་ ༼སྣར། པེ།༽ འཐུན་པ་"
    },
    {
      "span": {
        "start": 4361,
        "end": 4365
      },
      "text": "དཔེ་ ༼སྣར། པེ།༽ དཔེར་"
    },
    {
      "span": {
        "start": 4460,
        "end": 4466
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 4682,
        "end": 4688
      },
      "text": "བསལ་བ་ ༼སྣར། པེ།༽ གསལ་བ་"
    },
    {
      "span": {
        "start": 4776,
        "end": 4783
      },
      "text": "དཔེ་ནི་ ༼སྣར། པེ།༽ དཔེ་"
    },
    {
      "span": {
        "start": 4850,
        "end": 4859
      },
      "text": "གྲུབ་པ་མ་ ༼སྣར། པེ།༽ གྲུབ་པ་"
    },
    {
      "span": {
        "start": 5101,
        "end": 5109
      },
      "text": "བྱེད་དེ། ༼སྣར། པེ།༽ བྱས་ཏེ།"
    },
    {
      "span": {
        "start": 5344,
        "end": 5351
      },
      "text": "ཐོབ་པར་ ༼སྣར། པེ།༽ འཐོབ་པར་"
    },
    {
      "span": {
        "start": 5588,
        "end": 5595
      },
      "text": "རང་གིས་ ༼སྣར། པེ།༽ རང་གི་"
    },
    {
      "span": {
        "start": 5598,
        "end": 5607
      },
      "text": "བླངས་པའི་ ༼སྣར། པེ།༽ བླངས་པ་"
    },
    {
      "span": {
        "start": 5707,
        "end": 5712
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 5927,
        "end": 5934
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 5984,
        "end": 5986
      },
      "text": "པ་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 6312,
        "end": 6321
      },
      "text": "ཅར་སྐྱེས་ ༼སྣར། པེ།༽ ཆར་སྐྱེས་"
    },
    {
      "span": {
        "start": 6326,
        "end": 6334
      },
      "text": "རྒྱུ་དང་ ༼སྣར། པེ།༽ རྒྱུ་དག་"
    },
    {
      "span": {
        "start": 6410,
        "end": 6416
      },
      "text": "འགག་པ་ ༼སྣར། པེ།༽ དགག་པ་"
    },
    {
      "span": {
        "start": 6437,
        "end": 6440
      },
      "text": "དུ་ ༼སྣར། པེ།༽ དུ་ཚད་མ་དང་"
    },
    {
      "span": {
        "start": 6514,
        "end": 6520
      },
      "text": "འགག་པ་ ༼སྣར། པེ།༽ དགག་པ་"
    },
    {
      "span": {
        "start": 6596,
        "end": 6602
      },
      "text": "འགག་པ་ ༼སྣར། པེ།༽ དགག་པ་"
    },
    {
      "span": {
        "start": 6623,
        "end": 6633
      },
      "text": "འགྲུབ་སྟེ་ ༼སྣར། པེ།༽ འགྲུབ་ཏེ་"
    },
    {
      "span": {
        "start": 6637,
        "end": 6640
      },
      "text": "པར་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 6682,
        "end": 6689
      },
      "text": "འགག་པར་ ༼སྣར། པེ།༽ འགོག་པར་"
    },
    {
      "span": {
        "start": 6755,
        "end": 6764
      },
      "text": "འགྲུབ་བོ་ ༼སྣར། པེ།༽ གྲུབ་བོ་"
    },
    {
      "span": {
        "start": 6783,
        "end": 6792
      },
      "text": "བརྟག་པའི་ ༼སྣར། པེ།༽ རྟག་པའི་"
    },
    {
      "span": {
        "start": 6926,
        "end": 6933
      },
      "text": "གྲུབ་པ་ ༼སྣར། པེ།༽ གྲུབ་"
    },
    {
      "span": {
        "start": 6941,
        "end": 6945
      },
      "text": "ཡིན་ ༼སྣར། པེ།༽ ཡིན་པ་"
    },
    {
      "span": {
        "start": 6950,
        "end": 6956
      },
      "text": "འགག་པ་ ༼སྣར། པེ།༽ དགག་པ་"
    },
    {
      "span": {
        "start": 6993,
        "end": 7000
      },
      "text": "དགག་པར་ ༼སྣར། པེ།༽ དགག་པ་"
    },
    {
      "span": {
        "start": 7025,
        "end": 7033
      },
      "text": "གྲུབ་བོ་ ༼སྣར། པེ།༽ གྲུབ་བོ་ཞེས་"
    },
    {
      "span": {
        "start": 7099,
        "end": 7106
      },
      "text": "དགག་པས་ ༼སྣར། པེ།༽ དགག་པ་"
    },
    {
      "span": {
        "start": 7266,
        "end": 7270
      },
      "text": "པའི་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 7318,
        "end": 7324
      },
      "text": "འགག་པ་ ༼སྣར། པེ།༽ དགག་པ་"
    },
    {
      "span": {
        "start": 7369,
        "end": 7376
      },
      "text": "ཡིན་ནོ། ༼སྣར། པེ།༽ ཡིན་ནམ།"
    },
    {
      "span": {
        "start": 7603,
        "end": 7611
      },
      "text": "འགོག་པར་ ༼སྣར།༽ འགག་པར་"
    },
    {
      "span": {
        "start": 7642,
        "end": 7650
      },
      "text": "སྨྲས་པར་ ༼སྣར། པེ།༽ སྨྲ་བར་"
    },
    {
      "span": {
        "start": 7783,
        "end": 7789
      },
      "text": "འགག་པ་ ༼སྣར། པེ།༽ དགག་པ་"
    },
    {
      "span": {
        "start": 7873,
        "end": 7879
      },
      "text": "འགག་པ་ ༼སྣར། པེ།༽ དགག་པ་"
    },
    {
      "span": {
        "start": 7973,
        "end": 7978
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བ་དེ་"
    },
    {
      "span": {
        "start": 7999,
        "end": 8006
      },
      "text": "ཡིན་ཏེ། ༼སྣར། པེ།༽ ཡིན་ནོ།"
    },
    {
      "span": {
        "start": 8151,
        "end": 8161
      },
      "text": "འཇིགས་པའི་ ༼སྣར། པེ།༽ འཇིག་པའི་"
    },
    {
      "span": {
        "start": 8225,
        "end": 8232
      },
      "text": "ཡིན་ནོ། ༼སྣར། པེ།༽ ཡིན་ཏེ།"
    },
    {
      "span": {
        "start": 8267,
        "end": 8275
      },
      "text": "གསལ་བའི་ ༼སྣར། པེ།༽ བསལ་བའི་"
    },
    {
      "span": {
        "start": 8578,
        "end": 8582
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིར་"
    },
    {
      "span": {
        "start": 8812,
        "end": 8818
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ ད་ནི་"
    },
    {
      "span": {
        "start": 8821,
        "end": 8828
      },
      "text": "བླངས་ན་ ༼སྣར། པེ།༽ བླངས་ནས་"
    },
    {
      "span": {
        "start": 8982,
        "end": 8989
      },
      "text": "དབང་པོ་ ༼སྣར། པེ།༽ དབང་པོ་དང་དབང་པོ་"
    },
    {
      "span": {
        "start": 9064,
        "end": 9066
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་མིག་གི་"
    },
    {
      "span": {
        "start": 9185,
        "end": 9188
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 9332,
        "end": 9340
      },
      "text": "འབྲེལ་པ་ ༼སྣར། པེ།༽ འགྲེལ་པ་"
    },
    {
      "span": {
        "start": 9352,
        "end": 9360
      },
      "text": "སྔོན་དུ་ ༼སྣར། པེ།༽ མངོན་དུ་"
    },
    {
      "span": {
        "start": 9393,
        "end": 9398
      },
      "text": "དེ་ན་ ༼སྣར། པེ།༽ དེས་ན་"
    },
    {
      "span": {
        "start": 9627,
        "end": 9636
      },
      "text": "དེ་རྐྱེན་ ༼སྣར། པེ།༽ རྐྱེན་"
    },
    {
      "span": {
        "start": 9756,
        "end": 9761
      },
      "text": "དེའི་ ༼སྣར། པེ།༽ དེའི་ཕྱིར་"
    },
    {
      "span": {
        "start": 9813,
        "end": 9818
      },
      "text": "ཚད་མ་ ༼སྣར། པེ།༽ ཚད་མ་མ་"
    },
    {
      "span": {
        "start": 9848,
        "end": 9858
      },
      "text": "། །གཞལ་བྱ་ ༼སྣར། པེ།༽ ། །གཞན་"
    },
    {
      "span": {
        "start": 9963,
        "end": 9971
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 9979,
        "end": 9985
      },
      "text": "ཇི་ལྟ་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 10384,
        "end": 10389
      },
      "text": "དེ་མ་ ༼སྣར། པེ།༽ དེ་མི་"
    },
    {
      "span": {
        "start": 10479,
        "end": 10485
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 10794,
        "end": 10802
      },
      "text": "ཡོད་པ་མ་ ༼སྣར། པེ།༽ ཡོད་པ་"
    },
    {
      "span": {
        "start": 11012,
        "end": 11020
      },
      "text": "འཁྲུག་པ་ ༼སྣར། པེ།༽ འཕྲུག་པ་"
    },
    {
      "span": {
        "start": 11060,
        "end": 11076
      },
      "text": "སྡོང་དུམ་ཉིད་དོ། ༼སྣར། པེ།༽ སྡོང་དུམ་ཡིན།"
    },
    {
      "span": {
        "start": 11500,
        "end": 11506
      },
      "text": "ཇི་ལྟ་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 11531,
        "end": 11537
      },
      "text": "བཅས་པ་ ༼སྣར། པེ།༽ བཅས་པ་ལ་"
    },
    {
      "span": {
        "start": 11564,
        "end": 11568
      },
      "text": "འདི་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 12476,
        "end": 12483
      },
      "text": "དག་ཅིག་ ༼སྣར། པེ།༽ དག་གཅིག་"
    },
    {
      "span": {
        "start": 12574,
        "end": 12580
      },
      "text": "ཁོ་བོ་ ༼སྣར། པེ།༽ ཁོ་"
    },
    {
      "span": {
        "start": 12592,
        "end": 12616
      },
      "text": "ངེས་པར་མ་སྐྱེས་པའི་དགོས་ ༼སྣར།༽ ངེས་པ་མ་སྐྱེས་པའི་དགོས་ ༼པེ།༽ ངེས་"
    },
    {
      "span": {
        "start": 12964,
        "end": 12969
      },
      "text": "ཀྱིས་ ༼སྣར། པེ།༽ ཀྱིས་ན་"
    },
    {
      "span": {
        "start": 13073,
        "end": 13080
      },
      "text": "སྣམ་བུ་ ༼སྣར། པེ།༽ སྣལ་མ་"
    },
    {
      "span": {
        "start": 13106,
        "end": 13113
      },
      "text": "འཇུག་པ་ ༼སྣར། པེ།༽ འཇག་མ་"
    },
    {
      "span": {
        "start": 13252,
        "end": 13258
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 13412,
        "end": 13420
      },
      "text": "སྤྱོད་པ་ ༼སྣར། པེ།༽ དཔྱོད་པ་"
    },
    {
      "span": {
        "start": 13493,
        "end": 13504
      },
      "text": "མཐུན་པ་ཉིད་ ༼སྣར། པེ།༽ མཐུན་པ་"
    },
    {
      "span": {
        "start": 13760,
        "end": 13770
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 13902,
        "end": 13907
      },
      "text": "ཕྱིར། ༼སྣར། པེ།༽ ཕྱིར་རོ།"
    },
    {
      "span": {
        "start": 14368,
        "end": 14370
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 14431,
        "end": 14439
      },
      "text": "མཐུན་པར་ ༼སྣར། པེ།༽ མཐུན་པས་"
    },
    {
      "span": {
        "start": 14488,
        "end": 14493
      },
      "text": "ཡང་མ་ ༼སྣར། པེ།༽ ལས་ཀྱང་"
    },
    {
      "span": {
        "start": 14501,
        "end": 14506
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 14589,
        "end": 14591
      },
      "text": "པ་ ༼སྣར། པེ།༽ མཐའ་"
    },
    {
      "span": {
        "start": 14840,
        "end": 14849
      },
      "text": "ཡན་ལག་ཏུ་ ༼སྣར། པེ།༽ ཡན་ལག་"
    },
    {
      "span": {
        "start": 14853,
        "end": 14858
      },
      "text": "བ་ནི་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 14875,
        "end": 14884
      },
      "text": "ཐམས་ཅད་མ་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 14943,
        "end": 14951
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 15187,
        "end": 15193
      },
      "text": "རྣམ་པ་ ༼སྣར། པེ།༽ རྣམས་ཀྱང་"
    },
    {
      "span": {
        "start": 15225,
        "end": 15233
      },
      "text": "ཡན་ལག་མ་ ༼སྣར། པེ།༽ ཡན་ལག་ཅན་"
    },
    {
      "span": {
        "start": 15484,
        "end": 15490
      },
      "text": "རྣམ་པ་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 15538,
        "end": 15545
      },
      "text": "གཞན་ཡང་ ༼སྣར། པེ།༽ གཞན་མ་"
    },
    {
      "span": {
        "start": 15576,
        "end": 15587
      },
      "text": "གཞན་པ་གཅིག་ ༼སྣར། པེ།༽ གཞན་པ་ཞིག་"
    },
    {
      "span": {
        "start": 15651,
        "end": 15657
      },
      "text": "ཡན་ལག་ ༼སྣར། པེ།༽ ཡན་ལག་ཅན་"
    },
    {
      "span": {
        "start": 15716,
        "end": 15735
      },
      "text": "། ད་ལྟར་བ་རྣམ་པ་ལས་ ༼སྣར། པེ།༽ ད་ལྟར་བ་རྣམས་ལ་"
    },
    {
      "span": {
        "start": 16006,
        "end": 16016
      },
      "text": "ནུས་པ་ལྟར་ ༼སྣར། པེ།༽ ནུས་པ་"
    },
    {
      "span": {
        "start": 16024,
        "end": 16029
      },
      "text": "དུ་ན་ ༼སྣར། པེ།༽ དུ་"
    },
    {
      "span": {
        "start": 16038,
        "end": 16045
      },
      "text": "ལ་སོགས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་ཚོགས་"
    },
    {
      "span": {
        "start": 16058,
        "end": 16070
      },
      "text": "ཡོད་པ་མ་ཡིན་ ༼སྣར། པེ།༽ ཡོད་པ་བཞིན་"
    },
    {
      "span": {
        "start": 16096,
        "end": 16103
      },
      "text": "ཡིན་ཏེ། ༼སྣར།༽ ཡིན་སྟེ།"
    },
    {
      "span": {
        "start": 16196,
        "end": 16208
      },
      "text": "མོ་གཤམ་གཅིག་ ༼སྣར། པེ།༽ མོ་གཤམ་ཅིག་"
    },
    {
      "span": {
        "start": 16275,
        "end": 16285
      },
      "text": "བསྐྱེད་པར་ ༼སྣར། པེ།༽ སྐྱེད་པར་"
    },
    {
      "span": {
        "start": 16373,
        "end": 16380
      },
      "text": "དུ་མ་ལ་ ༼སྣར། པེ།༽ དུ་མར་"
    },
    {
      "span": {
        "start": 16436,
        "end": 16443
      },
      "text": "ཏིལ་མར་ ༼སྣར། པེ།༽ ཏིལ་མར་འབྱིན་པ་"
    },
    {
      "span": {
        "start": 16641,
        "end": 16648
      },
      "text": "ཛ་གཅིག་ ༼སྣར། པེ།༽ ཛ་ཅིག་"
    },
    {
      "span": {
        "start": 16798,
        "end": 16804
      },
      "text": "གང་ལས་ ༼སྣར། པེ།༽ ག་ལས་"
    },
    {
      "span": {
        "start": 16804,
        "end": 16809
      },
      "text": "ཤེ་ན་ ༼སྣར། པེ།༽ ཞེ་ན་"
    },
    {
      "span": {
        "start": 16937,
        "end": 16947
      },
      "text": "གཅིག་ལམ་ཁ་ ༼སྣར། པེ།༽ ཅིག་ལའམ་ཁའི་"
    },
    {
      "span": {
        "start": 17548,
        "end": 17555
      },
      "text": "བྱ་བའི་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 17787,
        "end": 17790
      },
      "text": "དག་ ༼སྣར། པེ།༽ དག་གཞན་"
    },
    {
      "span": {
        "start": 17843,
        "end": 17852
      },
      "text": "དཀར་པོའི་ ༼སྣར། པེ།༽ དཀར་པའོ་"
    },
    {
      "span": {
        "start": 18189,
        "end": 18198
      },
      "text": "གཏན་ཚིགས་ ༼སྣར།༽ གཏན་ཚིག་"
    },
    {
      "span": {
        "start": 18335,
        "end": 18347
      },
      "text": "དང་གཏན་ཚིགས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 18382,
        "end": 18389
      },
      "text": "བསྡུ་བ་ ༼སྣར། པེ།༽ སྡུད་པ་"
    },
    {
      "span": {
        "start": 18416,
        "end": 18425
      },
      "text": "དམ་བཅས་པ་ ༼སྣར། པེ།༽ དམ་བཅའ་བ་"
    },
    {
      "span": {
        "start": 18484,
        "end": 18491
      },
      "text": "བསྡུ་བ་ ༼སྣར། པེ།༽ སྡུད་པ་"
    },
    {
      "span": {
        "start": 18494,
        "end": 18506
      },
      "text": "ཀྱང་ཡོད་པ་མ་ ༼སྣར། པེ།༽ ཀྱང་མེད་པ་"
    },
    {
      "span": {
        "start": 18786,
        "end": 18794
      },
      "text": "སེམས་ཅན་ ༼སྣར། པེ།༽ སེམས་ན་"
    },
    {
      "span": {
        "start": 18849,
        "end": 18856
      },
      "text": "ཁོ་ནའི་ ༼སྣར། པེ།༽ ཁོ་ནས་"
    },
    {
      "span": {
        "start": 18957,
        "end": 18968
      },
      "text": "དོན་མེད་པར་ ༼སྣར། པེ།༽ དོན་མེད་པ་"
    },
    {
      "span": {
        "start": 19266,
        "end": 19292
      },
      "text": "། །གཏན་ཚིགས་ཀྱིས་འགྲུབ་པར་ ༼སྣར། པེ།༽ ། །བདག་ནི་"
    },
    {
      "span": {
        "start": 19393,
        "end": 19406
      },
      "text": "ནོ། །དེའི་ཚེ་ ༼སྣར། པེ།༽ གཏན་ཚིགས་དང་དཔེ་ལ་ཡང་དེ་བཞིན་ནོ། །གཞན་ཡང་། གཅིག་དང་གཅིག་བརྗོད་པའི་ཕྱིར་གཅིག་ལ་གཅིག་མེད་དོ། །གང་གི་ཚེ་དམ་བཅའ་བ་བརྗོད་པ་དེའི་ཚེ་གཏན་ཚིགས་ལ་སོགས་པ་མེད་ལ་"
    },
    {
      "span": {
        "start": 19514,
        "end": 19523
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 19547,
        "end": 19556
      },
      "text": "དམ་བཅའ་བ་ ༼སྣར། པེ།༽ དམ་བཅས་པ་"
    },
    {
      "span": {
        "start": 19741,
        "end": 19749
      },
      "text": "བྱེད་དེ། ༼སྣར། པེ།༽ བྱ་སྟེ།"
    },
    {
      "span": {
        "start": 19914,
        "end": 19919
      },
      "text": "ཕྱིར་ ༼སྣར། པེ།༽ ཕྱིར་པྲའི་"
    },
    {
      "span": {
        "start": 19995,
        "end": 19998
      },
      "text": "ཆུ་ ༼སྣར། པེ།༽ མཆུ་"
    },
    {
      "span": {
        "start": 20044,
        "end": 20051
      },
      "text": "ལ་གཅིག་ ༼སྣར། པེ།༽ ལ་ཅིག་"
    },
    {
      "span": {
        "start": 20085,
        "end": 20091
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 20117,
        "end": 20120
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 20151,
        "end": 20155
      },
      "text": "དོན་ ༼སྣར། པེ།༽ དོན་ལ་"
    },
    {
      "span": {
        "start": 20268,
        "end": 20274
      },
      "text": "ཇི་ལྟ་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 20416,
        "end": 20422
      },
      "text": "དོན་ལ་ ༼སྣར། པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 20502,
        "end": 20509
      },
      "text": "དཔྱད་པ་ ༼སྣར། པེ།༽ དཔྱད་པས་"
    },
    {
      "span": {
        "start": 20558,
        "end": 20567
      },
      "text": "རླུང་མཚན་ ༼སྣར། པེ།༽ རྒྱུ་མཚན་"
    },
    {
      "span": {
        "start": 20725,
        "end": 20732
      },
      "text": "གཉིས་ཀ་ ༼སྣར། པེ།༽ གཉི་ག་"
    },
    {
      "span": {
        "start": 20792,
        "end": 20797
      },
      "text": "གཅིག་ ༼སྣར། པེ།༽ ཅིག་"
    },
    {
      "span": {
        "start": 20831,
        "end": 20839
      },
      "text": "དག་གཅིག་ ༼སྣར། པེ།༽ དག་ཅིག་"
    },
    {
      "span": {
        "start": 20865,
        "end": 20876
      },
      "text": "གལ་ཏེ་གཅིག་ ༼སྣར། པེ།༽ གལ་ཏེ་ཅིག་"
    },
    {
      "span": {
        "start": 20928,
        "end": 20939
      },
      "text": "རུང་བ་གཅིག་ ༼སྣར། པེ།༽ རུང་བ་ཅིག་"
    },
    {
      "span": {
        "start": 20974,
        "end": 20978
      },
      "text": "དབང་ ༼སྣར། པེ།༽ དབང་པོ་"
    },
    {
      "span": {
        "start": 20981,
        "end": 20987
      },
      "text": "ནུས་པ་ ༼སྣར། པེ།༽ ནུས་"
    },
    {
      "span": {
        "start": 21059,
        "end": 21066
      },
      "text": "ན་གཅིག་ ༼སྣར། པེ།༽ ན་ཅིག་"
    },
    {
      "span": {
        "start": 21246,
        "end": 21253
      },
      "text": "ཡིན་ནོ། ༼སྣར། པེ།༽ ཡིན་ཏེ།"
    },
    {
      "span": {
        "start": 21552,
        "end": 21557
      },
      "text": "ཁྱོད་ ༼སྣར། པེ།༽ ཁྱོད་དང་"
    },
    {
      "span": {
        "start": 21800,
        "end": 21811
      },
      "text": "དེ་བཞིན་དུ་ ༼སྡེ།༽ དེ་བཞིན་"
    },
    {
      "span": {
        "start": 21844,
        "end": 21855
      },
      "text": "བུམ་པ་གཅིག་ ༼སྣར། པེ།༽ བུམ་པ་ཅིག་"
    },
    {
      "span": {
        "start": 21996,
        "end": 22004
      },
      "text": "མངོན་པར་ ༼སྣར། པེ།༽ མངོན་པར་བརྗོད་པར་"
    },
    {
      "span": {
        "start": 22562,
        "end": 22572
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 22672,
        "end": 22681
      },
      "text": "ལྷ་སྦྱིན་ ༼སྣར། པེ།༽ ལྷས་བྱིན་"
    },
    {
      "span": {
        "start": 22965,
        "end": 22971
      },
      "text": "སྟིགས་ ༼སྣར། པེ།༽ སྟིང་"
    },
    {
      "span": {
        "start": 23026,
        "end": 23036
      },
      "text": "ཚིགས་འཇིག་ ༼སྣར། པེ།༽ ཚིག་འཇིགས་"
    },
    {
      "span": {
        "start": 23059,
        "end": 23074
      },
      "text": "དང་སྐྱུར་རྩི་ལ་ ༼སྣར། པེ།༽ དང་སྒྱུར་རྩི་"
    },
    {
      "span": {
        "start": 23160,
        "end": 23168
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 23356,
        "end": 23365
      },
      "text": "ངག་ཕྱོགས་ ༼སྣར། པེ།༽ ངག་"
    },
    {
      "span": {
        "start": 23365,
        "end": 23368
      },
      "text": "དང་ ༼སྣར། པེ།༽ དང་ཕྱོགས་"
    },
    {
      "span": {
        "start": 23431,
        "end": 23435
      },
      "text": "དགུ་ ༼པེ།༽ མགུ་"
    },
    {
      "span": {
        "start": 23550,
        "end": 23554
      },
      "text": "ཀླུ། ༼སྣར། པེ།༽ རླུང་།"
    },
    {
      "span": {
        "start": 23727,
        "end": 23735
      },
      "text": "གཟུང་བར་ ༼སྣར། པེ།༽ བཟུང་བར་"
    },
    {
      "span": {
        "start": 23757,
        "end": 23765
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 23824,
        "end": 23832
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 23970,
        "end": 23980
      },
      "text": "བྱ་བ་གཅིག་ ༼སྣར། པེ།༽ བྱ་བ་ཅིག་"
    },
    {
      "span": {
        "start": 24024,
        "end": 24033
      },
      "text": "མི་འདོགས་ ༼སྣར།༽ མ་མདོག་ ༼པེ།༽ མི་མདོག་"
    },
    {
      "span": {
        "start": 24039,
        "end": 24046
      },
      "text": "བྱ་བའི་ ༼སྣར། པེ།༽ བྱ་པ་"
    },
    {
      "span": {
        "start": 24186,
        "end": 24193
      },
      "text": "ཕྱིར་མ་ ༼སྣར།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 24197,
        "end": 24202
      },
      "text": "པས་མ་ ༼སྣར།༽ པར་མ་"
    },
    {
      "span": {
        "start": 24322,
        "end": 24330
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 24617,
        "end": 24624
      },
      "text": "དོན་ཏོ། ༼སྣར། པེ།༽ དོན་ཏེ།"
    },
    {
      "span": {
        "start": 25045,
        "end": 25053
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར། པེ།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 25440,
        "end": 25447
      },
      "text": "ཡིན་ཏེ། ༼སྣར། པེ།༽ ཡིན་སྟེ།"
    },
    {
      "span": {
        "start": 25578,
        "end": 25593
      },
      "text": "འགྱུར་བའི་ཕྱིར་ ༼སྣར། པེ།༽ འགྱུར་བའི་"
    },
    {
      "span": {
        "start": 25678,
        "end": 25686
      },
      "text": "ཡོངས་སུ་ ༼སྣར། པེ།༽ ཡོངས་"
    },
    {
      "span": {
        "start": 25802,
        "end": 25806
      },
      "text": "འདི་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 26095,
        "end": 26101
      },
      "text": "ཇི་ལྟ་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 26254,
        "end": 26257
      },
      "text": "ཡང་ ༼སྣར། པེ།༽ ཡང་འཁྲུལ་པ་དང་བཅས་པར་མི་འགྱུར་རོ། །འོན་ཏེ་རང་གི་ངོ་བོ་འདོར་བར་བྱེད་པ་དེ་ལྟ་ན་ཡང་"
    },
    {
      "span": {
        "start": 26862,
        "end": 26868
      },
      "text": "ཡོད་པ་ ༼སྣར། པེ།༽ ཡོད་པ་པ་"
    },
    {
      "span": {
        "start": 26883,
        "end": 26886
      },
      "text": "ཤེ་ ༼སྣར། པེ།༽ ག་ལས་ཞེ་"
    },
    {
      "span": {
        "start": 27304,
        "end": 27307
      },
      "text": "དེ་ ༼སྡེ།༽ དེས་"
    },
    {
      "span": {
        "start": 27873,
        "end": 27876
      },
      "text": "དེ་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 28298,
        "end": 28307
      },
      "text": "གཏན་ཚིགས་ ༼སྣར། པེ།༽ གཏན་ཀྱིས་"
    },
    {
      "span": {
        "start": 28788,
        "end": 28795
      },
      "text": "སྔ་མའི་ ༼སྡེ།༽ སྔ་མའི་གཏན་"
    },
    {
      "span": {
        "start": 28842,
        "end": 28844
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 28879,
        "end": 28888
      },
      "text": "དུས་གཅིག་ ༼སྣར། པེ།༽ དུས་ཅིག་"
    },
    {
      "span": {
        "start": 28894,
        "end": 28897
      },
      "text": "ལན་ ༼སྣར། པེ།༽ ལན་དང་"
    },
    {
      "span": {
        "start": 29163,
        "end": 29172
      },
      "text": "ཁྱོད་ཀྱི་ ༼སྣར། པེ།༽ ཁྱོད་ཀྱིས་"
    },
    {
      "span": {
        "start": 29315,
        "end": 29325
      },
      "text": "དེའི་ཕྱིར་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 29676,
        "end": 29681
      },
      "text": "རྗོད་ ༼སྣར། པེ།༽ བརྗོད་"
    },
    {
      "span": {
        "start": 29822,
        "end": 29831
      },
      "text": "འབྱུང་བར་ ༼སྣར།༽ འགྱུར་བར་"
    },
    {
      "span": {
        "start": 29864,
        "end": 29875
      },
      "text": "དེ་བཞིན་དུ་ ༼སྣར། པེ།༽ དེ་བཞིན་"
    },
    {
      "span": {
        "start": 29910,
        "end": 29918
      },
      "text": "རྗོད་པར་ ༼སྣར། པེ།༽ བརྗོད་པར་"
    },
    {
      "span": {
        "start": 30109,
        "end": 30117
      },
      "text": "ཡིན་གྱི་ ༼སྣར། པེ།༽ ཡིན་པ་ཡིན་གྱིས་"
    },
    {
      "span": {
        "start": 30121,
        "end": 30123
      },
      "text": "པ་ ༼སྣར། པེ།༽ པ་ནི་"
    },
    {
      "span": {
        "start": 30551,
        "end": 30558
      },
      "text": "ལན་ཐམས་ ༼སྣར། པེ།༽ ཐམས་"
    },
    {
      "span": {
        "start": 30684,
        "end": 30690
      },
      "text": "གང་ལས་ ༼སྣར། པེ།༽ ག་ལས་"
    },
    {
      "span": {
        "start": 30690,
        "end": 30693
      },
      "text": "ཤེ་ ༼སྣར། པེ།༽ ཞེ་"
    },
    {
      "span": {
        "start": 30778,
        "end": 30784
      },
      "text": "འཐད་པ་ ༼སྣར། པེ།༽ འཐད་པ་མ་"
    },
    {
      "span": {
        "start": 31403,
        "end": 31410
      },
      "text": "ཟློས་པ་ ༼སྣར། པེ།༽ བཟློས་པ་"
    },
    {
      "span": {
        "start": 31549,
        "end": 31557
      },
      "text": "གཅད་པའི་ ༼སྣར། པེ།༽ བཅད་པའི་"
    },
    {
      "span": {
        "start": 31769,
        "end": 31782
      },
      "text": "གཅིག་ཉིད་ཀྱི་ ༼སྣར། པེ།༽ གཅིག་ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 32168,
        "end": 32173
      },
      "text": "ཟློས་ ༼སྣར། པེ།༽ བཟློག་"
    },
    {
      "span": {
        "start": 32208,
        "end": 32216
      },
      "text": "གཅད་པའི་ ༼སྣར། པེ།༽ བཅད་པའི་"
    },
    {
      "span": {
        "start": 32387,
        "end": 32393
      },
      "text": "གཅད་པ་ ༼སྣར། པེ།༽ བཅད་པ་"
    },
    {
      "span": {
        "start": 32478,
        "end": 32486
      },
      "text": "གཅད་པའི་ ༼སྣར། པེ།༽ བཅད་པའི་"
    },
    {
      "span": {
        "start": 32498,
        "end": 32504
      },
      "text": "གཅད་པ་ ༼སྣར། པེ།༽ བཅད་པ་"
    },
    {
      "span": {
        "start": 32511,
        "end": 32519
      },
      "text": "བཅིངས་པ་ ༼སྣར། པེ།༽ བཅིང་བ་"
    },
    {
      "span": {
        "start": 32532,
        "end": 32540
      },
      "text": "གཅད་པའི་ ༼སྣར། པེ།༽ བཅད་པའི་"
    },
    {
      "span": {
        "start": 32658,
        "end": 32662
      },
      "text": "འདི་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 32701,
        "end": 32708
      },
      "text": "འགག་པར་ ༼སྣར། པེ།༽ དགག་པར་"
    },
    {
      "span": {
        "start": 33257,
        "end": 33265
      },
      "text": "ཚིག་གིས་ ༼སྣར། པེ།༽ ཚིག་གི་"
    }
  ]
}