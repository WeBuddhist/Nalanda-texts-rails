{
  "durchens": [
    {
      "span": {
        "start": 211,
        "end": 221
      },
      "text": "ཡུལ་ཅན་དེ་ ༼སྣར། པེ།༽ ཡུལ་ཅན་"
    },
    {
      "span": {
        "start": 330,
        "end": 339
      },
      "text": "གནས་པས་ན་ ༼སྣར། པེ།༽ གནས་པས་"
    },
    {
      "span": {
        "start": 345,
        "end": 352
      },
      "text": "འཇུག་པ་ ༼སྣར། པེ།༽ འཇུག་"
    },
    {
      "span": {
        "start": 558,
        "end": 585
      },
      "text": "དང་ཡང་དུ་སྡུད་ཅིང་ལེན་པས་ན་ ༼སྣར། པེ།༽ དང་ཡང་"
    },
    {
      "span": {
        "start": 939,
        "end": 951
      },
      "text": "སྦྱོར་བ་ཡིན་ ༼སྣར། པེ།༽ སྦྱོར་བ་ཡིས་"
    },
    {
      "span": {
        "start": 1391,
        "end": 1397
      },
      "text": "སྤྱོད་ ༼སྣར། པེ།༽ དཔྱོད་"
    },
    {
      "span": {
        "start": 1461,
        "end": 1467
      },
      "text": "ཡིད་ལ་ ༼སྣར། པེ།༽ ཡིད་"
    },
    {
      "span": {
        "start": 1489,
        "end": 1493
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 1795,
        "end": 1808
      },
      "text": "ཤེས་པ་དང་ཤེས་ ༼སྣར། པེ།༽ ཤེས་"
    },
    {
      "span": {
        "start": 2207,
        "end": 2217
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 2538,
        "end": 2541
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱ་བར་ཤེས་པར་བྱ་"
    },
    {
      "span": {
        "start": 2648,
        "end": 2653
      },
      "text": "བསམས་ ༼སྣར། པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 2748,
        "end": 2758
      },
      "text": "མི་ཤིགས་པ་ ༼སྣར། པེ།༽ མི་ཤིག་"
    },
    {
      "span": {
        "start": 3034,
        "end": 3045
      },
      "text": "འཛིན་པ་ཡིན་ ༼སྣར། པེ།༽ འཛིན་"
    },
    {
      "span": {
        "start": 3132,
        "end": 3138
      },
      "text": "མཚན་མ་ ༼སྣར། པེ།༽ མཚན་མར་"
    },
    {
      "span": {
        "start": 3272,
        "end": 3274
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 3384,
        "end": 3392
      },
      "text": "རྡོ་རྗེ་ ༼སྣར། པེ།༽ རྡོ་རྗེས་"
    },
    {
      "span": {
        "start": 3599,
        "end": 3606
      },
      "text": "གྱུར་པ་ ༼སྣར། པེ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 3836,
        "end": 3842
      },
      "text": "མཚན་མ་ ༼སྣར། པེ།༽ མཚན་མར་"
    },
    {
      "span": {
        "start": 4167,
        "end": 4171
      },
      "text": "འདའ་ ༼སྣར། པེ།༽ མདའ་"
    },
    {
      "span": {
        "start": 4195,
        "end": 4204
      },
      "text": "རིམ་གྱིས་ ༼སྣར། པེ།༽ རིམ་གྱི་"
    },
    {
      "span": {
        "start": 4340,
        "end": 4345
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 4532,
        "end": 4539
      },
      "text": "རིམ་པས་ ༼སྣར། པེ།༽ རིམ་གྱིས་"
    },
    {
      "span": {
        "start": 4668,
        "end": 4671
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 4729,
        "end": 4732
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 4930,
        "end": 4939
      },
      "text": "རྒྱུ་བ་ལ་ ༼སྣར། པེ།༽ རྒྱུ་བས་"
    },
    {
      "span": {
        "start": 5106,
        "end": 5115
      },
      "text": "བསྒོམ་པར་ ༼པེ།༽ སྒོམ་པར་"
    },
    {
      "span": {
        "start": 5128,
        "end": 5141
      },
      "text": "འདི་ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ འདི་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 5145,
        "end": 5149
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱིས་"
    },
    {
      "span": {
        "start": 5422,
        "end": 5427
      },
      "text": "བརྟག་ ༼སྣར། པེ།༽ བརྟགས་"
    },
    {
      "span": {
        "start": 5553,
        "end": 5558
      },
      "text": "རླབས་ ༼སྣར། པེ།༽ བརླབས་"
    },
    {
      "span": {
        "start": 5696,
        "end": 5704
      },
      "text": "བརྟག་པར་ ༼སྣར། པེ།༽ བརྟགས་པར་"
    },
    {
      "span": {
        "start": 5926,
        "end": 5938
      },
      "text": "རྣལ་འབྱོར་པ་ ༼སྣར། པེ།༽ རྣལ་འབྱོར་"
    },
    {
      "span": {
        "start": 6665,
        "end": 6676
      },
      "text": "ཞུ་ཆེན་གྱི་ ༼སྣར། པེ།༽ ཞུ་ཆེན་"
    },
    {
      "span": {
        "start": 6734,
        "end": 6743
      },
      "text": "ཕབ་པའོ། །༼པེ།༽ ཕཕབ་པའོ་སརྦ་མངྒ་ལཾ་"
    }
  ]
}