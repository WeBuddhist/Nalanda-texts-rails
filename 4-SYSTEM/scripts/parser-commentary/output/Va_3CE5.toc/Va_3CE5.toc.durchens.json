{
  "durchens": [
    {
      "span": {
        "start": 1269,
        "end": 1276
      },
      "text": "ཚོགས་པ་ ༼སྣར།༽ ཚོགས་པའི་"
    },
    {
      "span": {
        "start": 1556,
        "end": 1566
      },
      "text": "གསུངས་པའི་ ༼སྣར། པེ།༽ གསུང་བའི་"
    },
    {
      "span": {
        "start": 2068,
        "end": 2071
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 2336,
        "end": 2344
      },
      "text": "ཐོབ་པའི་ ༼སྣར། པེ།༽ འཐོབ་པའི་"
    },
    {
      "span": {
        "start": 2368,
        "end": 2372
      },
      "text": "ཞབས་ ༼སྣར། པེ།༽ ཞབས་སུ་"
    },
    {
      "span": {
        "start": 2909,
        "end": 2927
      },
      "text": "བཞིན་དུ་འགྲོ་བ་ནི་ ༼སྣར། པེ།༽ བཞིན་དུ་"
    },
    {
      "span": {
        "start": 3797,
        "end": 3801
      },
      "text": "ཐོབ་ ༼སྣར།༽ ཐོབས་"
    },
    {
      "span": {
        "start": 4597,
        "end": 4604
      },
      "text": "བསྡམ་པ་ ༼སྣར། པེ།༽ སྡོམ་པ་"
    },
    {
      "span": {
        "start": 5102,
        "end": 5111
      },
      "text": "སྒྲུབ་པར་ ༼སྣར། པེ།༽ བསྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 5759,
        "end": 5767
      },
      "text": "སོ་སོའི་ ༼སྣར། པེ།༽ སོ་སོ་"
    },
    {
      "span": {
        "start": 6124,
        "end": 6132
      },
      "text": "ཕྲིན་ལས་ ༼སྣར། པེ།༽ འཕྲིན་ལས་"
    },
    {
      "span": {
        "start": 6180,
        "end": 6186
      },
      "text": "སྒྱུར་ ༼སྣར། པེ།༽ བསྒྱུར་"
    },
    {
      "span": {
        "start": 6254,
        "end": 6262
      },
      "text": "ཕྲིན་ལས་ ༼སྣར། པེ།༽ འཕྲིན་ལས་"
    },
    {
      "span": {
        "start": 6319,
        "end": 6325
      },
      "text": "དང་མི་ ༼སྣར།༽ དང་ནི་"
    },
    {
      "span": {
        "start": 6478,
        "end": 6484
      },
      "text": "རིག་པ་ ༼སྣར། པེ།༽ རིག་པས་"
    },
    {
      "span": {
        "start": 6843,
        "end": 6851
      },
      "text": "སྐྱེད་པ་ ༼སྣར།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 6879,
        "end": 6885
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 6981,
        "end": 6989
      },
      "text": "སྒྱུར་བ་ ༼སྣར། པེ།༽ བསྒྱུར་བ་"
    },
    {
      "span": {
        "start": 7223,
        "end": 7233
      },
      "text": "སྒྱུར་བའི་ ༼སྣར། པེ།༽ བསྒྱུར་བའི་"
    },
    {
      "span": {
        "start": 7271,
        "end": 7281
      },
      "text": "སྒྱུར་བའི་ ༼སྣར། པེ།༽ བསྒྱུར་བའི་"
    },
    {
      "span": {
        "start": 7326,
        "end": 7336
      },
      "text": "སྒྱུར་བའི་ ༼སྣར། པེ།༽ བསྒྱུར་བའི་"
    },
    {
      "span": {
        "start": 7388,
        "end": 7395
      },
      "text": "ཕྲེང་བ་ ༼པེ།༽ འཕྲེང་བ་"
    },
    {
      "span": {
        "start": 7400,
        "end": 7405
      },
      "text": "ལྟེང་ ༼སྣར། པེ།༽ སྟེང་"
    },
    {
      "span": {
        "start": 7518,
        "end": 7527
      },
      "text": "འདུལ་བའི་ ༼སྣར། པེ།༽ གདུལ་བའི་"
    },
    {
      "span": {
        "start": 7782,
        "end": 7787
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་"
    },
    {
      "span": {
        "start": 8259,
        "end": 8261
      },
      "text": "ལ་ ༼སྣར།༽ ལས་"
    },
    {
      "span": {
        "start": 8299,
        "end": 8307
      },
      "text": "སྒྱུར་བ་ ༼སྣར།༽ བསྒྱུར་བ་"
    },
    {
      "span": {
        "start": 8386,
        "end": 8394
      },
      "text": "ཕྲིན་ལས་ ༼སྣར། པེ།༽ འཕྲིན་ལས་"
    },
    {
      "span": {
        "start": 8568,
        "end": 8576
      },
      "text": "ཚུལ་གྱི་ ༼སྣར། པེ།༽ ཚུལ་གྱིས་"
    },
    {
      "span": {
        "start": 8676,
        "end": 8684
      },
      "text": "ཕྲིན་ལས་ ༼སྣར། པེ།༽ འཕྲིན་ལས་"
    },
    {
      "span": {
        "start": 9254,
        "end": 9260
      },
      "text": "བྱ་བར་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 9465,
        "end": 9469
      },
      "text": "མཐའ་ ༼སྣར།༽ མཐར་"
    },
    {
      "span": {
        "start": 9546,
        "end": 9552
      },
      "text": "དག་གི་ ༼སྣར། པེ།༽ དག་གིས་"
    },
    {
      "span": {
        "start": 9846,
        "end": 9852
      },
      "text": "སྤང་བ་ ༼སྣར། པེ།༽ སྤངས་པ་"
    },
    {
      "span": {
        "start": 10637,
        "end": 10645
      },
      "text": "ཕྱིར་རོ། ༼སྣར། པེ།༽ ཕྱིར་ཏེ།"
    },
    {
      "span": {
        "start": 10884,
        "end": 10897
      },
      "text": "གྱུར་ཅིག་ཅེས་ ༼སྣར།༽ གྱུར་ཅིག་པ་"
    },
    {
      "span": {
        "start": 10913,
        "end": 10920
      },
      "text": "བསྔོ་བ་ ༼སྣར།༽ སྔོ་བ་"
    },
    {
      "span": {
        "start": 11245,
        "end": 11256
      },
      "text": "གཤེགས་པ་དེ་ ༼སྣར། པེ།༽ གཤེགས་པ་"
    },
    {
      "span": {
        "start": 11522,
        "end": 11529
      },
      "text": "སྐུ་ནི་ ༼སྣར། པེ།༽ སྐུ་"
    },
    {
      "span": {
        "start": 11575,
        "end": 11584
      },
      "text": "འཕགས་པའི་ ༼སྣར། པེ།༽ འཕངས་པའི་"
    },
    {
      "span": {
        "start": 11594,
        "end": 11601
      },
      "text": "རྩོལ་བ་ ༼སྣར། པེ།༽ རྩོལ་"
    },
    {
      "span": {
        "start": 11628,
        "end": 11643
      },
      "text": "བཞིན་དུ་འཁོར་བ་ ༼སྣར། པེ།༽ བཞིན་དུ་"
    },
    {
      "span": {
        "start": 12986,
        "end": 12998
      },
      "text": "གཤེགས་པའི་བ་ ༼སྣར། པེ།༽ གཤེགས་པའི་"
    },
    {
      "span": {
        "start": 13021,
        "end": 13029
      },
      "text": "འགྲུབ་པ་ ༼སྣར། པེ།༽ འགྲུབ་པར་"
    },
    {
      "span": {
        "start": 13104,
        "end": 13110
      },
      "text": "བརྒྱད་ ༼སྣར། པེ།༽ བརྒྱ་"
    },
    {
      "span": {
        "start": 13193,
        "end": 13202
      },
      "text": "འགྲུབ་པར་ ༼སྣར། པེ།༽ གྲུབ་པར་"
    },
    {
      "span": {
        "start": 13270,
        "end": 13274
      },
      "text": "ཏོར་ ༼སྣར།༽ གཏོར་"
    },
    {
      "span": {
        "start": 14407,
        "end": 14414
      },
      "text": "བསྐྱེད་ ༼སྣར། པེ།༽ སྐྱེད་"
    },
    {
      "span": {
        "start": 14446,
        "end": 14456
      },
      "text": "བསྐྱེད་པས་ ༼སྣར། པེ།༽ སྐྱེད་པས་"
    },
    {
      "span": {
        "start": 14655,
        "end": 14662
      },
      "text": "རྣམས་ལ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 14716,
        "end": 14723
      },
      "text": "བརྫི་བ་ ༼སྣར། པེ།༽ རྫི་བ་"
    },
    {
      "span": {
        "start": 15020,
        "end": 15028
      },
      "text": "དགའ་བའི་ ༼སྣར། པེ།༽ དག་པའི་"
    },
    {
      "span": {
        "start": 15140,
        "end": 15147
      },
      "text": "བསམས་པ་ ༼སྣར། པེ།༽ བསམ་པ་"
    },
    {
      "span": {
        "start": 15294,
        "end": 15303
      },
      "text": "བསྐྱེད་པ་ ༼སྣར།༽ སྐྱེས་པ་ ༼པེ།༽ སྐྱེད་པ་"
    },
    {
      "span": {
        "start": 15880,
        "end": 15893
      },
      "text": "བཅོམ་ལྡན་འདས་ ༼པེ།༽ བཅོམ་ལྡན་"
    },
    {
      "span": {
        "start": 15945,
        "end": 15955
      },
      "text": "གྱིས་གནོན་ ༼པེ།༽ གྱི་མནོན་"
    },
    {
      "span": {
        "start": 15966,
        "end": 15974
      },
      "text": "ཕྲིན་ལས་ ༼པེ།༽ འཕྲིན་ལས་"
    },
    {
      "span": {
        "start": 16039,
        "end": 16050
      },
      "text": "ཤེས་རབ་ཀྱི་ ༼སྣར། པེ།༽ ཤེས་རབ་ཀྱིས་"
    },
    {
      "span": {
        "start": 16086,
        "end": 16093
      },
      "text": "བརྫི་བ་ ༼སྣར། པེ།༽ རྫི་བ་"
    },
    {
      "span": {
        "start": 16655,
        "end": 16659
      },
      "text": "སྔར་ ༼པེ།༽ བསྔར་"
    },
    {
      "span": {
        "start": 16698,
        "end": 16704
      },
      "text": "ལྷག་པ་ ༼སྣར། པེ།༽ ལྷགས་པ་"
    },
    {
      "span": {
        "start": 16805,
        "end": 16811
      },
      "text": "ལྷག་པ་ ༼སྣར། པེ།༽ ལྷགས་པ་"
    },
    {
      "span": {
        "start": 16865,
        "end": 16874
      },
      "text": "སྐྱེད་པར་ ༼སྣར། པེ།༽ བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 17165,
        "end": 17176
      },
      "text": "བསྒྲུབ་པའི་ ༼སྣར།༽ སྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 17399,
        "end": 17409
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 17688,
        "end": 17697
      },
      "text": "སྒྱུར་བས་ ༼སྣར། པེ།༽ བསྒྱུར་བ་"
    },
    {
      "span": {
        "start": 17706,
        "end": 17716
      },
      "text": "སྒྱུར་བའི་ ༼སྣར། པེ།༽ བསྒྱུར་བའི་"
    },
    {
      "span": {
        "start": 17786,
        "end": 17792
      },
      "text": "འདྲ་བ་ ༼སྣར། པེ།༽ འདྲ་བས་"
    },
    {
      "span": {
        "start": 17807,
        "end": 17812
      },
      "text": "གྱུར་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 18004,
        "end": 18008
      },
      "text": "དཀའ་ ༼སྣར། པེ།༽ བཀའ་"
    },
    {
      "span": {
        "start": 18024,
        "end": 18031
      },
      "text": "རྟོག་པ་ ༼སྣར། པེ།༽ རྟོགས་པ་"
    },
    {
      "span": {
        "start": 18588,
        "end": 18600
      },
      "text": "སེམས་ཅན་གྱི་ ༼པེ།༽ སེམས་ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 18693,
        "end": 18701
      },
      "text": "ཕྲིན་ལས་ ༼པེ།༽ འཕྲིན་ལས་"
    },
    {
      "span": {
        "start": 18732,
        "end": 18740
      },
      "text": "ཕྲིན་ལས་ ༼པེ།༽ འཕྲིན་ལས་"
    },
    {
      "span": {
        "start": 18800,
        "end": 18808
      },
      "text": "ཕྲིན་ལས་ ༼པེ།༽ འཕྲིན་ལས་"
    },
    {
      "span": {
        "start": 18921,
        "end": 18929
      },
      "text": "ཕྲིན་ལས་ ༼པེ།༽ འཕྲིན་ལས་"
    },
    {
      "span": {
        "start": 18970,
        "end": 18982
      },
      "text": "སེམས་ཅན་གྱི་ ༼སྣར།༽ སེམས་ཅན་གྱིས་"
    },
    {
      "span": {
        "start": 19013,
        "end": 19018
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 19076,
        "end": 19084
      },
      "text": "ཕྲིན་ལས་ ༼སྣར། པེ།༽ འཕྲིན་ལས་"
    },
    {
      "span": {
        "start": 19215,
        "end": 19223
      },
      "text": "ཕྲིན་ལས་ ༼པེ།༽ འཕྲིན་ལས་"
    },
    {
      "span": {
        "start": 19273,
        "end": 19278
      },
      "text": "བཟུང་ ༼སྣར། པེ།༽ གཟུང་"
    },
    {
      "span": {
        "start": 19365,
        "end": 19373
      },
      "text": "ཕྲིན་ལས་ ༼པེ།༽ འཕྲིན་ལས་"
    },
    {
      "span": {
        "start": 20092,
        "end": 20101
      },
      "text": "བཅོལ་བའི་ ༼སྣར། པེ།༽ རྩོལ་བའི་"
    },
    {
      "span": {
        "start": 20512,
        "end": 20533
      },
      "text": "ཕྲིན་ལས་ཀྱི་རྟེན་གྱི་ ༼སྣར། པེ།༽ ཕྲིན་ལས་ཀྱི་"
    },
    {
      "span": {
        "start": 21815,
        "end": 21824
      },
      "text": "འཕངས་པའི་ ༼སྣར། པེ།༽ ཕངས་པའི་"
    },
    {
      "span": {
        "start": 22034,
        "end": 22047
      },
      "text": "རབ་ཏུ་རྣམ་པར་ ༼སྣར། པེ།༽ རབ་ཏུ་"
    },
    {
      "span": {
        "start": 22411,
        "end": 22413
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 22702,
        "end": 22711
      },
      "text": "སྐྱེ་བའི་ ༼སྣར། པེ།༽ སྐྱེ་བས་"
    },
    {
      "span": {
        "start": 22764,
        "end": 22774
      },
      "text": "བསྡམས་པའི་ ༼སྣར། པེ།༽ སྡོམ་པའི་"
    },
    {
      "span": {
        "start": 22928,
        "end": 22935
      },
      "text": "བརྒལ་བ་ ༼སྣར། པེ།༽ རྒལ་བ་"
    },
    {
      "span": {
        "start": 23434,
        "end": 23445
      },
      "text": "འཕྲོགས་པའི་ ༼སྣར།༽ འཕྲོག་པའི་"
    },
    {
      "span": {
        "start": 23843,
        "end": 23849
      },
      "text": "མྱ་ངན་ ༼སྣར། པེ།༽ མྱ་ངན་ལས་"
    },
    {
      "span": {
        "start": 24302,
        "end": 24315
      },
      "text": "སངས་རྒྱས་ཀྱི་ ༼སྣར། པེ།༽ སངས་རྒྱས་"
    },
    {
      "span": {
        "start": 25401,
        "end": 25410
      },
      "text": "བཞུགས་སོ་ ༼སྣར།༽ བཞུགས་"
    },
    {
      "span": {
        "start": 25554,
        "end": 25563
      },
      "text": "སྦྱོར་བར་ ༼སྣར། པེ།༽ སྦྱོར་བ་"
    },
    {
      "span": {
        "start": 25625,
        "end": 25631
      },
      "text": "སྐུའི་ ༼སྣར། པེ།༽ སྐུས་"
    },
    {
      "span": {
        "start": 26337,
        "end": 26344
      },
      "text": "རིགས་པ་ ༼སྣར།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 26704,
        "end": 26712
      },
      "text": "ཕྲིན་ལས་ ༼པེ།༽ འཕྲིན་ལས་"
    },
    {
      "span": {
        "start": 26899,
        "end": 26902
      },
      "text": "ཞུ་ ༼སྣར། པེ།༽ ཞུས་"
    }
  ]
}