{
  "durchens": [
    {
      "span": {
        "start": 5361,
        "end": 5369
      },
      "text": "རྟོགས་པ་ ༼ཅོ།༽ གཏོགས་པ་"
    },
    {
      "span": {
        "start": 10696,
        "end": 10701
      },
      "text": "བྱ་བ་ ༼ཅོ།༽ བྱ་བར་"
    },
    {
      "span": {
        "start": 23830,
        "end": 23836
      },
      "text": "པས་ནི་ ༼ཅོ།༽ པས་"
    },
    {
      "span": {
        "start": 47076,
        "end": 47084
      },
      "text": "གནན་པའི་ ༼ཅོ།༽ མནན་པའི་"
    },
    {
      "span": {
        "start": 47222,
        "end": 47236
      },
      "text": "འཇིག་རྟེན་གྱི་ ༼ཅོ།༽ འཇིག་རྟེན་"
    },
    {
      "span": {
        "start": 47426,
        "end": 47434
      },
      "text": "གནན་པའི་ ༼ཅོ།༽ མནན་པའི་"
    },
    {
      "span": {
        "start": 48818,
        "end": 48827
      },
      "text": "ཡང་དག་པར་ ༼ཅོ།༽ ཡང་དག་པའི་"
    },
    {
      "span": {
        "start": 51244,
        "end": 51253
      },
      "text": "ཉིད་ཀྱིས་ ༼ཅོ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 55075,
        "end": 55080
      },
      "text": "བྱ་བ་ ༼ཅོ།༽ བྱ་བར་"
    },
    {
      "span": {
        "start": 55700,
        "end": 55706
      },
      "text": "ཇི་ལྟ་ ༼ཅོ།༽ ཇི་ལྟ་བ་"
    },
    {
      "span": {
        "start": 63282,
        "end": 63294
      },
      "text": "གསལ་བར་བསྟན་ ༼ཅོ།༽ གསལ་བར་སྟོན་"
    },
    {
      "span": {
        "start": 66883,
        "end": 66894
      },
      "text": "མཁྱེན་པ་ནི་ ༼ཅོ།༽ མཁྱེན་པའི་"
    },
    {
      "span": {
        "start": 70789,
        "end": 70793
      },
      "text": "བཞག་ ༼ཅོ།༽ གཞག་"
    },
    {
      "span": {
        "start": 73512,
        "end": 73519
      },
      "text": "བཏགས་པ་ ༼ཅོ།༽ བཏེགས་པ་"
    },
    {
      "span": {
        "start": 80933,
        "end": 80939
      },
      "text": "བའོ། ། ༼ཅོ།༽ །། །།"
    }
  ]
}