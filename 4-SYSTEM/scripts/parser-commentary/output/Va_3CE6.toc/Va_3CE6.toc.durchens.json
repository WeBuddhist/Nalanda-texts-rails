{
  "durchens": [
    {
      "span": {
        "start": 767,
        "end": 771
      },
      "text": "མོང་ ༼སྣར།༽ མོངས་"
    },
    {
      "span": {
        "start": 895,
        "end": 899
      },
      "text": "ཁྱད་ ༼སྣར། པེ།༽ ཁྱད་པར་"
    },
    {
      "span": {
        "start": 1160,
        "end": 1166
      },
      "text": "ངོས་ན་ ༼སྣར། པེ།༽ ངོས་"
    },
    {
      "span": {
        "start": 1315,
        "end": 1322
      },
      "text": "བརྩེགས་ ༼སྣར།༽ རྩེགས་"
    },
    {
      "span": {
        "start": 1322,
        "end": 1331
      },
      "text": "པ་བཞི་ནི་ ༼སྣར། པེ།༽ པ་བཞིན་"
    },
    {
      "span": {
        "start": 1873,
        "end": 1877
      },
      "text": "མོང་ ༼སྣར།༽ མོངས་"
    },
    {
      "span": {
        "start": 2582,
        "end": 2590
      },
      "text": "འདས་ཀྱི་ ༼སྣར། པེ།༽ འདས་ཀྱིས་"
    },
    {
      "span": {
        "start": 3541,
        "end": 3548
      },
      "text": "སོ།། །། ༼སྣར།༽ སོསསོ་དབྱིན་གཉེན་གྱིས། །།"
    }
  ]
}