{
  "durchens": [
    {
      "span": {
        "start": 350,
        "end": 360
      },
      "text": "སྒྲུབ་པའི་ ༼སྣར། པེ།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 406,
        "end": 412
      },
      "text": "ཐག་པར་ ༼སྣར། པེ།༽ ཐག་པ་"
    },
    {
      "span": {
        "start": 874,
        "end": 881
      },
      "text": "བརྟག་པ་ ༼སྣར། པེ།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 1015,
        "end": 1021
      },
      "text": "ཐག་པར་ ༼སྣར། པེ།༽ ཐག་པའི་"
    },
    {
      "span": {
        "start": 1025,
        "end": 1027
      },
      "text": "ལ་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 1092,
        "end": 1099
      },
      "text": "ལྟོས་པ་ ༼སྣར། པེ།༽ བལྟོས་པ་"
    },
    {
      "span": {
        "start": 1099,
        "end": 1102
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 1181,
        "end": 1185
      },
      "text": "བློ་ ༼སྣར། པེ།༽ བློ་ཡང་བའི་བློ་"
    },
    {
      "span": {
        "start": 1213,
        "end": 1222
      },
      "text": "བརྟག་པའི་ ༼སྣར། པེ།༽ བརྟགས་པའི་"
    },
    {
      "span": {
        "start": 1277,
        "end": 1280
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 1286,
        "end": 1290
      },
      "text": "ཡིས། ༼སྣར། པེ།༽ ཡི།"
    },
    {
      "span": {
        "start": 1591,
        "end": 1598
      },
      "text": "བརྟག་པ་ ༼སྡེ།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 1676,
        "end": 1684
      },
      "text": "བརྟགས་པ་ ༼སྣར། པེ།༽ བཏགས་པ་"
    },
    {
      "span": {
        "start": 1798,
        "end": 1807
      },
      "text": "བརྟག་པའི་ ༼སྣར། པེ།༽ བརྟགས་པའི་"
    },
    {
      "span": {
        "start": 1909,
        "end": 1917
      },
      "text": "དམིགས་པ་ ༼སྣར། པེ།༽ དམིགས་པར་"
    },
    {
      "span": {
        "start": 2087,
        "end": 2096
      },
      "text": "གཏན་ཚིགས་ ༼སྣར། པེ།༽ གཏན་ཚིག་"
    },
    {
      "span": {
        "start": 2767,
        "end": 2774
      },
      "text": "གསུམ་ལ་ ༼སྣར། པེ།༽ གསུམ་པ་"
    },
    {
      "span": {
        "start": 2969,
        "end": 2982
      },
      "text": "ཀུན་བརྟགས་པས་ ༼སྣར། པེ།༽ ཀུན་བརྟགས་པ་"
    },
    {
      "span": {
        "start": 3016,
        "end": 3029
      },
      "text": "རྣམ་པ་ཅན་གྱི་ ༼སྣར། པེ།༽ རྣམ་པ་ཅན་"
    },
    {
      "span": {
        "start": 3035,
        "end": 3048
      },
      "text": "པ་ཙམ་འདི་ཡོད་ ༼སྣར།༽ པའི་འདུ་ཤེས་འདི་ཡོད་ ༼པེ།༽ པའི་འདུ་ཤེས་འདི་མོད་"
    },
    {
      "span": {
        "start": 3077,
        "end": 3087
      },
      "text": "གྲོང་ཁྱེར་ ༼པེ།༽ གྲོང་"
    },
    {
      "span": {
        "start": 3301,
        "end": 3307
      },
      "text": "རང་གི་ ༼སྣར། པེ།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 3310,
        "end": 3314
      },
      "text": "བོས་ ༼སྣར། པེ།༽ བོ་"
    },
    {
      "span": {
        "start": 3550,
        "end": 3559
      },
      "text": "སྐྱེད་པར་ ༼སྣར།༽ བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 3573,
        "end": 3582
      },
      "text": "སྐྱེད་པར་ ༼སྣར། པེ།༽ བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 3582,
        "end": 3589
      },
      "text": "བྱེད་པ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 3596,
        "end": 3605
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 3813,
        "end": 3824
      },
      "text": "སྦྲུལ་གྱིས་ ༼སྣར། པེ།༽ སྦྲུལ་གྱི་"
    },
    {
      "span": {
        "start": 3829,
        "end": 3834
      },
      "text": "བཞིན་ ༼སྣར། པེ།༽ བཞི་"
    },
    {
      "span": {
        "start": 3857,
        "end": 3864
      },
      "text": "རྣམ་པར་ ༼སྣར། པེ།༽ རྣམ་པས་"
    },
    {
      "span": {
        "start": 3890,
        "end": 3895
      },
      "text": "གསུམ་ ༼སྣར། པེ།༽ གསུམ་པ་"
    },
    {
      "span": {
        "start": 3935,
        "end": 3939
      },
      "text": "གསལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 4049,
        "end": 4054
      },
      "text": "བསླང་ ༼སྣར། པེ།༽ སླང་"
    },
    {
      "span": {
        "start": 4085,
        "end": 4090
      },
      "text": "དཔྱད་ ༼སྣར། པེ།༽ སྤྱད་"
    },
    {
      "span": {
        "start": 4113,
        "end": 4124
      },
      "text": "སྦྲུལ་གྱིས་ ༼སྣར། པེ།༽ སྦྲུལ་གྱི་"
    },
    {
      "span": {
        "start": 4170,
        "end": 4179
      },
      "text": "སྐྱེད་པར་ ༼སྣར། པེ།༽ བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 4209,
        "end": 4217
      },
      "text": "བརྟགས་པ་ ༼སྣར། པེ།༽ བརྟག་པ་"
    },
    {
      "span": {
        "start": 4448,
        "end": 4452
      },
      "text": "བྱས། ༼སྣར། པེ།༽ བྱ།"
    },
    {
      "span": {
        "start": 4589,
        "end": 4599
      },
      "text": "བསྒྲུབ་པས་ ༼སྣར། པེ།༽ སྒྲུབ་པས་"
    },
    {
      "span": {
        "start": 4785,
        "end": 4794
      },
      "text": "ཚོལ་བ་ནས། ༼སྣར། པེ།༽ ཚོལ་བ་ན།"
    },
    {
      "span": {
        "start": 4940,
        "end": 4949
      },
      "text": "ཐུབ་པ་ཡི། ༼སྣར། པེ།༽ ཐུབ་པ་ཡིས།"
    },
    {
      "span": {
        "start": 4951,
        "end": 4967
      },
      "text": "བརྟུལ་ཞུགས་ཀྱིས་ ༼སྣར། པེ།༽ བརྟུལ་ཞུགས་ཀྱི་"
    },
    {
      "span": {
        "start": 5100,
        "end": 5110
      },
      "text": "སྤྱོད་པའི་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 5127,
        "end": 5142
      },
      "text": "བརྟུལ་ཞུགས་ཀྱི་ ༼སྣར། པེ།༽ བརྟུལ་ཞུགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 5344,
        "end": 5352
      },
      "text": "ཡིན་ནོ། ། ༼སྣར། པེ།༽ ཡིན་།། ། ༼སྣར།༽ །། །།སརྦ་མངྒཱ་ལཾ།། །། ༼པེ།༽ །། །།དགེའོ"
    }
  ]
}