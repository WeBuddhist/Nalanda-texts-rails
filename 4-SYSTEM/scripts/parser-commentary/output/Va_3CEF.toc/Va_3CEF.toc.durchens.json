{
  "durchens": [
    {
      "span": {
        "start": 308,
        "end": 312
      },
      "text": "གཞག་ ༼སྣར། པེ།༽ བཞག་"
    },
    {
      "span": {
        "start": 1476,
        "end": 1485
      },
      "text": "རྟོགས་པས་ ༼སྣར། པེ།༽ རྟོག་པས་"
    },
    {
      "span": {
        "start": 1770,
        "end": 1776
      },
      "text": "ན་ཞེས་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 1850,
        "end": 1854
      },
      "text": "པ་མ་ ༼སྣར། པེ།༽ པར་མ་"
    },
    {
      "span": {
        "start": 2316,
        "end": 2323
      },
      "text": "སྐྱེའོ་ ༼སྣར། པེ།༽ སྐྱེ་བོ་"
    },
    {
      "span": {
        "start": 2466,
        "end": 2474
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 2508,
        "end": 2517
      },
      "text": "སྣང་བ་ནི་ ༼སྣར། པེ།༽ སྣང་བའི་"
    },
    {
      "span": {
        "start": 2584,
        "end": 2588
      },
      "text": "ཡིད་ ༼སྣར། པེ།༽ ཡོད་"
    },
    {
      "span": {
        "start": 2600,
        "end": 2607
      },
      "text": "རིག་པར་ ༼སྣར། པེ།༽ རིག་པ་"
    },
    {
      "span": {
        "start": 2611,
        "end": 2616
      },
      "text": "བ་ནི་ ༼སྣར། པེ།༽ བའི་"
    },
    {
      "span": {
        "start": 2828,
        "end": 2833
      },
      "text": "རྟོག་ ༼སྣར། པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 2962,
        "end": 2968
      },
      "text": "ཙམ་དུ་ ༼སྣར། པེ།༽ ཙམ་"
    },
    {
      "span": {
        "start": 3016,
        "end": 3022
      },
      "text": "དེ་ཡེ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 3092,
        "end": 3094
      },
      "text": "ན་ ༼སྣར། པེ།༽ ན་ནི་"
    },
    {
      "span": {
        "start": 3668,
        "end": 3676
      },
      "text": "ད་ནི་ཡང་ ༼པེ།༽ ད་ནི་ཡང་ཡང་"
    },
    {
      "span": {
        "start": 3786,
        "end": 3792
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 3840,
        "end": 3846
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 3979,
        "end": 3982
      },
      "text": "ནས་ ༼སྣར། པེ།༽ ནས་དོན་མི་དམིགས་པ་སྐྱེའོ་དོན་མི་དམིགས་པ་ལ་བརྟེན་ནས་"
    },
    {
      "span": {
        "start": 4012,
        "end": 4021
      },
      "text": "སྐྱེ་སྟེ། ༼སྣར། པེ།༽ སྐྱེས་ཏེ།"
    },
    {
      "span": {
        "start": 4651,
        "end": 4672
      },
      "text": "བྱུང་། །ཞེས་བྱ་བའོ། ། ༼སྣར།༽ བྱུང་། ཞེ་བྱའོ་ ༼པེ།༽ འབྱུང་། ཞེས་བྱའོ་"
    },
    {
      "span": {
        "start": 4746,
        "end": 4754
      },
      "text": "རྣམས་ཏེ་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 4926,
        "end": 4933
      },
      "text": "བྱ་བའོ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 4973,
        "end": 4983
      },
      "text": "གཞན་དག་གི་ ༼སྣར། པེ།༽ གཞན་དག་གིས་"
    },
    {
      "span": {
        "start": 5089,
        "end": 5100
      },
      "text": "སྤྱོད་པ་ནི་ ༼སྣར། པེ།༽ སྤྱོད་པའི་"
    },
    {
      "span": {
        "start": 5380,
        "end": 5385
      },
      "text": "གཅོད་ ༼སྣར། པེ།༽ སྤྱོད་"
    },
    {
      "span": {
        "start": 5456,
        "end": 5459
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 5517,
        "end": 5527
      },
      "text": "ཡང་དག་མིན་ ༼སྣར། པེ།༽ ཡང་དག་མི་"
    },
    {
      "span": {
        "start": 6336,
        "end": 6386
      },
      "text": "། །རྣམ་གསུམ་ནི་ཉོན་མོངས་པའི་ཀུན་ནས་ཉོན་མོངས་པ་དང་། ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 6547,
        "end": 6552
      },
      "text": "པ་ནི་ ༼སྣར། པེ།༽ པའི་"
    },
    {
      "span": {
        "start": 6616,
        "end": 6622
      },
      "text": "ལྷག་མ་ ༼སྣར།༽ ལྷག་"
    },
    {
      "span": {
        "start": 6979,
        "end": 6989
      },
      "text": "འབེབས་པའི་ ༼སྣར། པེ།༽ འདེབས་པའི་"
    },
    {
      "span": {
        "start": 7072,
        "end": 7175
      },
      "text": "ཀུན་འཛིན་པའི་རྒྱུའོ། །རེག་པ་དང་ཚོར་བ་ནི་ཉེ་བར་སྤྱོད་པའི་རྒྱུའོ། །སྲེད་པ་དང་། ལེན་པ་དང་། སྲིད་པ་ནི་སྡུད་ ༼སྣར། པེ།༽ ཀུན་འཛིན་"
    },
    {
      "span": {
        "start": 7645,
        "end": 7652
      },
      "text": "ཀུན་ཏུ་ ༼སྣར། པེ།༽ ཀུན་"
    },
    {
      "span": {
        "start": 7868,
        "end": 7880
      },
      "text": "དངོས་མེད་དང་ ༼སྣར། པེ།༽ དངོས་མེད་པའི་"
    },
    {
      "span": {
        "start": 8338,
        "end": 8349
      },
      "text": "མཚན་ཉིད་དེ། ༼སྣར། པེ།༽ མཚན་ཉིད་དོ།"
    },
    {
      "span": {
        "start": 8421,
        "end": 8428
      },
      "text": "ཐ་དད་པ་ ༼སྣར། པེ།༽ ཐ་དད་"
    },
    {
      "span": {
        "start": 8762,
        "end": 8792
      },
      "text": "མཐའ། །མཚན་མ་མེད་དང་དོན་དམ་དང་། ༼སྣར། པེ།༽ མཐའ།"
    },
    {
      "span": {
        "start": 8896,
        "end": 8901
      },
      "text": "འགོག་ ༼སྣར། པེ།༽ འགགས་"
    },
    {
      "span": {
        "start": 9538,
        "end": 9549
      },
      "text": "དབྱེ་བ་སྟེ། ༼སྣར། པེ།༽ དབྱེ་བའོ།"
    },
    {
      "span": {
        "start": 9690,
        "end": 9694
      },
      "text": "གནས་ ༼སྣར། པེ།༽ ནས་"
    },
    {
      "span": {
        "start": 9761,
        "end": 9797
      },
      "text": "བཅས་པར་གྱུར་ལ་དྲི་མ་མེད་པར་ཡང་འགྱུར་ ༼སྣར། པེ།༽ བཅས་པར་གྱུར་"
    },
    {
      "span": {
        "start": 9953,
        "end": 9958
      },
      "text": "བྱའི་ ༼སྣར། པེ།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 10128,
        "end": 10140
      },
      "text": "ཆེན་པོ་སྟོང་ ༼སྣར། པེ།༽ སྟོང་"
    },
    {
      "span": {
        "start": 10142,
        "end": 10150
      },
      "text": "ཉིད་དང་། ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 10158,
        "end": 10162
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ ཉིད་དང་། ཆེན་པོ་"
    },
    {
      "span": {
        "start": 10246,
        "end": 10254
      },
      "text": "ཉིད་དང་། ༼སྣར།༽ ཉིད་"
    },
    {
      "span": {
        "start": 10268,
        "end": 10275
      },
      "text": "སྟོང་པ་ ༼སྣར།༽ སྟོང་"
    },
    {
      "span": {
        "start": 10371,
        "end": 10382
      },
      "text": "ཆོས་ཐམས་ཅད་ ༼སྣར། པེ།༽ རང་གི་མཚན་ཉིད་"
    },
    {
      "span": {
        "start": 10398,
        "end": 10412
      },
      "text": "རང་གི་མཚན་ཉིད་ ༼སྣར། པེ།༽ ཆོས་ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 10491,
        "end": 10498
      },
      "text": "ཉིད་དོ། ༼སྣར། པེ།༽ ཉིད་ནང་།"
    },
    {
      "span": {
        "start": 10559,
        "end": 10563
      },
      "text": "ལུས། ༼སྣར། པེ།༽ ཡུལ།"
    },
    {
      "span": {
        "start": 10715,
        "end": 10722
      },
      "text": "གཏང་བར་ ༼སྣར། པེ།༽ བཏང་བར་"
    },
    {
      "span": {
        "start": 10930,
        "end": 10938
      },
      "text": "རྣམས་ལས་ ༼སྣར། པེ།༽ རྣམས་"
    },
    {
      "span": {
        "start": 11239,
        "end": 11246
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 11313,
        "end": 11328
      },
      "text": "ཉིད་སྟོང་པ་ཉིད་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 11494,
        "end": 11502
      },
      "text": "བྱེད་ཅེ་ ༼སྣར། པེ།༽ བྱེད་"
    },
    {
      "span": {
        "start": 11618,
        "end": 11668
      },
      "text": "། །ཞེས་བྱ་བ་ནི་སེམས་ཅན་ལ་གཏན་དུ་ཕན་པར་བྱ་བའི་ཕྱིར་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 11680,
        "end": 11687
      },
      "text": "གཏང་བར་ ༼སྣར། པེ།༽ བཏང་བར་"
    },
    {
      "span": {
        "start": 11763,
        "end": 11768
      },
      "text": "སྐྱོ་ ༼སྣར། པེ།༽ སྐྱེ་"
    },
    {
      "span": {
        "start": 12292,
        "end": 12299
      },
      "text": "གཞག་པར་ ༼སྣར། པེ།༽ བཞག་པར་"
    },
    {
      "span": {
        "start": 12424,
        "end": 12426
      },
      "text": "པ། ༼སྣར། པེ།༽ ལ།"
    },
    {
      "span": {
        "start": 12459,
        "end": 12466
      },
      "text": "བྱ་བའོ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 12527,
        "end": 12533
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པའི་"
    },
    {
      "span": {
        "start": 12555,
        "end": 12564
      },
      "text": "ཡིན་ནོ། ། ༼སྣར། པེ།༽ སྟོང་པ་ཉིད་དོ།། །།"
    },
    {
      "span": {
        "start": 12883,
        "end": 12891
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར། པེ།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 13107,
        "end": 13116
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 13124,
        "end": 13135
      },
      "text": "གྱི་ཉེ་བའི་ ༼སྣར། པེ།༽ གྱི་"
    },
    {
      "span": {
        "start": 13364,
        "end": 13371
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ དེ་ལྟ་བས་"
    },
    {
      "span": {
        "start": 13391,
        "end": 13396
      },
      "text": "མོངས་ ༼སྣར། པེ།༽ རྨོངས་"
    },
    {
      "span": {
        "start": 13485,
        "end": 13498
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 13585,
        "end": 13597
      },
      "text": "གློ་བུར་གྱི་ ༼སྣར། པེ།༽ གློ་བུར་གྱིས་"
    },
    {
      "span": {
        "start": 13662,
        "end": 13672
      },
      "text": "བསྒྲུབས་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 13977,
        "end": 13987
      },
      "text": "ལ་སོགས་པས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 14015,
        "end": 14020
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 14250,
        "end": 14259
      },
      "text": "ཡིན་ནོ། ། ༼སྣར། པེ།༽ ཡིན་།། །།"
    },
    {
      "span": {
        "start": 14327,
        "end": 14336
      },
      "text": "བྱ་བ་སྟེ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 15413,
        "end": 15421
      },
      "text": "སུ་བྱེད་ ༼སྣར། པེ།༽ སུ་"
    },
    {
      "span": {
        "start": 15465,
        "end": 15471
      },
      "text": "ཇི་ལྟ་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 15518,
        "end": 15523
      },
      "text": "དེའི་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 15666,
        "end": 15671
      },
      "text": "འཇིག་ ༼སྣར།༽ འཇིགས་"
    },
    {
      "span": {
        "start": 15860,
        "end": 15875
      },
      "text": "ནི་འཇིག་ཚོགས་ལ་ ༼སྣར།༽ ནི་འཇིགས་ཚོགས་ ༼པེ།༽ ནི་འཇིག་ཚོགས་"
    },
    {
      "span": {
        "start": 16040,
        "end": 16053
      },
      "text": "འཇིག་ཚོགས་དང་ ༼སྣར། པེ།༽ འཇིག་ཚོགས་"
    },
    {
      "span": {
        "start": 16274,
        "end": 16285
      },
      "text": "ཐེ་ཚོམ་གྱི་ ༼སྣར། པེ།༽ ཐེ་ཚོམ་གྱིས་"
    },
    {
      "span": {
        "start": 17171,
        "end": 17179
      },
      "text": "དཔྱོད་པ་ ༼སྣར། པེ།༽ སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 17221,
        "end": 17225
      },
      "text": "གདུ་ ༼སྣར།༽ གདུང་"
    },
    {
      "span": {
        "start": 17439,
        "end": 17443
      },
      "text": "དགེ་ ༼པེ།༽ དགེ་བ་"
    },
    {
      "span": {
        "start": 19612,
        "end": 19618
      },
      "text": "བཙོ་བ་ ༼སྣར། པེ།༽ གཙོ་བོ་"
    },
    {
      "span": {
        "start": 19889,
        "end": 19894
      },
      "text": "དུ་བ་ ༼སྣར། པེ།༽ དུ་མ་"
    },
    {
      "span": {
        "start": 19924,
        "end": 19938
      },
      "text": "བྱེད་པའི་བྱེད་ ༼སྣར། པེ།༽ བྱེད་པའི་"
    },
    {
      "span": {
        "start": 19953,
        "end": 19962
      },
      "text": "དམ་བཅས་པ་ ༼སྣར། པེ།༽ དམ་བཅའ་བ་"
    },
    {
      "span": {
        "start": 20072,
        "end": 20079
      },
      "text": "སྐྱེ་བ་ ༼སྣར། པེ།༽ སྐྱེས་པ་"
    },
    {
      "span": {
        "start": 20115,
        "end": 20125
      },
      "text": "བསྐྱེད་པར་ ༼སྣར། པེ།༽ སྐྱེད་པར་"
    },
    {
      "span": {
        "start": 20257,
        "end": 20269
      },
      "text": "བྱང་ཆུབ་ཀྱི་ ༼སྣར། པེ།༽ བྱང་ཆུབ་"
    },
    {
      "span": {
        "start": 20433,
        "end": 20441
      },
      "text": "ལྡོག་པས་ ༼སྣར། པེ།༽ ལོག་པས་"
    },
    {
      "span": {
        "start": 20763,
        "end": 20769
      },
      "text": "སྒྲིབ་ ༼སྣར། པེ།༽ སྒྲིབ་པ་"
    },
    {
      "span": {
        "start": 20875,
        "end": 20883
      },
      "text": "ཐོབ་པའི་ ༼སྣར། པེ།༽ འཐོབ་པའི་"
    },
    {
      "span": {
        "start": 21001,
        "end": 21010
      },
      "text": "གོ་འབྱེད་ ༼སྣར།༽ གོ་བྱེད་"
    },
    {
      "span": {
        "start": 21031,
        "end": 21036
      },
      "text": "ཟས་ས་ ༼པེ།༽ ཟས་སམ་"
    },
    {
      "span": {
        "start": 21497,
        "end": 21510
      },
      "text": "སྤང་བའི་ཕྱིར་ ༼སྣར། པེ།༽ སྤང་བའི་"
    },
    {
      "span": {
        "start": 21969,
        "end": 21981
      },
      "text": "སྣ་ཚོགས་ཀྱི་ ༼སྣར། པེ།༽ སྣ་ཚོགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 22391,
        "end": 22401
      },
      "text": "གཉིས་ཀྱིས་ ༼སྣར། པེ།༽ གཉིས་ཀྱི་"
    },
    {
      "span": {
        "start": 22474,
        "end": 22477
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 22542,
        "end": 22550
      },
      "text": "བསྒོམ་པ་ ༼སྣར། པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 22666,
        "end": 22672
      },
      "text": "དེ་དག་ ༼སྣར། པེ།༽ དེ་དག་ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 22855,
        "end": 22863
      },
      "text": "ལེན་གྱི་ ༼སྣར། པེ།༽ ལེན་གྱིས་"
    },
    {
      "span": {
        "start": 23245,
        "end": 23251
      },
      "text": "དག་ནི་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 23253,
        "end": 23260
      },
      "text": "རོལ་ཏུ་ ༼སྣར། པེ།༽ རོལ་"
    },
    {
      "span": {
        "start": 23295,
        "end": 23315
      },
      "text": "སྒྲིབ་པས་དེའི་སྒྲིབ་ ༼སྣར། པེ།༽ སྒྲིབ་"
    },
    {
      "span": {
        "start": 23625,
        "end": 23634
      },
      "text": "འཕེལ་བ་ལ་ ༼སྣར། པེ།༽ འཕེལ་བ་"
    },
    {
      "span": {
        "start": 23951,
        "end": 23961
      },
      "text": "ཐམས་ཅད་དུ་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 24156,
        "end": 24164
      },
      "text": "བརྟགས་པ་ ༼སྣར།༽ རྟག་པ་ ༼པེ།༽ བརྟག་པ་"
    },
    {
      "span": {
        "start": 24167,
        "end": 24178
      },
      "text": "བསྒོམས་པའི་ ༼སྣར། པེ།༽ བསྒོམ་པའི་"
    },
    {
      "span": {
        "start": 24212,
        "end": 24224
      },
      "text": "ཟིལ་གྱིས་མི་ ༼སྣར། པེ།༽ ཟིལ་གྱིས་"
    },
    {
      "span": {
        "start": 24616,
        "end": 24624
      },
      "text": "བྲི་མེད་ ༼སྣར། པེ།༽ དྲི་མེད་"
    },
    {
      "span": {
        "start": 25250,
        "end": 25258
      },
      "text": "སྦྱོང་བ་ ༼སྣར། པེ།༽ སྦྱང་བ་"
    },
    {
      "span": {
        "start": 25580,
        "end": 25585
      },
      "text": "ལྡོག་ ༼སྣར། པེ།༽ རྟོག་"
    },
    {
      "span": {
        "start": 25600,
        "end": 25606
      },
      "text": "རྒྱུད་ ༼སྣར། པེ།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 25628,
        "end": 25637
      },
      "text": "རྟོགས་ཏེ། ༼སྣར། པེ།༽ རྟོག་སྟེ།"
    },
    {
      "span": {
        "start": 25638,
        "end": 25650
      },
      "text": "སེམས་དང་བསམ་ ༼སྣར། པེ།༽ རྣམ་པར་དག་"
    },
    {
      "span": {
        "start": 25652,
        "end": 25662
      },
      "text": "རྣམ་པར་དག་ ༼སྣར། པེ།༽ ལ་སེམས་དང་བསམ་"
    },
    {
      "span": {
        "start": 25670,
        "end": 25680
      },
      "text": "ཉིད་རྣམ་པ་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 25729,
        "end": 25743
      },
      "text": "། རྣམ་པར་དག་པ་ ༼སྣར། པེ།༽ རྣམ་པར་བྱང་བ་"
    },
    {
      "span": {
        "start": 25807,
        "end": 25811
      },
      "text": "ཀུན་ ༼སྣར། པེ།༽ ཀུན་ནས་"
    },
    {
      "span": {
        "start": 26305,
        "end": 26308
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 26352,
        "end": 26356
      },
      "text": "དང་། ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 27230,
        "end": 27232
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 27690,
        "end": 27696
      },
      "text": "རགས་པ་ ༼སྣར། པེ།༽ ཕྲ་བ་"
    },
    {
      "span": {
        "start": 27702,
        "end": 27707
      },
      "text": "ཕྲ་བ་ ༼སྣར། པེ།༽ རགས་པ་"
    },
    {
      "span": {
        "start": 27784,
        "end": 27788
      },
      "text": "རྣམ་ ༼པེ།༽ རྣམ་པ་"
    },
    {
      "span": {
        "start": 28180,
        "end": 28184
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམ་པ་བཅུ་པོ་དེ་ཡང་བདག་ཏུ་འཛིན་པ་རྣམ་"
    },
    {
      "span": {
        "start": 28326,
        "end": 28330
      },
      "text": "གནས་ ༼སྣར། པེ།༽ གནས་པ་"
    },
    {
      "span": {
        "start": 28530,
        "end": 28538
      },
      "text": "བརྟགས་པ་ ༼སྣར། པེ།༽ བརྟག་པ་"
    },
    {
      "span": {
        "start": 28622,
        "end": 28625
      },
      "text": "དེ་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 28843,
        "end": 28850
      },
      "text": "ཀུན་ཏུ་ ༼སྣར། པེ།༽ ཀུན་"
    },
    {
      "span": {
        "start": 28897,
        "end": 28902
      },
      "text": "ཅི་མ་ ༼སྣར། པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 28991,
        "end": 28997
      },
      "text": "དེ་ལྟ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 29455,
        "end": 29463
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 30009,
        "end": 30018
      },
      "text": "ཁོ་ན་དེར་ ༼སྣར། པེ།༽ ཁོ་ན་"
    },
    {
      "span": {
        "start": 30056,
        "end": 30059
      },
      "text": "བྱ་ ༼སྣར། པེ།༽ བྱའོ་"
    },
    {
      "span": {
        "start": 30124,
        "end": 30128
      },
      "text": "དྲི་ ༼སྣར། པེ།༽ དྲིར་"
    },
    {
      "span": {
        "start": 30274,
        "end": 30280
      },
      "text": "དྲི་མ་ ༼སྣར། པེ།༽ དྲི་"
    },
    {
      "span": {
        "start": 30651,
        "end": 30654
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་ཡི་"
    },
    {
      "span": {
        "start": 30863,
        "end": 30870
      },
      "text": "ཡེ་ཤེས་ ༼སྣར། པེ།༽ ཡེ་"
    },
    {
      "span": {
        "start": 30891,
        "end": 30896
      },
      "text": "དེ་མ་ ༼སྣར།༽ དེ་ ༼པེ།༽ -དེ་མ་"
    },
    {
      "span": {
        "start": 30990,
        "end": 30998
      },
      "text": "རང་བཞིན་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་དེ་"
    },
    {
      "span": {
        "start": 31207,
        "end": 31214
      },
      "text": "དབང་གི་ ༼སྣར། པེ།༽ དབང་གིས་"
    },
    {
      "span": {
        "start": 31376,
        "end": 31389
      },
      "text": "མཚན་ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ མཚན་ཉིད་"
    },
    {
      "span": {
        "start": 31648,
        "end": 31661
      },
      "text": "མཚན་ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ མཚན་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 32019,
        "end": 32031
      },
      "text": "ཀུན་འབྱུང་བ་ ༼སྣར། པེ།༽ ཀུན་འབྱུང་"
    },
    {
      "span": {
        "start": 32071,
        "end": 32078
      },
      "text": "ཇི་ལྟར་ ༼སྣར། པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 32376,
        "end": 32387
      },
      "text": "བག་ཆགས་ཀྱི་ ༼སྣར། པེ།༽ བག་ཆགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 32587,
        "end": 32597
      },
      "text": "གསུམ་གྱིས་ ༼སྣར། པེ།༽ གསུམ་གྱི་"
    },
    {
      "span": {
        "start": 32606,
        "end": 32640
      },
      "text": "བདེན་པ་སྟེ་འགོག་པ་རྣམ་པ་གསུམ་མོ། ། ༼སྣར། པེ།༽ བདེན་པ་ནི་"
    },
    {
      "span": {
        "start": 32873,
        "end": 32877
      },
      "text": "རྣམ་ ༼སྣར། པེ།༽ རྣམ་པ་"
    },
    {
      "span": {
        "start": 32906,
        "end": 32915
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 32971,
        "end": 32978
      },
      "text": "ལམ་གྱི་ ༼སྣར། པེ།༽ ལམ་གྱིས་"
    },
    {
      "span": {
        "start": 33025,
        "end": 33030
      },
      "text": "ཅེ་ན། ༼པེ།༽ ཅེ་ན་ཡོངས།"
    },
    {
      "span": {
        "start": 33302,
        "end": 33312
      },
      "text": "སྤང་བར་བྱ་ ༼སྣར། པེ།༽ སྤང་"
    },
    {
      "span": {
        "start": 33858,
        "end": 33867
      },
      "text": "དང་སྒྲུབ་ ༼སྣར། པེ།༽ བར་གྲུབ་"
    },
    {
      "span": {
        "start": 34303,
        "end": 34307
      },
      "text": "འདི་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 34858,
        "end": 34867
      },
      "text": "རིགས་པའི་ ༼སྣར། པེ།༽ རིག་པའི་"
    },
    {
      "span": {
        "start": 35422,
        "end": 35427
      },
      "text": "བསྡུ། ༼སྣར། པེ།༽ བསྡུས།"
    },
    {
      "span": {
        "start": 35588,
        "end": 35594
      },
      "text": "ཁོ་ནས་ ༼སྣར། པེ།༽ ཁོ་ནར་"
    },
    {
      "span": {
        "start": 35709,
        "end": 35776
      },
      "text": "ཁོ་ན་རྩ་བའི་དེ་ཁོ་ནར་ཇི་ལྟར་རིག་པར་བྱ་ཞེ་ན། རབ་ཏུ་དབྱེ་བའི་དེ་ཁོ་ན་ ༼སྣར། པེ།༽ ཁོ་ན་"
    },
    {
      "span": {
        "start": 35833,
        "end": 35865
      },
      "text": "དང་། རྣམ་པར་རིག་པའི་དེ་ཁོ་ན་དང་། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 35944,
        "end": 35953
      },
      "text": "ཡང་དག་པར་ ༼སྣར། པེ།༽ ཡང་དག་པ་"
    },
    {
      "span": {
        "start": 36070,
        "end": 36075
      },
      "text": "འཇུག་ ༼སྣར། པེ།༽ འཇུག་པའི་"
    },
    {
      "span": {
        "start": 37222,
        "end": 37227
      },
      "text": "འདུས་ ༼སྣར། པེ།༽ གསུངས་"
    },
    {
      "span": {
        "start": 37312,
        "end": 37317
      },
      "text": "བྱའོ། ༼སྣར། པེ།༽ བྱ་བའོ།"
    },
    {
      "span": {
        "start": 37325,
        "end": 37334
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 37422,
        "end": 37428
      },
      "text": "བརྟགས་ ༼སྣར།༽ བརྟག་"
    },
    {
      "span": {
        "start": 37475,
        "end": 37482
      },
      "text": "ཉིད་དེ། ༼སྣར། པེ།༽ ཉིད་དོ།"
    },
    {
      "span": {
        "start": 37546,
        "end": 37556
      },
      "text": "གཟུགས་ཀྱི་ ༼སྣར། པེ།༽ གཟུགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 37697,
        "end": 37706
      },
      "text": "དེ་ལྟར་ན་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 38059,
        "end": 38066
      },
      "text": "དོན་ནི་ ༼སྣར། པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 38072,
        "end": 38078
      },
      "text": "གང་ཅི་ ༼སྣར། པེ།༽ དག་ཅི་"
    },
    {
      "span": {
        "start": 39047,
        "end": 39089
      },
      "text": "དོན་ནི་རྟེན་ཅིང་འབྲེལ་བར་འབྱུང་བའི་དོན་ཏོ། ༼སྣར། པེ།༽ དོན་ནོ།"
    },
    {
      "span": {
        "start": 39996,
        "end": 40004
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 40356,
        "end": 40364
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 40614,
        "end": 40621
      },
      "text": "བསོད་པ་ ༼སྣར། པེ།༽ གསོད་པ་"
    },
    {
      "span": {
        "start": 40764,
        "end": 40769
      },
      "text": "བྱའོ། ༼སྣར། པེ།༽ བྱེད་པའོ།"
    },
    {
      "span": {
        "start": 41045,
        "end": 41060
      },
      "text": "པོ་དབང་བྱེད་དེ། ༼སྣར། པེ།༽ པོ་བྱེད་དོ་"
    },
    {
      "span": {
        "start": 41100,
        "end": 41107
      },
      "text": "འཚོབ་པ་ ༼སྣར། པེ།༽ འཚོ་བ་"
    },
    {
      "span": {
        "start": 41289,
        "end": 41303
      },
      "text": "འཇིག་རྟེན་པའི་ ༼སྣར། པེ།༽ འཇིག་རྟེན་པར་"
    },
    {
      "span": {
        "start": 41754,
        "end": 41762
      },
      "text": "དེ་ཞི་བ་ ༼སྣར། པེ།༽ དེ་བཞིན་པ་"
    },
    {
      "span": {
        "start": 42303,
        "end": 42308
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 42337,
        "end": 42344
      },
      "text": "ཡོན་ཏན་ ༼སྣར། པེ།༽ ཡོན་ཏན་དང་"
    },
    {
      "span": {
        "start": 42592,
        "end": 42597
      },
      "text": "བཏགས་ ༼སྣར། པེ།༽ བརྟགས་"
    },
    {
      "span": {
        "start": 42818,
        "end": 42821
      },
      "text": "དང་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 42919,
        "end": 42926
      },
      "text": "བཏགས་པ་ ༼སྣར། པེ།༽ བརྟགས་པ་"
    },
    {
      "span": {
        "start": 43349,
        "end": 43360
      },
      "text": "དེ་ལྟར་དོན་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 43429,
        "end": 43432
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་ལ་"
    },
    {
      "span": {
        "start": 43716,
        "end": 43724
      },
      "text": "སྣང་བའི་ ༼སྣར། པེ།༽ སྣང་བ་"
    },
    {
      "span": {
        "start": 43748,
        "end": 43755
      },
      "text": "ཐེག་པས་ ༼སྣར། པེ།༽ ཐེག་པའི་"
    },
    {
      "span": {
        "start": 43948,
        "end": 43955
      },
      "text": "ཕས་ཀྱི་ ༼སྣར། པེ།༽ ཕས་"
    },
    {
      "span": {
        "start": 44014,
        "end": 44022
      },
      "text": "བརྗོད་པ་ ༼སྣར། པེ།༽ བརྗོད་པའི་"
    },
    {
      "span": {
        "start": 44378,
        "end": 44382
      },
      "text": "ཐ་མ། ༼སྣར། པེ།༽ ཐ་མའོ།"
    },
    {
      "span": {
        "start": 44490,
        "end": 44495
      },
      "text": "སྲེད་ ༼སྣར། པེ།༽ སྲད་"
    },
    {
      "span": {
        "start": 44870,
        "end": 44878
      },
      "text": "རྒྱུ་ནི་ ༼སྣར། པེ།༽ རྒྱུ་"
    },
    {
      "span": {
        "start": 45051,
        "end": 45059
      },
      "text": "འཇིགས་པ་ ༼སྣར། པེ།༽ འཇིག་པ་"
    },
    {
      "span": {
        "start": 45373,
        "end": 45384
      },
      "text": "ཡོངས་ཤེས་ན། ༼སྣར། པེ།༽ ཡོངས་ཤེས་ནས།"
    },
    {
      "span": {
        "start": 45495,
        "end": 45509
      },
      "text": "གཉེན་པོ་རྣམ་པ་ ༼སྣར། པེ།༽ གཉེན་པོ་"
    },
    {
      "span": {
        "start": 45527,
        "end": 45533
      },
      "text": "ཤེས་ན། ༼སྣར། པེ།༽ ཤེས་ནས།"
    },
    {
      "span": {
        "start": 45552,
        "end": 45556
      },
      "text": "གསལ་ ༼སྣར། པེ།༽ བསལ་"
    },
    {
      "span": {
        "start": 45645,
        "end": 45653
      },
      "text": "སྐྱེས་པ་ ༼སྣར། པེ།༽ སྐྱེས་པས་"
    },
    {
      "span": {
        "start": 45695,
        "end": 45699
      },
      "text": "དེར་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 45795,
        "end": 45803
      },
      "text": "རྒྱུ་ལས་ ༼སྣར། པེ།༽ རྒྱུ་ལ་"
    },
    {
      "span": {
        "start": 45817,
        "end": 45825
      },
      "text": "སྤང་བའི་ ༼སྣར། པེ།༽ སྤངས་པའི་"
    },
    {
      "span": {
        "start": 46152,
        "end": 46162
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ བསྒོམས་པའི་"
    },
    {
      "span": {
        "start": 46308,
        "end": 46311
      },
      "text": "དེ། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 46330,
        "end": 46338
      },
      "text": "འདོད་དོ། ༼སྣར། པེ།༽ འདོད་དེ།"
    },
    {
      "span": {
        "start": 46510,
        "end": 46518
      },
      "text": "སྤང་བའི་ ༼སྣར། པེ།༽ སྤངས་པའི་"
    },
    {
      "span": {
        "start": 47215,
        "end": 47220
      },
      "text": "སྤོང་ ༼སྣར། པེ།༽ སྤང་"
    },
    {
      "span": {
        "start": 47660,
        "end": 47664
      },
      "text": "དང་། ༼སྣར། པེ།༽ དེ།"
    },
    {
      "span": {
        "start": 47748,
        "end": 47754
      },
      "text": "སྙེགས་ ༼སྣར།༽ སྙེམས་ ༼པེ།༽ སྙམ་སེམས་"
    },
    {
      "span": {
        "start": 48155,
        "end": 48163
      },
      "text": "སྲབ་པའི་ ༼སྣར། པེ།༽ བསྲབས་པའི་"
    },
    {
      "span": {
        "start": 48163,
        "end": 48168
      },
      "text": "ཕྱིར། ༼སྣར། པེ།༽ ཕྱིར་རོ། །"
    },
    {
      "span": {
        "start": 48200,
        "end": 48275
      },
      "text": "དད་པ་ལ་སོགས་པ་མི་མཐུན་པའི་ཕྱོགས་དང་མི་འདྲེ་བ་ནའོ། །ཅིའི་ཕྱིར་དད་པ་ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 48328,
        "end": 48349
      },
      "text": "རྒྱུ་དང་འབྲས་བུ་ལ་དད་ ༼སྣར། པེ།༽ དད་"
    },
    {
      "span": {
        "start": 48352,
        "end": 48367
      },
      "text": "གྱུར་པའི་རྒྱུས་ ༼སྣར། པེ།༽ གྱུར་པ་དེ་རྒྱུ་དང་"
    },
    {
      "span": {
        "start": 48411,
        "end": 48420
      },
      "text": "བརྩམས་པས་ ༼སྣར། པེ།༽ བརྩམས་པ་"
    },
    {
      "span": {
        "start": 48423,
        "end": 48463
      },
      "text": "དྲན་པ་ཉེ་བར་གནས་སོ། །དྲན་པ་ཉེ་བར་གནས་པས་ ༼སྣར། པེ།༽ ཉེ་བར་གནས་པ་"
    },
    {
      "span": {
        "start": 48500,
        "end": 48507
      },
      "text": "གཞག་པས་ ༼སྣར། པེ།༽ གཞག་པ་"
    },
    {
      "span": {
        "start": 48802,
        "end": 48805
      },
      "text": "ཚེ་ ༼སྣར། པེ།༽ ཚེ་དབང་པོ་རྣམས་ལ། ངེས་འབྱེད་ཆ་མཐུན་གཉིས་གཉིས་སོ་དྲོ་བར་གྱུར་པ་རྣམས་དང་རྩེ་མོ་དག་གིས་ཚེ་"
    },
    {
      "span": {
        "start": 49103,
        "end": 49112
      },
      "text": "ཡན་ལག་ཏུ་ ༼སྣར། པེ།༽ ཡན་ལག་བདུན་དུ་"
    },
    {
      "span": {
        "start": 49193,
        "end": 49241
      },
      "text": "གོ། །ཆོས་རྣམ་པར་འབྱེད་པ་ནི་རང་བཞིན་གྱི་ཡན་ལག་གོ། ༼སྣར། པེ།༽ གོ།"
    },
    {
      "span": {
        "start": 50193,
        "end": 50199
      },
      "text": "ངག་གི་ ༼སྣར། པེ།༽ ངག་གིས་"
    },
    {
      "span": {
        "start": 50618,
        "end": 50626
      },
      "text": "ཀྱིས་གས་ ༼སྣར། པེ།༽ ཀྱི་གོས་"
    },
    {
      "span": {
        "start": 50847,
        "end": 50857
      },
      "text": "གཉེན་པོའོ། ༼སྣར། པེ།༽ གཉེན་པའོ།"
    },
    {
      "span": {
        "start": 50961,
        "end": 50978
      },
      "text": "རྒོད་པའི་དབང་གིས་ ༼སྣར། པེ།༽ རྒོད་པ་དང་དབང་གི་"
    },
    {
      "span": {
        "start": 51380,
        "end": 51390
      },
      "text": "མདོར་བསྡུ་ ༼སྣར། པེ།༽ མདོར་བསྡུས་"
    },
    {
      "span": {
        "start": 51704,
        "end": 51712
      },
      "text": "སོ་སོའི་ ༼སྣར། པེ།༽ སོ་སོ་"
    },
    {
      "span": {
        "start": 51787,
        "end": 51799
      },
      "text": "རྣམས་ཀྱི་ནི། ༼སྣར། པེ།༽ རྣམས་ཀྱི།"
    },
    {
      "span": {
        "start": 51801,
        "end": 51807
      },
      "text": "དམིགས་ ༼སྣར། པེ།༽ དམིགས་པ་"
    },
    {
      "span": {
        "start": 51836,
        "end": 51842
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 51846,
        "end": 51849
      },
      "text": "པར་ ༼སྣར། པེ།༽ པར་དུ་"
    },
    {
      "span": {
        "start": 52353,
        "end": 52361
      },
      "text": "ཡིན་གྱི། ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 52499,
        "end": 52507
      },
      "text": "འབྲས་བུ་ ༼སྣར། པེ།༽ འབྲས་བུར་"
    },
    {
      "span": {
        "start": 52686,
        "end": 52695
      },
      "text": "བསྒྲུབ་པ་ ༼སྣར། པེ།༽ སྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 52863,
        "end": 52867
      },
      "text": "ཐོབ་ ༼སྣར། པེ།༽ ཐོས་"
    },
    {
      "span": {
        "start": 53033,
        "end": 53045
      },
      "text": "ལ་སོགས་པ་བས་ ༼སྣར། པེ།༽ ལ་སོགས་པས་"
    },
    {
      "span": {
        "start": 53057,
        "end": 53075
      },
      "text": "བྱང་ཆུབ་སེམས་དཔའོ། ༼སྣར། པེ།༽ བྱང་ཆུབ་པའོ།"
    },
    {
      "span": {
        "start": 54188,
        "end": 54198
      },
      "text": "གྱུར་པ་དེ་ ༼སྣར། པེ།༽ གྱུར་པ་"
    },
    {
      "span": {
        "start": 54822,
        "end": 54826
      },
      "text": "མའི་ ༼སྣར། པེ།༽ མ་"
    },
    {
      "span": {
        "start": 55485,
        "end": 55494
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 55813,
        "end": 55822
      },
      "text": "སྒོམ་པའི་ ༼སྣར། པེ།༽ བསྒོམ་པའི་"
    },
    {
      "span": {
        "start": 55873,
        "end": 55880
      },
      "text": "སྒོམ་པ་ ༼པེ།༽ བསྒོམས་པ་"
    },
    {
      "span": {
        "start": 55893,
        "end": 55901
      },
      "text": "སྦྱང་བར་ ༼སྣར། པེ།༽ སྦྱང་བ་"
    },
    {
      "span": {
        "start": 55916,
        "end": 55956
      },
      "text": "དང་། གོང་མ་ཡང་དག་པར་རྩོམ་པའི་སྒོམ་པ་དང་། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 56036,
        "end": 56043
      },
      "text": "སྒོམ་པ་ ༼སྣར། པེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 56056,
        "end": 56063
      },
      "text": "སྒོམ་པ་ ༼སྣར། པེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 56075,
        "end": 56082
      },
      "text": "སྒོམ་པ་ ༼སྣར། པེ།༽ བསྒོམ་པ་"
    },
    {
      "span": {
        "start": 56494,
        "end": 56521
      },
      "text": "ཀྱི་དོན་བསྡུས་པ་ནི་བསྡུས་པ་ ༼སྣར། པེ།༽ དོན་བསྡུས་པ་"
    },
    {
      "span": {
        "start": 56582,
        "end": 56591
      },
      "text": "བསྒྲུབ་པ་ ༼པེ།༽ བསྒྲུབས་པ་"
    },
    {
      "span": {
        "start": 56734,
        "end": 56738
      },
      "text": "གོང་ ༼སྣར། པེ།༽ གྲོང་"
    },
    {
      "span": {
        "start": 56741,
        "end": 56745
      },
      "text": "གོང་ ༼སྣར། པེ།༽ གྲོང་"
    },
    {
      "span": {
        "start": 58144,
        "end": 58151
      },
      "text": "གཟུང་བ་ ༼སྣར། པེ།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 58421,
        "end": 58426
      },
      "text": "པ་ནི་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 58791,
        "end": 58799
      },
      "text": "ཙམ་གྱིས་ ༼སྣར། པེ།༽ ཙམ་གྱི་"
    },
    {
      "span": {
        "start": 59292,
        "end": 59302
      },
      "text": "དེའི་ཕྱིར་ ༼སྣར། པེ།༽ དེ་ཕྱིར་"
    },
    {
      "span": {
        "start": 59318,
        "end": 59321
      },
      "text": "ནི། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 59359,
        "end": 59370
      },
      "text": "དམ་པ་རྣམ་པ་ ༼སྣར། པེ།༽ དམ་པ་"
    },
    {
      "span": {
        "start": 59408,
        "end": 59413
      },
      "text": "ཕྱིར་ ༼སྣར། པེ།༽ ཕྱིར་རོ་"
    },
    {
      "span": {
        "start": 59455,
        "end": 59462
      },
      "text": "བཅུ་པོ་ ༼སྣར། པེ།༽ དྲུག་པོ་"
    },
    {
      "span": {
        "start": 59511,
        "end": 59520
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 59659,
        "end": 59663
      },
      "text": "བཅུ། ༼སྣར། པེ།༽ བཅུའོ།"
    },
    {
      "span": {
        "start": 60049,
        "end": 60060
      },
      "text": "གཞན་དག་གིས་ ༼སྣར། པེ།༽ གཞན་དག་གི་"
    },
    {
      "span": {
        "start": 60468,
        "end": 60478
      },
      "text": "འབྱུང་བ་ལ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 60580,
        "end": 60590
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ སྒོམ་པའི་"
    },
    {
      "span": {
        "start": 60633,
        "end": 60645
      },
      "text": "གྱིས་མི་ནོན་ ༼སྣར། པེ།༽ གྱིས་གནོན་"
    },
    {
      "span": {
        "start": 60725,
        "end": 60734
      },
      "text": "ལ་སྒྲ་ཇི་ ༼སྣར། པེ།༽ ལ་དགྲ་"
    },
    {
      "span": {
        "start": 60960,
        "end": 60968
      },
      "text": "བཏགས་པར་ ༼སྣར། པེ།༽ བཏགས་པ་"
    },
    {
      "span": {
        "start": 61025,
        "end": 61029
      },
      "text": "ཡིད་ ༼སྣར། པེ།༽ ཡིད་ལ་"
    },
    {
      "span": {
        "start": 61160,
        "end": 61169
      },
      "text": "བྱུང་བའི་ ༼པེ།༽ བྱུང་བའི་ཡེ་"
    },
    {
      "span": {
        "start": 61299,
        "end": 61304
      },
      "text": "བརྟས་ ༼སྣར། པེ།༽ རྟས་"
    },
    {
      "span": {
        "start": 61408,
        "end": 61416
      },
      "text": "བརྟས་པར་ ༼སྣར། པེ།༽ རྟས་པར་"
    },
    {
      "span": {
        "start": 61427,
        "end": 61434
      },
      "text": "བསམས་པ་ ༼སྣར། པེ།༽ བསམས་པ་པ་"
    },
    {
      "span": {
        "start": 61448,
        "end": 61459
      },
      "text": "ཐོས་པ་དེའི་ ༼སྣར། པེ།༽ ཐོས་པ་"
    },
    {
      "span": {
        "start": 61644,
        "end": 61656
      },
      "text": "སྒྲུབ་པ་སྟེ། ༼པེ།༽ སྒྲུབ་པར་བྱ།"
    },
    {
      "span": {
        "start": 61840,
        "end": 61849
      },
      "text": "སྒོམ་པའོ། ༼སྣར། པེ།༽ བསྒོམ་པ་དང་།"
    },
    {
      "span": {
        "start": 61866,
        "end": 61872
      },
      "text": "ཡི་གེ་ ༼སྣར། པེ།༽ ཡི་གེར་"
    },
    {
      "span": {
        "start": 62129,
        "end": 62148
      },
      "text": "ཀྱི་ཆོས་སྤྱོད་པ་ནི་ ༼སྣར། པེ།༽ ཆོས་སྤྱོད་པ་"
    },
    {
      "span": {
        "start": 62614,
        "end": 62656
      },
      "text": "། །རྣམ་པ་འདི་གཉིས་ནི་རྗེས་སུ་མཐུན་པའི་ཆོས་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 62740,
        "end": 62747
      },
      "text": "གཡེང་བ་ ༼སྣར།༽ གཡེང་བ་ནི་"
    },
    {
      "span": {
        "start": 63148,
        "end": 63156
      },
      "text": "སེམས་ནི་ ༼སྣར། པེ།༽ སེམས་ཀྱི་"
    },
    {
      "span": {
        "start": 63266,
        "end": 63275
      },
      "text": "སེམས་དཔས་ ༼སྣར། པེ།༽ སེམས་དཔའ་"
    },
    {
      "span": {
        "start": 63297,
        "end": 63302
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 63453,
        "end": 63462
      },
      "text": "འཛིན་གྱི་ ༼སྣར། པེ།༽ འཛིན་གྱིས་"
    },
    {
      "span": {
        "start": 63641,
        "end": 63643
      },
      "text": "ན་ ༼སྣར།༽ ནི་"
    },
    {
      "span": {
        "start": 63736,
        "end": 63744
      },
      "text": "ཕྱིར་རོ། ༼སྣར། པེ།༽ ཕྱིར།"
    },
    {
      "span": {
        "start": 64048,
        "end": 64054
      },
      "text": "འདྲིས་ ༼སྣར། པེ།༽ འདྲེས་"
    },
    {
      "span": {
        "start": 64083,
        "end": 64089
      },
      "text": "འདྲིས་ ༼སྣར། པེ།༽ འདྲེས་"
    },
    {
      "span": {
        "start": 64130,
        "end": 64133
      },
      "text": "གེ་ ༼སྣར། པེ།༽ གེར་"
    },
    {
      "span": {
        "start": 64425,
        "end": 64433
      },
      "text": "ཡོད་པ་མ་ ༼སྣར།༽ ཡོད་པ་"
    },
    {
      "span": {
        "start": 64556,
        "end": 64779
      },
      "text": "། །ཇི་ལྟར་སྣང་བ་དེ་ལྟར་ནི་ཡོད་པ་མ་ཡིན་ཏེ། དེ་ལྟར་དོན་ལ་མཐོང་བ་གང་ཡིན་པ་དེ་ནི་དེ་ལ་ཕྱིན་ཅི་མ་ལོག་པའོ། །དོན་གྱི་ཡོད་པ་སྤངས་པ་ནི་གཟུང་བ་དང་འཛིན་པ་དངོས་པོ་མེད་པའི་ཕྱིར་རོ། །མེད་པ་སྤངས་པ་ནི་དེར་སྣང་བའི་འཁྲུལ་པ་ཡོད་པའི་ཕྱིར་རོ། ། ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 64801,
        "end": 64804
      },
      "text": "ཡི། ༼སྣར། པེ།༽ ནི།"
    },
    {
      "span": {
        "start": 65209,
        "end": 65217
      },
      "text": "དོན་གྱི་ ༼སྣར། པེ།༽ དོན་གྱིས་"
    },
    {
      "span": {
        "start": 65298,
        "end": 65304
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 65357,
        "end": 65362
      },
      "text": "ཐག་པ་ ༼སྣར། པེ།༽ ཐག་"
    },
    {
      "span": {
        "start": 65956,
        "end": 65963
      },
      "text": "མིང་ཙམ་ ༼སྣར། པེ།༽ མི་གཙང་"
    },
    {
      "span": {
        "start": 66040,
        "end": 66056
      },
      "text": "རྣམས་ཞེས་བྱ་བའི་ ༼སྣར། པེ།༽ རྣམས་ཤེས་བྱའི་"
    },
    {
      "span": {
        "start": 67023,
        "end": 67031
      },
      "text": "བཞིན་དུ་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 67227,
        "end": 67231
      },
      "text": "གི ། ༼སྣར། པེ།༽ གིས། །"
    },
    {
      "span": {
        "start": 67280,
        "end": 67286
      },
      "text": "དང་ང་། ༼སྣར། པེ།༽ དང་ངོ་།"
    },
    {
      "span": {
        "start": 67305,
        "end": 67313
      },
      "text": "ལོག་པའོ། ༼སྣར། པེ།༽ ལོག་པ།"
    },
    {
      "span": {
        "start": 67542,
        "end": 67550
      },
      "text": "འགྲིབ་པ་ ༼སྣར། པེ།༽ འགྲུབ་པ་"
    },
    {
      "span": {
        "start": 68113,
        "end": 68132
      },
      "text": "ནི་ངོ་བོ་ཉིད་དེ་ངོ་ ༼སྣར། པེ།༽ ནི་ངོ་"
    },
    {
      "span": {
        "start": 68139,
        "end": 68153
      },
      "text": "རྣམ་པ་གསུམ་དང་ ༼སྣར། པེ།༽ རྣམ་གསུམ་"
    },
    {
      "span": {
        "start": 68355,
        "end": 68364
      },
      "text": "གཉིས་ཀྱི་ ༼སྣར། པེ།༽ གཉིས་ཀྱིས་"
    },
    {
      "span": {
        "start": 68486,
        "end": 68494
      },
      "text": "གཞན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱིས་"
    },
    {
      "span": {
        "start": 68710,
        "end": 68716
      },
      "text": "ཤེས་པ་ ༼སྣར། པེ།༽ ཤེས་བྱ་"
    },
    {
      "span": {
        "start": 68812,
        "end": 68819
      },
      "text": "རིག་པར་ ༼སྣར།༽ རིགས་པར་"
    },
    {
      "span": {
        "start": 68932,
        "end": 68944
      },
      "text": "མཚན་ཉིད་ཀྱི་ ༼སྣར། པེ།༽ མཚན་ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 69043,
        "end": 69053
      },
      "text": "དུ་མི་རུང་ ༼སྣར། པེ།༽ དུ་རིང་"
    },
    {
      "span": {
        "start": 69222,
        "end": 69224
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 69307,
        "end": 69314
      },
      "text": "རེག་པར་ ༼སྣར། པེ།༽ རིག་པར་"
    },
    {
      "span": {
        "start": 69481,
        "end": 69487
      },
      "text": "དག་གི་ ༼སྣར། པེ།༽ དག་གིས་"
    },
    {
      "span": {
        "start": 69610,
        "end": 69618
      },
      "text": "འགྲིབ་པ་ ༼སྣར། པེ།༽ འགྲུབ་པ་"
    },
    {
      "span": {
        "start": 69924,
        "end": 69934
      },
      "text": "རྡོ་རྗེའི་ ༼སྣར། པེ།༽ རྡོ་རྗེ་"
    },
    {
      "span": {
        "start": 69987,
        "end": 69994
      },
      "text": "ཟིན་ཏོ། ༼སྡེ།༽ ཟིན་ཏེ།"
    },
    {
      "span": {
        "start": 70005,
        "end": 70011
      },
      "text": "སྤང་བ་ ༼སྣར། པེ།༽ སྤངས་པ་"
    },
    {
      "span": {
        "start": 70099,
        "end": 70109
      },
      "text": "རིག་པར་བྱ་ ༼སྣར། པེ།༽ རིག་པར་"
    },
    {
      "span": {
        "start": 70212,
        "end": 70217
      },
      "text": "རྣམས་ ༼སྣར། པེ།༽ རྣམ་"
    },
    {
      "span": {
        "start": 70250,
        "end": 70255
      },
      "text": "གཉེན་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 70313,
        "end": 70322
      },
      "text": "ཉོན་མོངས། ༼སྣར། པེ།༽ སྙོམས་དང་།"
    },
    {
      "span": {
        "start": 70453,
        "end": 70461
      },
      "text": "བྱ་དེ་ལ་ ༼སྣར། པེ།༽ བྱ་དེ་ལས་"
    },
    {
      "span": {
        "start": 70668,
        "end": 70676
      },
      "text": "སྤང་བའི་ ༼སྣར། པེ།༽ སྤངས་པའི་"
    },
    {
      "span": {
        "start": 70711,
        "end": 70725
      },
      "text": "སོ་སོར་རྟོག་པ་ ༼སྣར།༽ སོ་སོར་ཏོགས་ ༼པེ།༽ སོ་སོར་རྟོགས་"
    },
    {
      "span": {
        "start": 70829,
        "end": 70836
      },
      "text": "ལུས་དེ་ ༼སྣར། པེ།༽ ལུས་"
    },
    {
      "span": {
        "start": 71021,
        "end": 71028
      },
      "text": "རྟག་པར་ ༼སྣར། པེ།༽ རྟག་པ་"
    },
    {
      "span": {
        "start": 71161,
        "end": 71171
      },
      "text": "བརྟགས་པའི་ ༼སྣར། པེ།༽ བཏགས་པའི་"
    },
    {
      "span": {
        "start": 71171,
        "end": 71177
      },
      "text": "ཡོད་པ་ ༼པེ།༽ ཡོ་བྱད་"
    },
    {
      "span": {
        "start": 71847,
        "end": 71855
      },
      "text": "བྱ་བ་ནི་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 72134,
        "end": 72146
      },
      "text": "། །འཛིན་པའོ་ ༼སྣར། པེ།༽ ། །"
    },
    {
      "span": {
        "start": 72570,
        "end": 72583
      },
      "text": "ཉོན་མོངས་པའོ། ༼སྣར། པེ།༽ ཉོན་མོངས་པ་དང་།"
    },
    {
      "span": {
        "start": 72983,
        "end": 72993
      },
      "text": "སྐྱེས་པའི་ ༼སྣར། པེ།༽ སྐྱེ་བའི་"
    },
    {
      "span": {
        "start": 73037,
        "end": 73044
      },
      "text": "བྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་བ་"
    },
    {
      "span": {
        "start": 73647,
        "end": 73652
      },
      "text": "ལ་ནི་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 73734,
        "end": 73739
      },
      "text": "ཕྱིར་ ༼སྣར། པེ།༽ ཕྱིར་རོ་"
    },
    {
      "span": {
        "start": 73794,
        "end": 73799
      },
      "text": "བྱེད་ ༼སྣར། པེ།༽ བྱེད་མོད་"
    },
    {
      "span": {
        "start": 73922,
        "end": 73992
      },
      "text": "ཡོད་པར་རྣམ་པར་རྟོག་པ་ཡང་མཐའོ། །དངོས་པོ་མེད་པར་རྣམ་པར་རྟོག་པ་ཡང་མཐའོ། ། ༼སྣར།༽ ཡོད་པར་རྣམས་པར་རྟོག་པ་ཡང་མཐའོ། ། ༼པེ།༽ ཡོད་པར་རྣམ་པར་རྟོག་པ་ཡང་མཐའོ། །"
    },
    {
      "span": {
        "start": 73998,
        "end": 74005
      },
      "text": "ཡོད་དེ་ ༼སྣར། པེ།༽ ཡོད་དོ་"
    },
    {
      "span": {
        "start": 74320,
        "end": 74325
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བར་"
    },
    {
      "span": {
        "start": 74354,
        "end": 74361
      },
      "text": "རྣམ་པར་ ༼སྣར། པེ།༽ རྣམ་པ་"
    },
    {
      "span": {
        "start": 74434,
        "end": 74443
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 74498,
        "end": 74506
      },
      "text": "སྤང་བའི་ ༼སྣར། པེ།༽ སྤངས་པའི་"
    },
    {
      "span": {
        "start": 74636,
        "end": 74641
      },
      "text": "དངངས་ ༼སྣར། པེ།༽ དངས་"
    },
    {
      "span": {
        "start": 74730,
        "end": 74738
      },
      "text": "སྤང་བའི་ ༼སྣར། པེ།༽ སྤངས་པའི་"
    },
    {
      "span": {
        "start": 75523,
        "end": 75527
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ གཉིས་"
    },
    {
      "span": {
        "start": 75821,
        "end": 75833
      },
      "text": "མཚན་ཉིད་ཀྱང་ ༼སྣར། པེ།༽ མཚན་ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 75955,
        "end": 75965
      },
      "text": "ཡེ་ཤེས་ནི་ ༼སྣར། པེ།༽ ཡེ་ཤེས་"
    },
    {
      "span": {
        "start": 76390,
        "end": 76398
      },
      "text": "ཁྱད་མེད་ ༼སྣར། པེ།༽ ཁྱད་པར་མེད་པ་"
    },
    {
      "span": {
        "start": 76522,
        "end": 76525
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 76641,
        "end": 76648
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 76908,
        "end": 76937
      },
      "text": "དང་། བསྒྲུབ་བྱའི་དམིགས་པ་དང་། ༼སྣར། པེ།༽ དང་།"
    },
    {
      "span": {
        "start": 77046,
        "end": 77056
      },
      "text": "རྟོགས་པའི་ ༼སྣར། པེ།༽ རྟོག་པའི་"
    },
    {
      "span": {
        "start": 77177,
        "end": 77187
      },
      "text": "དམིགས་པའོ། ༼པེ།༽ དམིགས་སོ།"
    },
    {
      "span": {
        "start": 77354,
        "end": 77363
      },
      "text": "རྟོགས་པས་ ༼པེ།༽ རྟོག་པས་"
    },
    {
      "span": {
        "start": 77480,
        "end": 77487
      },
      "text": "བསམས་པ་ ༼སྣར། པེ།༽ བསམ་པ་"
    },
    {
      "span": {
        "start": 78049,
        "end": 78055
      },
      "text": "སྐྱེད་ ༼སྣར། པེ།༽ བསྐྱེད་"
    },
    {
      "span": {
        "start": 78319,
        "end": 78329
      },
      "text": "གཡེང་བ་ནི་ ༼པེ།༽ གཡེང་བ་"
    },
    {
      "span": {
        "start": 78334,
        "end": 78343
      },
      "text": "བསྐྱེད་པ་ ༼སྣར།༽ སྐྱེད་པ་"
    },
    {
      "span": {
        "start": 79168,
        "end": 79176
      },
      "text": "རྟོག་པར་ ༼སྣར། པེ།༽ རྟོགས་པར་"
    },
    {
      "span": {
        "start": 79183,
        "end": 79193
      },
      "text": "སྙིང་པོའི་ ༼སྣར། པེ།༽ སྙིང་པོ་"
    },
    {
      "span": {
        "start": 79199,
        "end": 79209
      },
      "text": "རྟོག་གེའི་ ༼སྣར། པེ།༽ རྟོག་གེ་"
    },
    {
      "span": {
        "start": 79309,
        "end": 79325
      },
      "text": "གཞན་གྱི་དོན་གྱི་ ༼སྣར། པེ།༽ གཞན་གྱི་"
    },
    {
      "span": {
        "start": 79569,
        "end": 79577
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 79602,
        "end": 79614
      },
      "text": "བསྒྲུབས་པའི་ ༼སྣར། པེ།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 80041,
        "end": 80047
      },
      "text": "བསླུས་ ༼སྣར། པེ།༽ བསྡུས་"
    },
    {
      "span": {
        "start": 80161,
        "end": 80169
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 80192,
        "end": 80197
      },
      "text": "ཅི་མ་ ༼སྣར། པེ།༽ ཅི་"
    },
    {
      "span": {
        "start": 80378,
        "end": 80387
      },
      "text": "བསྒོམས་པ་ ༼སྣར། པེ།༽ བསྒོམ་པ་"
    }
  ]
}