{
  "durchens": [
    {
      "span": {
        "start": 1240,
        "end": 1248
      },
      "text": "ཐུག་པའི་ ༼སྣར།༽ ཐུབ་པའི་"
    },
    {
      "span": {
        "start": 1635,
        "end": 1640
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ རྒྱུ་ཡང་"
    },
    {
      "span": {
        "start": 1956,
        "end": 1966
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 2048,
        "end": 2057
      },
      "text": "ལྡོངས་པས་ ༼སྣར། པེ།༽ མདོངས་པས་"
    },
    {
      "span": {
        "start": 2526,
        "end": 2532
      },
      "text": "འཁྲུག་ ༼པེ།༽ འཁྲུགས་"
    },
    {
      "span": {
        "start": 3336,
        "end": 3345
      },
      "text": "མི་དགེའི་ ༼སྣར།༽ མི་དགེ་བའི་"
    },
    {
      "span": {
        "start": 3458,
        "end": 3463
      },
      "text": "བགྱི་ ༼སྣར།༽ བགྱིད་"
    },
    {
      "span": {
        "start": 4152,
        "end": 4156
      },
      "text": "སྨས་ ༼པེ།༽ སྨད་"
    },
    {
      "span": {
        "start": 5205,
        "end": 5213
      },
      "text": "སྐྱེ་བས་ ༼པེ།༽ སྐྱེ་བའི་"
    },
    {
      "span": {
        "start": 5824,
        "end": 5827
      },
      "text": "བས་ ༼སྣར།༽ པས་"
    },
    {
      "span": {
        "start": 6046,
        "end": 6061
      },
      "text": "སྐྱེ་མཆེད་ཀྱིས་ ༼སྣར། པེ།༽ སྐྱེ་མཆེད་ཀྱི་"
    },
    {
      "span": {
        "start": 6098,
        "end": 6126
      },
      "text": "བྱ་བ་དེ་དག་གིས་ནི་དེའི་དགོས་ ༼སྣར། པེ།༽ བྱ་བ་འདི་དག་ནི་དགོངས་"
    },
    {
      "span": {
        "start": 6252,
        "end": 6257
      },
      "text": "དགོས་ ༼སྣར། པེ།༽ དགོངས་"
    },
    {
      "span": {
        "start": 6549,
        "end": 6563
      },
      "text": "འདི་དག་གིས་ནི་ ༼སྣར། པེ།༽ འདི་དག་གིས་"
    },
    {
      "span": {
        "start": 6673,
        "end": 6679
      },
      "text": "མཛད་པ་ ༼སྣར། པེ།༽ མཛད་"
    },
    {
      "span": {
        "start": 6750,
        "end": 6756
      },
      "text": "ལྡོངས་ ༼སྣར། པེ།༽ མདོངས་"
    },
    {
      "span": {
        "start": 6928,
        "end": 6936
      },
      "text": "བརྙེས་པ་ ༼སྣར།༽ བརྙེས་བ་ ༼པེ།༽ བརྙེས་པར་"
    },
    {
      "span": {
        "start": 6941,
        "end": 6944
      },
      "text": "ཏོ། ༼སྣར། པེ།༽ ཏེ།"
    },
    {
      "span": {
        "start": 7133,
        "end": 7142
      },
      "text": "ཡང་དག་པར་ ༼སྣར། པེ།༽ ཡང་དག་པ་"
    },
    {
      "span": {
        "start": 7445,
        "end": 7450
      },
      "text": "ཐ་མས་ ༼སྣར། པེ།༽ ཐ་མ་"
    },
    {
      "span": {
        "start": 7680,
        "end": 7685
      },
      "text": "སོ། ། ༼སྣར། པེ།༽ སསོ་རྒྱ་གར་གྱི་མཁན་པོ་སརྦ་ཛྙཱ་དེ་བ་དང་། ལོ་ཙཱ་བ་བན་དེ་རིན་ཆེན་མཆོག་གིས་བསྒྱུར་བའོ།"
    }
  ]
}