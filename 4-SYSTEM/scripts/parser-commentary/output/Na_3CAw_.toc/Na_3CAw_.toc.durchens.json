{
  "durchens": [
    {
      "span": {
        "start": 27,
        "end": 29
      },
      "text": "ཤ་ ༼སྣར། པེ།༽ ཤ་ཏ་ཀ་"
    },
    {
      "span": {
        "start": 29,
        "end": 34
      },
      "text": "ཏི་ཀ་ ༼སྣར། པེ།༽ ཏི་"
    },
    {
      "span": {
        "start": 512,
        "end": 523
      },
      "text": "ཐམས་ཅད་ཀྱང་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 674,
        "end": 679
      },
      "text": "གཅིག་ ༼སྣར། པེ།༽ ཅི་གཅིག་པ་"
    },
    {
      "span": {
        "start": 885,
        "end": 892
      },
      "text": "ཐ་དད་པ་ ༼སྣར། པེ།༽ ཐ་དད་པ་ཉིད་"
    },
    {
      "span": {
        "start": 1071,
        "end": 1075
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ ཉིད་དུ་"
    },
    {
      "span": {
        "start": 1126,
        "end": 1131
      },
      "text": "འདིར་ ༼སྣར།༽ འདིས་"
    },
    {
      "span": {
        "start": 1178,
        "end": 1184
      },
      "text": "ཇི་ལྟ་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 1231,
        "end": 1233
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལྟར་"
    },
    {
      "span": {
        "start": 1530,
        "end": 1539
      },
      "text": "ལ་སོགས་པ་ ༼སྣར། པེ།༽ ལ་སོགས་"
    },
    {
      "span": {
        "start": 1671,
        "end": 1675
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདི་ལ་"
    },
    {
      "span": {
        "start": 2154,
        "end": 2164
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 2340,
        "end": 2348
      },
      "text": "དངོས་པོ་ ༼པེ།༽ དངོས་"
    },
    {
      "span": {
        "start": 2365,
        "end": 2376
      },
      "text": "དམ་བཅས་པའོ། ༼སྣར། པེ།༽ དམ་བཅས་པ།"
    },
    {
      "span": {
        "start": 2821,
        "end": 2827
      },
      "text": "ཡོད་པ་ ༼སྣར། པེ།༽ ཡོད་པ་ཉིད་ཀྱི་མཚན་"
    },
    {
      "span": {
        "start": 2847,
        "end": 2854
      },
      "text": "བསྒྲུབ་ ༼པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 2933,
        "end": 2940
      },
      "text": "དམ་བཅའ་ ༼སྣར། པེ།༽ དམ་བཅའ་བ་"
    },
    {
      "span": {
        "start": 3117,
        "end": 3126
      },
      "text": "འདིར་དོན་ ༼སྣར། པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 3197,
        "end": 3207
      },
      "text": "བསྒྲུབ་པར་ ༼སྣར། པེ།༽ སྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 3300,
        "end": 3306
      },
      "text": "ཁོ་ནར་ ༼སྣར། པེ།༽ ཁོ་ནས་"
    },
    {
      "span": {
        "start": 3609,
        "end": 3611
      },
      "text": "མ་ ༼སྣར། པེ།༽ མ་ཆུ་ཡོད་པ་"
    },
    {
      "span": {
        "start": 3800,
        "end": 3806
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 3834,
        "end": 3844
      },
      "text": "འགྱུར་བའམ། ༼སྣར། པེ།༽ གྱུར་པའམ།"
    },
    {
      "span": {
        "start": 3854,
        "end": 3861
      },
      "text": "ཡིན་ཏེ། ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 4093,
        "end": 4101
      },
      "text": "ཐགས་བཟང་ ༼སྣར། པེ།༽ ཐག་བཟང་"
    },
    {
      "span": {
        "start": 4127,
        "end": 4134
      },
      "text": "རྒྱུ་མ་ ༼པེ།༽ སྒྱུ་མ་"
    },
    {
      "span": {
        "start": 4257,
        "end": 4261
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ ཡིན་ནོ།"
    },
    {
      "span": {
        "start": 4354,
        "end": 4372
      },
      "text": "ཐགས་བཟང་དང་། ཐག་པ་ ༼སྣར། པེ།༽ ཐགས་བཟང་ཐ་ག་མ་"
    },
    {
      "span": {
        "start": 4428,
        "end": 4434
      },
      "text": "དག་གི་ ༼སྣར། པེ།༽ དག་གིས་"
    },
    {
      "span": {
        "start": 4499,
        "end": 4534
      },
      "text": "མེད་པ་དག་གི་ཡང་རྒྱུ་ཡོད་པ་དང་མེད་པ་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 4646,
        "end": 4652
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པ་ནི་"
    },
    {
      "span": {
        "start": 4717,
        "end": 4724
      },
      "text": "གང་གིས་ ༼སྣར། པེ།༽ གང་གི་"
    },
    {
      "span": {
        "start": 4975,
        "end": 4981
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པ་ཉིད་"
    },
    {
      "span": {
        "start": 5002,
        "end": 5010
      },
      "text": "བྱ་བ་ནི་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 5252,
        "end": 5260
      },
      "text": "བཀག་པའི་ ༼སྣར། པེ།༽ འགག་པའི་"
    },
    {
      "span": {
        "start": 5270,
        "end": 5280
      },
      "text": "ཤུགས་ཀྱིས་ ༼སྣར། པེ།༽ ཤུགས་ཀྱི་"
    },
    {
      "span": {
        "start": 5296,
        "end": 5302
      },
      "text": "གཉི་ག་ ༼སྣར། པེ།༽ གཉིས་ཀ་"
    },
    {
      "span": {
        "start": 5482,
        "end": 5485
      },
      "text": "ནོ། ༼སྣར། པེ།༽ ནོ་ཞེ་ན།"
    },
    {
      "span": {
        "start": 5623,
        "end": 5632
      },
      "text": "དེ་ལྟར་ན་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 5639,
        "end": 5646
      },
      "text": "ལྟོས་པ་ ༼སྣར། པེ།༽ བལྟོས་པ་"
    },
    {
      "span": {
        "start": 5659,
        "end": 5667
      },
      "text": "གཉི་གའང་ ༼སྣར།༽ གཉི་ག་དང་"
    },
    {
      "span": {
        "start": 6243,
        "end": 6251
      },
      "text": "སླུ་བའི་ ༼སྣར། པེ།༽ བསླུ་བའི་"
    },
    {
      "span": {
        "start": 6278,
        "end": 6285
      },
      "text": "ཡིན་ཏེ་ ༼སྣར། པེ།༽ ཡིན་ནོ་"
    },
    {
      "span": {
        "start": 6357,
        "end": 6362
      },
      "text": "ན་ནི། ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 6375,
        "end": 6383
      },
      "text": "སྤང་བའི་ ༼སྣར། པེ།༽ སྤངས་པའི་"
    },
    {
      "span": {
        "start": 6660,
        "end": 6670
      },
      "text": "བདག་ཅག་གི་ ༼སྣར། པེ།༽ བདག་ཅག་གིས་"
    },
    {
      "span": {
        "start": 7041,
        "end": 7047
      },
      "text": "མེད་པ་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 7084,
        "end": 7093
      },
      "text": "གཟུང་བའི་ ༼སྣར། པེ།༽ བཟུང་བའི་"
    },
    {
      "span": {
        "start": 7110,
        "end": 7112
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 7144,
        "end": 7150
      },
      "text": "ཅན་ནི་ ༼སྣར། པེ།༽ ཅན་མི་"
    },
    {
      "span": {
        "start": 7174,
        "end": 7181
      },
      "text": "རྒྱུའི་ ༼སྣར། པེ།༽ རྒྱུ་ནི་"
    },
    {
      "span": {
        "start": 7761,
        "end": 7768
      },
      "text": "ནམ་མཁའ་ ༼སྣར། པེ།༽ ནམ་མཁའི་"
    },
    {
      "span": {
        "start": 8230,
        "end": 8238
      },
      "text": "སླུ་བའི་ ༼སྣར། པེ།༽ བསླུ་བའི་"
    },
    {
      "span": {
        "start": 8373,
        "end": 8387
      },
      "text": "གཏན་ཚིགས་ཀྱིས་ ༼སྣར། པེ།༽ གཏན་ཚིགས་ཀྱི་"
    },
    {
      "span": {
        "start": 8391,
        "end": 8397
      },
      "text": "སུ་ཡང་ ༼སྣར། པེ།༽ སུ་"
    },
    {
      "span": {
        "start": 8607,
        "end": 8616
      },
      "text": "ཡི་གེ་ཧེ་ ༼སྣར། པེ།༽ ཡི་གེ་ཏེ་"
    },
    {
      "span": {
        "start": 9314,
        "end": 9320
      },
      "text": "དེ་ལྟ་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 9865,
        "end": 9873
      },
      "text": "བཀག་པ་མ་ ༼སྣར། པེ།༽ བཀག་པ་"
    },
    {
      "span": {
        "start": 10238,
        "end": 10251
      },
      "text": "ཡིན་པའི་ཕྱིར་ ༼སྣར། པེ།༽ ཡིན་པའི་"
    },
    {
      "span": {
        "start": 10789,
        "end": 10799
      },
      "text": "སྤྱི་བོའོ་ ༼སྣར། པེ།༽ སྤྱིའོ་"
    },
    {
      "span": {
        "start": 11130,
        "end": 11136
      },
      "text": "ནི་མི་ ༼སྣར། པེ།༽ ནི་མ་"
    },
    {
      "span": {
        "start": 11169,
        "end": 11175
      },
      "text": "དེ་ལྟ་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 11279,
        "end": 11286
      },
      "text": "ཉིད་དག་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 11682,
        "end": 11685
      },
      "text": "དེ། ༼སྣར། པེ།༽ དེ་ཡིད་ལ་ནི་མཐོང་བ་མེད་དོ།"
    },
    {
      "span": {
        "start": 11811,
        "end": 11822
      },
      "text": "མཐོང་བར་མི་ ༼སྣར། པེ།༽ མཐོང་བར་"
    },
    {
      "span": {
        "start": 11884,
        "end": 11893
      },
      "text": "གཟུང་བའི་ ༼སྣར། པེ།༽ གཟུང་བས་"
    },
    {
      "span": {
        "start": 12069,
        "end": 12079
      },
      "text": "བསྟན་པ་ནི་ ༼སྣར། པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 12353,
        "end": 12359
      },
      "text": "གཞན་མ་ ༼སྣར། པེ།༽ གཞན་"
    },
    {
      "span": {
        "start": 12926,
        "end": 12928
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 12956,
        "end": 12961
      },
      "text": "བྱའོ། ༼སྣར། པེ།༽ བྱ་བའོ།"
    },
    {
      "span": {
        "start": 13288,
        "end": 13309
      },
      "text": "སྣམ་བུ་ལ་སོགས་པ་རྣམས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 13667,
        "end": 13673
      },
      "text": "དེ་ལྟ་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 13736,
        "end": 13744
      },
      "text": "རྒྱུ་ལས་ ༼སྣར། པེ།༽ རྒྱུ་ལ་"
    },
    {
      "span": {
        "start": 13814,
        "end": 13821
      },
      "text": "རིགས་པ་ ༼སྣར། པེ།༽ རགས་པ་"
    },
    {
      "span": {
        "start": 13879,
        "end": 13887
      },
      "text": "ཉིད་ཡོད་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 14283,
        "end": 14290
      },
      "text": "ཡིན་ནོ། ༼སྣར། པེ།༽ ཡིན་ཏེ།"
    },
    {
      "span": {
        "start": 14314,
        "end": 14322
      },
      "text": "རྒྱུ་ལས་ ༼སྣར། པེ།༽ རྒྱུ་ལ་"
    },
    {
      "span": {
        "start": 14558,
        "end": 14564
      },
      "text": "སྨྲ་བ་ ༼སྣར། པེ།༽ སྨྲས་པ་"
    },
    {
      "span": {
        "start": 14840,
        "end": 14848
      },
      "text": "ཕྱིར་རོ། ༼སྣར། པེ།༽ ཕྱིར།"
    },
    {
      "span": {
        "start": 14900,
        "end": 14909
      },
      "text": "སྐྱེད་པར་ ༼སྣར། པེ།༽ བསྐྱེད་པར་"
    },
    {
      "span": {
        "start": 14993,
        "end": 14997
      },
      "text": "རུས་ ༼སྣར། པེ།༽ རུལ་"
    },
    {
      "span": {
        "start": 15393,
        "end": 15396
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 16153,
        "end": 16159
      },
      "text": "མེད་ལ། ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 16186,
        "end": 16190
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ ཡིན་གང་གི་ཚེ་གནས་པ་མེད་པ་དེའི་ཚེ་སྐྱེ་བ་གང་གི་ཡིན།"
    },
    {
      "span": {
        "start": 16304,
        "end": 16317
      },
      "text": "མེད་པར་གང་གི་ ༼སྣར། པེ།༽ མེད་པར་"
    },
    {
      "span": {
        "start": 16340,
        "end": 16347
      },
      "text": "མོ་གཤམ་ ༼སྣར། པེ།༽ མོ་ཤམ་"
    },
    {
      "span": {
        "start": 16506,
        "end": 16514
      },
      "text": "དེ་བས་ན་ ༼པེ།༽ དེ་བས་"
    },
    {
      "span": {
        "start": 16700,
        "end": 16710
      },
      "text": "སྐྱེ་བ་དང་ ༼སྣར། པེ།༽ སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 16726,
        "end": 16732
      },
      "text": "དེ་བས་ ༼སྣར། པེ།༽ དེ་བས་ན་"
    },
    {
      "span": {
        "start": 16859,
        "end": 16870
      },
      "text": "འདི་དག་རིམ་ ༼སྣར། པེ།༽ འདི་དག་ཅིག་"
    },
    {
      "span": {
        "start": 16987,
        "end": 16989
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་ཡང་"
    },
    {
      "span": {
        "start": 17007,
        "end": 17018
      },
      "text": "ཐམས་ཅད་དུས་ ༼སྣར། པེ།༽ ཐམས་ཅད་དུ་"
    },
    {
      "span": {
        "start": 17211,
        "end": 17219
      },
      "text": "གཞན་དང་། ༼སྣར། པེ།༽ གཞན་ཡང་།"
    },
    {
      "span": {
        "start": 17890,
        "end": 17898
      },
      "text": "བྱས་ཀྱང་ ༼སྣར། པེ།༽ བྱས་"
    },
    {
      "span": {
        "start": 17957,
        "end": 17967
      },
      "text": "ན། སྨྲས་པ། ༼སྣར། པེ།༽ ན།"
    },
    {
      "span": {
        "start": 18160,
        "end": 18167
      },
      "text": "གནས་སམ་ ༼སྣར། པེ།༽ གནས་མ་"
    },
    {
      "span": {
        "start": 18182,
        "end": 18193
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱིས་"
    },
    {
      "span": {
        "start": 18356,
        "end": 18359
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེ་འདི་"
    },
    {
      "span": {
        "start": 18452,
        "end": 18463
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱིས་"
    },
    {
      "span": {
        "start": 18520,
        "end": 18524
      },
      "text": "ལུས་ ༼སྣར། པེ།༽ ལུས་ལ་"
    },
    {
      "span": {
        "start": 19082,
        "end": 19088
      },
      "text": "དེ་ལྟ་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 19215,
        "end": 19224
      },
      "text": "ཐལ་བར་ཡང་ ༼སྣར། པེ།༽ ཐལ་བར་"
    },
    {
      "span": {
        "start": 19306,
        "end": 19314
      },
      "text": "བདག་གིས་ ༼སྣར། པེ།༽ བདག་གི་"
    },
    {
      "span": {
        "start": 19447,
        "end": 19455
      },
      "text": "སྐྱེད་པ་ ༼སྣར། པེ།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 19512,
        "end": 19518
      },
      "text": "གང་གི་ ༼སྣར། པེ།༽ གང་གིས་"
    },
    {
      "span": {
        "start": 19522,
        "end": 19529
      },
      "text": "བཞིན་པ་ ༼སྣར། པེ།༽ བཞིན་"
    },
    {
      "span": {
        "start": 19535,
        "end": 19544
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 19568,
        "end": 19576
      },
      "text": "སྐྱེད་པ་ ༼སྣར། པེ།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 19788,
        "end": 19796
      },
      "text": "སྐྱེད་པ་ ༼སྣར། པེ།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 19957,
        "end": 19964
      },
      "text": "ཕྱིར་མ་ ༼སྣར། པེ།༽ ཕྱིར་"
    },
    {
      "span": {
        "start": 19968,
        "end": 19975
      },
      "text": "པ་རྣམས་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 20056,
        "end": 20064
      },
      "text": "མཐུན་པས་ ༼སྣར། པེ།༽ མཐུན་པས་མ་"
    },
    {
      "span": {
        "start": 20294,
        "end": 20301
      },
      "text": "འགག་པར་ ༼སྣར། པེ།༽ འགགས་པར་"
    },
    {
      "span": {
        "start": 20382,
        "end": 20395
      },
      "text": "དངོས་པོ་རྣམས་ ༼སྣར། པེ།༽ དངོས་པོ་"
    },
    {
      "span": {
        "start": 20662,
        "end": 20664
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་ཁྱིམ་"
    },
    {
      "span": {
        "start": 20754,
        "end": 20762
      },
      "text": "ངོས་མེད་ ༼སྣར། པེ།༽ དངོས་མེད་"
    },
    {
      "span": {
        "start": 20764,
        "end": 20770
      },
      "text": "ཡང་དེ་ ༼སྣར། པེ།༽ ཡང་"
    },
    {
      "span": {
        "start": 20870,
        "end": 20879
      },
      "text": "འགྱུར་ཏེ། ༼སྣར། པེ།༽ འགྱུར་རོ།"
    },
    {
      "span": {
        "start": 20997,
        "end": 21005
      },
      "text": "དམིགས་པ་ ༼སྣར།༽ དམིགས་པར་"
    },
    {
      "span": {
        "start": 21250,
        "end": 21268
      },
      "text": "མཚུངས་པ་ན་དེའི་ཚེ་ ༼སྣར། པེ།༽ མཚུངས་པ་ནི་དེའི་"
    },
    {
      "span": {
        "start": 21324,
        "end": 21333
      },
      "text": "འདིར་ལྟར་ ༼སྣར། པེ།༽ འདི་ལྟར་"
    },
    {
      "span": {
        "start": 21426,
        "end": 21435
      },
      "text": "རྟོགས་པར་ ༼སྣར། པེ།༽ རྟོག་པར་"
    },
    {
      "span": {
        "start": 21668,
        "end": 21677
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 22059,
        "end": 22062
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 22109,
        "end": 22112
      },
      "text": "རི་ ༼སྣར། པེ།༽ ཧི་"
    },
    {
      "span": {
        "start": 22797,
        "end": 22805
      },
      "text": "གསུངས་པ། ༼སྣར། པེ།༽ གསུངས་སོ་"
    },
    {
      "span": {
        "start": 22883,
        "end": 22890
      },
      "text": "དེ་ལྟར་ ༼སྣར། པེ།༽ དེ་"
    },
    {
      "span": {
        "start": 23218,
        "end": 23226
      },
      "text": "སྲིད་དོ། ༼སྣར། པེ།༽ སྲིད་དེ།"
    },
    {
      "span": {
        "start": 23296,
        "end": 23304
      },
      "text": "འགེགས་པ་ ༼སྣར། པེ།༽ འགེགས་པ་པོ་"
    },
    {
      "span": {
        "start": 23416,
        "end": 23423
      },
      "text": "དགག་པར་ ༼སྣར།༽ དགལ་བ་ ༼པེ།༽ དགག་པ་"
    },
    {
      "span": {
        "start": 23739,
        "end": 23747
      },
      "text": "གྲུབ་པར་ ༼སྣར། པེ།༽ བསྒྲུབ་པར་"
    },
    {
      "span": {
        "start": 23766,
        "end": 23773
      },
      "text": "དེ་ལྟར་ ༼སྣར།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 23858,
        "end": 23862
      },
      "text": "ཡིན། ༼སྣར། པེ།༽ མིན།"
    }
  ]
}