{
  "durchens": [
    {
      "span": {
        "start": 341,
        "end": 354
      },
      "text": "དལ་འབྱོར་གྱི་ ༼སྣར། པེ།༽ དལ་འབྱོར་གྱིས་"
    },
    {
      "span": {
        "start": 430,
        "end": 438
      },
      "text": "སེལ་བའི་ ༼སྣར། པེ།༽ བསལ་བའི་"
    },
    {
      "span": {
        "start": 504,
        "end": 513
      },
      "text": "སྦྱང་བའི་ ༼སྣར། པེ།༽ བྱང་བའི་"
    },
    {
      "span": {
        "start": 820,
        "end": 828
      },
      "text": "སྐྱེ་བར་ ༼སྣར། པེ།༽ སྐྱེད་པར་"
    },
    {
      "span": {
        "start": 1207,
        "end": 1216
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར། པེ།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 1624,
        "end": 1632
      },
      "text": "ལེགས་པར་ ༼སྣར། པེ།༽ ལེགས་པ་"
    },
    {
      "span": {
        "start": 1743,
        "end": 1751
      },
      "text": "ཟས་ཀྱིས་ ༼སྣར། པེ།༽ ཟས་ཀྱི་"
    },
    {
      "span": {
        "start": 2132,
        "end": 2136
      },
      "text": "གཅད་ ༼སྣར། པེ།༽ བཅད་"
    },
    {
      "span": {
        "start": 2193,
        "end": 2197
      },
      "text": "གནས་ ༼སྣར། པེ།༽ གནས་སུ་"
    },
    {
      "span": {
        "start": 2276,
        "end": 2279
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 2327,
        "end": 2331
      },
      "text": "བའོ། ༼སྣར། པེ།༽ རོ།"
    },
    {
      "span": {
        "start": 2343,
        "end": 2350
      },
      "text": "བརྒྱུད་ ༼སྣར། པེ།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 2473,
        "end": 2477
      },
      "text": "བཙའ་ ༼སྣར། པེ།༽ རྩ་"
    },
    {
      "span": {
        "start": 2714,
        "end": 2722
      },
      "text": "རླག་པའི་ ༼སྣར། པེ།༽ བརླག་པའི་"
    },
    {
      "span": {
        "start": 2890,
        "end": 2895
      },
      "text": "ཁོ་ན་ ༼སྣར།༽ ཁོ་"
    },
    {
      "span": {
        "start": 3389,
        "end": 3393
      },
      "text": "ཀྱི་ ༼སྣར། པེ།༽ ཀྱིས་"
    },
    {
      "span": {
        "start": 3426,
        "end": 3436
      },
      "text": "སྒྲུབ་པའི་ ༼སྣར། པེ།༽ བསྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 4064,
        "end": 4072
      },
      "text": "བར་གྱིས་ ༼སྣར། པེ།༽ བར་གྱི་"
    },
    {
      "span": {
        "start": 4192,
        "end": 4200
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 4442,
        "end": 4453
      },
      "text": "སེམས་ཅན་ནི་ ༼སྣར། པེ།༽ སེམས་ཅན་"
    },
    {
      "span": {
        "start": 4775,
        "end": 4780
      },
      "text": "གྲངས་ ༼སྣར། པེ།༽ གྲངས་པ་"
    },
    {
      "span": {
        "start": 4820,
        "end": 4825
      },
      "text": "སྲུང་ ༼སྣར།༽ གསུང་"
    },
    {
      "span": {
        "start": 4841,
        "end": 4844
      },
      "text": "མེ་ ༼སྣར། པེ།༽ མེད་"
    },
    {
      "span": {
        "start": 4852,
        "end": 4860
      },
      "text": "སྐྱེ་བོ་ ༼སྣར། པེ།༽ སྐྱེའོ། །"
    },
    {
      "span": {
        "start": 4865,
        "end": 4871
      },
      "text": "གཞིའི་ ༼སྣར། པེ།༽ གཞི་"
    },
    {
      "span": {
        "start": 5114,
        "end": 5123
      },
      "text": "སྦྱང་སྟེ། ༼སྣར། པེ།༽ སྦྱངས་ཏེ།"
    },
    {
      "span": {
        "start": 5351,
        "end": 5358
      },
      "text": "སྦྱང་བ་ ༼སྣར། པེ།༽ སྦྱངས་པ་"
    },
    {
      "span": {
        "start": 5609,
        "end": 5617
      },
      "text": "འཐོབ་པར་ ༼སྣར། པེ།༽ ཐོབ་པར་"
    },
    {
      "span": {
        "start": 5782,
        "end": 5793
      },
      "text": "ཐམས་ཅད་ལ་མ་ ༼སྣར།༽ ཐམས་ཅད་ལས་"
    },
    {
      "span": {
        "start": 6072,
        "end": 6087
      },
      "text": "བཅུ་བཞིའི་སྦྲང་ ༼སྣར།༽ བཅུ་བཞི་སྦྲམ་ ༼པེ།༽ བཅུ་བཞི་སྦྲང་"
    },
    {
      "span": {
        "start": 6114,
        "end": 6123
      },
      "text": "བྱོན་པའི་ ༼སྣར། པེ།༽ འབྱོན་པའི་"
    },
    {
      "span": {
        "start": 6233,
        "end": 6238
      },
      "text": "བྱོན་ ༼སྣར།༽ འབྱོན་"
    },
    {
      "span": {
        "start": 6407,
        "end": 6412
      },
      "text": "པོ། ། ༼སྣར། པེ།༽ ། །དགེ་སློང་ཚུལ་ཁྲིམས་རྒྱལ་བས་སྤེལ་བར་འདོད་པ་ལས་བོད་ཀྱི་སྟོན་པ་རྣམས་ནི་ང་རྒྱལ་དང་ཕྲག་དོག་ཆེ་བས་ང་རྒྱལ་གྱི་སྒང་བུ་ལ་ཡོན་ཏན་གྱི་ཆུ་མ་ཆགས་སོ། །དེ་འདྲ་ལྷ་ཁང་ཀེ་རུའི་ཁྱམས་སྨད་ཀྱི་བན་དེ་བདག་གིས་ཞུས་ཏེ་གདམས་ངག་དང་བཅས་ཏེ་གནང་ངོ་། །ཇོ་བོའི་བླ་མ་ཨ་ཝ་དྷཱུ་ཏི་པས་རབ་ཏུ་མི་གནས་པའི་ལྟ་བ་དང་། ལས་མཐའ་སེམས་བསྐྱེད་པའི་ཆོ་ག་དང་། མདོ་ཀུན་ལས་བཏུས་པའི་དོན་མན་ངག་ཏུ་བྱས་པ་འདི་གསུམ་སྟབས་གཅིག་ཏུ་གནང་བ་ལགས་སོ། །"
    }
  ]
}