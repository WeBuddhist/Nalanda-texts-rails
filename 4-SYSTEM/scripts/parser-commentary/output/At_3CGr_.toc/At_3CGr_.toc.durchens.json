{
  "durchens": [
    {
      "span": {
        "start": 349,
        "end": 360
      },
      "text": "ཡེ་ཤེས་ཀྱི་ ༼སྣར། པེ།༽ ཡེ་ཤེས་ཀྱིས་"
    },
    {
      "span": {
        "start": 490,
        "end": 495
      },
      "text": "གཙོར་ ༼སྣར། པེ།༽ གཙོ་བོར་"
    },
    {
      "span": {
        "start": 621,
        "end": 627
      },
      "text": "འདིའི་ ༼སྣར། པེ།༽ མདོའི་"
    },
    {
      "span": {
        "start": 819,
        "end": 824
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ རྒྱུད་"
    },
    {
      "span": {
        "start": 851,
        "end": 859
      },
      "text": "གཉིས་ཏེ། ༼སྣར།༽ གཉིས་"
    },
    {
      "span": {
        "start": 865,
        "end": 872
      },
      "text": "སློང་བ་ ༼སྣར། པེ།༽ བསླང་བ་"
    },
    {
      "span": {
        "start": 1214,
        "end": 1225
      },
      "text": "ཁྱད་པར་གྱི་ ༼སྣར།༽ ཁྱད་པར་"
    },
    {
      "span": {
        "start": 1453,
        "end": 1461
      },
      "text": "དན་རྟགས་ ༼སྣར། པེ།༽ དོན་བརྟགས་"
    },
    {
      "span": {
        "start": 1500,
        "end": 1504
      },
      "text": "འདི་ ༼སྣར།༽ འདིའི་"
    },
    {
      "span": {
        "start": 2034,
        "end": 2046
      },
      "text": "བསྡུས་དོན་ན་ ༼སྣར། པེ།༽ བསྡུས་དོན་ནས་"
    },
    {
      "span": {
        "start": 2168,
        "end": 2173
      },
      "text": "དེ་ལ་ ༼སྣར།༽ དེ་"
    },
    {
      "span": {
        "start": 2231,
        "end": 2240
      },
      "text": "ནུས་པ་ནི་ ༼སྣར།༽ ནུས་པའི་"
    },
    {
      "span": {
        "start": 2797,
        "end": 2804
      },
      "text": "མེད་དོ། ༼སྣར། པེ།༽ མེད་དེ།"
    },
    {
      "span": {
        "start": 3033,
        "end": 3035
      },
      "text": "ལ་ ༼སྣར།༽ ལས་"
    },
    {
      "span": {
        "start": 3054,
        "end": 3062
      },
      "text": "བསྟན་པས་ ༼སྣར། པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 3287,
        "end": 3295
      },
      "text": "ཐོས་པའི་ ༼སྣར། པེ།༽ ཐོས་པ་"
    },
    {
      "span": {
        "start": 3793,
        "end": 3800
      },
      "text": "ཆོས་ཉན་ ༼སྣར།༽ ཆོས་ཅན་"
    },
    {
      "span": {
        "start": 3804,
        "end": 3810
      },
      "text": "སྐལ་པ་ ༼སྣར།༽ སྐལ་"
    },
    {
      "span": {
        "start": 3823,
        "end": 3830
      },
      "text": "དང་ལྡན་ ༼སྣར། པེ།༽ ལ་བསྟན་"
    },
    {
      "span": {
        "start": 4398,
        "end": 4405
      },
      "text": "ཡིན་ནམ་ ༼སྣར། པེ།༽ ཡིན་"
    },
    {
      "span": {
        "start": 4460,
        "end": 4465
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བས་"
    },
    {
      "span": {
        "start": 4850,
        "end": 4858
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ མེད་པ་"
    },
    {
      "span": {
        "start": 4858,
        "end": 4861
      },
      "text": "དང་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 5627,
        "end": 5634
      },
      "text": "སྟོན་པ་ ༼སྣར། པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 6175,
        "end": 6188
      },
      "text": "གསང་སྔགས་ཀྱི་ ༼སྣར།༽ གསང་སྔགས་ཀྱིས་"
    },
    {
      "span": {
        "start": 6777,
        "end": 6786
      },
      "text": "ཁོག་དབུབ་ ༼སྣར། པེ།༽ ཁོག་"
    },
    {
      "span": {
        "start": 6868,
        "end": 6878
      },
      "text": "རྟོགས་པའི་ ༼སྣར། པེ།༽ རྟོག་པའི་"
    },
    {
      "span": {
        "start": 6975,
        "end": 6979
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིས་"
    },
    {
      "span": {
        "start": 7099,
        "end": 7102
      },
      "text": "སྔ་ ༼སྣར།༽ ལྔ་"
    },
    {
      "span": {
        "start": 7141,
        "end": 7147
      },
      "text": "ལྷག་མ་ ༼སྣར། པེ།༽ ལྷག་པ་"
    },
    {
      "span": {
        "start": 8742,
        "end": 8746
      },
      "text": "མཐའ་ ༼སྣར། པེ།༽ མཐའི་"
    },
    {
      "span": {
        "start": 9205,
        "end": 9210
      },
      "text": "ལྟ་བ་ ༼སྣར། པེ།༽ བལྟ་བ་"
    },
    {
      "span": {
        "start": 9227,
        "end": 9233
      },
      "text": "ལྟ་བར་ ༼སྣར། པེ།༽ བལྟ་བར་"
    },
    {
      "span": {
        "start": 10565,
        "end": 10569
      },
      "text": "རིམ་ ༼སྣར། པེ།༽ རིམས་"
    },
    {
      "span": {
        "start": 10607,
        "end": 10619
      },
      "text": "གོ་རིམས་ཀྱང་ ༼སྣར། པེ།༽ གོ་རིམ་ཡང་"
    },
    {
      "span": {
        "start": 10661,
        "end": 10668
      },
      "text": "ཟབ་པའི་ ༼སྣར། པེ།༽ ཟབ་མོའི་"
    },
    {
      "span": {
        "start": 10944,
        "end": 10951
      },
      "text": "ཇི་སྐད་ ༼སྣར། པེ།༽ འདི་སྐད་"
    },
    {
      "span": {
        "start": 11389,
        "end": 11398
      },
      "text": "བསྒོམ་ལམ་ ༼སྣར། པེ།༽ སྒོམ་ལམ་"
    },
    {
      "span": {
        "start": 11624,
        "end": 11628
      },
      "text": "གྱི་ ༼སྣར། པེ།༽ སྒོམ་ལམ་གྱིས་"
    },
    {
      "span": {
        "start": 11679,
        "end": 11688
      },
      "text": "བསྒོམ་ལམ་ ༼སྣར། པེ།༽ སྒོམ་ལམ་"
    },
    {
      "span": {
        "start": 11721,
        "end": 11730
      },
      "text": "བསྒོམ་ལམ་ ༼སྣར། པེ།༽ སྒོམ་ལམ་"
    },
    {
      "span": {
        "start": 11772,
        "end": 11779
      },
      "text": "ལན་ཅིག་ ༼སྣར། པེ།༽ ལམ་གཅིག་"
    },
    {
      "span": {
        "start": 11965,
        "end": 11972
      },
      "text": "བྱ་བ་ལ་ ༼སྣར། པེ།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 12111,
        "end": 12113
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 12443,
        "end": 12450
      },
      "text": "ཇི་ལྟར་ ༼སྣར། པེ།༽ ཇི་ལྟ་བ་"
    },
    {
      "span": {
        "start": 12744,
        "end": 12752
      },
      "text": "སྐྱུ་རུ་ ༼སྣར། པེ།༽ སྐྱུར་རུ་"
    },
    {
      "span": {
        "start": 12765,
        "end": 12771
      },
      "text": "བཞག་པ་ ༼སྣར། པེ།༽ གཞག་པ་"
    },
    {
      "span": {
        "start": 12860,
        "end": 12863
      },
      "text": "ལྟ་ ༼སྣར།༽ ལྟར་"
    },
    {
      "span": {
        "start": 13022,
        "end": 13031
      },
      "text": "བསྒོམ་ལམ་ ༼སྣར། པེ།༽ སྒོམ་ལམ་"
    },
    {
      "span": {
        "start": 13323,
        "end": 13329
      },
      "text": "དེ་དག་ ༼སྣར། པེ།༽ དེ་ཉིད་"
    },
    {
      "span": {
        "start": 13392,
        "end": 13400
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 13406,
        "end": 13410
      },
      "text": "དང་། ༼སྣར། པེ།༽ སྟེ།"
    },
    {
      "span": {
        "start": 13440,
        "end": 13446
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ ད་ནི་"
    },
    {
      "span": {
        "start": 13454,
        "end": 13459
      },
      "text": "སྐབས་ ༼སྣར། པེ།༽ སྐབས་སུ་"
    }
  ]
}