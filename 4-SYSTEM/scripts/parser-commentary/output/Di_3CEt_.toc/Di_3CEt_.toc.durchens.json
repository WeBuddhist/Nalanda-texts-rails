{
  "durchens": [
    {
      "span": {
        "start": 410,
        "end": 413
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 467,
        "end": 481
      },
      "text": "ཤེས་པས་གང་གིས་ ༼སྣར། པེ།༽ ཤེས་པས་"
    },
    {
      "span": {
        "start": 556,
        "end": 562
      },
      "text": "དག་གི་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 1045,
        "end": 1054
      },
      "text": "ཉིད་ཀྱིས་ ༼སྣར། པེ།༽ ཉིད་ཀྱི་"
    },
    {
      "span": {
        "start": 1074,
        "end": 1081
      },
      "text": "འདུས་པ་ ༼སྣར། པེ།༽ འདུས་བྱས་"
    },
    {
      "span": {
        "start": 1129,
        "end": 1136
      },
      "text": "བློ་ཡི་ ༼སྣར། པེ།༽ བློ་ཡིས་"
    },
    {
      "span": {
        "start": 1319,
        "end": 1343
      },
      "text": "ཐམས་ཅད་ནི་རྣམ་པ་དུ་མ་ཅན་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 1442,
        "end": 1452
      },
      "text": "སྐྱེད་པའི་ ༼སྣར། པེ།༽ བསྐྱེད་པའི་"
    },
    {
      "span": {
        "start": 1452,
        "end": 1457
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ རྒྱུའི་དངོས་པོ་"
    },
    {
      "span": {
        "start": 1530,
        "end": 1533
      },
      "text": "སྲ་ ༼སྣར། པེ།༽ སྲ་བ་"
    },
    {
      "span": {
        "start": 1604,
        "end": 1618
      },
      "text": "ཉིད་ཀྱང་དེ་དང་ ༼སྣར། པེ།༽ ཉིད་ཀྱང་"
    },
    {
      "span": {
        "start": 1854,
        "end": 1857
      },
      "text": "ནི་ ༼སྣར། པེ།༽ ན་"
    },
    {
      "span": {
        "start": 2223,
        "end": 2230
      },
      "text": "ཉིད་དོ། ༼སྣར། པེ།༽ ཉིད་དེ།"
    },
    {
      "span": {
        "start": 2373,
        "end": 2386
      },
      "text": "འདོར་བར་བྱེད་ ༼སྣར། པེ།༽ འདོར་བ་མེད་"
    },
    {
      "span": {
        "start": 2501,
        "end": 2511
      },
      "text": "གང་ཡིན་དེ། ༼སྣར།༽ གང་ཡིན་ཏེ།"
    },
    {
      "span": {
        "start": 2825,
        "end": 2835
      },
      "text": "ལ་ནི་རག་ལ། ༼སྣར། པེ།༽ ལ་རེག་ན་"
    },
    {
      "span": {
        "start": 2985,
        "end": 2994
      },
      "text": "སྐྱེ་བའི་ ༼སྣར། པེ།༽ སྐྱེས་པའི་"
    },
    {
      "span": {
        "start": 3021,
        "end": 3045
      },
      "text": "གཏན་ཚིགས་ཡོད་པ་དང་མེད་པ་ ༼སྣར། པེ།༽ གཏན་ཚིགས་"
    },
    {
      "span": {
        "start": 3088,
        "end": 3090
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 3090,
        "end": 3095
      },
      "text": "རྒྱུ་ ༼སྣར། པེ།༽ རྒྱུ་དང་རྒྱུ་འབྲས་"
    },
    {
      "span": {
        "start": 3217,
        "end": 3224
      },
      "text": "སྣང་བས་ ༼སྣར། པེ།༽ སྣང་བ་"
    },
    {
      "span": {
        "start": 3268,
        "end": 3276
      },
      "text": "བྱེད་པར་ ༼སྣར། པེ།༽ བྱེད་པའི་"
    },
    {
      "span": {
        "start": 3332,
        "end": 3340
      },
      "text": "འོ་ན་ནི་ ༼སྣར། པེ།༽ འོ་ན་"
    },
    {
      "span": {
        "start": 3399,
        "end": 3407
      },
      "text": "བརྟེན་ན་ ༼སྣར། པེ།༽ བརྟེན་ནས་"
    },
    {
      "span": {
        "start": 3454,
        "end": 3463
      },
      "text": "ནུས་པ་ཡི། ༼སྣར། པེ།༽ ནུས་པ་ཡིས།"
    },
    {
      "span": {
        "start": 3704,
        "end": 3720
      },
      "text": "འབྲས་བུ་སྐྱེད་པ་ ༼སྣར། པེ།༽ འབྲས་བུ་བསྐྱེད་"
    },
    {
      "span": {
        "start": 3858,
        "end": 3864
      },
      "text": "བརྟེན་ ༼སྣར། པེ།༽ རྟེན་"
    },
    {
      "span": {
        "start": 3906,
        "end": 3913
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ ཕྱེ་བ་"
    },
    {
      "span": {
        "start": 3973,
        "end": 3980
      },
      "text": "དུས་ཅན་ ༼སྣར། པེ།༽ དུས་མ་"
    },
    {
      "span": {
        "start": 3988,
        "end": 3996
      },
      "text": "རེས་འགའ་ ༼སྣར། པེ།༽ རེ་འགའ་"
    },
    {
      "span": {
        "start": 4029,
        "end": 4036
      },
      "text": "ཤེས་པས་ ༼སྣར། པེ།༽ ཤེས་པའི་"
    },
    {
      "span": {
        "start": 4050,
        "end": 4054
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ ཉིད་དུ་"
    },
    {
      "span": {
        "start": 4109,
        "end": 4112
      },
      "text": "ལས་ ༼སྣར། པེ།༽ དང་"
    },
    {
      "span": {
        "start": 4230,
        "end": 4242
      },
      "text": "དུ་མཐོང་ངོ་། ༼སྣར། པེ།༽ ཉིད་དུ་འཐད་དོ།"
    },
    {
      "span": {
        "start": 4252,
        "end": 4258
      },
      "text": "བརྟགས་ ༼སྣར། པེ།༽ བརྟག་"
    },
    {
      "span": {
        "start": 4298,
        "end": 4306
      },
      "text": "མཛད་པའོ། ༼སྣར། པེ།༽ མཛད་པ་རྫོགས་སོ།"
    }
  ]
}