{
  "durchens": [
    {
      "span": {
        "start": 558,
        "end": 569
      },
      "text": "བསྒྲུབ་པའི་ ༼སྣར། པེ།༽ སྒྲུབ་པའི་"
    },
    {
      "span": {
        "start": 679,
        "end": 688
      },
      "text": "རྣམས་ཀྱི་ ༼སྣར།༽ རྣམས་ཀྱིས་"
    },
    {
      "span": {
        "start": 712,
        "end": 720
      },
      "text": "དེ་མངོན་ ༼སྣར།༽ དེས་མངོན་ ༼པེ།༽ དེས་མངོག་"
    },
    {
      "span": {
        "start": 748,
        "end": 753
      },
      "text": "དགུས་ ༼སྣར། པེ།༽ དགུ་ཡིས་"
    },
    {
      "span": {
        "start": 2803,
        "end": 2806
      },
      "text": "ལས་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 2812,
        "end": 2815
      },
      "text": "པས་ ༼སྣར། པེ།༽ པ་"
    },
    {
      "span": {
        "start": 2908,
        "end": 2916
      },
      "text": "བརྙེས་པ་ ༼སྣར།༽ བརྙེད་པ་"
    },
    {
      "span": {
        "start": 3322,
        "end": 3333
      },
      "text": "ཤེས་རབ་ཀྱི་ ༼སྣར། པེ།༽ ཤེས་རབ་ཀྱིས་"
    },
    {
      "span": {
        "start": 3684,
        "end": 3691
      },
      "text": "བཟུང་བ་ ༼སྣར། པེ།༽ གཟུང་བ་"
    },
    {
      "span": {
        "start": 3936,
        "end": 3938
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 4092,
        "end": 4104
      },
      "text": "ཡེ་ཤེས་ཀྱིས་ ༼སྣར། པེ།༽ ཡེ་ཤེས་"
    },
    {
      "span": {
        "start": 4237,
        "end": 4244
      },
      "text": "ཕྱི་མར་ ༼སྣར། པེ།༽ ཕྱི་མ་"
    },
    {
      "span": {
        "start": 4390,
        "end": 4393
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེས་"
    },
    {
      "span": {
        "start": 5215,
        "end": 5224
      },
      "text": "གྱུར་པའི་ ༼སྣར། པེ།༽ གྱུར་པས་"
    },
    {
      "span": {
        "start": 5267,
        "end": 5280
      },
      "text": "མཆོག་ཏུ་སེམས་ ༼སྣར། པེ།༽ མཆོག་ཏུ་"
    },
    {
      "span": {
        "start": 5337,
        "end": 5341
      },
      "text": "གཏན་ ༼སྣར།༽ བཏན་"
    },
    {
      "span": {
        "start": 5966,
        "end": 5972
      },
      "text": "བྱང་བ་ ༼སྣར།༽ བྱ་བ་"
    },
    {
      "span": {
        "start": 6219,
        "end": 6227
      },
      "text": "ལེགས་པར་ ༼སྣར།༽ ལོག་པར་ ༼པེ།༽ ལོག་ས་"
    },
    {
      "span": {
        "start": 6276,
        "end": 6282
      },
      "text": "པ་དང་། ༼སྣར། པེ།༽ པའང་།"
    },
    {
      "span": {
        "start": 6291,
        "end": 6300
      },
      "text": "སྐྱེ་བོར་ ༼སྣར།༽ སྐྱེ་སོ་སྐྱེ་བར་ ༼པེ།༽ སྐྱེ་སོ་སྐྱེ་བོར་"
    },
    {
      "span": {
        "start": 6313,
        "end": 6322
      },
      "text": "མོད་ཀྱིས་ ༼སྣར། པེ།༽ མོད་ཀྱི་"
    },
    {
      "span": {
        "start": 6819,
        "end": 6825
      },
      "text": "ཡོད་པ་ ༼སྣར། པེ།༽ ཡོད་པ་ལ་"
    },
    {
      "span": {
        "start": 7132,
        "end": 7137
      },
      "text": "གྱུར། ༼སྣར། པེ།༽ འགྱུར།"
    },
    {
      "span": {
        "start": 7274,
        "end": 7279
      },
      "text": "སུའི་ ༼སྣར། པེ།༽ སུ་ནི་"
    },
    {
      "span": {
        "start": 7453,
        "end": 7460
      },
      "text": "པ་འདུལ་ ༼སྣར། པེ།༽ བར་འདུལ་"
    },
    {
      "span": {
        "start": 7587,
        "end": 7594
      },
      "text": "བ་འདུལ་ ༼སྣར། པེ།༽ བར་འདུལ་"
    },
    {
      "span": {
        "start": 7894,
        "end": 7901
      },
      "text": "ཕྲེང་བ་ ༼སྣར། པེ།༽ འཕྲེང་བ་"
    },
    {
      "span": {
        "start": 7916,
        "end": 7926
      },
      "text": "འོད་སྲུངས་ ༼སྣར། པེ།༽ འོད་སྲུང་"
    },
    {
      "span": {
        "start": 8278,
        "end": 8286
      },
      "text": "སྒྱུར་བ་ ༼སྣར། པེ།༽ སྒྱུར་"
    },
    {
      "span": {
        "start": 8666,
        "end": 8668
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 8924,
        "end": 8927
      },
      "text": "ཏེ། ༼སྣར།༽ ཏོ། ། ༼པེ།༽ ནོ། །"
    },
    {
      "span": {
        "start": 9184,
        "end": 9201
      },
      "text": "དོན་ཇི་ལྟ་བུ་ཡིན་ ༼སྣར། པེ།༽ ཇི་ལྟ་བུ་"
    },
    {
      "span": {
        "start": 9323,
        "end": 9330
      },
      "text": "གཟུང་བ་ ༼སྣར། པེ།༽ བཟུང་བ་"
    },
    {
      "span": {
        "start": 9532,
        "end": 9536
      },
      "text": "དགྲ་ ༼སྣར། པེ།༽ སྒྲ་"
    },
    {
      "span": {
        "start": 9608,
        "end": 9615
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ སྒྲུབ་"
    },
    {
      "span": {
        "start": 9648,
        "end": 9653
      },
      "text": "དེའང་ ༼སྣར། པེ།༽ དེ་ཡང་"
    },
    {
      "span": {
        "start": 9886,
        "end": 9892
      },
      "text": "འདས་ལ་ ༼སྣར། པེ།༽ འདས་"
    },
    {
      "span": {
        "start": 9910,
        "end": 9918
      },
      "text": "འདི་ལྟར་ ༼སྣར། པེ།༽ ཇི་ལྟར་"
    },
    {
      "span": {
        "start": 9991,
        "end": 9997
      },
      "text": "རྐྱེན་ ༼སྣར། པེ།༽ སྐྱེན་"
    },
    {
      "span": {
        "start": 10038,
        "end": 10041
      },
      "text": "ལྷ་ ༼སྣར།༽ ལྷས་"
    },
    {
      "span": {
        "start": 10085,
        "end": 10088
      },
      "text": "ལྷ་ ༼སྣར།༽ ལྷས་"
    },
    {
      "span": {
        "start": 10109,
        "end": 10119
      },
      "text": "རྟོགས་ཞེས་ ༼སྣར། པེ།༽ རྟོགས་ཅེས་"
    },
    {
      "span": {
        "start": 10122,
        "end": 10127
      },
      "text": "བ་ནི་ ༼སྣར། པེ།༽ བ་"
    },
    {
      "span": {
        "start": 10153,
        "end": 10164
      },
      "text": "དང་ལས་ཀྱིས་ ༼སྣར། པེ།༽ དང་ལས་ཀྱི་"
    },
    {
      "span": {
        "start": 10223,
        "end": 10229
      },
      "text": "སྦྱོར་ ༼སྣར། པེ།༽ སྦྱར་"
    },
    {
      "span": {
        "start": 10253,
        "end": 10259
      },
      "text": "སྦྱོར་ ༼སྣར། པེ།༽ སྦྱར་"
    },
    {
      "span": {
        "start": 10473,
        "end": 10477
      },
      "text": "ལྡན་ ༼སྣར། པེ།༽ ལྡན་པ་"
    },
    {
      "span": {
        "start": 10813,
        "end": 10816
      },
      "text": "ལྷ་ ༼སྣར།༽ ལྷས་"
    },
    {
      "span": {
        "start": 11028,
        "end": 11032
      },
      "text": "ལོག་ ༼སྣར།༽ ལོགས་"
    },
    {
      "span": {
        "start": 11689,
        "end": 11692
      },
      "text": "དྲ་ ༼སྣར། པེ།༽ དྲཱ་"
    },
    {
      "span": {
        "start": 11760,
        "end": 11763
      },
      "text": "ཕབ། ༼པེ།༽ ཕབ་པའོ།"
    }
  ]
}