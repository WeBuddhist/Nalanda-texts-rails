{
  "durchens": [
    {
      "span": {
        "start": 203,
        "end": 207
      },
      "text": "བསལ་ ༼ཅོ།༽ གསལ་"
    },
    {
      "span": {
        "start": 274,
        "end": 277
      },
      "text": "བྱ། ༼སྣར།༽ བྱེ།"
    },
    {
      "span": {
        "start": 655,
        "end": 657
      },
      "text": "པ་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 924,
        "end": 930
      },
      "text": "སྤང་བ་ ༼སྣར། པེ།༽ སྤོང་བ་"
    },
    {
      "span": {
        "start": 1071,
        "end": 1075
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདིས་"
    },
    {
      "span": {
        "start": 1248,
        "end": 1256
      },
      "text": "སྒྲུབ་པ་ ༼སྣར། པེ།༽ བསྒྲུབ་པ་"
    },
    {
      "span": {
        "start": 1483,
        "end": 1497
      },
      "text": "འཇུག་པ་ལ་འཇུག་ ༼སྣར། པེ།༽ འཇུག་"
    },
    {
      "span": {
        "start": 1511,
        "end": 1517
      },
      "text": "དེས་ན་ ༼སྣར། པེ།༽ དེ་ནས་"
    },
    {
      "span": {
        "start": 1525,
        "end": 1535
      },
      "text": "བསགས་པ་དག་ ༼སྣར། པེ།༽ བསགས་པ་"
    },
    {
      "span": {
        "start": 1537,
        "end": 1544
      },
      "text": "ལུས་པར་ ༼སྣར། པེ།༽ ལུས་པ་དག་"
    },
    {
      "span": {
        "start": 1671,
        "end": 1677
      },
      "text": "གཟུངས་ ༼སྣར།༽ བཟུངས་"
    },
    {
      "span": {
        "start": 1739,
        "end": 1749
      },
      "text": "སྒྲུབ་ཞིང་ ༼སྣར། པེ།༽ སྒྲུབ་ཅིང་"
    },
    {
      "span": {
        "start": 2091,
        "end": 2097
      },
      "text": "གཟུངས་ ༼པེ།༽ གསུངས་"
    },
    {
      "span": {
        "start": 2116,
        "end": 2122
      },
      "text": "དེ་ནི་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 2435,
        "end": 2439
      },
      "text": "བཞི་ ༼སྣར། པེ།༽ གཞི་"
    },
    {
      "span": {
        "start": 2558,
        "end": 2565
      },
      "text": "སྤང་བར་ ༼སྣར། པེ།༽ སྤོང་བར་"
    },
    {
      "span": {
        "start": 3008,
        "end": 3012
      },
      "text": "བཞི་ ༼སྣར། པེ།༽ གཞི་"
    },
    {
      "span": {
        "start": 3213,
        "end": 3224
      },
      "text": "ཞེས་བྱ་བའི་ ༼སྣར། པེ།༽ ཞེས་པའི་"
    },
    {
      "span": {
        "start": 3383,
        "end": 3396
      },
      "text": "གསོལ་བ་འདེབས་ ༼པེ།༽ གསོལ་བ་"
    },
    {
      "span": {
        "start": 3445,
        "end": 3451
      },
      "text": "ཉེས་པ་ ༼སྣར། པེ།༽ ཉན་པ་"
    },
    {
      "span": {
        "start": 3484,
        "end": 3491
      },
      "text": "བྱ་བའོ། ༼སྣར། པེ།༽ བྱའོ།"
    },
    {
      "span": {
        "start": 3572,
        "end": 3578
      },
      "text": "པའོ། ། ༼སྣར། པེ།༽ ། །འདི་ལྟ་སྟེ་གཟུང་བའམ་འཛིན་པར་ཡང་རུང་"
    },
    {
      "span": {
        "start": 3888,
        "end": 3898
      },
      "text": "ཅིའི་ཕྱིར་ ༼སྣར། པེ།༽ ཅིའི་ཕྱིར་ཞེ་ན་"
    },
    {
      "span": {
        "start": 3924,
        "end": 3932
      },
      "text": "མེད་པའི་ ༼སྣར། པེ།༽ མེད་པས་"
    },
    {
      "span": {
        "start": 3936,
        "end": 3940
      },
      "text": "པའི་ ༼སྣར། པེ།༽ བྱ་བའི་"
    },
    {
      "span": {
        "start": 4033,
        "end": 4038
      },
      "text": "རྟོག་ ༼སྣར།༽ རྟག་"
    },
    {
      "span": {
        "start": 4057,
        "end": 4064
      },
      "text": "གནས་པས་ ༼སྣར། པེ།༽ གནས་པས་ནི་"
    },
    {
      "span": {
        "start": 4209,
        "end": 4216
      },
      "text": "དབང་པོ་ ༼སྣར། པེ།༽ དབང་བ་"
    },
    {
      "span": {
        "start": 4255,
        "end": 4260
      },
      "text": "འདིས་ ༼སྣར། པེ།༽ འདིས་ནི་"
    },
    {
      "span": {
        "start": 4598,
        "end": 4608
      },
      "text": "རྣམས་ཀྱིས་ ༼པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 4836,
        "end": 4841
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་ལས་"
    },
    {
      "span": {
        "start": 4937,
        "end": 4943
      },
      "text": "བརྟེན་ ༼སྣར།༽ བསྟན་"
    },
    {
      "span": {
        "start": 4999,
        "end": 5006
      },
      "text": "དེ་སྐད་ ༼སྣར། པེ།༽ འདི་སྐད་"
    },
    {
      "span": {
        "start": 5010,
        "end": 5022
      },
      "text": "བྱ་བ་ནི་དེས་ ༼སྣར། པེ།༽ བྱ་བ་འདིས་"
    },
    {
      "span": {
        "start": 5025,
        "end": 5034
      },
      "text": "ཡང་དག་པར་ ༼སྣར། པེ།༽ ཡང་དག་པ་"
    },
    {
      "span": {
        "start": 5169,
        "end": 5176
      },
      "text": "ཐོབ་པར་ ༼སྣར། པེ།༽ ཐོས་པར་"
    },
    {
      "span": {
        "start": 5294,
        "end": 5306
      },
      "text": "སོ་ཞེས་བྱ་བ་ ༼སྣར། པེ།༽ སོ་ཞེས་"
    },
    {
      "span": {
        "start": 5347,
        "end": 5353
      },
      "text": "རྣམ་པ་ ༼སྣར། པེ།༽ རྣམ་པར་"
    },
    {
      "span": {
        "start": 5929,
        "end": 5939
      },
      "text": "ཡིད་བརྟེན་ ༼སྣར། པེ།༽ ཡིད་བརྟན་"
    },
    {
      "span": {
        "start": 6265,
        "end": 6279
      },
      "text": "འགྱུར་རོ། །ཞེ་ ༼སྣར།༽ འགྱུར་རོ་ཞེས་ ༼པེ།༽ འགྱུར་ཞེ་"
    },
    {
      "span": {
        "start": 6613,
        "end": 6615
      },
      "text": "ལ་ ༼པེ།༽ ལས་"
    },
    {
      "span": {
        "start": 7242,
        "end": 7247
      },
      "text": "གསུང་ ༼སྣར།༽ གསུངས་"
    },
    {
      "span": {
        "start": 7399,
        "end": 7405
      },
      "text": "དེ་བས་ ༼སྣར། པེ།༽ དེ་བས་ན་"
    },
    {
      "span": {
        "start": 7842,
        "end": 7851
      },
      "text": "འདས་ཀྱིས་ ༼སྣར། པེ།༽ འདས་ཀྱི་"
    },
    {
      "span": {
        "start": 8341,
        "end": 8350
      },
      "text": "ཡིན་པས་མ་ ༼སྣར། པེ།༽ ཡིན་པས་ན་"
    },
    {
      "span": {
        "start": 8374,
        "end": 8381
      },
      "text": "གུས་པར་ ༼སྣར། པེ།༽ གུས་པ་"
    },
    {
      "span": {
        "start": 8764,
        "end": 8769
      },
      "text": "སྨོས་ ༼སྣར། པེ།༽ སྨྲོས་"
    },
    {
      "span": {
        "start": 9106,
        "end": 9113
      },
      "text": "བསྒྲུབ་ ༼སྣར། པེ།༽ བསྒྲུབས་"
    },
    {
      "span": {
        "start": 9255,
        "end": 9262
      },
      "text": "བསྣན་པ་ ༼སྣར། པེ།༽ གནང་པ་"
    },
    {
      "span": {
        "start": 9369,
        "end": 9373
      },
      "text": "བཅས་ ༼སྣར།༽ བཅེས་"
    },
    {
      "span": {
        "start": 9534,
        "end": 9542
      },
      "text": "དེ་བས་ན་ ༼ཅོ།༽ དེར་ལན་"
    },
    {
      "span": {
        "start": 9596,
        "end": 9604
      },
      "text": "གཅིག་གི་ ༼སྣར། པེ།༽ གཅིག་གིས་"
    },
    {
      "span": {
        "start": 9785,
        "end": 9788
      },
      "text": "དུ་ ༼སྣར། པེ།༽ དུ་ཐོས་པར་"
    },
    {
      "span": {
        "start": 9937,
        "end": 9947
      },
      "text": "དུས་གཞན་ན་ ༼པེ།༽ དུས་གཞན་"
    },
    {
      "span": {
        "start": 10290,
        "end": 10296
      },
      "text": "དང་རབ་ ༼སྣར།༽ དང་བ་"
    },
    {
      "span": {
        "start": 10458,
        "end": 10464
      },
      "text": "ལུས་པ་ ༼སྣར། པེ།༽ ལུས་"
    },
    {
      "span": {
        "start": 10826,
        "end": 10831
      },
      "text": "གཙེས་ ༼སྣར།༽ གཙོས་"
    },
    {
      "span": {
        "start": 10933,
        "end": 10942
      },
      "text": "ཡིན་པས་ན་ ༼སྣར།༽ ཡིན་པས་"
    },
    {
      "span": {
        "start": 11205,
        "end": 11213
      },
      "text": "བཞུགས་པ་ ༼སྣར། པེ།༽ ཞུགས་པ་"
    },
    {
      "span": {
        "start": 11287,
        "end": 11295
      },
      "text": "ཁང་བཟངས་ ༼སྣར། པེ།༽ ཁང་བཟང་"
    },
    {
      "span": {
        "start": 11378,
        "end": 11387
      },
      "text": "རྟོག་པའི་ ༼སྣར།༽ རྟོགས་པའི་"
    },
    {
      "span": {
        "start": 11427,
        "end": 11436
      },
      "text": "སྙིང་པོར་ ༼སྣར། པེ།༽ སྙིང་པོ་དེ་"
    },
    {
      "span": {
        "start": 11491,
        "end": 11494
      },
      "text": "དེ་ ༼སྣར། པེ།༽ དེའི་"
    },
    {
      "span": {
        "start": 12210,
        "end": 12221
      },
      "text": "ཡེ་ཤེས་ཀྱི་ ༼སྣར། པེ།༽ ཡེ་ཤེས་ཀྱིས་"
    },
    {
      "span": {
        "start": 12315,
        "end": 12321
      },
      "text": "ལྟ་བུ་ ༼སྣར། པེ།༽ ལྟ་བུ་འདི་"
    },
    {
      "span": {
        "start": 12759,
        "end": 12767
      },
      "text": "བསྟན་ཏོ། ༼སྣར། པེ།༽ བསྟན་ཏེ།"
    },
    {
      "span": {
        "start": 12776,
        "end": 12783
      },
      "text": "དོན་དང་ ༼སྣར། པེ།༽ དོན་"
    },
    {
      "span": {
        "start": 12803,
        "end": 12811
      },
      "text": "ཚོགས་པར་ ༼སྣར། པེ།༽ ཚོགས་པས་"
    },
    {
      "span": {
        "start": 12993,
        "end": 13001
      },
      "text": "བསྟན་ཏོ། ༼སྣར། པེ།༽ བསྟན་ཏེ།"
    },
    {
      "span": {
        "start": 13212,
        "end": 13218
      },
      "text": "བཀྲོལ་ ༼སྣར། པེ།༽ དཀྲོལ་"
    },
    {
      "span": {
        "start": 13290,
        "end": 13297
      },
      "text": "དཔག་ཏུ་ ༼པེ།༽ དཔག་པ་"
    },
    {
      "span": {
        "start": 13301,
        "end": 13303
      },
      "text": "པ་ ༼པེ།༽ ཏུ་"
    },
    {
      "span": {
        "start": 13371,
        "end": 13381
      },
      "text": "ལ་སོགས་པས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 13464,
        "end": 13470
      },
      "text": "སྙོམས་ ༼སྣར།༽ སྙོམ་"
    },
    {
      "span": {
        "start": 13477,
        "end": 13488
      },
      "text": "ཅུང་ཟད་ཀྱང་ ༼སྣར། པེ།༽ ཅུང་ཟད་ཙམ་"
    },
    {
      "span": {
        "start": 13499,
        "end": 13508
      },
      "text": "བསོད་ནམས་ ༼སྣར། པེ།༽ བསོད་སྙོམས་"
    },
    {
      "span": {
        "start": 13745,
        "end": 13753
      },
      "text": "འདས་ཀྱི་ ༼སྣར། པེ།༽ འདས་ཀྱིས་"
    },
    {
      "span": {
        "start": 14116,
        "end": 14122
      },
      "text": "ངེས་པ་ ༼སྣར།༽ ངེས་པར་"
    },
    {
      "span": {
        "start": 14588,
        "end": 14597
      },
      "text": "བསམ་གྱིས་ ༼པེ།༽ བསམ་གྱི་"
    },
    {
      "span": {
        "start": 14656,
        "end": 14659
      },
      "text": "གང་ ༼སྣར། པེ།༽ གོ་"
    },
    {
      "span": {
        "start": 14774,
        "end": 14779
      },
      "text": "གཉིས་ ༼སྣར། པེ།༽ གཉི་ག་"
    },
    {
      "span": {
        "start": 14860,
        "end": 14867
      },
      "text": "སླུ་བས་ ༼སྣར། པེ།༽ བསླུ་བས་"
    },
    {
      "span": {
        "start": 15180,
        "end": 15185
      },
      "text": "བ་ནི། ༼སྣར། པེ།༽ བ་ན་"
    },
    {
      "span": {
        "start": 15190,
        "end": 15194
      },
      "text": "ཅིག་ ༼སྣར། པེ།༽ གཅིག་"
    },
    {
      "span": {
        "start": 15292,
        "end": 15301
      },
      "text": "སེམས་དཔས་ ༼སྣར། པེ།༽ ལ་སེམས་པས་"
    },
    {
      "span": {
        "start": 15381,
        "end": 15390
      },
      "text": "གཉིས་ཀྱི་ ༼སྣར། པེ།༽ གཉིས་ཀྱིས་"
    },
    {
      "span": {
        "start": 15407,
        "end": 15416
      },
      "text": "ཆེན་པོ་ལ་ ༼པེ།༽ ཆེན་པོ་"
    },
    {
      "span": {
        "start": 15554,
        "end": 15562
      },
      "text": "མདོ་སྟེ་ ༼སྣར། པེ།༽ མདོ་སྡེ་"
    },
    {
      "span": {
        "start": 15929,
        "end": 15934
      },
      "text": "ཕྱིར་ ༼སྣར། པེ།༽ ཆེད་དུ་"
    },
    {
      "span": {
        "start": 16037,
        "end": 16042
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བ་ཆེན་པོ་"
    },
    {
      "span": {
        "start": 16838,
        "end": 16848
      },
      "text": "བརྩོམས་པས་ ༼སྣར། པེ།༽ བརྩམས་པས་"
    },
    {
      "span": {
        "start": 17066,
        "end": 17075
      },
      "text": "རྟོགས་པས་ ༼སྡེ།༽ རྟོག་པས་"
    },
    {
      "span": {
        "start": 17681,
        "end": 17685
      },
      "text": "པའི་ ༼སྣར།༽ གའི་"
    },
    {
      "span": {
        "start": 18265,
        "end": 18272
      },
      "text": "རྣམ་པར་ ༼སྣར། པེ།༽ རྣམ་པར་མི་"
    },
    {
      "span": {
        "start": 18546,
        "end": 18551
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བས་"
    },
    {
      "span": {
        "start": 18660,
        "end": 18665
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བས་"
    },
    {
      "span": {
        "start": 18863,
        "end": 18872
      },
      "text": "འདས་ཀྱིས་ ༼སྣར། པེ།༽ འདས་ཀྱི་"
    },
    {
      "span": {
        "start": 19032,
        "end": 19038
      },
      "text": "པའོ། ། ༼པེ།༽ །། །།"
    },
    {
      "span": {
        "start": 19140,
        "end": 19145
      },
      "text": "བྱ་བ་ ༼སྣར། པེ།༽ བྱ་བས་"
    },
    {
      "span": {
        "start": 19148,
        "end": 19153
      },
      "text": "སྐབས་ ༼སྣར། པེ།༽ སྐབས་སམ་"
    },
    {
      "span": {
        "start": 19408,
        "end": 19415
      },
      "text": "ཁྱད་པར་ ༼སྣར། པེ།༽ ཕྱད་པར་"
    },
    {
      "span": {
        "start": 19464,
        "end": 19470
      },
      "text": "ནི་ཇི་ ༼སྣར། པེ།༽ ནི་གྱི་"
    },
    {
      "span": {
        "start": 19523,
        "end": 19529
      },
      "text": "མཛད་པ་ ༼པེ།༽ འཛིན་པ་"
    },
    {
      "span": {
        "start": 19555,
        "end": 19563
      },
      "text": "ཟུང་ཤིག་ ༼སྣར། པེ།༽ ཟུང་ཞིག་"
    },
    {
      "span": {
        "start": 19628,
        "end": 19638
      },
      "text": "བསྒྲུབ་པས་ ༼སྣར། པེ།༽ སྒྲུབ་པས་"
    },
    {
      "span": {
        "start": 20122,
        "end": 20130
      },
      "text": "ཉིད་ཀྱི་ ༼སྣར།༽ ཉིད་ཀྱིས་"
    },
    {
      "span": {
        "start": 20191,
        "end": 20193
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 20423,
        "end": 20432
      },
      "text": "བཅོམ་ལྡན་ ༼སྣར། པེ།༽ བཅོམ་ལྡན་འདས་"
    },
    {
      "span": {
        "start": 20432,
        "end": 20438
      },
      "text": "འཆད་པ་ ༼སྣར། པེ།༽ འཆད་"
    },
    {
      "span": {
        "start": 20674,
        "end": 20681
      },
      "text": "ཆུད་པས་ ༼སྣར།༽ ཆུད་པར་"
    },
    {
      "span": {
        "start": 20860,
        "end": 20868
      },
      "text": "ཐོབ་ཤིག་ ༼སྣར། པེ།༽ ཐོབ་ཅིག་"
    },
    {
      "span": {
        "start": 21072,
        "end": 21078
      },
      "text": "བསྒོམ་ ༼སྣར། པེ།༽ སྒོམ་"
    },
    {
      "span": {
        "start": 21306,
        "end": 21312
      },
      "text": "གཟུངས་ ༼པེ།༽ གསུངས་"
    },
    {
      "span": {
        "start": 21332,
        "end": 21339
      },
      "text": "སྒྲུབས་ ༼སྣར། པེ།༽ བསྒྲུབས་"
    },
    {
      "span": {
        "start": 21856,
        "end": 21864
      },
      "text": "ལེགས་པར་ ༼སྣར། པེ།༽ ལེགས་པ་"
    },
    {
      "span": {
        "start": 21881,
        "end": 21886
      },
      "text": "ཅི་མ་ ༼སྣར། པེ།༽ ཅི་མི་"
    },
    {
      "span": {
        "start": 21924,
        "end": 21932
      },
      "text": "ཟུང་ཤིག་ ༼སྣར། པེ།༽ ཟུང་ཞིག་"
    },
    {
      "span": {
        "start": 21959,
        "end": 21969
      },
      "text": "འཇུག་གཞུག་ ༼སྣར། པེ།༽ གཞུག་"
    },
    {
      "span": {
        "start": 21983,
        "end": 21991
      },
      "text": "སྣོད་ཁས་ ༼སྣར།༽ སྣོད་ཁ་"
    },
    {
      "span": {
        "start": 22134,
        "end": 22142
      },
      "text": "སྣོད་ཁས་ ༼སྣར། པེ།༽ སྣོད་ཁ་"
    },
    {
      "span": {
        "start": 22283,
        "end": 22293
      },
      "text": "དང་གཟུང་བ་ ༼སྣར།༽ དང་གཟུངས་"
    },
    {
      "span": {
        "start": 23194,
        "end": 23214
      },
      "text": "འདིས་རྣམ་པར་མི་རྟོག་ ༼སྣར།༽ རྣམ་པར་མ་རྟོགས་ ༼པེ།༽ མི་རྟོགས་"
    },
    {
      "span": {
        "start": 23529,
        "end": 23541
      },
      "text": "དེ་བཞིན་ཉིད་ ༼སྣར། པེ།༽ དེ་བཞིན་"
    },
    {
      "span": {
        "start": 23815,
        "end": 23824
      },
      "text": "བསམས་པའི་ ༼སྣར། པེ།༽ བསམ་པའི་"
    },
    {
      "span": {
        "start": 23824,
        "end": 23831
      },
      "text": "ཤེས་རབ་ ༼སྣར། པེ།༽ ཤེས་"
    },
    {
      "span": {
        "start": 23842,
        "end": 23850
      },
      "text": "བསྟན་པར་ ༼སྣར། པེ།༽ བརྟན་པར་"
    },
    {
      "span": {
        "start": 23867,
        "end": 23874
      },
      "text": "བསྟན་པ་ ༼སྣར། པེ།༽ བརྟན་པ་"
    },
    {
      "span": {
        "start": 23926,
        "end": 23932
      },
      "text": "མོས་པ་ ༼ཅོ།༽ མོས་པར་"
    },
    {
      "span": {
        "start": 24043,
        "end": 24051
      },
      "text": "བསམ་པའི་ ༼སྣར།༽ བསམས་པའི་"
    },
    {
      "span": {
        "start": 24123,
        "end": 24131
      },
      "text": "བསྒོམ་པ་ ༼སྣར། པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 24364,
        "end": 24378
      },
      "text": "གཉེན་པོ་བསྒོམ་ ༼སྣར། པེ།༽ གཉེན་པོ་ལ་དམིགས་པའི་མཚན་མ་དང་གཉེན་པོ་བསྒོམས་"
    },
    {
      "span": {
        "start": 24490,
        "end": 24497
      },
      "text": "རིམ་དུ་ ༼སྣར། པེ།༽ རིམས་སུ་"
    },
    {
      "span": {
        "start": 25255,
        "end": 25264
      },
      "text": "ཞུགས་པའི་ ༼སྣར། པེ།༽ བཞུགས་པའི་"
    },
    {
      "span": {
        "start": 25264,
        "end": 25276
      },
      "text": "རང་བཞིན་གྱི་ ༼སྣར། པེ།༽ རང་བཞིན་གྱིས་"
    },
    {
      "span": {
        "start": 25360,
        "end": 25367
      },
      "text": "གསལ་བར་ ༼སྣར། པེ།༽ བསལ་བར་"
    },
    {
      "span": {
        "start": 25827,
        "end": 25829
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་མི་"
    },
    {
      "span": {
        "start": 26168,
        "end": 26176
      },
      "text": "དོན་གྱི་ ༼སྡེ།༽ དོན་གྱིས་"
    },
    {
      "span": {
        "start": 26208,
        "end": 26216
      },
      "text": "བརྫུན་པ་ ༼སྣར། པེ།༽ རྫུན་པ་"
    },
    {
      "span": {
        "start": 26545,
        "end": 26552
      },
      "text": "སོ་སོར་ ༼སྣར། པེ།༽ སོ་སོ་"
    },
    {
      "span": {
        "start": 26580,
        "end": 26588
      },
      "text": "དེའི་ཚེ་ ༼སྣར།༽ དེའི་"
    },
    {
      "span": {
        "start": 26756,
        "end": 26761
      },
      "text": "ཉལ་བ་ ༼སྣར། པེ།༽ ཉལ་"
    },
    {
      "span": {
        "start": 28128,
        "end": 28135
      },
      "text": "དྲུད་པ་ ༼པེ།༽ དྲུད་"
    },
    {
      "span": {
        "start": 28371,
        "end": 28381
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ སྒོམ་པའི་"
    },
    {
      "span": {
        "start": 28427,
        "end": 28433
      },
      "text": "སྒྲའི་ ༼སྣར། པེ།༽ སྒྲའི་པ་"
    },
    {
      "span": {
        "start": 28439,
        "end": 28443
      },
      "text": "མེད་ ༼སྣར། པེ།༽ མེད་ན་"
    },
    {
      "span": {
        "start": 28545,
        "end": 28548
      },
      "text": "ཅད་ ༼པེ།༽ འཆད་"
    },
    {
      "span": {
        "start": 28822,
        "end": 28831
      },
      "text": "བསྲང་སྟེ། ༼སྣར། པེ།༽ བསྲུངས་ཏེ།"
    },
    {
      "span": {
        "start": 28905,
        "end": 28916
      },
      "text": "བསྐྱེད་པའི་ ༼སྣར། པེ།༽ བསྐྱེད་པ་"
    },
    {
      "span": {
        "start": 28998,
        "end": 29004
      },
      "text": "བསྒོམ་ ༼སྣར། པེ།༽ སྒོམ་"
    },
    {
      "span": {
        "start": 29223,
        "end": 29231
      },
      "text": "བསམ་པའི་ ༼སྣར།༽ བསམས་པའི་"
    },
    {
      "span": {
        "start": 29420,
        "end": 29425
      },
      "text": "མདོར་ ༼པེ།༽ འདོར་"
    },
    {
      "span": {
        "start": 29446,
        "end": 29454
      },
      "text": "རུང་སྟེ། ༼པེ།༽ རུང་ཏེ།"
    },
    {
      "span": {
        "start": 29949,
        "end": 29958
      },
      "text": "རྟོག་པའི་ ༼སྣར། པེ།༽ རྟོག་པའི་དབྱིངས་"
    },
    {
      "span": {
        "start": 30289,
        "end": 30300
      },
      "text": "ཇི་ལྟར་འོས་ ༼སྣར།༽ ཇི་ལྟར་འོ་"
    },
    {
      "span": {
        "start": 30477,
        "end": 30481
      },
      "text": "དགག་ ༼སྣར། པེ།༽ དག་"
    },
    {
      "span": {
        "start": 30521,
        "end": 30532
      },
      "text": "ལ་སོགས་པའི་ ༼སྣར། པེ།༽ ལ་སོགས་པ་ནི་"
    },
    {
      "span": {
        "start": 30727,
        "end": 30734
      },
      "text": "ཅི་ཡང་། ༼སྣར། པེ།༽ ཅིས་སྤང་།"
    },
    {
      "span": {
        "start": 31130,
        "end": 31137
      },
      "text": "སྤང་བར་ ༼སྣར།༽ སྤང་བར་བྱ་བ་"
    },
    {
      "span": {
        "start": 31297,
        "end": 31305
      },
      "text": "སྦྱིན་པ་ ༼སྣར། པེ།༽ སྦྱིན་པ་ལ་"
    },
    {
      "span": {
        "start": 31463,
        "end": 31480
      },
      "text": "འདོད་པས་གཞན་དག་ལ་ ༼སྣར། པེ།༽ འདོད་པས་"
    },
    {
      "span": {
        "start": 31505,
        "end": 31515
      },
      "text": "རྣམས་ཀྱིས་ ༼སྣར། པེ།༽ རྣམས་ཀྱི་"
    },
    {
      "span": {
        "start": 31669,
        "end": 31676
      },
      "text": "མཇེད་པ་ ༼སྣར། པེ།༽ མཆེད་པ་"
    },
    {
      "span": {
        "start": 32282,
        "end": 32291
      },
      "text": "འགྱུར་རོ། ༼སྣར། པེ།༽ འགྱུར་བའོ།"
    },
    {
      "span": {
        "start": 32414,
        "end": 32425
      },
      "text": "ཤེས་རབ་ཀྱི་ ༼སྣར། པེ།༽ ཤེས་རབ་ཀྱིས་"
    },
    {
      "span": {
        "start": 32608,
        "end": 32616
      },
      "text": "སྤྱོད་པ་ ༼སྣར། པེ།༽ དཔྱོད་པ་"
    },
    {
      "span": {
        "start": 32758,
        "end": 32765
      },
      "text": "སྤོང་བ་ ༼སྣར། པེ།༽ སྤང་བ་"
    },
    {
      "span": {
        "start": 32889,
        "end": 32896
      },
      "text": "མཐའ་དག་ ༼སྣར། པེ།༽ མཐའ་"
    },
    {
      "span": {
        "start": 33815,
        "end": 33823
      },
      "text": "སྐྱེ་བོ་ ༼སྣར། པེ།༽ སྐྱེ་བོས་"
    },
    {
      "span": {
        "start": 33831,
        "end": 33839
      },
      "text": "བརྟགས་པ་ ༼སྣར།༽ བརྟོགས་པ་"
    },
    {
      "span": {
        "start": 34016,
        "end": 34025
      },
      "text": "འགྱུར་བས་ ༼སྣར། པེ།༽ འགྲུབ་པས་"
    },
    {
      "span": {
        "start": 34089,
        "end": 34099
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ བསྒོམས་པའི་"
    },
    {
      "span": {
        "start": 34839,
        "end": 34847
      },
      "text": "སྤྱོད་པ་ ༼སྣར། པེ།༽ དཔྱོད་པ་"
    },
    {
      "span": {
        "start": 34994,
        "end": 35002
      },
      "text": "སླུ་བའི་ ༼སྣར། པེ།༽ བསླུ་བའི་"
    },
    {
      "span": {
        "start": 35347,
        "end": 35353
      },
      "text": "ཆོས་ལ་ ༼སྣར། པེ།༽ ཆོས་"
    },
    {
      "span": {
        "start": 35576,
        "end": 35584
      },
      "text": "རྟོགས་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 35609,
        "end": 35611
      },
      "text": "པ་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 35842,
        "end": 35849
      },
      "text": "གྱུར་པ་ ༼ཅོ།༽ འགྱུར་བ་"
    },
    {
      "span": {
        "start": 35937,
        "end": 35941
      },
      "text": "ཉིད་ ༼སྣར། པེ།༽ ས་"
    },
    {
      "span": {
        "start": 36142,
        "end": 36149
      },
      "text": "ཉིད་དོ། ༼སྣར། པེ།༽ ཉིད་དེ།"
    },
    {
      "span": {
        "start": 36179,
        "end": 36181
      },
      "text": "མ་ ༼སྣར། པེ།༽ མི་"
    },
    {
      "span": {
        "start": 36696,
        "end": 36705
      },
      "text": "ཁོ་ན་སྟེ། ༼སྣར། པེ།༽ ཁོ་ན་ཏེ།"
    },
    {
      "span": {
        "start": 36710,
        "end": 36720
      },
      "text": "བཞུགས་པའི་ ༼སྣར། པེ།༽ ཞུགས་པ་ཡི་"
    },
    {
      "span": {
        "start": 36916,
        "end": 36921
      },
      "text": "རྟོག་ ༼པེ།༽ རྟོགས་"
    },
    {
      "span": {
        "start": 37974,
        "end": 37982
      },
      "text": "ཐོབ་པའི་ ༼སྣར། པེ།༽ འཐོབ་པའི་"
    },
    {
      "span": {
        "start": 38120,
        "end": 38137
      },
      "text": "སངས་རྒྱས་ཀྱི་ཞིང་ ༼སྣར། པེ།༽ སངས་རྒྱས་ཀྱིས་"
    },
    {
      "span": {
        "start": 38298,
        "end": 38306
      },
      "text": "སྤྱོད་པ་ ༼སྣར། པེ།༽ དཔྱོད་པ་"
    },
    {
      "span": {
        "start": 38433,
        "end": 38442
      },
      "text": "སངས་རྒྱས་ ༼སྣར།༽ སངས་རྒྱས་བརྒྱ་"
    },
    {
      "span": {
        "start": 38454,
        "end": 38463
      },
      "text": "དེ་དག་གི་ ༼སྣར། པེ།༽ དེ་དག་གིས་"
    },
    {
      "span": {
        "start": 38877,
        "end": 38883
      },
      "text": "རྣམ་པ་ ༼སྣར།༽ རྣམ་པར་"
    },
    {
      "span": {
        "start": 39248,
        "end": 39252
      },
      "text": "ཞིང་ ༼པེ།༽ ཞིང་ནི་"
    },
    {
      "span": {
        "start": 39263,
        "end": 39276
      },
      "text": "འབུམ་ཕྲག་ཕྲག་ ༼སྣར། པེ།༽ འབུམ་ཕྲག་"
    },
    {
      "span": {
        "start": 39908,
        "end": 39912
      },
      "text": "སྤང་ ༼སྣར། པེ།༽ སྤོང་"
    },
    {
      "span": {
        "start": 40188,
        "end": 40197
      },
      "text": "གསུངས་ཏེ། ༼སྣར། པེ།༽ གསུངས་པ་སྟེ།"
    },
    {
      "span": {
        "start": 41151,
        "end": 41156
      },
      "text": "གཟུང་ ༼སྣར།༽ བཟུང་"
    },
    {
      "span": {
        "start": 41367,
        "end": 41372
      },
      "text": "ཁོ་ན་ ༼སྣར། པེ།༽ ཁོ་"
    },
    {
      "span": {
        "start": 41504,
        "end": 41509
      },
      "text": "རྩོལ་ ༼སྣར། པེ།༽ རྩོལ་བ་"
    },
    {
      "span": {
        "start": 41571,
        "end": 41578
      },
      "text": "བརྩལ་བ་ ༼སྣར། པེ།༽ རྩོལ་བ་"
    },
    {
      "span": {
        "start": 41650,
        "end": 41657
      },
      "text": "བརྩལ་བ་ ༼སྣར། པེ།༽ རྩོལ་བ་"
    },
    {
      "span": {
        "start": 41711,
        "end": 41716
      },
      "text": "དམུས་ ༼པེ།༽ དབུས་"
    },
    {
      "span": {
        "start": 41789,
        "end": 41796
      },
      "text": "གསལ་བར་ ༼སྣར། པེ།༽ བསལ་བར་"
    },
    {
      "span": {
        "start": 41803,
        "end": 41808
      },
      "text": "དགོད་ ༼སྣར། པེ།༽ རྒོད་"
    },
    {
      "span": {
        "start": 42021,
        "end": 42029
      },
      "text": "བསམས་ཏེ། ༼སྣར། པེ།༽ བསམ་སྟེ།"
    },
    {
      "span": {
        "start": 42128,
        "end": 42133
      },
      "text": "ལྟོས་ ༼སྣར། པེ།༽ བལྟོས་"
    },
    {
      "span": {
        "start": 42136,
        "end": 42144
      },
      "text": "འབྱུང་བ་ ༼སྣར། པེ།༽ འབྱུང་"
    },
    {
      "span": {
        "start": 42722,
        "end": 42730
      },
      "text": "ལྡན་པའི་ ༼སྣར། པེ།༽ ལྡན་པ་"
    },
    {
      "span": {
        "start": 43173,
        "end": 43181
      },
      "text": "གསུངས་པ་ ༼སྣར། པེ།༽ གསུང་བ་"
    },
    {
      "span": {
        "start": 43343,
        "end": 43352
      },
      "text": "སེམས་དཔའ་ ༼སྣར། པེ།༽ སེམས་དཔས་"
    },
    {
      "span": {
        "start": 43605,
        "end": 43613
      },
      "text": "བསྒོམ་པ་ ༼སྣར། པེ།༽ སྒོམ་པ་"
    },
    {
      "span": {
        "start": 43701,
        "end": 43708
      },
      "text": "དབྱིངས་ ༼སྣར། པེ།༽ དབྱིང་"
    },
    {
      "span": {
        "start": 43831,
        "end": 43844
      },
      "text": "ཚུལ་བཞིན་གྱི་ ༼སྣར། པེ།༽ ཚུལ་བཞིན་གྱིས་"
    },
    {
      "span": {
        "start": 44137,
        "end": 44147
      },
      "text": "བསྒོམ་པའི་ ༼སྣར། པེ།༽ བསྒོམས་པའི་"
    },
    {
      "span": {
        "start": 44348,
        "end": 44354
      },
      "text": "དྲན་པ་ ༼སྣར། པེ།༽ དྲ་བ་"
    },
    {
      "span": {
        "start": 45123,
        "end": 45131
      },
      "text": "བསྒོམ་པ་ ༼སྣར། པེ།༽ བསྒོམས་པ་"
    },
    {
      "span": {
        "start": 45347,
        "end": 45355
      },
      "text": "རྒྱུན་མ་ ༼སྣར། པེ།༽ རྒྱུ་མ་"
    },
    {
      "span": {
        "start": 45372,
        "end": 45375
      },
      "text": "ནས་ ༼སྣར། པེ།༽ ནས་དུས་"
    },
    {
      "span": {
        "start": 45878,
        "end": 45885
      },
      "text": "ཆུང་ངུ་ ༼སྣར། པེ།༽ ཆུང་ངུ་དང་"
    },
    {
      "span": {
        "start": 46094,
        "end": 46101
      },
      "text": "བརྟག་པ་ ༼སྣར། པེ།༽ རྟོག་པ་"
    },
    {
      "span": {
        "start": 46157,
        "end": 46163
      },
      "text": "རང་གི་ ༼སྣར། པེ།༽ རང་གིས་"
    },
    {
      "span": {
        "start": 46239,
        "end": 46249
      },
      "text": "བསྟན་པ་དང་ ༼སྣར།༽ བསྟན་པ་པོ་ང་"
    },
    {
      "span": {
        "start": 46437,
        "end": 46444
      },
      "text": "མིག་གི་ ༼པེ།༽ མིག་"
    },
    {
      "span": {
        "start": 46623,
        "end": 46630
      },
      "text": "ཡུལ་དུ་ ༼སྣར། པེ།༽ ཡུལ་"
    },
    {
      "span": {
        "start": 46873,
        "end": 46880
      },
      "text": "བརྟག་པ་ ༼སྣར།༽ རྟག་པ་"
    },
    {
      "span": {
        "start": 47170,
        "end": 47183
      },
      "text": "རང་བཞིན་གྱིས་ ༼སྣར། པེ།༽ རང་བཞིན་གྱི་"
    },
    {
      "span": {
        "start": 47394,
        "end": 47399
      },
      "text": "དེའི་ ༼སྣར། པེ།༽ དེ་ནི་"
    },
    {
      "span": {
        "start": 47901,
        "end": 47912
      },
      "text": "མཚན་ཉིད་དོ། ༼སྣར།༽ མཚན་ཉིད།"
    },
    {
      "span": {
        "start": 48507,
        "end": 48514
      },
      "text": "ཐམས་ཅད་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱི་མཆོག་དང་ལྡན་པའི་ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 48663,
        "end": 48667
      },
      "text": "འདི་ ༼སྣར། པེ།༽ འདི་ནི་"
    },
    {
      "span": {
        "start": 49409,
        "end": 49418
      },
      "text": "ལྷ་སྦྱིན་ ༼སྣར། པེ།༽ ལྷས་བྱིན་"
    },
    {
      "span": {
        "start": 49940,
        "end": 49942
      },
      "text": "པ་ ༼སྣར། པེ།༽ པར་"
    },
    {
      "span": {
        "start": 50109,
        "end": 50122
      },
      "text": "ཐམས་ཅད་དུ་ཡང་ ༼སྣར། པེ།༽ ཐམས་ཅད་"
    },
    {
      "span": {
        "start": 50355,
        "end": 50365
      },
      "text": "དོན་དམ་པར་ ༼སྣར། པེ།༽ དོན་དམ་པར་འགྱུར་བའི་སྐྱོན་དུ་"
    },
    {
      "span": {
        "start": 50834,
        "end": 50852
      },
      "text": "རྟེན་ཅིང་འབྲེལ་བར་ ༼སྣར། པེ།༽ རྟེན་ཅིང་"
    },
    {
      "span": {
        "start": 50909,
        "end": 50915
      },
      "text": "ད་ལྟར་ ༼སྣར། པེ།༽ དེ་ལྟར་"
    },
    {
      "span": {
        "start": 51355,
        "end": 51361
      },
      "text": "འགལ་བ་ ༼སྣར། པེ།༽ འགལ་བས་"
    },
    {
      "span": {
        "start": 51634,
        "end": 51642
      },
      "text": "དབང་གིས་ ༼པེ།༽ དབང་གི་"
    },
    {
      "span": {
        "start": 51683,
        "end": 51691
      },
      "text": "སྐྱེ་བོ་ ༼སྣར། པེ།༽ སྐྱེ་བ་"
    },
    {
      "span": {
        "start": 52044,
        "end": 52051
      },
      "text": "ཐོབ་པས་ ༼སྣར། པེ།༽ ཐོབ་པ་"
    },
    {
      "span": {
        "start": 52212,
        "end": 52222
      },
      "text": "འཇིག་རྟེན་ ༼སྣར། པེ།༽ འཇིག་རྟེན་དུ་"
    },
    {
      "span": {
        "start": 52425,
        "end": 52430
      },
      "text": "དེ་ལ་ ༼སྣར། པེ།༽ དེ་ལྟ་"
    },
    {
      "span": {
        "start": 53604,
        "end": 53616
      },
      "text": "མཚུངས་པར་ཏེ། ༼སྣར། པེ།༽ མཚུངས་པ་སྟེ།"
    },
    {
      "span": {
        "start": 53723,
        "end": 53732
      },
      "text": "མཚུངས་པར་ ༼སྣར།༽ མཚུངས་པ་"
    },
    {
      "span": {
        "start": 53775,
        "end": 53783
      },
      "text": "ཐོབ་པའི་ ༼སྣར། པེ།༽ ཐོས་པའི་"
    },
    {
      "span": {
        "start": 55337,
        "end": 55343
      },
      "text": "དབང་བ་ ༼སྣར། པེ།༽ དབང་བ་ཐོབ་པ་"
    },
    {
      "span": {
        "start": 56046,
        "end": 56054
      },
      "text": "དངོས་པོ། ༼སྣར། པེ།༽ དངོས་སོ།"
    },
    {
      "span": {
        "start": 56588,
        "end": 56596
      },
      "text": "རྐོ་བའི་ ༼སྣར། པེ།༽ བརྐོ་བའི་"
    },
    {
      "span": {
        "start": 56804,
        "end": 56809
      },
      "text": "བསགས་ ༼སྣར། པེ།༽ བསག་"
    },
    {
      "span": {
        "start": 57446,
        "end": 57459
      },
      "text": "རྟོག་པའི་བྱེ་ ༼སྣར། པེ།༽ རྟོག་པའི་"
    },
    {
      "span": {
        "start": 57579,
        "end": 57587
      },
      "text": "སྐྱེ་བས་ ༼སྣར། པེ།༽ སྐྱེ་བར་"
    },
    {
      "span": {
        "start": 57621,
        "end": 57629
      },
      "text": "གཅིག་དང་ ༼སྣར། པེ།༽ གཅིག་ཏུ་"
    },
    {
      "span": {
        "start": 58752,
        "end": 58764
      },
      "text": "ཤེས་པའི་མིང་ ༼སྣར། པེ།༽ ཤེས་པའི་མི་"
    },
    {
      "span": {
        "start": 58768,
        "end": 58775
      },
      "text": "བྱ་སྟེ་ ༼སྣར། པེ།༽ བྱ་ཏེ་"
    },
    {
      "span": {
        "start": 59002,
        "end": 59010
      },
      "text": "གསུང་བས་ ༼སྣར།༽ གསུང་བསུ་ ༼པེ།༽ གསུངས་པས་"
    },
    {
      "span": {
        "start": 59084,
        "end": 59093
      },
      "text": "བཅོམ་པའོ། ༼སྣར། པེ།༽ བཅོམ་པའམ།"
    },
    {
      "span": {
        "start": 59388,
        "end": 59399
      },
      "text": "རང་བཞིན་ནི་ ༼སྣར། པེ།༽ རང་བཞིན་"
    },
    {
      "span": {
        "start": 59414,
        "end": 59433
      },
      "text": "གཞོར་ལ་སོགས་པས་རྐོ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་བརྐོ་"
    },
    {
      "span": {
        "start": 59456,
        "end": 59466
      },
      "text": "འགྲུབ་ཀྱི་ ༼སྣར། པེ།༽ འགྲུབ་ཀྱིས་"
    },
    {
      "span": {
        "start": 59841,
        "end": 59847
      },
      "text": "འགྱུར་ ༼སྣར། པེ།༽ གྱུར་"
    },
    {
      "span": {
        "start": 59851,
        "end": 59860
      },
      "text": "ཡིད་བཞིན་ ༼སྣར།༽ འདི་བཞིན་"
    },
    {
      "span": {
        "start": 60896,
        "end": 60905
      },
      "text": "བཅུ་བཞིས་ ༼སྣར། པེ།༽ བཅུ་བཞི་པ་"
    },
    {
      "span": {
        "start": 61035,
        "end": 61044
      },
      "text": "སྤོངས་པར་ ༼སྣར།༽ སྤངས་པར་ ༼པེ།༽ སྤོང་"
    },
    {
      "span": {
        "start": 61298,
        "end": 61303
      },
      "text": "བྱ་བ་ ༼སྣར།༽ བྱ་བར་"
    },
    {
      "span": {
        "start": 61535,
        "end": 61543
      },
      "text": "ལ་བརྟགས་ ༼སྣར། པེ།༽ ལ་བཏགས་"
    },
    {
      "span": {
        "start": 61641,
        "end": 61647
      },
      "text": "གཟུགས་ ༼སྣར།༽ གཟུག་པ་"
    },
    {
      "span": {
        "start": 61776,
        "end": 61784
      },
      "text": "བརྟག་པར་ ༼སྣར། པེ།༽ བརྟགས་པར་"
    },
    {
      "span": {
        "start": 62252,
        "end": 62258
      },
      "text": "གཟུགས་ ༼སྣར།༽ གཟུངས་"
    },
    {
      "span": {
        "start": 62378,
        "end": 62383
      },
      "text": "གཟོད་ ༼པེ།༽ བཟོད་"
    },
    {
      "span": {
        "start": 62665,
        "end": 62671
      },
      "text": "དང་མི་ ༼སྣར།༽ དང་མ་"
    },
    {
      "span": {
        "start": 62891,
        "end": 62893
      },
      "text": "ལ་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 63057,
        "end": 63063
      },
      "text": "པའོ། ། ༼སྣར།༽ ། །དེ་"
    },
    {
      "span": {
        "start": 63189,
        "end": 63198
      },
      "text": "བཏགས་པའི་ ༼སྣར། པེ།༽ བརྟགས་པའི་"
    },
    {
      "span": {
        "start": 63420,
        "end": 63427
      },
      "text": "ངོ་བོར་ ༼སྣར། པེ།༽ ངོ་བོ་"
    },
    {
      "span": {
        "start": 63437,
        "end": 63446
      },
      "text": "འབྲས་བུར་ ༼སྣར། པེ།༽ འབྲས་བུ་"
    },
    {
      "span": {
        "start": 63609,
        "end": 63615
      },
      "text": "སྣང་བ་ ༼སྣར། པེ།༽ སྣང་བའི་"
    },
    {
      "span": {
        "start": 63864,
        "end": 63870
      },
      "text": "གཟུགས་ ༼སྣར། པེ།༽ གཟུགས་སུ་"
    },
    {
      "span": {
        "start": 63981,
        "end": 63991
      },
      "text": "མཐར་འགྱུར་ ༼སྣར། པེ།༽ མཐར་"
    },
    {
      "span": {
        "start": 64126,
        "end": 64130
      },
      "text": "གིས་ ༼སྣར། པེ།༽ གི་ཕྱིར་"
    },
    {
      "span": {
        "start": 64448,
        "end": 64453
      },
      "text": "གཟོན་ ༼སྣར། པེ།༽ གསོན་"
    },
    {
      "span": {
        "start": 64590,
        "end": 64592
      },
      "text": "ན་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 64944,
        "end": 64946
      },
      "text": "པ་ ༼སྣར། པེ།༽ ལ་"
    },
    {
      "span": {
        "start": 64949,
        "end": 64953
      },
      "text": "བོར་ ༼སྣར། པེ།༽ ནོར་"
    },
    {
      "span": {
        "start": 65105,
        "end": 65107
      },
      "text": "པ་ ༼སྣར། པེ།༽ གསོན་"
    },
    {
      "span": {
        "start": 65165,
        "end": 65172
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་པར་ཡང་"
    },
    {
      "span": {
        "start": 65615,
        "end": 65622
      },
      "text": "མེད་པར་ ༼སྣར། པེ།༽ མེད་པར་ཡང་"
    },
    {
      "span": {
        "start": 66362,
        "end": 66369
      },
      "text": "ཉིད་དུ་ ༼སྣར། པེ།༽ ཉིད་"
    },
    {
      "span": {
        "start": 66434,
        "end": 66441
      },
      "text": "དེ་ཉིད་ ༼སྣར། པེ།༽ དེ་ཉིད་དེ་"
    },
    {
      "span": {
        "start": 66608,
        "end": 66621
      },
      "text": "འདུ་བྱེད་ཀྱི་ ༼སྣར། པེ།༽ འདུ་བྱེད་ཀྱིས་"
    },
    {
      "span": {
        "start": 66905,
        "end": 66917
      },
      "text": "དངོས་པོར་ཡང་ ༼སྣར། པེ།༽ དངོས་པོར་ཡང་ཡང་"
    },
    {
      "span": {
        "start": 67049,
        "end": 67052
      },
      "text": "མི་ ༼སྣར། པེ།༽ མི་མཐོང་བ་ནི་དངོས་པོ་མི་"
    },
    {
      "span": {
        "start": 67360,
        "end": 67371
      },
      "text": "ཐམས་ཅད་ཀྱི་ ༼སྣར། པེ།༽ ཐམས་ཅད་ཀྱིས་"
    },
    {
      "span": {
        "start": 67853,
        "end": 67861
      },
      "text": "བརྟེན་པ་ ༼སྣར། པེ།༽ བསྟན་པ་"
    },
    {
      "span": {
        "start": 67943,
        "end": 67956
      },
      "text": "སྒྲོ་འདོགས་པ་ ༼སྣར། པེ།༽ སྒྲོ་འདོགས་"
    },
    {
      "span": {
        "start": 68031,
        "end": 68034
      },
      "text": "ལོ། ༼སྣར། པེ།༽ དུའོ།"
    },
    {
      "span": {
        "start": 68149,
        "end": 68156
      },
      "text": "ཚིག་གི་ ༼སྣར། པེ།༽ ཚིག་"
    },
    {
      "span": {
        "start": 68188,
        "end": 68192
      },
      "text": "རིག་ ༼སྣར། པེ།༽ རིགས་"
    },
    {
      "span": {
        "start": 68380,
        "end": 68384
      },
      "text": "གཅད་ ༼སྣར། པེ།༽ བཅད་"
    },
    {
      "span": {
        "start": 68448,
        "end": 68456
      },
      "text": "སྤང་བའི་ ༼སྣར། པེ།༽ སྤོང་བའི་"
    },
    {
      "span": {
        "start": 68800,
        "end": 68809
      },
      "text": "ལྟོས་པའི་ ༼སྣར། པེ།༽ བལྟོས་པའི་"
    },
    {
      "span": {
        "start": 68874,
        "end": 68880
      },
      "text": "དང་རོ་ ༼སྣར།༽ དང་བོ་"
    },
    {
      "span": {
        "start": 69217,
        "end": 69222
      },
      "text": "སྡུད་ ༼སྣར།༽ སྡུས་"
    },
    {
      "span": {
        "start": 69368,
        "end": 69376
      },
      "text": "ནི་དེའི་ ༼སྣར། པེ།༽ ནི་"
    },
    {
      "span": {
        "start": 69431,
        "end": 69436
      },
      "text": "བསམས་ ༼པེ།༽ བསམ་"
    },
    {
      "span": {
        "start": 69535,
        "end": 69539
      },
      "text": "ཞེས་ ༼སྣར། པེ།༽ ཞེས་གང་"
    },
    {
      "span": {
        "start": 69630,
        "end": 69640
      },
      "text": "ལ་སོགས་པས་ ༼སྣར། པེ།༽ ལ་སོགས་པ་"
    },
    {
      "span": {
        "start": 70189,
        "end": 70198
      },
      "text": "བསྟན་པའི་ ༼སྣར། པེ།༽ བརྟན་པའི་"
    },
    {
      "span": {
        "start": 70274,
        "end": 70278
      },
      "text": "ཁྱད་ ༼སྣར། པེ།༽ ཁྱད་པར་"
    },
    {
      "span": {
        "start": 70417,
        "end": 70420
      },
      "text": "དེ་ ༼སྣར།༽ རོ་"
    },
    {
      "span": {
        "start": 70939,
        "end": 70949
      },
      "text": "བྱེད་པས་ན་ ༼སྣར། པེ།༽ བྱེད་པས་"
    },
    {
      "span": {
        "start": 70978,
        "end": 70984
      },
      "text": "གཟུངས་ ༼སྣར། པེ།༽ གཟུགས་"
    },
    {
      "span": {
        "start": 71160,
        "end": 71170
      },
      "text": "བཤད་པ་ཡིས། ༼སྣར། པེ།༽ བཤད་པ་ཡི།"
    },
    {
      "span": {
        "start": 71291,
        "end": 71296
      },
      "text": "ཤོག ་ ༼སྣར། པེ།༽ ཤོག།། །།"
    },
    {
      "span": {
        "start": 71363,
        "end": 71367
      },
      "text": "ཀ་མ་ ༼སྣར། པེ།༽ ཀ་མཱ་"
    },
    {
      "span": {
        "start": 71445,
        "end": 71448
      },
      "text": "ཞུ་ ༼སྣར། པེ།༽ ཞུས་"
    }
  ]
}