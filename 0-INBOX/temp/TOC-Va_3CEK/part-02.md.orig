   * 1.50 ལས་འབྲས་བུ་དང་བཅས་པ [[གོང་དུ་འབྲས་བུ་ལྔ་བཤད་པ་གང་དག་ཡིན་པ་དེ་དག་ལས་ལས་གང་ཞིག]]
   * 1.51 རིགས་པ་མ་ཡིན་པས་བསྐྱེད་པ་ལ་སོགས་པའི་ལས [[ལས་བསྟན་པའི་སྐབས་སུ་འདི་ཡང་ཡོངས་སུ་བྲི་བར༌[^715]བྱ་སྟེ།]]
   * 1.52 ལས་གཅིག་གིས་སྐྱེ་བ་གཅིག་འཕེན་པ [[ཅི་ལས་གཅིག་གིས་སྐྱེ་བ་གཅིག་ཁོ་ན་འཕེན་ཏམ་འོན་ཏེ་དུ་མ་ཡང་འཕེན།]]
   * 1.53 སྒྲིབ་པ་གསུམ [[བཅོམ་ལྡན་འདས་ཀྱིས་ལས་ཀྱི་སྒྲིབ་པ་དང་། ཉོན་མོངས་པའི་སྒྲིབ་པ་དང་།]]
   * 1.54 མཚམས་མེད་པ་རྣམས་ཀྱི་རང་བཞིན [[མཚམས་མེད་པ་རྣམས་ཀྱི་རང་བཞིན་ཅི་ཞེ་ན།]]
   * 1.55 དགེ་འདུན་གྱི་དབྱེན [[རྒྱུ་ལ་འབྲས་བུ་བཏགས་པའམ། འདིས་འབྱེད་པར་བྱེད་པས་ན་དགེ་འདུན་གྱི་དབྱེན]]
   * 1.56 མ་བསད་པ་ལ་སོགས་པ་མཚམས་མེད་པ་ཡིན་པ [[ཅིའི་ཕྱིར་མ་བསད་པ་ལ་སོགས་པ་མཚམས་མེད་པ་ཡིན་ལ་གཞན་ནི་མ་ཡིན་ཞེ་ན།]]
   * 1.57 ཁ་ན་མ་ཐོ་བ་དང་བཅས་པ་ཆེན་པོ [[མཚམས་མེད་པའི་ལས་འདི་དག་ལས་ཐམས་ཅད་ཀྱི་ནང་ན་ཁ་ན་མ་ཐོ་བ་དང་བཅས་པ་ཆེན་པོ]]
   * 1.58 ལེགས་པར་སྤྱད་པ་རྣམས་ལས་འབྲས་བུ་རབ་ཏུ་ཆེ་བ [[ལེགས་པར་སྤྱད་པ་རྣམས་ལས་འབྲས་བུ་རབ་ཏུ་ཆེ་བ་གང་ཡིན་ཞེ་ན།]]
   * 1.59 མཚམས་མེད་པ་དང་ཆ་འདྲ་བ [[ཅི་མཚམས་མེད་པ་རྣམས་ཁོ་ནས་དམྱལ་བ་དག་ཏུ་གདོན་མི་ཟ་བར་སྐྱེ་བར་འགྱུར་རམ།]]
   * 1.60 དུས་གསུམ་པོ་དག་ཏུ་ཤིན་ཏུ་བགེགས་བྱེད་པ [[རྣམ་པར་སྨིན་པ་དང་བཅས་པའི་ལས་གཞན་ཡང་དུས་གསུམ་པོ་དག་ཏུ་ཤིན་ཏུ་བགེགས་བྱེད༌[^819]དེ།]]
   * 1.61 གང་ནས་བྱང་ཆུབ་སེམས་དཔའ་ཡིན་པ [[བྱང་ཆུབ་སེམས་དཔའ་གསད་པ་ཞེས་བཤད་པ་གང་ཡིན་པ། གང་ནས་བྱང་ཆུབ་སེམས་དཔའ་ཡིན། །]]
   * 1.62 མཚན་རྣམ་པར་སྨིན་པ་ཅན་གྱི་ལས [[མཚན་རྣམ་པར་སྨིན་པ་ཅན་གྱི་ལས་སུ་བཤད་པ་གང་ཡིན་པ།]]
   * 1.63 སངས་རྒྱས་ཇི་སྙེད་ཅིག་ལ་བསྙེན་བཀུར་བྱས་པ [[ཡང་བཅོམ་ལྡན་འདས་བྱང་ཆུབ་སེམས་དཔར༌[^838]གྱུར་པ་ན་སངས་རྒྱས་ཇི་སྙེད་ཅིག་ལ]]
   * 1.64 ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པ [[ཡང་བྱང་ཆུབ་སེམས་དཔའ་གནས་སྐབས་གང་དག་ཏུ༌[^844]ཕ་རོལ་ཏུ་ཕྱིན་པ་གང་ཡོངས་སུ་རྫོགས་པར་བྱེད་ཅེ་ན།]]
   * 1.65 བསོད་ནམས་བྱ་བའི་གཞི་གསུམ [[མདོ་ལས་སྦྱིན་པ་ལས་བྱུང་བའི་བསོད་ནམས་བྱ་བའི་གཞི་དང་།]]
      * 1.65.1 སྦྱིན་པ་ལས་བྱུང་བའི་བསོད་ནམས་བྱ་བའི་གཞི [[སྦྱིན་པ་ཞེས་བྱ་བ་འདི་ཅི་ཡིན་ཞེ་ན། གང་སྦྱིན་པར་བྱ་བ་དེ་ཡང་སྦྱིན་པ་ཡིན་མོད་ཀྱི]]
         * 1.65.1.1 གང་གིས་སྦྱིན་བྱེད་དེ་སྦྱིན་པ [[གང་གིས་སྦྱིན་བྱེད་དེ་སྦྱིན་པ། །འཇིགས་པ་དང་། ལན་ལ་རེ་བ་དང་།]]
         * 1.65.1.2 འབྲས་བུ་ལོངས་སྤྱོད་ཆེན་པོ [[དེ་འབྲས་ལོངས་སྤྱོད་ཆེན་པོ་ཅན། །སྦྱིན་པ་ལས་བྱུང་བའི་བསོད་ནམས་བྱ་བའི་གཞི]]
         * 1.65.1.3 བདག་གཞན་དོན་ཕྱིར་སྦྱིན་པ [[ཡང་སྦྱིན་པ་དེ་ནི།]]
         * 1.65.1.4 སྦྱིན་པའི་ཁྱད་པར [[སྦྱིན་པའི་འབྲས་བུ་ལོངས་སྤྱོད་ཆེན་པོ་ཅན་ཞེས་སྤྱིར་བསྟན་པ།]]
            * 1.65.1.4.1 སྦྱིན་བདག་ཁྱད་པར་དུ་འཕགས་པ [[དེ་ལ་རེ་ཞིག །སྦྱིན་བདག་ཁྱད་འཕགས་དད་སོགས་ཀྱིས། །]]
            * 1.65.1.4.2 དངོས་པོ་ཁྱད་པར་དུ་འཕགས་པ [[ཇི་ལྟར་ན་དངོས་པོ་ཁྱད་པར་དུ་འཕགས་པ་ཡིན་ཞེ་ན།]]
            * 1.65.1.4.3 ཞིང་ཁྱད་དུ་འཕགས་པ [[ཡང༌[^875]ཇི་ལྟར་ན་ཞིང་ཁྱད༌[^876]དུ་འཕགས་པ་ཡིན་ཞེ་ན།]]
               * 1.65.1.4.3.1 འགྲོ་བའི་ཁྱད་པར [[རེ་ཞིག་འགྲོ་བའི་ཁྱད་པར་གྱིས་ཁྱད་དུ་འཕགས་པ་འདི་ལྟར]]
               * 1.65.1.4.3.2 སྡུག་བསྔལ་གྱི་ཁྱད་པར [[སྡུག་བསྔལ་གྱི་ཁྱད་པར་དུ་འཕགས་པ་ནི་འདི༌[^877]ལྟར]]
               * 1.65.1.4.3.3 ཕན་འདོགས་པའི་ཁྱད་པར [[ཕན་འདོགས་པའི་ཁྱད་པར་ལས་ནི་འདི་ལྟ་སྟེ་ཕ་མ་དང་།]]
               * 1.65.1.4.3.4 ཡོན་ཏན་གྱི་ཁྱད་པར [[ཡོན་ཏན་གྱི་ཁྱད་པར་ལས་ནི་འདི་ལྟ་སྟེ། ཚུལ་ཁྲིམས་དང་ལྡན་པ་ལ༌[^883]བྱིན་ན]]
         * 1.65.1.5 སྦྱིན་པ་ཐམས་ཅད་ཀྱི་ནང་ན་མཆོག [[སྦྱིན་པ་ཐམས་ཅད་ཀྱི་ནང་ན། །]]
         * 1.65.1.6 ཡོན་གཞལ་དུ་མེད་པ [[མདོ་ལས་རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་ལ་ཞུགས་པ་ལ་སྦྱིན་པ་བྱིན་ན]]
         * 1.65.1.7 ལས་རྣམས་ཀྱི་ལྕི་བ་དང་ཡང་བ [[ལས་རྣམས་ཀྱི་ལྕི་བ་དང་། ཡང་བ་ཉིད་ཤེས་པར་འདོད་པས་མདོར་ན་རྒྱུ་དྲུག]]
         * 1.65.1.8 བསགས་པའི་ལས [[ལས་བྱས་པ་དང་བསགས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་ན་ལས་བསགས་པ་ཡིན་ཞེ་ན།]]
         * 1.65.1.9 མཆོད་རྟེན་ལ་སྦྱིན་པ་བྱིན་པའི་བསོད་ནམས [[འདོད་ཆགས་དང་བཅས་པས་མཆོད་རྟེན་ལ་སྦྱིན་པ་བྱིན་པ་ནི་བདག་གི་དོན་དུའོ]]
         * 1.65.1.10 ངན་པའི་ཞིང་ལ་འབྲས་བུ་ཡིད་འོང་བ [[གལ་ཏེ་ཞིང་བཟང་པོ་ལ་སྦྱིན་པར་བྱ་བའི་ས་བོན་འབྲས་བུ]]
      * 1.65.2 ཚུལ་ཁྲིམས་ལས་བྱུང་བ [[ཚུལ་ཁྲིམས་ལས་བྱུང་བ་བརྗོད་པར་བྱ་སྟེ།]]
         * 1.65.2.1 ཚུལ་ཁྲིམས་མདོར་བཤད་པ [[དེས༌[^911]སྨྲས་པ། འཆལ་པའི་ཚུལ་ཁྲིམས་མི་དགེའི་གཟུགས། །]]
         * 1.65.2.2 རྣམ་པར་དག་པའི་ཚུལ་ཁྲིམས [[རྣམ་དག་ཡོན་ཏན་བཞི་ལྡན་ནོ། །]]
      * 1.65.3 བསྒོམ་པ [[མཉམ་པར་གཞག་པའི་དགེ་བ་ནི་སྒོམ༌[^922]པའོ། །]]
      * 1.65.4 ཚངས་པའི་བསོད་ནམས [[མདོ་ལས་གང་ཟག་བཞི་ནི་ཚངས་པའི་བསོད་ནམས་སྐྱེད་དོ་ཞེས་གསུངས་པ།]]
      * 1.65.5 ཆོས་ཀྱི་སྦྱིན་པ [[ཆོས་ཀྱི་སྦྱིན་པ་བརྗོད་པར་བྱ་སྟེ། དེས༌[^931]སྨྲས་པ།]]
   * 1.66 ཆ་མཐུན་དགེ་བ་གསུམ [[བསོད་ནམས་མྱ་ངན་འདས་པ་དང་། །]]
      * 1.66.1 བསོད་ནམས་ཀྱི་ཆ་དང་མཐུན་པ [[བསོད་ནམས་ཀྱི་ཆ་དང་མཐུན་པ་ནི་རྣམ་པར་སྨིན་པ་ཡིད་དུ་འོང་བ་ཅན]]
      * 1.66.2 ཐར་པའི་ཆ་དང་མཐུན་པ [[ཐར་པའི་ཆ་དང་མཐུན་པ་ནི་གང་སྐྱེས་ན་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བའི]]
      * 1.66.3 ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ [[ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་ནི་དྲོ་བར་གྱུར་པ་ལ་སོགས་པ]]
   * 1.67 ཡིག་འབྲུ་དང་རྒྱ་ལ་སོགས་པའི་རང་བཞིན [[འཇིག་རྟེན་ན་ཡིག་འབྲུ་དང་། རྒྱ་དང་། བགྲང་བ་དང་། སྙན་ངག་དང་།]]
   * 1.68 རྣམ་གྲངས་ཁ་ཅིག [[ད་ནི་རྣམ་གྲངས་ཁ་ཅིག་བརྗོད་པར་བྱ་སྟེ།]]
