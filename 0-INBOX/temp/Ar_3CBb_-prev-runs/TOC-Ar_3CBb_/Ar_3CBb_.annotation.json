    {
      "depth": 2,
      "heading_title": "ལེའུ་གཉིས་པ།",
      "body_start_context": "ལེའུ་གཉིས་པ་ལས་ནི་རྫོགས་པའི་རི"
    },
    {
      "depth": 2,
      "heading_title": "ལེའུ་གསུམ་པ།",
      "body_start_context": "ལེའུ་གཉིས་པ་བརྗོད་ཟིན་ནས་གསུམ་"
    },
    {
      "depth": 2,
      "heading_title": "ལེའུ་བཞི་པ།",
      "body_start_context": "ཡང་ན་ཉེ་བར་ལོངས་སྤྱོད་པའི་དོན་"
    },
    {
      "depth": 2,
      "heading_title": "ལེའུ་ལྔ་པ།",
      "body_start_context": "འདིར་ཡང་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད"
