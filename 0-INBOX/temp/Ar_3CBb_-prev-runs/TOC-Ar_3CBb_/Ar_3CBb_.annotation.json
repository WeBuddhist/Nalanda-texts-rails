  "sections": [
    {
      "depth": 1,
      "heading_title": "རྒྱན་རྣམ་པ་བདུན་སྤྲོས་པ་དང་བཅས་པའི་བཤད་པ།",
      "body_start_context": "དེ་ཉིད་ཀྱི་དབྱེ་བ་མདོར་བསྟན་པའ"
    },
    {
      "depth": 2,
      "heading_title": "རྒྱན་རྣམས་མདོར་བསྡུས་པ།",
      "body_start_context": "དེ་ཉིད་ཀྱི་དབྱེ་བ་མདོར་བསྟན་པའ"
    },
    {
      "depth": 2,
      "heading_title": "རྒྱན་བདུན་པོ་རྣམས་ཀྱི་རྒྱས་པ།",
      "body_start_context": "རྒྱན་རྣམས་མདོར་བསྡུས་པའོ་ཞེས་བ"
    },
    {
      "depth": 1,
      "heading_title": "ལེའུ་བཅུ་བདུན་གྱི་བསྡུས་པའི་དོན།",
      "body_start_context": "དེ་ལྟར་རྒྱན་རྣམ་པ་བདུན་གོ་རིམས"
    },
    {
      "depth": 2,
      "heading_title": "ལེའུ་དང་པོ།",
      "body_start_context": "འོ་ན་ལེའུ་དང་པོ་ལས་ནི་ཅི་ཞིག་ག"
